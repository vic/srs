// captureBegin .. captureEnd: the prints between them are one string, not output (captures nest); column: the bytes
// printed since the last newline
capability Console:
  def print(s: Str): Unit
  def printI64(v: I64): Unit
  def printChar(c: I64): Unit
  def eprint(s: Str): Unit
  def eprintI64(v: I64): Unit
  def captureBegin(): Unit
  def captureEnd(): Str
  def column(): I64

