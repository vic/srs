// CStr.argv copies the n pointers of xs and a NULL into the region r: the char *const argv[] of execvp and posix_spawn
// (Emit.cargv). No CStr is NULL, so CStr.argv is the only way to an argv, and every argv ends in its NULL
extern def CStr.argv {r: Srs.Region} (n: I64, xs: Array[CStr](n)<r>): CArgv<r>
