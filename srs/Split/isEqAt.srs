// token j is the one-byte operator `=`
def Split.isEqAt(src: Str, tcap: I64, tk: Array[U8](tcap), to: Array[U32](tcap), tl: Array[U32](tcap), t: I64, j: I64): Bool =
  if Split.isKind(tcap, tk, t, j, Lexer.KOp) && 0 <= j && j < tcap then
    val o = I64.of(to(j))
    I64.of(tl(j)) == 1 && Str.at(src, o) == 61
  else false

