def Split.byteKind(c: I64): Coll.Option[Split.Kind] =
  if c == 0 then Coll.Some(Split.Def)
  else if c == 1 then Coll.Some(Split.Enum)
  else if c == 2 then Coll.Some(Split.Extern)
  else if c == 3 then Coll.Some(Split.Handler)
  else if c == 4 then Coll.Some(Split.Capability)
  else if c == 5 then Coll.Some(Split.Trait)
  else if c == 6 then Coll.Some(Split.Type)
  else if c == 7 then Coll.Some(Split.Val)
  else if c == 8 then Coll.Some(Split.Given)
  else if c == 9 then Coll.Some(Split.Proto)
  else if c == 10 then Coll.Some(Split.Other)
  else Coll.None

