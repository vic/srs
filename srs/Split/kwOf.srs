// the keyword table (s2/parse.srs:171-188); a word outside it is no decl
def Split.kwOf(s: Str): Coll.Option[Split.Kind] =
  if Str.eq(s, "def") then Coll.Some(Split.Def)
  else if Str.eq(s, "enum") then Coll.Some(Split.Enum)
  else if Str.eq(s, "extern") then Coll.Some(Split.Extern)
  else if Str.eq(s, "handler") then Coll.Some(Split.Handler)
  else if Str.eq(s, "capability") then Coll.Some(Split.Capability)
  else if Str.eq(s, "trait") then Coll.Some(Split.Trait)
  else if Str.eq(s, "type") then Coll.Some(Split.Type)
  else if Str.eq(s, "val") then Coll.Some(Split.Val)
  else if Str.eq(s, "given") then Coll.Some(Split.Given)
  else Coll.None

