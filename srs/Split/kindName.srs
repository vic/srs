def Split.kindName(k: Split.Kind): Str = k match
  case Split.Def => "def"
  case Split.Enum => "enum"
  case Split.Extern => "extern"
  case Split.Handler => "handler"
  case Split.Capability => "capability"
  case Split.Trait => "trait"
  case Split.Type => "type"
  case Split.Val => "val"
  case Split.Given => "given"
  case Split.Proto => "proto"
  case Split.Other => "other"

