def Split.kindByte(k: Split.Kind): I64 = k match
  case Split.Def => 0
  case Split.Enum => 1
  case Split.Extern => 2
  case Split.Handler => 3
  case Split.Capability => 4
  case Split.Trait => 5
  case Split.Type => 6
  case Split.Val => 7
  case Split.Given => 8
  case Split.Proto => 9
  case Split.Other => 10

