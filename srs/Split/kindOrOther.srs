def Split.kindOrOther(src: Str, tcap: I64, tk: Array[U8](tcap), to: Array[U32](tcap), tl: Array[U32](tcap), t: I64, j: I64): Split.Kind =
  if Split.isKind(tcap, tk, t, j, Lexer.KIdent) && 0 <= j && j < tcap then
    val o = I64.of(to(j))
    Split.kwOf(Str.slice(src, o, o + I64.of(tl(j)))) match
      case Coll.Some(k) => k
      case Coll.None => Split.Other
  else Split.Other

