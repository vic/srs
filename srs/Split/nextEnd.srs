// where the decl whose head is before j ends: the next col-0 code token, or t
def Split.nextEnd(src: Str, n: I64, tcap: I64, tk: Array[U8](tcap), to: Array[U32](tcap), t: I64, j: I64): I64 =
  if j >= t then t
  else if Split.isHead(src, n, tcap, tk, to, t, j) then j
  else Split.nextEnd(src, n, tcap, tk, to, t, j + 1)

