// the result: decl columns (cap slots, c used) and diag columns (dcap slots, d used)
enum Split.Out:
  case Split.Out(cap: I64, kd: Array[U8](cap), nm: Array[U32](cap), hd: Array[U32](cap), lo: Array[U32](cap), hi: Array[U32](cap), c: I64, dcap: I64, dw: Array[U8](dcap), dt: Array[U32](dcap), d: I64)

