// the text of the word at token j when it is an identifier
def Split.wordIs(src: Str, tcap: I64, tk: Array[U8](tcap), to: Array[U32](tcap), tl: Array[U32](tcap), t: I64, j: I64, w: Str): Bool =
  if Split.isKind(tcap, tk, t, j, Lexer.KIdent) && 0 <= j && j < tcap then
    val o = I64.of(to(j))
    Str.eq(Str.slice(src, o, o + I64.of(tl(j))), w)
  else false

