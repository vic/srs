def Kernel.jstrFrom(s: Str, i: I64, n: I64): Unit =
  if i < n then
    val c = Str.at(s, i)
    if c == 34 then
      Console.printChar(92)
      Console.printChar(34)
    else if c == 92 then
      Console.printChar(92)
      Console.printChar(92)
    else if c == 10 then
      Console.printChar(92)
      Console.printChar(110)
    else if c == 9 then
      Console.printChar(92)
      Console.printChar(116)
    else if c < 32 then Console.printChar(32)
    else Console.printChar(c)
    Kernel.jstrFrom(s, i + 1, n)
  else ()

