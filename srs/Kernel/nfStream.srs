// prompt: print the stream of the unit resolved as r (see Kernel.nfToks); its path is the unit name.
def Kernel.nfStream(w: Resolve.W, tj: Kernel.Tj, nf: Kernel.Nf, c: I64, md: Kernel.Md, r: Typer.R): Unit =
  val Typer.R(f, rcap, rk, rf) = r
  val Resolve.F(path, g, _, _, _, _, _, _) = f
  val Ast.G(tk, _, _, _) = g
  val Ast.Tk(_, tcap, cls, _, _, t) = tk
  Kernel.nfToks(w, tj, nf, c, md, g, path, tcap, cls, t, rcap, rk, rf, 0)