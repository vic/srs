// submit: the decls of s replace the units of the same names in im; two decls of one name in s stay two units
// prompt: the image stays in name order: the units of s are inserted by Kernel.insAll after the old units of their names are dropped.
def Kernel.split(im: Kernel.Img, s: Str): Kernel.Img =
  val fresh = Kernel.splitAdd(Kernel.Empty, s)
  Kernel.insAll(Kernel.dropAll(im, fresh), fresh)