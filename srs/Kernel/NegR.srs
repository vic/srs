// prompt: the result of a NegTest run: fail = the count of failed NegTests, judged = the count of NegTests judged without a
// cache hit, spawned = the count of child processes started (Process.run calls; a cache hit or a refused scratch dir starts
// none), out = the report.
enum Kernel.NegR:
  case Kernel.NegR(fail: I64, judged: I64, spawned: I64, out: Str)

