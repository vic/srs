// prompt: the names of the units the s7 families check in plain image pl, decided by the server only: every unit, unless the
// server serves the kernel image (then none: its NegTest probes are checked in their children as cs = us).
def Kernel.checkedNames(pl: Kernel.Img): Os.Strs = if Kernel.isKernelImage() then Os.End else Kernel.namesOf(pl, Os.End)

