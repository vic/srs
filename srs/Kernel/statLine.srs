// a counter line of a check report (not a diag)
def Kernel.statLine(t: Str, i: I64): Bool =
  Kernel.startsAt(t, i, "types:") || Kernel.startsAt(t, i, "bodies:") || Kernel.startsAt(t, i, "tynodes:") || Kernel.startsAt(t, i, "handlerbodies:") || Kernel.startsAt(t, i, "clauses:") || Kernel.startsAt(t, i, "diags:") || Kernel.startsAt(t, i, "lengths:")

