// one Test.show line per test of im
def Kernel.testCalls(im: Kernel.Img): Unit = im match
  case Kernel.Empty => ()
  case Kernel.Unit(n, t, r) =>
    if Kernel.isTest(t) then
      Console.print("  Test.show(")
      Console.printChar(Kernel.quote())
      Console.print(n)
      Console.printChar(Kernel.quote())
      Console.print(", ")
      Console.print(n)
      Console.print("())\n")
    else ()
    Kernel.testCalls(r)

