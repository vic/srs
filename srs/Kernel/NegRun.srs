// prompt: the inputs that every NegTest of one run shares: the kernel binary path self, the plain image file base that the
// children check, and the run key (Some only when the kernel binary and base are both readable; None = no result is cached).
enum Kernel.NegRun:
  case Kernel.NegRun(self: Str, base: Str, key: Coll.Option[Str])


