// offset of the keyword of the head line at h: after `extern` and an optional quoted ABI word
def Kernel.kwAt(t: Str, h: I64): I64 =
  val e = Kernel.wordEnd(t, h)
  if Str.eq(Str.slice(t, h, e), "extern") then
    val b = Kernel.skipSp(t, e)
    if Str.at(t, b) == 34 then Kernel.skipSp(t, Kernel.wordEnd(t, b)) else b
  else h

