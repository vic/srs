// prompt: a(8x..8x+7) = the B3 words of s (no Console capture inside).
def Kernel.nfPut(n8: I64, a: Array[U32](n8), x: I64, s: Str): Unit =
  val len = Str.len(s)
  val nc = if len == 0 then 1 else (len + 1023) / 1024
  val cv = Array.fill(8, U32.of(0))
  Blake3.sub(s, len, 0, nc, true, 8, cv)
  Kernel.putW(n8, a, 8 * x, 8, cv, 0)

