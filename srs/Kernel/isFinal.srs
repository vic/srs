// prompt: true for a verdict that the cache may keep (the child judged the body: accepted or rejected); a crash or an
// unreadable child is never cached.
def Kernel.isFinal(v: Kernel.Verdict): Bool = v match
  case Kernel.VAccept => true
  case Kernel.VReject => true
  case Kernel.VUnread => false
  case Kernel.VCrash => false


