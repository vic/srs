// prompt: how a token that names a member v of the scc being hashed is printed: K.MAnon "@"; K.MShape "%" and lh(v) (the anon
// hash of v, so members with equal shape but different callees differ); K.MFull "@" and rnk(v).
enum Kernel.Md:
  case Kernel.MAnon
  case Kernel.MShape
  case Kernel.MFull

