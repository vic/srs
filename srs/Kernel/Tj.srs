// Tarjan state: idx(u) dfs number (0 unvisited), low(u), on(u) 1 on the stack, st the stack, comp(u) scc number;
// ctr(0) last dfs number, ctr(1) stack size, ctr(2) next scc number
enum Kernel.Tj:
  case Kernel.Tj(n: I64, idx: Array[U32](n), low: Array[U32](n), on: Array[U8](n), st: Array[U32](n), comp: Array[U32](n), c3: I64, ctr: Array[U32](c3))

