// the dependency graph of im plus the names world and the per-token resolution of each unit
// prompt: K.graphW(im) resolves im once and returns the same graph as K.graph(im), the names world w and the resolution rs of every unit in image order.
enum Kernel.Gw:
  case Kernel.Gw(gr: Kernel.Gr, w: Resolve.W, rs: Coll.List[Typer.R])

