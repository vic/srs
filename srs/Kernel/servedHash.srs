// prompt: the B3 of the served image text: the plain image (no NegTests) printed by Kernel.printTexts, the same bytes a NegTest run
// writes to <scratch>/base.srs.
def Kernel.servedHash(im: Kernel.Img): Str =
  Console.captureBegin()
  Kernel.printTexts(Kernel.plain(im))
  Blake3.hash(Console.captureEnd())

