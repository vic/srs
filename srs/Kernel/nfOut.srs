// prompt: true when given gl(a) is outside scc c.
def Kernel.nfOut(tj: Kernel.Tj, gn: I64, gl: Array[U32](gn), c: I64, a: I64): Bool =
  val Kernel.Tj(tn, idx, low, on, st, comp, c3, ctr) = tj
  if 0 <= a && a < gn then
    val u = I64.of(gl(a))
    0 <= u && u < tn && I64.of(comp(u)) != c
  else false

