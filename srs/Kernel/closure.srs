// the units of im that the roots use, transitively, roots included
def Kernel.closure(im: Kernel.Img, roots: Os.Strs): Kernel.Img =
  val gr = Kernel.graph(im)
  val n = Kernel.count(im, 0)
  val mk = Array.fill(n, U8.of(0))
  Kernel.rootMark(gr, n, mk, im, 0, roots)
  Kernel.pick(im, n, mk, 0)

