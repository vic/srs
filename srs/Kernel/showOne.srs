// the text of the unit named n in the image, or a missing line
def Kernel.showOne(im: Kernel.Img, n: Str): Unit = im match
  case Kernel.Empty =>
    Console.print("missing ")
    Console.print(n)
    Console.print("\n")
  case Kernel.Unit(m, t, r) =>
    if Str.eq(m, n) then
      Console.print(t)
      Console.print("\n")
    else Kernel.showOne(r, n)

