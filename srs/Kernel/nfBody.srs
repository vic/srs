// prompt: print the full streams of the members of scc c in rank order k, k+1, .. until a rank has no member.
def Kernel.nfBody(w: Resolve.W, tj: Kernel.Tj, nf: Kernel.Nf, c: I64, k: I64, rs: Coll.List[Typer.R]): Unit =
  if Kernel.nfAt(w, tj, nf, c, k, rs, 0) then Kernel.nfBody(w, tj, nf, c, k + 1, rs) else ()

