// ── store tree (vic prompt.md 2026-11-16: "A definition X.Y.z must be written to file X/Y/z.srs") ──
// prompt: the dir of name prefix p under store dir d: d "/" p with every "." as "/".
def Kernel.dirPath(d: Str, p: Str): Str =
  Console.captureBegin()
  Console.print(d)
  Console.print("/")
  Kernel.swap(p, 46, 47, 0)
  Console.captureEnd()

