// one decl chunk becomes one unit; a given, or any decl without a name, is named by its header line, so no decl is ever dropped unchecked and a given never takes its trait's name; a chunk with no head line (comments only) holds no decl
// prompt: K.add1(im, t) inserts the chunk t into im under K.textName(t) (name order, K.snoc); a chunk with no name leaves im as it is.
def Kernel.add1(im: Kernel.Img, t: Str): Kernel.Img =
  val m = Kernel.textName(t)
  if Str.len(m) == 0 then im else Kernel.snoc(im, m, t)

