// relaunch: a detached image process on the same socket, capped in memory and time
def Kernel.relArgv(bin: Str, sock: Str): Os.Strs = Os.More("setsid", Os.More("-f", Os.More("prlimit", Os.More(Kernel.memCap(), Os.More("timeout", Os.More(Kernel.lifeSecs(), Os.More(bin, Os.More(sock, Os.End))))))))

