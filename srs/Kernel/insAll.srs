// prompt: insert every unit of xs into im in name order (Kernel.snoc); a name already in im stays and the new unit goes after it.
def Kernel.insAll(im: Kernel.Img, xs: Kernel.Img): Kernel.Img = xs match
  case Kernel.Empty => im
  case Kernel.Unit(n, t, r) => Kernel.insAll(Kernel.snoc(im, n, t), r)

