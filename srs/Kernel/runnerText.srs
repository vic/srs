// the runner: a main that installs Test.Run, shows every test and writes the report to rp
def Kernel.runnerText(im: Kernel.Img, rp: Str): Str =
  Console.captureBegin()
  Console.print("def main(): I64 =\n  handle io = Srs.Console()\n  handle r = Srs.Arena()\n  handle d = Srs.Disk()\n  handle t = Test.Run()\n  Console.captureBegin()\n")
  Kernel.testCalls(im)
  Console.print("  Disk.put(")
  Console.printChar(Kernel.quote())
  Console.print(rp)
  Console.printChar(Kernel.quote())
  Console.print(", Console.captureEnd())\n")
  Console.captureEnd()

