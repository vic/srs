// prompt: the report of NegTest n from judgement j: ok when the verdict is a rejection and the code sets of want and of the
// diags are equal; judged = 1 when it was not a cache hit, spawned = the child processes started for it.
def Kernel.negJudge(n: Str, j: Kernel.Judged, why: Str, want: Os.Strs, judged: I64, spawned: I64): Kernel.NegR = j match
  case Kernel.Judged(v, diags) =>
    val got = Kernel.codes(diags, 0, Os.End)
    val ok = Kernel.isReject(v) && Kernel.allIn(want, got) && Kernel.allIn(got, want)
    Kernel.NegR(if ok then 0 else 1, judged, spawned, Kernel.negLine(n, ok, Kernel.vName(v), want, got, why, diags))

