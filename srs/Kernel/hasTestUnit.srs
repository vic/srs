// prompt: true when image im holds a Test or a NegTest unit (their checks and runner reach units by text: Kernel.implicitRoots).
def Kernel.hasTestUnit(im: Kernel.Img): Bool = im match
  case Kernel.Empty => false
  case Kernel.Unit(_, t, r) => Kernel.isTest(t) || Kernel.isNegTest(t) || Kernel.hasTestUnit(r)

