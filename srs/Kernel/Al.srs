// ── file-scoped aliases (vic 2026-11-16: `alias A = Foo.Bar` lines in a unit, for humans; no impact on C nor on ids; an alias is
// not a type definition: `type X = T` defines a type) ──
// prompt: the aliases of one unit: short name and long name, last alias line first.
enum Kernel.Al:
  case Kernel.AlEnd
  case Kernel.AlMore(short: Str, long: Str, rest: Kernel.Al)