// prompt: the units a NegTest child checks: the closure, in image bi with the probe decls of pt replacing units of the same
// names (Kernel.split), of the probe decl names plus Kernel.implicitRoots (Kernel.negtMain).
def Kernel.negSub(bi: Kernel.Img, pt: Str): Kernel.Img =
  val probe = Kernel.splitAdd(Kernel.Empty, pt)
  Kernel.closure(Kernel.split(bi, pt), Kernel.cat(Kernel.namesOf(probe, Os.End), Kernel.implicitRoots()))

