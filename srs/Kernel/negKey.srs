// prompt: the entry key of the NegTest body probe in run r: B3(run key, probe text); None when the run caches nothing.
def Kernel.negKey(r: Kernel.NegRun, probe: Str): Coll.Option[Str] = r match
  case Kernel.NegRun(_, _, k, _, _, _) => k match
    case Coll.None => Coll.None
    case Coll.Some(rk) => Coll.Some(Blake3.hash(Kernel.msg2(rk, probe)))

