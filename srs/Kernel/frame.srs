def Kernel.frame(me: Str, id: I64, rid: Str, a: Str, b: Str, c: Str): Str =
  Console.captureBegin()
  Kernel.emit("{'msgV':1,'msg_id':'00000000-0000-4000-8000-")
  Kernel.hex(id, 12)
  Kernel.emit("','type':'user','message':{'role':'user','content':'<cross-session-message from=^uds:")
  Console.print(me)
  Kernel.emit("^ from-name=^s4-k0^ from-mode=^prompting^>~re ")
  Console.print(rid)
  Kernel.emit("~")
  Kernel.jstr(a)
  Kernel.jstr(b)
  Kernel.emit("~")
  Kernel.jstr(c)
  Kernel.emit("~</cross-session-message>'},'priority':'next','from':'uds:")
  Console.print(me)
  Kernel.emit("'}")
  Console.printChar(10)
  Console.captureEnd()

