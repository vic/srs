// prompt: judge the NegTest body probe of NegTest n in a child process (Kernel.negtArgv) over the plain image of run r: the
// verdict of the child, the diag lines it wrote, and the number of children started. A refused scratch dir is
// error[negtest-scratch-refused] (non-final: never cached, never a pass) and starts no child. The child must echo the run's
// base B3; on a mismatch the base is written again and the child runs once more; a second mismatch is
// error[negtest-base-mismatch] (non-final).
def Kernel.negChild(r: Kernel.NegRun, n: Str, probe: Str): Kernel.Spawned =
  val Kernel.NegRun(self, base, _, baseHash, baseText, scratch) = r
  scratch match
    case Kernel.ScratchRefused(reason) => Kernel.Spawned(Kernel.Judged(Kernel.VUnread, Kernel.msg2(Kernel.msg2(Kernel.msg2(n, " error[negtest-scratch-refused] "), reason), "\n")), 0)
    case Kernel.ScratchReady(dir) =>
      val pp = Kernel.msg2(dir, "/probe.srs")
      val op = Kernel.msg2(dir, "/out.txt")
      val ep = Kernel.msg2(op, ".base")
      val io = Kernel.Judged(Kernel.VUnread, Kernel.msg2(n, " error[negtest-io] write failed\n"))
      if Disk.put(pp, probe) != 0 || Disk.put(op, "") != 0 || Disk.put(ep, "") != 0 then Kernel.Spawned(io, 0)
      else Kernel.negChildRun(self, base, pp, op, ep, baseHash) match
        case Coll.Some(j) => Kernel.Spawned(j, 1)
        case Coll.None =>
          if Disk.put(base, baseText) != 0 || Disk.put(op, "") != 0 || Disk.put(ep, "") != 0 then Kernel.Spawned(io, 1)
          else Kernel.negChildRun(self, base, pp, op, ep, baseHash) match
            case Coll.Some(j) => Kernel.Spawned(j, 2)
            case Coll.None => Kernel.Spawned(Kernel.Judged(Kernel.VUnread, Kernel.msg2(n, " error[negtest-base-mismatch] the child read a base whose B3 differs from the run's base, twice\n")), 2)

