// prompt: the unit name of file x (ends in ".srs") in dir rel of a store: rel with "/" as "." then "." (when rel is not ""), then x without ".srs".
def Kernel.unitName(rel: Str, x: Str): Str =
  Console.captureBegin()
  Kernel.swap(rel, 47, 46, 0)
  if Str.len(rel) > 0 then Console.print(".") else ()
  Console.print(Str.slice(x, 0, Str.len(x) - 4))
  Console.captureEnd()

