// prompt: check image im with user units us (the program checked against the image: NegTest probe, gate FILE, --neg, --emit); the
// s7 families check the same units (cs = us): their base was admitted by its server under the server scope.
def Kernel.check(bp: Os.Strs, bt: Os.Strs, im: Kernel.Img, us: Os.Strs): Kernel.Res = Kernel.checkIn(bp, bt, im, us, us)

