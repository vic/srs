def Kernel.check(bp: Os.Strs, bt: Os.Strs, im: Kernel.Img): Kernel.Res =
  val Kernel.Res(dc, dout) = Gate.dup(im)
  if dc != 0 then Kernel.Res(dc, dout)
  else
    val ps = Kernel.cat(bp, Kernel.paths(im))
    val xs = Kernel.cat(bt, Kernel.texts(im))
    val Kernel.Res(fc, fout) = Gate.f2(ps, xs)
    if fc != 0 then Kernel.Res(fc, fout)
    else
      Console.captureBegin()
      val code = Typer.runFs(Resolve.loadMem(ps, xs), Kernel.len(ps, 0), 0)
      Kernel.Res(code, Console.captureEnd())