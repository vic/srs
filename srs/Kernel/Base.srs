// prompt: the base files of a server: ps = the unit names and xs = the unit texts of every unit of every base file (each file
// split by Kernel.splitAdd, so two units of one name stay two units and Gate.dupNames reports them), none = the files that hold
// no unit, bad = the count of unreadable files.
enum Kernel.Base:
  case Kernel.Base(ps: Os.Strs, xs: Os.Strs, none: Os.Strs, bad: I64)

