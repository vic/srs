// ── output: "@r" then one row per line, tab separated ──
def Datalog.printCols(rn: I64, xs: Array[U32](rn), base: I64, c: I64, a: I64): Unit =
  if c >= a then Console.print("\n") else
    if c > 0 then Console.print("\t") else ()
    Console.printI64(Datalog.u(rn, xs, base + c))
    Datalog.printCols(rn, xs, base, c + 1, a)

