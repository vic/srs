def Datalog.join {g: Srs.Region} (st: Datalog.St, hv: I64, a: I64, k: I64): Unit =
  if k == 0 then Datalog.emit(st, hv)
  else
    val neg = Datalog.p(st, a)
    if neg >= 2 then
      if Datalog.cmp(st, neg, Datalog.opnd(st, a + 1), Datalog.opnd(st, a + 3)) then Datalog.join(st, hv, a + 5, k - 1) else ()
    else
      val rel = Datalog.p(st, a + 1)
      val x = Datalog.p(st, a + 2)
      val ar = Datalog.p(st, rel)
      val nxt = a + 3 + 2 * ar
      if neg == 1 then
        if Datalog.exists(st, a + 3, rel, ar) then () else Datalog.join(st, hv, nxt, k - 1)
      else Datalog.probe(st, hv, a + 3, nxt, k, rel, x, ar)

