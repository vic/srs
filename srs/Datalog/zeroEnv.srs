// ── plan check: the defects of a plan (0 = well formed), found before it runs ──
// a slot is bound (env 1) by an earlier atom of the rule; a positive atom binds its tag 2 columns (env 2 while the atom is
// read: a tag 1 column needs a slot bound by an EARLIER atom, a tag 5 column one bound by this atom). A comparison atom, a
// negative atom and the head read only bound slots; the first atom is positive; an atom's index is over its own relation
// and exactly its tag 0/1 columns.
def Datalog.zeroEnv(st: Datalog.St, i: I64): Unit =
  if i >= 32 then () else
    Datalog.setEnv(st, i, 0)
    Datalog.zeroEnv(st, i + 1)

