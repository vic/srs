def Datalog.drive {g: Srs.Region} (st: Datalog.St, hv: I64, sp: I64, nxt: I64, k: I64, ar: I64, rn: I64, xs: Array[U32](rn), i: I64, e: I64): Unit =
  if i >= e then () else
    if Datalog.matchCols(st, rn, xs, i * ar, sp, 0, ar) then Datalog.join(st, hv, nxt, k - 1) else ()
    Datalog.drive(st, hv, sp, nxt, k, ar, rn, xs, i + 1, e)

