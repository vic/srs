def Datalog.exists(st: Datalog.St, sp: I64, r: I64, a: I64): Bool =
  val h = Datalog.hkey(st, sp, 0, a, Datalog.h0())
  Datalog.relOf(st, r) match
    case Datalog.Rel.Mk(_, rn, xs) => Datalog.ixOf(st, r) match
      case Datalog.Ix.Mk(hc, hs, nc, nx) => Datalog.existsWalk(st, sp, a, rn, xs, nc, nx, Datalog.u(hc, hs, Datalog.fin(h, hc)))

