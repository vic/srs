// ── add: the row in hb joins relation r unless its full index has it ──
def Datalog.rowEq(st: Datalog.St, rn: I64, xs: Array[U32](rn), base: I64, c: I64, a: I64): Bool =
  if c >= a then true
  else if Datalog.u(rn, xs, base + c) == Datalog.hb(st, c) then Datalog.rowEq(st, rn, xs, base, c + 1, a)
  else false

