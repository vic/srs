// a comparison atom is a filter: tag 2 Lt, 3 Le, 4 Ne, then two operands (tag 0 const, 1 bound slot; a tag and a value each);
// no relation, binds nothing. Columns are all U32, so every comparison is between numbers of one type.
def Datalog.opnd(st: Datalog.St, sp: I64): I64 = if Datalog.p(st, sp) == 0 then Datalog.p(st, sp + 1) else Datalog.env(st, Datalog.p(st, sp + 1))

