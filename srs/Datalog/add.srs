def Datalog.add {g: Srs.Region} (st: Datalog.St, r: I64, a: I64): Unit =
  val h = Datalog.hhb(st, a, 0, Datalog.h0())
  Datalog.relOf(st, r) match
    case Datalog.Rel.Mk(_, rn, xs) => Datalog.ixOf(st, r) match
      case Datalog.Ix.Mk(hc, hs, nc, nx) =>
        if Datalog.hbFound(st, a, rn, xs, nc, nx, Datalog.u(hc, hs, Datalog.fin(h, hc))) then () else Datalog.append(st, r, a)