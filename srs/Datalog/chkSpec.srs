// the defects of one spec (tag, value) of an atom of tag t
def Datalog.chkSpec(st: Datalog.St, t: I64, tag: I64, v: I64): I64 =
  if tag == 0 then 0
  else if tag == 1 then Datalog.slotIs(st, v, 1)
  else if tag == 5 && t == 0 then Datalog.slotIs(st, v, 2)
  else if tag == 2 && t == 0 && 0 <= v && v < 32 then
    Datalog.setEnv(st, v, 2)
    0
  else 1

