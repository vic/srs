def Datalog.digs(s: Str, n: I64, i: I64, acc: I64, neg: Bool): Datalog.N =
  if i < n then
    val c = Str.at(s, i)
    if c >= 48 && c <= 57 then Datalog.digs(s, n, i + 1, acc * 10 + c - 48, neg)
    else Datalog.N(if neg then 0 - acc else acc, i)
  else Datalog.N(if neg then 0 - acc else acc, i)

