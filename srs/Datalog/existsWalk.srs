def Datalog.existsWalk(st: Datalog.St, sp: I64, a: I64, rn: I64, xs: Array[U32](rn), nc: I64, nx: Array[U32](nc), node: I64): Bool =
  if node == 0 then false
  else if Datalog.matchCols(st, rn, xs, (node - 1) * a, sp, 0, a) then true
  else Datalog.existsWalk(st, sp, a, rn, xs, nc, nx, Datalog.u(nc, nx, node - 1))

