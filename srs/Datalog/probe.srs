def Datalog.probe {g: Srs.Region} (st: Datalog.St, hv: I64, sp: I64, nxt: I64, k: I64, rel: I64, x: I64, ar: I64): Unit =
  val h = Datalog.hkey(st, sp, 0, ar, Datalog.h0())
  Datalog.relOf(st, rel) match
    case Datalog.Rel.Mk(_, rn, xs) => Datalog.ixOf(st, x) match
      case Datalog.Ix.Mk(hc, hs, nc, nx) => Datalog.walk(st, hv, sp, nxt, k, ar, rn, xs, nc, nx, Datalog.u(hc, hs, Datalog.fin(h, hc)))

