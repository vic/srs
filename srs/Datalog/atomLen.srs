// ── variants and rounds ──
// a variant: kind (0 once, from every row; 1 per round, from the delta), head relation, head specs, natoms, atoms
// (tag 0 positive | 1 negative, relation, index, specs; or tag 2 Lt | 3 Le | 4 Ne and two operands); every spec is a tag and a value
def Datalog.atomLen(st: Datalog.St, a: I64): I64 = if Datalog.p(st, a) >= 2 then 5 else 3 + 2 * Datalog.p(st, Datalog.p(st, a + 1))

