// prompt: the srs Arena Region handler: its state is the arena struct (one word: the head chunk), ops go to Srs.Arena.*.
handler Srs.Arena for Srs.Region:
  def init(): Srs.Mem = Srs.Arena.newArena()
  def alloc(self: Srs.Mem, size: I64): Srs.Mem = Srs.Arena.alloc(self, size)
  def free(self: Srs.Mem): Unit = Srs.Arena.free(self)

