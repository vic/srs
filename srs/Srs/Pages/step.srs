// prompt: an unreadable count or more than limit() failures since arming shuts the gate; else advise the pages.
def Srs.Pages.step(g: Array[I64](16), a: Srs.Mem, len: I64, ok: Bool): Unit =
  if ok && Srs.Globals.get(g, Srs.Gate.seen()) - Srs.Globals.get(g, Srs.Gate.base()) <= Srs.Pages.limit() then
    Srs.Pages.huge(a, len)
  else Srs.Gate.shut(g)

