// prompt: the argv of a child process under construction (rt/srs_rt.c os_proc), behind the Process capability: an opaque handle
// (Ptr[U8](0): no byte readable by srs), made only by the extern rt_proc_new, filled by rt_proc_arg, consumed by rt_proc_run
// (vic 2026-11-16: only externs make refined Ptr; every Ptr has a type and a size bound).
type Srs.Process.Argv {p: Process} = Ptr[U8](0)