// prompt: the malloc Region handler: its state is a Srs.Heap.State; each op is one rt_heap_* call.
handler Srs.Heap for Srs.Region:
  def init(): Srs.Heap.State = rt_heap_new()
  def alloc(self: Srs.Heap.State, size: I64): Ptr = rt_heap_alloc(self, size)
  def free(self: Srs.Heap.State): Unit = rt_heap_free(self)