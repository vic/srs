// prompt: the unix socket server over libc with no raw pointer (fil-c FC64: every libc buffer is an srs array whose length the
// extern telescope ties to what libc gets): open = unlink + socket + bind + listen on path (1..100 bytes; -1 bad path, -2 socket,
// -3 bind, -4 listen); take = accept with no peer address; peer = the SO_PEERCRED uid (-1 on failure); me = getuid; slurp = the
// bytes read from fd until EOF or 1040000 bytes; done = close.
handler Srs.Sock for Sock:
  def init(): Srs.Sock.State = Srs.Sock.Bufs
  def open(self: Srs.Sock.State, path: Str): I64 =
    val n = Str.len(path)
    if n <= 0 || n > 100 then 0 - 1
    else
      if I64.ofI32(unlink(CStr.of(path))) == 0 then () else ()
      val m = n + 3
      val sa = Array.fill(m, U8.of(0))
      Srs.Sock.addr(m, sa, path, 0)
      val fd = socket(AF_UNIX, SOCK_STREAM, I32.of(0))
      if I64.ofI32(fd) < 0 then 0 - 2
      else if I64.ofI32(bind(fd, sa, m)) != 0 then 0 - 3
      else if I64.ofI32(listen(fd, I32.of(16))) != 0 then 0 - 4
      else I64.ofI32(fd)
  def take(self: Srs.Sock.State, lfd: I64): I64 =
    val a = Array.fill(1, U8.of(0))
    val l = Array.fill(4, U8.of(0))
    I64.ofI32(accept(I32.of(lfd), a, l))
  def peer(self: Srs.Sock.State, fd: I64): I64 =
    val v = Array.fill(12, U8.of(0))
    val l = Array.fill(4, U8.of(0))
    Array.put(l, 0, U8.of(12))
    if I64.ofI32(getsockopt(I32.of(fd), SOL_SOCKET, SO_PEERCRED, v, l)) != 0 then 0 - 1
    else I64.ofU8(v(4)) + 256 * I64.ofU8(v(5)) + 65536 * I64.ofU8(v(6)) + 16777216 * I64.ofU8(v(7))
  def me(self: Srs.Sock.State): I64 = I64.ofI32(getuid())
  def slurp(self: Srs.Sock.State, fd: I64): Str =
    Console.captureBegin()
    Srs.Sock.drain(fd, 0)
    Console.captureEnd()
  def done(self: Srs.Sock.State, fd: I64): Unit = if I64.ofI32(close(I32.of(fd))) == 0 then () else ()

