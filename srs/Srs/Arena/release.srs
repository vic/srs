// prompt: every chunk of the arena from address c: a chunk-size one goes on the spare list, a big block is unmapped.
def Srs.Arena.release(g: Array[I64](16), c: I64): Unit =
  if c == 0 then ()
  else
    val ch = Srs.Arena.at(c)
    val next = rt_ptr_get(ch, Srs.Arena.hNext())
    val cap = rt_ptr_get(ch, Srs.Arena.hCap())
    if cap == Srs.Arena.chunk() then
      rt_ptr_set(ch, Srs.Arena.hNext(), Srs.Globals.get(g, Srs.Arena.gSpare()))
      Srs.Globals.set(g, Srs.Arena.gSpare(), c)
    else
      val un = munmap(ch, U64.ofI64(Srs.Arena.up(Srs.Arena.header() + cap, Srs.Arena.page())))
      ()
    Srs.Arena.release(g, next)

