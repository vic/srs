// prompt: the arena struct: a freed one, else 8 bytes of the current small page; the one Mut handle of this allocator entry
// (globals words are written through Srs.Globals.set).
def Srs.Arena.newArena(): Srs.Mem =
  handle m = Srs.Mut()
  val g = rt_globals()
  val free = Srs.Globals.get(g, Srs.Arena.gFree())
  if free != 0 then
    val s = Srs.Arena.at(free)
    Srs.Globals.set(g, Srs.Arena.gFree(), rt_ptr_get(s, 0))
    rt_ptr_set(s, 0, 0)
    s
  else
    val cur = Srs.Globals.get(g, Srs.Arena.gSmall())
    val s = if cur != 0 && cur < Srs.Globals.get(g, Srs.Arena.gSmallEnd()) then Srs.Arena.at(cur) else Srs.Arena.smallPage(g)
    Srs.Globals.set(g, Srs.Arena.gSmall(), Srs.Arena.addr(s) + 8)
    s

