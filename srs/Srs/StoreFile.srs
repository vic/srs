// prompt: StoreOut over one store entry named by its hash: state from rt_out_new; put appends, commit renames into place.
handler Srs.StoreFile for StoreOut:
  def init(dir: Str, a: I64, b: I64, c: I64, d: I64): Srs.Out.Handle = rt_out_new(dir, a, b, c, d)
  def put(self: Srs.Out.Handle, s: Str): Unit = rt_out_str(self, s)
  def commit(self: Srs.Out.Handle): Unit = rt_out_commit(self)