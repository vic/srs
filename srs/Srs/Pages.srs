// prompt: the Pages handler: its state is the globals block armed by Srs.Pages.arm; live = the gate is On.
handler Srs.Pages for Pages:
  def init(): Array[I64](16) = Srs.Pages.arm()
  def live(self: Array[I64](16)): Bool = Srs.Gate.read(self) match
    case Srs.GateOn => true
    case Srs.GateIdle => false
    case Srs.GateShut => false

