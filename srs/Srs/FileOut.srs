// a source file rewritten whole (srs fmt): the new text goes to a file beside it, renamed over it at commit
// prompt: StoreOut over one source file rewritten whole: state from rt_fout_new; put appends, commit renames into place.
handler Srs.FileOut for StoreOut:
  def init(path: Str): Srs.Out.Handle = rt_fout_new(path)
  def put(self: Srs.Out.Handle, s: Str): Unit = rt_out_str(self, s)
  def commit(self: Srs.Out.Handle): Unit = rt_out_commit(self)


