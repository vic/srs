// decl id -> kind byte, file, line, name symbol; tab: symbol id -> decl id (0 = none). decl 0 and symbol 0 are the absent ones.
// the type namespace is indexed by symbol: tyk = kind byte + 1 (0 = no such type), tyf = file, tyl = line
enum Resolve.Gt:
  case Resolve.Gt(gcap: I64, gk: Array[U8](gcap), gf: Array[U32](gcap), gl: Array[U32](gcap), gs: Array[U32](gcap), tcap: I64, tab: Array[U32](tcap), tyk: Array[U8](tcap), tyf: Array[U32](tcap), tyl: Array[U32](tcap))

