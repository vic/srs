// prompt: resolve the term tokens of the rel(terms) atoms of list l (from i) in the current scope: every name term is a use (Resolve.use),
// an int term is a literal; other atom shapes resolve nothing (their rows fail closed).
def Resolve.atomTerms(x: Resolve.X, l: I64, i: I64): Unit =
  val Resolve.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Ast.len(g, l) then
    val a = Ast.item(g, l, i)
    if Ast.kd(g, a) == Ast.kAtomCall() then Resolve.termToks(x, Ast.a(g, a), 0) else ()
    Resolve.atomTerms(x, l, i + 1)
  else ()
