def Resolve.rkOf(b: I64): Coll.Option[Resolve.RK] =
  if b == 0 then Coll.Some(Resolve.RGlobal)
  else if b == 1 then Coll.Some(Resolve.RLocal)
  else if b == 2 then Coll.Some(Resolve.RCase)
  else if b == 3 then Coll.Some(Resolve.RBuiltin)
  else if b == 4 then Coll.Some(Resolve.RCap)
  else if b == 5 then Coll.Some(Resolve.RUnres)
  else Coll.None

