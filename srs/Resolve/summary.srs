def Resolve.summary(w: Resolve.W, fs: Coll.List[Resolve.F]): Unit =
  Resolve.num("globals=", Resolve.cget(w, Resolve.sDecl()) - 1)
  Resolve.num(" locals=", Resolve.cget(w, Resolve.sLocals()))
  Resolve.num(" resolved=", Resolve.cget(w, Resolve.sRes()))
  Resolve.num(" unresolved=", Resolve.cget(w, Resolve.sUnres()))
  Resolve.num(" types=", Resolve.cget(w, Resolve.sTypes()))
  Resolve.num(" tresolved=", Resolve.cget(w, Resolve.sTypes()) - Resolve.cget(w, Resolve.sTUnres()))
  Resolve.num(" tunresolved=", Resolve.cget(w, Resolve.sTUnres()))
  Console.print("\n")
  Resolve.showUnres(w, fs, 0, Resolve.cget(w, Resolve.sShown()), Resolve.sUFile(), Resolve.sUTok(), "")
  Resolve.showUnres(w, fs, 0, Resolve.cget(w, Resolve.sTShown()), Resolve.sTUFile(), Resolve.sTUTok(), "type ")
  Console.print("kinds")
  Resolve.kinds(w, 0)
  Resolve.num(" syms=", Resolve.cget(w, Resolve.sSyms()) - 1)
  Resolve.num(" dups=", Resolve.cget(w, Resolve.sDup()))
  Resolve.num(" maxScope=", Resolve.cget(w, Resolve.sMaxSp()))
  Resolve.num(" parseErr=", Resolve.sumPerr(fs, 0))
  Resolve.num(" overflow=", Resolve.cget(w, Resolve.sOver()))
  Resolve.num(" leaks=", Resolve.cget(w, Resolve.sLeak()))
  Console.print("\ntkinds")
  Resolve.tkinds(w, 0)
  Resolve.num(" tdups=", Resolve.cget(w, Resolve.sTDup()))
  Console.print("\n")
  Resolve.showTop(w, fs, 0)

