def Resolve.tkName(k: Resolve.TK): Str = k match
  case Resolve.TEnum => "TypeEnum"
  case Resolve.TDecl => "TypeDecl"
  case Resolve.TCap => "TypeCap"
  case Resolve.TBuiltin => "TypeBuiltin"
  case Resolve.TParam => "TypeTyParam"
  case Resolve.TTrait => "TypeTrait"
  case Resolve.THandler => "TypeHandler"
  case Resolve.TUnres => "TypeUnresolved"

