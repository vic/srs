// resume k(v): k is the continuation of the handler fn, which is no value (tests/s2/neg/ms_k_value.srs): only a continuation binder answers
def Resolve.useK(x: Resolve.X, j: I64): Unit =
  val Resolve.X(w, g, _, _, _, _, _, _, _, _) = x
  val sym = Resolve.sym(w, Resolve.tokT(g, j), false)
  Resolve.look(w, sym, Resolve.cget(w, Resolve.sSp()) - 1, false) match
    case Coll.Some(i) => Resolve.useKAt(x, j, i)
    case Coll.None => Resolve.set(x, j, Resolve.kUnres(), 0)

