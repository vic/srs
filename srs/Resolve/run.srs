// s3c --names F... : the program is all the files; --names-dump F... also prints one line per use token
def Resolve.run(dump: Bool): I64 =
  val fs = Resolve.load(2)
  val w = Resolve.world(Resolve.sumTok(fs, 0), Resolve.sumBytes(fs, 0))
  Resolve.builtins(w)
  Resolve.btypes(w)
  Resolve.declFiles(w, fs, 0)
  Resolve.resolveFiles(w, fs, 0, dump)
  if !dump then Resolve.summary(w, fs) else ()
  if Coll.length(fs) < Args.count() - 2 then 1 else 0

