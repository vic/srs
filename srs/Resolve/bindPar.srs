def Resolve.bindPar(x: Resolve.X, parts: I64, i: I64): Unit =
  val Resolve.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Ast.len(g, parts) then
    val p = Ast.item(g, parts, i)
    if Ast.kd(g, p) == Ast.kParams() then Resolve.bindBinders(x, Ast.a(g, p), 0) else ()
    Resolve.bindPar(x, parts, i + 1)
  else ()

