def Resolve.useKAt(x: Resolve.X, j: I64, i: I64): Unit =
  val Resolve.X(w, _, _, _, _, _, _, _, _, _) = x
  val Resolve.W(_, _, sc, _) = w
  val Resolve.Sc(cap, _, st, sk) = sc
  if 0 <= i && i < cap then
    if I64.ofU8(sk(i)) == Resolve.bCont() then Resolve.set(x, j, Resolve.kLocal(), I64.of(st(i)))
    else Resolve.set(x, j, Resolve.kUnres(), 0)
  // shortcut: Nm.look answers an index below cap; s3 Vec will make it unrepresentable
  else Resolve.over(w)

