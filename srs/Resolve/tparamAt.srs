def Resolve.tparamAt(x: Resolve.X, j: I64, i: I64): Unit =
  val Resolve.X(w, _, _, _, _, _, _, _, _, _) = x
  val Resolve.W(_, _, sc, _) = w
  val Resolve.Sc(cap, _, st, _) = sc
  if 0 <= i && i < cap then Resolve.tset(x, j, Resolve.tParam(), I64.of(st(i)))
  // shortcut: Nm.look answers an index below cap; s3 Vec will make it unrepresentable
  else Resolve.over(w)

