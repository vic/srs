def Resolve.tkOf(b: I64): Coll.Option[Resolve.TK] =
  if b == 0 then Coll.Some(Resolve.TEnum)
  else if b == 1 then Coll.Some(Resolve.TDecl)
  else if b == 2 then Coll.Some(Resolve.TCap)
  else if b == 3 then Coll.Some(Resolve.TBuiltin)
  else if b == 4 then Coll.Some(Resolve.TParam)
  else if b == 5 then Coll.Some(Resolve.TTrait)
  else if b == 6 then Coll.Some(Resolve.THandler)
  else if b == 7 then Coll.Some(Resolve.TUnres)
  else Coll.None

