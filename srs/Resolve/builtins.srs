// the builtin calls of s2/names.srs Names.builtins (163) and Names.atoms (167, 170), and the two literals the parser reads as names
def Resolve.builtins(w: Resolve.W): Unit =
  Resolve.bi(w, "Array.fill")
  Resolve.bi(w, "Array.tabulate")
  Resolve.bi(w, "Array.slice")
  Resolve.bi(w, "Array.put")
  Resolve.bi(w, "Array.blit")
  Resolve.bi(w, "Array.aload")
  Resolve.bi(w, "Array.astore")
  Resolve.bi(w, "Array.cas")
  Resolve.bi(w, "Array.fetchAdd")
  Resolve.bi(w, "Cell.new")
  Resolve.bi(w, "Cell.get")
  Resolve.bi(w, "Cell.put")
  Resolve.bi(w, "ACell.new")
  Resolve.bi(w, "ACell.load")
  Resolve.bi(w, "ACell.store")
  Resolve.bi(w, "ACell.cas")
  Resolve.bi(w, "ACell.fetchAdd")
  Resolve.bi(w, "true")
  Resolve.bi(w, "false")

