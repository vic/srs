// a def or a capability def (same parts)
def Resolve.defN(x: Resolve.X, d: I64): Unit =
  val Resolve.X(_, g, _, _, _, _, _, _, _, _) = x
  val sp = Resolve.sp(x)
  val parts = Ast.b(g, d)
  Resolve.bindTps(x, parts, 0)
  Resolve.bindEv(x, parts, 0)
  Resolve.bindPar(x, parts, 0)
  Resolve.parts(x, parts, 0)
  Resolve.setSp(x, sp)

