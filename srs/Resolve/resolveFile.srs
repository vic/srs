def Resolve.resolveFile(w: Resolve.W, f: Resolve.F, fi: I64, dump: Bool): Unit =
  val Resolve.F(path, g, lcap, ln, rc, rk, rr, _) = f
  val rcap = Resolve.tcapOf(g)
  val ks = Array.fill(rcap, U8.of(0))
  val fs = Array.fill(rcap, U32.of(0))
  Resolve.rootsOf(Resolve.X(w, g, fi, path, dump, lcap, ln, rcap, ks, fs), rc, rk, rr, 0)

