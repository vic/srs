// the builtin types of s2/names.srs Names.builtins 163 (Array, Cell), Names.atoms2 170 (ACell) and Names.builtins7 173
def Resolve.btypes(w: Resolve.W): Unit =
  Resolve.bty(w, "Array")
  Resolve.bty(w, "Cell")
  Resolve.bty(w, "ACell")
  Resolve.bty(w, "I64")
  Resolve.bty(w, "Bool")
  Resolve.bty(w, "Unit")
  Resolve.bty(w, "Str")
  Resolve.bty(w, "Ptr")
  Resolve.bty(w, "U32")
  Resolve.bty(w, "U64")
  Resolve.bty(w, "U8")
  Resolve.bty(w, "I32")
  Resolve.bty(w, "CStr")
  Resolve.bty(w, "CArgv")
  Resolve.bty(w, "F64")

