// t with x consed onto the list bound to k (a one-element list when k is absent): one find, then one path copy
def Coll.bPushT [A: Type] (t: Coll.BTree[Coll.List[A]], k: I64, x: A): Coll.BTree[Coll.List[A]] =
  val n = Coll.bFind(t, k)
  if Coll.bIsNode(n) then Coll.bRep(t, k, Coll.Cons(x, Coll.bValOr(n, k, Coll.Nil)))
  else Coll.bIns(t, k, Coll.Cons(x, Coll.Nil))

