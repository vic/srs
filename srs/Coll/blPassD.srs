// a descending level: t is the rightmost tree of the group, a its last entry; acc holds the promoted keys, ascending
def Coll.blPassD [V: Type] (t: Coll.BTree[V], a: Coll.BTK[V], rest: Coll.List[Coll.BTK[V]], acc: Coll.List[Coll.BKT[V]]): Coll.BLvlA[V] = rest match
  case Coll.Nil => Coll.BLvlA(Coll.blD2(a, t), acc)
  case Coll.Cons(b, r2) => r2 match
    case Coll.Nil => Coll.BLvlA(Coll.blD3(b, a, t), acc)
    case Coll.Cons(c, r3) => r3 match
      case Coll.Nil => Coll.BLvlA(Coll.blD4(c, b, a, t), acc)
      case Coll.Cons(d, r4) => c match
        case Coll.BTK(tc, kc, vc) => Coll.blPassD(tc, d, r4, Coll.Cons(Coll.BKT(kc, vc, Coll.blD3(b, a, t)), acc))

