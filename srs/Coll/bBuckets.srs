def Coll.bBuckets [V: Type] (t: Coll.BTree[Coll.List[Coll.SEntry[V]]], acc: Coll.List[Coll.SEntry[V]]): Coll.List[Coll.SEntry[V]] = t match
  case Coll.BTip => acc
  case Coll.B2(a, _, v1, b) => Coll.bBuckets(a, Coll.revOnto(v1, Coll.bBuckets(b, acc)))
  case Coll.B3(a, _, v1, b, _, v2, c) =>
    Coll.bBuckets(a, Coll.revOnto(v1, Coll.bBuckets(b, Coll.revOnto(v2, Coll.bBuckets(c, acc)))))
  case Coll.B4(a, _, v1, b, _, v2, c, _, v3, d) =>
    Coll.bBuckets(a, Coll.revOnto(v1, Coll.bBuckets(b, Coll.revOnto(v2, Coll.bBuckets(c, Coll.revOnto(v3, Coll.bBuckets(d, acc)))))))

