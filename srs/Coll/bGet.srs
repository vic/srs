// the value of k in one descent
def Coll.bGet [V: Type] (t: Coll.BTree[V], k: I64): Coll.Option[V] = t match
  case Coll.BTip => Coll.None
  case Coll.B2(a, k1, v1, b) =>
    if k < k1 then Coll.bGet(a, k)
    else if k > k1 then Coll.bGet(b, k)
    else Coll.Some(v1)
  case Coll.B3(a, k1, v1, b, k2, v2, c) =>
    if k < k1 then Coll.bGet(a, k)
    else if k == k1 then Coll.Some(v1)
    else if k < k2 then Coll.bGet(b, k)
    else if k == k2 then Coll.Some(v2)
    else Coll.bGet(c, k)
  case Coll.B4(a, k1, v1, b, k2, v2, c, k3, v3, d) =>
    if k < k1 then Coll.bGet(a, k)
    else if k == k1 then Coll.Some(v1)
    else if k < k2 then Coll.bGet(b, k)
    else if k == k2 then Coll.Some(v2)
    else if k < k3 then Coll.bGet(c, k)
    else if k == k3 then Coll.Some(v3)
    else Coll.bGet(d, k)

