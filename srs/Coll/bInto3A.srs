def Coll.bInto3A [V: Type] (a: Coll.BTree[V], k1: I64, v1: V, b: Coll.BTree[V], k2: I64, v2: V, c: Coll.BTree[V], k: I64, v: V): Coll.BTree[V] = a match
  case Coll.BTip => Coll.B4(Coll.BTip, k, v, Coll.BTip, k1, v1, Coll.BTip, k2, v2, Coll.BTip)
  case Coll.B4(x1, y1, z1, x2, y2, z2, x3, y3, z3, x4) =>
    Coll.bLift3A(Coll.bSplitIns(x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, k, v), k1, v1, b, k2, v2, c)
  case Coll.B2(_, _, _, _) => Coll.B3(Coll.bIns(a, k, v), k1, v1, b, k2, v2, c)
  case Coll.B3(_, _, _, _, _, _, _) => Coll.B3(Coll.bIns(a, k, v), k1, v1, b, k2, v2, c)

