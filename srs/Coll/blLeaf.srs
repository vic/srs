// the leaf level: ascending pairs, a first; acc holds the promoted keys, descending
def Coll.blLeaf [V: Type] (a: Coll.KV[V], rest: Coll.List[Coll.KV[V]], acc: Coll.List[Coll.BTK[V]]): Coll.BLvlD[V] = rest match
  case Coll.Nil => Coll.BLvlD(acc, Coll.blL2(a))
  case Coll.Cons(b, r2) => r2 match
    case Coll.Nil => Coll.BLvlD(acc, Coll.blL3(a, b))
    case Coll.Cons(c, r3) => r3 match
      case Coll.Nil => Coll.BLvlD(acc, Coll.blL4(a, b, c))
      case Coll.Cons(d, r4) => c match
        case Coll.KV(kc, vc) => Coll.blLeaf(d, r4, Coll.Cons(Coll.BTK(Coll.blL3(a, b), kc, vc), acc))

