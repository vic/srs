// a B4 root becomes a B2 over two B2s, then k enters it
def Coll.bRootIns [V: Type] (a: Coll.BTree[V], k1: I64, v1: V, b: Coll.BTree[V], k2: I64, v2: V, c: Coll.BTree[V], k3: I64, v3: V, d: Coll.BTree[V], k: I64, v: V): Coll.BTree[V] =
  Coll.bIns(Coll.B2(Coll.B2(a, k1, v1, b), k2, v2, Coll.B2(c, k3, v3, d)), k, v)

