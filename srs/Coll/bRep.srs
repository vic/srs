// t with the value of k replaced: the path is copied and the shape is kept (no split); t when k is absent
def Coll.bRep [V: Type] (t: Coll.BTree[V], k: I64, v: V): Coll.BTree[V] = t match
  case Coll.BTip => t
  case Coll.B2(a, k1, v1, b) =>
    if k < k1 then Coll.B2(Coll.bRep(a, k, v), k1, v1, b)
    else if k > k1 then Coll.B2(a, k1, v1, Coll.bRep(b, k, v))
    else Coll.B2(a, k1, v, b)
  case Coll.B3(a, k1, v1, b, k2, v2, c) =>
    if k < k1 then Coll.B3(Coll.bRep(a, k, v), k1, v1, b, k2, v2, c)
    else if k == k1 then Coll.B3(a, k1, v, b, k2, v2, c)
    else if k < k2 then Coll.B3(a, k1, v1, Coll.bRep(b, k, v), k2, v2, c)
    else if k == k2 then Coll.B3(a, k1, v1, b, k2, v, c)
    else Coll.B3(a, k1, v1, b, k2, v2, Coll.bRep(c, k, v))
  case Coll.B4(a, k1, v1, b, k2, v2, c, k3, v3, d) =>
    if k < k1 then Coll.B4(Coll.bRep(a, k, v), k1, v1, b, k2, v2, c, k3, v3, d)
    else if k == k1 then Coll.B4(a, k1, v, b, k2, v2, c, k3, v3, d)
    else if k < k2 then Coll.B4(a, k1, v1, Coll.bRep(b, k, v), k2, v2, c, k3, v3, d)
    else if k == k2 then Coll.B4(a, k1, v1, b, k2, v, c, k3, v3, d)
    else if k < k3 then Coll.B4(a, k1, v1, b, k2, v2, Coll.bRep(c, k, v), k3, v3, d)
    else if k == k3 then Coll.B4(a, k1, v1, b, k2, v2, c, k3, v, d)
    else Coll.B4(a, k1, v1, b, k2, v2, c, k3, v3, Coll.bRep(d, k, v))

