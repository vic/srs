// the value binder named like token j (its text), in the binders of the kParams node vp
def Parser.binderNamed(g: Ast.G, bl: I64, i: I64, j: I64): Bool =
  if i < Ast.len(g, bl) then
    if Str.eq(Ast.text(g, Ast.tok(g, Ast.item(g, bl, i))), Ast.text(g, j)) then true else Parser.binderNamed(g, bl, i + 1, j)
  else false

