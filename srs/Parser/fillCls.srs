def Parser.fillCls(src: Str, n: I64, tcap: I64, ks: Array[U8](tcap), os: Array[U32](tcap), ls: Array[U32](tcap), t: I64, cls: Array[U8](tcap), j: I64): Unit =
  if 0 <= j && j < t && j < tcap then
    Array.put(cls, j, U8.of(Parser.classOf(src, n, I64.ofU8(ks(j)), I64.of(os(j)), I64.of(ls(j)))))
    Parser.fillCls(src, n, tcap, ks, os, ls, t, cls, j + 1)
  else ()

