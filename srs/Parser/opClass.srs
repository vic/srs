// prompt: the token class of an operator token of length l at o (byte c): one class per one-byte operator of Lexer.isPunct (`@` = Token.at),
// the two-byte operators, >>> (shr); anything else Token.other.
def Parser.opClass(src: Str, n: I64, o: I64, l: I64): I64 =
  val c = Str.at(src, o)
  if l == 1 then
    if c == 40 then Token.lp()
    else if c == 41 then Token.rp()
    else if c == 91 then Token.lb()
    else if c == 93 then Token.rb()
    else if c == 123 then Token.lc()
    else if c == 125 then Token.rc()
    else if c == 44 then Token.comma()
    else if c == 58 then Token.colon()
    else if c == 61 then Token.eq()
    else if c == 46 then Token.dot()
    else if c == 60 then Token.lt()
    else if c == 62 then Token.gt()
    else if c == 124 then Token.bar()
    else if c == 94 then Token.caret()
    else if c == 38 then Token.amp()
    else if c == 43 then Token.plus()
    else if c == 45 then Token.minus()
    else if c == 42 then Token.star()
    else if c == 47 then Token.slash()
    else if c == 37 then Token.pct()
    else if c == 33 then Token.bang()
    else if c == 126 then Token.tilde()
    else if c == 64 then Token.at()
    else Token.other()
  else if l == 2 then
    if c == 61 && Lexer.is(src, n, o + 1, 62) then Token.arrow()
    else if c == 61 && Lexer.is(src, n, o + 1, 61) then Token.eqeq()
    else if c == 33 && Lexer.is(src, n, o + 1, 61) then Token.ne()
    else if c == 60 && Lexer.is(src, n, o + 1, 61) then Token.le()
    else if c == 62 && Lexer.is(src, n, o + 1, 61) then Token.ge()
    else if c == 38 && Lexer.is(src, n, o + 1, 38) then Token.andand()
    else if c == 124 && Lexer.is(src, n, o + 1, 124) then Token.oror()
    else if c == 60 && Lexer.is(src, n, o + 1, 60) then Token.shl()
    else if c == 62 && Lexer.is(src, n, o + 1, 62) then Token.shr()
    else Token.other()
  else if l == 3 then Token.shr()
  else Token.other()

