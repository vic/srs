// tokens. the class of token j is Kc.eof outside [0, hi) (hi = the end of the decl being parsed)
def Ast.cls(g: Ast.G, j: I64): I64 =
  val Ast.G(tk, _, _, _) = g
  val Ast.Tk(_, tcap, cls, _, _, t) = tk
  if 0 <= j && j < t && j < tcap && j < Ast.cget(g, Ast.sHi()) then I64.ofU8(cls(j)) else Token.eof()

