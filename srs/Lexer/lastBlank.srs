// the last token is a blank-line Doc (a Doc of length 0): s2 keeps one per run of blank lines
def Lexer.lastBlank(cap: I64, ks: Array[U8](cap), ls: Array[U32](cap), t: I64): Bool =
  val q = t - 1
  if 0 <= q && q < cap then I64.ofU8(ks(q)) == Lexer.kindByte(Lexer.KDoc) && I64.of(ls(q)) == 0
  else false

