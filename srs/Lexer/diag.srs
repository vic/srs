// a diag at i, then on from e in position p
def Lexer.diag(src: Str, n: I64, nt: Lexer.Notes, i: I64, e: I64, w: Lexer.Why, cap: I64, ks: Array[U8](cap), os: Array[U32](cap), ls: Array[U32](cap), t: I64, dcap: I64, dc: Array[U8](dcap), dof: Array[U32](dcap), d: I64, scap: I64, st: Array[U32](scap), sp: I64, depth: I64, pos: Lexer.Pos): Lexer.Out =
  Lexer.putDiag(dcap, dc, dof, d, w, i)
  Lexer.go(src, n, nt, e, cap, ks, os, ls, t, dcap, dc, dof, d + 1, scap, st, sp, depth, pos)

