def Lexer.kindName(k: Lexer.Kind): Str = k match
  case Lexer.KIdent => "ident"
  case Lexer.KInt => "int"
  case Lexer.KStr => "str"
  case Lexer.KChar => "char"
  case Lexer.KOp => "op"
  case Lexer.KLtGlued => "ltglued"
  case Lexer.KNl => "nl"
  case Lexer.KIndent => "indent"
  case Lexer.KDedent => "dedent"
  case Lexer.KDoc => "doc"

