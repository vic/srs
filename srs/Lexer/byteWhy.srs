def Lexer.byteWhy(c: I64): Coll.Option[Lexer.Why] =
  if c == 0 then Coll.Some(Lexer.Tab)
  else if c == 1 then Coll.Some(Lexer.BadChar)
  else if c == 2 then Coll.Some(Lexer.Unterminated)
  else if c == 3 then Coll.Some(Lexer.BigHex)
  else if c == 4 then Coll.Some(Lexer.BadDedent)
  else if c == 5 then Coll.Some(Lexer.Overflow)
  else Coll.None

