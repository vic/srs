// a token [i, e) of kind k, then on from e with depth dp
def Lexer.emit(src: Str, n: I64, nt: Lexer.Notes, i: I64, e: I64, k: Lexer.Kind, cap: I64, ks: Array[U8](cap), os: Array[U32](cap), ls: Array[U32](cap), t: I64, dcap: I64, dc: Array[U8](dcap), dof: Array[U32](dcap), d: I64, scap: I64, st: Array[U32](scap), sp: I64, dp: I64, pos: Lexer.Pos): Lexer.Out =
  val inc = Lexer.putTok(cap, ks, os, ls, t, k, i, e - i, dcap, dc, dof, d)
  Lexer.go(src, n, nt, e, cap, ks, os, ls, t + 1, dcap, dc, dof, d + inc, scap, st, sp, dp, pos)

