// at a line start with depth 0 (s2 Lex.go, bol branch): the indent of the line
def Lexer.lineStart(src: Str, n: I64, nt: Lexer.Notes, i: I64, cap: I64, ks: Array[U8](cap), os: Array[U32](cap), ls: Array[U32](cap), t: I64, dcap: I64, dc: Array[U8](dcap), dof: Array[U32](dcap), d: I64, scap: I64, st: Array[U32](scap), sp: I64, depth: I64, pos: Lexer.Pos): Lexer.Out =
  val j = Lexer.spaces(src, n, i)
  if j >= n then Lexer.go(src, n, nt, j, cap, ks, os, ls, t, dcap, dc, dof, d, scap, st, sp, depth, Lexer.Mid)
  else Lexer.lineAt(src, n, nt, i, j, j - i, Str.at(src, j), cap, ks, os, ls, t, dcap, dc, dof, d, scap, st, sp, depth, pos)

