def Lexer.byteKind(c: I64): Coll.Option[Lexer.Kind] =
  if c == 0 then Coll.Some(Lexer.KIdent)
  else if c == 1 then Coll.Some(Lexer.KInt)
  else if c == 2 then Coll.Some(Lexer.KStr)
  else if c == 3 then Coll.Some(Lexer.KChar)
  else if c == 4 then Coll.Some(Lexer.KOp)
  else if c == 5 then Coll.Some(Lexer.KLtGlued)
  else if c == 6 then Coll.Some(Lexer.KNl)
  else if c == 7 then Coll.Some(Lexer.KIndent)
  else if c == 8 then Coll.Some(Lexer.KDedent)
  else if c == 9 then Coll.Some(Lexer.KDoc)
  else Coll.None

