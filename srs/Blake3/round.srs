def Blake3.round(n: I64, v: Array[U32](n), mn: I64, m: Array[U32](mn)): Unit =
  if 15 < mn then
    Blake3.g(n, v, 0, 4, 8, 12, m(0), m(1))
    Blake3.g(n, v, 1, 5, 9, 13, m(2), m(3))
    Blake3.g(n, v, 2, 6, 10, 14, m(4), m(5))
    Blake3.g(n, v, 3, 7, 11, 15, m(6), m(7))
    Blake3.g(n, v, 0, 5, 10, 15, m(8), m(9))
    Blake3.g(n, v, 1, 6, 11, 12, m(10), m(11))
    Blake3.g(n, v, 2, 7, 8, 13, m(12), m(13))
    Blake3.g(n, v, 3, 4, 9, 14, m(14), m(15))
  else ()

