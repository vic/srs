def Blake3.perm(i: I64): I64 =
  if i == 0 then 2 else if i == 1 then 6 else if i == 2 then 3 else if i == 3 then 10
  else if i == 4 then 7 else if i == 5 then 0 else if i == 6 then 4 else if i == 7 then 13
  else if i == 8 then 1 else if i == 9 then 11 else if i == 10 then 12 else if i == 11 then 5
  else if i == 12 then 9 else if i == 13 then 14 else if i == 14 then 15 else 8

