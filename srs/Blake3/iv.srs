// B3: BLAKE3 (unkeyed, 32-byte output) after the reference implementation of the BLAKE3 paper: 7-round compression,
// 1024-byte chunks of 64-byte blocks, a binary tree whose left subtree holds the largest power of two of chunks below n
def Blake3.iv(i: I64): U32 =
  if i == 0 then U32.of(1779033703)
  else if i == 1 then U32.of(3144134277)
  else if i == 2 then U32.of(1013904242)
  else if i == 3 then U32.of(2773480762)
  else if i == 4 then U32.of(1359893119)
  else if i == 5 then U32.of(2600822924)
  else if i == 6 then U32.of(528734635)
  else U32.of(1541459225)

