// prompt: s2 corpus neg handle_row_end: the kernel must reject it with exactly these codes (s2 expects error[region-ended-under-handle])
val NegTests.S2.handle_row_end {NegTest}: Never =
  enum Bx:
    case Bx(v: I64)
  capability Bp:
    def mk(n: I64): Bx

  handler Hb for Bp:
    def mk(n: I64): Bx = Bx(n)

  def Bx.get(b: Bx): I64 = b match
    case Bx(v) => v

  def main(): I64 =
    handle io = Srs.Console()
    handle r = Srs.Arena()
    handle h = Hb()
    val a = Bp.mk(1)
    r.free()
    val b = Bp.mk(2)
    Console.printI64(7)
    0
  NegTest.expect("region-ended-under-handle", "the s2 corpus expects error[region-ended-under-handle] for handle_row_end")

