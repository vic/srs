// prompt: s2 corpus neg given_none: the kernel must reject it with exactly these codes (s2 expects error[no-given])
val NegTests.S2.given_none {NegTest}: Never =
  trait Show [A: Type]:
    def show(x: A): I64
  def print [A: Type] {s: Show[A]} (x: A): I64 = s.show(x)
  given Show[I64]:
    def show(x: I64): I64 = x
  def main(): I64 = print(true)
  NegTest.expect("no-given", "the s2 corpus expects error[no-given] for given_none")

