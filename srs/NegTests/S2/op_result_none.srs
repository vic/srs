// prompt: s2 corpus neg op_result_none: the kernel must reject it with exactly these codes (s2 expects error[op-result-choice])
val NegTests.S2.op_result_none {NegTest}: Never =
  capability Scratch:
    state Building, Viewed
    start Building
    stop Building, Viewed
    def view <Building> (): View{} <Viewed>

  handler HScratch for Scratch:
    def view(): Ptr = Srs.noState()

  type View {b: Scratch} <b: Viewed> = Ptr

  def main(): I64 =
    handle b = HScratch()
    0
  NegTest.expect("mismatch", "ptr-outside-srs", "arith-unproved", "untyped", "s2 expects error[op-result-choice] for op_result_none; s4 rejects it with other codes (code fidelity gap)")


