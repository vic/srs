// prompt: s2 corpus neg handler_ptr_region: the kernel must reject it with exactly these codes (s2 expects error[capability-bound])
val NegTests.S2.handler_ptr_region {NegTest}: Never =
  capability Pool:
    state Open, Shut
    start Open
    stop Shut
    def take <Open> (n: I64): Ptr<self> <Open>
    def shut <Open> (): Unit <Shut>
    drop shut

  handler HPool for Pool:
    def take(n: I64): Ptr = Srs.Region.alloc(n)
    def shut(): Unit = ()

  def peek(p: Ptr): I64 = 7

  def main(): I64 =
    handle a = Srs.Arena()
    handle p = HPool()
    val x = p.take(8)
    a.free()
    val n = peek(x)
    p.shut()
    n
  NegTest.expect("ptr-outside-srs", "arith-unproved", "mismatch", "s2 expects error[capability-bound] for handler_ptr_region; s4 rejects it with other codes (code fidelity gap)")


