  def peek(p: Ptr): I64 = 7
  def grab {r: Srs.Region} <r: Open> (): I64 <r: Freed> =
    val p = r.alloc(8)
    r.free()
    peek(p)
  def main(): I64 =
    handle tmp = Srs.Arena()
    grab{tmp}()
