// prompt: s2 corpus neg op_result_escape: the kernel must reject it with exactly these codes (s2 expects error[region-escape]); K3 part 2 (allocation needs a Region cover) adds unhandled-effect in main
val NegTests.S2.op_result_escape {NegTest}: Never =
  capability Oe:
    def get(): Str

  handler Hoe for Oe:
    def get(): Str =
      handle r = Srs.Arena()
      val n = 3
      val xs: Array[U8](n) = Array.fill(n, U8.of(65))
      Str.ofBytes(n, xs)

  def main(): I64 =
    handle io = Srs.Console()
    handle h = Hoe()
    Console.print(Oe.get())
    0
  NegTest.expect("region-escape", "arith-unproved", "unhandled-effect", "the s2 corpus expects error[region-escape] for op_result_escape")