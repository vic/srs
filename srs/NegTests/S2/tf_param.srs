// prompt: s2 corpus neg tf_param: the kernel must reject it with exactly these codes (s2 expects error[stale-value])
val NegTests.S2.tf_param {NegTest}: Never =
  capability Scratch:
    state Building, Viewed, Gone
    start Building
    stop Gone
    def add <Building> (s: Str): Unit <Building>
    def view <Building> (): Ptr <Viewed>
    def clear <Viewed> (): Unit <Building>
    transition ends Building -> Gone, Viewed -> Gone
    def done <s ends t> (): Unit <t>

  handler HScratch for Scratch:
    def add(s: Str): Unit = ()
    def view(): Ptr = Srs.noState()
    def clear(): Unit = ()
    def done(): Unit = ()

  type View {b: Scratch} <b: Viewed> = Ptr
  extern def I6.viewOf {b: Scratch} <b: Viewed> (p: Ptr): View
  def I6.hash {b: Scratch} <b: Viewed> (v: View): I64 = 7
  def I6.keep(p: Ptr): I64 = 0
  def I6.later {b: Scratch} <b: Viewed> (v: View): I64 <b: Building> =
    b.clear()
    I6.keep(v)
  def main(): I64 = 0
  NegTest.expect("ptr-outside-srs", "s2 expects error[stale-value] for tf_param; s4 rejects it with other codes (code fidelity gap)")

