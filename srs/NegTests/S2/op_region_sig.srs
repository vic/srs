// prompt: s2 corpus neg op_region_sig: the kernel must reject it with exactly these codes (s2 expects error[op-signature])
val NegTests.S2.op_region_sig {NegTest}: Never =
  capability Rs:
    def mk {r: Srs.Region} (n: I64): Str<r>

  handler Hrs for Rs:
    def mk(n: I64): Str = "x"

  def main(): I64 =
    handle io = Srs.Console()
    handle a = Srs.Arena()
    handle h = Hrs()
    Console.print(Rs.mk(3))
    0
  NegTest.expect("op-signature", "the s2 corpus expects error[op-signature] for op_region_sig")

