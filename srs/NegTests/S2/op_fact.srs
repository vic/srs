// prompt: s2 corpus neg op_fact: the kernel must reject it with exactly these codes (s2 expects error[stale-value])
val NegTests.S2.op_fact {NegTest}: Never =
  capability Scratch:
    state Building, Viewed, Gone
    start Building
    stop Gone
    def add <Building> (s: Str): Unit <Building>
    def view <Building> (): View{self} <Viewed>
    def clear <Viewed> (): Unit <Building>
    transition ends Building -> Gone, Viewed -> Gone
    def done <s ends t> (): Unit <t>

  handler HScratch for Scratch:
    def add(s: Str): Unit = ()
    def view(): Ptr = Srs.noState()
    def clear(): Unit = ()
    def done(): Unit = ()

  type View {b: Scratch} <b: Viewed> = Ptr
  def peek(p: Ptr): I64 = 7

  def main(): I64 =
    handle b = HScratch()
    val p = b.view()
    b.done()
    peek(p)
  NegTest.expect("mismatch", "ptr-outside-srs", "arith-unproved", "untyped", "s2 expects error[stale-value] for op_fact; s4 rejects it with other codes (code fidelity gap)")


