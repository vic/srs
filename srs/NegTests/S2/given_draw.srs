// prompt: s2 corpus neg given_draw: the kernel must reject it with exactly these codes (s2 expects error[ambiguous-givens])
val NegTests.S2.given_draw {NegTest}: Never =
  trait Show [A: Type]:
    def show(x: A): I64
  def print [A: Type] {s: Show[A]} (x: A): I64 = s.show(x)
  given {t: Show[Bool]} Show[I64]:
    def show(x: I64): I64 = 1
  given {u: Show[Bool]} Show[I64]:
    def show(x: I64): I64 = 2
  given Show[Bool]:
    def show(x: Bool): I64 = 0
  def main(): I64 = print(1)
  NegTest.expect("ambiguous-givens", "given-fuel", "the s2 corpus expects error[ambiguous-givens] for given_draw")

