// prompt: s2 corpus neg word_mix: the kernel must reject it with exactly these codes (s2 expects error[mismatch])
val NegTests.S2.word_mix {NegTest}: Never =
  def f(x: U32, n: I64): U32 =
    val y = x + 1
    y + n
  def main(): I64 = 0
  NegTest.expect("mismatch", "the s2 corpus expects error[mismatch] for word_mix")

