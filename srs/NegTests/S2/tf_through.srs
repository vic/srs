// prompt: s2 corpus neg tf_through: the kernel must reject it with exactly these codes (s2 expects error[capability-bound])
val NegTests.S2.tf_through {NegTest}: Never =
  capability Scratch:
    state Building, Viewed, Gone
    start Building
    stop Gone
    def add <Building> (s: Str): Unit <Building>
    def view <Building> (): Ptr <Viewed>
    def clear <Viewed> (): Unit <Building>
    transition ends Building -> Gone, Viewed -> Gone
    def done <s ends t> (): Unit <t>

  handler HScratch for Scratch:
    def add(s: Str): Unit = ()
    def view(): Ptr = Srs.noState()
    def clear(): Unit = ()
    def done(): Unit = ()

  type View {b: Scratch} <b: Viewed> = Ptr
  extern def I6.viewOf {b: Scratch} <b: Viewed> (p: Ptr): View
  def I6.hash {b: Scratch} <b: Viewed> (v: View): I64 = 7
  def I6.keep(p: Ptr): I64 = 0
  def I6.same {b: Scratch} <b: Viewed> (v: View): View = v
  def main(): I64 =
    handle o = HScratch()
    handle b1 = HScratch()
    val ov = I6.viewOf{o}(o.view())
    val v = I6.viewOf{b1}(b1.view())
    val w = I6.same{o}(v)
    b1.clear()
    val n = I6.keep(w)
    o.done()
    b1.done()
    n
  NegTest.expect("ptr-outside-srs", "arith-unproved", "mismatch", "untyped", "extern-denied", "s2 expects error[capability-bound] for tf_through; s4 rejects it with other codes (code fidelity gap)")



