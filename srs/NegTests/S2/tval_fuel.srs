// prompt: s2 corpus neg tval_fuel: the kernel must reject it with exactly these codes (s2 expects error[no-compile-time-value])
val NegTests.S2.tval_fuel {NegTest}: Never =
  type Bits (n: I64) = n match
    case 8 => Bool
    case _ => I64
  def spin(n: I64): I64 =
    var i = 0
    while true do
      i = i + 1
    i
  def tf(x: Bits(spin(1))): I64 = x
  def main(): I64 = 0
  NegTest.expect("missingEntry", "no-compile-time-value", "untyped", "the s2 corpus expects error[no-compile-time-value] for tval_fuel")

