// prompt: s2 corpus neg tf_aba: the kernel must reject it with exactly these codes (s2 expects error[stale-value])
val NegTests.S2.tf_aba {NegTest}: Never =
  capability Scratch:
    state Building, Viewed, Gone
    start Building
    stop Gone
    def add <Building> (s: Str): Unit <Building>
    def view <Building> (): Ptr <Viewed>
    def clear <Viewed> (): Unit <Building>
    transition ends Building -> Gone, Viewed -> Gone
    def done <s ends t> (): Unit <t>

  handler HScratch for Scratch:
    def add(s: Str): Unit = ()
    def view(): Ptr = Srs.noState()
    def clear(): Unit = ()
    def done(): Unit = ()

  type View {b: Scratch} <b: Viewed> = Ptr
  extern def I6.viewOf {b: Scratch} <b: Viewed> (p: Ptr): View
  def I6.hash {b: Scratch} <b: Viewed> (v: View): I64 = 7
  def I6.keep(p: Ptr): I64 = 0

  def I6.two {b: Scratch} <b: Building> (): I64 <b: Viewed> =
    b.add("Derive(")
    val v: View = I6.viewOf(b.view())
    b.clear()
    b.add("text")
    val w: View = I6.viewOf(b.view())
    I6.keep(v) + I6.hash(w)
  def main(): I64 =
    handle b = HScratch()
    val n = I6.two()
    b.done()
    n
  NegTest.expect("ptr-outside-srs", "arith-unproved", "mismatch", "untyped", "extern-denied", "s2 expects error[stale-value] for tf_aba; s4 rejects it with other codes (code fidelity gap)")



