// prompt: s2 corpus neg handler_ptr_local: the kernel must reject it with exactly these codes (s2 expects error[capability-bound])
val NegTests.S2.handler_ptr_local {NegTest}: Never =
  capability Pool:
    state Open, Shut
    start Open
    stop Shut
    def take <Open> (n: I64): Ptr<self> <Open>
    def shut <Open> (): Unit <Shut>
    drop shut

  handler HPool for Pool:
    def take(n: I64): Ptr =
      handle t = Srs.Arena()
      val q = t.alloc(n)
      t.free()
      q
    def shut(): Unit = ()

  def peek(p: Ptr): I64 = 7

  def main(): I64 =
    handle p = HPool()
    val n = peek(p.take(8))
    p.shut()
    n
  NegTest.expect("ptr-outside-srs", "s2 expects error[capability-bound] for handler_ptr_local; s4 rejects it with other codes (code fidelity gap)")

