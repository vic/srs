// with exactly error[reserved-name] (F5e badReserved): Srs.* names belong to the trusted image.
val NegTests.S2.srs_name_forge {NegTest}: Never =
  extern def rt_print(s: Str): Unit
  capability Forge:
    def go(): Unit
  handler Srs.Forge for Forge:
    def go(): Unit = rt_print("forged\n")
  def main(): I64 =
    handle f = Srs.Forge()
    Forge.go()
    0
  NegTest.expect("reserved-name", "arith-unproved", "rt-outside-srs", "extern-denied", "the s2 corpus expects error[reserved-name]: a user Srs.* handler could call any rt_* extern")


