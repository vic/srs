// prompt: s2 corpus neg op_ptr: the kernel must reject it with exactly these codes (s2 expects error[use-after-free])
val NegTests.S2.op_ptr {NegTest}: Never =
  def peek(p: Ptr): I64 = 7
  def main(): I64 =
    handle tmp = Srs.Arena()
    val p = tmp.alloc(8)
    tmp.free()
    peek(p)
  NegTest.expect("ptr-outside-srs", "s2 expects error[use-after-free] for op_ptr; s4 rejects it with other codes (code fidelity gap)")

