// prompt: s2 corpus neg op_region_noregion: the kernel must reject it with exactly these codes (s2 expects error[no-capability])
val NegTests.S2.op_region_noregion {NegTest}: Never =
  capability Rn:
    def mk {r: Srs.Region} (n: I64): Str<r>

  handler Hrn for Rn:
    def mk {r: Srs.Region} (n: I64): Str<r> =
      val xs: Array[U8](n) = Array.fill(n, U8.of(65))
      Str.ofBytes(n, xs)

  def main(): I64 =
    handle io = Srs.Console()
    handle h = Hrn()
    Console.print(Rn.mk(3))
    0
  NegTest.expect("no-capability", "the s2 corpus expects error[no-capability] for op_region_noregion")

