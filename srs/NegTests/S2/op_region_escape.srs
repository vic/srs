// prompt: s2 corpus neg op_region_escape: the kernel must reject it with exactly these codes (s2 expects error[region-escape])
val NegTests.S2.op_region_escape {NegTest}: Never =
  capability Rg:
    def mk {r: Srs.Region} (n: I64): Str<r>

  handler Hrg for Rg:
    def mk {r: Srs.Region} (n: I64): Str<r> =
      val xs: Array[U8](n) = Array.fill(n, U8.of(65))
      Str.ofBytes(n, xs)

  def main(): I64 =
    handle io = Srs.Console()
    handle a = Srs.Arena()
    handle h = Hrg()
    val s: Str =
      handle b = Srs.Arena()
      Rg.mk(3)
    Console.print(s)
    0
  NegTest.expect("region-escape", "the s2 corpus expects error[region-escape] for op_region_escape")

