// prompt: s2 corpus neg array_grow_copy_unproved: the kernel must reject it with exactly these codes (s2 expects error[index-unproved])
val NegTests.S2.array_grow_copy_unproved {NegTest}: Never =
  def G.copy(n: I64, xs: Array[I64](n), m: I64, ys: Array[I64](m), i: I64): Unit =
    if 0 <= i && i < n then
      Array.put(ys, i, xs(i))
      G.copy(n, xs, m, ys, i + 1)
    else ()
  def main(): I64 = 0
  NegTest.expect("index-unproved", "the s2 corpus expects error[index-unproved] for array_grow_copy_unproved")

