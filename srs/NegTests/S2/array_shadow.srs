// prompt: s2 corpus neg array_shadow: the kernel must reject it with exactly these codes (s2 expects error[index-unproved])
val NegTests.S2.array_shadow {NegTest}: Never =
  def Ar.get(n: I64, xs: Array[I64](n), i: I64): I64 =
    val k = n + 100
    if 0 <= i && i < k then
      val n = k
      if i < n then xs(i) else 0
    else 0
  def main(): I64 = 0
  NegTest.expect("index-unproved", "arith-unproved", "the s2 corpus expects error[index-unproved] for array_shadow")


