// prompt: s2 corpus neg ms_shape_nested: the kernel must reject it with exactly these codes (s2 expects error[multishot-shape])
val NegTests.S2.ms_shape_nested {NegTest}: Never =
  capability NonDet:
    def choose(): Bool
  handler Count [A: Type] for NonDet:
    def done(x: A): I64 = 1
    def choose(k): I64 = resume k(true) + resume k(false)
  def main(): I64 =
    handle nd = Count()
    val x = if NonDet.choose() then 1 else 2
    x
  NegTest.expect("multishot-shape", "the s2 corpus expects error[multishot-shape] for ms_shape_nested")

