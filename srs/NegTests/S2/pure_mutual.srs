// prompt: s2 corpus neg pure_mutual: the kernel must reject it with exactly these codes (s2 expects error[impure-call])
val NegTests.S2.pure_mutual {NegTest}: Never =
  def pe(n: I64): Bool = if n == 0 then true else po(n - 1)
  def po(n: I64): Bool =
    Console.print("o")
    if n == 0 then false else pe(n - 1)
  val g: Bool = pe(3)
  def main(): I64 = 0
  NegTest.expect("impure-call", "arith-unproved", "the s2 corpus expects error[impure-call] for pure_mutual")


