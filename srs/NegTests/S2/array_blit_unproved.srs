// prompt: s2 corpus neg array_blit_unproved: the kernel must reject it with exactly these codes (s2 expects error[index-unproved])
val NegTests.S2.array_blit_unproved {NegTest}: Never =
  def B.put(n: I64, xs: Array[U8](n), at: I64, s: Str): Unit =
    val m = Str.len(s)
    Array.blit(xs, at, s, m)
  def main(): I64 = 0
  NegTest.expect("index-unproved", "the s2 corpus expects error[index-unproved] for array_blit_unproved")

