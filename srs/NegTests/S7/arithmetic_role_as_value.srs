// prompt: the kernel must reject an arithmetic kernel unit used as a value: a later call through it escapes the site check (K2 H2).
val NegTests.S7.arithmetic_role_as_value {NegTest}: Never =
  def Arithmetic.rejected(value: U64): U64 =
    val remainder = U64.remainder
    value
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "U64.remainder used as a value escapes the divisor check at its calls")

