// prompt: the kernel must reject `a - U64.of(1)` with no guard: 0 - 1 goes below zero.
val NegTests.S7.arithmetic_minus_one_unguarded {NegTest}: Never =
  def Arithmetic.rejected(a: U64): U64 = a - U64.of(1)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "a - 1 without a guard 0 < a goes below zero at a == 0")

