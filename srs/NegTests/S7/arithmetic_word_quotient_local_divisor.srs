// prompt: the kernel must reject U64.quotient(value, divisor) with a divisor that is no literal: no row proves it is not zero.
val NegTests.S7.arithmetic_word_quotient_local_divisor {NegTest}: Never =
  def Arithmetic.rejected(value: U64, divisor: U32): U64 = U64.quotient(value, divisor)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "a divisor that is no literal can be zero")

