// prompt: the kernel must reject U32.of(4294967296): the value does not fit 32 unsigned bits.
val NegTests.S7.arithmetic_unsigned_word_too_large {NegTest}: Never =
  def Arithmetic.rejected(): U32 = U32.of(4294967296)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "U32 holds 0 to 4294967295; 4294967296 keeps only its low 32 bits")

