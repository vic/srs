// prompt: the kernel must reject U64.quotient with one argument: the site exists at any arity, the shape only at two.
val NegTests.S7.arithmetic_word_quotient_one_argument {NegTest}: Never =
  def Arithmetic.rejected(value: U64): U64 = U64.quotient(value)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "mismatch", "a quotient call with one argument has no proved shape")

