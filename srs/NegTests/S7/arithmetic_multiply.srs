// prompt: the kernel must reject a product of two values: no proved form bounds it.
val NegTests.S7.arithmetic_multiply {NegTest}: Never =
  def Arithmetic.rejected(a: I64, b: I64): I64 = a * b
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "a * b has no proved form; it can pass the largest I64")

