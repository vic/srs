// prompt: the kernel must reject the negation of a binder: -a of the smallest I64 has no I64.
val NegTests.S7.arithmetic_negate_binder {NegTest}: Never =
  def Arithmetic.rejected(a: I64): I64 = -a
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "-a of the smallest I64 has no I64; only a literal may be negated")

