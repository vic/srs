// prompt: the kernel must reject U8.of(-1): a negative value has no byte (the low 8 bits would read 255).
val NegTests.S7.arithmetic_byte_of_negative {NegTest}: Never =
  def Arithmetic.rejected(): U8 = U8.of(-1)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "-1 has no byte; keeping the low 8 bits would read 255")

