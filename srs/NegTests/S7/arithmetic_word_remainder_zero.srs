// prompt: the kernel must reject U64.remainder(value, 0): a remainder by zero has no result (K2 F5').
val NegTests.S7.arithmetic_word_remainder_zero {NegTest}: Never =
  def Arithmetic.rejected(value: U64): U64 = U64.remainder(value, 0)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "a remainder by zero has no result; the divisor must be a literal other than 0")

