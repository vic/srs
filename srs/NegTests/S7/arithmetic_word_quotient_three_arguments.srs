// prompt: the kernel must reject U64.quotient with three arguments: the site exists at any arity, the shape only at two.
val NegTests.S7.arithmetic_word_quotient_three_arguments {NegTest}: Never =
  def Arithmetic.rejected(value: U64): U64 = U64.quotient(value, 10, 3)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "mismatch", "a quotient call with three arguments has no proved shape")

