// prompt: the kernel must reject a call with no resolved callee: its arithmetic is unknown, so it is a site with no proof (K2 H1).
val NegTests.S7.arithmetic_unresolved_call {NegTest}: Never =
  def Arithmetic.rejected(value: U64): U64 = Missing.step(value)
  def main(): I64 = 0
  NegTest.expect("arith-unproved", "untyped", "Missing.step resolves to no unit, so the call has no proved form")

