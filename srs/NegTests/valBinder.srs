// prompt: the kernel must reject a value binder of a type decl whose type is not I64 or Bool, with error[value-binder-type]
val NegTests.valBinder {NegTest}: Never =
  type NtVb.P (p: Str) = I64
  NegTest.expect("value-binder-type", "a value binder of a type is an I64 or a Bool; Str is no compile-time value kind")

