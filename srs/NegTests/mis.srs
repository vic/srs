// a negative test: a local val of the wrong type
// prompt: the kernel must reject a Str value bound to an I64 val with error[mismatch].
val NegTests.mis {NegTest}: Never =
  def main(): I64 =
    val a: I64 = "x"
    a
  NegTest.expect("mismatch", "a Str literal is not an I64: the val type and its value must agree")

