// prompt: the kernel must reject a block value made by a Region op inside an Arena that the block closes, with error[region-escape].
val NegTests.opRegionEsc {NegTest}: Never =
  capability Rg:
    def mk {r: Srs.Region} (n: I64): Str<r>
  handler Hrg for Rg:
    def mk {r: Srs.Region} (n: I64): Str<r> =
      val xs: Array[U8](n) = Array.fill(n, U8.of(65))
      Str.ofBytes(n, xs)
  def main(): I64 =
    handle io = Srs.Console()
    handle a = Srs.Arena()
    handle h = Hrg()
    val s: Str =
      handle b = Srs.Arena()
      Rg.mk(3)
    Console.print(s)
    0
  NegTest.expect("region-escape", "the op result lives in the innermost Arena b, which closes at the end of the block that returns it")

