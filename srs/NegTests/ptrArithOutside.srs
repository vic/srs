// prompt: int-to-pointer casts (rt_ptr_of) outside the allocator Srs.Arena.* must be rejected with error[ptr-arith-outside-allocator]
// (F5e badPtrArith, fil-c FC51/55); a NegTest body is user code, so its Srs.* unit is also error[reserved-name].
val NegTests.ptrArithOutside {NegTest}: Never =
  def Srs.NtPa.forge(a: U64): Srs.Mem = rt_ptr_of(a)
  NegTest.expect("reserved-name", "ptr-arith-outside-allocator", "only the allocator Srs.Arena.* may make a pointer from an address; Srs.NtPa.forge is no allocator unit")