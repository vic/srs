// a negative test: an array length literal of at least 2^32
// prompt: the kernel must give no length fact for Array[U8](2^32 + 4) (never the wrapped 4), so a(3) is unproved (fail closed:
// a true length above the fact column is never used).
val NegTests.lengthLiteralWide {NegTest}: Never =
  def Probe.lengthWide(a: Array[U8](4294967300)): U8 = a(3)
  NegTest.expect("index-unproved", "4294967300 is above the 32-bit fact column: no alenLit fact, so a(3) is unproved")

