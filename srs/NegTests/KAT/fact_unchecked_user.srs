// prompt: K-AT neg: an atom on a relation that is not a kernel relation is fact-unchecked.
val NegTests.KAT.fact_unchecked_user {NegTest}: Never =
  def G.pick(i: U64, n: U64): U64 =
    if i < n then
      @<foo(i, n)>
      i
    else n
  def main(): I64 = 0
  NegTest.expect("fact-unchecked", "foo names no kernel relation, so the gate cannot check it")