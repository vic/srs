// prompt: K3 NEG: an enum with two value params is not carried by the typer.
val NegTests.K3.value_param_two {NegTest}: Never =
  enum K3.Neg.TwoSizes (a: U64, b: U64):
    case K3.Neg.Pair(x: Array[U8](a))
