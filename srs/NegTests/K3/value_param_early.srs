// prompt: K3 NEG: a value param group before a [] group is rejected.
val NegTests.K3.value_param_early {NegTest}: Never =
  enum K3.Neg.EarlyBox (n: U64) [A: Type]:
    case K3.Neg.Full(x: Array[U8](n))
  NegTest.expect("value-param-shape", "the value param is the last type arg of the enum; before a [] group it is rejected")

