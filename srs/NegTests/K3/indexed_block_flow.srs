// prompt: K3 NEG: an allocation of m bytes is no allocation of n bytes.
val NegTests.K3.indexed_block_flow {NegTest}: Never =
  def K3.Neg.flow(n: U64, m: U64, r: K3.Probe.Allocation(m), index: U64): U8 = K3.Probe.byteAt(n, r, index, U8.of(0))
  NegTest.expect("mismatch", "Allocation(m) passed where Allocation(n) is expected: the sizes are two different values")

