// a given defines a fn its trait does not declare
// prompt: the kernel must reject a given that defines a method its trait lacks, with error[not-a-method].
val NegTests.traitExtra {NegTest}: Never =
  trait Show [A: Type]:
    def show(x: A): I64
  given Show[I64]:
    def show(x: I64): I64 = x
    def extra(x: I64): I64 = x
  NegTest.expect("not-a-method", "a given defines only the methods its trait declares")

