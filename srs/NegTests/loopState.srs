// prompt: a loop whose body moves a capability forward each turn must be rejected with op-not-allowed when a later turn reaches a state that forbids the operation.
val NegTests.loopState {NegTest}: Never =
  capability ZqFile:
    state R0, R1, R2, Done
    start R0
    stop Done
    transition rd R0 -> R1, R1 -> R2
    transition cl R0 -> Done, R1 -> Done, R2 -> Done
    def read <s rd t> (): I64 <t>
    def close <s cl t> (): Unit <t>
  handler ZqH for ZqFile:
    def read(): I64 = 1
    def close(): Unit = ()
  def main(): I64 =
    handle f = ZqH()
    var i = 0
    while i < 2 do
      f.read()
      i = i + 1
    f.close()
    0
  NegTest.expect("op-not-allowed", "each turn reads once; a third turn would read in R2, so the loop is not safe for every turn count")