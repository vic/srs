// prompt: an allocation in an arena region after the region is freed: the kernel must reject the allocating call with op-not-allowed.
val NegTests.allocAfterFree {NegTest}: Never =
  enum ZqList:
    case ZqNil
    case ZqCons(h: I64, t: ZqList)
  def zqBuild {r: Srs.Region} (n: I64): ZqList =
    if n == 0 then ZqNil else ZqCons(n, zqBuild(n - 1))
  def zqSum(xs: ZqList): I64 =
    xs match
      case ZqNil => 0
      case ZqCons(h, t) => h + zqSum(t)
  def main(): I64 =
    handle r = Srs.Arena()
    r.free()
    zqSum(zqBuild(2))
  NegTest.expect("op-not-allowed", "zqBuild allocates in region r after r.free(): the freed region allows no more allocation")

