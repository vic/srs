def Planner.driverAt(b: Planner.Atoms, d: I64, i: I64, g: Planner.G): Planner.G = b match
  case Planner.ANil => g
  case Planner.ACons(a, rest) =>
    if i == d then
      val Planner.Atom(r, ng, ts) = a
      val Planner.G(sl, ns, na, xs, placed, bad) = g
      Console.print(" 0 ")
      Console.printI64(r)
      Console.print(" -1")
      val Planner.Pl(m, sl2, ns2, b2) = Planner.placeTs(ts, 1, sl, sl, ns, 0)
      Planner.G(sl2, ns2, na + 1, xs, Planner.iput(placed, i, 1), bad || b2)
    else Planner.driverAt(rest, d, i + 1, g)

