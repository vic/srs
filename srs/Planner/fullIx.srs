def Planner.fullIx(ars: Planner.Ints, r: I64, first: Bool): Unit = ars match
  case Planner.INil => ()
  case Planner.ICons(a, rest) =>
    if first then () else Console.print(" ")
    Console.printI64(r)
    Console.print(" ")
    Console.printI64(Planner.pow2(a) - 1)
    Planner.fullIx(rest, r + 1, false)

