def Planner.posAt(b: Planner.Atoms, p: I64, i: I64, g: Planner.G, nr: I64, ars: Planner.Ints): Planner.G = b match
  case Planner.ANil => g
  case Planner.ACons(a, rest) =>
    if i == p then
      val Planner.Atom(r, ng, ts) = a
      val Planner.G(sl, ns, na, xs, placed, bad) = g
      val Planner.Xr(x, xs2) = Planner.idxid(xs, nr, r, Planner.maskOf(ts, sl, 1, 0), Planner.pow2(Planner.nth(ars, r)) - 1)
      Console.print(" 0 ")
      Console.printI64(r)
      Console.print(" ")
      Console.printI64(x)
      val Planner.Pl(m, sl2, ns2, b2) = Planner.placeTs(ts, 1, sl, sl, ns, 0)
      Planner.G(sl2, ns2, na + 1, xs2, Planner.iput(placed, i, 1), bad || b2)
    else Planner.posAt(rest, p, i + 1, g, nr, ars)

