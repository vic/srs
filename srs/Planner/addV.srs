def Planner.addV(acc: Planner.Acc, s: I64, v: Planner.V): Planner.Acc =
  val Planner.Acc(vl, xs, mx, err) = acc
  val Planner.V(txt, xs2, nsl, e2) = v
  if Str.len(err) > 0 then acc
  else if Str.len(e2) > 0 then Planner.Acc(vl, xs2, mx, e2)
  else Planner.Acc(Planner.vsnoc(vl, s, txt), xs2, if nsl > mx then nsl else mx, "")

