// the whole executor input for rule text src and its input facts fs (files of a dir, or rows held in memory)
def Planner.textS(src: Str, fs: Planner.Src): Planner.Res2 =
  val Planner.Prog(names, ars, ins, rules, err) = Planner.parse(src, 0, Planner.Prog(Os.End, Planner.INil, Os.End, Planner.RNil, ""))
  if Str.len(err) > 0 then Planner.Res2(err, "")
  else
    val nr = Planner.slen(names, 0)
    val st = Planner.strata(Planner.zeros(nr), rules, nr)
    if nr > 0 && Planner.imax(st, 0) >= nr then Planner.Res2("unstratifiable: negation cycle", "")
    else
      val ns = if nr == 0 then 0 else Planner.imax(st, 0) + 1
      val Planner.Acc(vl, xs, mx, e2) = Planner.rulesV(rules, st, Planner.estsD(names, ins, fs), nr, ars, Planner.Acc(Planner.VNil, Planner.XNil, 0, ""))
      if Str.len(e2) > 0 then Planner.Res2(e2, "")
      else
        Console.captureBegin()
        Planner.ints(ars, true)
        val l1 = Console.captureEnd()
        Console.captureBegin()
        Planner.fullIx(ars, 0, true)
        Planner.regIx(xs)
        val l2 = Console.captureEnd()
        Console.captureBegin()
        Planner.strataTxt(vl, 0, ns)
        val l3 = Console.captureEnd()
        Console.captureBegin()
        Console.printI64(Planner.tokens(l1, 0, false, 0) + Planner.tokens(l2, 0, false, 0) + Planner.tokens(l3, 0, false, 0))
        Console.print(" ")
        Console.printI64(nr)
        Console.print(" ")
        Console.printI64(nr + Planner.ixLen(xs, 0))
        Console.print(" ")
        Console.printI64(ns)
        Console.print(" ")
        Console.printI64(mx)
        Console.print("\n")
        Console.print(l1)
        Console.print("\n")
        Console.print(l2)
        Console.print("\n")
        Console.print(l3)
        Planner.factsTxt(names, ins, fs)
        Planner.Res2("", Console.captureEnd())

