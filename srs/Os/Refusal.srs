// prompt: why a scratch directory was refused: lstat failed, it is not a directory (a symbolic link is not one), it is owned by
// another user, its permission bits are not exactly 0700, or its parent directory is not private (a directory of this user with
// mode 0700): lstat and a plain creat are safe only where no other user can write on the path.
enum Os.Refusal:
  case Os.StatFailed
  case Os.NotDirectory
  case Os.NotOwned
  case Os.NotPrivate
  case Os.ParentNotPrivate

