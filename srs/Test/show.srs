// one line of the test report: name, then ok, or FAIL with the expected value, the found value and the reason
// prompt: print "NAME ok" or "NAME FAIL: expected W, found G: WHY" and a newline.
def Test.show(n: Str, r: Test.Result): Unit =
  Console.print(n)
  r match
    case Test.Ok => Console.print(" ok\n")
    case Test.Fail(g, w, y) =>
      Console.print(" FAIL: expected ")
      Console.printI64(w)
      Console.print(", found ")
      Console.printI64(g)
      Console.print(": ")
      Console.print(y)
      Console.print("\n")

