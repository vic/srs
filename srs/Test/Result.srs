// the value of a test (vic 2026-11-16): a top-level val Foo.bar {Test}: Test.Result = .. is a test; Test is the only capability it may use
// prompt: Test.Ok, or Test.Fail with the value found (got), the value expected (want) and the human reason (why).
enum Test.Result:
  case Test.Ok
  case Test.Fail(got: I64, want: I64, why: Str)

