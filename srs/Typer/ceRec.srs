// the callee / case / handler / op symbol of node n, and its ax word (site + 1 or tag + 1)
def Typer.ceRec(s: Typer.S, n: I64, v: I64): Unit =
  val idx = Typer.cget(s, Typer.cTyBase()) + n
  if 0 < n && idx < Typer.cget(s, Typer.cTyN()) then Typer.mxSet(s, Typer.moCe(s, idx), v) else Typer.cinc(s, Typer.cTyOver())

