// prompt: mark type decl sym as a value type (Typer.flagValTy in the sx column)
def Typer.valTySet(s: Typer.S, sym: I64): Unit =
  val Typer.S(_, _, _, _, sg) = s
  val Typer.Sg(gcap, _, _, _, _, _, _, _, _, _, _, _, sx) = sg
  if 0 < sym && sym < gcap then Array.put(sx, sym, U8.of(Typer.flagValTy())) else Typer.over(s)

