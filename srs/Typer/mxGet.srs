// prompt: word i of the mono tables.
def Typer.mxGet(s: Typer.S, i: I64): I64 =
  val Typer.S(_, _, _, _, sg) = s
  val Typer.Sg(_, _, _, _, _, _, _, _, _, _, mcap, mx, _) = sg
  if 0 <= i && i < mcap then I64.of(mx(i))
  // shortcut: offsets come from the Tp.mo* functions, always below mcap; s3 Vec will make it unrepresentable
  else 0


