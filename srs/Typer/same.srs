def Typer.same(s: Typer.S, id: I64, kind: I64, head: I64, m: I64, n: I64): Bool =
  val Typer.S(tt, _, _, _, _) = s
  val Typer.Tt(tcap, tk, _, th, ta, tn) = tt
  if 0 <= id && id < tcap then
    I64.ofU8(tk(id)) == kind && I64.of(th(id)) == head && I64.of(tn(id)) == n && Typer.argsEq(s, I64.of(ta(id)), m, 0, n)
  else false

