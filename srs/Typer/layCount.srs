def Typer.layCount(s: Typer.S, i: I64, n: I64): Unit =
  if i < n then
    if Typer.layOlder(s, Typer.mxGet(s, Typer.moInst(s, i, 1)) - 1, Typer.mxGet(s, Typer.moInst(s, i, 2)), Typer.mxGet(s, Typer.moInst(s, i, 3))) then () else Typer.cinc(s, Typer.cLay())
    Typer.layCount(s, i + 1, n)
  else ()

