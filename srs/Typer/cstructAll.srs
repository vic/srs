// prompt: mark the extern struct names of all files rs (Typer.cstructRoots), called once at the start of Typer.headers
def Typer.cstructAll(w: Resolve.W, s: Typer.S, rs: Coll.List[Typer.R]): Unit = rs match
  case Coll.Nil => ()
  case Coll.Cons(r, rest) =>
    val Typer.R(f, rcap, rk, rf) = r
    val Resolve.F(_, g, _, _, _, _, _, _) = f
    Typer.cstructRoots(Typer.X(w, g, s, rcap, rk, rf), f, 0)
    Typer.cstructAll(w, s, rest)

