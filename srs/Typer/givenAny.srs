// prompt: true when some type id i.. below n is a given head (Typer.clsGiven) that covers z (Typer.gmatch).
def Typer.givenAny(s: Typer.S, z: I64, i: I64, n: I64): Bool =
  if i < n then (Typer.kind(s, i) == Typer.bCap() && Typer.cls(s, i) == Typer.clsGiven() && Typer.gmatch(s, i, z)) || Typer.givenAny(s, z, i + 1, n)
  else false


