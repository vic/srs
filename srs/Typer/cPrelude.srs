// the part of the C file that the emitter owns before the first def (s2/emit.srs: srs_str, srs_cap)
def Typer.cPrelude(s: Typer.S): Unit =
  Typer.po(s,"#include <stdint.h>\n#include <stdbool.h>\n")
  Typer.po(s,"typedef struct { const uint8_t* p; int64_t n; } srs_str;\n")
  Typer.po(s,"typedef struct srs_cap { void* self; void* const* vt; int64_t live; char* cur; char* end; } srs_cap;\n")

