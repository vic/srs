// prompt: true when t is an Array[A](n) type (kind array, head symbol Array; Cell and ACell share the kind, not the head)
def Typer.isArrayT(x: Typer.X, t: I64): Bool =
  val Typer.X(w, _, s, _, _, _) = x
  t != 0 && Typer.kind(s, t) == Typer.bArray() && Typer.head(s, t) == Resolve.sym(w, Resolve.lit("Array"), false)

