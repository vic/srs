// the arity of a builtin call, -1 when the name is no callable builtin (true, false)
def Typer.builtinArity(nm: Str): I64 =
  if Str.eq(nm, "Array.fill") || Str.eq(nm, "Array.aload") || Str.eq(nm, "ACell.store") || Str.eq(nm, "ACell.fetchAdd") || Str.eq(nm, "Cell.put") then 2
  else if Str.eq(nm, "Array.tabulate") || Str.eq(nm, "Cell.new") || Str.eq(nm, "ACell.new") || Str.eq(nm, "Cell.get") || Str.eq(nm, "ACell.load") then 1
  else if Str.eq(nm, "Array.slice") || Str.eq(nm, "Array.put") || Str.eq(nm, "Array.astore") || Str.eq(nm, "Array.fetchAdd") || Str.eq(nm, "ACell.cas") then 3
  else if Str.eq(nm, "Array.blit") || Str.eq(nm, "Array.cas") then 4
  else 0 - 1

