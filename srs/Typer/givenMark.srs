// prompt: mark type t as the head of a given (Typer.clsGiven in its class column) when t is a capability/trait type.
def Typer.givenMark(s: Typer.S, t: I64): Unit =
  val Typer.S(tt, _, _, _, _) = s
  val Typer.Tt(tcap, tk, tc, _, _, _) = tt
  if 0 <= t && t < tcap && I64.ofU8(tk(t)) == Typer.bCap() then Array.put(tc, t, U8.of(Typer.clsGiven())) else ()


