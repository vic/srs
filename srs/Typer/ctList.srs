// prompt: compile items i.. of list r (0 = no list) in order (Typer.ctComp); false when any fails
def Typer.ctList(x: Typer.X, r: I64, i: I64, pr: I64, lo: I64, hi: I64): Bool =
  val Typer.X(_, g, _, _, _, _) = x
  if r != 0 && i < Ast.len(g, r) then Typer.ctComp(x, Ast.item(g, r, i), pr, lo, hi) && Typer.ctList(x, r, i + 1, pr, lo, hi) else true

