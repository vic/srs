def Typer.pflush(s: Typer.S): Unit =
  val Typer.S(_, _, _, c, _) = s
  val Typer.Cn(cnn, cn, _, _, _, _, obc, ob) = c
  val o = Typer.cOut()
  if 0 <= o && o < cnn then
    val n = cn(o)
    if 0 < n && n <= obc then Console.print(Str.slice(Str.ofBytes(obc, ob), 0, n)) else ()
    Array.put(cn, o, 0)
  else ()

