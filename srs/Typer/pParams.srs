def Typer.pParams(x: Typer.X, r: I64, i: I64, start: I64, n: I64): Unit =
  val Typer.X(w, g, s, _, _, _) = x
  if i < n then
    if i > 0 then Typer.po(s, ", ") else ()
    Typer.cty(w, s, Typer.poolAt(s, start + i))
    Typer.po(s, " p_")
    Typer.idStr(s, Ast.text(g, Ast.tok(g, Ast.item(g, r, i))), 0)
    Typer.pParams(x, r, i + 1, start, n)
  else ()

