// prompt: the symbol `H.done` of handler name token j (the answer fn of a multi-shot handler, signature stored by Typer.handlerMulti)
def Typer.doneSym(x: Typer.X, j: I64): I64 =
  val Typer.X(w, g, _, _, _, _) = x
  Resolve.sym(w, Resolve.T(Resolve.srcOf(g), Ast.toff(g, j), Ast.tlen(g, j), "done", 0, 4), true)

