// prompt: a compile-time value (comptime-eval rulings, ~/hk/srs/vic/c/comptime-eval.md): an I64, a Bool, or CtNo = no compile-time value (a node outside the evaluator's whitelist, fuel out, division by zero, a name that is no value binder)
enum Typer.Ct:
  case Typer.CtInt(v: I64)
  case Typer.CtBool(b: Bool)
  case Typer.CtNo

