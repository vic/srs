// prompt: one pass over the files rs from index fi with the file context set (cFile, cTyBase): the type definition roots of each file
// (Typer.fileTdefs), or, when left, the type-fuel Diags of its type definitions still unset (Typer.tdefLeft).
def Typer.tdefPass(w: Resolve.W, s: Typer.S, rs: Coll.List[Typer.R], fi: I64, left: Bool): Unit = rs match
  case Coll.Nil => ()
  case Coll.Cons(r, rest) =>
    val Typer.R(f, rcap, rk, rf) = r
    val Resolve.F(_, g, _, _, _, _, _, _) = f
    Typer.cset(s, Typer.cFile(), fi)
    Typer.cset(s, Typer.cTyBase(), Typer.mxGet(s, Typer.moFb(s, fi)))
    val x = Typer.X(w, g, s, rcap, rk, rf)
    if left then Typer.tdefLeft(x, f, 0) else Typer.fileTdefs(x, f, 0)
    Typer.tdefPass(w, s, rest, fi + 1, left)



