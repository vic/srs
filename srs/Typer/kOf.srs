def Typer.kOf(b: I64): Coll.Option[Typer.K] =
  if b == 0 then Coll.Some(Typer.KBuiltin)
  else if b == 1 then Coll.Some(Typer.KArray)
  else if b == 2 then Coll.Some(Typer.KEnum)
  else if b == 3 then Coll.Some(Typer.KParam)
  else if b == 4 then Coll.Some(Typer.KCap)
  else if b == 5 then Coll.Some(Typer.KOther)
  else if b == 6 then Coll.Some(Typer.KVar)
  else if b == 7 then Coll.Some(Typer.KLen)
  else Coll.None

