// prompt: column col of the signature of sym: 0 result, 1 pool start, 2 param count, 3 type-param count, else evidence count.
def Typer.sigAt(s: Typer.S, sym: I64, col: I64): I64 =
  val Typer.S(_, _, _, _, sg) = s
  val Typer.Sg(gcap, sr, ss, sn, st, se, _, _, _, _, _, _, _) = sg
  if 0 <= sym && sym < gcap then
    if col == 0 then I64.of(sr(sym))
    else if col == 1 then I64.of(ss(sym))
    else if col == 2 then I64.of(sn(sym))
    else if col == 3 then I64.of(st(sym))
    else I64.of(se(sym))
  // shortcut: sym comes from the names table, always below gcap; s3 Vec will make it unrepresentable
  else 0


