def Typer.localsSummary(s: Typer.S): Unit =
  Typer.num(s,"// locals: defs=", Typer.cget(s, Typer.cNDef()))
  Typer.num(s," defsskipped=", Typer.cget(s, Typer.cDefSkip()))
  Typer.num(s," locals=", Typer.cget(s, Typer.cLocOut()))
  Typer.num(s," localsunprinted=", Typer.cget(s, Typer.cLocBad()))
  Typer.num(s," witnesses=", Typer.cget(s, Typer.cWitOut()))
  Typer.num(s," witnessesskipped=", Typer.cget(s, Typer.cWitSkip()))
  Typer.po(s,"\n")

