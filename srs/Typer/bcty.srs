def Typer.bcty(c: I64): Str =
  if c == 0 || c == 1 then "int64_t"
  else if c == 2 then "bool"
  else if c == 3 then "srs_str"
  else if c == 4 then "void*"
  else if c == 5 then "uint32_t"
  else if c == 6 then "uint8_t"
  else if c == 7 then "int32_t"
  else if c == 8 then "double"
  else if c == 9 then "const char*"
  else if c == 10 then "char *const*"
  else if c == 11 then "uint64_t"
  else "?builtin"

