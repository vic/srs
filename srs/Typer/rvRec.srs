// prompt: record t as the receiver type of method node n (column rv, Typer.moRv)
def Typer.rvRec(s: Typer.S, n: I64, t: I64): Unit =
  val idx = Typer.cget(s, Typer.cTyBase()) + n
  if 0 < n && idx < Typer.cget(s, Typer.cTyN()) then Typer.mxSet(s, Typer.moRv(s, idx), t) else Typer.cinc(s, Typer.cTyOver())

