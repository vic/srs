// signatures by the symbol of the def name: result id, params slice (start, count), type-param count, evidence count
// prompt: the per-symbol tables of the typer: signature columns (sr result, ss pool start, sn params, st type params, se evidence
// count), sa declared type, sl local types by binder token, sv var bindings, sw var sites, sx decl flags (Typer.flagExtern), and mx
// the mono tables.
enum Typer.Sg:
  case Typer.Sg(gcap: I64, sr: Array[U32](gcap), ss: Array[U32](gcap), sn: Array[U32](gcap), st: Array[U32](gcap), se: Array[U32](gcap), sa: Array[U32](gcap), sl: Array[U32](gcap), sv: Array[U32](gcap), sw: Array[U32](gcap), mcap: I64, mx: Array[U32](mcap), sx: Array[U8](gcap))


