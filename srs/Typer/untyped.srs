def Typer.untyped(x: Typer.X, tok: I64, code: I64): I64 =
  val Typer.X(_, _, s, _, _, _) = x
  val n = Typer.cget(s, Typer.cUnShown())
  Typer.unCount(s, code)
  if n < Typer.nMisShown() then
    Typer.cset(s, Typer.cUnAt() + 2 * n, Typer.cget(s, Typer.cFile()))
    Typer.cset(s, Typer.cUnAt() + 2 * n + 1, tok)
    Typer.cset(s, Typer.cUnShown(), n + 1)
  else ()
  Typer.fresh(s)

