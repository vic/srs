// prompt: the printed name (the s2 error code) of value-type Diag kind dk (Typer.isValDg)
def Typer.dgVal(dk: I64): Str = if dk == Typer.dValBinder() then "value-binder-type" else if dk == Typer.dValPattern() then "value-pattern-type" else if dk == Typer.dValArg() then "value-arg-type" else if dk == Typer.dValArgs() then "value-args" else "no-compile-time-value"

