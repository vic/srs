// ── S1a-0: the length index is a part of the Array type id (arg 1, a Len type) ──
// the visible args of a type: the length slot is no part of a name
def Typer.vn(s: Typer.S, t: I64): I64 =
  val n = Typer.nargs(s, t)
  if n > 0 && Typer.kind(s, Typer.arg(s, t, n - 1)) == Typer.bLen() then n - 1 else n

