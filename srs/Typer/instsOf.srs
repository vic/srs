// the instances of one def (chain e): a prototype each, or only the name line `mono NAME`
def Typer.instsOf(x: Typer.X, pr: I64, e: I64, names: Bool): Unit =
  val Typer.X(w, _, s, _, _, _) = x
  if e > 0 then
    if names then
      Typer.po(s, "mono ")
      Typer.instName(w, s, e - 1)
      Typer.po(s, "\n")
    else Typer.protoInst(x, e - 1, pr)
    Typer.instsOf(x, pr, Typer.mxGet(s, Typer.moInst(s, e - 1, 3)), names)
  else ()

