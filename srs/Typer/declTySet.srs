// prompt: record t as the type that decl sym denotes (Typer.declTyGet).
def Typer.declTySet(s: Typer.S, sym: I64, t: I64): Unit =
  val Typer.S(_, _, _, _, sg) = s
  val Typer.Sg(gcap, _, _, _, _, _, sa, _, _, _, _, _, _) = sg
  if 0 < sym && 0 <= sym && sym < gcap then Array.put(sa, sym, U32.of(t)) else Typer.over(s)


