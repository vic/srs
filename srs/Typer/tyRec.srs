def Typer.tyRec(s: Typer.S, n: I64, t: I64): Unit =
  val idx = Typer.cget(s, Typer.cTyBase()) + n
  val ln = Typer.cget(s, Typer.cLogN())
  if 0 < n && idx < Typer.cget(s, Typer.cTyN()) && ln < Typer.cget(s, Typer.cTyL()) then
    Typer.mxSet(s, Typer.moTy(s, idx), t)
    Typer.mxSet(s, Typer.moTl(s, ln), n)
    Typer.cset(s, Typer.cLogN(), ln + 1)
  else Typer.cinc(s, Typer.cTyOver())

