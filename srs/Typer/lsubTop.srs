// the callee sig type t at a call with arg list r: its binder lengths become the lengths of the args, its hidden ones a var / a fresh rigid
def Typer.lsubTop(x: Typer.X, t: I64, r: I64, base: I64, np: I64, up: Bool): I64 =
  val Typer.X(_, _, s, _, _, _) = x
  if Typer.cget(s, Typer.cNoLen()) == 0 && Typer.hasLB(s, t) then Typer.lsub(x, t, r, base, np, up) else t

