// prompt: Typer.consCheck on the param types i.. (np of them at pool ss) of the signature of the def owner.
def Typer.consParams(s: Typer.S, owner: I64, j: I64, ss: I64, i: I64, np: I64): Unit =
  if i < np then
    Typer.consCheck(s, owner, Typer.poolAt(s, ss + i), j)
    Typer.consParams(s, owner, j, ss, i + 1, np)
  else ()


