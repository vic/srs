// prompt: the symbol of the continuation type Srs.Cont[V, R] (V = the op result it takes, R = the answer it gives): only the binder k of a handler op `def op(k, ..)` has it, and its one use is `resume k(v)` (Q-M1, vic 2026-11-09)
def Typer.contSym(x: Typer.X): I64 =
  val Typer.X(w, _, _, _, _, _) = x
  Resolve.sym(w, Resolve.lit("Srs.Cont"), true)

