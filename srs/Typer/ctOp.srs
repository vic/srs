// prompt: true for the binary operator token classes the compile-time evaluator computes: + - * / % == != < <= > >= && ||
def Typer.ctOp(c: I64): Bool = c == Token.plus() || c == Token.minus() || c == Token.star() || c == Token.slash() || c == Token.pct() || c == Token.eqeq() || c == Token.ne() || c == Token.lt() || c == Token.le() || c == Token.gt() || c == Token.ge() || c == Token.andand() || c == Token.oror()

