// an expression node kind (the nodes Tp.expr visits)
def Typer.isExprKind(k: I64): Bool =
  k == Ast.kInt() || k == Ast.kStr() || k == Ast.kChar() || k == Ast.kName() || k == Ast.kUnit() || k == Ast.kParen() || k == Ast.kCall() || k == Ast.kMethod() || k == Ast.kResume() || k == Ast.kBin() || k == Ast.kUn() || k == Ast.kIf() || k == Ast.kIfNl() || k == Ast.kMatch() || k == Ast.kBlock() || k == Ast.kWhile() || k == Ast.kAssign() || k == Ast.kQuant()

