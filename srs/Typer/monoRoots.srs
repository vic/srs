def Typer.monoRoots(s: Typer.S, j: I64, n: I64): Unit =
  if j < n then
    val a = Typer.mxGet(s, Typer.moSite(j, 2))
    if Typer.sigAt(s, Typer.mxGet(s, Typer.moSite(j, 0)), 3) == 0 && a > 0 then Typer.instAdd(s, Typer.mxGet(s, Typer.moSite(j, 1)), a - 1, Typer.mxGet(s, Typer.moSite(j, 3))) else ()
    Typer.monoRoots(s, j + 1, n)
  else ()

