// the node kinds with an entry in the ty column (the others: types, declarations, layout, clauses, proofs: no C is emitted for them)
def Typer.reqKind(k: I64): Bool =
  Typer.isExprKind(k) || k == Ast.kVal() || k == Ast.kVar() || k == Ast.kPatVal() || k == Ast.kHandle() || k == Ast.kDo() || k == Ast.kPCase() || k == Ast.kPCaseNP() || k == Ast.kPAny() || k == Ast.kArm() || k == Ast.kPair() || k == Ast.kBind()

