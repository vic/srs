def Typer.insts(w: Resolve.W, s: Typer.S, rs: Coll.List[Typer.R], names: Bool): Unit = rs match
  case Coll.Nil => ()
  case Coll.Cons(r, rest) =>
    val Typer.R(f, rcap, rk, rf) = r
    val Resolve.F(_, g, _, _, _, _, _, _) = f
    Typer.fileInsts(Typer.X(w, g, s, rcap, rk, rf), f, 0, names)
    Typer.insts(w, s, rest, names)

