def Typer.summary(s: Typer.S): Unit =
  Typer.num(s,"types: defs=", Typer.cget(s, Typer.cDefs()))
  Typer.num(s," generic=", Typer.cget(s, Typer.cGeneric()))
  Typer.num(s," monosites=", Typer.cget(s, Typer.cNSite()))
  Typer.num(s," instances=", Typer.cget(s, Typer.cNInst()))
  Typer.num(s," layoutkeys=", Typer.cget(s, Typer.cLay()))
  Typer.num(s," monoover=", Typer.cget(s, Typer.cSubOver()))
  Typer.num(s," evidence=", Typer.cget(s, Typer.cEvid()))
  Typer.num(s," protos=", Typer.cget(s, Typer.cProtos()))
  Typer.num(s," dupdefs=", Typer.cget(s, Typer.cDup()))
  Typer.num(s," typeids=", Typer.cget(s, Typer.cTypes()) - 1)
  Typer.num(s," argpool=", Typer.cget(s, Typer.cATop()))
  Typer.num(s," overflow=", Typer.cget(s, Typer.cOver()))
  Typer.po(s," untyped[typenode typeunres typeother]")
  Typer.unTypeTable(s, 0)
  Typer.po(s,"\n")
  Typer.num(s,"bodies: checked=", Typer.cget(s, Typer.cBodies()))
  Typer.num(s," fullytyped=", Typer.cget(s, Typer.cFull()))
  Typer.num(s," mismatches=", Typer.cget(s, Typer.cMis()))
  Typer.num(s," untypednodes=", Typer.cget(s, Typer.cUnTot()))
  Typer.po(s," by-kind:")
  Typer.unTable(s, 0)
  Typer.po(s," (k90 builtin call, k92 call w/o sig, k93 cap/other call, k94 local w/o type or non-array call, k95 name, k96 pattern)\n")
  Typer.num(s,"tynodes: records=", Typer.cget(s, Typer.cTyRec()))
  Typer.num(s," nonground=", Typer.cget(s, Typer.cTyBad()))
  Typer.num(s," logover=", Typer.cget(s, Typer.cTyOver()))
  Typer.num(s," exprmissing=", Typer.cget(s, Typer.cTyExMiss()))
  Typer.num(s," column=", Typer.cget(s, Typer.cTyN()))
  Typer.po(s,"\n")
  Typer.num(s,"handlerbodies: checked=", Typer.cget(s, Typer.cHBod()))
  Typer.num(s," untyped=", Typer.cget(s, Typer.cHUn()))
  Typer.num(s," mismatches=", Typer.cget(s, Typer.cHMis()))
  Typer.po(s,"\n")
  Typer.num(s,"clauses: checked=", Typer.cget(s, Typer.cCCl()))
  Typer.num(s," untyped=", Typer.cget(s, Typer.cCUn()))
  Typer.num(s," mismatches=", Typer.cget(s, Typer.cCMis()))
  Typer.po(s,"\n")
  Typer.num(s,"diags: annotate=", Typer.cget(s, Typer.cAnn()))
  Typer.num(s," nonexhaustive=", Typer.cget(s, Typer.cNonEx()))
  Typer.num(s," exhaustiveskipped=", Typer.cget(s, Typer.cExSkip()))
  Typer.num(s," missingEntry=", Typer.cget(s, Typer.cMissE()))
  Typer.num(s," (ty=", Typer.cget(s, Typer.cTyBad()))
  Typer.num(s," callee=", Typer.cget(s, Typer.cMissCe()))
  Typer.num(s," tag/site=", Typer.cget(s, Typer.cMissAx()))
  Typer.num(s," literal=", Typer.cget(s, Typer.cMissLit()))
  Typer.num(s," unrecorded=", Typer.cget(s, Typer.cTyExMiss()))
  Typer.po(s,")\n")
  Typer.num(s,"lengths: lengthNotName=", Typer.cget(s, Typer.cLenNN()))
  Typer.po(s,"\n")

