// prompt: push the value kind (Typer.ctKind) of each value binder of list pr from i, and record the binder type as its node's type entry; a binder whose type is no I64 or Bool is the Diag value-binder-type
def Typer.ctBinders(x: Typer.X, pr: I64, i: I64): Unit =
  val Typer.X(_, g, s, _, _, _) = x
  if i < Ast.len(g, pr) then
    val b = Ast.item(g, pr, i)
    val t = Typer.ty(x, Ast.a(g, b))
    val k = Typer.ctKind(s, t)
    if k == 0 then Typer.diag(s, Typer.dValBinder(), Ast.tok(g, b)) else ()
    Typer.tyPut(s, b, t)
    Typer.push(s, k)
    Typer.ctBinders(x, pr, i + 1)
  else ()