// the digits of t from i are <= the digits of r from k (same count, _ in t skipped): a digit-wise compare, so no value is ever computed past its width
def Typer.digLe(t: Str, i: I64, r: Str, k: I64): Bool =
  if k >= Str.len(r) then true
  else if i >= Str.len(t) then true
  else if Str.at(t, i) == 95 then Typer.digLe(t, i + 1, r, k)
  else if Str.at(t, i) < Str.at(r, k) then true
  else if Str.at(t, i) > Str.at(r, k) then false
  else Typer.digLe(t, i + 1, r, k + 1)


