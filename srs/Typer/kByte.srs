// prompt: the byte of each type kind in the type table.
def Typer.kByte(k: Typer.K): I64 = k match
  case Typer.KLen => 7
  case Typer.KVar => 6
  case Typer.KBuiltin => 0
  case Typer.KArray => 1
  case Typer.KEnum => 2
  case Typer.KParam => 3
  case Typer.KCap => 4
  case Typer.KOther => 5
  case Typer.KNominal => 8


