// t with the params (tokens at pool tp0, ntp of them) replaced by the ground types at pool base
def Typer.msubArgs(s: Typer.S, t: I64, tp0: I64, ntp: I64, base: I64, i: I64, n: I64): Unit =
  if i < n then
    Typer.push(s, Typer.msub(s, Typer.arg(s, t, i), tp0, ntp, base))
    Typer.msubArgs(s, t, tp0, ntp, base, i + 1, n)
  else ()

