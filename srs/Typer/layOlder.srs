// an older instance of the same def (chain e) with the same layout key
def Typer.layOlder(s: Typer.S, a: I64, n: I64, e: I64): Bool =
  if e > 0 then
    (n == Typer.mxGet(s, Typer.moInst(s, e - 1, 2)) && Typer.layEq(s, a, Typer.mxGet(s, Typer.moInst(s, e - 1, 1)) - 1, 0, n)) || Typer.layOlder(s, a, n, Typer.mxGet(s, Typer.moInst(s, e - 1, 3)))
  else false

