// prompt: push the types of the fields i.. of an extern struct (field list r)
def Typer.cstructTys(x: Typer.X, r: I64, i: I64): Unit =
  val Typer.X(_, g, s, _, _, _) = x
  if i < Ast.len(g, r) then
    Typer.push(s, Typer.ty(x, Ast.a(g, Ast.item(g, r, i))))
    Typer.cstructTys(x, r, i + 1)
  else ()

