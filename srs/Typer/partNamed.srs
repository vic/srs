// prompt: the first def among parts i.. named nm, 0 when none
def Typer.partNamed(g: Ast.G, parts: I64, i: I64, nm: Str): I64 =
  if i < Ast.len(g, parts) then
    val d = Ast.item(g, parts, i)
    if Ast.kd(g, d) == Ast.kDef() && Str.eq(Ast.text(g, Ast.a(g, d)), nm) then d else Typer.partNamed(g, parts, i + 1, nm)
  else 0

