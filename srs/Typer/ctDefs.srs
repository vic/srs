// prompt: the compile-time code of the defs of all files rs from index fi (file context cFile, cTyBase set as Typer.tdefPass does), before any type use is evaluated
def Typer.ctDefs(w: Resolve.W, s: Typer.S, rs: Coll.List[Typer.R], fi: I64): Unit = rs match
  case Coll.Nil => ()
  case Coll.Cons(r, rest) =>
    val Typer.R(f, rcap, rk, rf) = r
    val Resolve.F(_, g, _, _, _, _, _, _) = f
    Typer.cset(s, Typer.cFile(), fi)
    Typer.cset(s, Typer.cTyBase(), Typer.mxGet(s, Typer.moFb(s, fi)))
    Typer.ctFile(Typer.X(w, g, s, rcap, rk, rf), f, 0, 0)
    Typer.ctDefs(w, s, rest, fi + 1)