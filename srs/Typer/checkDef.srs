// scope 0 = a def, 1 = a handler fn: the counters it feeds
// prompt: type check the body of the def-like node root (scope 0 a def, 1 a handler fn): owner, params, result, clauses and the body
// expression; the {} groups of outer (the parts of the enclosing given head, 0 = none) are bound first, so a given method sees the
// given's evidence binders (s2 prog givens: `given [A] {s: Show[A]} Show[Box[A]]` uses s.show); the trait constraints of the types
// in its signature must be held or given (Typer.consParams, Typer.consCheck); then zonk sites and locals and reset the type vars.
def Typer.checkDef(x: Typer.X, root: I64, scope: I64, outer: I64): Unit =
  val Typer.X(_, g, s, _, _, _) = x
  val parts = Ast.b(g, root)
  val body = Typer.part(g, parts, 0, Ast.kBody())
  if body == 0 then ()
  else
    val un0 = Typer.cget(s, Typer.unSlot(s))
    val owner = Typer.symOf(x, Ast.a(g, root))
    Typer.cset(s, Typer.cOwner(), owner)
    Typer.cset(s, Typer.cSite0(), Typer.cget(s, Typer.cNSite()))
    Typer.cset(s, Typer.cNLoc(), 0)
    Typer.cset(s, Typer.cNWit(), 0)
    // the params of a def body: a length that is not annotated is a rigid; the result and the locals: a length var
    Typer.cset(s, Typer.cCtx(), 1)
    if outer != 0 then Typer.bindGroups(x, outer, 0) else ()
    Typer.bindGroups(x, parts, 0)
    Typer.cset(s, Typer.cCtx(), 2)
    val ret = Typer.ty(x, Ast.a(g, Typer.part(g, parts, 0, Ast.kRet())))
    Typer.consParams(s, owner, Ast.tok(g, Ast.a(g, root)), Typer.sigAt(s, owner, 1), 0, Typer.sigAt(s, owner, 2))
    Typer.consCheck(s, owner, ret, Ast.tok(g, Ast.a(g, root)))
    Typer.cset(s, Typer.cScope(), 2)
    Typer.clauses(x, parts, 0, ret)
    Typer.cset(s, Typer.cScope(), scope)
    Typer.expect(x, Ast.tok(g, body), Typer.expr(x, Ast.a(g, body), ret), ret)
    Typer.unsolved(s, 0, Typer.cget(s, Typer.cNVar()))
    Typer.siteZonk(s, Typer.cget(s, Typer.cSite0()), Typer.cget(s, Typer.cNSite()))
    Typer.tyZonk(x, 0, Typer.cget(s, Typer.cLogN()))
    Typer.cset(s, Typer.cLogN(), 0)
    if Typer.cget(s, Typer.cMode()) == 3 && scope == 0 then Typer.printLocals(x, root, parts) else ()
    Typer.siteReset(s, 0, Typer.cget(s, Typer.cNVar()))
    if scope == 0 then Typer.cinc(s, Typer.cBodies()) else Typer.cinc(s, Typer.cHBod())
    if scope == 0 && Typer.cget(s, Typer.unSlot(s)) == un0 then Typer.cinc(s, Typer.cFull()) else ()
    Typer.resetVars(s, 0, Typer.cget(s, Typer.cNVar()))
    Typer.cset(s, Typer.cNVar(), 0)
    Typer.cset(s, Typer.cCtx(), 0)

