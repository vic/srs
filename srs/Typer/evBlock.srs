// prompt: the pool index of the trait evidence block of the signature of def sym: [count, types..] after its params, [] tokens and
// binder lengths (Typer.sigOf); only for a def whose evidence count (column 4) is > 0.
def Typer.evBlock(s: Typer.S, sym: I64): I64 =
  val np = Typer.sigAt(s, sym, 2)
  Typer.sigAt(s, sym, 1) + np + Typer.sigAt(s, sym, 3) + np


