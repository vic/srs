// prompt: true when type z is one of the trait evidence types of the signature of the def owner (the caller holds it).
def Typer.evHeld(s: Typer.S, owner: I64, z: I64): Bool =
  if owner > 0 && Typer.sigAt(s, owner, 4) > 0 then
    val b = Typer.evBlock(s, owner)
    Typer.evIn(s, z, b + 1, 0, Typer.poolAt(s, b))
  else false


