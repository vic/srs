// ── C text (s2/emit.srs) ──
// the bytes of pool[p + b, p + e) as one print (a zero-copy view of the pool): a name is its runs between the dots, not a print per byte
def Typer.idRun(s: Typer.S, pcap: I64, pool: Array[U8](pcap), p: I64, b: I64, e: I64): Unit =
  if b < e && 0 <= p + b && p + e <= pcap then Typer.po(s, Str.slice(Str.ofBytes(pcap, pool), p + b, p + e)) else ()

