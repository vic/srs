// prompt: true when the visible type args i..n of a and b print the same C names (Typer.sameName on each pair).
def Typer.sameNameArgs(s: Typer.S, a: I64, b: I64, i: I64, n: I64): Bool = if i < n then Typer.sameName(s, Typer.arg(s, a, i), Typer.arg(s, b, i)) && Typer.sameNameArgs(s, a, b, i + 1, n) else true
