// prompt: the count of the binders of list r from i whose type is a trait.
def Typer.traitEvNB(x: Typer.X, r: I64, i: I64): I64 =
  val Typer.X(_, g, _, _, _, _) = x
  if i < Ast.len(g, r) then (if Typer.isTraitTy(x, Ast.a(g, Ast.item(g, r, i))) then 1 else 0) + Typer.traitEvNB(x, r, i + 1) else 0


