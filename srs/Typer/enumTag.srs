// `struct E_Name` / `struct E_Name_N_args`: the tag of an enum type
def Typer.enumTag(w: Resolve.W, s: Typer.S, t: I64): Unit =
  Typer.po(s, "struct E_")
  Typer.id(s, w, Typer.head(s, t))
  val n = Typer.vn(s, t)
  if n > 0 then
    Typer.po(s, "_")
    Typer.mangleArgs(w, s, t, 0, n)
  else ()

