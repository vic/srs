// prompt: true when every param binder of list pr from i has a value kind (Typer.ctPKind)
def Typer.ctPKOk(x: Typer.X, pr: I64, i: I64): Bool =
  val Typer.X(_, g, _, _, _, _) = x
  if pr != 0 && i < Ast.len(g, pr) then Typer.ctPKind(x, Ast.item(g, pr, i)) != 0 && Typer.ctPKOk(x, pr, i + 1) else true

