// the untyped table: node kind (or reason code >= 90) = count, for the non-zero slots
def Typer.unTable(s: Typer.S, i: I64): Unit =
  if i < 100 then
    val c = Typer.cget(s, Typer.cUnNode() + i)
    if c > 0 then
      Typer.num(s," k", i)
      Typer.num(s,"=", c)
    else ()
    Typer.unTable(s, i + 1)
  else ()

