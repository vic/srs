// prompt: the type of value type use target with k arg codes at pool pc over env frame fb (an alias body `Bits(n * 2)`): the args go to new env entries from the env top (Typer.ctFill), then Typer.ctEnter
def Typer.ctUse(s: Typer.S, target: I64, k: I64, pc: I64, fb: I64, j: I64): I64 =
  val nf = Typer.cget(s, Typer.cCtTop())
  if Typer.ctFill(s, pc, fb, nf, 0, k, j) then Typer.ctEnter(s, target, nf, k, j) else 0

