// prompt: true when the types a and b print the same C name: the same head and, recursively, the same visible type args (Typer.mangle
// drops the length slot at every level through Typer.vn), so one C definition serves both (A11 emitter dedup, s5 ruling).
def Typer.sameName(s: Typer.S, a: I64, b: I64): Bool = Typer.head(s, a) == Typer.head(s, b) && Typer.vn(s, a) == Typer.vn(s, b) && Typer.sameNameArgs(s, a, b, 0, Typer.vn(s, a))
