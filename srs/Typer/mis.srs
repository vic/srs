def Typer.mis(s: Typer.S, tok: I64): Unit =
  val n = Typer.cget(s, Typer.cMisShown())
  Typer.cinc(s, Typer.misSlot(s))
  if n < Typer.nMisShown() then
    Typer.cset(s, Typer.cMisAt() + 2 * n, Typer.cget(s, Typer.cFile()))
    Typer.cset(s, Typer.cMisAt() + 2 * n + 1, tok)
    Typer.cset(s, Typer.cMisShown(), n + 1)
  else ()

