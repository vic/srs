// prompt: the pool position after the code at pc (Typer.ctComp layout), without evaluating it
def Typer.ctSkip(s: Typer.S, pc: I64): I64 =
  val op = Typer.poolAt(s, pc)
  if op == 1 then pc + 3
  else if op == 2 || op == 3 then pc + 2
  else if op == 4 || op == 7 then Typer.ctSkip(s, pc + 2)
  else if op == 5 then Typer.ctSkip(s, Typer.ctSkip(s, pc + 2))
  else if op == 6 then Typer.ctSkipN(s, pc + 3, Typer.poolAt(s, pc + 2))
  else if op == 8 then Typer.ctSkipN(s, pc + 2, Typer.poolAt(s, pc + 1))
  else if op == 9 then Typer.ctSkipN(s, pc + 1, 2)
  else if op == 10 then Typer.ctSkipN(s, pc + 1, 3)
  else pc + 1

