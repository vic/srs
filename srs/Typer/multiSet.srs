// prompt: mark handler symbol hs as multi-shot (Typer.flagMulti in the sx column)
def Typer.multiSet(s: Typer.S, hs: I64): Unit =
  val Typer.S(_, _, _, _, sg) = s
  val Typer.Sg(gcap, _, _, _, _, _, _, _, _, _, _, _, sx) = sg
  if 0 < hs && hs < gcap then Array.put(sx, hs, U8.of(Typer.flagMulti())) else Typer.over(s)

