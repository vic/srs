// the length of length expression e (an annotation `(e)`): a literal, or the binder of a plain local (not a var, not assigned), else lengthNotName
def Typer.lenOf(x: Typer.X, e: I64, report: Bool): I64 =
  val Typer.X(_, g, s, _, _, _) = x
  val k = Ast.kd(g, e)
  if k == Ast.kParen() then Typer.lenOf(x, Ast.a(g, e), report)
  else if k == Ast.kInt() && Typer.litOk(Ast.text(g, Ast.tok(g, e)), 0) then Typer.lenLit(s, Typer.dec(Ast.text(g, Ast.tok(g, e)), 0, 0))
  else if k == Ast.kName() && Typer.useKind(x, Ast.tok(g, e)) == Resolve.kLocal() && !Typer.isMut(s, Typer.useRef(x, Ast.tok(g, e))) then Typer.lenBind(s, Typer.useRef(x, Ast.tok(g, e)))
  else Typer.lenNN(x, e, report)

