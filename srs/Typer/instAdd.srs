// the instance (sym, the n type ids at pool a)
def Typer.instAdd(s: Typer.S, sym: I64, a: I64, n: I64): Unit =
  val hc = Typer.cget(s, Typer.cMoH())
  if hc > 0 && 0 < sym && sym < Typer.cget(s, Typer.cMoG()) then Typer.instProbe(s, sym, a, n, Typer.hashPool(s, a, 0, n, sym) % hc, 0)
  else Typer.cinc(s, Typer.cSubOver())

