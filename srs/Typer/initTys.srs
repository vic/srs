def Typer.initTys(w: Resolve.W, s: Typer.S): Unit =
  Typer.initTy(w, s, "I64", 0, Typer.tI64())
  Typer.initTy(w, s, "Bool", 2, Typer.tBool())
  Typer.initTy(w, s, "Unit", 1, Typer.tUnit())
  Typer.initTy(w, s, "Str", 3, Typer.tStr())
  Typer.initTy(w, s, "U32", 5, Typer.tU32())
  Typer.initTy(w, s, "U64", 11, Typer.tU64())

