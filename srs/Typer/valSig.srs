// a value (top-level, or an extern libc val): its type is the result of a signature without params
def Typer.valSig(x: Typer.X, nameTok: I64, tyNode: I64): Unit =
  val Typer.X(_, _, s, _, _, _) = x
  val m = Typer.mark(s)
  Typer.sigStore(s, Typer.symOf(x, nameTok), Typer.ty(x, tyNode), 0, 0, 0, m)

