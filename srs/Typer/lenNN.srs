// a length that is no literal and no plain local: the Diag lengthNotName, its length is the error length (equal to every length, no follow-on mismatch)
def Typer.lenNN(x: Typer.X, e: I64, report: Bool): I64 =
  val Typer.X(_, g, s, _, _, _) = x
  if report && Typer.cget(s, Typer.cNoLen()) == 0 then Typer.diag(s, Typer.dLenNN(), Ast.tok(g, e)) else ()
  Typer.lenK(s, Typer.tErr(), 0, 0, false)

