// Emit.mangle: the name, and `_N` then `_arg` for each arg of a type with args
def Typer.mangle(w: Resolve.W, s: Typer.S, t: I64): Unit =
  Typer.id(s, w, Typer.head(s, t))
  val n = Typer.vn(s, t)
  if n > 0 then
    Typer.po(s, "_")
    Typer.pi(s, n)
    Typer.mangleArgs(w, s, t, 0, n)
  else ()

