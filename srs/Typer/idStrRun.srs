// the run t[b, i) then on: a dot ends a run and prints `__`
def Typer.idStrRun(s: Typer.S, t: Str, i: I64, b: I64): Unit =
  if i < Str.len(t) then
    if Str.at(t, i) == 46 then
      Typer.po(s, Str.slice(t, b, i))
      Typer.po(s, "__")
      Typer.idStrRun(s, t, i + 1, i + 1)
    else Typer.idStrRun(s, t, i + 1, b)
  else Typer.po(s, Str.slice(t, b, i))

