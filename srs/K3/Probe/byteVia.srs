// prompt: K3 POS P2: the matched block keeps the length size of the scrutinee's type (passed on as Array[U8](size)).
def K3.Probe.byteVia(size: U64, result: K3.Probe.Allocation(size), i: U64, fallback: U8): U8 = result match
  case K3.Probe.Allocated(block) => K3.Probe.byteOf(size, block, i, fallback)
  case K3.Probe.AllocationFailed => fallback

