// prompt: test: byte 3 of the zero block of 10 bytes built by K3.Probe.build10 (in a test-local Arena), read through byteVia / byteOf, is 0.
val Tests.K3.byte_via_block {Test}: Test.Result =
  handle a = Srs.Arena()
  Test.expect(I64.ofU8(K3.Probe.byteVia(10, K3.Probe.build10(), U64.of(3), U8.of(9))), 0, "the zero block holds 0 at index 3")

