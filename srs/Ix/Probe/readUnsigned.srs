// prompt: K POS: the byte at a U64 index under only its upper bound index < size; the gate accepts it because U64 is never
// negative (vic 2026-11-17). Its value is checked by Tests.Ix.read_unsigned (a root, vic PROBES ARE TESTS).
def Ix.Probe.readUnsigned(size: U64, bytes: Array[U8](size), index: U64, fallback: U8): U8 =
  if index < size then bytes(index) else fallback

