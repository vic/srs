// A -> B, C -> D from the flat token list
def Printer.pairs(g: Ast.G, r: I64, i: I64): Unit =
  if i < Ast.len(g, r) then
    if i > 0 then Printer.s(", ") else ()
    Printer.tok(g, Ast.item(g, r, i))
    Printer.s(" -> ")
    Printer.tok(g, Ast.item(g, r, i + 1))
    Printer.pairs(g, r, i + 2)
  else ()

