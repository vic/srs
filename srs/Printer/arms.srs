def Printer.arms(g: Ast.G, r: I64, i: I64, ind: I64): Unit =
  if i < Ast.len(g, r) then
    val n = Ast.item(g, r, i)
    Printer.line(ind + 2)
    Printer.s("case ")
    Printer.pat(g, Ast.a(g, n))
    Printer.s(" => ")
    Printer.rhs(g, Ast.b(g, n), ind + 2)
    Printer.arms(g, r, i + 1, ind)
  else ()

