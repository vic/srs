// a binary < written glued to its left operand stays glued
def Printer.bin(g: Ast.G, n: I64, ind: I64): Unit =
  Printer.expr(g, Ast.a(g, n), ind)
  if Ast.cls(g, Ast.tok(g, n)) == Token.ltg() then
    Printer.s("<")
    Printer.expr(g, Ast.b(g, n), ind)
  else
    Printer.s(" ")
    Printer.tok(g, Ast.tok(g, n))
    Printer.s(" ")
    Printer.expr(g, Ast.b(g, n), ind)

