// a header part: group, params, return type, exit facts, body
def Printer.part(g: Ast.G, n: I64, ind: I64): Unit =
  val k = Ast.kd(g, n)
  if k == Ast.kGTypes() then
    Printer.s("[")
    Printer.binders(g, Ast.a(g, n), 0)
    Printer.s("]")
  else if k == Ast.kGEv() then
    Printer.s("{")
    Printer.binders(g, Ast.a(g, n), 0)
    Printer.s("}")
  else if k == Ast.kGFacts() || k == Ast.kExit() then
    Printer.s(" <")
    Printer.atoms(g, Ast.a(g, n), 0)
    Printer.s(">")
  else if k == Ast.kParams() then
    Printer.s("(")
    Printer.binders(g, Ast.a(g, n), 0)
    Printer.s(")")
  else if k == Ast.kRet() then
    Printer.s(": ")
    Printer.ty(g, Ast.a(g, n))
  else if k == Ast.kBody() then
    Printer.s(" = ")
    Printer.rhs(g, Ast.a(g, n), ind)
  else if k == Ast.kClause() then
    Printer.line(ind + 2)
    Printer.tok(g, Ast.tok(g, n))
    Printer.s(" ")
    Printer.expr(g, Ast.a(g, n), ind + 2)
  else if k == Ast.kProofUs() then
    Printer.line(ind + 2)
    Printer.s("proof using ")
    Printer.toks(g, Ast.a(g, n), 0)
  else if k == Ast.kProofInd() then
    Printer.line(ind + 2)
    Printer.s("proof by induction ")
    Printer.tok(g, Ast.a(g, n))
  else if k == Ast.kProofLean() then
    Printer.line(ind + 2)
    Printer.s("proof lean ")
    Printer.tok(g, Ast.a(g, n))
  else if k == Ast.kEntry() then
    Printer.s(" <")
    Printer.toksSp(g, Ast.a(g, n), 0)
    Printer.s(">")
  else if k == Ast.kOpRet() || k == Ast.kOpRetC() then
    Printer.s(": ")
    Printer.ty(g, Ast.a(g, n))
    if k == Ast.kOpRetC() then
      Printer.s("{")
      Printer.toks(g, Ast.b(g, n), 0)
      Printer.s("}")
    else ()
  else if k == Ast.kExitSt() then
    Printer.s(" <")
    Printer.tok(g, Ast.a(g, n))
    Printer.s(">")
  else if k == Ast.kHAns() then
    Printer.s(" [")
    Printer.tok(g, Ast.a(g, n))
    Printer.s(": Type]")
  else if k == Ast.kHFor() then
    Printer.s(" for ")
    Printer.tok(g, Ast.a(g, n))
  else if k == Ast.kAlias() then
    Printer.s(" = ")
    Printer.ty(g, Ast.a(g, n))
  else if k == Ast.kTyMatch() then
    Printer.s(" = ")
    Printer.ty(g, Ast.a(g, n))
    Printer.s(" match")
    Printer.tarms(g, Ast.b(g, n), 0, ind)
  else if k == Ast.kValMatch() then
    Printer.s(" = ")
    Printer.tok(g, Ast.tok(g, n))
    Printer.s(" match")
    Printer.tarms(g, Ast.b(g, n), 0, ind)
  else ()

