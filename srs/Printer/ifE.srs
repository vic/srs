def Printer.ifE(g: Ast.G, n: I64, ind: I64): Unit =
  val p = Ast.b(g, n)
  val t = Ast.a(g, p)
  Printer.s("if ")
  Printer.expr(g, Ast.a(g, n), ind)
  Printer.s(" then ")
  Printer.rhs(g, t, ind)
  if Ast.kd(g, n) == Ast.kIfNl() || Printer.endsDed(g, t) then Printer.line(ind) else Printer.s(" ")
  Printer.s("else ")
  Printer.rhs(g, Ast.b(g, p), ind)

