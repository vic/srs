// the defs of the list r, one per line at indent 2
def Printer.members(g: Ast.G, r: I64, i: I64): Unit =
  if i < Ast.len(g, r) then
    val n = Ast.item(g, r, i)
    if Ast.kd(g, n) == Ast.kDef() then
      Printer.line(2)
      Printer.defN(g, n, 2)
    else ()
    Printer.members(g, r, i + 1)
  else ()

