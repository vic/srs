def Printer.stmt(g: Ast.G, n: I64, ind: I64): Unit =
  val k = Ast.kd(g, n)
  if k == Ast.kVal() || k == Ast.kVar() then
    if k == Ast.kVal() then Printer.s("val ") else Printer.s("var ")
    Printer.tok(g, Ast.tok(g, n))
    if Ast.a(g, n) != 0 then
      Printer.s(": ")
      Printer.ty(g, Ast.a(g, n))
    else ()
    Printer.s(" = ")
    Printer.rhs(g, Ast.b(g, n), ind)
  else if k == Ast.kPatVal() then
    Printer.s("val ")
    Printer.tok(g, Ast.tok(g, n))
    Printer.s("(")
    Printer.toks(g, Ast.a(g, n), 0)
    Printer.s(") = ")
    Printer.rhs(g, Ast.b(g, n), ind)
  else if k == Ast.kHandle() then
    Printer.s("handle ")
    Printer.tok(g, Ast.tok(g, n))
    Printer.s(" = ")
    Printer.tok(g, Ast.a(g, n))
    Printer.s("(")
    Printer.exprs(g, Ast.b(g, n), 0, ind)
    Printer.s(")")
  else if k == Ast.kCheck() then
    Printer.tok(g, Ast.tok(g, n))
    Printer.s(" ")
    Printer.expr(g, Ast.a(g, n), ind)
  else Printer.expr(g, Ast.a(g, n), ind)

