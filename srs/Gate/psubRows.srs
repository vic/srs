// psub(u, s) when dot is false: a plain sub-pattern name of a case pattern has symbol s; nestDot(u, t) when dot is true: the sub-pattern name at token t is dotted (both mark nested patterns, not binders)
def Gate.psubRows(w: Resolve.W, g: Ast.G, dot: Bool, u: I64, p: I64): Unit =
  if Ast.kd(g, p) == Ast.kPCase() then Gate.psubNames(w, g, dot, u, Ast.a(g, p), 0) else ()

