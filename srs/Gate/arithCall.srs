// prompt: K2 rows of call node n (args l) for selector FArith, names never read: its arity, and per argument index a literal
// (fact range) or a bare local binder. The Datalog forms join them with the resolved callee(u, n, v) and the kernel role units.
def Gate.arithCall(g: Ast.G, sel: Gate.Fk, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), n: I64, l: I64): Unit =
  if Gate.fkB(sel) == Gate.fkB(Gate.FArith) then
    Gate.arithRow(Gate.TagArity, u, n, Ast.len(g, l), 0)
    Gate.arithArguments(g, u, rcap, rk, rf, n, l, 0)
  else ()

