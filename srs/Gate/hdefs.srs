// the defs inside a handler decl's part list
def Gate.hdefs(w: Resolve.W, g: Ast.G, sel: Gate.Fk, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val d = Ast.item(g, l, i)
    if Ast.kd(g, d) == Ast.kDef() then Gate.defRoot(w, g, sel, u, rcap, rk, rf, d) else ()
    Gate.hdefs(w, g, sel, u, rcap, rk, rf, l, i + 1)
  else ()

