// transition r A -> B, C -> D: the state tokens flat in pairs
def Gate.transRows(w: Resolve.W, g: Ast.G, c: I64, r: I64, l: I64, i: I64): Unit =
  if i + 1 < Ast.len(g, l) then
    Gate.row4(c, r, Gate.tsym(w, g, Ast.item(g, l, i)), Gate.tsym(w, g, Ast.item(g, l, i + 1)))
    Gate.transRows(w, g, c, r, l, i + 2)
  else ()

