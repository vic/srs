// prompt: typeArgument(u, b, e, k, a): the param b of unit u is declared with type E(a0, a1, ..) where E resolves to the enum
// unit e and a_k is the bare local a. (hook: Gate.parRows kParams branch, selector FTypeArg -> Gate.typeArgBinds)
def Gate.typeArgBinds(w: Resolve.W, g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    val t = Ast.a(g, n)
    if Ast.kd(g, n) == Ast.kBind() && Ast.kd(g, t) == Ast.kTy() then
      Gate.tyUnit(w, Gate.tsym(w, g, Ast.tok(g, t))) match
        case Coll.Some(e) => Gate.typeArgRows(g, u, rcap, rk, rf, Ast.tok(g, n), e, Ast.b(g, t), 0)
        case Coll.None => ()
    else ()
    Gate.typeArgBinds(w, g, u, rcap, rk, rf, l, i + 1)
  else ()

