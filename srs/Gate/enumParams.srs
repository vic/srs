// prompt: the value-parameter group of an enum (the first kParams item of its declaration list), or 0 when it has none.
def Gate.enumParams(g: Ast.G, l: I64, i: I64): I64 =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kParams() then Ast.a(g, n) else Gate.enumParams(g, l, i + 1)
  else 0

