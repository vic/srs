// the unit that declares the head of type t, when it is a declared type
def Gate.headUnit(w: Resolve.W, g: Ast.G, t: I64): Coll.Option[I64] =
  if t == 0 then Coll.None
  else if Ast.kd(g, t) == Ast.kTyCaps() then Gate.headUnit(w, g, Ast.a(g, t))
  else Gate.tyUnit(w, Gate.tsym(w, g, Ast.tok(g, t)))


