// prompt: the number of an arithShape row tag (column 1; Gate.f5eRules splits the relation by these numbers).
def Gate.arithTagNumber(t: Gate.ArithTag): I64 = t match
  case Gate.TagSite => 0
  case Gate.TagLeftLocal => 1
  case Gate.TagRightLocal => 2
  case Gate.TagLeftNode => 3
  case Gate.TagRightNode => 4
  case Gate.TagRightLiteral => 5
  case Gate.TagArgumentLiteral => 6
  case Gate.TagArgumentLocal => 7
  case Gate.TagArity => 8
  case Gate.TagBindCall => 9
  case Gate.TagGlobalValue => 10
  case Gate.TagNegateLiteral => 11
  case Gate.TagBelowTwo63 => 12
  case Gate.TagParamType => 13
  case Gate.TagResultType => 14
  case Gate.TagParamCount => 15

