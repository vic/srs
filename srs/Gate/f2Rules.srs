// family F2: a unit that is neither a Srs.* unit nor an extern decl may not refer to an rt_* decl or a libc def, and may not name the Ptr type.
// family F3a (ambient world, s2/types.srs:1699): a world handler is handled only in main, or where a binder already holds its capability.
// family F0 (parse): a unit whose text has a parser diag is rejected; a dropped diag is an unsound accept.
// family F1b (duplicate case): an enum case name is declared once in the whole image.
// family F3b (unhandled effect, s2/types.srs:675): the row of a unit = its requests and the rows of what it calls or handles, minus what a handle earlier in its body covers; main's row is empty.
// family F5a (protocol): the states of each handle binder flow along the body (sequence, branch join, loop back, operands left to right). A binder is tracked when every use and every op of its capability in the unit is a modeled site and no called def holds or requests the capability; for a tracked binder an op is allowed only in a state its decl moves from, evidence use {x} needs a live state, and at the end of the handle's block the state is a stop state (after the drop op).
// facts come from the name pass (resolved global decl per use token, resolved type per type token), never from raw tokens
def Gate.f2Rules(): Str = ".decl ref(c1: number, c2: number)\n.decl rt(c1: number)\n.decl libc(c1: number)\n.decl srs(c1: number)\n.decl ext(c1: number)\n.decl badRt(c1: number)\n.decl badLibc(c1: number)\n.decl ptr(c1: number)\n.decl badPtr(c1: number)\n.decl worldH(c1: number, c2: number)\n.decl held(c1: number, c2: number)\n.decl mainU(c1: number)\n.decl badAmb(c1: number)\n.decl hand(c1: number, c2: number)\n.decl perr(c1: number)\n.decl badParse(c1: number)\n.decl caseDecl(c1: number, c2: number, c3: number)\n.decl badCase(c1: number)\n.decl req(c1: number, c2: number, c3: number)\n.decl call(c1: number, c2: number, c3: number)\n.decl htop(c1: number, c2: number, c3: number)\n.decl hfor(c1: number, c2: number)\n.decl hat(c1: number, c2: number, c3: number)\n.decl site(c1: number, c2: number, c3: number)\n.decl covR(c1: number, c2: number, c3: number)\n.decl covS(c1: number, c2: number, c3: number)\n.decl row(c1: number, c2: number)\n.decl badEff(c1: number)\n.decl stateOf(c1: number, c2: number)\n.decl capStart(c1: number, c2: number)\n.decl stopSt(c1: number, c2: number)\n.decl dropOp(c1: number, c2: number)\n.decl trans(c1: number, c2: number, c3: number, c4: number)\n.decl opArrow(c1: number, c2: number, c3: number, c4: number)\n.decl opRel(c1: number, c2: number, c3: number)\n.decl opFree(c1: number, c2: number)\n.decl hst(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl xe(c1: number, c2: number, c3: number)\n.decl ee(c1: number, c2: number, c3: number)\n.decl xx(c1: number, c2: number, c3: number)\n.decl ex(c1: number, c2: number)\n.decl opsite(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl luse(c1: number, c2: number, c3: number)\n.decl move(c1: number, c2: number, c3: number, c4: number)\n.decl allowed(c1: number, c2: number, c3: number)\n.decl capOf(c1: number, c2: number, c3: number)\n.decl initAt(c1: number, c2: number, c3: number)\n.decl isOp(c1: number, c2: number, c3: number)\n.decl tsE(c1: number, c2: number, c3: number, c4: number)\n.decl tsX(c1: number, c2: number, c3: number, c4: number)\n.decl badOp(c1: number)\n.decl hb(c1: number, c2: number)\n.decl modeled(c1: number, c2: number)\n.decl endS(c1: number, c2: number, c3: number)\n.decl hasDrop(c1: number)\n.decl fin(c1: number, c2: number, c3: number)\n.decl badEnd(c1: number)\n.decl evsite(c1: number, c2: number, c3: number, c4: number)\n.decl opTok(c1: number, c2: number)\n.decl untracked(c1: number, c2: number)\n.decl heldU(c1: number, c2: number)\n.input ref\n.input rt\n.input libc\n.input srs\n.input ext\n.input ptr\n.input worldH\n.input held\n.input mainU\n.input hand\n.input perr\n.input caseDecl\n.input req\n.input call\n.input htop\n.input hfor\n.input stateOf\n.input capStart\n.input stopSt\n.input dropOp\n.input trans\n.input opArrow\n.input opRel\n.input opFree\n.input hst\n.input xe\n.input ee\n.input xx\n.input ex\n.input opsite\n.input luse\n.input evsite\n.input opTok\n.input heldU\n.output badRt\n.output badLibc\n.output badPtr\n.output badAmb\n.output badParse\n.output badCase\n.output badEff\n.output badOp\n.output badEnd\nbadRt(u) :- ref(u, v), rt(v), !srs(u), !ext(u).\nbadLibc(u) :- ref(u, v), libc(v), !srs(u), !ext(u).\nbadPtr(u) :- ptr(u), !srs(u), !ext(u).\nbadAmb(u) :- hand(u, h), worldH(h, c), !mainU(u), !held(u, c).\nbadParse(u) :- perr(u).\nbadCase(b) :- caseDecl(s, a, t), caseDecl(s, b, q), a < b.\nbadCase(a) :- caseDecl(s, a, t), caseDecl(s, a, q), t < q.\nhat(u, c, h) :- htop(u, v, h), hfor(v, c).\nsite(u, v, j) :- call(u, v, j).\nsite(u, v, h) :- htop(u, v, h).\ncovR(u, c, j) :- req(u, c, j), hat(u, c, h), h < j.\ncovS(u, c, j) :- site(u, v, j), hat(u, c, h), h < j.\nrow(u, c) :- req(u, c, j), !covR(u, c, j).\nrow(u, c) :- site(u, v, j), row(v, c), !covS(u, c, j).\nbadEff(u) :- mainU(u), row(u, c).\nmove(c, o, a, b) :- opArrow(c, o, a, b).\nmove(c, o, a, b) :- opRel(c, o, r), trans(c, r, a, b).\nmove(c, o, s, s) :- opFree(c, o), stateOf(c, s).\nallowed(c, o, s) :- move(c, o, s, t).\ncapOf(u, x, c) :- hst(u, h, x, v, b), hfor(v, c).\ninitAt(u, h, x) :- hst(u, h, x, v, b).\nisOp(u, n, x) :- opsite(u, n, x, o, j).\ntsX(u, h, x, s) :- hst(u, h, x, v, b), hfor(v, c), capStart(c, s).\ntsE(u, b, x, s) :- tsX(u, a, x, s), xe(u, a, b).\ntsE(u, b, x, s) :- tsE(u, a, x, s), ee(u, a, b).\nhb(u, x) :- hst(u, h, x, v, b).\nmodeled(u, j) :- opsite(u, n, x, o, j).\nmodeled(u, j) :- evsite(u, n, x, j).\nuntracked(u, x) :- luse(u, x, j), hb(u, x), x < j, !modeled(u, j).\nuntracked(u, x) :- capOf(u, x, c), req(u, c, t), !opTok(u, t).\nuntracked(u, x) :- capOf(u, x, c), call(u, v, j), row(v, c).\nbadOp(u) :- tsE(u, n, x, s), evsite(u, n, x, j), capOf(u, x, c), stopSt(c, s), !capStart(c, s), !untracked(u, x).\nendS(u, x, s) :- hst(u, h, x, v, b), tsX(u, b, x, s), !untracked(u, x).\nhasDrop(c) :- dropOp(c, d).\nfin(u, x, s) :- endS(u, x, s), capOf(u, x, c), stopSt(c, s).\nfin(u, x, t) :- endS(u, x, s), capOf(u, x, c), !stopSt(c, s), dropOp(c, d), move(c, d, s, t).\nbadEnd(u) :- endS(u, x, s), capOf(u, x, c), !stopSt(c, s), !hasDrop(c).\nbadEnd(u) :- endS(u, x, s), capOf(u, x, c), !stopSt(c, s), dropOp(c, d), !allowed(c, d, s).\nbadEnd(u) :- fin(u, x, t), capOf(u, x, c), !stopSt(c, t).\n"
