// prompt: rows of the index i of every unit whose name (in ps) starts with one of the prefixes pres (a unit family such as Srs.Arena.).
def Gate.prefixRows(ps: Os.Strs, pres: Os.Strs, i: I64): Unit = ps match
  case Os.End => ()
  case Os.More(n, r) =>
    if Gate.hasPrefix(n, pres) then Gate.row1(i) else ()
    Gate.prefixRows(r, pres, i + 1)

