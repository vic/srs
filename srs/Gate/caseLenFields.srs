def Gate.caseLenFields(w: Resolve.W, g: Ast.G, s: I64, fl: I64, i: I64): Unit =
  if i < Ast.len(g, fl) then
    val n = Ast.item(g, fl, i)
    val t0 = Ast.a(g, n)
    val t = if Ast.kd(g, t0) == Ast.kTyCaps() then Ast.a(g, t0) else t0
    if Ast.kd(g, n) == Ast.kBind() && Ast.kd(g, t) == Ast.kTy() && Ast.len(g, Ast.b(g, t)) >= 1 && Ast.kd(g, Ast.item(g, Ast.b(g, t), 0)) == Ast.kName() then
      Gate.fieldIdx(w, g, fl, Gate.tsym(w, g, Ast.tok(g, Ast.item(g, Ast.b(g, t), 0))), 0) match
        case Coll.Some(j) => Gate.row3(s, i, j)
        case Coll.None => ()
    else ()
    Gate.caseLenFields(w, g, s, fl, i + 1)
  else ()

