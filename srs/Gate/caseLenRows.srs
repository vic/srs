// caseLen(s, i, j): field i of the enum case with symbol s is an Array whose length names field j
def Gate.caseLenRows(w: Resolve.W, g: Ast.G, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val c = Ast.item(g, l, i)
    if Ast.kd(g, c) == Ast.kCase() then Gate.caseLenFields(w, g, Resolve.sym(w, Resolve.tokT(g, Ast.tok(g, c)), false), Ast.a(g, c), 0) else ()
    Gate.caseLenRows(w, g, l, i + 1)
  else ()

