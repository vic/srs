// gEvSize(u, x, n): the given's {..} binder x has a type of size n
def Gate.gEvSizes(g: Ast.G, u: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kBind() then Gate.row3(u, Ast.tok(g, n), Gate.tySize(g, Ast.a(g, n))) else ()
    Gate.gEvSizes(g, u, l, i + 1)
  else ()


