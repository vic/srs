// prompt: family F5e (fil-c trust boundary, vic/notes/20261117--filc-rule-coverage__s4_design.md): user code (user(u)) may not
// define a Srs.* unit (reserved-name, s2 srs_name_forge), may not write an extern that names the bare Ptr type (ptr-outside-srs,
// fil-c FC01/02/08), and may not write an extern that names a refined Ptr type of the image (ffi-forge, fil-c FC64-66/73). Inside
// the image, pointer arithmetic and int<->pointer casts (rt_ptr_add, rt_ptr_of, rt_ptr_addr: primArith) are allowed only in the
// allocator Srs.Arena.* (ptr-arith-outside-allocator, fil-c FC51/55/56), raw word access (rt_ptr_get, rt_ptr_set: primMem) only in
// Srs.Arena.* and the globals words of Srs.Gate.* / Srs.Pages.* (ptr-access-outside-allocator), trusted code names no bare Ptr
// (raw-ptr), and rt_ptr_add has the one caller Srs.Arena.wordAdd (ptr-align: offsets are whole words, fil-c FC58-61). K2
// (checkedUnit = every unit of a checked server, the probe units on the kernel image): every arithmetic site is proved by one of
// the forms F1..FU or it is arith-unproved, with every callee identified by Datalog joins on the resolved callee (role names give
// sites, role identities = exact-signature non-libc externs give proofs); an unresolved call head and an arithmetic unit used as a
// value are arith-unproved; a remainder binder is bounded by its divisor (arithRemainderBound, read by the F5f family); a checked
// unit names no Ptr (ptr-outside-srs) and no runtime unit except rtAllowed (rt-outside-srs), a checked extern forges no image
// pointer (ffi-forge), and no unit takes a builtin name (builtin-name-taken). The index rule provedI lives in F5f (one proof path).
def Gate.f5eRules(): Str = ".decl user(c1: number)\n.decl ptrDef(c1: number)\n.decl tref(c1: number, c2: number)\n.decl primArith(c1: number)\n.decl primMem(c1: number)\n.decl allocU(c1: number)\n.decl globU(c1: number)\n.decl primAdd(c1: number)\n.decl wordU(c1: number)\n.input user\n.input ptrDef\n.input tref\n.input primArith\n.input primMem\n.input allocU\n.input globU\n.input primAdd\n.input wordU\n.decl badReserved(c1: number)\n.decl badUserPtr(c1: number)\n.decl badFfi(c1: number)\n.decl badPtrArith(c1: number)\n.decl badPtrMem(c1: number)\n.decl badAlign(c1: number)\n.output badReserved\n.output badUserPtr\n.output badFfi\n.output badPtrArith\n.output badPtrMem\n.output badAlign\nbadReserved(u) :- user(u), srs(u).\nbadUserPtr(u) :- user(u), ext(u), ptr(u).\nbadFfi(u) :- user(u), ext(u), tref(u, v), ptrDef(v), !user(v).\nbadFfi(u) :- user(u), ext(u), ref(u, v), ptrDef(v), !user(v).\nbadPtrArith(u) :- ref(u, v), primArith(v), srs(u), !allocU(u).\nbadPtrMem(u) :- ref(u, v), primMem(v), srs(u), !allocU(u), !globU(u).\n.decl badRawPtr(c1: number)\n.output badRawPtr\nbadRawPtr(u) :- rawPtr(u), srs(u).\nbadRawPtr(u) :- rawPtr(u), ext(u), !user(u).\nbadAlign(u) :- ref(u, v), primAdd(v), srs(u), !wordU(u).\n.decl unsignedB(c1: number, c2: number)\n.input unsignedB\n.decl nonNeg(c1: number, c2: number, c3: number)\nnonNeg(u, c, i) :- ge0(u, c, i).\nnonNeg(u, c, i) :- unsignedB(u, i), ithen(u, c, t).\nprovedR(u, n) :- rargs(u, n, a, at, m), alen(u, a, nb), nonNeg(u, c, at), nonNeg(u, c, m), gle(u, c, m, nb), gleSub(u, c, at, nb, m), ithen(u, c, t), c < n, n <= t, !mutB(u, at), !mutB(u, m), !mutB(u, nb).\n.decl arithShape(c1: number, c2: number, c3: number, c4: number, c5: number)\n.input arithShape\n.decl checkedUnit(c1: number)\n.input checkedUnit\n.decl rtAllowed(c1: number)\n.input rtAllowed\n.decl arithQuotientName(c1: number)\n.input arithQuotientName\n.decl arithRemainderName(c1: number)\n.input arithRemainderName\n.decl arithWordWidenName(c1: number)\n.input arithWordWidenName\n.decl arithByteWidenName(c1: number)\n.input arithByteWidenName\n.decl arithSignedOfName(c1: number)\n.input arithSignedOfName\n.decl arithUnsignedOfName(c1: number)\n.input arithUnsignedOfName\n.decl arithByteOfName(c1: number)\n.input arithByteOfName\n.decl arithWordOfName(c1: number)\n.input arithWordOfName\n.decl arithUnsignedWordOfName(c1: number)\n.input arithUnsignedWordOfName\n.decl arithNarrowName(c1: number)\n.input arithNarrowName\n.decl arithBuiltinName(c1: number)\n.input arithBuiltinName\n.decl arithBuiltinSym(c1: number)\n.input arithBuiltinSym\n.decl arithTypeU64(c1: number)\n.input arithTypeU64\n.decl arithTypeU32(c1: number)\n.input arithTypeU32\n.decl arithTypeU8(c1: number)\n.input arithTypeU8\n.decl arithTypeI64(c1: number)\n.input arithTypeI64\n.decl arithTypeI32(c1: number)\n.input arithTypeI32\n.decl arithSite(c1: number, c2: number, c3: number)\n.decl arithLeftLocal(c1: number, c2: number, c3: number)\n.decl arithRightLocal(c1: number, c2: number, c3: number)\n.decl arithLeftNode(c1: number, c2: number, c3: number)\n.decl arithRightNode(c1: number, c2: number, c3: number)\n.decl arithRightLiteral(c1: number, c2: number, c3: number)\n.decl arithArgumentLiteral(c1: number, c2: number, c3: number, c4: number)\n.decl arithArgumentLocal(c1: number, c2: number, c3: number, c4: number)\n.decl arithArity(c1: number, c2: number, c3: number)\n.decl arithBindCall(c1: number, c2: number, c3: number)\n.decl arithGlobalValue(c1: number, c2: number, c3: number)\n.decl arithNegateLiteral(c1: number, c2: number)\n.decl arithBelowTwo63(c1: number, c2: number, c3: number)\n.decl arithParamType(c1: number, c2: number, c3: number)\n.decl arithResultType(c1: number, c2: number)\n.decl arithParamCount(c1: number, c2: number)\n.decl arithCalled(c1: number, c2: number)\n.decl arithBuiltinCall(c1: number, c2: number)\n.decl arithKernelExtern(c1: number)\n.decl arithSigOne(c1: number, c2: number, c3: number)\n.decl arithQuotientUnit(c1: number)\n.decl arithRemainderUnit(c1: number)\n.decl arithWordWidenUnit(c1: number)\n.decl arithByteWidenUnit(c1: number)\n.decl arithSignedOfUnit(c1: number)\n.decl arithUnsignedOfUnit(c1: number)\n.decl arithByteOfUnit(c1: number)\n.decl arithWordOfUnit(c1: number)\n.decl arithUnsignedWordOfUnit(c1: number)\n.decl arithRoleName(c1: number)\n.decl arithAddOne(c1: number, c2: number, c3: number)\n.decl arithSubtractOne(c1: number, c2: number, c3: number)\n.decl arithSubtractPair(c1: number, c2: number, c3: number, c4: number)\n.decl arithShiftByte(c1: number, c2: number, c3: number)\n.decl arithDivideLiteral(c1: number, c2: number, c3: number)\n.decl arithRemainderLiteral(c1: number, c2: number, c3: number)\n.decl arithSignedOf(c1: number, c2: number, c3: number)\n.decl arithUnsignedOf(c1: number, c2: number, c3: number)\n.decl arithByteOf(c1: number, c2: number, c3: number)\n.decl arithWordOf(c1: number, c2: number, c3: number)\n.decl arithUnsignedWordOf(c1: number, c2: number, c3: number)\n.decl arithRemainderBound(c1: number, c2: number, c3: number)\n.decl provedArith(c1: number, c2: number)\n.decl badArith(c1: number)\n.decl badPtrChecked(c1: number)\n.decl badRtChecked(c1: number)\n.decl badBuiltinName(c1: number)\n.output badArith\n.output badPtrChecked\n.output badRtChecked\n.output badBuiltinName\n.decl badExternChecked(c1: number)\n.output badExternChecked\narithSite(u, n, k) :- arithShape(0, u, n, k, y).\narithLeftLocal(u, n, x) :- arithShape(1, u, n, x, y).\narithRightLocal(u, n, x) :- arithShape(2, u, n, x, y).\narithLeftNode(u, n, a) :- arithShape(3, u, n, a, y).\narithRightNode(u, n, b) :- arithShape(4, u, n, b, y).\narithRightLiteral(u, n, l) :- arithShape(5, u, n, l, y).\narithArgumentLiteral(u, n, i, l) :- arithShape(6, u, n, i, l).\narithArgumentLocal(u, n, i, x) :- arithShape(7, u, n, i, x).\narithArity(u, n, k) :- arithShape(8, u, n, k, y).\narithBindCall(u, r, c) :- arithShape(9, u, r, c, y).\narithGlobalValue(u, n, v) :- arithShape(10, u, n, v, y).\narithNegateLiteral(u, n) :- arithShape(11, u, n, l, y).\narithBelowTwo63(u, c, v) :- arithShape(12, u, c, v, y).\narithParamType(u, i, s) :- arithShape(13, u, i, s, y).\narithResultType(u, s) :- arithShape(14, u, z, s, y).\narithParamCount(u, k) :- arithShape(15, u, k, x, y).\narithCalled(u, n) :- callee(u, n, v).\narithBuiltinCall(u, n) :- cname(u, n, s), arithBuiltinSym(s).\narithKernelExtern(v) :- ext(v), !libc(v), !checkedUnit(v).\narithSigOne(v, p, r) :- arithKernelExtern(v), arithParamCount(v, 1), arithParamType(v, 0, p), arithResultType(v, r).\narithQuotientUnit(v) :- arithQuotientName(v), arithKernelExtern(v), arithParamCount(v, 2), arithParamType(v, 0, a), arithTypeU64(a), arithParamType(v, 1, b), arithTypeU32(b), arithResultType(v, c), arithTypeU64(c).\narithRemainderUnit(v) :- arithRemainderName(v), arithKernelExtern(v), arithParamCount(v, 2), arithParamType(v, 0, a), arithTypeU64(a), arithParamType(v, 1, b), arithTypeU32(b), arithResultType(v, c), arithTypeU64(c).\narithWordWidenUnit(v) :- arithWordWidenName(v), arithSigOne(v, p, r), arithTypeU32(p), arithTypeU64(r).\narithByteWidenUnit(v) :- arithByteWidenName(v), arithSigOne(v, p, r), arithTypeU8(p), arithTypeU64(r).\narithSignedOfUnit(v) :- arithSignedOfName(v), arithSigOne(v, p, r), arithTypeU64(p), arithTypeI64(r).\narithUnsignedOfUnit(v) :- arithUnsignedOfName(v), arithSigOne(v, p, r), arithTypeI64(p), arithTypeU64(r).\narithByteOfUnit(v) :- arithByteOfName(v), arithSigOne(v, p, r), arithTypeI64(p), arithTypeU8(r).\narithWordOfUnit(v) :- arithWordOfName(v), arithSigOne(v, p, r), arithTypeI64(p), arithTypeI32(r).\narithUnsignedWordOfUnit(v) :- arithUnsignedWordOfName(v), arithSigOne(v, p, r), arithTypeI64(p), arithTypeU32(r).\narithRoleName(v) :- arithQuotientName(v).\narithRoleName(v) :- arithRemainderName(v).\narithRoleName(v) :- arithWordWidenName(v).\narithRoleName(v) :- arithByteWidenName(v).\narithRoleName(v) :- arithSignedOfName(v).\narithRoleName(v) :- arithUnsignedOfName(v).\narithRoleName(v) :- arithByteOfName(v).\narithRoleName(v) :- arithWordOfName(v).\narithRoleName(v) :- arithUnsignedWordOfName(v).\narithRoleName(v) :- arithNarrowName(v).\narithSite(u, n, 4) :- callee(u, n, v), arithQuotientName(v).\narithSite(u, n, 5) :- callee(u, n, v), arithRemainderName(v).\narithSite(u, n, 9) :- callee(u, n, v), arithSignedOfName(v).\narithSite(u, n, 10) :- callee(u, n, v), arithUnsignedOfName(v).\narithSite(u, n, 11) :- callee(u, n, v), arithByteOfName(v).\narithSite(u, n, 12) :- callee(u, n, v), arithWordOfName(v).\narithSite(u, n, 13) :- callee(u, n, v), arithUnsignedWordOfName(v).\narithSite(u, n, 14) :- callee(u, n, v), arithNarrowName(v).\narithSite(u, n, 0) :- ctok(u, n, j), !arithCalled(u, n), !ctorCall(u, n), !isite(u, n), !arithBuiltinCall(u, n).\narithAddOne(u, n, x) :- arithSite(u, n, 1), arithLeftLocal(u, n, x), arithRightNode(u, n, b), callee(u, b, v), arithWordWidenUnit(v), arithArity(u, b, 1), arithArgumentLiteral(u, b, 0, 1).\narithSubtractOne(u, n, x) :- arithSite(u, n, 2), arithLeftLocal(u, n, x), arithRightNode(u, n, b), callee(u, b, v), arithWordWidenUnit(v), arithArity(u, b, 1), arithArgumentLiteral(u, b, 0, 1).\narithSubtractPair(u, n, x, z) :- arithSite(u, n, 2), arithLeftLocal(u, n, x), arithRightLocal(u, n, z).\narithShiftByte(u, n, l) :- arithSite(u, n, 6), arithLeftNode(u, n, a), callee(u, a, v), arithByteWidenUnit(v), arithRightLiteral(u, n, l).\narithDivideLiteral(u, n, l) :- arithSite(u, n, 4), arithRightLiteral(u, n, l).\narithRemainderLiteral(u, n, l) :- arithSite(u, n, 5), arithRightLiteral(u, n, l).\narithDivideLiteral(u, n, l) :- callee(u, n, v), arithQuotientUnit(v), arithArity(u, n, 2), arithArgumentLiteral(u, n, 1, l).\narithRemainderLiteral(u, n, l) :- callee(u, n, v), arithRemainderUnit(v), arithArity(u, n, 2), arithArgumentLiteral(u, n, 1, l).\narithSignedOf(u, n, x) :- callee(u, n, v), arithSignedOfUnit(v), arithArity(u, n, 1), arithArgumentLocal(u, n, 0, x).\narithUnsignedOf(u, n, x) :- callee(u, n, v), arithUnsignedOfUnit(v), arithArity(u, n, 1), arithArgumentLocal(u, n, 0, x).\narithByteOf(u, n, l) :- callee(u, n, v), arithByteOfUnit(v), arithArity(u, n, 1), arithArgumentLiteral(u, n, 0, l).\narithWordOf(u, n, l) :- callee(u, n, v), arithWordOfUnit(v), arithArity(u, n, 1), arithArgumentLiteral(u, n, 0, l).\narithUnsignedWordOf(u, n, l) :- callee(u, n, v), arithUnsignedWordOfUnit(v), arithArity(u, n, 1), arithArgumentLiteral(u, n, 0, l).\narithRemainderBound(u, r, l) :- arithBindCall(u, r, c), callee(u, c, v), arithRemainderUnit(v), arithArity(u, c, 2), arithArgumentLiteral(u, c, 1, l), l != 0.\nprovedArith(u, n) :- arithAddOne(u, n, a), glt(u, c, a, b), ithen(u, c, t), c < n, n <= t, !mutB(u, a), !mutB(u, b).\nprovedArith(u, n) :- arithAddOne(u, n, a), gltL(u, c, a, l), ithen(u, c, t), c < n, n <= t, !mutB(u, a).\nprovedArith(u, n) :- arithSubtractPair(u, n, a, b), gle(u, c, b, a), ithen(u, c, t), c < n, n <= t, !mutB(u, a), !mutB(u, b).\nprovedArith(u, n) :- arithSubtractOne(u, n, a), glb(u, c, l, a), ithen(u, c, t), c < n, n <= t, !mutB(u, a).\nprovedArith(u, n) :- arithShiftByte(u, n, l), l <= 56.\nprovedArith(u, n) :- arithSignedOf(u, n, v), arithBelowTwo63(u, c, v), ithen(u, c, t), c < n, n <= t, !mutB(u, v).\nprovedArith(u, n) :- arithDivideLiteral(u, n, l), l != 0.\nprovedArith(u, n) :- arithRemainderLiteral(u, n, l), l != 0.\nprovedArith(u, n) :- arithUnsignedOf(u, n, v), ge0(u, c, v), ithen(u, c, t), c < n, n <= t, !mutB(u, v).\nprovedArith(u, n) :- arithNegateLiteral(u, n).\nprovedArith(u, n) :- arithByteOf(u, n, l), l <= 255.\nprovedArith(u, n) :- arithWordOf(u, n, l), l <= 2147483647.\nprovedArith(u, n) :- arithUnsignedWordOf(u, n, l).\nbadArith(u) :- checkedUnit(u), arithSite(u, n, k), !provedArith(u, n).\nbadArith(u) :- checkedUnit(u), arithGlobalValue(u, n, v), arithRoleName(v).\nbadPtrChecked(u) :- checkedUnit(u), ptr(u).\nbadRtChecked(u) :- checkedUnit(u), ref(u, v), rt(v), !rtAllowed(v).\nbadUserPtr(u) :- checkedUnit(u), ext(u), ptr(u).\nbadFfi(u) :- checkedUnit(u), ext(u), tref(u, v), ptrDef(v), !checkedUnit(v).\nbadFfi(u) :- checkedUnit(u), ext(u), ref(u, v), ptrDef(v), !checkedUnit(v).\nbadBuiltinName(u) :- arithBuiltinName(u).\nbadBuiltinName(u) :- checkedUnit(u), arithRoleName(u).\nbadExternChecked(u) :- checkedUnit(u), ext(u), !libc(u).\n.decl scrutArm(c1: number, c2: number, c3: number)\n.input scrutArm\n.decl caseParamLength(c1: number, c2: number, c3: number)\n.input caseParamLength\n.decl typeArgument(c1: number, c2: number, c3: number, c4: number, c5: number)\n.input typeArgument\nalen(u, w, a) :- scrutArm(u, p, b), pbind(u, p, s, i, w), caseDecl(s, e, t), caseParamLength(s, i, k), typeArgument(u, b, e, k, a), !mutB(u, a).\n"