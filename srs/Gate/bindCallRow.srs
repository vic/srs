// prompt: the bindCall row of a val or var binder (token binder) whose value e is a call node: the Datalog form remainderBound
// joins it with the resolved callee (U64.remainder) and its literal divisor.
def Gate.bindCallRow(g: Ast.G, sel: Gate.Fk, u: I64, binder: I64, e: I64): Unit =
  if Gate.fkB(sel) == Gate.fkB(Gate.FArith) && Ast.kd(g, e) == Ast.kCall() then Gate.arithRow(Gate.TagBindCall, u, binder, e, 0) else ()

