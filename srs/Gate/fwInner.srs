// one statement or expression node whose single child r is evaluated between its entry and its exit
def Gate.fwInner(w: Resolve.W, g: Ast.G, sel: Gate.Fk, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), blk: I64, n: I64, r: I64): Unit =
  if r == 0 then Gate.fx(sel, u, n)
  else
    Gate.fe(sel, Gate.FEe, u, n, r)
    Gate.fe(sel, Gate.FXx, u, r, n)
    Gate.fw(w, g, sel, u, rcap, rk, rf, blk, r)

