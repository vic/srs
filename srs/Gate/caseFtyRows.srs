// prompt: caseFty(s, i, t) for each field i of each case (symbol s) of the enum cases l[i..]: t = the symbol of the field's type head
// (a field type T<caps> is read as T).
def Gate.caseFtyRows(w: Resolve.W, g: Ast.G, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val c = Ast.item(g, l, i)
    if Ast.kd(g, c) == Ast.kCase() then Gate.caseFtyFields(w, g, Resolve.sym(w, Resolve.tokT(g, Ast.tok(g, c)), false), Ast.a(g, c), 0) else ()
    Gate.caseFtyRows(w, g, l, i + 1)
  else ()

