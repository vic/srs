// prompt: the signature rows of one params group l of unit u for selector FArith: its param count, then each param's builtin type
// symbol by position (Gate.signatureParams). An extern is walked too (Gate.flowRoots): the prim identities of K2 need its signature.
def Gate.signatureGroup(g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), l: I64): Unit =
  Gate.arithRow(Gate.TagParamCount, u, Ast.len(g, l), 0, 0)
  Gate.signatureParams(g, u, rcap, rk, rf, l, 0)

