// evsite(u, n, x, t): the call node n passes the handle binder x as evidence at token t ({a} group)
def Gate.evToks(g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), n: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val t = Ast.item(g, l, i)
    if 0 <= t && t < rcap && I64.ofU8(rk(t)) == Resolve.kLocal() then Gate.row4(u, n, I64.of(rf(t)), t) else ()
    Gate.evToks(g, u, rcap, rk, rf, n, l, i + 1)
  else ()

