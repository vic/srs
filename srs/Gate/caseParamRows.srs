// prompt: caseParamLength rows of the cases in list l (from item i) against the enum value params ps (0 = none: no rows).
def Gate.caseParamRows(w: Resolve.W, g: Ast.G, l: I64, ps: I64, i: I64): Unit =
  if ps != 0 && i < Ast.len(g, l) then
    val c = Ast.item(g, l, i)
    if Ast.kd(g, c) == Ast.kCase() then Gate.caseParamFields(w, g, Resolve.sym(w, Resolve.tokT(g, Ast.tok(g, c)), false), Ast.a(g, c), ps, 0) else ()
    Gate.caseParamRows(w, g, l, ps, i + 1)
  else ()

