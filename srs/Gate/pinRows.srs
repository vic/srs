def Gate.pinRows(g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    val t = Ast.a(g, n)
    if Ast.kd(g, n) == Ast.kBind() && Ast.kd(g, t) == Ast.kTyCaps() then Gate.pinNames(g, u, Ast.tok(g, n), rcap, rk, rf, Ast.b(g, t), 0) else ()
    Gate.pinRows(g, u, rcap, rk, rf, l, i + 1)
  else ()

