// the local binder an expression names when it is a bare local name
def Gate.localOf(g: Ast.G, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), e: I64): Coll.Option[I64] =
  if Ast.kd(g, e) == Ast.kName() then
    val t = Ast.tok(g, e)
    if 0 <= t && t < rcap && I64.ofU8(rk(t)) == Resolve.kLocal() then Coll.Some(I64.of(rf(t))) else Coll.None
  else Coll.None

