// tpos(u, k, s) from the items l of a list (from i, position k): a [] binder name, or the head of a type arg
def Gate.tposList(w: Resolve.W, g: Ast.G, u: I64, l: I64, i: I64, k: I64): I64 =
  if i < Ast.len(g, l) then
    Gate.row3(u, k, Gate.tsym(w, g, Ast.tok(g, Ast.item(g, l, i))))
    Gate.tposList(w, g, u, l, i + 1, k + 1)
  else k


