// prompt: relU rows of the 2-term atom calls among the fact list l from i (Gate.relUse)
def Gate.relUseAt(w: Resolve.W, g: Ast.G, u: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kAtomCall() && Ast.len(g, Ast.a(g, n)) == 2 then Gate.row4(u, Gate.tsym(w, g, Ast.tok(g, n)), Gate.tsym(w, g, Ast.item(g, Ast.a(g, n), 0)), Gate.tsym(w, g, Ast.item(g, Ast.a(g, n), 1))) else ()
    Gate.relUseAt(w, g, u, l, i + 1)
  else ()

