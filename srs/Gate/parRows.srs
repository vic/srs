def Gate.parRows(w: Resolve.W, g: Ast.G, sel: Gate.Fk, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), r: I64, i: I64): Unit =
  if i < Ast.len(g, r) then
    val p = Ast.item(g, r, i)
    val k = Ast.kd(g, p)
    if k == Ast.kGEv() && Gate.fkB(sel) == Gate.fkB(Gate.FPcap) then Gate.binRows(w, g, true, u, rcap, rk, rf, Ast.a(g, p), 0)
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FPdata) then Gate.binRows(w, g, false, u, rcap, rk, rf, Ast.a(g, p), 0)
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FPin) then Gate.pinRows(g, u, rcap, rk, rf, Ast.a(g, p), 0)
    else if k == Ast.kRet() && Gate.fkB(sel) == Gate.fkB(Gate.FRbound) && Ast.kd(g, Ast.a(g, p)) == Ast.kTyCaps() then Gate.capNames(g, u, rcap, rk, rf, Ast.b(g, Ast.a(g, p)), 0)
    else if k == Ast.kGEv() && Gate.fkB(sel) == Gate.fkB(Gate.FEvpos) then Gate.evposRows(g, u, Ast.a(g, p), 0, Gate.evBefore(g, r, i, 0, 0))
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FPpos) then Gate.pposRows(g, u, Ast.a(g, p), 0)
    else if k == Ast.kRet() && Gate.fkB(sel) == Gate.fkB(Gate.FErased) && Gate.tyHasCap(g, rcap, rk, Ast.a(g, p)) then Gate.row1(u)
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FCapParam) then Gate.capParams(g, u, rcap, rk, Ast.a(g, p), 0)
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FTval) then Gate.tvalBinds(w, g, u, rcap, rk, rf, Ast.a(g, p), 0)
    else if k == Ast.kRet() && Gate.fkB(sel) == Gate.fkB(Gate.FTval) && Gate.tyValBad(w, g, rcap, rk, rf, Ast.a(g, p)) then Gate.row1(u)
    else if (k == Ast.kGFacts() || k == Ast.kExit()) && Gate.fkB(sel) == Gate.fkB(Gate.FAtAt) then Gate.atRows(w, g, u, r, Ast.a(g, p), 0)
    else if (k == Ast.kGFacts() || k == Ast.kExit()) && Gate.fkB(sel) == Gate.fkB(Gate.FFvar) then Gate.fvarRows(w, g, u, Ast.a(g, p), 0)
    else if k == Ast.kGTypes() && Gate.fkB(sel) == Gate.fkB(Gate.FHide) then Gate.hideRows(w, g, u, Ast.a(g, p), 0)
    else if k == Ast.kGEv() && Gate.fkB(sel) == Gate.fkB(Gate.FEvTy) then Gate.evTyRows(w, g, u, Ast.a(g, p), 0)
    else if k == Ast.kGFacts() && Gate.fkB(sel) == Gate.fkB(Gate.FSigE) then Gate.atRows(w, g, u, r, Ast.a(g, p), 0)
    else if k == Ast.kExit() && Gate.fkB(sel) == Gate.fkB(Gate.FSigX) then Gate.atRows(w, g, u, r, Ast.a(g, p), 0)
    else if (k == Ast.kGFacts() || k == Ast.kExit()) && Gate.fkB(sel) == Gate.fkB(Gate.FRel) then Gate.relRows(w, g, u, Ast.a(g, p), 0)
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FAlen) then Gate.alenBinds(g, u, rcap, rk, rf, Ast.a(g, p), 0)
    else if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FAlenLit) then Gate.alenLitBinds(g, u, Ast.a(g, p), 0)
    else ()
    Gate.parRows(w, g, sel, u, rcap, rk, rf, r, i + 1)
  else ()