// prompt: the rows of the retTp input relation (Gate.retTpRows over all files): defs whose call result keeps the regions of the args
// (s2 rule vic-m5r.15: a [] binder result lives in the regions of the call's args).
def Gate.retTpText(rs: Coll.List[Typer.R]): Str =
  Console.captureBegin()
  Gate.retTpRows(rs, 0)
  Console.captureEnd()