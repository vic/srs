// family F5b (region lifetime, v4) + no-capability + capability-bound: a val/var/assign whose rhs is data (a call of a def returning data, or a constructor) lives in its {x} region, else in the innermost Region handle before it in the same block; a binding v = w of a local w lives where the latest binding of w before it lives, and also where a later binding of w in the same while body lives (the loop back edge); a data param (or a type-parameter param) lives in the binders its type names (List<s>), else in every Region evidence binder {r: Srs.Region} of its def; a use whose latest binding before it lives in x, after a modeled op that moved x (a handle or an evidence binder) to a terminal stop state, or after the last token of the block that opens x, is error[use-after-free]; a def body whose last expression is data with no {..} evidence while the body opens a Region handle before it is error[region-escape]; a call with no {..} evidence of a def with an evidence binder {y: C} needs exactly one provider of C in the caller (a handle for C or an evidence binder of C), else error[no-capability]; a var whose annotation names regions (List<a>) and gets a value in another region, or a body whose result type names regions and whose last value (the {y} of a call, or a local) lives in another region, is error[capability-bound]. Not yet: the result region of a call with evidence, builtin results, provider scope by position.
// prompt: the F5b Datalog rules (region lifetime, use-after-free, region-escape, no-capability, capability-bound, put-data, index and
// slice proofs, fact/state checks). no-capability: a call of a def or extern with a {y: C} binder needs one provider of C in the
// caller, except a binder of an extern pinned by one of its params (Str.ofBytes {r} (xs: ..<r>): s2/emit.srs:2794 "a top-level
// extern ... its binder names none the caller chooses": the region of the arg, no capability). A handler unit provides Srs.Region
// (ruling ledger srs/ruling/handler-fn-alloc-in-site-region-2026-11-12: a handler fn allocates in its handle site's Region).
def Gate.f5bRules(): Str = "extPin(v, y) :- ext(v), pin(v, a, y).\ndataRhs(u, r) :- callee(u, r, g), retData(g).\ndataRhs(u, r) :- ctorCall(u, r).\nhasEv(u, r) :- evsite(u, r, x, t).\nregH(u, b, x) :- hst(u, h, x, v, b), hfor(v, c), regionCap(c).\nvbpos(u, b, p) :- vb(u, n, v, b, r, p).\nlater(u, b, x, p) :- regH(u, b, x), regH(u, b, y), x < y, vbpos(u, b, p), y < p.\nrbnd(v) :- rbound(v, x).\nmapped(u, r) :- callee(u, r, v), rbnd(v).\noutIn(u, r, y) :- callee(u, r, v), rbound(v, xr), evpos(v, xr, i), evarg(u, r, y, i).\nalloc(u, v, x, p) :- vb(u, n, v, b, r, p), dataRhs(u, r), evsite(u, r, x, t), !mapped(u, r).\nalloc(u, v, x, p) :- vb(u, n, v, b, r, p), dataRhs(u, r), outIn(u, r, x).\nalloc(u, v, x, p) :- vb(u, n, v, b, r, p), dataRhs(u, r), !hasEv(u, r), regH(u, b, x), x < p, !later(u, b, x, p).\npann(u, v) :- pin(u, v, x).\nalloc(u, v, x, p) :- pdata(u, v, p), pin(u, v, x), pcap(u, x, c), regionCap(c).\nalloc(u, v, x, p) :- pdata(u, v, p), !pann(u, v), pcap(u, x, c), regionCap(c).\nbpos(u, v, p) :- vb(u, n, v, b, r, p).\nshadowed(u, w, q, p) :- alias(u, v, w, p), bpos(u, w, q), bpos(u, w, q2), q < q2, q2 < p.\nalloc(u, v, x, p) :- alias(u, v, w, p), alloc(u, w, x, q), q < p, !shadowed(u, w, q, p).\nalloc(u, v, x, p) :- alias(u, v, w, p), alloc(u, w, x, q), loopb(u, s, e), s < p, p < q, q < e.\nrcap(u, x, c) :- capOf(u, x, c).\nrcap(u, x, c) :- pcap(u, x, c).\nleaves(c, t) :- move(c, o, t, s), t < s.\nleaves(c, t) :- move(c, o, t, s), s < t.\nfreeAt(u, x, k) :- opsite(u, n, x, o, k), rcap(u, x, c), move(c, o, s, t), stopSt(c, t), !capStart(c, t), !leaves(c, t).\nrebound(u, v, p, j) :- alloc(u, v, x, p), luse(u, v, j), vb(u, n, v, b, r, q), p < q, q < j.\nbadUaf(u) :- alloc(u, v, x, p), luse(u, v, j), freeAt(u, x, k), p < k, k < j, !rebound(u, v, p, j).\nbadUaf(u) :- alloc(u, v, x, p), luse(u, v, j), regH(u, b, x), bend(u, b, e), p < e, e < j, !rebound(u, v, p, j).\nbadEsc(u) :- body(u, b), lastE(u, r, b, j), dataRhs(u, r), !hasEv(u, r), regH(u, b, x), x < j.\nbadEsc(u) :- body(u, b), lastIn(u, y), regH(u, b, y).\nbadEsc(u) :- rbound(u, x), body(u, b), lastE(u, r, b, j), luse(u, w, j), pdata(u, w, p), !pann(u, w).\nneed(u, n, c) :- callee(u, n, v), pcap(v, y, c), !hasEv(u, n), !extPin(v, y).\nprov(u, c) :- rcap(u, x, c).\nprov(u, c) :- hfor(u, h), regionCap(c).\nbadErased(u) :- erasedR(u).\nbadCapParam(u) :- capParamR(u).\nbadHTrait(u) :- hfor(u, c), traitU(c).\nbadTval(u) :- tvalR(u).\nbadNest(u) :- nestDot(u, t).\nputSite(u, n) :- cname(u, n, s), putSym(s).\ndataVal(u, n) :- putSite(u, n), argLast(u, n, a, t), ctorCall(u, a).\ndataVal(u, n) :- putSite(u, n), argLast(u, n, a, t), callee(u, a, v), retData(v).\ndataVal(u, n) :- putSite(u, n), argLast(u, n, a, t), carg(u, n, w, k, t), pdata(u, w, p).\ndataVal(u, n) :- putSite(u, n), argLast(u, n, a, t), carg(u, n, w, k, t), alloc(u, w, x, p).\nmultiB(u, w) :- vb(u, m, w, b, r, p), vb(u, m2, w, b2, r2, q), p < q.\nhomeArr(u, n) :- putSite(u, n), argFirst(u, n, a, t), carg(u, n, w, k, t), vb(u, m, w, b, r, p), cname(u, r, s), fillSym(s), !multiB(u, w).\nhomeArr(u, n) :- putSite(u, n), argFirst(u, n, a, t), carg(u, n, w, k, t), pin(u, w, x).\nbadPut(u) :- dataVal(u, n), !homeArr(u, n).\nalen(u, a, nb) :- alenP(u, a, nb).\nalen(u, a, nb) :- pbind(u, p, s, i, a), pbind(u, p, s, j, nb), caseLen(s, i, j).\nalen(u, v, nb) :- vb(u, m, v, b, r, p), cname(u, r, s), fillSym(s), argFirst(u, r, a, t), carg(u, r, nb, k, t), !multiB(u, v), !mutB(u, v).\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), iarg(u, n, i), alen(u, a, nb), ge0(u, c, i), glt(u, c, i, nb), ithen(u, c, t), c < n, n <= t, !mutB(u, i), !mutB(u, nb).\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), ilit(u, n, k), alenLit(u, a, l), k < l.\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), iarg(u, n, i), alenLit(u, a, l), ge0(u, c, i), gltL(u, c, i, l2), ithen(u, c, t), c < n, n <= t, l2 <= l, !mutB(u, i).\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), ilit(u, n, k), alen(u, a, nb), glb(u, c, lk, nb), ithen(u, c, t), c < n, n <= t, k <= lk, !mutB(u, nb).\nbadIdx(u) :- isite(u, n), !provedI(u, n).\nprovedR(u, n) :- rargs(u, n, a, at, m), alen(u, a, nb), ge0(u, c, at), ge0(u, c, m), gle(u, c, m, nb), gleSub(u, c, at, nb, m), ithen(u, c, t), c < n, n <= t, !mutB(u, at), !mutB(u, m), !mutB(u, nb).\nbadIdx(u) :- bsite(u, n), !provedR(u, n).\nbadSlice(u) :- ssite(u, n), !provedR(u, n).\nbadPut(u) :- putSite(u, n), argFirst(u, n, a, t), carg(u, n, w, k, t), pin(u, w, x), argLast(u, n, a2, t2), carg(u, n, v, k2, t2), pdata(u, v, p), !pann(u, v).\nbadBound(u) :- putSite(u, n), argFirst(u, n, a, t), carg(u, n, w, k, t), pin(u, w, x), argLast(u, n, a2, t2), carg(u, n, v, k2, t2), pin(u, v, y), !pin(u, v, x).\nbadNest(u) :- psub(u, s), caseDecl(s, v, t).\nbadFactCap(u) :- atAt(u, x, s), !pcapB(u, x).\nbadState(u) :- atAt(u, x, s), pcap(u, x, c), !stateOf(c, s), !fvarS(u, s).\nbadCapVal(u) :- alias(u, v, w, p), rcap(u, w, c).\nbadEvVal(u) :- alias(u, v, w, p), evpos(u, w, i), !pcapB(u, w).\npcapB(u, w) :- pcap(u, w, c).\nbadOp(u) :- need(u, n, c), ctok(u, n, j), rcap(u, x, c), freeAt(u, x, k), k < j.\naTok(u, j) :- ctorCall(u, n), ctok(u, n, j).\naTok(u, j) :- callee(u, n, v), retData(v), !hasEv(u, n), ctok(u, n, j).\nnewerReg(u, x, j) :- regH(u, b, x), regH(u, b2, y), x < y, aTok(u, j), y < j.\nbadOp(u) :- aTok(u, j), regH(u, b, x), x < j, freeAt(u, x, k), k < j, !newerReg(u, x, j).\nbadNoCap(u) :- need(u, n, c), pcap(u, x, c), pcap(u, y, c), x < y.\nbadNoCap(u) :- need(u, n, c), hst(u, h, x, w, b), hfor(w, c), h < n, n <= b, hst(u, g, y, w2, e), hfor(w2, c), g < n, n <= e, h < g.\nbadNoCap(u) :- need(u, n, c), pcap(u, x, c), hst(u, h, y, w, b), hfor(w, c), h < n, n <= b.\nlastIn(u, y) :- body(u, b), lastE(u, r, b, j), evsite(u, r, y, t), !mapped(u, r).\nlastIn(u, y) :- body(u, b), lastE(u, r, b, j), outIn(u, r, y).\nlastIn(u, y) :- body(u, b), lastE(u, r, b, j), luse(u, w, j), alloc(u, w, y, p), p < j, !rebound(u, w, p, j).\nbadBound(u) :- rbound(u, x), lastIn(u, y), !rbound(u, y).\nbadBound(u) :- vbound(u, v, x), alloc(u, v, y, p), !vbound(u, v, y).\nbadBound(u) :- pin(u, v, x), alloc(u, v, y, p), !pin(u, v, y).\nallowedR(u, n, k, y) :- callee(u, n, v), ppos(v, a, k), pin(v, a, xr), evpos(v, xr, i), evarg(u, n, y, i).\npinArg(u, n, k) :- allowedR(u, n, k, y).\nbadBound(u) :- carg(u, n, w, k, j), pinArg(u, n, k), alloc(u, w, z, p), p < j, !rebound(u, w, p, j), !allowedR(u, n, k, z).\n"

