// atAt(u, x, s): a fact atom x: S of the def; x is the {..} binder the subject names, or the subject token itself when it names none
def Gate.atRows(w: Resolve.W, g: Ast.G, u: I64, r: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kAtomAt() then
      val j = Ast.tok(g, n)
      Gate.row3(u, Gate.evFind(w, g, r, 0, Gate.tsym(w, g, j), j), Gate.tsym(w, g, Ast.a(g, n)))
    else ()
    Gate.atRows(w, g, u, r, l, i + 1)
  else ()

