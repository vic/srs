def Gate.evArgToks(g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), n: I64, l: I64, k: I64, off: I64): Unit =
  if k < Ast.len(g, l) then
    val t = Ast.item(g, l, k)
    if 0 <= t && t < rcap && I64.ofU8(rk(t)) == Resolve.kLocal() then Gate.row4(u, n, I64.of(rf(t)), off + k) else ()
    Gate.evArgToks(g, u, rcap, rk, rf, n, l, k + 1, off)
  else ()