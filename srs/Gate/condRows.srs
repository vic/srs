// guard atoms of the condition c (an && tree): ge0(u, c, i) for 0 <= i or i >= 0; glt(u, c, i, nb) for i < nb (bare local names)
def Gate.condRows(g: Ast.G, sel: Gate.Fk, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), c: I64, e: I64): Unit =
  val k = Ast.kd(g, e)
  if k == Ast.kParen() then Gate.condRows(g, sel, u, rcap, rk, rf, c, Ast.a(g, e))
  else if k == Ast.kBin() then
    val op = Ast.text(g, Ast.tok(g, e))
    val a = Ast.a(g, e)
    val b = Ast.b(g, e)
    if Str.eq(op, "&&") then
      Gate.condRows(g, sel, u, rcap, rk, rf, c, a)
      Gate.condRows(g, sel, u, rcap, rk, rf, c, b)
    else if Str.eq(op, "<=") && Gate.isZero(g, a) && Gate.fkB(sel) == Gate.fkB(Gate.FGe0) then Gate.optRow3(u, c, Gate.localOf(g, rcap, rk, rf, b))
    else if Str.eq(op, ">=") && Gate.isZero(g, b) && Gate.fkB(sel) == Gate.fkB(Gate.FGe0) then Gate.optRow3(u, c, Gate.localOf(g, rcap, rk, rf, a))
    else if Str.eq(op, "<") && Gate.isZero(g, a) && Gate.fkB(sel) == Gate.fkB(Gate.FGe0) then Gate.optRow3(u, c, Gate.localOf(g, rcap, rk, rf, b))
    else if Str.eq(op, "<=") && (Gate.fkB(sel) == Gate.fkB(Gate.FGle) || Gate.fkB(sel) == Gate.fkB(Gate.FGleSub)) then Gate.leRows(g, sel, u, rcap, rk, rf, c, a, b)
    else if Str.eq(op, "<") && Gate.fkB(sel) == Gate.fkB(Gate.FGlb) then
      Gate.intOf(g, a) match
        case Coll.Some(l) =>
          Gate.localOf(g, rcap, rk, rf, b) match
            case Coll.Some(nb) => Gate.row4(u, c, l, nb)
            case Coll.None => ()
        case Coll.None => ()
    else if Str.eq(op, "<") && Gate.fkB(sel) == Gate.fkB(Gate.FGltL) then
      Gate.localOf(g, rcap, rk, rf, a) match
        case Coll.Some(i) =>
          Gate.intOf(g, b) match
            case Coll.Some(l) => Gate.row4(u, c, i, l)
            case Coll.None => ()
        case Coll.None => ()
    else if Str.eq(op, "<") && Gate.fkB(sel) == Gate.fkB(Gate.FGlt) then
      Gate.localOf(g, rcap, rk, rf, a) match
        case Coll.Some(i) =>
          Gate.localOf(g, rcap, rk, rf, b) match
            case Coll.Some(nb) => Gate.row4(u, c, i, nb)
            case Coll.None => ()
        case Coll.None => ()
    else ()
  else ()

