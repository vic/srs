// gArg(u, c, k, s): the given's head is headed by unit c and its k-th type arg is headed by symbol s
def Gate.gArgRows(w: Resolve.W, g: Ast.G, u: I64, c: I64, l: I64, i: I64): Unit =
  if l != 0 && i < Ast.len(g, l) then
    Gate.row4(u, c, i, Gate.tsym(w, g, Ast.tok(g, Ast.item(g, l, i))))
    Gate.gArgRows(w, g, u, c, l, i + 1)
  else ()


