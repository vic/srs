// prompt: the arithmetic site kinds of K2 (a closed set; the number of a kind is Gate.arithKindNumber, column 4 of a site row).
enum Gate.ArithKind:
  case Gate.ArithAdd
  case Gate.ArithSubtract
  case Gate.ArithMultiply
  case Gate.ArithDivide
  case Gate.ArithRemainder
  case Gate.ArithShiftLeft
  case Gate.ArithShiftRight
  case Gate.ArithNegate
  case Gate.ArithSignedOfUnsigned
  case Gate.ArithUnsignedOfSigned
  case Gate.ArithByteOf
  case Gate.ArithWordOf
  case Gate.ArithUnsignedWordOf
  case Gate.ArithUnsignedWordOfWord
  case Gate.ArithFloatOf

