// fvarS(u, s): the name s is a term of a relation atom rel(..) in the def's fact groups (a fact variable, not a state)
def Gate.fvarRows(w: Resolve.W, g: Ast.G, u: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kAtomCall() then Gate.fvarTerms(w, g, u, Ast.a(g, n), 0) else ()
    Gate.fvarRows(w, g, u, l, i + 1)
  else ()

