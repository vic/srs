def Gate.tvalBinds(w: Resolve.W, g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kBind() && Gate.tyValBad(w, g, rcap, rk, rf, Ast.a(g, n)) then Gate.row1(u) else ()
    Gate.tvalBinds(w, g, u, rcap, rk, rf, l, i + 1)
  else ()