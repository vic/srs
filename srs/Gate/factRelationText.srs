// prompt: the factBelowUnit / factLessOrEqualUnit row of the kernel relation declared as full: its declaring unit and the symbol of its
// short name; located by the declared symbol, so it holds in every program split (image units, NegTest files).
def Gate.factRelationText(w: Resolve.W, full: Str, short: Str): Str =
  Console.captureBegin()
  Gate.factUnitOf(w, Resolve.sym(w, Resolve.lit(full), false)) match
    case Coll.Some(v) => Gate.row2(v, Resolve.sym(w, Resolve.lit(short), true))
    case Coll.None => ()
  Console.captureEnd()