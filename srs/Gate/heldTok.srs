// held(u, c): a type token of unit u resolves to the capability c (an evidence binder like {_: Env} holds it)
def Gate.heldTok(u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), j: I64): Unit =
  if 0 <= j && j < rcap then
    if I64.ofU8(rk(j)) == Resolve.tBase() + Resolve.tCap() then Gate.row2(u, I64.of(rf(j))) else ()
    Gate.heldTok(u, rcap, rk, rf, j + 1)
  else ()

