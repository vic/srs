// relA(u, r, a, o, b): a relation atom r(a, o, b) of the def's fact groups (symbols); r = 0 when the atom has not 3 terms, so no relation matches it
// prompt: relA(u, r, a, o, b) rows of the 3-term atoms r(a, o, b) among the fact atoms l from i of def unit u; a 2-term atom is a rule atom (relU, Gate.relUse) and gives no row here; any other term count gives r = 0 (no relation matches: error[unknown-relation])
def Gate.relRows(w: Resolve.W, g: Ast.G, u: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kAtomCall() then
      val ts = Ast.a(g, n)
      if Ast.len(g, ts) == 3 then Gate.row5(u, Gate.tsym(w, g, Ast.tok(g, n)), Gate.tsym(w, g, Ast.item(g, ts, 0)), Gate.tsym(w, g, Ast.item(g, ts, 1)), Gate.tsym(w, g, Ast.item(g, ts, 2)))
      else if Ast.len(g, ts) != 2 then Gate.row5(u, 0, 0, 0, 0)
      else ()
    else ()
    Gate.relRows(w, g, u, l, i + 1)
  else ()