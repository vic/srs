// pbind(u, p, s, i, t): the pattern group p (a match arm pattern or a val destructuring) of the case with symbol s binds its field i to the name at token t
def Gate.pbindRows(w: Resolve.W, g: Ast.G, u: I64, p: I64, ct: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    Gate.row5(u, p, Resolve.sym(w, Resolve.tokT(g, ct), false), i, Ast.item(g, l, i))
    Gate.pbindRows(w, g, u, p, ct, l, i + 1)
  else ()

