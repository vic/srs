// prompt: the rule rows of the rule defs (kRule) among the items i.. of capability decl list l of unit c (Gate.ruleItem)
def Gate.ruleItems(w: Resolve.W, g: Ast.G, sel: Gate.Rk, c: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    if Ast.kd(g, Ast.item(g, l, i)) == Ast.kRule() then Gate.ruleItem(w, g, sel, c, Ast.item(g, l, i), 0) else ()
    Gate.ruleItems(w, g, sel, c, l, i + 1)
  else ()

