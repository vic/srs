// prompt: the binary operator kind of op text, or None for an operator that is no arithmetic site (| & ^ comparisons ..).
def Gate.arithOfOperator(op: Str): Coll.Option[Gate.ArithKind] =
  if Str.eq(op, "+") then Coll.Some(Gate.ArithAdd)
  else if Str.eq(op, "-") then Coll.Some(Gate.ArithSubtract)
  else if Str.eq(op, "*") then Coll.Some(Gate.ArithMultiply)
  else if Str.eq(op, "/") then Coll.Some(Gate.ArithDivide)
  else if Str.eq(op, "%") then Coll.Some(Gate.ArithRemainder)
  else if Str.eq(op, "<<") then Coll.Some(Gate.ArithShiftLeft)
  else if Str.eq(op, ">>") then Coll.Some(Gate.ArithShiftRight)
  else Coll.None

