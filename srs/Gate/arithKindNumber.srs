// prompt: the number of an arithmetic site kind (column 4 of an arithShape site row).
def Gate.arithKindNumber(k: Gate.ArithKind): I64 = k match
  case Gate.ArithAdd => 1
  case Gate.ArithSubtract => 2
  case Gate.ArithMultiply => 3
  case Gate.ArithDivide => 4
  case Gate.ArithRemainder => 5
  case Gate.ArithShiftLeft => 6
  case Gate.ArithShiftRight => 7
  case Gate.ArithNegate => 8
  case Gate.ArithSignedOfUnsigned => 9
  case Gate.ArithUnsignedOfSigned => 10
  case Gate.ArithByteOf => 11
  case Gate.ArithWordOf => 12
  case Gate.ArithUnsignedWordOf => 13
  case Gate.ArithUnsignedWordOfWord => 14
  case Gate.ArithFloatOf => 15

