// the unit of capability Test (a test may use no other capability, family test-capability)
def Gate.testCapText(w: Resolve.W): Str =
  Console.captureBegin()
  Gate.tyUnit(w, Resolve.sym(w, Resolve.lit("Test"), false)) match
    case Coll.Some(c) => Gate.row1(c)
    case Coll.None => ()
  Console.captureEnd()

