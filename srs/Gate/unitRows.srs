// unit(name id, position): the name id is the position of the first unit with that name
def Gate.unitRows(all: Os.Strs, ns: Os.Strs, i: I64): Unit = ns match
  case Os.End => ()
  case Os.More(n, r) =>
    Console.printI64(Gate.firstIdx(all, n, i))
    Console.print("\t")
    Console.printI64(i)
    Console.print("\n")
    Gate.unitRows(all, r, i + 1)

