def Gate.listMsg(code: Str, all: Os.Strs, rows: Str, i: I64): Unit =
  if i >= Str.len(rows) then ()
  else
    val e = Kernel.eol(rows, i)
    val Datalog.N(u, j) = Datalog.num(rows, i)
    Console.print(code)
    Console.print(" ")
    Console.print(Planner.snth(all, u))
    Console.print("\n")
    Gate.listMsg(code, all, rows, e + 1)

