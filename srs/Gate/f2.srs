// prompt: run the Datalog gate over files ps (texts xs; us = user unit names) and print one diag line per rejected unit and code
// (families F2..F5e); Res(0, "") when no rule fires.
def Gate.f2(ps: Os.Strs, xs: Os.Strs, us: Os.Strs): Kernel.Res =
  val Gate.In(names, rows) = Gate.f2In(ps, xs, us)
  val Planner.Res2(err, txt) = Planner.textS(Gate.rulesAll(), Planner.Mem(names, rows))
  if Str.len(err) > 0 then Kernel.Res(1, err)
  else
    val out = Planner.run(txt)
    val br = Gate.section(out, "@5\n")
    val bl = Gate.section(out, "@6\n")
    val bp = Gate.section(out, "@8\n")
    val ba = Gate.section(out, "@12\n")
    val bq = Gate.section(out, "@15\n")
    val bc = Gate.section(out, "@17\n")
    val be = Gate.section(out, "@27\n")
    val bo = Gate.section(out, "@50\n")
    val bn = Gate.section(out, "@56\n")
    val bu = Gate.section(out, "@75\n")
    val bs = Gate.section(out, "@76\n")
    val bk = Gate.section(out, "@91\n")
    val bb = Gate.section(out, "@95\n")
    val bz = Gate.section(out, "@107\n")
    val bcp = Gate.section(out, "@109\n")
    val bcv = Gate.section(out, "@110\n")
    val bev = Gate.section(out, "@111\n")
    val bht = Gate.section(out, "@115\n")
    val btv = Gate.section(out, "@116\n")
    val bfc = Gate.section(out, "@118\n")
    val bst = Gate.section(out, "@119\n")
    val bnp = Gate.section(out, "@123\n")
    val bpd = Gate.section(out, "@134\n")
    val bix = Gate.section(out, "@146\n")
    val bsl = Gate.section(out, "@159\n")
    val bsig = Gate.sigMsgs(ps, out)
    if Str.len(br) == 0 && Str.len(bl) == 0 && Str.len(bp) == 0 && Str.len(ba) == 0 && Str.len(bq) == 0 && Str.len(bc) == 0 && Str.len(be) == 0 && Str.len(bo) == 0 && Str.len(bn) == 0 && Str.len(bu) == 0 && Str.len(bs) == 0 && Str.len(bk) == 0 && Str.len(bb) == 0 && Str.len(bz) == 0 && Str.len(bcp) == 0 && Str.len(bcv) == 0 && Str.len(bev) == 0 && Str.len(bht) == 0 && Str.len(btv) == 0 && Str.len(bfc) == 0 && Str.len(bst) == 0 && Str.len(bnp) == 0 && Str.len(bpd) == 0 && Str.len(bix) == 0 && Str.len(bsl) == 0 && Str.len(bsig) == 0 then Kernel.Res(0, "")
    else
      Console.captureBegin()
      Gate.listMsg("error[rt-outside-srs]", ps, br, 0)
      Gate.listMsg("error[libc-outside-handler]", ps, bl, 0)
      Gate.listMsg("error[ptr-outside-srs]", ps, bp, 0)
      Gate.listMsg("error[ambient-world]", ps, ba, 0)
      Gate.listMsg("error[parse]", ps, bq, 0)
      Gate.listMsg("error[duplicate]", ps, bc, 0)
      Gate.listMsg("error[unhandled-effect]", ps, be, 0)
      Gate.listMsg("error[op-not-allowed]", ps, bo, 0)
      Gate.listMsg("error[capability-not-ended]", ps, bn, 0)
      Gate.listMsg("error[use-after-free]", ps, bu, 0)
      Gate.listMsg("error[region-escape]", ps, bs, 0)
      Gate.listMsg("error[no-capability]", ps, bk, 0)
      Gate.listMsg("error[capability-bound]", ps, bb, 0)
      Gate.listMsg("error[capability-erased]", ps, bz, 0)
      Gate.listMsg("error[capability-param]", ps, bcp, 0)
      Gate.listMsg("error[capability-value]", ps, bcv, 0)
      Gate.listMsg("error[evidence-value]", ps, bev, 0)
      Gate.listMsg("error[not-a-capability]", ps, bht, 0)
      Gate.listMsg("error[value-args]", ps, btv, 0)
      Gate.listMsg("error[fact-not-capability]", ps, bfc, 0)
      Gate.listMsg("error[unknown-state]", ps, bst, 0)
      Gate.listMsg("error[nested-pattern]", ps, bnp, 0)
      Gate.listMsg("error[put-data]", ps, bpd, 0)
      Gate.listMsg("error[index-unproved]", ps, bix, 0)
      Gate.listMsg("error[slice-unproved]", ps, bsl, 0)
      Console.print(bsig)
      Kernel.Res(1, Console.captureEnd())

