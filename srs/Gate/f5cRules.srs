// family F5a-2 (signature facts, ruling state-generic-defs a'): <x: S> before the params = entry state of the {..} binder x, after the result = exit state; next(s, o, t) = the protocol moves s to t by op o. A def is checked once per solution of its entry facts (key k = the entry state); per solution its body flows the state of x (sE/sX) and ends in the exit state. A call to such a def steps the caller's provider binder from s to the exit state of the callee solution whose entry is s; no solution = op-not-allowed.
// qualified requests: Cap.op(..) is an op of the innermost handle binder of Cap whose scope holds the call (reqOp -> opsite, opTok).
// op and call nodes: the op runs after its args, so its state is the entry state of a leaf node or the exit state of its last arg (pre, sPre); an arg exit never passes through such a node unchanged.
// prompt: the F5c Datalog rules (Gate.extraIn inputs; decls safe here, after all numbered F2 sections). badChosen
// (error[chosen-not-capability]): an explicit {y} evidence arg must be a capability the caller holds or a trait evidence binder of
// the caller (s2 prog givens: print{s}(x) passes local trait evidence on).
def Gate.f5cRules(): Str = ".decl kOp(c1: number, c2: number)\n.input kOp\n.decl doneSym(c1: number)\n.input doneSym\n.decl sigE(c1: number, c2: number, c3: number)\n.decl sigX(c1: number, c2: number, c3: number)\n.decl relA(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl nextSym(c1: number)\n.decl nextF(c1: number, c2: number, c3: number, c4: number)\n.decl capU(c1: number, c2: number)\n.decl termOf(c1: number, c2: number)\n.decl isState(c1: number, c2: number)\n.decl hasVar(c1: number)\n.decl candV(c1: number, c2: number)\n.decl cand(c1: number, c2: number)\n.decl vOf(c1: number, c2: number, c3: number, c4: number)\n.decl unsat(c1: number, c2: number)\n.decl sol(c1: number, c2: number)\n.decl solAny(c1: number)\n.decl sE(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl sX(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl sigCap(c1: number, c2: number)\n.decl provB(c1: number, c2: number, c3: number)\n.decl callAt(c1: number, c2: number, c3: number, c4: number)\n.decl solIn(c1: number, c2: number, c3: number)\n.decl outSt(c1: number, c2: number, c3: number)\n.decl hasX(c1: number, c2: number)\n.decl isCallAt(c1: number, c2: number, c3: number)\n.decl solInAny(c1: number, c2: number)\n.decl badExit(c1: number)\n.decl badUnsolv(c1: number)\n.decl badFactOp(c1: number)\n.decl badTwice(c1: number)\n.decl badRel(c1: number)\n.decl opOf(c1: number, c2: number)\n.decl boundK(c1: number, c2: number, c3: number)\n.decl reachedX(c1: number, c2: number, c3: number)\n.decl reqOp(c1: number, c2: number, c3: number, c4: number)\n.decl qIn(c1: number, c2: number, c3: number, c4: number)\n.decl qShad(c1: number, c2: number, c3: number)\n.decl opN(c1: number, c2: number, c3: number)\n.decl pre(c1: number, c2: number, c3: number, c4: number)\n.decl sPre(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl badRegH(c1: number)\n.decl rAt(c1: number, c2: number, c3: number, c4: number)\n.decl rShad(c1: number, c2: number, c3: number)\n.output badRegH\n.decl sigP(c1: number, c2: number, c3: number, c4: number)\n.decl sigN(c1: number, c2: number, c3: number)\n.decl sigR(c1: number, c2: number, c3: number)\n.decl sigG(c1: number, c2: number)\n.decl sigT(c1: number, c2: number, c3: number)\n.decl bindT(c1: number, c2: number, c3: number, c4: number)\n.decl badHArity(c1: number)\n.decl badHType(c1: number)\n.decl badHSig(c1: number)\n.input sigP\n.input sigN\n.input sigR\n.input sigG\n.input sigT\n.output badHArity\n.output badHType\n.output badHSig\n.decl hideB(c1: number, c2: number)\n.decl badHide(c1: number)\n.input hideB\n.decl tpos(c1: number, c2: number, c3: number)\n.decl hasTpos(c1: number, c2: number)\n.input tpos\n.decl rcapB(c1: number, c2: number)\n.decl badChosen(c1: number)\n.output badChosen\n.decl gTp(c1: number, c2: number)\n.decl gHd(c1: number, c2: number)\n.decl gArg(c1: number, c2: number, c3: number, c4: number)\n.decl gHdSize(c1: number, c2: number)\n.decl gEvSize(c1: number, c2: number, c3: number)\n.decl evTy(c1: number, c2: number, c3: number, c4: number)\n.decl gPair(c1: number, c2: number)\n.decl gDiff(c1: number, c2: number)\n.decl capU2(c1: number)\n.decl badGHead(c1: number)\n.decl badOverlap(c1: number)\n.decl badFuel(c1: number)\n.decl badOpBinder(c1: number)\n.decl badAmbEv(c1: number)\n.input gTp\n.input gHd\n.input gArg\n.input gHdSize\n.input gEvSize\n.input evTy\n.output badGHead\n.output badOverlap\n.output badFuel\n.output badOpBinder\n.output badAmbEv\n.decl testCap(c1: number)\n.input testCap\n.decl badTestCap(c1: number)\n.output badTestCap\nbadTestCap(u) :- testCap(t), heldU(u, t), row(u, c), c != t.\n.decl gfor(c1: number, c2: number)\n.decl gHasArg(c1: number, c2: number)\n.decl tpT(c1: number, c2: number)\n.decl tHasOp(c1: number, c2: number)\n.decl tWantP(c1: number, c2: number, c3: number, c4: number)\n.decl tWantR(c1: number, c2: number, c3: number)\n.decl badTArity(c1: number)\n.decl badTSig(c1: number)\n.decl badTMiss(c1: number)\n.decl badTNotM(c1: number)\n.output badTArity\n.output badTSig\n.output badTMiss\n.output badTNotM\ngfor(v, c) :- gArg(v, c, k, s), traitU(c).\n.decl gHu(c1: number, c2: number)\n.input gHu\n.decl badNotTrait(c1: number)\n.output badNotTrait\ngfor(v, c) :- gHu(v, c), traitU(c).\nbadNotTrait(v) :- gHu(v, c), !traitU(c).\n.decl nonPtrT(c1: number)\n.input nonPtrT\n.decl initSym(c1: number)\n.input initSym\n.decl badHState(c1: number)\n.output badHState\nbadHState(v) :- hfor(v, c), initSym(o), sigR(v, o, t), nonPtrT(t).\ngHasArg(v, k) :- gArg(v, c, k, s).\ntpT(c, t) :- traitU(c), tpos(c, k, t).\ntHasOp(u, o) :- sigN(u, o, n).\nbadTArity(v) :- gfor(v, c), gArg(v, c, k, s), !hasTpos(c, k).\nbadTArity(v) :- gfor(v, c), tpos(c, k, a), !gHasArg(v, k).\ntWantP(v, o, k, s) :- gfor(v, c), sigP(c, o, k, t), tpos(c, j, t), gArg(v, c, j, s).\ntWantP(v, o, k, t) :- gfor(v, c), sigP(c, o, k, t), !tpT(c, t).\ntWantR(v, o, s) :- gfor(v, c), sigR(c, o, t), tpos(c, j, t), gArg(v, c, j, s).\ntWantR(v, o, t) :- gfor(v, c), sigR(c, o, t), !tpT(c, t).\nbadTSig(v) :- tWantP(v, o, k, e), sigP(v, o, k, s), s != e.\nbadTSig(v) :- tWantR(v, o, e), sigR(v, o, s), s != e.\nbadTSig(v) :- gfor(v, c), sigN(c, o, n), sigN(v, o, m), n != m.\nbadTMiss(v) :- gfor(v, c), sigN(c, o, n), !tHasOp(v, o).\nbadTNotM(v) :- gfor(v, c), sigN(v, o, m), !tHasOp(c, o).\n.decl badGRow(c1: number)\n.output badGRow\nbadGRow(v) :- gfor(v, c), row(v, k), !heldU(c, k).\nbadGRow(v) :- gfor(v, c), ctorCall(v, n), regionCap(r), !heldU(c, r).\nbadGHead(u) :- gTp(u, a), !gHd(u, a).\ngPair(u, v) :- gArg(u, c, k, s1), gArg(v, c, k, s2), u < v.\ngDiff(u, v) :- gArg(u, c, k, s1), gArg(v, c, k, s2), u < v, s1 != s2, !gTp(u, s1), !gTp(v, s2).\n.decl gMoreAt(c1: number, c2: number)\n.decl gHasEv(c1: number)\n.decl gRank(c1: number, c2: number)\ngMoreAt(u, v) :- gArg(u, c, k, s1), gArg(v, c, k, s2), gTp(v, s2), !gTp(u, s1).\ngHasEv(u) :- gEvSize(u, x, e).\ngRank(u, v) :- gPair(u, v), gMoreAt(u, v), !gMoreAt(v, u).\ngRank(u, v) :- gPair(u, v), gMoreAt(v, u), !gMoreAt(u, v).\ngRank(u, v) :- gPair(u, v), !gMoreAt(u, v), !gMoreAt(v, u), gHasEv(u), !gHasEv(v).\ngRank(u, v) :- gPair(u, v), !gMoreAt(u, v), !gMoreAt(v, u), gHasEv(v), !gHasEv(u).\nbadOverlap(v) :- gPair(u, v), !gDiff(u, v), !gRank(u, v).\nbadFuel(u) :- gHdSize(u, h), gEvSize(u, x, e), h <= e, gHu(u, c), evTy(u, x, c, a).\ncapU2(c) :- opFree(c, o).\ncapU2(c) :- opArrow(c, o, a, b).\ncapU2(c) :- opRel(c, o, r).\nbadOpBinder(c) :- capU2(c), evTy(c, x, t, a), traitU(t).\nbadAmbEv(u) :- call(u, v, j), ctok(u, n, j), !hasEv(u, n), evTy(v, y, t, a), evTy(u, x1, t, b), evTy(u, x2, t, b), x1 < x2.\nrcapB(u, y) :- rcap(u, y, c).\n.decl chosenOk(c1: number, c2: number)\nchosenOk(u, y) :- rcapB(u, y).\nchosenOk(u, y) :- evTy(u, y, c, a), traitU(c).\nbadChosen(u) :- evarg(u, n, y, i), !chosenOk(u, y).\nhasTpos(u, k) :- tpos(u, k, s).\nbadHType(v) :- bindT(v, o, a, s), hfor(v, c), tpos(c, k, a), tpos(v, k, t), s != t.\nbadHType(v) :- hfor(v, c), tpos(c, k, a), !hasTpos(v, k).\nbadHType(v) :- hfor(v, c), tpos(v, k, t), !hasTpos(c, k).\n.output badHide\nbadHide(u) :- hideB(u, s).\n.input reqOp\n.input sigE\n.input sigX\n.input relA\n.input nextSym\n.output badExit\n.output badUnsolv\n.output badFactOp\n.output badTwice\n.output badRel\nnextF(u, a, o, b) :- relA(u, r, a, o, b), nextSym(r).\nbadRel(u) :- relA(u, r, a, o, b), !nextSym(r).\ncapU(u, c) :- sigE(u, x, a), pcap(u, x, c).\ncapU(u, c) :- sigX(u, x, a), pcap(u, x, c).\ntermOf(u, a) :- sigE(u, x, a).\ntermOf(u, a) :- sigX(u, x, a).\ntermOf(u, a) :- nextF(u, a, o, b).\ntermOf(u, b) :- nextF(u, a, o, b).\nisState(u, a) :- termOf(u, a), capU(u, c), stateOf(c, a).\nhasVar(u) :- sigE(u, x, a), !isState(u, a).\ncandV(u, k) :- sigE(u, x, a), !isState(u, a), pcap(u, x, c), stateOf(c, k).\ncand(u, k) :- candV(u, k).\ncand(u, a) :- sigE(u, x, a), isState(u, a), !hasVar(u).\nvOf(u, k, a, k) :- candV(u, k), sigE(u, x, a), !isState(u, a).\nvOf(u, k, a, a) :- cand(u, k), isState(u, a).\nvOf(u, k, b, t) :- nextF(u, a, o, b), vOf(u, k, a, s), capU(u, c), move(c, o, s, t), !isState(u, b).\nboundK(u, k, a) :- vOf(u, k, a, s).\nunsat(u, k) :- cand(u, k), nextF(u, a, o, b), !boundK(u, k, a).\nunsat(u, k) :- cand(u, k), nextF(u, a, o, b), vOf(u, k, a, s), capU(u, c), !allowed(c, o, s).\nunsat(u, k) :- cand(u, k), nextF(u, a, o, b), isState(u, b), vOf(u, k, a, s), capU(u, c), move(c, o, s, t), t != b.\nsol(u, k) :- cand(u, k), !unsat(u, k).\nsolAny(u) :- sol(u, k).\nbadUnsolv(u) :- sigE(u, x, a), !solAny(u).\nbadUnsolv(u) :- sigE(u, x, a), sigE(u, y, b), x < y, !isState(u, a), !isState(u, b).\nopOf(c, o) :- move(c, o, s, t).\nbadFactOp(u) :- nextF(u, a, o, b), capU(u, c), !opOf(c, o).\nbadTwice(u) :- sigE(u, x, a), sigE(u, x, b), a < b.\nbadTwice(u) :- sigX(u, x, a), sigX(u, x, b), a < b.\nsigCap(v, c) :- sigE(v, y, a), pcap(v, y, c).\nprovB(u, x, c) :- capOf(u, x, c).\nprovB(u, x, c) :- pcap(u, x, c).\ncallAt(u, n, x, v) :- call(u, v, j), ctok(u, n, j), sigCap(v, c), pcap(u, x, c), !hasEv(u, n).\ncallAt(u, n, x, v) :- call(u, v, j), ctok(u, n, j), sigCap(v, c), hst(u, h, x, w, b), hfor(w, c), h < n, n <= b, !hasEv(u, n).\ncallAt(u, n, x, v) :- call(u, v, j), ctok(u, n, j), sigCap(v, c), evarg(u, n, x, i), provB(u, x, c).\nisCallAt(u, n, x) :- callAt(u, n, x, v).\nsolIn(v, s, k) :- sol(v, k), sigE(v, y, a), vOf(v, k, a, s).\nsolInAny(v, s) :- solIn(v, s, k).\nhasX(v, y) :- sigX(v, y, b).\noutSt(v, k, t) :- sol(v, k), sigX(v, y, b), vOf(v, k, b, t).\noutSt(v, k, s) :- sol(v, k), sigE(v, y, a), vOf(v, k, a, s), !hasX(v, y).\nqIn(u, n, x, h) :- reqOp(u, c, o, j), ctok(u, n, j), hst(u, h, x, v, b), hfor(v, c), h < n, n <= b.\nqShad(u, n, h) :- qIn(u, n, x, h), qIn(u, n, y, g), h < g.\nopsite(u, n, x, o, j) :- reqOp(u, c, o, j), ctok(u, n, j), qIn(u, n, x, h), !qShad(u, n, h).\nopTok(u, j) :- reqOp(u, c, o, j), ctok(u, n, j), qIn(u, n, x, h).\nopN(u, n, x) :- isOp(u, n, x).\nopN(u, n, x) :- isCallAt(u, n, x).\npre(u, n, x, s) :- tsE(u, n, x, s), ex(u, n), opN(u, n, x).\npre(u, n, x, s) :- tsX(u, a, x, s), xx(u, a, n), opN(u, n, x).\ntsX(u, b, x, s) :- tsX(u, a, x, s), xx(u, a, b), !opN(u, b, x).\ntsX(u, a, x, s) :- tsE(u, a, x, s), ex(u, a), !isOp(u, a, x), !initAt(u, a, x), !isCallAt(u, a, x).\ntsX(u, n, x, t) :- pre(u, n, x, s), opsite(u, n, x, o, j), capOf(u, x, c), move(c, o, s, t).\ntsX(u, n, x, t) :- pre(u, n, x, s), callAt(u, n, x, v), solIn(v, s, w), outSt(v, w, t).\nbadOp(u) :- pre(u, n, x, s), opsite(u, n, x, o, j), capOf(u, x, c), !allowed(c, o, s), !untracked(u, x).\nbadOp(u) :- pre(u, n, x, s), callAt(u, n, x, v), !solInAny(v, s), !untracked(u, x).\nuntracked(u, x) :- capOf(u, x, c), call(u, v, j), heldU(v, c), !sigCap(v, c).\nsE(u, k, r, x, s) :- body(u, r), sol(u, k), sigE(u, x, a), vOf(u, k, a, s).\nsE(u, k, b, x, s) :- sX(u, k, a, x, s), xe(u, a, b).\nsE(u, k, b, x, s) :- sE(u, k, a, x, s), ee(u, a, b).\nsPre(u, k, n, x, s) :- sE(u, k, n, x, s), ex(u, n), opN(u, n, x).\nsPre(u, k, n, x, s) :- sX(u, k, a, x, s), xx(u, a, n), opN(u, n, x).\nsX(u, k, b, x, s) :- sX(u, k, a, x, s), xx(u, a, b), !opN(u, b, x).\nsX(u, k, a, x, s) :- sE(u, k, a, x, s), ex(u, a), !opN(u, a, x).\nsX(u, k, n, x, t) :- sPre(u, k, n, x, s), opsite(u, n, x, o, j), pcap(u, x, c), move(c, o, s, t).\nsX(u, k, n, x, t) :- sPre(u, k, n, x, s), callAt(u, n, x, v), solIn(v, s, w), outSt(v, w, t).\nbadOp(u) :- sPre(u, k, n, x, s), opsite(u, n, x, o, j), pcap(u, x, c), !allowed(c, o, s).\nbadOp(u) :- sPre(u, k, n, x, s), callAt(u, n, x, v), !solInAny(v, s).\nreachedX(u, k, x) :- body(u, r), sX(u, k, r, x, s).\nbadExit(u) :- body(u, r), sX(u, k, r, x, s), sigX(u, x, a), vOf(u, k, a, t), s != t.\nbadExit(u) :- sigX(u, x, a), sol(u, k), !boundK(u, k, a).\nbadExit(u) :- body(u, r), sol(u, k), sigX(u, x, a), !reachedX(u, k, x).\nrAt(u, h, r, g) :- hst(u, h, x, v, b), hst(u, g, r, w, e), hfor(w, c), regionCap(c), g < h, h <= e.\nrShad(u, h, g) :- rAt(u, h, r, g), rAt(u, h, q, f), g < f.\nbadRegH(u) :- opsite(u, n, x, o, j), hst(u, h, x, v, b), aTok(v, t), rAt(u, h, r, g), !rShad(u, h, g), freeAt(u, r, k), k < j.\nbadHArity(v) :- hfor(v, c), sigN(c, o, n), sigN(v, o, m), n != m.\nbadHType(v) :- hfor(v, c), sigP(c, o, k, t), sigP(v, o, k, s), t != s, !sigT(c, o, t).\nbadHType(v) :- hfor(v, c), sigR(c, o, t), sigR(v, o, s), t != s, !sigT(c, o, t), !kOp(v, o).\nbindT(v, o, t, s) :- hfor(v, c), sigP(c, o, k, t), sigP(v, o, k, s), sigT(c, o, t).\nbindT(v, o, t, s) :- hfor(v, c), sigR(c, o, t), sigR(v, o, s), sigT(c, o, t), !kOp(v, o).\n.decl badAns(c1: number)\n.output badAns\nbadAns(v) :- kOp(v, o), sigR(v, o, s), doneSym(d), sigR(v, d, r), s != r.\nbadHType(v) :- bindT(v, o, a, s), bindT(v, o, a, r), s < r.\nbadHSig(v) :- hfor(v, c), sigG(c, o), sigN(v, o, m), !sigG(v, o).\n"