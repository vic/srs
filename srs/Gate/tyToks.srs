// gHd(u, s): every name symbol s in type t (head and args, recursively)
def Gate.tyToks(w: Resolve.W, g: Ast.G, u: I64, t: I64): Unit =
  if t == 0 then ()
  else if Ast.kd(g, t) == Ast.kTyCaps() then Gate.tyToks(w, g, u, Ast.a(g, t))
  else
    Gate.row2(u, Gate.tsym(w, g, Ast.tok(g, t)))
    Gate.tyToksL(w, g, u, Ast.a(g, t), 0)


