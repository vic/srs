// an atomic op is a request on Atomic (s2/types.srs:724, :775-789)
def Gate.isAtomOp(w: Resolve.W, s: I64): Bool = s == Resolve.sym(w, Resolve.lit("ACell.load"), false) || s == Resolve.sym(w, Resolve.lit("ACell.store"), false) || s == Resolve.sym(w, Resolve.lit("ACell.fetchAdd"), false) || s == Resolve.sym(w, Resolve.lit("ACell.cas"), false)

