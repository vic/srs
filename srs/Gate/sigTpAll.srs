// sigT rows for op or fn o from the [] binders of the enclosing capability or handler telescope (items l)
def Gate.sigTpAll(w: Resolve.W, g: Ast.G, u: I64, o: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val n = Ast.item(g, l, i)
    if Ast.kd(g, n) == Ast.kGTypes() then Gate.sigTp(w, g, u, o, Ast.a(g, n), 0) else ()
    Gate.sigTpAll(w, g, u, o, l, i + 1)
  else ()


