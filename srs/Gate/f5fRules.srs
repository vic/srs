// prompt: family F5f (K-AT part 2, s5 design k-at/design.md REV 2 + f7-rewrite-plan.md WP1-WP3): ONE scoped fact family factBelow /
// factBelowLiteral / factLessOrEqual / factLessOrEqualLiteral / factLiteralBelow (u, a, b, c, t) = the relation holds at every node n
// with c < n, n <= t; sources: guards (glt, gltL, gle, glb under ithen, var binders excluded by mutB), the U64.remainder val binder
// (arithRemainderBound over its val scope), transitivity only where one scope contains the other, and the credit of proved assertions
// (FactCredit scope: the later statements of the block). An assertion atom names a kernel relation (Srs.Facts.below / lessOrEqual) by
// exact unit or by the prelude short name when no unit has that exact name; it is proved from the family at its point, else
// assertion-unproved; any other atom is fact-unchecked. The index rule provedI reads only the family (no direct guard rows).
def Gate.f5fRules(): Str = ".decl factAtom(c1: number, c2: number, c3: number, c4: number, c5: number)\n.input factAtom\n.decl factBelowUnit(c1: number, c2: number)\n.input factBelowUnit\n.decl factLessOrEqualUnit(c1: number, c2: number)\n.input factLessOrEqualUnit\n.decl factHeadUnit(c1: number, c2: number, c3: number)\n.decl factPoint(c1: number, c2: number, c3: number)\n.decl factArity(c1: number, c2: number, c3: number)\n.decl factLeftLocal(c1: number, c2: number, c3: number)\n.decl factLeftLiteral(c1: number, c2: number, c3: number)\n.decl factRightLocal(c1: number, c2: number, c3: number)\n.decl factRightLiteral(c1: number, c2: number, c3: number)\n.decl factHeadName(c1: number, c2: number, c3: number)\n.decl factCredit(c1: number, c2: number, c3: number, c4: number)\n.decl factHeadDeclared(c1: number, c2: number)\n.decl factRelationOf(c1: number, c2: number, c3: number)\n.decl factBelowAtom(c1: number, c2: number)\n.decl factLessOrEqualAtom(c1: number, c2: number)\n.decl factSafetyAtom(c1: number, c2: number)\n.decl factBelow(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl factBelowLiteral(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl factLessOrEqual(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl factLessOrEqualLiteral(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl factLiteralBelow(c1: number, c2: number, c3: number, c4: number, c5: number)\n.decl factProved(c1: number, c2: number)\n.decl factUnsigned(c1: number, c2: number)\n.decl factNonNegative(c1: number, c2: number, c3: number, c4: number)\n.decl badAssertion(c1: number)\n.decl badFactUnchecked(c1: number)\n.output badAssertion\n.output badFactUnchecked\nfactHeadUnit(u, a, v) :- factAtom(0, u, a, v, y).\nfactPoint(u, a, p) :- factAtom(1, u, a, p, y).\nfactArity(u, a, k) :- factAtom(2, u, a, k, y).\nfactLeftLocal(u, a, x) :- factAtom(3, u, a, x, y).\nfactLeftLiteral(u, a, l) :- factAtom(4, u, a, l, y).\nfactRightLocal(u, a, x) :- factAtom(5, u, a, x, y).\nfactRightLiteral(u, a, l) :- factAtom(6, u, a, l, y).\nfactHeadName(u, a, s) :- factAtom(7, u, a, s, y).\nfactCredit(u, p, s, b) :- factAtom(8, u, p, s, b).\nfactHeadDeclared(u, a) :- factHeadUnit(u, a, v).\nfactRelationOf(u, a, v) :- factHeadUnit(u, a, v).\nfactRelationOf(u, a, v) :- factHeadName(u, a, s), factBelowUnit(v, s), !factHeadDeclared(u, a).\nfactRelationOf(u, a, v) :- factHeadName(u, a, s), factLessOrEqualUnit(v, s), !factHeadDeclared(u, a).\nfactBelowAtom(u, a) :- factRelationOf(u, a, v), factBelowUnit(v, s), factArity(u, a, 2).\nfactLessOrEqualAtom(u, a) :- factRelationOf(u, a, v), factLessOrEqualUnit(v, s), factArity(u, a, 2).\nfactSafetyAtom(u, a) :- factBelowAtom(u, a).\nfactSafetyAtom(u, a) :- factLessOrEqualAtom(u, a).\nfactBelow(u, x, y, c, t) :- glt(u, c, x, y), ithen(u, c, t), !mutB(u, x), !mutB(u, y).\nfactBelowLiteral(u, x, l, c, t) :- gltL(u, c, x, l), ithen(u, c, t), !mutB(u, x).\nfactBelowLiteral(u, r, l, n, b) :- arithRemainderBound(u, r, l), vb(u, n, r, b, h, k), !mutB(u, r).\nfactLessOrEqual(u, x, y, c, t) :- gle(u, c, x, y), ithen(u, c, t), !mutB(u, x), !mutB(u, y).\nfactLiteralBelow(u, l, x, c, t) :- glb(u, c, l, x), ithen(u, c, t), !mutB(u, x).\nfactLessOrEqual(u, x, y, c, t) :- factBelow(u, x, y, c, t).\nfactLessOrEqualLiteral(u, x, l, c, t) :- factBelowLiteral(u, x, l, c, t).\nfactBelow(u, x, z, d, e) :- factBelow(u, x, y, c, t), factLessOrEqual(u, y, z, d, e), c <= d, e <= t.\nfactBelow(u, x, z, c, t) :- factBelow(u, x, y, c, t), factLessOrEqual(u, y, z, d, e), d <= c, t <= e.\nfactBelow(u, x, z, d, e) :- factLessOrEqual(u, x, y, c, t), factBelow(u, y, z, d, e), c <= d, e <= t.\nfactBelow(u, x, z, c, t) :- factLessOrEqual(u, x, y, c, t), factBelow(u, y, z, d, e), d <= c, t <= e.\nfactLessOrEqual(u, x, z, d, e) :- factLessOrEqual(u, x, y, c, t), factLessOrEqual(u, y, z, d, e), c <= d, e <= t.\nfactLessOrEqual(u, x, z, c, t) :- factLessOrEqual(u, x, y, c, t), factLessOrEqual(u, y, z, d, e), d <= c, t <= e.\nfactBelowLiteral(u, x, l, d, e) :- factLessOrEqual(u, x, y, c, t), factBelowLiteral(u, y, l, d, e), c <= d, e <= t.\nfactBelowLiteral(u, x, l, c, t) :- factLessOrEqual(u, x, y, c, t), factBelowLiteral(u, y, l, d, e), d <= c, t <= e.\nfactLessOrEqualLiteral(u, x, l, d, e) :- factLessOrEqual(u, x, y, c, t), factLessOrEqualLiteral(u, y, l, d, e), c <= d, e <= t.\nfactLessOrEqualLiteral(u, x, l, c, t) :- factLessOrEqual(u, x, y, c, t), factLessOrEqualLiteral(u, y, l, d, e), d <= c, t <= e.\nfactProved(u, a) :- factBelowAtom(u, a), factPoint(u, a, p), factLeftLocal(u, a, x), factRightLocal(u, a, y), factBelow(u, x, y, c, t), c < p, p <= t.\nfactProved(u, a) :- factBelowAtom(u, a), factPoint(u, a, p), factLeftLocal(u, a, x), factRightLiteral(u, a, l), factBelowLiteral(u, x, m, c, t), m <= l, c < p, p <= t.\nfactProved(u, a) :- factBelowAtom(u, a), factPoint(u, a, p), factLeftLiteral(u, a, k), factRightLocal(u, a, y), factLiteralBelow(u, m, y, c, t), k <= m, c < p, p <= t.\nfactProved(u, a) :- factBelowAtom(u, a), factLeftLiteral(u, a, k), factRightLiteral(u, a, l), k < l.\nfactProved(u, a) :- factLessOrEqualAtom(u, a), factPoint(u, a, p), factLeftLocal(u, a, x), factRightLocal(u, a, y), factLessOrEqual(u, x, y, c, t), c < p, p <= t.\nfactProved(u, a) :- factLessOrEqualAtom(u, a), factPoint(u, a, p), factLeftLocal(u, a, x), factRightLiteral(u, a, l), factLessOrEqualLiteral(u, x, m, c, t), m <= l, c < p, p <= t.\nfactProved(u, a) :- factLessOrEqualAtom(u, a), factPoint(u, a, p), factLeftLiteral(u, a, k), factRightLocal(u, a, y), factLiteralBelow(u, m, y, c, t), k <= m, c < p, p <= t.\nfactProved(u, a) :- factLessOrEqualAtom(u, a), factLeftLiteral(u, a, k), factRightLiteral(u, a, l), k <= l.\nfactBelow(u, x, y, s, b) :- factBelowAtom(u, a), factProved(u, a), factPoint(u, a, p), factCredit(u, p, s, b), factLeftLocal(u, a, x), factRightLocal(u, a, y), !mutB(u, x), !mutB(u, y).\nfactBelowLiteral(u, x, l, s, b) :- factBelowAtom(u, a), factProved(u, a), factPoint(u, a, p), factCredit(u, p, s, b), factLeftLocal(u, a, x), factRightLiteral(u, a, l), !mutB(u, x).\nfactLiteralBelow(u, k, y, s, b) :- factBelowAtom(u, a), factProved(u, a), factPoint(u, a, p), factCredit(u, p, s, b), factLeftLiteral(u, a, k), factRightLocal(u, a, y), !mutB(u, y).\nfactLessOrEqual(u, x, y, s, b) :- factLessOrEqualAtom(u, a), factProved(u, a), factPoint(u, a, p), factCredit(u, p, s, b), factLeftLocal(u, a, x), factRightLocal(u, a, y), !mutB(u, x), !mutB(u, y).\nfactLessOrEqualLiteral(u, x, l, s, b) :- factLessOrEqualAtom(u, a), factProved(u, a), factPoint(u, a, p), factCredit(u, p, s, b), factLeftLocal(u, a, x), factRightLiteral(u, a, l), !mutB(u, x).\nbadAssertion(u) :- factSafetyAtom(u, a), !factProved(u, a).\nbadFactUnchecked(u) :- factPoint(u, a, p), !factSafetyAtom(u, a).\nfactUnsigned(u, i) :- unsignedB(u, i).\nfactUnsigned(u, r) :- arithRemainderBound(u, r, l).\nfactNonNegative(u, i, c, t) :- ge0(u, c, i), ithen(u, c, t), !mutB(u, i).\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), iarg(u, n, i), alen(u, a, m), factBelow(u, i, m, c, t), c < n, n <= t, factUnsigned(u, i).\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), iarg(u, n, i), alen(u, a, m), factBelow(u, i, m, c, t), c < n, n <= t, factNonNegative(u, i, d, e), d < n, n <= e.\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), iarg(u, n, i), alenLit(u, a, l), factBelowLiteral(u, i, m, c, t), c < n, n <= t, m <= l, factUnsigned(u, i).\nprovedI(u, n) :- isite(u, n), iarr(u, n, a), iarg(u, n, i), alenLit(u, a, l), factBelowLiteral(u, i, m, c, t), c < n, n <= t, m <= l, factNonNegative(u, i, d, e), d < n, n <= e.\n"

