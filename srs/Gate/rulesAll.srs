// the whole gate program: the decls and rules of every family, joined in one text
// prompt: the gate program text: families F2, F5b decls, F5b, F5c and F5d, in that order (relMsg tags count decls in this text).
def Gate.rulesAll(): Str =
  Console.captureBegin()
  Console.print(Gate.f2Rules())
  Console.print(Gate.f5bDecls())
  Console.print(Gate.f5bRules())
  Console.print(Gate.f5cRules())
  Console.print(Gate.f5dRules())
  Console.captureEnd()