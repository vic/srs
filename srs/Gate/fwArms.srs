def Gate.fwArms(w: Resolve.W, g: Ast.G, sel: Gate.Fk, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), blk: I64, n: I64, e: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val arm = Ast.item(g, l, i)
    val body = Ast.b(g, arm)
    if Gate.fkB(sel) == Gate.fkB(Gate.FPsub) then Gate.psubRows(w, g, false, u, Ast.a(g, arm))
    else if Gate.fkB(sel) == Gate.fkB(Gate.FPdot) then Gate.psubRows(w, g, true, u, Ast.a(g, arm))
    else ()
    if Gate.fkB(sel) == Gate.fkB(Gate.FPbind) && Ast.kd(g, Ast.a(g, arm)) == Ast.kPCase() then Gate.pbindRows(w, g, u, Ast.a(g, arm), Ast.tok(g, Ast.a(g, arm)), Ast.a(g, Ast.a(g, arm)), 0) else ()
    if Gate.fkB(sel) == Gate.fkB(Gate.FScrutArm) then Gate.optRow3(u, Ast.a(g, arm), Gate.localOf(g, rcap, rk, rf, e)) else ()
    val bv = Gate.valueOf(g, body)
    val bj = Ast.tok(g, bv)
    if Gate.fkB(sel) == Gate.fkB(Gate.FPtail) && Ast.kd(g, bv) == Ast.kName() && 0 <= bj && bj < rcap && I64.ofU8(rk(bj)) == Resolve.kLocal() then Gate.row3(u, n, I64.of(rf(bj))) else ()
// prompt: the flow facts of the arms l[i..] of match n (scrutinee e) of unit u: pattern subs and dots, pattern binders (pbind), an arm
// whose body is a bare local (ptail(u, n, local): the match returns that local), the scrutinee-to-arm and arm-to-match edges, then
// each arm body walked.
    Gate.fe(sel, Gate.FXe, u, e, body)
    Gate.fe(sel, Gate.FXx, u, body, n)
    Gate.fw(w, g, sel, u, rcap, rk, rf, blk, body)
    Gate.fwArms(w, g, sel, u, rcap, rk, rf, blk, n, e, l, i + 1)
  else ()

