// prompt: the number of a factAtom row tag (column 1; Gate.f5fRules splits the relation by these numbers).
def Gate.factTagNumber(t: Gate.FactTag): I64 = t match
  case Gate.FactHead => 0
  case Gate.FactAssert => 1
  case Gate.FactArity => 2
  case Gate.FactLeftLocal => 3
  case Gate.FactLeftLiteral => 4
  case Gate.FactRightLocal => 5
  case Gate.FactRightLiteral => 6
  case Gate.FactHeadName => 7
  case Gate.FactCredit => 8

