def Gate.capRoots(w: Resolve.W, g: Ast.G, sel: Gate.Ck, c: I64, rc: I64, dk: Array[U8](rc), dr: Array[U32](rc), i: I64): Unit =
  if 0 <= i && i < rc then
    if I64.ofU8(dk(i)) == Split.kindByte(Split.Capability) then Gate.capItems(w, g, sel, c, Ast.b(g, I64.of(dr(i))), 0) else ()
    Gate.capRoots(w, g, sel, c, rc, dk, dr, i + 1)
  else ()

