// a write is a request on Mut (s2/types.srs:687 Cell.put, :911 Array.put, :938 Array.blit)
def Gate.isMutOp(w: Resolve.W, s: I64): Bool = s == Resolve.sym(w, Resolve.lit("Array.put"), false) || s == Resolve.sym(w, Resolve.lit("Cell.put"), false) || s == Resolve.sym(w, Resolve.lit("Array.blit"), false)

