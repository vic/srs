// the types a handler state may not have: the handle site keeps the state as a void*, so a scalar or a Str (16 bytes) is cut or converted
def Gate.nonPtrText(w: Resolve.W): Str =
  Console.captureBegin()
  Gate.symRows(w, Os.More("I64", Os.More("Bool", Os.More("Unit", Os.More("I32", Os.More("U8", Os.More("U16", Os.More("U32", Os.More("U64", Os.More("I8", Os.More("I16", Os.More("F64", Os.More("Char", Os.More("Str", Os.End))))))))))))))
  Console.captureEnd()

