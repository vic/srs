// the diagnostics of the G.f5cRules families: one line per rejected unit and code
def Gate.sigMsgs(ps: Os.Strs, out: Str): Str =
  val t = Gate.rulesAll()
  Console.captureBegin()
  Gate.relMsg("error[exit-state]", "badExit", t, ps, out)
  Gate.relMsg("error[entry-facts-unsolvable]", "badUnsolv", t, ps, out)
  Gate.relMsg("error[fact-not-op]", "badFactOp", t, ps, out)
  Gate.relMsg("error[fact-twice]", "badTwice", t, ps, out)
  Gate.relMsg("error[unknown-relation]", "badRel", t, ps, out)
  Gate.relMsg("error[region-ended-under-handle]", "badRegH", t, ps, out)
  Gate.relMsg("error[handler-arity]", "badHArity", t, ps, out)
  Gate.relMsg("error[mismatch]", "badHType", t, ps, out)
  Gate.relMsg("error[op-signature]", "badHSig", t, ps, out)
  Gate.relMsg("error[binder-hides-type]", "badHide", t, ps, out)
  Gate.relMsg("error[chosen-not-capability]", "badChosen", t, ps, out)
  Gate.relMsg("error[binder-not-in-head]", "badGHead", t, ps, out)
  Gate.relMsg("error[ambiguous-givens]", "badOverlap", t, ps, out)
  Gate.relMsg("error[given-fuel]", "badFuel", t, ps, out)
  Gate.relMsg("error[op-binder]", "badOpBinder", t, ps, out)
  Gate.relMsg("error[ambiguous-evidence]", "badAmbEv", t, ps, out)
  Gate.relMsg("error[test-capability]", "badTestCap", t, ps, out)
  Gate.relMsg("error[trait-arity]", "badTArity", t, ps, out)
  Gate.relMsg("error[method-signature]", "badTSig", t, ps, out)
  Gate.relMsg("error[missing-method]", "badTMiss", t, ps, out)
  Gate.relMsg("error[not-a-method]", "badTNotM", t, ps, out)
  Gate.relMsg("error[given-row]", "badGRow", t, ps, out)
  Gate.relMsg("error[not-a-trait]", "badNotTrait", t, ps, out)
  Gate.relMsg("error[handler-state-shape]", "badHState", t, ps, out)
  Gate.relMsg("error[no-capability]", "badNoCapM", t, ps, out)
  Gate.relMsg("error[length-unnamed]", "badLoopLen", t, ps, out)
  Gate.relMsg("error[region-escape]", "badEscB", t, ps, out)
  Gate.relMsg("error[region-escape]", "badPutEsc", t, ps, out)
  Gate.relMsg("error[cell-seal]", "badSeal", t, ps, out)
  Gate.relMsg("error[region-escape]", "badEscP", t, ps, out)
  Gate.relMsg("error[comptime-handle]", "badCtHandle", t, ps, out)
  Gate.relMsg("error[impure-call]", "badImpure", t, ps, out)
  Gate.relMsg("error[unhandled-effect]", "badValEff", t, ps, out)
  Gate.relMsg("error[val-at-run-time]", "badValRt", t, ps, out)
  Gate.relMsg("error[answer-type]", "badAns", t, ps, out)
  Gate.relMsg("error[multishot-shape]", "badMsShape", t, ps, out)
  Gate.relMsg("error[multishot-state]", "badMsState", t, ps, out)
  Gate.relMsg("error[rule-shape]", "badRuleShape", t, ps, out)
  Gate.relMsg("error[fact-ambiguous]", "badAmbFact", t, ps, out)
  Console.captureEnd()
// prompt: (above) one diag line per unit and code for every output relation of families F5c and F5d (Gate.relMsg).