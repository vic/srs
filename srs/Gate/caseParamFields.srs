// prompt: for each field i of the case fields fl typed Ty(arg0, ..) with arg0 a Name: the position k of that name among the
// enum value params ps (Gate.paramIndex by symbol); a match gives caseParamLength(s, i, k).
def Gate.caseParamFields(w: Resolve.W, g: Ast.G, s: I64, fl: I64, ps: I64, i: I64): Unit =
  if i < Ast.len(g, fl) then
    val n = Ast.item(g, fl, i)
    val t0 = Ast.a(g, n)
    val t = if Ast.kd(g, t0) == Ast.kTyCaps() then Ast.a(g, t0) else t0
    if Ast.kd(g, n) == Ast.kBind() && Ast.kd(g, t) == Ast.kTy() && Ast.len(g, Ast.b(g, t)) >= 1 && Ast.kd(g, Ast.item(g, Ast.b(g, t), 0)) == Ast.kName() then
      Gate.paramIndex(w, g, ps, Gate.tsym(w, g, Ast.tok(g, Ast.item(g, Ast.b(g, t), 0))), 0) match
        case Coll.Some(k) => Gate.row3(s, i, k)
        case Coll.None => ()
    else ()
    Gate.caseParamFields(w, g, s, fl, ps, i + 1)
  else ()

