// the signature rows of op or fn o (header parts ps): sigP / sigN(u, o, n) value params, sigR(u, o, t) result type head, sigG(u, o) a {..} group, sigT type binders
def Gate.sigParts(w: Resolve.W, g: Ast.G, sel: Gate.Fk, u: I64, self: I64, o: I64, ps: I64, i: I64): Unit =
  if i < Ast.len(g, ps) then
    val p = Ast.item(g, ps, i)
    val k = Ast.kd(g, p)
    if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FSigP) then
      val n = Gate.sigPar(w, g, u, self, o, Ast.a(g, p), 0, 0, true)
    else ()
    if k == Ast.kParams() && Gate.fkB(sel) == Gate.fkB(Gate.FSigN) then Gate.row3(u, o, Gate.sigPar(w, g, u, self, o, Ast.a(g, p), 0, 0, false)) else ()
    if (k == Ast.kRet() || k == Ast.kOpRet() || k == Ast.kOpRetC()) && Gate.fkB(sel) == Gate.fkB(Gate.FSigR) then Gate.row3(u, o, Gate.tsym(w, g, Ast.tok(g, Ast.a(g, p)))) else ()
    if k == Ast.kGEv() && Gate.fkB(sel) == Gate.fkB(Gate.FSigG) then Gate.row2(u, o) else ()
    if k == Ast.kGEv() && Gate.fkB(sel) == Gate.fkB(Gate.FEvTy) then Gate.evTyRows(w, g, u, Ast.a(g, p), 0) else ()
    if k == Ast.kGTypes() && Gate.fkB(sel) == Gate.fkB(Gate.FSigT) then Gate.sigTp(w, g, u, o, Ast.a(g, p), 0) else ()
    Gate.sigParts(w, g, sel, u, self, o, ps, i + 1)
  else ()


