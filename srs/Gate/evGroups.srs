def Gate.evGroups(g: Ast.G, u: I64, rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap), n: I64, l: I64, i: I64): Unit =
  if i < Ast.len(g, l) then
    val grp = Ast.item(g, l, i)
    if Ast.kd(g, grp) == Ast.kCGEv() then Gate.evToks(g, u, rcap, rk, rf, n, Ast.a(g, grp), 0) else ()
    Gate.evGroups(g, u, rcap, rk, rf, n, l, i + 1)
  else ()

