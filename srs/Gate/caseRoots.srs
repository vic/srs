def Gate.caseRoots(w: Resolve.W, g: Ast.G, u: I64, rc: I64, rk: Array[U8](rc), rr: Array[U32](rc), i: I64): Unit =
  if 0 <= i && i < rc then
    if I64.ofU8(rk(i)) == Split.kindByte(Split.Enum) then Gate.caseItems(w, g, u, Ast.b(g, I64.of(rr(i))), 0) else ()
    Gate.caseRoots(w, g, u, rc, rk, rr, i + 1)
  else ()