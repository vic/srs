// a value of a builtin scalar type lives in no region
def Gate.isScalarSym(w: Resolve.W, s: I64): Bool = s == Resolve.sym(w, Resolve.lit("I64"), false) || s == Resolve.sym(w, Resolve.lit("Bool"), false) || s == Resolve.sym(w, Resolve.lit("Unit"), false) || s == Resolve.sym(w, Resolve.lit("I32"), false) || s == Resolve.sym(w, Resolve.lit("U8"), false) || s == Resolve.sym(w, Resolve.lit("U16"), false) || s == Resolve.sym(w, Resolve.lit("U32"), false) || s == Resolve.sym(w, Resolve.lit("U64"), false) || s == Resolve.sym(w, Resolve.lit("I8"), false) || s == Resolve.sym(w, Resolve.lit("I16"), false) || s == Resolve.sym(w, Resolve.lit("F64"), false) || s == Resolve.sym(w, Resolve.lit("Char"), false)

