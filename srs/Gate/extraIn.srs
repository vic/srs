  val n2 = Os.More("gTp", Os.More("gHd", Os.More("gArg", Os.More("gHdSize", Os.More("gEvSize", Os.More("evTy", n))))))
  val r2 = Os.More(Gate.flowText(w, Gate.FGTp, rs), Os.More(Gate.flowText(w, Gate.FGHd, rs), Os.More(Gate.flowText(w, Gate.FGArg, rs), Os.More(Gate.flowText(w, Gate.FGHdSize, rs), Os.More(Gate.flowText(w, Gate.FGEvSize, rs), Os.More(Gate.flowText(w, Gate.FEvTy, rs), r))))))
  val ns = Os.More("tpos", Os.More("hideB", Os.More("sigP", Os.More("sigN", Os.More("sigR", Os.More("sigG", Os.More("sigT", Os.More("reqOp", Os.More("sigE", Os.More("sigX", Os.More("relA", Os.More("nextSym", Os.More("testCap", Os.More("gHu", Os.More("nonPtrT", Os.More("initSym", Os.More("ruleAtom", Os.More("ruleLen", Os.More("ruleBad", Os.More("relU", n2))))))))))))))))))))
  val xs = Os.More(Gate.flowText(w, Gate.FTpos, rs), Os.More(Gate.flowText(w, Gate.FHide, rs), Os.More(Gate.flowText(w, Gate.FSigP, rs), Os.More(Gate.flowText(w, Gate.FSigN, rs), Os.More(Gate.flowText(w, Gate.FSigR, rs), Os.More(Gate.flowText(w, Gate.FSigG, rs), Os.More(Gate.flowText(w, Gate.FSigT, rs), Os.More(Gate.reqOpText(w, rs), Os.More(Gate.flowText(w, Gate.FSigE, rs), Os.More(Gate.flowText(w, Gate.FSigX, rs), Os.More(Gate.flowText(w, Gate.FRel, rs), Os.More(Gate.symText(w, "next"), Os.More(Gate.testCapText(w), Os.More(Gate.flowText(w, Gate.FGHu, rs), Os.More(Gate.nonPtrText(w), Os.More(Gate.symText(w, "init"), Os.More(Gate.ruleText(w, rs, Gate.RAtom), Os.More(Gate.ruleText(w, rs, Gate.RLen), Os.More(Gate.ruleText(w, rs, Gate.RBad), Os.More(Gate.ruleText(w, rs, Gate.RUse), r2))))))))))))))))))))
  Gate.In(Os.More("kOp", Os.More("doneSym", Os.More("csNew", Os.More("atSym", Os.More("topVal", Os.More("ptail", Os.More("caseFty", Os.More("retTp", Os.More("rawPtr", Os.More("cellNewSym", Os.More("cellPutSym", ns))))))))))), Os.More(Gate.kOpText(w, rs), Os.More(Gate.symText(w, "done"), Os.More(Gate.csNewText(rs), Os.More(Gate.symText(w, "at"), Os.More(Gate.topValText(rs), Os.More(Gate.flowText(w, Gate.FPtail, rs), Os.More(Gate.flowText(w, Gate.FCaseFty, rs), Os.More(Gate.retTpText(rs), Os.More(Gate.rawPtrText(w, rs), Os.More(Gate.symText(w, "Cell.new"), Os.More(Gate.symText(w, "Cell.put"), xs))))))))))))
