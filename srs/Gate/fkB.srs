// prompt: the number of a fact selector (compared by the walkers; FPtail 74, FCaseFty 75, FUnsigned 76, FArith 77, then K3 OPEN-D
// FScrutArm 78, FCaseParamLen 79, FTypeArg 80 appended at the end; K-AT part 2 FFact 81).
def Gate.fkB(k: Gate.Fk): I64 = k match
  case Gate.FXe => 0
  case Gate.FEe => 1
  case Gate.FXx => 2
  case Gate.FEx => 3
  case Gate.FHst => 4
  case Gate.FOp => 5
  case Gate.FUse => 6
  case Gate.FEv => 7
