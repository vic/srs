  case Gate.FVbound => 21
  case Gate.FEvpos => 22
  case Gate.FEvarg => 23
  case Gate.FCarg => 24
  case Gate.FPpos => 25
  case Gate.FCtok => 26
  case Gate.FErased => 27
  case Gate.FCapParam => 28
  case Gate.FTrait => 29
  case Gate.FTval => 30
  case Gate.FAtAt => 31
  case Gate.FFvar => 32
  case Gate.FPsub => 33
  case Gate.FPdot => 34
  case Gate.FCname => 35
  case Gate.FArg => 36
  case Gate.FArgL => 37
  case Gate.FIsite => 38
  case Gate.FIarr => 39
  case Gate.FIarg => 40
