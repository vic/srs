// prompt: a call of a global def n (tail = tail position): a self tail call is a jump; a generic class-1 extern is one C symbol with void* slots; else the def, instance or extern name with the args (a class-1 C extern first gets its {} binders as srs_cap* args, Emit.capArgs; a def that drops {} binders gets their caps last, Emit.pdArgs); a call whose one explicit evidence is a Region handle allocates in it (srs_cur set around the call, Emit.curWrap)
def Emit.callG(e: Emit.E, n: I64, tail: Bool): Unit =
  val g = Emit.gOf(e)
  val s = Emit.sOf(e)
  val w = Emit.wOf(e)
  val Emit.E(_, k, _, ntp, _, own, _, _) = e
  val sym = Emit.ce(e, n)
  val cls = Emit.kget(k, sym)
  val gen = Typer.sigAt(s, sym, 3) > 0 && Emit.ax(e, n) > 0
  val same = !gen || Emit.siteSame(e, Typer.mxGet(s, Typer.moSite(Emit.ax(e, n) - 1, 2)) - 1, 0, Typer.mxGet(s, Typer.moSite(Emit.ax(e, n) - 1, 3)))
  if cls == 6 then Emit.unsup(e, Ast.kCall())
  else if tail && sym == own && same && Ast.len(g, Ast.b(g, n)) == Typer.sigAt(s, sym, 2) then Emit.tailCall(e, n, sym)
  else if cls == 1 && Typer.sigAt(s, sym, 3) > 0 then
    // a generic extern is one C symbol with void* slots
    Emit.po(e,"((")
    Emit.cty(e, Emit.tyS(e, n))
    Emit.po(e,")")
    Emit.id(e,sym)
    Emit.po(e,"(")
    Emit.vargs(e, Ast.b(g, n), 0)
    Emit.po(e,"))")
  else
    val cw = if cls == 0 then Emit.curWrap(e, n, sym) else 0 - 1
    if cw >= 0 then
      Emit.po(e,"({ srs_cap* sv_")
      Emit.pi(e, n)
      Emit.po(e," = srs_cur; srs_cur = &hk_")
      Emit.pi(e, cw)
      Emit.po(e,"; ")
      Emit.cty(e, Emit.tyS(e, n))
      Emit.po(e," rv_")
      Emit.pi(e, n)
      Emit.po(e," = ")
    else ()
    if gen then Emit.instNm(e, sym, Emit.ax(e, n) - 1)
    else if cls == 0 then
      Emit.po(e,"f_")
      Emit.id(e,sym)
    else Emit.id(e,sym)
    Emit.po(e,"(")
    if cls == 1 then Emit.capArgs(e, Typer.sigAt(s, sym, 4), Ast.len(g, Ast.b(g, n)) > 0) else ()
    Emit.args(e, Ast.b(g, n), 0, false)
    if cls == 0 then Emit.pdArgs(e, n, Emit.pdGet(k, sym), 0, Ast.len(g, Ast.b(g, n)) > 0) else ()
    Emit.po(e,")")
    if cw >= 0 then
      Emit.po(e,"; srs_cur = sv_")
      Emit.pi(e, n)
      Emit.po(e,"; rv_")
      Emit.pi(e, n)
      Emit.po(e,"; })")
    else ()