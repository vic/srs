// prompt: the cut kind of expression n (multi-shot emit, s2 C3.3/C3.4): 1 a request of a multi-shot capability op (method or qualified call), 2 a call of a CPS def (class 6), 3 an if whose arm is a cut, 0 none; a paren is its inner expression
def Emit.msCut(e: Emit.E, n: I64): I64 =
  val g = Emit.gOf(e)
  val k = Ast.kd(g, n)
  val uk = Typer.useKind(Emit.xOf(e), Ast.tok(g, n))
  if k == Ast.kParen() || (k == Ast.kAssert() && Ast.a(g, n) != 0) then Emit.msCut(e, Ast.a(g, n))
  else if k == Ast.kMethod() && Emit.msCapOp(e, Emit.ce(e, n), 0) then 1
  else if k == Ast.kCall() && uk == Resolve.kCap() && Emit.msCapOp(e, Emit.ce(e, n), 0) then 1
  else if k == Ast.kCall() && uk == Resolve.kGlobal() && Emit.kget(Emit.kOf(e), Emit.ce(e, n)) == 6 then 2
  else if (k == Ast.kIf() || k == Ast.kIfNl()) && (Emit.msCut(e, Ast.a(g, Ast.b(g, n))) > 0 || Emit.msCut(e, Ast.b(g, Ast.b(g, n))) > 0) then 3
  else 0

