// prompt: `static R name(params)` of a def (inst >= 0: the name of instance inst), then a `srs_cap* rp_<tok>` param per {} binder the def drops (Emit.pdParams); it starts a fn body, so the handle-binder stack is reset (Emit.hreset)
def Emit.head(e: Emit.E, root: I64, sym: I64, inst: I64): Unit =
  val g = Emit.gOf(e)
  val s = Emit.sOf(e)
  val pr = Ast.a(g, Typer.part(g, Ast.b(g, root), 0, Ast.kParams()))
  val n = Typer.sigAt(s, sym, 2)
  val mask = Emit.pdGet(Emit.kOf(e), sym)
  Emit.hreset(Emit.kOf(e))
  Emit.po(e,"static ")
  Emit.cty(e, Emit.sub(e, Typer.sigAt(s, sym, 0)))
  Emit.po(e," ")
  if inst >= 0 then Typer.instName(Emit.wOf(e), s, inst)
  else
    Emit.po(e,"f_")
    Emit.id(e,sym)
  Emit.po(e,"(")
  if n == 0 && mask == 0 then Emit.po(e,"void") else Emit.params(e, pr, sym, 0, n)
  Emit.pdParams(e, root, mask, 0, 0, n > 0)
  Emit.po(e,")")

