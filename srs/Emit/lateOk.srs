// prompt: true when every type id i.. below n is a capability/trait type (kind cap: C void*, no struct or layout), so a type interned after the structs were emitted (a given goal found while given instances are emitted, Emit.gdrain) is harmless; any other late type fails the emit
def Emit.lateOk(s: Typer.S, i: I64, n: I64): Bool =
  if i < n then Typer.kind(s, i) == Typer.bCap() && Emit.lateOk(s, i + 1, n) else true