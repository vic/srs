// prompt: Emit.gbind over the args i.. below n of h and z, the first binding found
def Emit.gbindArgs(s: Typer.S, h: I64, z: I64, p: I64, i: I64, n: I64): I64 =
  if i < n then
    val r = Emit.gbind(s, Typer.arg(s, h, i), Typer.arg(s, z, i), p)
    if r != 0 then r else Emit.gbindArgs(s, h, z, p, i + 1, n)
  else 0

