// prompt: the end of one statement st of a block: a val that shadowed a handle gives the innermost handler back; a handle runs its drop op behind its live flag, then the handler state, and for a capability with several handlers its innermost (hc_) and the handler's outer (ho_), go back to their values before the handle
def Emit.dropOne(e: Emit.E, st: I64): Unit =
  val g = Emit.gOf(e)
  if Ast.kd(g, st) == Ast.kVal() || Ast.kd(g, st) == Ast.kVar() then
    val sh = Emit.shadowH(e, Ast.text(g, Ast.tok(g, st)), Ast.tok(g, st), Emit.hget(Emit.kOf(e), Emit.hsBase()) - 1)
    if sh != 0 && Emit.hmulti(Emit.kOf(e), Emit.capOfH(Emit.sOf(e), sh), sh, 0) then
      Emit.po(e,"hc_")
      Emit.id(e, Emit.capOfH(Emit.sOf(e), sh))
      Emit.po(e," = hsh_")
      Emit.pi(e, Ast.tok(g, st))
      Emit.po(e,"; ")
    else ()
  else ()
  if Ast.kd(g, st) == Ast.kHandle() then
    val w = Emit.wOf(e)
    val dsym = Emit.dropOf(Emit.kOf(e), Typer.head(Emit.sOf(e), Emit.ty(e, st)), 0)
    val h = Emit.ce(e, st)
    val tk = Ast.tok(g, st)
    if dsym != 0 then
      Emit.po(e,"if (hl_")
      Emit.pi(e,tk)
      Emit.po(e,") { hl_")
      Emit.pi(e,tk)
      Emit.po(e," = 0; h_")
      Emit.id(e,h)
      Emit.po(e,"_")
      Emit.symTail(e, w,dsym, Emit.lastDot(w, dsym, 0, 0 - 1) + 1)
      Emit.po(e,"(hs_")
      Emit.id(e,h)
      Emit.po(e,"); } ")
    else ()
    Emit.po(e,"hs_")
    Emit.id(e,h)
    Emit.po(e," = hv_")
    Emit.pi(e,tk)
    Emit.po(e,"; ")
    val cap = Emit.capOfH(Emit.sOf(e), h)
    if Emit.hmulti(Emit.kOf(e), cap, h, 0) then
      Emit.po(e,"hc_")
      Emit.id(e, cap)
      Emit.po(e," = hcv_")
      Emit.pi(e, tk)
      Emit.po(e,"; ho_")
      Emit.id(e, h)
      Emit.po(e," = hov_")
      Emit.pi(e, tk)
      Emit.po(e,"; ")
    else ()
  else ()

