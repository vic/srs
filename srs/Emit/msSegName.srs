// prompt: the C name of segment idx (its first statement index) of chain ckey (0 = the handled rest of the site's def, else the CPS def symbol) of the multi-shot site (its handle token): ms_<site>_<ckey>_<idx>, idx < 0 = the end segment
def Emit.msSegName(e: Emit.E, site: I64, ckey: I64, idx: I64): Unit =
  Emit.po(e,"ms_")
  Emit.pi(e, site)
  Emit.po(e,"_")
  Emit.pi(e, ckey)
  Emit.po(e,"_")
  if idx < 0 then Emit.po(e,"end") else Emit.pi(e, idx)

