// prompt: the C of Array.tabulate[F](n): n elements, element i = g_<mangle Array.Gen[F, A]>_at(i), the at method of the given Array.Gen[F, A] (F = the node's aux type Emit.rv, A = the element of the node type). The type Array.Gen[F, A] is interned at emit time: without such a given it is a new type id, so lateTypes > 0 fails the emit (never silent).
def Emit.tabulate(e: Emit.E, n: I64): Unit =
  val s = Emit.sOf(e)
  val m = Typer.mark(s)
  Typer.push(s, Emit.sub(e, Emit.rv(e, n)))
  Typer.push(s, Typer.arg(s, Emit.tyS(e, n), 0))
  val gt = Typer.mk(s, Typer.bCap(), 0, Resolve.sym(Emit.wOf(e), Resolve.lit("Array.Gen"), false), m)
  Emit.gqAdd(e, gt)
  Emit.po(e,"({ ")
  Emit.elemC(e, n)
  Emit.po(e," ")
  Emit.gName(e, gt, "at")
  Emit.po(e,"(int64_t); int64_t n")
  Emit.nid(e, n)
  Emit.po(e," = ")
  Emit.arg(e, n, 0)
  Emit.po(e,"; ")
  Emit.elemC(e, n)
  Emit.po(e,"* a")
  Emit.nid(e, n)
  Emit.po(e," = (")
  Emit.elemC(e, n)
  Emit.po(e,"*)srs_alloc(n")
  Emit.nid(e, n)
  Emit.po(e," * (int64_t)sizeof(")
  Emit.elemC(e, n)
  Emit.po(e,")); for (int64_t i")
  Emit.nid(e, n)
  Emit.po(e," = 0; i")
  Emit.nid(e, n)
  Emit.po(e," < n")
  Emit.nid(e, n)
  Emit.po(e,"; i")
  Emit.nid(e, n)
  Emit.po(e,"++) a")
  Emit.nid(e, n)
  Emit.po(e,"[i")
  Emit.nid(e, n)
  Emit.po(e,"] = ")
  Emit.gName(e, gt, "at")
  Emit.po(e,"(i")
  Emit.nid(e, n)
  Emit.po(e,"); a")
  Emit.nid(e, n)
  Emit.po(e,"; })")