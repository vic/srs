def Emit.tmps(e: Emit.E, r: I64, sym: I64, i: I64): Unit =
  val g = Emit.gOf(e)
  if i < Ast.len(g, r) then
    Emit.cty(e, Emit.paramTy(e, sym, i))
    Emit.po(e," t")
    Emit.pi(e,i)
    Emit.po(e," = ")
    Emit.expr(e, Ast.item(g, r, i), false)
    Emit.po(e,"; ")
    Emit.tmps(e, r, sym, i + 1)
  else ()

