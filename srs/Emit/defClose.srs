def Emit.defClose(x: Typer.X, k: Emit.K, base: I64, root: I64, prev: I64): Unit =
  val Typer.X(_, g, s, _, _, _) = x
  val sym = Typer.symOf(x, Ast.a(g, root))
  if Typer.sigAt(s, sym, 3) > 0 && Typer.sigAt(s, sym, 0) != 0 then Emit.instClose(x, k, base, root, prev, sym, Typer.mxGet(s, Typer.moIhd(s, sym)))
  else ()

