// prompt: the C of xs.at(j) (typed by Typer.atCall): j evaluated once into aj<n>, then Array.Ok(xs[aj]) when 0 <= aj < n else Array.Out(aj); n = the receiver's length key (a named local binder or a literal), read from the node's receiver type (Emit.rv)
def Emit.atCall(e: Emit.E, n: I64): Unit =
  val g = Emit.gOf(e)
  val s = Emit.sOf(e)
  val recv = Ast.tok(g, n)
  val ln = Typer.walk(s, Typer.arg(s, Emit.rv(e, n), 1))
  Emit.po(e,"({ int64_t aj")
  Emit.nid(e, n)
  Emit.po(e," = ")
  Emit.expr(e, Ast.item(g, Ast.b(g, n), 0), false)
  Emit.po(e,"; ")
  Emit.cty(e, Emit.tyS(e, n))
  Emit.po(e," ao")
  Emit.nid(e, n)
  Emit.po(e,"; if (0 <= aj")
  Emit.nid(e, n)
  Emit.po(e," && aj")
  Emit.nid(e, n)
  Emit.po(e," < ")
  if Typer.head(s, ln) == Typer.tBind() then Emit.binder(e, Typer.arg(s, ln, 1))
  else Emit.pi(e, Typer.arg(s, ln, 0) * 4294967296 + Typer.arg(s, ln, 1))
  Emit.po(e,") { ")
  Emit.atCase(e, n, "Array.Ok", 0, recv)
  Emit.po(e," } else { ")
  Emit.atCase(e, n, "Array.Out", 1, 0 - 1)
  Emit.po(e," } ao")
  Emit.nid(e, n)
  Emit.po(e,"; })")

