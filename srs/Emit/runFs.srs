// prompt: the emitter front: type check fs as Typer.runFs does (mutability, type definitions, headers, bodies, mono), then emit C.
def Emit.runFs(fs: Coll.List[Resolve.F], want: I64): I64 =
  val ntok = Resolve.sumTok(fs, 0)
  val w = Resolve.world(ntok, Resolve.sumBytes(fs, 0))
  Resolve.builtins(w)
  Resolve.btypes(w)
  Resolve.declFiles(w, fs, 0)
  val s = Typer.store(ntok, Typer.sumNodes(fs, 0), Typer.maxNodes(fs, 0), Coll.length(fs))
  Typer.fileBases(s, fs, 0, 0)
  val rs = Typer.resolve(w, fs, 0)
  Typer.mutPasses(w, s, rs, 0)
  Typer.initTys(w, s)
  Typer.tdefAll(w, s, rs)
  Typer.cset(s, Typer.cMode(), 0)
  Typer.headers(w, s, rs, false, 0)
  Typer.bodies(w, s, rs, 0)
  Typer.nodeFiles(w, s, fs, 0, false)
  Typer.mono(s)
  val bad = Typer.cget(s, Typer.cMis()) + Typer.cget(s, Typer.cHMis()) + Typer.cget(s, Typer.cAnn()) + Typer.cget(s, Typer.cNonEx()) + Typer.cget(s, Typer.cMissE()) + Typer.cget(s, Typer.cUnTot()) + Typer.cget(s, Typer.cTyArity()) + Typer.cget(s, Typer.cTyFuel()) + Typer.cget(s, Typer.cTyNoCase()) + Typer.cget(s, Typer.cTyNoGiven()) + Typer.cget(s, Typer.cTyExtSlot()) + Typer.cget(s, Typer.cTyVal())
  if bad > 0 || Coll.length(fs) < want then
    Emit.num("emit: phase A failed: mismatches=", Typer.cget(s, Typer.cMis()) + Typer.cget(s, Typer.cHMis()))
    Emit.num(" annotate=", Typer.cget(s, Typer.cAnn()))
    Emit.num(" nonexhaustive=", Typer.cget(s, Typer.cNonEx()))
    Emit.num(" missingEntry=", Typer.cget(s, Typer.cMissE()))
    Emit.num(" untyped=", Typer.cget(s, Typer.cUnTot()))
    Console.eprint("\n")
    1
  else
    val kn = Resolve.cget(w, Resolve.sSyms()) + 16
    // the param-drop masks (kn words) and the current fn's dropped binders (9 words) follow the multi-shot words (Emit.pdBase)
    val hn = Emit.msBase() + 2 + kn + 9
    val Typer.S(tt, _, _, _, _) = s
    val Typer.Tt(tcap, _, _, _, _, _) = tt
    val xcap = tcap / 8 + 16
    val k = Emit.K(kn, Array.fill(kn, U8.of(0)), hn, Array.fill(hn, 0), Array.fill(kn, U32.of(0)), xcap, Array.fill(xcap, U32.of(0)))
    Emit.files(w, s, k, rs, 0, 0)
    Emit.msFix(w, s, k, rs)
    Emit.close(w, s, k, rs, 0)
    val tclosed = Typer.cget(s, Typer.cTypes())
    Emit.preamble(s)
    Typer.fwds(w, s, 1)
    Emit.ixBuild(s, k)
    Emit.files(w, s, k, rs, 0, 1)
    Typer.po(s, "static const uint64_t srs_nul[")
    Typer.pi(s, Emit.hget(k, 10) + 1)
    Typer.po(s, "] = {")
    Emit.nul(s, 0, Emit.hget(k, 10) + 1)
    Typer.po(s, "};\n")
    Emit.files(w, s, k, rs, 0, 2)
    Emit.allocFn(w, s, k, 0)
    Emit.preamble2(s)
    Emit.capAllocFn(w, s, k)
    Emit.files(w, s, k, rs, 0, 3)
    Emit.gdrain(w, s, k, rs, 0)
    Typer.po(s, "int main(int argc, char** argv) { rt_init(argc, argv); return (int)f_main(); }\n")
    Typer.pflush(s)
    Emit.num("emit: defs=", Emit.hget(k, 3))
    Emit.num(" instances=", Emit.hget(k, 4))
    Emit.num(" handlerfns=", Emit.hget(k, 5))
    Emit.num(" handles=", Emit.hget(k, 0))
    Emit.num(" noBodyDefs=", Emit.hget(k, 7))
    Emit.num(" closurePasses=", Emit.hget(k, 8))
    Emit.num(" lateTypes=", Typer.cget(s, Typer.cTypes()) - tclosed)
    Emit.num(" noHandlerCalls=", Emit.hget(k, 11))
    Emit.num(" unsupportedResume=", Emit.hget(k, 13))
    Emit.num(" unsupported=", Emit.hget(k, 2))
    Emit.num(" overflow=", Emit.hget(k, 1))
    Emit.num(" ixUnindexed=", Emit.hget(k, 133))
    Emit.num(" ixOverflow=", Emit.hget(k, 134))
    Emit.num(" ixTailRange=", Emit.hget(k, 135))
    Emit.num(" ixBuilds=", Emit.hget(k, 136))
    Emit.kindRows(k, 0)
    Console.eprint("\n")
    if Emit.hget(k, 2) > 0 || Emit.hget(k, 13) > 0 || Emit.hget(k, 1) > 0 || !Emit.lateOk(s, tclosed, Typer.cget(s, Typer.cTypes())) || Emit.hget(k, 6) == 0 then 1 else 0

