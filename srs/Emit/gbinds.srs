// prompt: push the binding (Emit.gbind of head h against goal z) of each param token on the stack slots m + i.. below m + n
def Emit.gbinds(s: Typer.S, h: I64, z: I64, m: I64, i: I64, n: I64): Unit =
  if i < n then
    Typer.push(s, Emit.gbind(s, h, z, Typer.stkAt(s, m + i)))
    Emit.gbinds(s, h, z, m, i + 1, n)
  else ()

