def Emit.isPrim(w: Resolve.W, sym: I64): Bool =
  Emit.symPre(w, sym, "Str.") || Emit.symPre(w, sym, "U32.") || Emit.symPre(w, sym, "U64.") || Emit.symPre(w, sym, "I64.") || Emit.symPre(w, sym, "U8.") || Emit.symPre(w, sym, "I32.") || Emit.symPre(w, sym, "F64.") || Emit.symPre(w, sym, "CStr.") || Emit.symPre(w, sym, "Array.") || Emit.symPre(w, sym, "rt_ptr_") || Emit.symIs(w, sym, "rt_globals") || Emit.symIs(w, sym, "rt_os_errno")

