// f_Name__A__B of the generic call site j: the site's type args under the substitution of the instance being emitted
def Emit.instArgs(e: Emit.E, a: I64, i: I64, nc: I64): Unit =
  if i < nc then
    Emit.po(e,"_")
    Typer.mangle(Emit.wOf(e), Emit.sOf(e), Emit.sub(e, Typer.poolAt(Emit.sOf(e), a + i)))
    Emit.instArgs(e, a, i + 1, nc)
  else ()

