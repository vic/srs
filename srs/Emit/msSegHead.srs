// prompt: `static R ms_..(void** e_, V v_)`: a segment takes the env of the live locals and the value its cut produced
def Emit.msSegHead(e: Emit.E, site: I64, ckey: I64, idx: I64, rT: I64, vT: I64): Unit =
  Emit.po(e,"static ")
  Emit.cty(e, rT)
  Emit.po(e," ")
  Emit.msSegName(e, site, ckey, idx)
  Emit.po(e,"(void** e_, ")
  Emit.cty(e, vT)
  Emit.po(e," v_)")

