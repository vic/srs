def Emit.caseFields(e: Emit.E, sym: I64, et: I64, i: I64, np: I64, pr: Bool): Unit =
  if i < np then
    val t = Emit.fieldTy(e, sym, et, i)
    if pr then
      Emit.po(e," ")
      Emit.cty(e, t)
      Emit.po(e," f")
      Emit.pi(e,i)
      Emit.po(e,";")
    else ()
    Emit.caseFields(e, sym, et, i + 1, np, pr)
  else ()

