// the first position in xi[lo, hi) whose id is >= t, else hi
def Emit.ixLb(xn: I64, xi: Array[U32](xn), lo: I64, hi: I64, t: I64): I64 =
  if lo < hi && 0 <= lo && hi <= xn then
    val mid = (lo + hi) / 2
    if Emit.xg(xn, xi, mid) < t then Emit.ixLb(xn, xi, mid + 1, hi, t) else Emit.ixLb(xn, xi, lo, mid, t)
  else lo

