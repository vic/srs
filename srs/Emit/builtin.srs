def Emit.builtin(e: Emit.E, n: I64): Unit =
  val g = Emit.gOf(e)
  val nm = Ast.text(g, Ast.tok(g, n))
  if Str.eq(nm, "Array.fill") then
    Emit.po(e,"({ int64_t n")
    Emit.nid(e, n)
    Emit.po(e," = ")
    Emit.arg(e, n, 0)
    Emit.po(e,"; ")
    Emit.elemC(e, n)
    Emit.po(e,"* a")
    Emit.nid(e, n)
    Emit.po(e," = (")
    Emit.elemC(e, n)
    Emit.po(e,"*)srs_alloc(n")
    Emit.nid(e, n)
    Emit.po(e," * (int64_t)sizeof(")
    Emit.elemC(e, n)
    Emit.po(e,")); ")
    Emit.elemC(e, n)
    Emit.po(e," x")
    Emit.nid(e, n)
    Emit.po(e," = ")
    Emit.arg(e, n, 1)
    Emit.po(e,"; for (int64_t i")
    Emit.nid(e, n)
    Emit.po(e," = 0; i")
    Emit.nid(e, n)
    Emit.po(e," < n")
    Emit.nid(e, n)
    Emit.po(e,"; i")
    Emit.nid(e, n)
    Emit.po(e,"++) a")
    Emit.nid(e, n)
    Emit.po(e,"[i")
    Emit.nid(e, n)
    Emit.po(e,"] = x")
    Emit.nid(e, n)
    Emit.po(e,"; a")
    Emit.nid(e, n)
    Emit.po(e,"; })")
  else if Str.eq(nm, "ACell.load") then
    Emit.po(e,"__atomic_load_n(")
    Emit.arg(e, n, 0)
    Emit.po(e,", __ATOMIC_SEQ_CST)")
  else if Str.eq(nm, "ACell.store") then
    Emit.po(e,"(__atomic_store_n(")
    Emit.arg(e, n, 0)
    Emit.po(e,", ")
    Emit.arg(e, n, 1)
    Emit.po(e,", __ATOMIC_SEQ_CST), ((int64_t)0))")
  else if Str.eq(nm, "ACell.fetchAdd") then
    Emit.po(e,"__atomic_fetch_add(")
    Emit.arg(e, n, 0)
    Emit.po(e,", ")
    Emit.arg(e, n, 1)
    Emit.po(e,", __ATOMIC_SEQ_CST)")
  else if Str.eq(nm, "ACell.cas") || Str.eq(nm, "Array.cas") then
    val ar = Str.eq(nm, "Array.cas")
    Emit.po(e,"({ ")
    Emit.cty(e, Typer.arg(Emit.sOf(e), Emit.tyS(e, Ast.item(g, Ast.b(g, n), 0)), 0))
    Emit.po(e," x")
    Emit.nid(e, n)
    Emit.po(e," = ")
    Emit.arg(e, n, if ar then 2 else 1)
    Emit.po(e,"; __atomic_compare_exchange_n(")
    if ar then Emit.po(e,"&") else ()
    Emit.arg(e, n, 0)
    if ar then
      Emit.po(e,"[")
      Emit.arg(e, n, 1)
      Emit.po(e,"]")
    else ()
    Emit.po(e,", &x")
    Emit.nid(e, n)
    Emit.po(e,", ")
    Emit.arg(e, n, if ar then 3 else 2)
    Emit.po(e,", false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); })")
  else if Str.eq(nm, "Array.aload") || Str.eq(nm, "Array.fetchAdd") then
    Emit.po(e,if Str.eq(nm, "Array.aload") then "__atomic_load_n(&" else "__atomic_fetch_add(&")
    Emit.arg(e, n, 0)
    Emit.po(e,"[")
    Emit.arg(e, n, 1)
    Emit.po(e,"]")
    if Str.eq(nm, "Array.aload") then Emit.po(e,", __ATOMIC_SEQ_CST)")
    else
      Emit.po(e,", ")
      Emit.arg(e, n, 2)
      Emit.po(e,", __ATOMIC_SEQ_CST)")
  else if Str.eq(nm, "Array.astore") then
    Emit.po(e,"(__atomic_store_n(&")
    Emit.arg(e, n, 0)
    Emit.po(e,"[")
    Emit.arg(e, n, 1)
    Emit.po(e,"], ")
    Emit.arg(e, n, 2)
    Emit.po(e,", __ATOMIC_SEQ_CST), ((int64_t)0))")
  else if Str.eq(nm, "Array.put") then
    Emit.po(e,"(")
    Emit.arg(e, n, 0)
    Emit.po(e,"[")
    Emit.arg(e, n, 1)
    Emit.po(e,"] = ")
    Emit.arg(e, n, 2)
    Emit.po(e,", ((int64_t)0))")
  else if Str.eq(nm, "Array.slice") then
    Emit.po(e,"(")
    Emit.arg(e, n, 0)
    Emit.po(e," + ")
    Emit.arg(e, n, 1)
    Emit.po(e,")")
  else if Str.eq(nm, "Array.blit") then
    Emit.po(e,"(Array__blit(")
    Emit.arg(e, n, 0)
    Emit.po(e," + ")
    Emit.arg(e, n, 1)
    Emit.po(e,", ")
    Emit.arg(e, n, 2)
    Emit.po(e,", ")
    Emit.arg(e, n, 3)
    Emit.po(e,"), ((int64_t)0))")
  else if Str.eq(nm, "Cell.new") || Str.eq(nm, "ACell.new") then
    Emit.po(e,"({ ")
    Emit.elemC(e, n)
    Emit.po(e,"* c")
    Emit.nid(e, n)
    Emit.po(e," = (")
    Emit.elemC(e, n)
    Emit.po(e,"*)srs_alloc((int64_t)sizeof(")
    Emit.elemC(e, n)
    Emit.po(e,")); *c")
    Emit.nid(e, n)
    Emit.po(e," = ")
    Emit.arg(e, n, 0)
    Emit.po(e,"; c")
    Emit.nid(e, n)
    Emit.po(e,"; })")
  else if Str.eq(nm, "Cell.get") then
    Emit.po(e,"(*")
    Emit.arg(e, n, 0)
    Emit.po(e,")")
  else if Str.eq(nm, "Cell.put") then
    Emit.po(e,"(*")
    Emit.arg(e, n, 0)
    Emit.po(e," = ")
    Emit.arg(e, n, 1)
    Emit.po(e,", ((int64_t)0))")
  else if Str.eq(nm, "Array.tabulate") then Emit.tabulate(e, n)
  else Emit.unsup(e, 61)
// prompt: the C of the builtin call n (Array, Cell and ACell ops) by name; an unknown builtin is unsupported (61, the emit fails)

