// the type of field i of case sym of the enum type et
def Emit.fieldTy(e: Emit.E, sym: I64, et: I64, i: I64): I64 =
  val s = Emit.sOf(e)
  val start = Typer.sigAt(s, sym, 1)
  val np = Typer.sigAt(s, sym, 2)
  Typer.msub(s, Typer.poolAt(s, start + i), start + np, Typer.sigAt(s, sym, 3), Typer.argBase(s, et))

