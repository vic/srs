// prompt: the type bound to the given param token p when given head h is matched against goal z (0 when p does not occur in h)
def Emit.gbind(s: Typer.S, h: I64, z: I64, p: I64): I64 =
  if Typer.kind(s, h) == Typer.bParam() then (if Typer.head(s, h) == p then z else 0)
  else Emit.gbindArgs(s, h, z, p, 0, Typer.nargs(s, h))

