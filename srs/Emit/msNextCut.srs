// prompt: the index of the first cut statement i.. of r (Emit.msStmtCut > 0), the length of r when none
def Emit.msNextCut(e: Emit.E, r: I64, i: I64): I64 =
  val g = Emit.gOf(e)
  if i < Ast.len(g, r) then
    if Emit.msStmtCut(e, Ast.item(g, r, i)) > 0 then i else Emit.msNextCut(e, r, i + 1)
  else Ast.len(g, r)

