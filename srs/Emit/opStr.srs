// ── operators ──
def Emit.opStr(c: I64): Str =
  if c == Token.plus() then "+"
  else if c == Token.minus() then "-"
  else if c == Token.star() then "*"
  else if c == Token.slash() then "/"
  else if c == Token.pct() then "%"
  else if c == Token.caret() then "^"
  else if c == Token.amp() then "&"
  else if c == Token.bar() then "|"
  else if c == Token.andand() then "&&"
  else if c == Token.oror() then "||"
  else if c == Token.eqeq() then "=="
  else if c == Token.ne() then "!="
  else if c == Token.le() then "<="
  else if c == Token.ge() then ">="
  else if c == Token.lt() || c == Token.ltg() then "<"
  else if c == Token.gt() then ">"
  else "?op"

