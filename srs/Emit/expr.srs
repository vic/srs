// prompt: the C of one expression node n (tail = in tail position of the def); a method whose receiver type (Emit.rv) is an array is xs.at(j) (Emit.atCall), any other method a capability or trait op (Emit.capCall)
def Emit.expr(e: Emit.E, n: I64, tail: Bool): Unit =
  val g = Emit.gOf(e)
  val k = Ast.kd(g, n)
  if k == Ast.kInt() || k == Ast.kChar() then Emit.lit(e, n)
  else if k == Ast.kStr() then Emit.str(e, n)
  else if k == Ast.kUnit() then Emit.po(e,"((int64_t)0)")
  else if k == Ast.kParen() then
    Emit.po(e,"(")
    Emit.expr(e, Ast.a(g, n), tail)
    Emit.po(e,")")
  else if k == Ast.kName() then Emit.name(e, n)
  else if k == Ast.kCall() then Emit.call(e, n, tail)
  else if k == Ast.kMethod() && Typer.isArrayT(Emit.xOf(e), Emit.rv(e, n)) then Emit.atCall(e, n)
  else if k == Ast.kMethod() && Typer.isCStruct(Emit.sOf(e), Emit.ce(e, n)) then Emit.cstructCall(e, n)
  else if k == Ast.kMethod() then Emit.capCall(e, n, Ast.b(g, n), Ast.tok(g, n))
  else if k == Ast.kBin() then Emit.bin(e, n)
  else if k == Ast.kUn() then Emit.un(e, n)
  else if k == Ast.kIf() || k == Ast.kIfNl() then Emit.ifx(e, n, tail)
  else if k == Ast.kMatch() then Emit.matchx(e, n, tail)
  else if k == Ast.kBlock() then Emit.block(e, n, tail)
  else if k == Ast.kWhile() then Emit.whilex(e, n)
  else if k == Ast.kAssign() then Emit.assign(e, n)
  else if k == Ast.kResume() then Emit.resume(e, n, tail)
  else Emit.unsup(e, k)

