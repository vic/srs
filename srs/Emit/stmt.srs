// prompt: the C of one statement st of a block (last = the block's value, tail = in tail position): val/var, pattern val, handle (saves the outer state of the same handler in hv_<tok>, installs the new one, sets the live flag hl_<tok> and pushes (binder token, handler) on the handle-binder stack, Emit.hpush), check (no code), do, or an expression
def Emit.stmt(e: Emit.E, st: I64, last: Bool, tail: Bool): Unit =
  val g = Emit.gOf(e)
  val w = Emit.wOf(e)
  val s = Emit.sOf(e)
  val k = Ast.kd(g, st)
  if k == Ast.kVal() || k == Ast.kVar() then
    Emit.cty(e, Emit.tyS(e, st))
    Emit.po(e," ")
    Emit.binder(e, Ast.tok(g, st))
    Emit.po(e," = ")
    Emit.expr(e, Ast.b(g, st), false)
    Emit.po(e,"; ")
    // a val/var named like a handle binder in scope takes that handle out of reach: if it is the innermost of a capability with several handlers, the one outside it answers until the block ends (Emit.drops restores)
    val sh = Emit.shadowH(e, Ast.text(g, Ast.tok(g, st)), Ast.tok(g, st), Emit.hget(Emit.kOf(e), Emit.hsBase()) - 1)
    if sh != 0 && Emit.hmulti(Emit.kOf(e), Emit.capOfH(s, sh), sh, 0) then
      Emit.po(e,"int64_t hsh_")
      Emit.pi(e, Ast.tok(g, st))
      Emit.po(e," = hc_")
      Emit.id(e, Emit.capOfH(s, sh))
      Emit.po(e,"; if (hc_")
      Emit.id(e, Emit.capOfH(s, sh))
      Emit.po(e," == ")
      Emit.pi(e, sh)
      Emit.po(e,") hc_")
      Emit.id(e, Emit.capOfH(s, sh))
      Emit.po(e," = ho_")
      Emit.id(e, sh)
      Emit.po(e,"; ")
    else ()
    if last then Emit.po(e,"((int64_t)0); ") else ()
  else if k == Ast.kPatVal() then
    Emit.cty(e, Emit.tyS(e, st))
    Emit.po(e," s")
    Emit.pi(e,st)
    Emit.po(e," = ")
    Emit.expr(e, Ast.b(g, st), false)
    Emit.po(e,"; ")
    Emit.binds(e, st, Ast.a(g, st), 0, st)
    if last then Emit.po(e,"((int64_t)0); ") else ()
  else if k == Ast.kHandle() then
    val hs = Emit.ce(e, st)
    // the state of an outer handle of the same handler is kept in hv_ and put back at the end of the block
    Emit.po(e,"void* hv_")
    Emit.pi(e,Ast.tok(g, st))
    Emit.po(e," = hs_")
    Emit.id(e,hs)
    Emit.po(e,"; hs_")
    Emit.id(e,hs)
    Emit.po(e," = ")
    if Typer.sigAt(s, hs, 0) != 0 then
      Emit.po(e,"h_")
      Emit.id(e,hs)
      Emit.po(e,"_init(")
      Emit.args(e, Ast.b(g, st), 0, false)
      Emit.po(e,")")
    else Emit.po(e,"((void*)0)")
    Emit.po(e,"; int hl_")
    Emit.pi(e,Ast.tok(g, st))
    Emit.po(e," = 1; ")
    // the handle as a cap (handler id, state, live flag) for a def that drops or allocates in it (Emit.pdCap, Emit.curWrap)
    Emit.po(e,"srs_cap hk_")
    Emit.pi(e,Ast.tok(g, st))
    Emit.po(e," = { ")
    Emit.pi(e, hs)
    Emit.po(e,", hs_")
    Emit.id(e, hs)
    Emit.po(e,", &hl_")
    Emit.pi(e,Ast.tok(g, st))
    Emit.po(e," }; ")
    // a capability with several handlers: this handle becomes the innermost (hc_<cap>), the one it shadows is its outer (ho_<H>); both come back at the end of the block (Emit.drops)
    val cap = Emit.capOfH(s, hs)
    if Emit.hmulti(Emit.kOf(e), cap, hs, 0) then
      Emit.po(e,"int64_t hcv_")
      Emit.pi(e, Ast.tok(g, st))
      Emit.po(e," = hc_")
      Emit.id(e, cap)
      Emit.po(e,"; int64_t hov_")
      Emit.pi(e, Ast.tok(g, st))
      Emit.po(e," = ho_")
      Emit.id(e, hs)
      Emit.po(e,"; ho_")
      Emit.id(e, hs)
      Emit.po(e," = hc_")
      Emit.id(e, cap)
      Emit.po(e,"; hc_")
      Emit.id(e, cap)
      Emit.po(e," = ")
      Emit.pi(e, hs)
      Emit.po(e,"; ")
    else ()
    Emit.hpush(e, Ast.tok(g, st), hs)
    if last then Emit.po(e,"((int64_t)0); ") else ()
  else if k == Ast.kCheck() || (k == Ast.kAssert() && Ast.a(g, st) == 0) then
    if last then Emit.po(e,"((int64_t)0); ") else ()
  else if k == Ast.kDo() then
    if last then
      Emit.expr(e, Ast.a(g, st), tail)
      Emit.po(e,"; ")
    else
      Emit.po(e,"(void)(")
      Emit.expr(e, Ast.a(g, st), false)
      Emit.po(e,"); ")
  else if last then
    Emit.expr(e, st, tail)
    Emit.po(e,"; ")
  else
    Emit.po(e,"(void)(")
    Emit.expr(e, st, false)
    Emit.po(e,"); ")

