// prompt: one case value of Array.Index for xs.at(j) (case index ci: 0 = Array.Ok, 1 = Array.Out, the decl order), allocated like Emit.ctor; field f0 = xs[aj] when recv >= 0 (the receiver use token), else aj
def Emit.atCase(e: Emit.E, n: I64, cs: Str, ci: I64, recv: I64): Unit =
  val t = Emit.tyS(e, n)
  val c = Resolve.sym(Emit.wOf(e), Resolve.lit(cs), false)
  Emit.po(e,"ao")
  Emit.nid(e, n)
  Emit.po(e," = (")
  Emit.cty(e, t)
  Emit.po(e,")srs_alloc((int64_t)(offsetof(")
  Emit.etag(e, t)
  Emit.po(e,", u) + sizeof(((")
  Emit.etag(e, t)
  Emit.po(e,"*)0)->u.C_")
  Emit.id(e, c)
  Emit.po(e,"))); ao")
  Emit.nid(e, n)
  Emit.po(e,"->u.C_")
  Emit.id(e, c)
  Emit.po(e,".t_ = ")
  Emit.pi(e, ci)
  Emit.po(e,"; ao")
  Emit.nid(e, n)
  Emit.po(e,"->u.C_")
  Emit.id(e, c)
  Emit.po(e,".f0 = ")
  if recv >= 0 then
    Emit.local(e, recv)
    Emit.po(e,"[aj")
    Emit.nid(e, n)
    Emit.po(e,"]")
  else
    Emit.po(e,"aj")
    Emit.nid(e, n)
  Emit.po(e,";")

