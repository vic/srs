def Emit.arms(e: Emit.E, r: I64, i: I64, n: I64, tail: Bool): Unit =
  val g = Emit.gOf(e)
  if i < Ast.len(g, r) then
    val arm = Ast.item(g, r, i)
    val p = Ast.a(g, arm)
    if Ast.kd(g, p) == Ast.kPAny() || i + 1 == Ast.len(g, r) then Emit.armBody(e, arm, n, tail)
    else
      Emit.po(e,"(s")
      Emit.pi(e,n)
      Emit.po(e,"->tag == ")
      Emit.pi(e,Emit.ax(e, p) - 1)
      Emit.po(e,") ? ")
      Emit.armBody(e, arm, n, tail)
      Emit.po(e," : ")
      Emit.arms(e, r, i + 1, n, tail)
  // shortcut: s2 cannot express room-guaranteed append; s3 Vec will make it unrepresentable
  else
    Emit.over(Emit.kOf(e))
    Emit.po(e,"((int64_t)0)")

