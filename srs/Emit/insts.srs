// the instances of the def sym (chain c): prototype (ph 2) or body (ph 3)
def Emit.insts(x: Typer.X, k: Emit.K, base: I64, root: I64, sym: I64, c: I64, ph: I64): Unit =
  val Typer.X(_, _, s, _, _, _) = x
  if c > 0 then
    val e = Emit.envOf(x, k, base, root, sym, c - 1)
    Emit.head(e, root, sym, c - 1)
    if ph == 2 then Emit.po(e,";\n")
    else
      Emit.body(e, root, false)
      Emit.hinc(k, 4)
    Emit.insts(x, k, base, root, sym, Typer.mxGet(s, Typer.moInst(s, c - 1, 3)), ph)
  else ()

