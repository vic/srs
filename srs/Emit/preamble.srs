// s3c EMIT-1: the C emitter, in s2 (vic/c/s3-design.md 1e). Two phases. Phase A is the typing pipeline of Tp.run: every def is typed into the
// total side tables (ty / ce / ax columns, the type store, the signatures, the mono instances). Phase B (this file) reads ONLY those tables and
// the AST: no unification, no name lookup beyond the names pass results that the typer kept (use kind and binder token per use token).
// Output is streamed with Console.print, one piece at a time: the preamble, the struct decls, the prototypes, then one chunk per def.
// Symbols come from declared names (f_Mod__name, v_<name>_<binder token>, h_<Handler>_<op>, hs_<Handler>); no counter names a symbol.
// Regions: a def whose result allocates has a hidden region param in the design; fixpoint 1 binds every one to the run arena, which is a
// file-static (the first Region handle of main): srs_alloc(n) calls that handler's alloc directly. Handlers are static: a capability op is a
// direct call h_<Handler>_<op>(hs_<Handler>, args). A self tail call is a goto srs_tail.
// Counters (Em.K.hc) are named: nothing is skipped silently; `s3c --emit` prints them on stderr.

// ── the C preamble: the prims the externs of the prelude stand for (static inline, the C of Emit.strPrims, wordPrims, f64Prims, ptrPrims) ──
def Emit.preamble(s: Typer.S): Unit =
  Typer.po(s, "#define _GNU_SOURCE\n#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <string.h>\n#include <errno.h>\n")
  Typer.po(s, "#include <sys/mman.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <stdatomic.h>\n#include <fcntl.h>\n#include <unistd.h>\n#include <sys/stat.h>\n")
  Typer.po(s, "#include <termios.h>\n#include <time.h>\n#include <poll.h>\n#include <sys/wait.h>\n#include <spawn.h>\n#include <sys/socket.h>\n")
  Typer.po(s, "static inline int32_t rt_os_errno(void) { return errno; }\n")
  Typer.po(s, "typedef struct { const uint8_t* p; int64_t n; } srs_str;\n")
  Typer.po(s, "static inline int64_t Str__len(srs_str s) { return s.n; }\n")
  Typer.po(s, "static inline int64_t Str__at(srs_str s, int64_t i) { return (uint64_t)i < (uint64_t)s.n ? s.p[i] : -1; }\n")
  Typer.po(s, "static inline srs_str Str__slice(srs_str s, int64_t b, int64_t e) {\n  if (b < 0) b = 0;\n  if (e > s.n) e = s.n;\n  if (e < b) e = b;\n  return (srs_str){s.p + b, e - b};\n}\n")
  Typer.po(s, "static inline bool Str__eq(srs_str a, srs_str b) { return a.n == b.n && memcmp(a.p, b.p, (size_t)a.n) == 0; }\n")
  Typer.po(s, "static inline bool Str__less(srs_str a, srs_str b) {\n  int64_t m = a.n < b.n ? a.n : b.n;\n  int c = m > 0 ? memcmp(a.p, b.p, (size_t)m) : 0;\n  return c ? c < 0 : a.n < b.n;\n}\n")
  Typer.po(s, "static inline bool Str__has(srs_str s, int64_t c, int64_t i, int64_t e) {\n  if (i < 0) i = 0;\n  if (e > s.n) e = s.n;\n  return (uint64_t)c < 256 && i < e && memchr(s.p + i, (int)c, (size_t)(e - i)) != NULL;\n}\n")
  Typer.po(s, "static inline srs_str Str__ofBytes(int64_t n, uint8_t* xs) { return (srs_str){xs, n}; }\n")
  Typer.po(s, "static inline void Array__blit(uint8_t* d, srs_str s, int64_t m) { int64_t k = m < s.n ? m : s.n; if (k > 0) memcpy(d, s.p, (size_t)k); }\n")
  Typer.po(s, "static inline uint32_t U32__of(int64_t x) { return (uint32_t)x; }\n")
  Typer.po(s, "static inline uint32_t U32__ofU64(uint64_t x) { return (uint32_t)x; }\n")
  Typer.po(s, "static inline uint64_t U64__of(uint32_t x) { return x; }\n")
  Typer.po(s, "static inline uint64_t U64__ofI64(int64_t x) { return (uint64_t)x; }\n")
  Typer.po(s, "static inline int64_t I64__of(uint32_t x) { return x; }\n")
  Typer.po(s, "static inline int64_t I64__ofU64(uint64_t x) { return (int64_t)x; }\n")
  Typer.po(s, "static inline uint8_t U8__of(int64_t x) { return (uint8_t)x; }\n")
  Typer.po(s, "static inline int64_t I64__ofU8(uint8_t x) { return x; }\n")
  Typer.po(s, "static inline int32_t I32__of(int64_t x) { return (int32_t)x; }\n")
  Typer.po(s, "static inline int64_t I64__ofI32(int32_t x) { return x; }\n")
  Typer.po(s, "static inline double F64__ofBits(int64_t b) { double x; memcpy(&x, &b, 8); return x; }\n")
  Typer.po(s, "static inline int64_t F64__bits(double x) { int64_t b; memcpy(&b, &x, 8); return b; }\n")
  Typer.po(s, "static inline double F64__ofI64(int64_t i) { return (double)i; }\n")
  Typer.po(s, "static inline int64_t F64__truncI64(double x) { return x >= -9223372036854775808.0 && x < 9223372036854775808.0 ? (int64_t)x : 0; }\n")
  Typer.po(s, "static inline double F64__add(double a, double b) { return a + b; }\n")
  Typer.po(s, "static inline double F64__sub(double a, double b) { return a - b; }\n")
  Typer.po(s, "static inline double F64__mul(double a, double b) { return a * b; }\n")
  Typer.po(s, "static inline double F64__div(double a, double b) { return a / b; }\n")
  Typer.po(s, "static inline bool F64__lt(double a, double b) { return a < b; }\n")
  Typer.po(s, "static inline bool F64__eq(double a, double b) { return a == b; }\n")
  Typer.po(s, "static inline double F64__ceil(double x) { return ceil(x); }\n")
  Typer.po(s, "static inline double F64__floor(double x) { return floor(x); }\n")
  Typer.po(s, "static inline int64_t F64__fmt(int64_t n, uint8_t* buf, int64_t how, int64_t prec, double x) { if (n <= 0) return 0; int k = how == 0 ? snprintf((char*)buf, (size_t)n, \"%g\", x) : how == 1 ? snprintf((char*)buf, (size_t)n, \"%f\", x) : snprintf((char*)buf, (size_t)n, \"%.*e\", (int)prec, x); return k < 0 ? 0 : k < n ? k : n - 1; }\n")
  Typer.po(s, "static inline double F64__parse(srs_str s) { char b[512]; int64_t n = s.n < 511 ? s.n : 511; if (n > 0) memcpy(b, s.p, (size_t)n); b[n] = 0; return strtod(b, 0); }\n")
  Typer.po(s, "static inline uint32_t Str__u32le(srs_str s, int64_t i) {\n  uint32_t v = 0;\n  if (i >= s.n) return 0;\n  for (int64_t k = 0; k < 4; k++) if (i + k >= 0 && i + k < s.n) v |= (uint32_t)s.p[i + k] << (8 * k);\n  return v;\n}\n")
  Typer.po(s, "static inline uint64_t Str__u64le(srs_str s, int64_t i) {\n  uint64_t v = 0;\n  if (i >= s.n) return 0;\n  for (int64_t k = 0; k < 8; k++) if (i + k >= 0 && i + k < s.n) v |= (uint64_t)s.p[i + k] << (8 * k);\n  return v;\n}\n")
  Typer.po(s, "static inline int64_t rt_ptr_get(void* p, int64_t i) { return ((int64_t*)p)[i]; }\n")
  Typer.po(s, "static inline int64_t rt_ptr_set(void* p, int64_t i, int64_t v) { ((int64_t*)p)[i] = v; return 0; }\n")
  Typer.po(s, "static inline void* rt_ptr_add(void* p, int64_t n) { return (char*)p + n; }\n")
  Typer.po(s, "static inline uint64_t rt_ptr_addr(void* p) { return (uint64_t)(uintptr_t)p; }\n")
  Typer.po(s, "static inline void* rt_ptr_of(uint64_t a) { return (void*)(uintptr_t)a; }\n")
  Typer.po(s, "static int64_t srs_globals[16];\n")
  Typer.po(s, "static inline void* rt_globals(void) { return srs_globals; }\n")
  Typer.po(s, "typedef struct srs_cap srs_cap;\n")
  Typer.po(s, "void rt_init(int argc, char** argv);\n")

