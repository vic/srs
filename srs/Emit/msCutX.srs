// prompt: the C of cut expression n with continuation idx (Emit.msKf): a request calls the site's op fn mh_<site>_<op>(k, env, args); a CPS call calls cg_<site>_<g>(k, env, args); an if picks an arm, each arm a cut or a plain value handed to the continuation
def Emit.msCutX(e: Emit.E, n: I64, site: I64, ckey: I64, idx: I64): Unit =
  val g = Emit.gOf(e)
  val w = Emit.wOf(e)
  val c = Emit.msCut(e, n)
  if Ast.kd(g, n) == Ast.kParen() then Emit.msCutX(e, Ast.a(g, n), site, ckey, idx)
  else if c == 3 then
    Emit.po(e,"(")
    Emit.expr(e, Ast.a(g, n), false)
    Emit.po(e," ? ")
    Emit.msCutX(e, Ast.a(g, Ast.b(g, n)), site, ckey, idx)
    Emit.po(e," : ")
    Emit.msCutX(e, Ast.b(g, Ast.b(g, n)), site, ckey, idx)
    Emit.po(e,")")
  else if c == 1 then
    val sg = Emit.ce(e, n)
    Emit.po(e,"mh_")
    Emit.pi(e, site)
    Emit.po(e,"_")
    Emit.symTail(e, w, sg, Emit.lastDot(w, sg, 0, 0 - 1) + 1)
    Emit.po(e,"(")
    Emit.msKf(e, site, ckey, idx)
    Emit.po(e,", ")
    Emit.msKe(e, idx)
    Emit.args(e, Ast.b(g, n), 0, true)
    Emit.po(e,")")
  else if c == 2 then
    Emit.po(e,"cg_")
    Emit.pi(e, site)
    Emit.po(e,"_")
    Emit.id(e, Emit.ce(e, n))
    Emit.po(e,"(")
    Emit.msKf(e, site, ckey, idx)
    Emit.po(e,", ")
    Emit.msKe(e, idx)
    Emit.args(e, Ast.b(g, n), 0, true)
    Emit.po(e,")")
  else
    Emit.msKf(e, site, ckey, idx)
    Emit.po(e,"(")
    Emit.msKe(e, idx)
    Emit.po(e,", ")
    Emit.expr(e, n, false)
    Emit.po(e,")")

