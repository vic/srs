// prompt: an extern root: phase 0 its class (2 library, 3 prim, 1 runtime/C extern; an extern val 4), phase 2 the prototype of a class-1 def extern: a generic one takes void* slots, any other its {} binders as leading srs_cap* params (rt/srs_cap.h) then its params
def Emit.externRoot(x: Typer.X, k: Emit.K, base: I64, root: I64, ph: I64): Unit =
  val Typer.X(w, g, s, _, _, _) = x
  val inner = Ast.b(g, root)
  if Ast.kd(g, inner) == Ast.kDef() then
    val sym = Typer.symOf(x, Ast.a(g, inner))
    if ph == 0 then Emit.kset(k, sym, if Ast.a(g, root) != 0 then 2 else if Emit.isPrim(w, sym) then 3 else 1)
    else if ph == 2 && Emit.kget(k, sym) == 1 then
      val e = Emit.E(x, k, 0, 0, 0, 0, 0, base)
      val gen = Typer.sigAt(s, sym, 3) > 0
      if gen then Emit.po(e,"void*") else Emit.cty(e, Typer.sigAt(s, sym, 0))
      Emit.po(e," ")
      Emit.id(e,sym)
      Emit.po(e,"(")
      if Typer.sigAt(s, sym, 2) == 0 && (gen || Typer.sigAt(s, sym, 4) == 0) then Emit.po(e,"void")
      else if gen then Emit.voidTys(e, Typer.sigAt(s, sym, 2), 0)
      else
        Emit.capTys(e, Typer.sigAt(s, sym, 4), Typer.sigAt(s, sym, 2) > 0)
        Emit.externTys(e, sym, 0, Typer.sigAt(s, sym, 2))
      Emit.po(e,");\n")
    else ()
  else if Ast.kd(g, inner) == Ast.kCVal() && ph == 0 then Emit.kset(k, Typer.symOf(x, Ast.tok(g, inner)), 4)
  else ()

