// prompt: the struct definitions (pr) or field registrations of the closed instantiations of enum esym from type id t: a definition is
// printed only for the first instantiation of each C name (Typer.firstOfTag): one C definition per mangled name (A11 emitter dedup).
def Emit.enumTypes(e: Emit.E, root: I64, esym: I64, t: I64, pr: Bool): Unit =
  val s = Emit.sOf(e)
  val Emit.E(_, k, _, _, _, _, _, _) = e
  val u = Emit.nextEnum(s, k, esym, t)
  if u < Typer.cget(s, Typer.cTypes()) then
    if Typer.closedT(s, u) then
      if pr then (if Typer.firstOfTag(s, u, 0) then Emit.enumType(e, root, u, true) else ())
      else
        Emit.cases(e, Ast.b(Emit.gOf(e), root), 0, u, false)
    else ()
    Emit.enumTypes(e, root, esym, u + 1, pr)
  else ()