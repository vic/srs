def Emit.ctor(e: Emit.E, n: I64): Unit =
  val g = Emit.gOf(e)
  val r = Ast.b(g, n)
  if Ast.len(g, r) == 0 then Emit.nullary(e, n)
  else
    val t = Emit.tyS(e, n)
    val w = Emit.wOf(e)
    Emit.po(e,"({ ")
    Emit.cty(e, t)
    Emit.po(e," o")
    Emit.pi(e,n)
    Emit.po(e," = (")
    Emit.cty(e, t)
    Emit.po(e,")srs_alloc((int64_t)(offsetof(")
    Emit.etag(e, t)
    Emit.po(e,", u) + sizeof(((")
    Emit.etag(e, t)
    Emit.po(e,"*)0)->u.C_")
    Emit.id(e,Emit.ce(e, n))
    Emit.po(e,"))); o")
    Emit.pi(e,n)
    Emit.po(e,"->u.C_")
    Emit.id(e,Emit.ce(e, n))
    Emit.po(e,".t_ = ")
    Emit.pi(e,Emit.ax(e, n) - 1)
    Emit.po(e,";")
    Emit.fields(e, n, r, 0)
    Emit.po(e," o")
    Emit.pi(e,n)
    Emit.po(e,"; })")

