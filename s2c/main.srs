// the s2 compiler (self-host rung B3, vic/c/s2-selfhost.md): `s2c a.srs b.srs ... > out.c`. the decls of all files form
// one program. errors are data until main: every one is reported on stderr, and the exit code is 1.

// a file that did not read or parse (line: numbered across files, as every line of the program)
enum S2c.Err:
  case S2c.NoFile(path: Str)
  case S2c.Syntax(line: I64, want: Str)

// a source file: its path, the number of its first line, its text. lines are numbered across the files, so a line
// names its file (Parse.sourceFrom)
enum S2c.File:
  case S2c.File(path: Str, base: I64, text: Str)

enum S2c.Read:
  case S2c.Read(ds: Coll.List[Ast.Decl], errs: Coll.List[S2c.Err], files: Coll.List[S2c.File])

// the args from i on, each a source file, in order; base = the number of the next file's first line
def S2c.read(i: I64, base: I64, ds: Coll.List[Ast.Decl], errs: Coll.List[S2c.Err], fs: Coll.List[S2c.File]): S2c.Read =
  if i >= Args.count() then S2c.Read(Coll.rev(ds), Coll.rev(errs), fs)
  else
    val p = Args.at(i)
    val src = Files.read(p)
    if Str.len(src) < 0 then S2c.read(i + 1, base, ds, Coll.Cons(S2c.NoFile(p), errs), fs)
    else
      val fs2 = Coll.Cons(S2c.File(p, base, src), fs)
      val next = base + S2c.lineCount(src, 0, 1)
      Parse.sourceFrom(src, base) match
        case Parse.Ok(fds, _) => S2c.read(i + 1, next, Coll.revOnto(fds, ds), errs, fs2)
        case Parse.Err(line, want) => S2c.read(i + 1, next, ds, Coll.Cons(S2c.Syntax(line, want), errs), fs2)

def S2c.lineCount(s: Str, i: I64, n: I64): I64 =
  if i >= Str.len(s) then n else S2c.lineCount(s, i + 1, if Str.at(s, i) == 10 then n + 1 else n)

// ── diagnostics (vic Q-E1, 2026-11-09): error[code]: what / --> file:line / the source line / expected, found / help ──
// what a diagnostic names after its title: nothing, a name, a type, or the type wanted and the type found
enum S2c.What:
  case S2c.Plain
  case S2c.Name(n: Sym.Sym)
  case S2c.Type(t: K.Term)
  case S2c.Want(want: K.Term, got: K.Term)
  case S2c.Text(s: Str)
  // an op of a capability and one of its source states
  case S2c.OpFrom(op: Sym.Sym, s: Sym.Sym)

def S2c.diag(fs: Coll.List[S2c.File], code: Str, line: I64, title: Str, w: S2c.What, help: Str): Unit =
  Console.eprint("error[")
  Console.eprint(code)
  Console.eprint("]: ")
  Console.eprint(title)
  w match
    case S2c.Name(n) =>
      Console.eprint(" '")
      Console.eprint(Sym.str(n))
      Console.eprint("'")
    case S2c.OpFrom(op, s) =>
      Console.eprint(" '")
      Console.eprint(Sym.str(op))
      Console.eprint("' from state '")
      Console.eprint(Sym.str(s))
      Console.eprint("'")
    case S2c.Text(x) =>
      Console.eprint(" ")
      Console.eprint(x)
    case S2c.Type(t) =>
      Console.eprint(" ")
      S2c.term(t)
    case _ => ()
  Console.eprint("\n")
  S2c.fileOf(fs, line) match
    case Coll.Some(f) =>
      val S2c.File(p, base, text) = f
      val k = line - base + 1
      Console.eprint("  --> ")
      Console.eprint(p)
      Console.eprint(":")
      Console.eprintI64(k)
      Console.eprint("\n    |\n")
      S2c.pad(k)
      Console.eprintI64(k)
      Console.eprint(" | ")
      Console.eprint(S2c.lineText(text, k, 0, 1))
      Console.eprint("\n    |\n")
    case Coll.None => ()
  w match
    case S2c.Want(want, got) =>
      Console.eprint("    = expected: ")
      S2c.term(want)
      Console.eprint("\n    = found:    ")
      S2c.term(got)
      Console.eprint("\n")
    case _ => ()
  Console.eprint("    = help: ")
  Console.eprint(help)
  Console.eprint("\n")

// the file a line is in: the last one whose first line is at or before it (files are kept latest first)
def S2c.fileOf(fs: Coll.List[S2c.File], line: I64): Coll.Option[S2c.File] = fs match
  case Coll.Nil => Coll.None
  case Coll.Cons(f, rest) =>
    val S2c.File(_, base, _) = f
    if line >= base then Coll.Some(f) else S2c.fileOf(rest, line)

def S2c.pad(k: I64): Unit = if k < 10 then Console.eprint("  ") else if k < 100 then Console.eprint(" ") else ()

// line k of s (1-based), without its newline
def S2c.lineText(s: Str, k: I64, i: I64, n: I64): Str =
  if n == k then Str.slice(s, i, S2c.lineEnd(s, i))
  else if i >= Str.len(s) then ""
  else S2c.lineText(s, k, i + 1, if Str.at(s, i) == 10 then n + 1 else n)

def S2c.lineEnd(s: Str, i: I64): I64 = if i >= Str.len(s) || Str.at(s, i) == 10 then i else S2c.lineEnd(s, i + 1)

def S2c.showErrs(fs: Coll.List[S2c.File], es: Coll.List[S2c.Err]): Unit = es match
  case Coll.Nil => ()
  case Coll.Cons(e, rest) =>
    e match
      case S2c.NoFile(p) =>
        Console.eprint("error[no-file]: cannot read ")
        Console.eprint(p)
        Console.eprint("\n    = help: check the path and that the file is readable\n")
      case S2c.Syntax(line, want) => S2c.diag(fs, "parse", line, "parse error, expected", S2c.Text(want), "fix the syntax on this line")
    S2c.showErrs(fs, rest)

def S2c.showClashes(fs: Coll.List[S2c.File], s: K.Subst, cs: Coll.List[Ty.Clash]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    c match
      case Ty.Mismatch(l, got, want) => S2c.diag(fs, "mismatch", l, "the value has the wrong type", S2c.Want(K.reify(s, want), K.reify(s, got)), "give a value of the expected type, or change the declared type")
      case Ty.Unknown(l, n) => S2c.diag(fs, "unknown-name", l, "unknown name", S2c.Name(n), "declare it, or fix its spelling (module members are written qualified: Foo.bar)")
      case Ty.Arity(l, n) => S2c.diag(fs, "arity", l, "wrong number of args to", S2c.Name(n), "pass one arg per param of its declaration")
      case Ty.NotEnum(l, t) => S2c.diag(fs, "not-enum", l, "a match needs an enum, not", S2c.Type(K.reify(s, t)), "match on a value of an enum type")
      case Ty.NoOp(l, n) => S2c.diag(fs, "no-op", l, "no op or trait method", S2c.Name(n), "call an op of the capability, or a method of the evidence's trait")
      case Ty.CannotInfer(l, n) => S2c.diag(fs, "cannot-infer", l, "cannot infer the type args of", S2c.Name(n), "write them: f[T](x), or annotate the val")
      case Ty.NoCap(l, p) => S2c.diag(fs, "no-capability", l, "no single capability in scope of", S2c.Name(p), "open one (handle r = Srs.Arena()) or take it as a {} binder; with two, choose one: f{a}(x)")
      case Ty.Impure(l, n) => S2c.diag(fs, "impure-call", l, "a compile-time body (a top-level val) calls only pure fns, not", S2c.Name(n), "it runs at compile time: call only fns with no effect but Region")
      case Ty.ComptimeHandle(l, h) => S2c.diag(fs, "comptime-handle", l, "a compile-time body (a top-level val) opens no handler, not", S2c.Name(h), "the compiler supplies its Region: build data without a handle")
      case Ty.PureRules(rel) => S2c.diag(fs, "internal", 0, "the purity rules are ill-formed at", S2c.Name(rel), "a bug in s2: report it")
      case Ty.NotExhaustive(l, n) => S2c.diag(fs, "not-exhaustive", l, "the match misses the case", S2c.Name(n), "add an arm for it, or a `_` arm")
      case Ty.PatArity(l, n) => S2c.diag(fs, "pattern-arity", l, "the pattern binds another number of fields than", S2c.Name(n), "bind one name (or _) per field of the case")
      case Ty.NoGiven(l, t) => S2c.diag(fs, "no-given", l, "no given for", S2c.Type(t), "declare a given for this type, or take the evidence as a {} binder")
      case Ty.AmbigGivens(l, t) => S2c.diag(fs, "ambiguous-givens", l, "two givens tie for", S2c.Type(t), "make one head more specific, or choose the evidence: f{e}(x)")
      case Ty.AmbigEvidence(l, t) => S2c.diag(fs, "ambiguous-evidence", l, "two local evidences prove", S2c.Type(t), "choose one: f{e}(x)")
      case Ty.GivenFuel(l, t) => S2c.diag(fs, "given-fuel", l, "the given search ran out of fuel at", S2c.Type(t), "a given clause needs itself at a bigger type: break the loop")
      case Ty.ChosenBad(l, t) => S2c.diag(fs, "chosen-evidence", l, "the chosen evidence does not prove", S2c.Type(t), "choose a local whose type is the goal")
      case Ty.ChosenCount(l, n) => S2c.diag(fs, "chosen-count", l, "wrong number of chosen evidence for", S2c.Name(n), "choose one name per {} binder of the callee")
      case Ty.ChosenNotCap(l, p) => S2c.diag(fs, "chosen-not-capability", l, "the chosen name is not a capability of", S2c.Name(p), "choose a local opened by a handler of this capability")
      case Ty.EvidenceValue(l, x) => S2c.diag(fs, "evidence-value", l, "evidence is only a method receiver, not a value:", S2c.Name(x), "call its methods: e.m(x)")
      case Ty.CapValue(l, x) => S2c.diag(fs, "capability-value", l, "a capability is second-class, not a value:", S2c.Name(x), "pass it as a {} binder: f{c}(x)")
      case Ty.BinderHides(l, x) => S2c.diag(fs, "binder-hides-type", l, "a [] binder hides the type", S2c.Name(x), "rename the binder")
      case Ty.CapParam(l, x) => S2c.diag(fs, "capability-param", l, "a capability is a {} binder, not a param:", S2c.Name(x), "write it as {x: P} before the params")
      case Ty.CapErased(l, p) => S2c.diag(fs, "capability-erased", l, "a capability is erased at run time: no value type names", S2c.Name(p), "take it as a {} binder ({c: Console} or {Console}); it is never a result, a field or a type arg")
      case Ty.NotTrait(l, n) => S2c.diag(fs, "not-a-trait", l, "a given of a name that is not a trait:", S2c.Name(n), "a given implements a trait (given Show[I64]); a capability is implemented by a handler (handler H for Console)")
      case Ty.ResumeNotK(l, k) => S2c.diag(fs, "resume-not-k", l, "resume of a name that is not this op's continuation:", S2c.Name(k), "resume the k this op takes first: def choose(k): R = resume k(true)")
      case Ty.AnswerType(l, op) => S2c.diag(fs, "answer-type", l, "a multi-shot op does not return the answer type:", S2c.Name(op), "an op with k returns what done returns, or the block type [A] when there is no done")
      case Ty.MultishotShape(l, p) => S2c.diag(fs, "multishot-shape", l, "a multi-shot op is compiled only as a whole val or statement of its handled block:", S2c.Name(p), "write val x = P.op() at the top of the block; a fn that requests it is not compiled yet (vic-hm63 C3.4)")
      case Ty.TraitArity(l, t) => S2c.diag(fs, "trait-arity", l, "wrong number of type args for the trait", S2c.Name(t), "give one type arg per [] binder of the trait")
      case Ty.NotMethod(l, m) => S2c.diag(fs, "not-a-method", l, "not a method of the trait:", S2c.Name(m), "a given defines exactly the trait's methods")
      case Ty.MissingMethod(l, m) => S2c.diag(fs, "missing-method", l, "the given misses the trait method", S2c.Name(m), "define it in the given")
      case Ty.SigDiffers(l, m) => S2c.diag(fs, "method-signature", l, "the given method's signature differs from its trait:", S2c.Name(m), "use the trait's params and result at the given's head")
      case Ty.NotInHead(l, x) => S2c.diag(fs, "binder-not-in-head", l, "a given [] binder is not in its head:", S2c.Name(x), "use each [] binder in the given's head")
      case Ty.ExternSlot(l, t) => S2c.diag(fs, "extern-slot", l, "an extern [] binder is a pointer (void*), not", S2c.Type(t), "call the extern at an enum or Ptr type")
      case Ty.UnhandledEffect(l, p) => S2c.diag(fs, "unhandled-effect", l, "effect not handled:", S2c.Name(p), "open a handler of it in an enclosing block (handle x = H()): main must handle every effect it needs")
      case Ty.GivenRow(l, p) => S2c.diag(fs, "given-row", l, "a given fn uses a capability its trait method does not declare:", S2c.Name(p), "add it to the trait method's {} binders (def show {Console} (x: A): Str), or remove the request")
      case Ty.RtOutsideSrs(l, f) => S2c.diag(fs, "rt-outside-srs", l, "rt_* is called only in the body of a Srs.* handler, not here:", S2c.Name(f), "request the effect (Console.print(s)) and handle it in main (handle c = Srs.Console())")
      case Ty.ValAtRunTime(l, x) => S2c.diag(fs, "val-at-run-time", l, "a top-level val is a compile-time value; run-time code cannot name it yet:", S2c.Name(x), "use it from another top-level val, or call a def")
      case Ty.IntRange(l, t) => S2c.diag(fs, "int-range", l, "the int literal does not fit its type", S2c.Type(K.reify(s, t)), "write a literal in range (U32: 0 to 0xffffffff), or convert: U64.ofI64(n)")
      case Ty.AssignVal(l, x) => S2c.diag(fs, "assign-val", l, "an immutable I64 local (a length or a fact may name it) is assigned:", S2c.Name(x), "declare it with var, or bind a new val")
      case Ty.IndexUnproved(l, x) => S2c.diag(fs, "index-unproved", l, "the index is not proved in [0, n) for the array", S2c.Name(x), "test it first (if 0 <= i && i < n then xs(i) else ...), or use xs.at(i)")
      case Ty.SliceUnproved(l, f) => S2c.diag(fs, "slice-unproved", l, "the slice bounds are not proved for", S2c.Name(f), "test them first: if 0 <= off && 0 <= m && m <= n && off <= n - m then Array.slice(xs, off, m) else ...")
      case Ty.LenUnnamed(l, x) => S2c.diag(fs, "length-unnamed", l, "no local in scope holds the length of the array", S2c.Name(x), "keep the length binder n in scope (a param, a val or a field)")
    S2c.showClashes(fs, s, rest)

def S2c.showTl(fs: Coll.List[S2c.File], es: Coll.List[Tl.Err]): Unit = es match
  case Coll.Nil => ()
  case Coll.Cons(e, rest) =>
    e match
      case Tl.Fuel(l, n) => S2c.diag(fs, "type-fuel", l, "type reduction ran out of fuel at", S2c.Name(n), "a type that names itself never ends: break the loop")
      case Tl.NoCase(l, n) => S2c.diag(fs, "no-type-case", l, "no case of the match type matches in", S2c.Name(n), "add a case for this arg, or a `_` case")
      case Tl.BadVal(l, n) => S2c.diag(fs, "no-compile-time-value", l, "a value arg has no compile-time value in", S2c.Name(n), "use literals, value params and pure defs (no effects, fuel bounded)")
      case Tl.Arity(l, n) => S2c.diag(fs, "type-arity", l, "wrong number of type or value args for", S2c.Name(n), "give one arg per binder of the type")
      case Tl.NoVals(l, n) => S2c.diag(fs, "value-args", l, "value args on a type that takes none:", S2c.Name(n), "drop the (...) after the type")
      case Tl.ArgType(l, n) => S2c.diag(fs, "value-arg-type", l, "a value arg does not fit its binder's type in", S2c.Name(n), "give a value of the binder's type")
      case Tl.BinderType(l, x) => S2c.diag(fs, "value-binder-type", l, "a value binder takes I64, Bool or Str:", S2c.Name(x), "use one of those types")
      case Tl.PatType(l, n) => S2c.diag(fs, "value-pattern-type", l, "a value match pattern does not fit its binder's type in", S2c.Name(n), "use patterns of the binder's type")
    S2c.showTl(fs, rest)

// ── the phases: names, type level, types, flow (capability states, regions), then C; the first phase with errors stops ──
def S2c.compile(m: S2c.Mode, fs: Coll.List[S2c.File], ds: Coll.List[Ast.Decl]): I64 = Names.check(ds) match
  case Names.Ok(arr) => S2c.facts(m, fs, ds, arr)
  case Names.Bad(cs) =>
    S2c.showNames(fs, cs)
    1
  case Names.RulesBad(rel) => S2c.internal("names", rel)

def S2c.facts(m: S2c.Mode, fs: Coll.List[S2c.File], ds: Coll.List[Ast.Decl], arr: Names.Arrays): I64 = Fx.check(ds) match
  case Fx.Ok => S2c.typed(m, fs, ds, arr)
  case Fx.Bad(cs) =>
    S2c.showFx(fs, cs)
    1
  case Fx.RulesBad(rel) => S2c.internal("facts", rel)

def S2c.showFx(fs: Coll.List[S2c.File], cs: Coll.List[Fx.Clash]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    c match
      case Fx.NotCap(l, x) => S2c.diag(fs, "fact-not-capability", l, "at: not a {} capability of this def or type:", S2c.Name(x), "name a {} capability binder of the def or type")
      case Fx.BadState(l, s) => S2c.diag(fs, "unknown-state", l, "unknown capability state", S2c.Name(s), "use a state the capability declares")
      case Fx.Twice(l, x) => S2c.diag(fs, "fact-twice", l, "two states of one capability in a fact group:", S2c.Name(x), "give each capability one state per group")
      case Fx.NotOp(l, op) => S2c.diag(fs, "fact-not-op", l, "next: not an op of a capability of this def:", S2c.Name(op), "use an op of one of the def's capabilities")
      case Fx.UnknownRel(l, rel) => S2c.diag(fs, "unknown-relation", l, "unknown relation in facts:", S2c.Name(rel), "use at, next, or a rule def of a capability")
      case Fx.RelArity(l, rel) => S2c.diag(fs, "relation-arity", l, "wrong number of args for relation", S2c.Name(rel), "give the rule def's number of args")
      case Fx.Unbound(l, v) => S2c.diag(fs, "fact-unbound", l, "an exit fact variable is not bound by the entry facts:", S2c.Name(v), "bind it in an entry fact")
      case Fx.ExitOther(l, rel) => S2c.diag(fs, "exit-fact", l, "an exit fact is an at, not", S2c.Name(rel), "write the exit state as at(cap, State)")
      case Fx.Reserved(l, rel) => S2c.diag(fs, "reserved-relation", l, "reserved relation name:", S2c.Name(rel), "at and next are built in: rename the rule def")
      case Fx.ClauseArity(l, rel) => S2c.diag(fs, "rule-arity", l, "rule defs of one relation differ in arity:", S2c.Name(rel), "give every rule def of a relation one arity")
      case Fx.Unsafe(l, x) => S2c.diag(fs, "rule-unsafe", l, "a rule def param is not in its body:", S2c.Name(x), "use each param in the body")
      case Fx.RuleUnknown(l, rel) => S2c.diag(fs, "rule-unknown", l, "unknown relation in rule:", S2c.Name(rel), "use next, at, or a rule def of this capability")
      case Fx.RuleOp(l, op) => S2c.diag(fs, "rule-op", l, "next: not an op of the capability:", S2c.Name(op), "use an op of this capability")
      case Fx.Ambiguous(l, op, s) => S2c.diag(fs, "protocol-ambiguous", l, "an op goes to more than one state from one state:", S2c.OpFrom(op, s), "give the op one target per state: a run-time outcome is not the program's choice (split the op, one per target)")
      case Fx.OpCap(l, x) => S2c.diag(fs, "op-result-capability", l, "an op result lives in a capability other than its receiver:", S2c.Name(x), "write Ptr^<self>: self is the receiver, the only capability an op names")
      case Fx.OpChoice(l, t) => S2c.diag(fs, "op-result-choice", l, "an op result's {...} does not give each {} binder of its type the receiver:", S2c.Name(t), "write T{self} with one self per {} binder of T, each a binder of this capability")
    S2c.showFx(fs, rest)

def S2c.typed(m: S2c.Mode, fs: Coll.List[S2c.File], ds: Coll.List[Ast.Decl], arr: Names.Arrays): I64 =
  Ty.typed(ds, arr) match
    case Ty.TlBad(tes) =>
      S2c.showTl(fs, Coll.rev(tes))
      1
    case Ty.RowsBad(rel) => S2c.internal("effect row", rel)
    case Ty.Checked(xds, rows, res) =>
      val Ty.Result(cs, _, s, _, _, _) = res
      cs match
        case Coll.Cons(_, _) =>
          S2c.showClashes(fs, s, Coll.rev(cs))
          1
        case Coll.Nil => S2c.flowed(m, fs, xds, rows, res)

def S2c.flowed(m: S2c.Mode, fs: Coll.List[S2c.File], ds: Coll.List[Ast.Decl], rows: Eff.Rows, res: Ty.Result): I64 =
  S2c.flowAll(Flow.plans(), S2c.flowCx(ds, rows, Coll.Nil, Coll.Nil, Coll.Nil, Coll.Nil, Coll.Nil), ds, Coll.Nil) match
    case S2c.FlowBad(rel) => S2c.internal("flow", rel)
    case S2c.FlowOk(cs) => cs match
      case Coll.Cons(_, _) =>
        S2c.showFlow(fs, Coll.rev(cs))
        1
      case Coll.Nil => S2c.finish(m, fs, ds, rows, res)

enum S2c.Flowed:
  case S2c.FlowOk(cs: Coll.List[Flow.Clash])
  case S2c.FlowBad(rel: Sym.Sym)

def S2c.flowCx(ds: Coll.List[Ast.Decl], rows: Eff.Rows, ps: Coll.List[Ast.Proto], hs: Coll.List[Ast.Handler], fs: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ts: Coll.List[Ast.TypeDecl]): Flow.Cx = ds match
  case Coll.Nil => Flow.Cx(ps, hs, fs, es, ts, rows, Eff.syms())
  case Coll.Cons(d, rest) => d match
    case Ast.DProto(p) => S2c.flowCx(rest, rows, Coll.Cons(p, ps), hs, fs, es, ts)
    case Ast.DHandler(h) => S2c.flowCx(rest, rows, ps, Coll.Cons(h, hs), fs, es, ts)
    case Ast.DFn(f) => S2c.flowCx(rest, rows, ps, hs, Coll.Cons(f, fs), es, ts)
    case Ast.DEnum(e) => S2c.flowCx(rest, rows, ps, hs, fs, Coll.Cons(e, es), ts)
    case Ast.DType(td) => S2c.flowCx(rest, rows, ps, hs, fs, es, Coll.Cons(td, ts))
    case _ => S2c.flowCx(rest, rows, ps, hs, fs, es, ts)

// every def with a body: its flow clashes (all of them, in order)
def S2c.flowAll(p: Flow.Plans, cx: Flow.Cx, ds: Coll.List[Ast.Decl], acc: Coll.List[Flow.Clash]): S2c.Flowed = ds match
  case Coll.Nil => S2c.FlowOk(acc)
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) =>
      val Ast.Fn(_, _, _, _, _, _, body) = f
      body match
        case Ast.Def(_, _) => Flow.checkWith(p, cx, f) match
          case Flow.Ok => S2c.flowAll(p, cx, rest, acc)
          case Flow.Bad(cs) => S2c.flowAll(p, cx, rest, Coll.revOnto(cs, acc))
          case Flow.RulesUnsafe(rel) => S2c.FlowBad(rel)
          case Flow.RulesNegCycle(rel) => S2c.FlowBad(rel)
          case Flow.RulesIllTyped(rel) => S2c.FlowBad(rel)
        case _ => S2c.flowAll(p, cx, rest, acc)
    // a handler's fns of ops whose result lives in self (Flow.checkHandler)
    case Ast.DHandler(h) => Flow.checkHandler(p, cx, h) match
      case Flow.Ok => S2c.flowAll(p, cx, rest, acc)
      case Flow.Bad(cs) => S2c.flowAll(p, cx, rest, Coll.revOnto(cs, acc))
      case Flow.RulesUnsafe(rel) => S2c.FlowBad(rel)
      case Flow.RulesNegCycle(rel) => S2c.FlowBad(rel)
      case Flow.RulesIllTyped(rel) => S2c.FlowBad(rel)
    case _ => S2c.flowAll(p, cx, rest, acc)

def S2c.showNames(fs: Coll.List[S2c.File], cs: Coll.List[Names.Clash]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    c match
      case Names.Dup(l, n) => S2c.diag(fs, "duplicate", l, "duplicate name", S2c.Name(n), "rename one of them")
      case Names.Unknown(l, n) => S2c.diag(fs, "unknown-name", l, "unknown name", S2c.Name(n), "declare it, or fix its spelling (module members are written qualified: Foo.bar)")
      case Names.NoType(l, n) => S2c.diag(fs, "unknown-type", l, "unknown type", S2c.Name(n), "declare it, or fix its spelling")
      case Names.BadState(l, n) => S2c.diag(fs, "unknown-state", l, "unknown capability state", S2c.Name(n), "use a state the capability declares")
      case Names.NoDrop(l, n) => S2c.diag(fs, "unknown-drop", l, "unknown drop op", S2c.Name(n), "drop one of the capability's ops")
      case Names.NoProto(l, n) => S2c.diag(fs, "not-a-capability", l, "a handler of a name that is not a capability:", S2c.Name(n), "write a handler for a capability")
      case Names.NoInit(l, n) => S2c.diag(fs, "handler-no-init", l, "a handler without init:", S2c.Name(n), "define def init(...): Ptr")
      case Names.NoOp(l, n) => S2c.diag(fs, "handler-missing-op", l, "a handler misses the op", S2c.Name(n), "define every op of the capability")
      case Names.BadArity(l, n) => S2c.diag(fs, "handler-arity", l, "a handler fn has the wrong arity:", S2c.Name(n), "take self: Ptr first, then the op's params")
    S2c.showNames(fs, rest)

def S2c.showFlow(fs: Coll.List[S2c.File], cs: Coll.List[Flow.Clash]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    c match
      case Flow.Stuck(l, n) => S2c.diag(fs, "op-not-allowed", l, "op not allowed in this state of the capability", S2c.Name(n), "call the ops in the order the capability allows")
      case Flow.Split(l, n) => S2c.diag(fs, "branch-states", l, "branches leave the capability in different states:", S2c.Name(n), "bring it to one state on every branch")
      case Flow.Unended(l, n) => S2c.diag(fs, "capability-not-ended", l, "the capability does not end in its declared state:", S2c.Name(n), "end it (its drop op or an op into an end state) before its scope ends")
      case Flow.Ambig(l, n) => S2c.diag(fs, "entry-facts-ambiguous", l, "entry facts with more than one solution at the call of", S2c.Name(n), "fix the capability states before the call")
      case Flow.ExitBad(l, n) => S2c.diag(fs, "exit-state", l, "a capability ends in another state than the exit fact of", S2c.Name(n), "end it in the state the exit fact names")
      case Flow.NoSol(l, n) => S2c.diag(fs, "entry-facts-unsolvable", l, "entry facts with no solution in", S2c.Name(n), "make the entry facts satisfiable")
      case Flow.Dead(l, n) => S2c.diag(fs, "use-after-free", l, "use of a value after its region ended:", S2c.Name(n), "use it before the region ends, or allocate it in a longer region")
      case Flow.Escape(l, n) => S2c.diag(fs, "region-escape", l, "a value escapes the scope of its region", S2c.Name(n), "allocate it in a region that outlives the block")
      case Flow.Stale(l, x) => S2c.diag(fs, "stale-value", l, "the value needs its capability in the state its type names; it is in another state:", S2c.Name(x), "use it before the capability changes state")
      case Flow.Bound(l, n) => S2c.diag(fs, "capability-bound", l, "a value lives in, or is bound to, a capability its type does not name:", S2c.Name(n), "pass or make a value of the capability the type names (its ^<...> or its fact), or name that capability in the type")
      case Flow.MsState(l, c) => S2c.diag(fs, "multishot-state", l, "a capability from outside a multi-shot handle is in another state here than at the end of the block:", S2c.Name(c), "each resume runs the rest of the block again from here: bring the capability back to this state by the end, or open it inside the block")
    S2c.showFlow(fs, rest)

// a rule library that is not a Datalog program, or a clash of another shape: a bug in s2, reported as one
def S2c.internal(phase: Str, rel: Sym.Sym): I64 =
  Console.eprint("srs internal: the ")
  Console.eprint(phase)
  Console.eprint(" rules are ill-formed at relation ")
  Console.eprint(Sym.str(rel))
  Console.eprint("\n")
  2

// what a checked program becomes: C (the default), or the output of an s1 flag (vic 2026-11-09: s2 has every s1 flag)
enum S2c.Mode:
  case S2c.EmitC
  // --eval: "name value" for each nullary pure def but main, run at compile time
  case S2c.EvalAll
  // --hash: "name a.b.c.d", the content hash of every def and enum
  case S2c.HashAll
  // --store-check: write every hashed decl to the store, read it back, compare
  case S2c.StoreCheck
  // --fragment: the C fragment gate (s2/elgate.srs): the table of kinds; exit 1 on a permanent kind
  case S2c.Fragment

// --fragment: the table of every kind (stdout); the C leaves the fragment where a permanent kind is found: exit 1
def S2c.fragment(fs: Coll.List[S2c.File], vs: Coll.List[Elgate.V]): I64 =
  Elgate.rows(vs, Elgate.kinds())
  val bad = Elgate.failing(vs, Coll.Nil)
  S2c.fragmentErrs(fs, bad)
  bad match
    case Coll.Nil => 0
    case Coll.Cons(_, _) => 1

def S2c.fragmentErrs(fs: Coll.List[S2c.File], vs: Coll.List[Elgate.V]): Unit = vs match
  case Coll.Nil => ()
  case Coll.Cons(v, rest) =>
    val Elgate.V(k, c, l, _) = v
    S2c.diag(fs, "c-fragment", l, Elgate.kindS(k), S2c.Text(Elgate.conS(c)), "the emitted C may not contain it: lower the construct to a statement, or move it into a handler")
    S2c.fragmentErrs(fs, rest)

def S2c.finish(m: S2c.Mode, fs: Coll.List[S2c.File], ds: Coll.List[Ast.Decl], rows: Eff.Rows, res: Ty.Result): I64 = m match
  case S2c.StoreCheck =>
    Store.check(ds)
    0
  case S2c.HashAll =>
    Hs.print(ds)
    0
  case S2c.Fragment =>
    S2c.fragment(fs, Elgate.run(ds, res))
  case S2c.EmitC =>
    Emit.program(ds, res)
    0
  case S2c.EvalAll => Pure.impure(ds, rows) match
    case Pure.RulesBad(rel) => S2c.internal("purity", rel)
    case Pure.Got(imp) => Ev.all(ds, imp) match
      case Ev.Lines(ls) =>
        S2c.showLines(ls)
        0
      case Ev.Failed(e) =>
        e match
          case Ev.Fuel(l, f) => S2c.diag(fs, "comptime-fuel", l, "comptime evaluation ran out of fuel at", S2c.Name(f), "the evaluation loops or runs too long: bound it")
          case Ev.DivZero(l, f) => S2c.diag(fs, "comptime-div-zero", l, "comptime division by zero in", S2c.Name(f), "divide by a nonzero value")
          case Ev.NoValue(l, f) => S2c.diag(fs, "comptime-no-value", l, "no compile-time value at", S2c.Name(f), "call only pure fns at compile time")
        1

def S2c.showLines(ls: Coll.List[Ev.Line]): Unit = ls match
  case Coll.Nil => ()
  case Coll.Cons(l, rest) =>
    val Ev.Shown(n, v) = l
    Console.print(Sym.str(n))
    Console.print(" ")
    Ev.show(v)
    Console.print("\n")
    S2c.showLines(rest)

// the flag in arg 1, if any; the files follow it
enum S2c.Args:
  case S2c.Args(m: S2c.Mode, first: I64)

def S2c.args(): S2c.Args =
  if Args.count() > 1 && Str.eq(Args.at(1), "--eval") then S2c.Args(S2c.EvalAll, 2)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--hash") then S2c.Args(S2c.HashAll, 2)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--store-check") then S2c.Args(S2c.StoreCheck, 2)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--fragment") then S2c.Args(S2c.Fragment, 2)
  else S2c.Args(S2c.EmitC, 1)

def main(): I64 =
  handle r = Srs.Arena()
  handle c = Srs.Console()
  handle a = Srs.Args()
  handle f = Srs.Files()
  handle st = Srs.Store()
  val S2c.Args(m, first) = S2c.args()
  val S2c.Read(ds, errs, fs) = S2c.read(first, 1, Coll.Nil, Coll.Nil, Coll.Nil)
  errs match
    case Coll.Cons(_, _) =>
      S2c.showErrs(fs, errs)
      1
    case Coll.Nil => S2c.compile(m, fs, ds)

// a type as written: Name[arg, ...]
def S2c.term(t: K.Term): Unit = t match
  case K.Con(n, args) =>
    Console.eprint(Sym.str(n))
    args match
      case Coll.Nil => ()
      case Coll.Cons(a, rest) =>
        Console.eprint("[")
        S2c.term(a)
        S2c.terms(rest)
        Console.eprint("]")
  case K.Int(v) => Console.eprintI64(v)
  case K.Var(v) =>
    Console.eprint("?")
    Console.eprintI64(v)

def S2c.terms(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Console.eprint(", ")
    S2c.term(t)
    S2c.terms(rest)
