// S1 parser: tokens -> decl nodes. Grammar = s0/parse.zig.

enum PR:
  case PR(n: Node, rest: Nodes)

def pn(p: PR): Node = p match
  case PR(n, _) => n
def pr(p: PR): Nodes = p match
  case PR(_, rest) => rest

def isK(ts: Nodes, k: Kind): Bool = kind(head(ts)) == k
def isT(ts: Nodes, s: Str): Bool =
  val k = kind(head(ts))
  (k == TOp || k == TIdent) && eqs(text(head(ts)), s)
def at(ts: Nodes): I64 = lineOf(head(ts))

def perr(ts: Nodes, what: Str): Unit =
  rt_eprint("srs:")
  rt_eprint_i64(at(ts))
  rt_eprint(": parse error: expected ")
  rt_eprint(what)
  rt_eprint(", got '")
  rt_eprint(text(head(ts)))
  rt_eprint("'\n")
  rt_exit(1)

def expect(ts: Nodes, s: Str): Nodes =
  if isT(ts, s) then tail(ts)
  else
    perr(ts, s)
    ts
def expectK(ts: Nodes, k: Kind, what: Str): Nodes =
  if isK(ts, k) then tail(ts)
  else
    perr(ts, what)
    ts
def needIdent(ts: Nodes): Str =
  if isK(ts, TIdent) then text(head(ts))
  else
    perr(ts, "identifier")
    ""
def layoutOpen(ts: Nodes): Nodes = expectK(expectK(expect(ts, ":"), TNl, "newline"), TIndent, "indent")
def endLine(ts: Nodes): Nodes = if isK(ts, TDedent) then ts else expectK(ts, TNl, "newline")
def list {r: Region} (k: Kind, line: I64, xs: Nodes): Node = Node(k, "", "", 0, line, xs)

def parseFile {r: Region} (toks: Nodes): Nodes =
  var ts = toks
  var out = NNil
  while !isK(ts, TEof) do
    if isK(ts, TNl) then ts = tail(ts)
    else
      val p = decl(ts)
      out = NCons(pn(p), out)
      ts = pr(p)
  rev(out)

def decl {r: Region} (ts: Nodes): PR =
  if isT(ts, "extern") then fn(tail(ts), 1)
  else if isT(ts, "def") then fn(ts, 0)
  else if isT(ts, "spec") then fn(tail(ts), 2)
  else if isT(ts, "enum") then enumDecl(tail(ts))
  else if isT(ts, "protocol") then protoDecl(tail(ts))
  else if isT(ts, "handler") then handlerDecl(tail(ts))
  else if isT(ts, "trait") then traitDecl(tail(ts))
  else if isT(ts, "type") then typeDecl(tail(ts))
  else if isT(ts, "given") then givenDecl(tail(ts))
  else
    perr(ts, "declaration")
    PR(NoNode, ts)

// signature = telescope: binder groups (vic/c/binders-design.md) around the one `()` group; facts after the return type
def fn {r: Region} (ts0: Nodes, ext: I64): PR =
  var ts = expect(ts0, "def")
  val line = at(ts)
  val name = needIdent(ts)
  val g1 = groups(tail(ts), NNil)
  val ps = params(pr(g1))
  val g2 = groups(pr(ps), kids(pn(g1)))
  val rt = ty(expect(pr(g2), ":"))
  val g3 = if isT(pr(rt), "<") then outFacts(pr(rt), kids(pn(g2))) else g2
  val gs = list(Groups, line, rev(kids(pn(g3))))
  val after = if isT(pr(rt), "<") then pr(g3) else pr(rt)
  // spec defs are Lean only (vic 2026-11-05); externs take groups: a trusted contract of the C body
  if ext == 2 && !isNil(kids(gs)) then fatal("binder groups on def and extern def only, not spec def", line) else ()
  if ext == 1 then PR(Node(DFn, name, "", 1, line, NCons(pn(ps), NCons(pn(rt), NCons(NoNode, NCons(list(Names, line, NNil), one(gs)))))), after)
  else
    // contract clauses, indented between the signature and `=`
    val cl = if isK(after, TNl) && isK(tail(after), TIndent) then clauses(tail(after)) else PR(list(Names, line, NNil), after)
    val b = rhs(expect(pr(cl), "="))
    PR(Node(DFn, name, "", ext, line, NCons(pn(ps), NCons(pn(rt), NCons(pn(b), NCons(pn(cl), one(gs)))))), pr(b))

// groups in written order, reversed onto acc: `[A: Type]` type ascriptions, `{s: Show[A]}` evidence, `<at(f, s)>` facts
def groups {r: Region} (ts0: Nodes, acc: Nodes): PR =
  var ts = ts0
  var gs = acc
  while isT(ts, "{") || isT(ts, "[") || isT(ts, "<") do
    val g = group(ts, "")
    gs = NCons(pn(g), gs)
    ts = pr(g)
  PR(list(Groups, at(ts0), gs), ts)

// facts after the return type: what holds when the call returns
def outFacts {r: Region} (ts: Nodes, acc: Nodes): PR =
  val g = group(ts, "out")
  PR(list(Groups, at(ts), NCons(pn(g), acc)), pr(g))

def group {r: Region} (ts0: Nodes, out: Str): PR =
  val line = at(ts0)
  val open = text(head(ts0))
  val close = if eqs(open, "{") then "}" else if eqs(open, "[") then "]" else if eqs(open, "(") then ")" else ">"
  var ts = tail(ts0)
  var xs = NNil
  while !isT(ts, close) do
    if eqs(open, "<") then
      val a = tterm(ts, "(")
      xs = NCons(pn(a), xs)
      ts = pr(a)
    else
      val n = needIdent(ts)
      val bl = at(ts)
      val t = tterm(expect(tail(ts), ":"), "[")
      xs = NCons(Node(Binder, n, "", 0, bl, one(pn(t))), xs)
      ts = pr(t)
    if !isT(ts, close) then ts = expect(ts, ",") else ()
  PR(Node(Group, open, out, 0, line, rev(xs)), tail(ts))

// T | T[args] | 3: a type (open = "[") or a Datalog atom p(args) (open = "(")
def tterm {r: Region} (ts0: Nodes, open: Str): PR =
  val line = at(ts0)
  if isK(ts0, TInt) then PR(Node(TTerm, text(head(ts0)), "", 1, line, NNil), tail(ts0))
  else
    val f = needIdent(ts0)
    var ts = tail(ts0)
    var xs = NNil
    val close = if eqs(open, "[") then "]" else ")"
    if isT(ts, open) then
      ts = tail(ts)
      while !isT(ts, close) do
        val a = tterm(ts, open)
        xs = NCons(pn(a), xs)
        ts = pr(a)
        if !isT(ts, close) then ts = expect(ts, ",") else ()
      ts = tail(ts)
    else ()
    PR(Node(TTerm, f, "", 0, line, rev(xs)), ts)

def clauses {r: Region} (ts0: Nodes): PR =
  var ts = expectK(ts0, TIndent, "indent")
  var cs = NNil
  while !isK(ts, TDedent) do
    val p = clause(ts)
    cs = NCons(pn(p), cs)
    ts = endLine(pr(p))
  PR(list(Names, at(ts0), rev(cs)), tail(ts))

def isClause(ts: Nodes): Bool =
  isT(ts, "requires") || isT(ts, "ensures") || isT(ts, "returns") || isT(ts, "decreases") || isT(ts, "invariant") || isT(ts, "proof")

// requires e | ensures e | returns e | decreases e | invariant e | proof using a, b | proof by induction x | proof lean "tactics"
def clause {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val kw = text(head(ts0))
  if !isClause(ts0) then perr(ts0, "requires, ensures, returns, decreases, invariant or proof") else ()
  if eqs(kw, "proof") then
    val ts = tail(ts0)
    if isT(ts, "using") then
      var t = tail(ts)
      var xs = NNil
      xs = NCons(leaf(Name, needIdent(t), line), xs)
      t = tail(t)
      while isT(t, ",") do
        xs = NCons(leaf(Name, needIdent(tail(t)), line), xs)
        t = drop(t, 2)
      PR(Node(SClause, kw, "using", 0, line, rev(xs)), t)
    else if isT(ts, "by") then
      val t = expect(tail(ts), "induction")
      PR(Node(SClause, kw, "by", 0, line, one(leaf(Name, needIdent(t), line))), tail(t))
    else
      val t = expect(ts, "lean")
      if !isK(t, TStr) then perr(t, "a string of Lean tactics") else ()
      PR(Node(SClause, kw, "lean", 0, line, one(leaf(XStr, text(head(t)), line))), tail(t))
  else
    val e = expr(tail(ts0))
    PR(Node(SClause, kw, "", 0, line, one(pn(e))), pr(e))

def enumDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  // `enum List [A: Type]:` [] binders; every case keeps them as its kid 1, so the case list stays the enum's kids
  val g = groups(tail(ts0), NNil)
  val gs = list(Groups, line, rev(kids(pn(g))))
  var ts = layoutOpen(pr(g))
  var cs = NNil
  var tag = 0
  while !isK(ts, TDedent) do
    ts = expect(ts, "case")
    val cl = at(ts)
    val cn = needIdent(ts)
    ts = tail(ts)
    var fs = list(Params, cl, NNil)
    if isT(ts, "(") then
      val p = params(ts)
      fs = pn(p)
      ts = pr(p)
    else ()
    cs = NCons(Node(DCase, cn, name, tag, cl, NCons(fs, one(gs))), cs)
    tag = tag + 1
    ts = endLine(ts)
  PR(Node(DEnum, name, "", 0, line, rev(cs)), tail(ts))

def protoDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = layoutOpen(tail(ts0))
  var states = NNil
  var start = ""
  var ends = NNil
  var dropOp = ""
  var ops = NNil
  var rules = NNil
  while !isK(ts, TDedent) do
    if isT(ts, "state") then
      val p = names(tail(ts))
      states = kids(pn(p))
      ts = pr(p)
    else if isT(ts, "start") then
      start = needIdent(tail(ts))
      ts = drop(ts, 2)
    else if isT(ts, "end") then
      val p = names(tail(ts))
      ends = kids(pn(p))
      ts = pr(p)
    else if isT(ts, "drop") then
      dropOp = needIdent(tail(ts))
      ts = drop(ts, 2)
    else if isT(ts, "rule") then
      val p = ruleDecl(expect(tail(ts), "def"))
      rules = NCons(pn(p), rules)
      ts = pr(p)
    else if isT(ts, "op") then
      val p = opDecl(tail(ts))
      ops = NCons(pn(p), ops)
      ts = pr(p)
    else perr(ts, "protocol item")
    ts = endLine(ts)
  val parts = NCons(list(Names, line, states), NCons(list(Names, line, ends), NCons(leaf(Name, dropOp, line), NCons(list(Names, line, rev(ops)), one(list(Names, line, rev(rules)))))))
  PR(Node(DProto, name, start, 0, line, parts), tail(ts))

// rule def name(v1, v2) = atom, atom (in a protocol, vic 2026-11-05): a Datalog rule; DRule s = name, a = [Names params, atoms...]
def ruleDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = expect(tail(ts0), "(")
  var ps = NNil
  while !isT(ts, ")") do
    ps = NCons(leaf(Name, needIdent(ts), at(ts)), ps)
    ts = tail(ts)
    if !isT(ts, ")") then ts = expect(ts, ",") else ()
  ts = expect(tail(ts), "=")
  var body = NNil
  var more = true
  while more do
    val a = tterm(ts, "(")
    body = NCons(pn(a), body)
    ts = pr(a)
    more = isT(ts, ",")
    if more then ts = tail(ts) else ()
  PR(Node(DRule, name, "", 0, line, NCons(list(Names, line, rev(ps)), rev(body))), ts)

def opDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  val ps = params(tail(ts0))
  val rt = ty(expect(pr(ps), ":"))
  var ts = expect(pr(rt), ":")
  var tr = NNil
  var more = true
  while more do
    val f = needIdent(ts)
    ts = expect(expect(tail(ts), "-"), ">")
    tr = NCons(Node(DTrans, f, needIdent(ts), 0, line, NNil), tr)
    ts = tail(ts)
    if isT(ts, ",") then ts = tail(ts) else more = false
  PR(Node(DOp, name, "", 0, line, NCons(pn(ps), NCons(pn(rt), one(list(Names, line, rev(tr)))))), ts)

def names {r: Region} (ts0: Nodes): PR =
  var ts = ts0
  var xs = one(leaf(Name, needIdent(ts), at(ts)))
  ts = tail(ts)
  while isT(ts, ",") do
    xs = NCons(leaf(Name, needIdent(tail(ts)), at(ts)), xs)
    ts = drop(ts, 2)
  PR(list(Names, at(ts0), rev(xs)), ts)

// type F [A: Type] = T, or a match type: type F [A: Type] = A match / case P => T ... (vic S18 + telescopes, vic-9l7.9 BD6)
// DType s = name, n 1 = match, a = [Groups, body Ty (the scrutinee of a match), DTCase(a = [pattern, result])...]
def typeDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  val g = groups(tail(ts0), NNil)
  // () value binders after the other groups (vic-u2d.3): type Bits (n: I64) = ...
  val vg = if isT(pr(g), "(") then group(pr(g), "") else PR(NoNode, pr(g))
  val gs = list(Groups, line, if found(pn(vg)) then append(rev(kids(pn(g))), one(pn(vg))) else rev(kids(pn(g))))
  var ts = expect(pr(vg), "=")
  // a value match: type Bits (n: I64) = n match / case 8 => U8 / case _ => U64 (vic Q-U3 a); DType n = 2
  val vm = found(pn(vg)) && isK(ts, TIdent) && found(find(kids(pn(vg)), Binder, text(head(ts)))) && isT(tail(ts), "match")
  if vm then
    val scrut = leaf(XName, text(head(ts)), line)
    ts = expectK(expectK(drop(ts, 2), TNl, "newline"), TIndent, "indent")
    var vcs = NNil
    while !isK(ts, TDedent) do
      val cl = at(ts)
      val p = valuePat(expect(ts, "case"))
      val t = ty(expect(pr(p), "=>"))
      vcs = NCons(Node(DTCase, "", "", 0, cl, NCons(pn(p), one(pn(t)))), vcs)
      ts = endLine(pr(t))
    PR(Node(DType, name, "", 2, line, NCons(gs, NCons(scrut, rev(vcs)))), tail(ts))
  else typeBody(name, line, gs, ts)

// a value match pattern: an int, a string, true, false or _
def valuePat {r: Region} (ts: Nodes): PR =
  val line = at(ts)
  if isK(ts, TInt) then PR(Node(XInt, "", "", parseInt(text(head(ts))), line, NNil), tail(ts))
  else if isK(ts, TStr) then PR(leaf(XStr, text(head(ts)), line), tail(ts))
  else if isT(ts, "true") || isT(ts, "false") then PR(Node(XBool, "", "", if isT(ts, "true") then 1 else 0, line, NNil), tail(ts))
  else if isT(ts, "_") then PR(leaf(XName, "_", line), tail(ts))
  else
    perr(ts, "a value pattern (int, string, true, false, _)")
    PR(NoNode, ts)

// the body of a type decl: a type, or a match type on a type
def typeBody {r: Region} (name: Str, line: I64, gs: Node, ts0: Nodes): PR =
  var ts = ts0
  val b = ty(ts)
  ts = pr(b)
  if isT(ts, "match") then
    ts = expectK(expectK(tail(ts), TNl, "newline"), TIndent, "indent")
    var cs = NNil
    while !isK(ts, TDedent) do
      val cl = at(ts)
      val p = ty(expect(ts, "case"))
      val t = ty(expect(pr(p), "=>"))
      cs = NCons(Node(DTCase, "", "", 0, cl, NCons(pn(p), one(pn(t)))), cs)
      ts = endLine(pr(t))
    PR(Node(DType, name, "", 1, line, NCons(gs, NCons(pn(b), rev(cs)))), tail(ts))
  else PR(Node(DType, name, "", 0, line, NCons(gs, one(pn(b)))), ts)

// trait Show [A: Type]: indented `def` signatures (no bodies) (vic-9l7.6 BD4a)
def traitDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  val g = groups(tail(ts0), NNil)
  var ts = layoutOpen(pr(g))
  var fs = NNil
  while !isK(ts, TDedent) do
    val p = fn(ts, 1)
    fs = NCons(pn(p), fs)
    ts = endLine(pr(p))
  PR(Node(DTrait, name, "", 0, line, NCons(list(Groups, line, rev(kids(pn(g)))), rev(fs))), tail(ts))

// given [A: Type] {s: Show[A]} Show[List[A]]: indented defs. a clause: its head holds when its {} evidence does.
// each def keeps the given's groups as its kid 4, so it is checked and instantiated as a generic def
def givenDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val g = groups(ts0, NNil)
  val gs = list(Groups, line, rev(kids(pn(g))))
  val hd = ty(pr(g))
  var ts = layoutOpen(pr(hd))
  var fs = NNil
  while !isK(ts, TDedent) do
    val p = fn(ts, 0)
    val f = pn(p)
    fs = NCons(withKids(f, NCons(kid(f, 0), NCons(kid(f, 1), NCons(kid(f, 2), NCons(kid(f, 3), one(gs)))))), fs)
    ts = pr(p)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(Node(DGiven, text(pn(hd)), "", 0, line, NCons(gs, NCons(pn(hd), rev(fs)))), tail(ts))

def handlerDecl {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = expect(tail(ts0), "for")
  val proto = needIdent(ts)
  ts = layoutOpen(tail(ts))
  var fs = NNil
  while !isK(ts, TDedent) do
    val p = fn(ts, 0)
    fs = NCons(pn(p), fs)
    ts = pr(p)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(Node(DHandler, name, proto, 0, line, rev(fs)), tail(ts))

def params {r: Region} (ts0: Nodes): PR =
  var ts = expect(ts0, "(")
  var ps = NNil
  while !isT(ts, ")") do
    val n = needIdent(ts)
    val pl = at(ts)
    val t = ty(expect(tail(ts), ":"))
    ps = NCons(Node(Param, n, "", 0, pl, one(pn(t))), ps)
    ts = pr(t)
    if !isT(ts, ")") then ts = expect(ts, ",") else ()
  PR(list(Params, at(ts0), rev(ps)), tail(ts))

def ty {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = tail(ts0)
  // type application T[args] (vic 2026-11-05: [] = types, the Scala3 surface): the args are the kids of TyTo, so tyCaps stays the tail
  var args = NNil
  if isT(ts, "[") then
    ts = tail(ts)
    while !isT(ts, "]") do
      val a = ty(ts)
      args = NCons(pn(a), args)
      ts = pr(a)
      if !isT(ts, "]") then ts = expect(ts, ",") else ()
    ts = tail(ts)
  else ()
  // value args T(v, ...) (vic-u2d.3): compile-time values, the last kid (normTy evaluates them and drops it)
  var vals = NNil
  // a one-char test: this runs for every type parsed (bench: isT here cost +0.1% of a compile)
  val hasVals = isK(ts, TOp) && rt_str_at(text(head(ts)), 0) == 40 && rt_str_len(text(head(ts))) == 1
  if hasVals then
    ts = tail(ts)
    while !isT(ts, ")") do
      val v = expr(ts)
      vals = NCons(pn(v), vals)
      ts = pr(v)
      if !isT(ts, ")") then ts = expect(ts, ",") else ()
    ts = tail(ts)
  else ()
  var caps = NNil
  var annotated = 0
  // caps T^<r, q>: the regions a value lives in are facts (vic 2026-11-05)
  if isT(ts, "^") then
    annotated = 1
    ts = expect(tail(ts), "<")
    while !isT(ts, ">") do
      caps = NCons(leaf(TyCap, needIdent(ts), line), caps)
      ts = tail(ts)
      if !isT(ts, ">") then ts = expect(ts, ",") else ()
    ts = tail(ts)
  else ()
  val tail0 = if hasVals then append(rev(caps), one(list(TyVals, line, rev(vals)))) else rev(caps)
  PR(Node(Ty, name, "", annotated, line, NCons(Node(TyTo, "", "", 0, line, rev(args)), tail0)), ts)

def rhs {r: Region} (ts: Nodes): PR =
  if isK(ts, TNl) && isK(tail(ts), TIndent) then block(tail(ts)) else expr(ts)

def block {r: Region} (ts0: Nodes): PR =
  var ts = expectK(ts0, TIndent, "indent")
  var ss = NNil
  while !isK(ts, TDedent) do
    val p = stmt(ts)
    ss = NCons(pn(p), ss)
    ts = pr(p)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(list(XBlock, at(ts0), unPat(ss, NNil)), tail(ts))

// the statements of a block in order (ss reversed); a pattern val takes the statements after it as its arm body
def unPat {r: Region} (ss: Nodes, acc: Nodes): Nodes =
  if isNil(ss) then acc
  else if kind(head(ss)) == XMatch && num(head(ss)) == 1 then unPat(tail(ss), one(armRest(head(ss), acc)))
  else unPat(tail(ss), NCons(head(ss), acc))
def armRest {r: Region} (m: Node, rest: Nodes): Node =
  val arm = kid(m, 1)
  val body = if isNil(rest) then leaf(XUnit, "", lineOf(m)) else list(XBlock, lineOf(m), rest)
  Node(XMatch, "", "", 0, lineOf(m), NCons(kid(m, 0), one(Node(XArm, text(arm), "", 0, lineOf(arm), NCons(body, tail(kids(arm)))))))

// val C(a, b) = e (vic-m5r.11): binds the fields of the one case C; block makes it `e match case C(a, b) => <rest>`
// (num 1 until then), so a case of an enum with more cases is a non-exhaustive match
def isPatVal(ts: Nodes): Bool = isK(ts, TIdent) && rt_str_at(text(head(ts)), 0) >= 'A' && rt_str_at(text(head(ts)), 0) <= 'Z' && isT(tail(ts), "(")
def patVal {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  val p = patBinds(drop(ts0, 2), line)
  val e = rhs(expect(pr(p), "="))
  PR(Node(XMatch, "", "", 1, line, NCons(pn(e), one(Node(XArm, needIdent(tail(ts0)), "", 0, line, NCons(leaf(XUnit, "", line), kids(pn(p))))))), pr(e))

def stmt {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  if isT(ts0, "val") && isPatVal(tail(ts0)) then patVal(ts0)
  else if isT(ts0, "val") || isT(ts0, "var") then
    val mut = if isT(ts0, "var") then 1 else 0
    val name = needIdent(tail(ts0))
    var ts = drop(ts0, 2)
    var tyk = NNil
    if isT(ts, ":") then
      val t = ty(tail(ts))
      tyk = one(pn(t))
      ts = pr(t)
    else ()
    val e = rhs(expect(ts, "="))
    PR(Node(SVal, name, "", mut, line, NCons(pn(e), tyk)), pr(e))
  else if isT(ts0, "invariant") || isT(ts0, "decreases") then clause(ts0)
  else if isT(ts0, "handle") then
    val name = needIdent(tail(ts0))
    val ts = expect(drop(ts0, 2), "=")
    val a = args(tail(ts))
    PR(Node(SHandle, name, needIdent(ts), 0, line, kids(pn(a))), pr(a))
  else expr(ts0)

// f[T1, T2]{a, b}(args): explicit type args, chosen evidence or capabilities (vic 2026-11-05)
def callGroups {r: Region} (ts0: Nodes): PR =
  var ts = ts0
  var gs = NNil
  while isT(ts, "[") || isT(ts, "{") do
    val open = text(head(ts))
    val close = if eqs(open, "[") then "]" else "}"
    val line = at(ts)
    ts = tail(ts)
    var xs = NNil
    while !isT(ts, close) do
      if eqs(open, "[") then
        val t = ty(ts)
        xs = NCons(pn(t), xs)
        ts = pr(t)
      else
        xs = NCons(leaf(Name, needIdent(ts), at(ts)), xs)
        ts = tail(ts)
      if !isT(ts, close) then ts = expect(ts, ",") else ()
    gs = NCons(Node(Group, open, "", 0, line, rev(xs)), gs)
    ts = tail(ts)
  PR(list(Groups, at(ts0), rev(gs)), ts)

def args {r: Region} (ts0: Nodes): PR =
  var ts = expect(ts0, "(")
  var xs = NNil
  while !isT(ts, ")") do
    val e = expr(ts)
    xs = NCons(pn(e), xs)
    ts = pr(e)
    if !isT(ts, ")") then ts = expect(ts, ",") else ()
  PR(list(Names, at(ts0), rev(xs)), tail(ts))

def expr {r: Region} (ts0: Nodes): PR =
  val line = at(ts0)
  if isT(ts0, "if") then
    val c = expr(tail(ts0))
    val t = rhs(expect(pr(c), "then"))
    var ts = pr(t)
    if isK(ts, TNl) && isT(tail(ts), "else") then ts = tail(ts) else ()
    val e = rhs(expect(ts, "else"))
    PR(Node(XIf, "", "", 0, line, NCons(pn(c), NCons(pn(t), one(pn(e))))), pr(e))
  else if isT(ts0, "forall") || isT(ts0, "exists") then
    val x = needIdent(tail(ts0))
    val t = ty(expect(drop(ts0, 2), ":"))
    val b = expr(expect(pr(t), "=>"))
    PR(Node(if isT(ts0, "forall") then XForall else XExists, x, "", 0, line, NCons(pn(t), one(pn(b)))), pr(b))
  else if isT(ts0, "while") then
    val c = expr(tail(ts0))
    val b = rhs(expect(pr(c), "do"))
    PR(Node(XWhile, "", "", 0, line, NCons(pn(c), one(pn(b)))), pr(b))
  else if isK(ts0, TIdent) && isK(tail(ts0), TOp) && eqs(text(head(tail(ts0))), "=") then
    val e = rhs(drop(ts0, 2))
    PR(Node(XAssign, text(head(ts0)), "", 0, line, one(pn(e))), pr(e))
  else
    val b = binary(ts0, 0)
    if isT(pr(b), "match") then arms(pn(b), tail(pr(b))) else b

// (a, b, ...) after a case name: the binders, in order
def patBinds {r: Region} (ts0: Nodes, line: I64): PR =
  var ts = tail(ts0)
  var binds = NNil
  while !isT(ts, ")") do
    binds = NCons(leaf(XName, needIdent(ts), line), binds)
    ts = tail(ts)
    if !isT(ts, ")") then ts = expect(ts, ",") else ()
  PR(list(Names, line, rev(binds)), tail(ts))

def arms {r: Region} (scrut: Node, ts0: Nodes): PR =
  var ts = expectK(expectK(ts0, TNl, "newline"), TIndent, "indent")
  var xs = NNil
  while !isK(ts, TDedent) do
    val al = at(ts)
    ts = expect(ts, "case")
    var ctor = "_"
    var binds = NNil
    if isT(ts, "_") then ts = tail(ts)
    else
      ctor = needIdent(ts)
      ts = tail(ts)
      if isT(ts, "(") then
        val p = patBinds(ts, al)
        binds = kids(pn(p))
        ts = pr(p)
      else ()
    val b = rhs(expect(ts, "=>"))
    xs = NCons(Node(XArm, ctor, "", 0, al, NCons(pn(b), binds)), xs)
    ts = pr(b)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(Node(XMatch, "", "", 0, lineOf(scrut), NCons(scrut, rev(xs))), tail(ts))

def opLevel(s: Str): I64 =
  if eqs(s, "||") then 0 else if eqs(s, "&&") then 1
  else if eqs(s, "==") || eqs(s, "!=") then 2
  else if eqs(s, "<") || eqs(s, "<=") || eqs(s, ">") || eqs(s, ">=") then 3
  else if eqs(s, "+") || eqs(s, "-") then 4
  else if eqs(s, "*") || eqs(s, "/") || eqs(s, "%") then 5
  else -1

def binary {r: Region} (ts0: Nodes, lvl: I64): PR =
  if lvl == 6 then unary(ts0)
  else
    var p = binary(ts0, lvl + 1)
    while isK(pr(p), TOp) && opLevel(text(head(pr(p)))) == lvl do
      val op = head(pr(p))
      val q = binary(tail(pr(p)), lvl + 1)
      p = PR(Node(XBin, text(op), "", 0, lineOf(op), NCons(pn(p), one(pn(q)))), pr(q))
    p

def unary {r: Region} (ts: Nodes): PR =
  if isT(ts, "-") || isT(ts, "!") then
    val e = unary(tail(ts))
    PR(Node(XUn, text(head(ts)), "", 0, at(ts), one(pn(e))), pr(e))
  else primary(ts)

def parseInt(s: Str): I64 =
  var v = 0
  var i = 0
  while i < rt_str_len(s) do
    v = v * 10 + rt_str_at(s, i) - '0'
    i = i + 1
  v

def charValue(ts: Nodes): I64 =
  val s = text(head(ts))
  if rt_str_len(s) == 1 then rt_str_at(s, 0)
  else
    val c = rt_str_at(s, 1)
    if c == 'n' then '\n' else if c == 't' then '\t' else if c == 'r' then '\r' else if c == '0' then 0
    else if c == '\\' || c == '\'' || c == '"' then c
    else
      perr(ts, "char escape")
      0

def primary {r: Region} (ts: Nodes): PR =
  val t = head(ts)
  val line = lineOf(t)
  val k = kind(t)
  if k == TInt then PR(Node(XInt, "", "", parseInt(text(t)), line, NNil), tail(ts))
  else if k == TStr then PR(leaf(XStr, text(t), line), tail(ts))
  else if k == TChar then PR(Node(XInt, "", "", charValue(ts), line, NNil), tail(ts))
  else if k == TIdent then
    val s = text(t)
    if eqs(s, "true") then PR(Node(XBool, "", "", 1, line, NNil), tail(ts))
    else if eqs(s, "false") then PR(Node(XBool, "", "", 0, line, NNil), tail(ts))
    else if isT(tail(ts), "(") then
      val a = args(tail(ts))
      PR(Node(XCall, s, "", 0, line, kids(pn(a))), pr(a))
    else if isT(tail(ts), "[") || isT(tail(ts), "{") then
      val g = callGroups(tail(ts))
      val a = args(pr(g))
      PR(Node(XCallG, s, "", 0, line, NCons(pn(g), kids(pn(a)))), pr(a))
    else if isT(tail(ts), ".") then
      val a = args(drop(ts, 3))
      PR(Node(XMethod, s, needIdent(drop(ts, 2)), 0, line, kids(pn(a))), pr(a))
    else PR(leaf(XName, s, line), tail(ts))
  else if isT(ts, "(") then
    if isT(tail(ts), ")") then PR(leaf(XUnit, "", line), drop(ts, 2))
    else
      val e = expr(tail(ts))
      PR(pn(e), expect(pr(e), ")"))
  else
    perr(ts, "expression")
    PR(NoNode, ts)
