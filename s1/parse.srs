// S1 parser: tokens -> decl nodes. Grammar = s0/parse.zig.

enum PR:
  case PR(n: Node, rest: Nodes)

def pn(p: PR): Node = p match
  case PR(n, _) => n
def pr(p: PR): Nodes = p match
  case PR(_, rest) => rest

def isK(ts: Nodes, k: Kind): Bool = kind(head(ts)) == k
def isT(ts: Nodes, s: Str): Bool =
  val k = kind(head(ts))
  (k == TOp || k == TIdent) && eqs(text(head(ts)), s)
def at(ts: Nodes): I64 = lineOf(head(ts))

def perr(ts: Nodes, what: Str): Unit =
  rt_eprint("srs:")
  rt_eprint_i64(at(ts))
  rt_eprint(": parse error: expected ")
  rt_eprint(what)
  rt_eprint(", got '")
  rt_eprint(text(head(ts)))
  rt_eprint("'\n")
  rt_exit(1)

def expect(ts: Nodes, s: Str): Nodes =
  if isT(ts, s) then tail(ts)
  else
    perr(ts, s)
    ts
def expectK(ts: Nodes, k: Kind, what: Str): Nodes =
  if isK(ts, k) then tail(ts)
  else
    perr(ts, what)
    ts
def needIdent(ts: Nodes): Str =
  if isK(ts, TIdent) then text(head(ts))
  else
    perr(ts, "identifier")
    ""
def layoutOpen(ts: Nodes): Nodes = expectK(expectK(expect(ts, ":"), TNl, "newline"), TIndent, "indent")
def endLine(ts: Nodes): Nodes = if isK(ts, TDedent) then ts else expectK(ts, TNl, "newline")
def list(r: Region, k: Kind, line: I64, xs: Nodes): Node = Node(k, "", "", 0, line, xs)

def parseFile(r: Region, toks: Nodes): Nodes =
  var ts = toks
  var out = NNil
  while !isK(ts, TEof) do
    if isK(ts, TNl) then ts = tail(ts)
    else
      val p = decl(r, ts)
      out = NCons(pn(p), out)
      ts = pr(p)
  rev(r, out)

def decl(r: Region, ts: Nodes): PR =
  if isT(ts, "extern") then fn(r, tail(ts), 1)
  else if isT(ts, "def") then fn(r, ts, 0)
  else if isT(ts, "spec") then fn(r, tail(ts), 2)
  else if isT(ts, "enum") then enumDecl(r, tail(ts))
  else if isT(ts, "protocol") then protoDecl(r, tail(ts))
  else if isT(ts, "handler") then handlerDecl(r, tail(ts))
  else
    perr(ts, "declaration")
    PR(NoNode, ts)

// signature = telescope: binder groups (vic/c/binders-design.md) around the one `()` group; facts after the return type
def fn(r: Region, ts0: Nodes, ext: I64): PR =
  var ts = expect(ts0, "def")
  val line = at(ts)
  val name = needIdent(ts)
  val g1 = groups(r, tail(ts), NNil)
  val ps = params(r, pr(g1))
  val g2 = groups(r, pr(ps), kids(pn(g1)))
  val rt = ty(r, expect(pr(g2), ":"))
  val g3 = if isT(pr(rt), "<") then outFacts(r, pr(rt), kids(pn(g2))) else g2
  val gs = list(r, Groups, line, rev(r, kids(pn(g3))))
  val after = if isT(pr(rt), "<") then pr(g3) else pr(rt)
  // spec defs are Lean only (vic 2026-11-05); externs take groups: a trusted contract of the C body
  if ext == 2 && !isNil(kids(gs)) then fatal("binder groups on def and extern def only, not spec def", line) else ()
  if ext == 1 then PR(Node(DFn, name, "", 1, line, NCons(pn(ps), NCons(pn(rt), NCons(NoNode, NCons(list(r, Names, line, NNil), one(r, gs)))))), after)
  else
    // contract clauses, indented between the signature and `=`
    val cl = if isK(after, TNl) && isK(tail(after), TIndent) then clauses(r, tail(after)) else PR(list(r, Names, line, NNil), after)
    val b = rhs(r, expect(pr(cl), "="))
    PR(Node(DFn, name, "", ext, line, NCons(pn(ps), NCons(pn(rt), NCons(pn(b), NCons(pn(cl), one(r, gs)))))), pr(b))

// groups in written order, reversed onto acc: `[A: Type]` type ascriptions, `{s: Show[A]}` evidence, `<at(f, s)>` facts
def groups(r: Region, ts0: Nodes, acc: Nodes): PR =
  var ts = ts0
  var gs = acc
  while isT(ts, "{") || isT(ts, "[") || isT(ts, "<") do
    val g = group(r, ts, "")
    gs = NCons(pn(g), gs)
    ts = pr(g)
  PR(list(r, Groups, at(ts0), gs), ts)

// facts after the return type: what holds when the call returns
def outFacts(r: Region, ts: Nodes, acc: Nodes): PR =
  val g = group(r, ts, "out")
  PR(list(r, Groups, at(ts), NCons(pn(g), acc)), pr(g))

def group(r: Region, ts0: Nodes, out: Str): PR =
  val line = at(ts0)
  val open = text(head(ts0))
  val close = if eqs(open, "{") then "}" else if eqs(open, "[") then "]" else ">"
  var ts = tail(ts0)
  var xs = NNil
  while !isT(ts, close) do
    if eqs(open, "<") then
      val a = tterm(r, ts, "(")
      xs = NCons(pn(a), xs)
      ts = pr(a)
    else
      val n = needIdent(ts)
      val bl = at(ts)
      val t = tterm(r, expect(tail(ts), ":"), "[")
      xs = NCons(Node(Binder, n, "", 0, bl, one(r, pn(t))), xs)
      ts = pr(t)
    if !isT(ts, close) then ts = expect(ts, ",") else ()
  PR(Node(Group, open, out, 0, line, rev(r, xs)), tail(ts))

// T | T[args] | 3: a type (open = "[") or a Datalog atom p(args) (open = "(")
def tterm(r: Region, ts0: Nodes, open: Str): PR =
  val line = at(ts0)
  if isK(ts0, TInt) then PR(Node(TTerm, text(head(ts0)), "", 1, line, NNil), tail(ts0))
  else
    val f = needIdent(ts0)
    var ts = tail(ts0)
    var xs = NNil
    val close = if eqs(open, "[") then "]" else ")"
    if isT(ts, open) then
      ts = tail(ts)
      while !isT(ts, close) do
        val a = tterm(r, ts, open)
        xs = NCons(pn(a), xs)
        ts = pr(a)
        if !isT(ts, close) then ts = expect(ts, ",") else ()
      ts = tail(ts)
    else ()
    PR(Node(TTerm, f, "", 0, line, rev(r, xs)), ts)

def clauses(r: Region, ts0: Nodes): PR =
  var ts = expectK(ts0, TIndent, "indent")
  var cs = NNil
  while !isK(ts, TDedent) do
    val p = clause(r, ts)
    cs = NCons(pn(p), cs)
    ts = endLine(pr(p))
  PR(list(r, Names, at(ts0), rev(r, cs)), tail(ts))

def isClause(ts: Nodes): Bool =
  isT(ts, "requires") || isT(ts, "ensures") || isT(ts, "returns") || isT(ts, "decreases") || isT(ts, "invariant") || isT(ts, "proof")

// requires e | ensures e | returns e | decreases e | invariant e | proof using a, b | proof by induction x | proof lean "tactics"
def clause(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  val kw = text(head(ts0))
  if !isClause(ts0) then perr(ts0, "requires, ensures, returns, decreases, invariant or proof") else ()
  if eqs(kw, "proof") then
    val ts = tail(ts0)
    if isT(ts, "using") then
      var t = tail(ts)
      var xs = NNil
      xs = NCons(leaf(r, Name, needIdent(t), line), xs)
      t = tail(t)
      while isT(t, ",") do
        xs = NCons(leaf(r, Name, needIdent(tail(t)), line), xs)
        t = drop(t, 2)
      PR(Node(SClause, kw, "using", 0, line, rev(r, xs)), t)
    else if isT(ts, "by") then
      val t = expect(tail(ts), "induction")
      PR(Node(SClause, kw, "by", 0, line, one(r, leaf(r, Name, needIdent(t), line))), tail(t))
    else
      val t = expect(ts, "lean")
      if !isK(t, TStr) then perr(t, "a string of Lean tactics") else ()
      PR(Node(SClause, kw, "lean", 0, line, one(r, leaf(r, XStr, text(head(t)), line))), tail(t))
  else
    val e = expr(r, tail(ts0))
    PR(Node(SClause, kw, "", 0, line, one(r, pn(e))), pr(e))

def enumDecl(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  // `enum List [A: Type]:` [] binders; every case keeps them as its kid 1, so the case list stays the enum's kids
  val g = groups(r, tail(ts0), NNil)
  val gs = list(r, Groups, line, rev(r, kids(pn(g))))
  var ts = layoutOpen(pr(g))
  var cs = NNil
  var tag = 0
  while !isK(ts, TDedent) do
    ts = expect(ts, "case")
    val cl = at(ts)
    val cn = needIdent(ts)
    ts = tail(ts)
    var fs = list(r, Params, cl, NNil)
    if isT(ts, "(") then
      val p = params(r, ts)
      fs = pn(p)
      ts = pr(p)
    else ()
    cs = NCons(Node(DCase, cn, name, tag, cl, NCons(fs, one(r, gs))), cs)
    tag = tag + 1
    ts = endLine(ts)
  PR(Node(DEnum, name, "", 0, line, rev(r, cs)), tail(ts))

def protoDecl(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = layoutOpen(tail(ts0))
  var states = NNil
  var start = ""
  var ends = NNil
  var dropOp = ""
  var ops = NNil
  while !isK(ts, TDedent) do
    if isT(ts, "state") then
      val p = names(r, tail(ts))
      states = kids(pn(p))
      ts = pr(p)
    else if isT(ts, "start") then
      start = needIdent(tail(ts))
      ts = drop(ts, 2)
    else if isT(ts, "end") then
      val p = names(r, tail(ts))
      ends = kids(pn(p))
      ts = pr(p)
    else if isT(ts, "drop") then
      dropOp = needIdent(tail(ts))
      ts = drop(ts, 2)
    else if isT(ts, "op") then
      val p = opDecl(r, tail(ts))
      ops = NCons(pn(p), ops)
      ts = pr(p)
    else perr(ts, "protocol item")
    ts = endLine(ts)
  val parts = NCons(list(r, Names, line, states), NCons(list(r, Names, line, ends), NCons(leaf(r, Name, dropOp, line), one(r, list(r, Names, line, rev(r, ops))))))
  PR(Node(DProto, name, start, 0, line, parts), tail(ts))

def opDecl(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  val ps = params(r, tail(ts0))
  val rt = ty(r, expect(pr(ps), ":"))
  var ts = expect(pr(rt), ":")
  var tr = NNil
  var more = true
  while more do
    val f = needIdent(ts)
    ts = expect(expect(tail(ts), "-"), ">")
    tr = NCons(Node(DTrans, f, needIdent(ts), 0, line, NNil), tr)
    ts = tail(ts)
    if isT(ts, ",") then ts = tail(ts) else more = false
  PR(Node(DOp, name, "", 0, line, NCons(pn(ps), NCons(pn(rt), one(r, list(r, Names, line, rev(r, tr)))))), ts)

def names(r: Region, ts0: Nodes): PR =
  var ts = ts0
  var xs = one(r, leaf(r, Name, needIdent(ts), at(ts)))
  ts = tail(ts)
  while isT(ts, ",") do
    xs = NCons(leaf(r, Name, needIdent(tail(ts)), at(ts)), xs)
    ts = drop(ts, 2)
  PR(list(r, Names, at(ts0), rev(r, xs)), ts)

def handlerDecl(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = expect(tail(ts0), "for")
  val proto = needIdent(ts)
  ts = layoutOpen(tail(ts))
  var fs = NNil
  while !isK(ts, TDedent) do
    val p = fn(r, ts, 0)
    fs = NCons(pn(p), fs)
    ts = pr(p)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(Node(DHandler, name, proto, 0, line, rev(r, fs)), tail(ts))

def params(r: Region, ts0: Nodes): PR =
  var ts = expect(ts0, "(")
  var ps = NNil
  while !isT(ts, ")") do
    val n = needIdent(ts)
    val pl = at(ts)
    val t = ty(r, expect(tail(ts), ":"))
    ps = NCons(Node(Param, n, "", 0, pl, one(r, pn(t))), ps)
    ts = pr(t)
    if !isT(ts, ")") then ts = expect(ts, ",") else ()
  PR(list(r, Params, at(ts0), rev(r, ps)), tail(ts))

def ty(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  val name = needIdent(ts0)
  var ts = tail(ts0)
  var from = ""
  var to = ""
  // type application T[args] (vic 2026-11-05: [] = types, the Scala3 surface): the args are the kids of TyTo, so tyCaps stays the tail
  var args = NNil
  // protocol state File[S1 ~> S2], told apart by the ~> after one name; dropped in BD5 for <> facts (vic-9l7.8)
  if isT(ts, "[") && isT(drop(ts, 2), "~>") then
    from = needIdent(tail(ts))
    to = needIdent(drop(ts, 3))
    ts = expect(drop(ts, 4), "]")
  else if isT(ts, "[") then
    ts = tail(ts)
    while !isT(ts, "]") do
      val a = ty(r, ts)
      args = NCons(pn(a), args)
      ts = pr(a)
      if !isT(ts, "]") then ts = expect(ts, ",") else ()
    ts = tail(ts)
  else ()
  var caps = NNil
  var annotated = 0
  // caps T^<r, q>: the regions a value lives in are facts (vic 2026-11-05)
  if isT(ts, "^") then
    annotated = 1
    ts = expect(tail(ts), "<")
    while !isT(ts, ">") do
      caps = NCons(leaf(r, TyCap, needIdent(ts), line), caps)
      ts = tail(ts)
      if !isT(ts, ">") then ts = expect(ts, ",") else ()
    ts = tail(ts)
  else ()
  PR(Node(Ty, name, from, annotated, line, NCons(Node(TyTo, to, "", 0, line, rev(r, args)), rev(r, caps))), ts)

def rhs(r: Region, ts: Nodes): PR =
  if isK(ts, TNl) && isK(tail(ts), TIndent) then block(r, tail(ts)) else expr(r, ts)

def block(r: Region, ts0: Nodes): PR =
  var ts = expectK(ts0, TIndent, "indent")
  var ss = NNil
  while !isK(ts, TDedent) do
    val p = stmt(r, ts)
    ss = NCons(pn(p), ss)
    ts = pr(p)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(list(r, XBlock, at(ts0), rev(r, ss)), tail(ts))

def stmt(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  if isT(ts0, "val") || isT(ts0, "var") then
    val mut = if isT(ts0, "var") then 1 else 0
    val name = needIdent(tail(ts0))
    var ts = drop(ts0, 2)
    var tyk = NNil
    if isT(ts, ":") then
      val t = ty(r, tail(ts))
      tyk = one(r, pn(t))
      ts = pr(t)
    else ()
    val e = rhs(r, expect(ts, "="))
    PR(Node(SVal, name, "", mut, line, NCons(pn(e), tyk)), pr(e))
  else if isT(ts0, "invariant") || isT(ts0, "decreases") then clause(r, ts0)
  else if isT(ts0, "handle") then
    val name = needIdent(tail(ts0))
    val ts = expect(drop(ts0, 2), "=")
    val a = args(r, tail(ts))
    PR(Node(SHandle, name, needIdent(ts), 0, line, kids(pn(a))), pr(a))
  else expr(r, ts0)

def args(r: Region, ts0: Nodes): PR =
  var ts = expect(ts0, "(")
  var xs = NNil
  while !isT(ts, ")") do
    val e = expr(r, ts)
    xs = NCons(pn(e), xs)
    ts = pr(e)
    if !isT(ts, ")") then ts = expect(ts, ",") else ()
  PR(list(r, Names, at(ts0), rev(r, xs)), tail(ts))

def expr(r: Region, ts0: Nodes): PR =
  val line = at(ts0)
  if isT(ts0, "if") then
    val c = expr(r, tail(ts0))
    val t = rhs(r, expect(pr(c), "then"))
    var ts = pr(t)
    if isK(ts, TNl) && isT(tail(ts), "else") then ts = tail(ts) else ()
    val e = rhs(r, expect(ts, "else"))
    PR(Node(XIf, "", "", 0, line, NCons(pn(c), NCons(pn(t), one(r, pn(e))))), pr(e))
  else if isT(ts0, "forall") || isT(ts0, "exists") then
    val x = needIdent(tail(ts0))
    val t = ty(r, expect(drop(ts0, 2), ":"))
    val b = expr(r, expect(pr(t), "=>"))
    PR(Node(if isT(ts0, "forall") then XForall else XExists, x, "", 0, line, NCons(pn(t), one(r, pn(b)))), pr(b))
  else if isT(ts0, "while") then
    val c = expr(r, tail(ts0))
    val b = rhs(r, expect(pr(c), "do"))
    PR(Node(XWhile, "", "", 0, line, NCons(pn(c), one(r, pn(b)))), pr(b))
  else if isK(ts0, TIdent) && isK(tail(ts0), TOp) && eqs(text(head(tail(ts0))), "=") then
    val e = rhs(r, drop(ts0, 2))
    PR(Node(XAssign, text(head(ts0)), "", 0, line, one(r, pn(e))), pr(e))
  else
    val b = binary(r, ts0, 0)
    if isT(pr(b), "match") then arms(r, pn(b), tail(pr(b))) else b

def arms(r: Region, scrut: Node, ts0: Nodes): PR =
  var ts = expectK(expectK(ts0, TNl, "newline"), TIndent, "indent")
  var xs = NNil
  while !isK(ts, TDedent) do
    val al = at(ts)
    ts = expect(ts, "case")
    var ctor = "_"
    var binds = NNil
    if isT(ts, "_") then ts = tail(ts)
    else
      ctor = needIdent(ts)
      ts = tail(ts)
      if isT(ts, "(") then
        ts = tail(ts)
        while !isT(ts, ")") do
          binds = NCons(leaf(r, XName, needIdent(ts), al), binds)
          ts = tail(ts)
          if !isT(ts, ")") then ts = expect(ts, ",") else ()
        ts = tail(ts)
      else ()
    val b = rhs(r, expect(ts, "=>"))
    xs = NCons(Node(XArm, ctor, "", 0, al, NCons(pn(b), rev(r, binds))), xs)
    ts = pr(b)
    if isK(ts, TNl) then ts = tail(ts) else ()
  PR(Node(XMatch, "", "", 0, lineOf(scrut), NCons(scrut, rev(r, xs))), tail(ts))

def opLevel(s: Str): I64 =
  if eqs(s, "||") then 0 else if eqs(s, "&&") then 1
  else if eqs(s, "==") || eqs(s, "!=") then 2
  else if eqs(s, "<") || eqs(s, "<=") || eqs(s, ">") || eqs(s, ">=") then 3
  else if eqs(s, "+") || eqs(s, "-") then 4
  else if eqs(s, "*") || eqs(s, "/") || eqs(s, "%") then 5
  else -1

def binary(r: Region, ts0: Nodes, lvl: I64): PR =
  if lvl == 6 then unary(r, ts0)
  else
    var p = binary(r, ts0, lvl + 1)
    while isK(pr(p), TOp) && opLevel(text(head(pr(p)))) == lvl do
      val op = head(pr(p))
      val q = binary(r, tail(pr(p)), lvl + 1)
      p = PR(Node(XBin, text(op), "", 0, lineOf(op), NCons(pn(p), one(r, pn(q)))), pr(q))
    p

def unary(r: Region, ts: Nodes): PR =
  if isT(ts, "-") || isT(ts, "!") then
    val e = unary(r, tail(ts))
    PR(Node(XUn, text(head(ts)), "", 0, at(ts), one(r, pn(e))), pr(e))
  else primary(r, ts)

def parseInt(s: Str): I64 =
  var v = 0
  var i = 0
  while i < rt_str_len(s) do
    v = v * 10 + rt_str_at(s, i) - '0'
    i = i + 1
  v

def charValue(ts: Nodes): I64 =
  val s = text(head(ts))
  if rt_str_len(s) == 1 then rt_str_at(s, 0)
  else
    val c = rt_str_at(s, 1)
    if c == 'n' then '\n' else if c == 't' then '\t' else if c == 'r' then '\r' else if c == '0' then 0
    else if c == '\\' || c == '\'' || c == '"' then c
    else
      perr(ts, "char escape")
      0

def primary(r: Region, ts: Nodes): PR =
  val t = head(ts)
  val line = lineOf(t)
  val k = kind(t)
  if k == TInt then PR(Node(XInt, "", "", parseInt(text(t)), line, NNil), tail(ts))
  else if k == TStr then PR(leaf(r, XStr, text(t), line), tail(ts))
  else if k == TChar then PR(Node(XInt, "", "", charValue(ts), line, NNil), tail(ts))
  else if k == TIdent then
    val s = text(t)
    if eqs(s, "true") then PR(Node(XBool, "", "", 1, line, NNil), tail(ts))
    else if eqs(s, "false") then PR(Node(XBool, "", "", 0, line, NNil), tail(ts))
    else if isT(tail(ts), "(") then
      val a = args(r, tail(ts))
      PR(Node(XCall, s, "", 0, line, kids(pn(a))), pr(a))
    else if isT(tail(ts), ".") then
      val a = args(r, drop(ts, 3))
      PR(Node(XMethod, s, needIdent(drop(ts, 2)), 0, line, kids(pn(a))), pr(a))
    else PR(leaf(r, XName, s, line), tail(ts))
  else if isT(ts, "(") then
    if isT(tail(ts), ")") then PR(leaf(r, XUnit, "", line), drop(ts, 2))
    else
      val e = expr(r, tail(ts))
      PR(pn(e), expect(pr(e), ")"))
  else
    perr(ts, "expression")
    PR(NoNode, ts)
