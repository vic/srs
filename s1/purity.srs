// vic-u2d U1b: which fns have effects (vic 2026-11-05: pure = no effects), a Datalog program over the source bodies.
// a protocol is effect-free when every fn of each of its handlers is pure (vic Q-U5: "from handler bodies.")

def purAtom1 {r: Region} (rel: Str, a: I64): Atom = Atom(rel, ArgCons(AVar(a), ArgNil))
def purAtom2 {r: Region} (rel: Str, a: I64, b: I64): Atom = Atom(rel, ArgCons(AVar(a), ArgCons(AVar(b), ArgNil)))
def purRule1 {r: Region} (h: Atom, b: Atom): Clause = Clause(h, LitCons(Pos(b), LitNil))
def purRule2 {r: Region} (h: Atom, b1: Atom, b2: Atom): Clause = Clause(h, LitCons(Pos(b1), LitCons(Pos(b2), LitNil)))

// impure(F) :- direct(F) | calls(F, G), impure(G) | uses(F, P), effectful(P)
// effectful(P) :- handles(H, P), impureH(H)
// impureH(H) :- hdirect(H) | hcalls(H, G), impure(G) | huses(H, P), effectful(P)
def purityRules {r: Region} (): Clauses =
  var cs = ClCons(purRule1(purAtom1("impure", 0), purAtom1("direct", 0)), ClNil)
  cs = ClCons(purRule2(purAtom1("impure", 0), purAtom1("impure", 1), purAtom2("calls", 0, 1)), cs)
  cs = ClCons(purRule2(purAtom1("impure", 0), purAtom1("effectful", 1), purAtom2("uses", 0, 1)), cs)
  cs = ClCons(purRule2(purAtom1("effectful", 0), purAtom1("impureH", 1), purAtom2("handles", 1, 0)), cs)
  cs = ClCons(purRule1(purAtom1("impureH", 0), purAtom1("hdirect", 0)), cs)
  cs = ClCons(purRule2(purAtom1("impureH", 0), purAtom1("impure", 1), purAtom2("hcalls", 0, 1)), cs)
  ClCons(purRule2(purAtom1("impureH", 0), purAtom1("effectful", 1), purAtom2("huses", 0, 1)), cs)

def purFact1 {r: Region} (rel: Str, a: Str, edb: Edb): Edb = EdbCons(Fact(rel, ValCons(VSym(a), ValNil)), edb)
def purFact2 {r: Region} (rel: Str, a: Str, b: Str, edb: Edb): Edb = EdbCons(Fact(rel, ValCons(VSym(a), ValCons(VSym(b), ValNil))), edb)

// the binders of f's {} groups (kid 4)
def curlyBinders {r: Region} (f: Node): Nodes =
  var out = NNil
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "{") then out = append(kids(head(gs)), out) else ()
    gs = tail(gs)
  out

// the facts of expr x in fn who (hd: who is a handler): calls, handles, method calls on trait evidence ev
def bodyFacts {r: Region} (ds: Nodes, hd: Bool, who: Str, ev: Nodes, x: Node, edb0: Edb): Edb =
  val k = kind(x)
  var edb = edb0
  if k == XCall || k == XCallG then edb = purFact2(if hd then "hcalls" else "calls", who, text(x), edb) else ()
  if k == SHandle then edb = purFact2(if hd then "huses" else "uses", who, text2(find(ds, DHandler, text2(x))), edb) else ()
  // the given that answers trait evidence is not known before mono: a direct effect
  if k == XMethod && has(ev, text(x)) then edb = purFact1(if hd then "hdirect" else "direct", who, edb) else ()
  var c = kids(x)
  while !isNil(c) do
    edb = bodyFacts(ds, hd, who, ev, head(c), edb)
    c = tail(c)
  edb

// the facts of fn f, named who: an extern not in the pure set is a direct effect; a {} cap binder uses its protocol
def fnFacts {r: Region} (ds: Nodes, hd: Bool, who: Str, f: Node, edb0: Edb): Edb =
  var edb = edb0
  if num(f) == 1 && !isPureExtern(text(f)) then edb = purFact1("direct", who, edb) else ()
  var ev = NNil
  var c = curlyBinders(f)
  while !isNil(c) do
    val p = text(kid(head(c), 0))
    if isProto(ds, p) then edb = purFact2(if hd then "huses" else "uses", who, p, edb) else ev = NCons(head(c), ev)
    c = tail(c)
  if num(f) == 1 then edb else bodyFacts(ds, hd, who, ev, kid(f, 2), edb)

def purityFacts {r: Region} (ds: Nodes): Edb =
  var edb = EdbNil
  var c = ds
  while !isNil(c) do
    val d = head(c)
    if kind(d) == DFn then edb = fnFacts(ds, false, text(d), d, edb) else ()
    if kind(d) == DHandler then
      edb = purFact2("handles", text(d), text2(d), edb)
      var fs = kids(d)
      while !isNil(fs) do
        edb = fnFacts(ds, true, text(d), head(fs), edb)
        fs = tail(fs)
    else ()
    c = tail(c)
  edb

def impureOf {r: Region} (db: Facts): Nodes = db match
  case FactNil => NNil
  case FactCons(h, _, t) => h match
    case Fact(rel, vs) => vs match
      case ValCons(v, _) => if eqs(rel, "impure") then NCons(Node(Name, symOf(v), "", 0, 0, NNil), impureOf(t)) else impureOf(t)
      case ValNil => impureOf(t)

// the marker decl %impure (no srs name has a %): the fns with effects; check() prepends it to the decls it passes down
def impureDecl {r: Region} (ds: Nodes): Node = evalDatalog(purityRules(), purityFacts(ds)) match
  case Model(db) => Node(Names, "%impure", "", 0, 0, impureOf(db))
  case Unsafe(p) =>
    err("internal: unsafe purity rule", p, 0)
    NoNode
  case NegCycle(p) =>
    err("internal: negation in purity rules", p, 0)
    NoNode

def isImpure(ds: Nodes, n: Str): Bool =
  val m = find(ds, Names, "%impure")
  if !found(m) then err("internal: no purity facts for", n, 0) else ()
  has(kids(m), n)
