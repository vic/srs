// S1 lexer: tokens + layout (TNl / TIndent / TDedent), same rules as s0/lex.zig.

def isAlpha(c: I64): Bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
def isDigit(c: I64): Bool = c >= '0' && c <= '9'
def isPunct(c: I64): Bool =
  c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' || c == ',' || c == ':' || c == '=' || c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '<' || c == '>' || c == '!' || c == '.' || c == '^' || c == '@'
def isTwo(a: I64, b: I64): Bool =
  (a == '=' && b == '>') || (a == '=' && b == '=') || (a == '!' && b == '=') || (a == '<' && b == '=') || (a == '>' && b == '=') || (a == '&' && b == '&') || (a == '|' && b == '|') || (a == '~' && b == '>')

def tok {r: Region} (k: Kind, s: Str, line: I64): Node = Node(k, s, "", 0, line, NNil)

// last token is a layout token (no TNl needed after it)
def layoutLast(out: Nodes): Bool =
  if isNil(out) then true
  else
    val k = kind(head(out))
    k == TNl || k == TIndent || k == TDedent

def lex {r: Region} (src: Str): Nodes =
  var out = NNil
  var ind = one(Node(TInt, "", "", 0, 0, NNil))
  var i = 0
  var line = 1
  var depth = 0
  var bol = true
  val n = rt_str_len(src)
  while i < n do
    if bol && depth == 0 then
      var col = 0
      while rt_str_at(src, i) == ' ' do
        col = col + 1
        i = i + 1
      val c = rt_str_at(src, i)
      if c == '\t' then fatal("tab in indentation", line) else ()
      val blank = c == -1 || c == '\n' || (c == '/' && rt_str_at(src, i + 1) == '/')
      bol = false
      if !blank then
        if col > num(head(ind)) then
          ind = NCons(Node(TInt, "", "", col, line, NNil), ind)
          out = NCons(tok(TIndent, "", line), out)
        else
          while col < num(head(ind)) do
            ind = tail(ind)
            out = NCons(tok(TDedent, "", line), out)
          if col != num(head(ind)) then fatal("bad dedent", line) else ()
      else ()
    else
      val c = rt_str_at(src, i)
      if c == '\n' then
        if depth == 0 && !layoutLast(out) then out = NCons(tok(TNl, "", line), out) else ()
        line = line + 1
        i = i + 1
        bol = true
      else if c == ' ' || c == '\r' then i = i + 1
      else if c == '/' && rt_str_at(src, i + 1) == '/' then
        while i < n && rt_str_at(src, i) != '\n' do i = i + 1
      else if isAlpha(c) then
        val b = i
        while isAlpha(rt_str_at(src, i)) || isDigit(rt_str_at(src, i)) do i = i + 1
        // a module member is one symbol, the `.` part of it (vic 2026-11-06): Upper.name, Upper.Upper.name, ...
        if c >= 'A' && c <= 'Z' then
          while rt_str_at(src, i) == '.' && isAlpha(rt_str_at(src, i + 1)) do
            i = i + 1
            while isAlpha(rt_str_at(src, i)) || isDigit(rt_str_at(src, i)) do i = i + 1
        else ()
        out = NCons(tok(TIdent, rt_str_slice(src, b, i), line), out)
      else if isDigit(c) then
        val b = i
        while isDigit(rt_str_at(src, i)) do i = i + 1
        out = NCons(tok(TInt, rt_str_slice(src, b, i), line), out)
      else if c == '"' || c == '\'' then
        i = i + 1
        val b = i
        while i < n && rt_str_at(src, i) != c && rt_str_at(src, i) != '\n' do
          if rt_str_at(src, i) == '\\' then i = i + 2 else i = i + 1
        if rt_str_at(src, i) != c then fatal("unterminated literal", line) else ()
        out = NCons(tok(if c == '"' then TStr else TChar, rt_str_slice(src, b, i), line), out)
        i = i + 1
      else
        val w = if isTwo(c, rt_str_at(src, i + 1)) then 2 else 1
        if w == 1 && !isPunct(c) then fatal("bad character", line) else ()
        if c == '(' || c == '[' then depth = depth + 1 else ()
        if (c == ')' || c == ']') && depth > 0 then depth = depth - 1 else ()
        out = NCons(tok(TOp, rt_str_slice(src, i, i + w), line), out)
        i = i + w
  if !isNil(out) && kind(head(out)) != TNl && kind(head(out)) != TDedent then out = NCons(tok(TNl, "", line), out) else ()
  while num(head(ind)) > 0 do
    ind = tail(ind)
    out = NCons(tok(TDedent, "", line), out)
  rev(NCons(tok(TEof, "", line), out))
