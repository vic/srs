// S1 checker: types + flow-typed effects (vic/c/effects.md, fx-rs#20).
// Judgment Γ1 ⊢ e : T ⊣ Γ2. Γ = GState(s = cap, t = state) + GVar(s = var, a = caps) list, innermost first.
// env = BVar(s = name, t = protocol or "", n = 0 val / 1 var / 2 cap, a = [Ty]); var Ty = bound, n 0 = none.
// Ty a = [TyTo, TyCap...]: value caps = regions the value lives in.
// "*" = the caller's capture variable ρ of a signature: never in Γ, always live.

enum TG:
  case TG(ty: Node, gam: Nodes, e2: Node)

def tgTy(x: TG): Node = x match
  case TG(t, _, _) => t
def tgGam(x: TG): Nodes = x match
  case TG(_, g, _) => g
// the expansion: e as the emitter takes it (Turnstile e >> e2, vic/c/binders-design.md)
def tgE(x: TG): Node = x match
  case TG(_, _, e) => e

// e with new kids, every other field kept
def withKids {r: Region} (e: Node, ks: Nodes): Node = e match
  case Node(k, s, t, n, l, _) => Node(k, s, t, n, l, ks)
  case NoNode => NoNode

def eprintErr(what: Str, name: Str, line: I64): Unit =
  rt_eprint("srs:")
  rt_eprint_i64(line)
  rt_eprint(": error: ")
  rt_eprint(what)
  rt_eprint(" '")
  rt_eprint(name)
  rt_eprint("'\n")

def err(what: Str, name: Str, line: I64): Unit =
  eprintErr(what, name, line)
  rt_exit(1)

// an error as data (vic-ngq): the ill-typed expr e stays in e2 as a mark over its checked sub-exprs xs; its type is
// the hole, consistent with every type (Zhao et al. POPL 2024, Thm 2.3: ill-typed iff at least one mark)
def illTyped {r: Region} (gam: Nodes, what: Str, name: Str, e: Node, xs: Nodes): TG =
  TG(Node(TyHole, "", "", 0, lineOf(e), NNil), gam, Node(XIllTyped, what, name, 0, lineOf(e), xs))

// every mark in the checked decls, in source order: main reports them all and rejects the program
def illTypedIn {r: Region} (xs: Nodes): Nodes = rev(illTypedAcc(xs, NNil))
def illTypedAcc {r: Region} (xs: Nodes, acc0: Nodes): Nodes =
  var acc = acc0
  var c = xs
  while !isNil(c) do
    val k = kind(head(c))
    if k == XIllTyped then acc = NCons(head(c), acc) else ()
    // a mark is an expr (only chk makes one): types, params, groups and names hold none
    if k != Ty && k != Params && k != Groups && k != Names then acc = illTypedAcc(kids(head(c)), acc) else ()
    c = tail(c)
  acc

def tyCaps(t: Node): Nodes
  ensures result == tailS(kidsS(t))
= tail(kids(t))
def tyTo(t: Node): Str = text(head(kids(t)))
def mkTy {r: Region} (name: Str, caps: Nodes): Node = Node(Ty, name, "", 1, 0, NCons(leaf(TyTo, "", 0), caps))
def prim {r: Region} (name: Str): Node = mkTy(name, NNil)
// the args of T[args]
def tyArgs(t: Node): Nodes = kids(head(kids(t)))
// t with new caps: name and type args kept
def recap {r: Region} (t: Node, caps: Nodes): Node = Node(Ty, text(t), "", 1, 0, NCons(Node(TyTo, "", "", 0, 0, tyArgs(t)), caps))
// one type: same name, same type args (caps are checked apart); the hole is consistent with every type (POPL 2024)
def tyEq(a: Node, b: Node): Bool = eqs(text(a), text(b)) && tysEq(tyArgs(a), tyArgs(b)) || kind(a) == TyHole || kind(b) == TyHole
def tysEq(a: Nodes, b: Nodes): Bool =
  if isNil(a) || isNil(b) then isNil(a) && isNil(b) else tyEq(head(a), head(b)) && tysEq(tail(a), tail(b))
def eprintTy(t: Node): Unit =
  rt_eprint(text(t))
  if !isNil(tyArgs(t)) then
    rt_eprint("[")
    var c = tyArgs(t)
    while !isNil(c) do
      eprintTy(head(c))
      if !isNil(tail(c)) then rt_eprint(", ") else ()
      c = tail(c)
    rt_eprint("]")
  else ()

// the binders of the [] groups of gs (type ascriptions, vic 2026-11-05)
def groupBinders {r: Region} (gs: Nodes): Nodes =
  var out = NNil
  var c = gs
  while !isNil(c) do
    if kind(head(c)) == Group && eqs(text(head(c)), "[") then out = append(out, kids(head(c))) else ()
    c = tail(c)
  out
// [] binders of enum n: kept on each of its cases (kid 1)
def enumTParams {r: Region} (ds: Decls, n: Str): Nodes = groupBinders(kids(kid(head(kids(findDecl(ds, DEnum, n))), 1)))
def enumArity(ds: Decls, n: Str): I64 =
  var k = 0
  var c = kids(kid(head(kids(findDecl(ds, DEnum, n))), 1))
  while !isNil(c) do
    if kind(head(c)) == Group && eqs(text(head(c)), "[") then k = k + len(kids(head(c))) else ()
    c = tail(c)
  k

def isBuiltin(n: Str): Bool = eqs(n, "I64") || eqs(n, "Bool") || eqs(n, "Unit") || eqs(n, "Str") || eqs(n, "Ptr")
def isEnum(ds: Decls, n: Str): Bool = found(findDecl(ds, DEnum, n))
def isProto(ds: Decls, n: Str): Bool = found(findDecl(ds, DProto, n))
// a [] binder in scope: checkSig and checkFn put the fn's binders in front of ds
def isTParam(ds: Decls, n: Str): Bool = found(findDecl(ds, Binder, n))

// a, then each node of b whose text is not yet in, in b's order (onto the front)
spec def unionS(a: Nodes, b: Nodes): Nodes
  ensures forall s: Str => memS(s, result) == (memS(s, a) || memS(s, b))
  proof by induction b
= b match
  case NNil => a
  case NCons(h, t) => unionS(if memS(textS(h), a) then a else NCons(h, a), t)
def union {r: Region} (a: Nodes, b: Nodes): Nodes
  ensures result == unionS(a, b)
=
  var out = a
  var c = b
  while !isNil(c) do
    invariant unionS(out, c) == unionS(a, b)
    decreases sizeS(c)
    if !has(out, text(head(c))) then out = NCons(head(c), out) else ()
    c = tail(c)
  out
// spec: every text of a is a text of b
spec def allIn(a: Nodes, b: Nodes): Bool = a match
  case NNil => true
  case NCons(h, t) => memS(textS(h), b) && allIn(t, b)

def subset(a: Nodes, b: Nodes): Bool
  ensures result == allIn(a, b)
=
  var c = a
  var ok = true
  while ok && !isNil(c) do
    invariant (ok && allIn(c, b)) == allIn(a, b)
    decreases sizeS(c)
    ok = has(b, text(head(c)))
    c = tail(c)
  ok

def state(gam: Nodes, cap: Str): Str
  ensures result == text2S(lookS(gam, GState, cap))
= text2(find(gam, GState, cap))
// replace the innermost Γ entry of x's kind and name by x
spec def replS(xs: Nodes, x: Node): Nodes = xs match
  case NNil => NNil
  case NCons(h, t) => if kindS(h) == kindS(x) && rt_str_eq(textS(h), textS(x)) then NCons(x, t) else NCons(h, replS(t, x))
def setG {r: Region} (gam: Nodes, x: Node): Nodes
  ensures result == replS(gam, x)
=
  var out = NNil
  var c = gam
  var done = false
  while !isNil(c) do
    invariant revOnto(out, if done then c else replS(c, x)) == replS(gam, x)
    decreases sizeS(c)
    if !done && kind(head(c)) == kind(x) && eqs(text(head(c)), text(x)) then
      out = NCons(x, out)
      done = true
    else out = NCons(head(c), out)
    c = tail(c)
  rev(out)
// spec: the cap states (text2) of a and b agree entry by entry
spec def agreeS(a: Nodes, b: Nodes): Bool = a match
  case NNil => true
  case NCons(h, t) => rt_str_eq(text2S(h), text2S(headS(b))) && agreeS(t, tailS(b))
// spec: entry by entry, a's entry with the caps of both entries
spec def joinS(a: Nodes, b: Nodes): Nodes = a match
  case NNil => NNil
  case NCons(h, t) => NCons(Node(kindS(h), textS(h), text2S(h), 0, 0, unionS(kidsS(h), kidsS(headS(b)))), joinS(t, tailS(b)))
// Γ of two paths from one Γ (same entries, same order): var caps join by union (C8), cap states must agree
// accepts only when the states agree
def joinGam {r: Region} (a: Nodes, b: Nodes, what: Str, line: I64): Nodes
  returns agreeS(a, b) && result == joinS(a, b)
=
  var out = NNil
  var x = a
  var y = b
  while !isNil(x) do
    invariant agreeS(a, b) == agreeS(x, y) && joinS(a, b) == revOnto(out, joinS(x, y))
    decreases sizeS(x)
    if !eqs(text2(head(x)), text2(head(y))) then err(what, text(head(x)), line) else ()
    out = NCons(Node(kind(head(x)), text(head(x)), text2(head(x)), 0, 0, union(kids(head(x)), kids(head(y)))), out)
    x = tail(x)
    y = tail(y)
  rev(out)
// every var of a has caps within the same var of b
spec def withinS(a: Nodes, b: Nodes): Bool = a match
  case NNil => true
  case NCons(h, t) => allIn(kidsS(h), kidsS(headS(b))) && withinS(t, tailS(b))
def within(a: Nodes, b: Nodes): Bool
  ensures result == withinS(a, b)
=
  var x = a
  var y = b
  var ok = true
  while ok && !isNil(x) do
    invariant (ok && withinS(x, y)) == withinS(a, b)
    decreases sizeS(x)
    ok = subset(kids(head(x)), kids(head(y)))
    x = tail(x)
    y = tail(y)
  ok

def protoEnds(ds: Nodes, p: Str): Nodes
  ensures result == kidsS(nthS(kidsS(lookS(ds, DProto, p)), 1))
= kids(kid(find(ds, DProto, p), 1))
def protoStates(ds: Nodes, p: Str): Nodes = kids(kid(find(ds, DProto, p), 0))

// capture c is live: not a tracked cap (ρ), or its state is not an end state
spec def liveS(ds: Nodes, env: Nodes, gam: Nodes, c: Str): Bool =
  if !foundS(lookS(env, BVar, c)) || numS(lookS(env, BVar, c)) != 2 then true
  else !memS(text2S(lookS(gam, GState, c)), kidsS(nthS(kidsS(lookS(ds, DProto, text2S(lookS(env, BVar, c)))), 1)))
def live(ds: Nodes, env: Nodes, gam: Nodes, c: Str): Bool
  ensures result == liveS(ds, env, gam, c)
=
  val b = find(env, BVar, c)
  if !found(b) || num(b) != 2 then true
  else !has(protoEnds(ds, text2(b)), state(gam, c))
spec def allLiveS(ds: Nodes, env: Nodes, gam: Nodes, xs: Nodes): Bool = xs match
  case NNil => true
  case NCons(h, t) => liveS(ds, env, gam, textS(h)) && allLiveS(ds, env, gam, t)
// accepts (returns) only when every capture of t is live, else the run stops
def needLive(ds: Nodes, env: Nodes, gam: Nodes, t: Node, line: I64): Unit
  returns allLiveS(ds, env, gam, tailS(kidsS(t)))
=
  var c = tyCaps(t)
  while !isNil(c) do
    invariant allLiveS(ds, env, gam, tailS(kidsS(t))) == allLiveS(ds, env, gam, c)
    decreases sizeS(c)
    if !live(ds, env, gam, text(head(c))) then err("use of value after its region ended:", text(head(c)), line) else ()
    c = tail(c)

// annotation w/o caps = no cap bound: caps stay inferred from t (R2 Q2)
def bound {r: Region} (ann: Node, t: Node): Node = if num(ann) == 0 then recap(ann, tyCaps(t)) else ann
def uncapped {r: Region} (name: Str): Node = Node(Ty, name, "", 0, 0, one(leaf(TyTo, "", 0)))
// t with no caps and no annotation: a var's type, its caps are flow state
def uncap {r: Region} (t: Node): Node = Node(Ty, text(t), "", 0, 0, one(Node(TyTo, "", "", 0, 0, tyArgs(t))))

def assignable(a: Node, b: Node): Bool = tyEq(a, b) && subset(tyCaps(a), tyCaps(b))
// facts on a type (vic-jxk): each cap of t that names a state (TyCap t) must be in that state in Γ now
def needStates(gam: Nodes, t: Node, line: I64): Unit =
  var c = tyCaps(t)
  while !isNil(c) do
    val want = text2(head(c))
    if rt_str_len(want) > 0 && !eqs(state(gam, text(head(c))), want) then
      rt_eprint("srs:")
      rt_eprint_i64(line)
      rt_eprint(": error: value needs '")
      rt_eprint(text(head(c)))
      rt_eprint("' in state ")
      rt_eprint(want)
      rt_eprint(", it is ")
      rt_eprint(state(gam, text(head(c))))
      rt_eprint("\n")
      rt_exit(1)
    else ()
    c = tail(c)

// a value of type a can stand where type b is expected only if it carries every fact of b (same cap, same state)
def needCarried(a: Node, b: Node, line: I64): Unit =
  var c = tyCaps(b)
  while !isNil(c) do
    if rt_str_len(text2(head(c))) > 0 && !hasState(tyCaps(a), text(head(c)), text2(head(c))) then err("value does not carry the fact of its type: state of", text(head(c)), line) else ()
    c = tail(c)

def hasState(cs: Nodes, cap: Str, s: Str): Bool =
  var res = false
  var c = cs
  while !res && !isNil(c) do
    res = eqs(text(head(c)), cap) && eqs(text2(head(c)), s)
    c = tail(c)
  res

def needAssign(a: Node, b: Node, line: I64): Unit =
  if !tyEq(a, b) then
    rt_eprint("srs:")
    rt_eprint_i64(line)
    rt_eprint(": error: type mismatch: ")
    eprintTy(a)
    rt_eprint(" is not ")
    eprintTy(b)
    rt_eprint("\n")
    rt_exit(1)
  else if !subset(tyCaps(a), tyCaps(b)) then err("value escapes its region, expected type", text(b), line)
  else needCarried(a, b, line)

def needTy(ds: Decls, t: Node): Unit =
  val n = text(t)
  if !isBuiltin(n) && !isEnum(ds, n) && !isProto(ds, n) && !isTParam(ds, n) then err("unknown type", n, lineOf(t)) else ()
  // T[args]: as many args as T has [] binders (only an enum has any), each a type
  val arity = if isEnum(ds, n) then enumArity(ds, n) else 0
  if len(tyArgs(t)) != arity then err("wrong number of type args for", n, lineOf(t)) else ()
  var c = tyArgs(t)
  while !isNil(c) do
    needTy(ds, head(c))
    c = tail(c)
  if isProto(ds, n) then
    val st = protoStates(declList(ds), n)
    if rt_str_len(text2(t)) > 0 && (!has(st, text2(t)) || !has(st, tyTo(t))) then err("unknown protocol state in", n, lineOf(t)) else ()
  else ()

// region (cap) params of a signature
def regionParams {r: Region} (ps: Nodes): Nodes =
  var out = NNil
  var c = ps
  while !isNil(c) do
    if eqs(text(kid(head(c), 0)), "Region") then out = NCons(leaf(TyCap, text(head(c)), 0), out) else ()
    c = tail(c)
  out

// signature type as seen in the body: unannotated enum = region params + ρ
def sigTy {r: Region} (ds: Decls, ps: Nodes, t: Node): Node =
  if (isEnum(ds, text(t)) || isTParam(ds, text(t))) && num(t) == 0 then recap(t, NCons(leaf(TyCap, "*", 0), regionParams(ps)))
  else t

// one name, one meaning (vic-gkz): fns and enum cases share the call namespace, enums/protocols/traits/handlers the
// type namespace; a second decl of a name would silently lose to the first (find takes the first)
def uniqueNames {r: Region} (ds: Nodes): Unit =
  var vals = NNil
  var tys = NNil
  var c = ds
  while !isNil(c) do
    val d = head(c)
    val k = kind(d)
    if k == DFn then
      if has(vals, text(d)) then err("duplicate name:", text(d), lineOf(d)) else ()
      vals = NCons(d, vals)
    else ()
    if k == DEnum || k == DProto || k == DTrait || k == DHandler || k == DType then
      if has(tys, text(d)) then err("duplicate type name:", text(d), lineOf(d)) else ()
      tys = NCons(d, tys)
    else ()
    if k == DEnum then
      var cs = kids(d)
      while !isNil(cs) do
        if has(vals, text(head(cs))) then err("duplicate name:", text(head(cs)), lineOf(head(cs))) else ()
        vals = NCons(head(cs), vals)
        cs = tail(cs)
    else ()
    c = tail(c)

// the program checked: decls with fn bodies expanded (e2), for the C emitter
def check {r: Region} (ds0: Nodes): Nodes =
  // type lambdas applied, match types reduced (s1/types.srs)
  val ds1 = expandTypes(mkDecls(ds0))
  uniqueNames(ds1)
  // the decls passed down carry the fns with effects (s1/purity.srs), not the output
  val dd = mkDecls(ds1)
  val ds = declsCons(impureDecl(dd), dd)
  var c = ds1
  var out = NNil
  while !isNil(c) do
    val d = head(c)
    if kind(d) == DFn then checkSig(ds, d) else ()
    if kind(d) == DEnum then checkEnum(ds, d) else ()
    if kind(d) == DProto then checkProto(ds, d) else ()
    if kind(d) == DTrait then checkTrait(ds, d) else ()
    // spec defs: pure, no regions; Lean type-checks them
    // defs and spec defs (pure mode, vic-u2d U1) are checked; their expansion e2 is kept
    val d2 = if kind(d) == DFn && (num(d) == 0 || num(d) == 2) then checkFn(ds, d) else if kind(d) == DHandler then checkHandler(ds, d) else if kind(d) == DGiven then checkGiven(ds, d) else if kind(d) == DFn && num(d) == 1 then withKids(d, NCons(list(Params, lineOf(d), sigParams(ds, d, defSol(ds, d))), tail(kids(d)))) else d
    out = NCons(d2, out)
    c = tail(c)
  rev(out)

def checkEnum {r: Region} (ds0: Decls, d: Node): Unit =
  // its [] binders are types in its field types; [] and <> on an enum: not yet
  val gs = kids(kid(head(kids(d)), 1))
  var g = gs
  while !isNil(g) do
    if !eqs(text(head(g)), "[") then err("not yet: binder group on an enum", text(head(g)), lineOf(head(g))) else ()
    g = tail(g)
  val ds = declsPrepend(groupBinders(gs), ds0)
  var cs = kids(d)
  while !isNil(cs) do
    var fs = kids(kid(head(cs), 0))
    while !isNil(fs) do
      val t = kid(head(fs), 0)
      needTy(ds, t)
      if isProto(ds, text(t)) then err("capability stored in data:", text(head(fs)), lineOf(t)) else ()
      fs = tail(fs)
    cs = tail(cs)

def checkProto {r: Region} (ds: Decls, d: Node): Unit =
  val st = protoStates(declList(ds), text(d))
  if !has(st, text2(d)) then err("unknown start state in protocol", text(d), lineOf(d)) else ()
  checkRules(ds, d)
  var ops = kids(kid(d, 3))
  while !isNil(ops) do
    var tr = kids(kid(head(ops), 2))
    while !isNil(tr) do
      if !has(st, text(head(tr))) || !has(st, text2(head(tr))) then err("unknown state in op", text(head(ops)), lineOf(head(ops))) else ()
      tr = tail(tr)
    ops = tail(ops)
  val dn = text(kid(d, 2))
  if rt_str_len(dn) > 0 && !found(find(kids(kid(d, 3)), DOp, dn)) then err("unknown drop op", dn, lineOf(d)) else ()

def checkHandler {r: Region} (ds: Decls, h: Node): Node =
  val p = findDecl(ds, DProto, text2(h))
  if !found(p) then err("unknown protocol", text2(h), lineOf(h)) else ()
  if !found(find(kids(h), DFn, "init")) then err("handler needs init:", text(h), lineOf(h)) else ()
  var ops = kids(kid(p, 3))
  while !isNil(ops) do
    val op = head(ops)
    val f = find(kids(h), DFn, text(op))
    if !found(f) then err("handler misses op", text(op), lineOf(h)) else ()
    // impl = (self: Ptr, op params...): op ret
    if len(kids(kid(f, 0))) != len(kids(kid(op, 0))) + 1 || !eqs(text(kid(f, 1)), text(kid(op, 1))) then err("handler op signature differs from protocol:", text(op), lineOf(f)) else ()
    ops = tail(ops)
  var fs = kids(h)
  var fs2 = NNil
  while !isNil(fs) do
    if !isNil(kids(kid(head(fs), 4))) then err("not yet: binder groups on a handler fn", text(head(fs)), lineOf(head(fs))) else ()
    checkSig(ds, head(fs))
    fs2 = NCons(checkFn(ds, head(fs)), fs2)
    fs = tail(fs)
  withKids(h, rev(fs2))

// [] binders of f: the binders of its [] groups, each of kind Type (vic-9l7.4 BD2)
def tparams {r: Region} (f: Node): Nodes = groupBinders(kids(kid(f, 4)))

// decls as seen in f's signature and body: its [] binders are types there
def withTParams {r: Region} (ds: Decls, f: Node): Decls = declsPrepend(tparams(f), ds)

def checkSig {r: Region} (ds0: Decls, f: Node): Unit =
  // [] type ascriptions, {} evidence (a trait application); <> facts: BD5
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    val g = head(gs)
    if !eqs(text(g), "[") && !eqs(text(g), "{") && !eqs(text(g), "<") then err("not yet: binder group", text(g), lineOf(g)) else ()
    if eqs(text(g), "<") then needFacts(ds0, f, g) else ()
    var bs = kids(g)
    while !isNil(bs) do
      val k = kid(head(bs), 0)
      if eqs(text(g), "[") then
        if !eqs(text(k), "Type") || !isNil(kids(k)) then err("not yet: [] binder of kind", text(k), lineOf(head(bs))) else ()
        if isBuiltin(text(head(bs))) || isEnum(ds0, text(head(bs))) || isProto(ds0, text(head(bs))) then err("[] binder hides a type:", text(head(bs)), lineOf(head(bs))) else ()
      else if eqs(text(g), "{") && !isProto(ds0, text(k)) then needTrait(withTParams(ds0, f), termTy(k))
      else ()
      bs = tail(bs)
    gs = tail(gs)
  val ds = withTParams(ds0, f)
  var ps = kids(kid(f, 0))
  while !isNil(ps) do
    val pt = kid(head(ps), 0)
    needTy(ds, pt)
    // a capability is evidence: a {} binder, never a value param (vic 2026-11-05)
    if isProto(ds, text(pt)) && num(f) != 1 then err("a capability is a {} binder, not a param:", text(head(ps)), lineOf(head(ps))) else ()
    ps = tail(ps)
  needTy(ds, kid(f, 1))
  if isProto(ds, text(kid(f, 1))) then err("capability returned from", text(f), lineOf(f)) else ()

// the env and Γ a fn body starts in: params, caps in their `from` state (also used by the Lean backend)
// f's {} binders of a protocol type: its capabilities (vic 2026-11-05: capability = evidence of a handler),
// as params in written order; the elaborated fn has them first, so C and the body see ordinary cap params
def capParams {r: Region} (ds: Decls, f: Node, sol: Nodes): Nodes =
  var out = NNil
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "{") then
      var bs = kids(head(gs))
      while !isNil(bs) do
        val k = kid(head(bs), 0)
        // its states: <at(f, S1)> before the params = entry, <at(f, S2)> after the result = exit (unchanged if absent)
        val from = capState(f, text(head(bs)), "", sol)
        val out2 = capState(f, text(head(bs)), "out", sol)
        val to = if rt_str_len(out2) > 0 then out2 else from
        if isProto(ds, text(k)) then out = NCons(Node(Param, text(head(bs)), "", 0, lineOf(head(bs)), one(Node(Ty, text(k), from, 0, lineOf(k), one(Node(TyTo, to, "", 0, 0, NNil))))), out) else ()
        bs = tail(bs)
    else ()
    gs = tail(gs)
  rev(out)

// f's params as its body sees them: capabilities, then values
def sigParams {r: Region} (ds: Decls, f: Node, sol: Nodes): Nodes = append(capParams(ds, f, sol), kids(kid(f, 0)))

def fnEnv {r: Region} (ds: Decls, ps: Nodes): Nodes =
  var env = NNil
  var c = ps
  while !isNil(c) do
    val p = head(c)
    val t = kid(p, 0)
    if isProto(ds, text(t)) then env = NCons(Node(BVar, text(p), text(t), 2, lineOf(p), one(t)), env)
    else env = NCons(Node(BVar, text(p), "", 0, lineOf(p), one(sigTy(ds, ps, t))), env)
    c = tail(c)
  env
def fnGam {r: Region} (ds: Decls, ps: Nodes): Nodes =
  var gam = NNil
  var c = ps
  while !isNil(c) do
    val t = kid(head(c), 0)
    if isProto(ds, text(t)) then
      val from = if rt_str_len(text2(t)) > 0 then text2(t) else text2(findDecl(ds, DProto, text(t)))
      gam = NCons(Node(GState, text(head(c)), from, 0, 0, NNil), gam)
    else ()
    c = tail(c)
  gam

// f with its body expanded (e2). variables in its facts: the body is checked once per solution (vic (a′)), and
// must end in each solution's exit state; the expansion does not depend on states, so the first one is kept
def checkFn {r: Region} (ds0: Decls, f: Node): Node =
  if hasVars(f) then
    val ss = solutions(withTParams(ds0, f), f, NNil)
    if isNil(ss) then err("entry facts have no solution:", text(f), lineOf(f)) else ()
    var c = tail(ss)
    while !isNil(c) do
      checkFnAt(ds0, f, kids(head(c)))
      c = tail(c)
    checkFnAt(ds0, f, kids(head(ss)))
  else checkFnAt(ds0, f, NNil)

def checkFnAt {r: Region} (ds0: Decls, f: Node, sol: Nodes): Node =
  val ds = withTParams(ds0, f)
  val ps = sigParams(ds, f, sol)
  val env0 = append(evEnv(ds, f), fnEnv(ds, ps))
  // a spec def body: checked in pure mode (vic-u2d U1), the compile-time fragment
  val env = if num(f) == 2 then NCons(leaf(BVar, "%pure", lineOf(f)), env0) else env0
  val res = chk(ds, env, fnGam(ds, ps), kid(f, 2), NoNode)
  needAssign(tgTy(res), sigTy(ds, ps, kid(f, 1)), lineOf(f))
  var c = ps
  while !isNil(c) do
    val t = kid(head(c), 0)
    if isProto(ds, text(t)) then
      val want = if rt_str_len(text2(t)) > 0 then tyTo(t) else text2(findDecl(ds, DProto, text(t)))
      if !eqs(state(tgGam(res), text(head(c))), want) then err("capability must end in its declared state:", text(head(c)), lineOf(f)) else ()
    else ()
    c = tail(c)
  // elaborated: capabilities are leading params (the call e2 passes them first)
  withKids(f, NCons(list(Params, lineOf(f), ps), NCons(kid(f, 1), NCons(tgE(res), tail(tail(tail(kids(f))))))))

// want: the type the context expects (an annotation, a param), or NoNode; it solves [] binders only the result names
def chk {r: Region} (ds: Decls, env: Nodes, gam: Nodes, e: Node, want: Node): TG =
  val k = kind(e)
  val line = lineOf(e)
  if k == XInt then TG(prim("I64"), gam, e)
  else if k == XBool then TG(prim("Bool"), gam, e)
  else if k == XStr then TG(prim("Str"), gam, e)
  else if k == XUnit then TG(prim("Unit"), gam, e)
  else if k == XName then
    val b = find(env, BVar, text(e))
    if found(b) then
      if num(b) == 2 then err("capability is second-class, only a call argument:", text(e), line) else ()
      if num(b) == 3 then err("evidence is only a method receiver:", text(e), line) else ()
      // a var's caps are flow state: what it holds now (C8)
      val t = if num(b) == 1 then recap(kid(b, 0), kids(find(gam, GVar, text(e)))) else kid(b, 0)
      needLive(declList(ds), env, gam, t, line)
      needStates(gam, t, line)
      TG(t, gam, e)
    else
      val c = findDecl(ds, DCase, text(e))
      if !found(c) then illTyped(gam, "unknown name", text(e), e, NNil)
      else
        if !isNil(kids(kid(c, 0))) then err("constructor needs arguments:", text(e), line) else ()
        chkNullary(ds, gam, c, e, want)
  else if k == XCall then
    val c = findDecl(ds, DCase, text(e))
    if found(c) then chkCtor(ds, env, gam, c, e, want) else chkCall(ds, env, gam, e, want, NNil)
  else if k == XCallG then
    if found(findDecl(ds, DCase, text(e))) then err("not yet: [] or {} on a constructor", text(e), line) else ()
    chkCall(ds, env, gam, Node(XCall, text(e), "", 0, line, tail(kids(e))), want, kids(head(kids(e))))
  else if k == XMethod then
    val ev = find(env, BVar, text(e))
    if found(ev) && num(ev) == 3 then chkEv(ds, env, gam, e, ev) else chkMethod(ds, env, gam, e)
  else if k == XBin then chkBin(ds, env, gam, e)
  else if k == XUn then
    val a = chk(ds, env, gam, kid(e, 0), NoNode)
    val need = if eqs(text(e), "-") then "I64" else "Bool"
    needAssign(tgTy(a), prim(need), line)
    TG(tgTy(a), tgGam(a), withKids(e, one(tgE(a))))
  else if k == XIf then
    val c = chk(ds, env, gam, kid(e, 0), NoNode)
    needAssign(tgTy(c), prim("Bool"), line)
    val t = chk(ds, env, tgGam(c), kid(e, 1), want)
    val f = chk(ds, env, tgGam(c), kid(e, 2), want)
    val e2 = withKids(e, NCons(tgE(c), NCons(tgE(t), one(tgE(f)))))
    TG(join(tgTy(t), tgTy(f), line), joinGam(tgGam(t), tgGam(f), branchErr(), line), e2)
  else if k == XMatch then chkMatch(ds, env, gam, e, want)
  else if k == XBlock then chkBlock(ds, env, gam, e, want)
  else if k == XWhile then chkWhile(ds, env, gam, e)
  else if k == XAssign then
    val b = find(env, BVar, text(e))
    if !found(b) || num(b) != 1 then err("assignment to non-var", text(e), line) else ()
    val a = chk(ds, env, gam, kid(e, 0), NoNode)
    needAssign(tgTy(a), bound(kid(b, 0), tgTy(a)), line)
    // strong update: the var now holds the caps of the new value (C8)
    TG(prim("Unit"), setG(tgGam(a), Node(GVar, text(e), "", 0, 0, tyCaps(tgTy(a)))), withKids(e, one(tgE(a))))
  else
    err("internal: expression", "?", line)
    TG(prim("Unit"), gam, e)

def branchErr(): Str = "branches leave capabilities in different states:"

// Γ after a loop = fixpoint over any number of turns: var caps grow by union until stable, cap states fixed
def chkWhile {r: Region} (ds: Decls, env: Nodes, gam: Nodes, e: Node): TG =
  val what = "loop changes capability state, protocol needs a fixed count:"
  var g = gam
  var done = false
  var e2 = e
  while !done do
    val c = chk(ds, env, g, kid(e, 0), NoNode)
    needAssign(tgTy(c), prim("Bool"), lineOf(e))
    val b = chk(ds, env, tgGam(c), kid(e, 1), NoNode)
    val w = joinGam(g, joinGam(tgGam(c), tgGam(b), what, lineOf(e)), what, lineOf(e))
    done = within(w, g)
    g = w
    // the expansion of the last turn: types do not depend on Γ, so every turn expands the same
    e2 = withKids(e, NCons(tgE(c), one(tgE(b))))
  TG(prim("Unit"), g, e2)

def join {r: Region} (a: Node, b: Node, line: I64): Node =
  if !tyEq(a, b) then needAssign(a, b, line) else ()
  recap(a, union(tyCaps(a), tyCaps(b)))

def chkBin {r: Region} (ds: Decls, env: Nodes, gam: Nodes, e: Node): TG =
  val op = text(e)
  val line = lineOf(e)
  val a = chk(ds, env, gam, kid(e, 0), NoNode)
  val b = chk(ds, env, tgGam(a), kid(e, 1), NoNode)
  val ta = tgTy(a)
  val tb = tgTy(b)
  val e2 = withKids(e, NCons(tgE(a), one(tgE(b))))
  if eqs(op, "&&") || eqs(op, "||") then
    needAssign(ta, prim("Bool"), line)
    needAssign(tb, prim("Bool"), line)
    TG(prim("Bool"), tgGam(b), e2)
  else if eqs(op, "==") || eqs(op, "!=") then
    if !tyEq(ta, tb) then needAssign(tb, ta, line) else ()
    if eqs(text(ta), "Str") then err("Str has no ==, use", "rt_str_eq", line) else ()
    TG(prim("Bool"), tgGam(b), e2)
  else
    needAssign(ta, prim("I64"), line)
    needAssign(tb, prim("I64"), line)
    val cmp = eqs(op, "<") || eqs(op, "<=") || eqs(op, ">") || eqs(op, ">=")
    TG(prim(if cmp then "Bool" else "I64"), tgGam(b), e2)

// in a spec def body: the env holds the marker %pure (no srs name has a %)
def isPure(env: Nodes): Bool = found(find(env, BVar, "%pure"))

// the externs without effects: pure, total, also in Lean (lean/Srs/Rt.lean namespace P)
def isPureExtern(n: Str): Bool = eqs(n, "rt_str_len") || eqs(n, "rt_str_at") || eqs(n, "rt_str_slice") || eqs(n, "rt_str_eq")

// the one capability of protocol p in scope: what a {} binder of a callee takes (vic-9l7.7)
def theCap(env: Nodes, p: Str, line: I64): Str =
  var c = env
  var res = ""
  var n = 0
  while !isNil(c) do
    val b = head(c)
    if num(b) == 2 && eqs(text2(b), p) && !eqs(text(b), res) then
      if n == 0 then res = text(b) else ()
      n = n + 1
    else ()
    c = tail(c)
  if n == 0 then err("no capability in scope for", p, line) else ()
  if n > 1 then err("ambiguous capability, more than one in scope for", p, line) else ()
  res

// a chosen capability: a cap of protocol p in scope
def chosenCap(env: Nodes, n: Str, p: Str, line: I64): Str =
  val b = find(env, BVar, n)
  if !found(b) || num(b) != 2 || !eqs(text2(b), p) then err("chosen name is not a capability of", p, line) else ()
  n

// unique Region capability in scope (effects.md)
def theRegion(env: Nodes, line: I64): Str =
  var c = env
  var res = ""
  var n = 0
  while !isNil(c) do
    val b = head(c)
    if num(b) == 2 && eqs(text2(b), "Region") && !eqs(text(b), res) then
      if n == 0 then res = text(b) else ()
      n = n + 1
    else ()
    c = tail(c)
  if n == 0 then err("constructor needs a Region capability in scope", "", line) else ()
  if n > 1 then err("constructor region is ambiguous, more than one Region in scope", "", line) else ()
  res

// op opName of protocol proto; its transition from the state of cap in gam
spec def opS(ds: Nodes, proto: Str, opName: Str): Node = lookS(kidsS(nthS(kidsS(lookS(ds, DProto, proto)), 3)), DOp, opName)
spec def trS(ds: Nodes, gam: Nodes, cap: Str, proto: Str, opName: Str): Node =
  lookS(kidsS(nthS(kidsS(opS(ds, proto, opName)), 2)), DTrans, text2S(lookS(gam, GState, cap)))
// one protocol step on cap: Γ(cap) must have a transition in op
// accepts only when op and its transition exist; Γ after = cap moved to the transition target
def step {r: Region} (ds: Nodes, gam: Nodes, cap: Str, proto: Str, opName: Str, line: I64): Nodes
  returns foundS(opS(ds, proto, opName)) && foundS(trS(ds, gam, cap, proto, opName)) && result == replS(gam, Node(GState, cap, text2S(trS(ds, gam, cap, proto, opName)), 0, 0, NNil))
=
  val op = find(kids(kid(find(ds, DProto, proto), 3)), DOp, opName)
  if !found(op) then err("unknown op", opName, line) else ()
  val s = state(gam, cap)
  val tr = find(kids(kid(op, 2)), DTrans, s)
  if !found(tr) then
    rt_eprint("srs:")
    rt_eprint_i64(line)
    rt_eprint(": error: protocol ")
    rt_eprint(proto)
    rt_eprint(": op '")
    rt_eprint(opName)
    rt_eprint("' not allowed in state ")
    rt_eprint(s)
    rt_eprint(" of '")
    rt_eprint(cap)
    rt_eprint("'\n")
    rt_exit(1)
  else ()
  setG(gam, Node(GState, cap, text2(tr), 0, 0, NNil))

def chkCtor {r: Region} (ds: Decls, env: Nodes, gam0: Nodes, c: Node, e: Node, want: Node): TG =
  val line = lineOf(e)
  var fs = kids(kid(c, 0))
  if len(fs) != len(kids(e)) then err("constructor arity", text(c), line) else ()
  if isNil(fs) then err("nullary constructor takes no ()", text(c), line) else ()
  // a spec def builds compile-time data: no Region (vic Q-U4); else the one Region in scope allocates it
  val inSpec = isPure(env)
  val reg = if inSpec then "" else theRegion(env, line)
  var gam = if inSpec then gam0 else step(declList(ds), gam0, reg, "Region", "alloc", line)
  var caps = if inSpec then NNil else one(leaf(TyCap, reg, line))
  // a generic enum: the field types match the args, binding its [] binders (as chkCall)
  val tps = enumTParams(ds, text2(c))
  var sub = NNil
  var a = kids(e)
  var a2 = NNil
  while !isNil(a) do
    val ft = kid(head(fs), 0)
    val w = applyTy(sub, ft)
    val x = chk(ds, env, gam, head(a), if mentions(tps, w) then NoNode else w)
    if mentions(tps, ft) then sub = matchTy(tps, ft, tgTy(x), sub, line)
    else if !tyEq(tgTy(x), ft) then needAssign(tgTy(x), ft, line)
    else ()
    caps = union(caps, tyCaps(tgTy(x)))
    gam = tgGam(x)
    a2 = NCons(tgE(x), a2)
    a = tail(a)
    fs = tail(fs)
  if isNil(tps) then TG(mkTy(text2(c), caps), gam, withKids(e, rev(a2)))
  else
    val self = enumSelf(text2(c), tps)
    if mentions(tps, applyTy(sub, self)) && found(want) then sub = matchTy(tps, self, want, sub, line) else ()
    val targs = instArgs(tps, sub, line)
    TG(recap(applyTy(sub, self), caps), gam, Node(XNew, text(c), "", 0, line, NCons(list(Names, line, targs), rev(a2))))

// enum n applied to its own [] binders: the pattern its values match
def enumSelf {r: Region} (n: Str, tps: Nodes): Node =
  var out = NNil
  var c = tps
  while !isNil(c) do
    out = NCons(mkTy(text(head(c)), NNil), out)
    c = tail(c)
  Node(Ty, n, "", 1, 0, one(Node(TyTo, "", "", 0, 0, rev(out))))

// a nullary case of a generic enum: the expected type gives its type args
def chkNullary {r: Region} (ds: Decls, gam: Nodes, c: Node, e: Node, want: Node): TG =
  val tps = enumTParams(ds, text2(c))
  if isNil(tps) then TG(prim(text2(c)), gam, e)
  else
    val sub = if found(want) then matchTy(tps, enumSelf(text2(c), tps), want, NNil, lineOf(e)) else NNil
    val targs = instArgs(tps, sub, lineOf(e))
    TG(recap(applyTy(sub, enumSelf(text2(c), tps)), NNil), gam, Node(XNew, text(c), "", 0, lineOf(e), one(list(Names, lineOf(e), targs))))

spec def tgGamS(x: TG): Nodes = x match
  case TG(_, g, _) => g
// accepts only when, in the Γ after the args, op and its transition exist; Γ after = cap e moved by op
def chkMethod {r: Region} (ds: Decls, env: Nodes, gam0: Nodes, e: Node): TG
  returns exists gam: Nodes => foundS(opS(declsS(ds), text2S(lookS(env, BVar, textS(e))), text2S(e))) && foundS(trS(declsS(ds), gam, textS(e), text2S(lookS(env, BVar, textS(e))), text2S(e))) && tgGamS(result) == replS(gam, Node(GState, textS(e), text2S(trS(declsS(ds), gam, textS(e), text2S(lookS(env, BVar, textS(e))), text2S(e))), 0, 0, NNil))
=
  val line = lineOf(e)
  val b = find(env, BVar, text(e))
  if !found(b) || num(b) != 2 then err("not a capability:", text(e), line) else ()
  val op = find(kids(kid(find(declList(ds), DProto, text2(b)), 3)), DOp, text2(e))
  if !found(op) then err("unknown op", text2(e), line) else ()
  var ps = kids(kid(op, 0))
  if len(ps) != len(kids(e)) then err("op arity", text2(e), line) else ()
  var gam = gam0
  var a = kids(e)
  var a2 = NNil
  while !isNil(a) do
    val x = chk(ds, env, gam, head(a), NoNode)
    needAssign(tgTy(x), kid(head(ps), 0), line)
    gam = tgGam(x)
    a2 = NCons(tgE(x), a2)
    a = tail(a)
    ps = tail(ps)
  TG(kid(op, 1), step(declList(ds), gam, text(e), text2(b), text2(e), line), withKids(e, rev(a2)))

// map callee cap-param name -> caller cap name
def mapCaps {r: Region} (caps: Nodes, m: Nodes): Nodes =
  var out = NNil
  var c = caps
  while !isNil(c) do
    val g = find(m, GState, text(head(c)))
    // a fact on a type (vic-jxk): the cap keeps its required state (t)
    out = NCons(Node(TyCap, if found(g) then text2(g) else text(head(c)), text2(head(c)), 0, 0, NNil), out)
    c = tail(c)
  out

// gs: the call's groups (f[T]{a}(x), vic 2026-11-05): explicit type args, the {} binders chosen by name
def chkCall {r: Region} (ds: Decls, env: Nodes, gam0: Nodes, e: Node, want: Node, gs: Nodes): TG =
  val f = findDecl(ds, DFn, text(e))
  if found(f) then chkCallOf(ds, env, gam0, f, e, want, gs) else illTypedCall(ds, env, gam0, "unknown function", e)

// an ill-typed call: its args are still checked, so the errors inside them surface too
def illTypedCall {r: Region} (ds: Decls, env: Nodes, gam0: Nodes, what: Str, e: Node): TG =
  var gam = gam0
  var xs = NNil
  var a = kids(e)
  while !isNil(a) do
    val tg = chk(ds, env, gam, head(a), NoNode)
    gam = tgGam(tg)
    xs = NCons(tgE(tg), xs)
    a = tail(a)
  illTyped(gam, what, text(e), e, rev(xs))

def chkCallOf {r: Region} (ds: Decls, env: Nodes, gam0: Nodes, f: Node, e: Node, want: Node, gs: Nodes): TG =
  val line = lineOf(e)
  // a spec def calls only fns without effects: pure defs and the pure externs (vic-u2d U1b, s1/purity.srs)
  if isPure(env) && isImpure(ds, text(f)) then err("a spec def calls only pure defs and pure externs, not", text(e), line) else ()
  var ps = kids(kid(f, 0))
  if len(ps) != len(kids(e)) then err("arity of", text(e), line) else ()
  // pass 1: cap args, protocol state transitions S1 -> S2
  var m = NNil
  var gam = gam0
  var a = kids(e)
  var p = ps
  while !isNil(a) do
    val pt = kid(head(p), 0)
    if isProto(ds, text(pt)) then
      val x = head(a)
      val b = find(env, BVar, text(x))
      if kind(x) != XName || !found(b) || num(b) != 2 || !eqs(text2(b), text(pt)) then err("expected capability argument of protocol", text(pt), line) else ()
      if found(find(m, GState, text(head(p)))) || has(mapVals(m), text(x)) then err("capability passed twice:", text(x), line) else ()
      m = NCons(Node(GState, text(head(p)), text(x), 0, 0, NNil), m)
    else ()
    a = tail(a)
    p = tail(p)
  // {} capabilities: the one cap of that protocol in scope (as a constructor finds its region); 0 or 2+ = reject
  val cps = capParams(ds, f, NNil)
  // f{a, b}(x): one name per {} binder of f, in written order, else each found in scope
  val ch = callGroup(gs, "{")
  if !isNil(ch) && len(ch) != curlyCount(f) then err("wrong number of chosen evidence for", text(e), line) else ()
  var c = cps
  var capArgs = NNil
  while !isNil(c) do
    val proto = text(kid(head(c), 0))
    val cap = if isNil(ch) then theCap(env, proto, line) else chosenCap(env, text(nth(ch, curlyIndex(f, text(head(c))))), proto, line)
    if has(mapVals(m), cap) then err("capability passed twice:", cap, line) else ()
    m = NCons(Node(GState, text(head(c)), cap, 0, 0, NNil), m)
    capArgs = NCons(leaf(XName, cap, line), capArgs)
    c = tail(c)
  var allPs = append(cps, ps)
  // pass 2: value args, left to right
  val tps = tparams(f)
  // f[T1, T2](x): the [] binders given, else matched from the args
  val ex = callGroup(gs, "[")
  if !isNil(ex) && len(ex) != len(tps) then err("wrong number of type args for", text(e), line) else ()
  var tx = ex
  while !isNil(tx) do
    needTy(ds, head(tx))
    tx = tail(tx)
  var sub = zipBind(tps, ex)
  var rho = NNil
  var a2 = NNil
  a = kids(e)
  p = ps
  while !isNil(a) do
    val pt = kid(head(p), 0)
    // cap args stay as written
    if isProto(ds, text(pt)) then a2 = NCons(head(a), a2) else ()
    if mentions(tps, pt) then
      // the param type names [] binders: the arg type matches it, binding them; bound ones must agree
      val w = applyTy(sub, pt)
      val x = chk(ds, env, gam, head(a), if mentions(tps, w) then NoNode else w)
      gam = tgGam(x)
      a2 = NCons(tgE(x), a2)
      sub = matchTy(tps, pt, tgTy(x), sub, line)
      rho = union(rho, tyCaps(tgTy(x)))
    else if !isProto(ds, text(pt)) then
      val x = chk(ds, env, gam, head(a), pt)
      gam = tgGam(x)
      a2 = NCons(tgE(x), a2)
      if isEnum(ds, text(pt)) && num(pt) == 0 then
        if !tyEq(tgTy(x), pt) then needAssign(tgTy(x), pt, line) else ()
        rho = union(rho, tyCaps(tgTy(x)))
      else needAssign(tgTy(x), recap(pt, mapCaps(tyCaps(pt), m)), line)
    else ()
    a = tail(a)
    p = tail(p)
  // cap transitions happen during the call, after the args
  // variables in its facts: Datalog binds them from the caps' states in Γ now (one solution), giving each cap its
  // entry and exit state (vic (a′))
  if hasVars(f) then allPs = append(capParams(ds, f, callSol(ds, f, capEntry(m, gam), line)), ps) else ()
  p = allPs
  while !isNil(p) do
    val pt = kid(head(p), 0)
    if isProto(ds, text(pt)) then
      val cap = text2(find(m, GState, text(head(p))))
      val from = if rt_str_len(text2(pt)) > 0 then text2(pt) else text2(findDecl(ds, DProto, text(pt)))
      val to = if rt_str_len(text2(pt)) > 0 then tyTo(pt) else from
      if !eqs(state(gam, cap), from) then
        rt_eprint("srs:")
        rt_eprint_i64(line)
        rt_eprint(": error: '")
        rt_eprint(text(e))
        rt_eprint("' needs '")
        rt_eprint(cap)
        rt_eprint("' in state ")
        rt_eprint(from)
        rt_eprint(", it is ")
        rt_eprint(state(gam, cap))
        rt_eprint("\n")
        rt_exit(1)
      else ()
      gam = setG(gam, Node(GState, cap, to, 0, 0, NNil))
    else ()
    p = tail(p)
  val rt = kid(f, 1)
  if isNil(tps) then
    // the callee's {} evidence: each goal has one given (s1/given.srs)
    goals(ds, env, kids(kid(f, 4)), NNil, ch, givenFuel(), line)
    val caps = if isEnum(ds, text(rt)) && num(rt) == 0 then union(rho, mapCaps(regionParams(allPs), m)) else mapCaps(tyCaps(rt), m)
    TG(recap(rt, caps), gam, withKids(e, append(rev(capArgs), rev(a2))))
  else
    // a [] binder only the result names: the context's expected type solves it (check mode)
    if mentions(tps, applyTy(sub, rt)) && found(want) then sub = matchTy(tps, rt, want, sub, line) else ()
    val targs = instArgs(tps, sub, line)
    goals(ds, env, kids(kid(f, 4)), sub, ch, givenFuel(), line)
    // a value of a [] binder lives in the regions of the args given for it
    val rt2 = applyTy(sub, rt)
    // only data (an enum, or a [] binder still open) lives in regions; I64, Bool, ... carry none
    val res = if mentions(tps, rt) then recap(rt2, if isEnum(ds, text(rt2)) || isTParam(ds, text(rt2)) then rho else NNil) else recap(rt, mapCaps(tyCaps(rt), m))
    TG(res, gam, Node(XInst, text(e), "", 0, line, NCons(list(Names, line, targs), append(rev(capArgs), rev(a2)))))

// t is one of the [] binders tps
def isTP(tps: Nodes, t: Node): Bool = found(find(tps, Binder, text(t)))

// binder i of tps bound to type i of ts
def zipBind {r: Region} (tps: Nodes, ts: Nodes): Nodes =
  if isNil(tps) || isNil(ts) then NNil
  else NCons(Node(Binder, text(head(tps)), "", 0, 0, one(head(ts))), zipBind(tail(tps), tail(ts)))

// t names a [] binder of tps, whole or inside T[args]
def mentions(tps: Nodes, t: Node): Bool = isTP(tps, t) || anyMentions(tps, tyArgs(t))
def anyMentions(tps: Nodes, ts: Nodes): Bool = if isNil(ts) then false else mentions(tps, head(ts)) || anyMentions(tps, tail(ts))

// sub extended so the pattern p (it may name [] binders tps) is the type a: one-sided unify (a names none of tps)
def matchTy {r: Region} (tps: Nodes, p: Node, a: Node, sub: Nodes, line: I64): Nodes =
  if isTP(tps, p) then
    val b = find(sub, Binder, text(p))
    if found(b) then
      needSame(a, kid(b, 0), line)
      sub
    else NCons(Node(Binder, text(p), "", 0, line, one(recap(a, NNil))), sub)
  else
    if !eqs(text(p), text(a)) || len(tyArgs(p)) != len(tyArgs(a)) then needAssign(a, p, line) else ()
    var s = sub
    var ps = tyArgs(p)
    var as = tyArgs(a)
    while !isNil(ps) do
      s = matchTy(tps, head(ps), head(as), s, line)
      ps = tail(ps)
      as = tail(as)
    s

// t with its bound [] binders replaced; caps and to-state kept
def applyTy {r: Region} (sub: Nodes, t: Node): Node =
  val b = find(sub, Binder, text(t))
  if found(b) && isNil(tyArgs(t)) then kid(b, 0)
  else
    var out = NNil
    var c = tyArgs(t)
    while !isNil(c) do
      out = NCons(applyTy(sub, head(c)), out)
      c = tail(c)
    Node(Ty, text(t), text2(t), num(t), lineOf(t), NCons(Node(TyTo, tyTo(t), "", 0, 0, rev(out)), tyCaps(t)))

// a [] binder bound twice: the same type (unify on names, BD2; structure comes with type application, BD3)
def needSame(a: Node, b: Node, line: I64): Unit = if !tyEq(a, b) then needAssign(a, b, line) else ()

// the types of an instance, in [] binder order; every [] binder must be solved
def instArgs {r: Region} (tps: Nodes, sub: Nodes, line: I64): Nodes =
  var out = NNil
  var c = tps
  while !isNil(c) do
    val b = find(sub, Binder, text(head(c)))
    if !found(b) then err("cannot infer", text(head(c)), line) else ()
    out = NCons(kid(b, 0), out)
    c = tail(c)
  rev(out)

def mapVals {r: Region} (m: Nodes): Nodes =
  var out = NNil
  var c = m
  while !isNil(c) do
    out = NCons(leaf(Name, text2(head(c)), 0), out)
    c = tail(c)
  out

def chkMatch {r: Region} (ds: Decls, env: Nodes, gam: Nodes, e: Node, want: Node): TG =
  val line = lineOf(e)
  val s = chk(ds, env, gam, kid(e, 0), NoNode)
  val st = tgTy(s)
  val en = findDecl(ds, DEnum, text(st))
  if !found(en) then err("match on non-enum type", text(st), line) else ()
  var arms = tail(kids(e))
  var seen = NNil
  var wild = false
  var res = NoNode
  var out = NNil
  var arms2 = NNil
  while !isNil(arms) do
    val arm = head(arms)
    var env2 = env
    if eqs(text(arm), "_") then wild = true
    else
      val c = find(kids(en), DCase, text(arm))
      if !found(c) then err("not a case of the scrutinee enum:", text(arm), lineOf(arm)) else ()
      seen = NCons(leaf(Name, text(arm), 0), seen)
      var bs = tail(kids(arm))
      var fs = kids(kid(c, 0))
      if len(bs) != len(fs) then err("pattern arity", text(arm), lineOf(arm)) else ()
      while !isNil(bs) do
        val ft = kid(head(fs), 0)
        // fields share the capture of the scrutinee
        // a generic enum: the scrutinee's type args fill the field types
        val ft2 = applyTy(zipBind(enumTParams(ds, text(st)), tyArgs(st)), ft)
        val bt = if isEnum(ds, text(ft2)) then recap(ft2, tyCaps(st)) else ft2
        env2 = NCons(Node(BVar, text(head(bs)), "", 0, lineOf(arm), one(bt)), env2)
        bs = tail(bs)
        fs = tail(fs)
    val x = chk(ds, env2, tgGam(s), kid(arm, 0), want)
    arms2 = NCons(withKids(arm, NCons(tgE(x), tail(kids(arm)))), arms2)
    if found(res) then
      res = join(res, tgTy(x), lineOf(arm))
      out = joinGam(out, tgGam(x), branchErr(), lineOf(arm))
    else
      res = tgTy(x)
      out = tgGam(x)
    arms = tail(arms)
  if !wild then
    var cs = kids(en)
    while !isNil(cs) do
      if !has(seen, text(head(cs))) then err("match is not exhaustive, missing case", text(head(cs)), line) else ()
      cs = tail(cs)
  else ()
  TG(res, out, withKids(e, NCons(tgE(s), rev(arms2))))

def chkBlock {r: Region} (ds: Decls, env0: Nodes, gam0: Nodes, blk: Node, want: Node): TG =
  val line = lineOf(blk)
  var env = env0
  var gam = gam0
  var caps = NNil
  var res = prim("Unit")
  var c = kids(blk)
  var ss2 = NNil
  while !isNil(c) do
    val s = head(c)
    val k = kind(s)
    if k == SClause then ss2 = NCons(s, ss2)
    else if k == SVal then
      // the annotation is a type first: it is the expected type (want) of the value
      if !isNil(tail(kids(s))) then needTy(ds, kid(s, 1)) else ()
      val x = chk(ds, env, gam, kid(s, 0), if isNil(tail(kids(s))) then NoNode else kid(s, 1))
      ss2 = NCons(withKids(s, NCons(tgE(x), tail(kids(s)))), ss2)
      gam = tgGam(x)
      var t = tgTy(x)
      if !isNil(tail(kids(s))) then
        val ann = kid(s, 1)
        if isProto(ds, text(ann)) then err("capability bound to a val:", text(s), lineOf(s)) else ()
        needAssign(t, bound(ann, t), lineOf(s))
        t = if num(s) == 1 then ann else bound(ann, t)
      else if num(s) == 1 then t = uncap(t)
      else ()
      if num(s) == 1 then gam = NCons(Node(GVar, text(s), "", 0, 0, tyCaps(tgTy(x))), gam) else ()
      env = NCons(Node(BVar, text(s), "", num(s), lineOf(s), one(t)), env)
      res = prim("Unit")
    else if k == SHandle then
      if isPure(env) then err("a spec def is pure: no handle of", text2(s), lineOf(s)) else ()
      val h = findDecl(ds, DHandler, text2(s))
      if !found(h) then err("unknown handler", text2(s), lineOf(s)) else ()
      val init = find(kids(h), DFn, "init")
      var ps = kids(kid(init, 0))
      var a = kids(s)
      var a2 = NNil
      if len(ps) != len(a) then err("handler init arity", text2(s), lineOf(s)) else ()
      while !isNil(a) do
        val x = chk(ds, env, gam, head(a), NoNode)
        needAssign(tgTy(x), kid(head(ps), 0), lineOf(s))
        gam = tgGam(x)
        a2 = NCons(tgE(x), a2)
        a = tail(a)
        ps = tail(ps)
      ss2 = NCons(withKids(s, rev(a2)), ss2)
      val p = findDecl(ds, DProto, text2(h))
      env = NCons(Node(BVar, text(s), text(p), 2, lineOf(s), one(mkTy(text(p), NNil))), env)
      gam = NCons(Node(GState, text(s), text2(p), 0, 0, NNil), gam)
      caps = NCons(Node(BVar, text(s), text(p), 2, lineOf(s), NNil), caps)
      res = prim("Unit")
    else
      val x = chk(ds, env, gam, s, if isNil(tail(c)) then want else NoNode)
      ss2 = NCons(tgE(x), ss2)
      gam = tgGam(x)
      res = tgTy(x)
    c = tail(c)
  // scope end: each handled cap reaches an end state, by itself or by its drop op
  while !isNil(caps) do
    val b = head(caps)
    val p = findDecl(ds, DProto, text2(b))
    val s = state(gam, text(b))
    if !has(kids(kid(p, 1)), s) then
      val dn = text(kid(p, 2))
      val op = find(kids(kid(p, 3)), DOp, dn)
      val tr = find(kids(kid(op, 2)), DTrans, s)
      if rt_str_len(dn) == 0 || !found(tr) || !has(kids(kid(p, 1)), text2(tr)) then
        rt_eprint("srs:")
        rt_eprint_i64(lineOf(b))
        rt_eprint(": error: protocol ")
        rt_eprint(text(p))
        rt_eprint(": '")
        rt_eprint(text(b))
        rt_eprint("' ends its scope in state ")
        rt_eprint(s)
        rt_eprint(", not an end state\n")
        rt_exit(1)
      else ()
    else ()
    if has(tyCaps(res), text(b)) then err("value escapes the scope of its region", text(b), lineOf(b)) else ()
    caps = tail(caps)
  // block entries (caps, vars) were prepended to Γ: cut them
  TG(res, drop(gam, len(gam) - len(gam0)), withKids(blk, rev(ss2)))
