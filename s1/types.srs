// Type telescopes and match types (vic S18 + telescopes; vic-9l7.9 BD6). type F [A: Type] = T: F[X] is T with A := X.
// a match type reduces by its first case whose pattern is the scrutinee (concrete patterns). Expansion runs before
// checking, over every Ty of the program; each reduction step costs fuel (as givens, vic Q-R4b): a loop is a reject.

def typeFuel(): I64 = 1000

// the program with every type lambda applied and every match type reduced
def expandTypes {r: Region} (ds0: Decls): Nodes =
  // value args call pure defs at compile time: the fns with effects (s1/purity.srs), when a type has () binders
  val ds = if hasValueTypes(declList(ds0)) then declsCons(impureDecl(ds0), ds0) else ds0
  var out = NNil
  var c = declList(ds0)
  while !isNil(c) do
    val d = head(c)
    if kind(d) == DType then checkTypeDecl(ds, d) else ()
    // the evidence in scope of its types: a def's (or a given's) {} binders; a type's {} goals resolve against it
    out = NCons(if kind(d) == DType then d else expandIn(ds, declEv(ds, d), d), out)
    c = tail(c)
  rev(out)

// e with each Ty normalized
def expandIn {r: Region} (ds: Decls, env: Nodes, e: Node): Node =
  if kind(e) == Ty then normTy(ds, env, e, typeFuel())
  else
    var out = NNil
    var c = kids(e)
    while !isNil(c) do
      out = NCons(expandIn(ds, env, head(c)), out)
      c = tail(c)
    withKids(e, rev(out))

// t with its args normalized and, if it names a type decl, applied (and its match reduced); the use keeps its caps
def normTy {r: Region} (ds: Decls, env: Nodes, t: Node, fuel: I64): Node = normTyV(ds, env, CEnvNil, t, fuel)

// t inside the body of a type decl whose () value params are cv (vic-u2d.3): its value args see them
def normTyV {r: Region} (ds: Decls, env: Nodes, cv: CEnv, t: Node, fuel: I64): Node =
  if fuel <= 0 then errTy("type reduction ran out of fuel at", t, lineOf(t)) else ()
  var args = NNil
  var c = tyArgs(t)
  while !isNil(c) do
    args = NCons(normTyV(ds, env, cv, head(c), fuel - 1), args)
    c = tail(c)
  val vals = if isNil(tyCaps(t)) then NoNode else find(tyCaps(t), TyVals, "")
  val t1 = Node(Ty, text(t), text2(t), num(t), lineOf(t), NCons(Node(TyTo, tyTo(t), "", 0, 0, rev(args)), if found(vals) then dropVals(tyCaps(t)) else tyCaps(t)))
  val d = findDecl(ds, DType, text(t))
  if !found(d) then
    if found(vals) then err("value args on a type that takes none:", text(t), lineOf(t)) else ()
    t1
  else
    val tps = groupBinders(kids(kid(d, 0)))
    if len(tyArgs(t1)) != len(tps) then err("wrong number of type args for", text(t), lineOf(t)) else ()
    val vbs = valueBinders(kids(kid(d, 0)))
    if (if found(vals) then len(kids(vals)) else 0) != len(vbs) then err("wrong number of value args for", text(t), lineOf(t)) else ()
    // the value args, evaluated at compile time (U2), bound to the decl's () params
    val cv2 = if found(vals) then bindVals(ds, cv, vbs, kids(vals), text(t)) else CEnvNil
    val sub = zipBind(tps, tyArgs(t1))
    // its {} evidence: resolved at this use (as a call's, local evidence first, vic-jxk)
    goals(ds, env, kids(kid(d, 0)), sub, NNil, givenFuel(), lineOf(t))
    val res = if num(d) == 2 then reduceValues(ds, d, cv2, sub, lineOf(t)) else if num(d) == 1 then reduceMatch(ds, d, normTyV(ds, env, cv2, applyTy(sub, kid(d, 1)), fuel - 1), sub, lineOf(t)) else applyTy(sub, kid(d, 1))
    // its facts <at(f, S)>: the caps of the use's scope, each with its required state (vic-jxk)
    withCaps(normTyV(ds, env, cv2, res, fuel - 1), t1, typeFacts(ds, env, d, lineOf(t)))

def dropVals {r: Region} (cs: Nodes): Nodes =
  var out = NNil
  var c = cs
  while !isNil(c) do
    if kind(head(c)) != TyVals then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(out)

// the binders of the () group of a type decl
def valueBinders {r: Region} (gs: Nodes): Nodes =
  var out = NNil
  var c = gs
  while !isNil(c) do
    if kind(head(c)) == Group && eqs(text(head(c)), "(") then out = append(out, kids(head(c))) else ()
    c = tail(c)
  out

def hasValueTypes {r: Region} (ds: Nodes): Bool =
  var res = false
  var c = ds
  while !res && !isNil(c) do
    if kind(head(c)) == DType then res = !isNil(valueBinders(kids(kid(head(c), 0)))) else ()
    c = tail(c)
  res

// a compile-time value fits a value binder type: I64, Bool or Str
def cvFits(v: CVal, t: Str): Bool = v match
  case CInt(_) => eqs(t, "I64")
  case CBool(_) => eqs(t, "Bool")
  case CStr(_) => eqs(t, "Str")
  case _ => false

def bindVals {r: Region} (ds: Decls, cv: CEnv, bs: Nodes, xs: Nodes, ty: Str): CEnv =
  var out = CEnvNil
  var b = bs
  var x = xs
  while !isNil(b) && !isNil(x) do
    val v = crV(evExpr(ds, ty, cv, comptimeFuel(), head(x)))
    if !cvFits(v, text(kid(head(b), 0))) then err("value arg does not fit", text(kid(head(b), 0)), lineOf(head(x))) else ()
    out = CBind(text(head(b)), v, out)
    b = tail(b)
    x = tail(x)
  out

// the result of the first case of value match d whose pattern is the scrutinee's value (or _)
def reduceValues {r: Region} (ds: Decls, d: Node, cv: CEnv, sub: Nodes, line: I64): Node =
  val v = crV(evExpr(ds, text(d), cv, comptimeFuel(), kid(d, 1)))
  var res = NoNode
  var c = tail(tail(kids(d)))
  while !found(res) && !isNil(c) do
    val p = kid(head(c), 0)
    val hit = (kind(p) == XName && eqs(text(p), "_")) || cvEq(crV(evExpr(ds, text(d), CEnvNil, comptimeFuel(), p)), v)
    if hit then res = applyTy(sub, kid(head(c), 1)) else ()
    c = tail(c)
  if !found(res) then err("no case of the value match matches", text(d), line) else ()
  res

// res at the use t: t's caps, annotation flag and line
def withCaps {r: Region} (res: Node, t: Node, facts: Nodes): Node = Node(Ty, text(res), text2(res), num(t), lineOf(t), NCons(head(kids(res)), append(facts, tyCaps(t))))

// the result of the first case of match type d whose pattern is s; s must be a concrete type
def reduceMatch {r: Region} (ds: Decls, d: Node, s: Node, sub: Nodes, line: I64): Node =
  if !isBuiltin(text(s)) && !isEnum(ds, text(s)) && !isProto(ds, text(s)) then errTy("match type needs a concrete type, not", s, line) else ()
  var res = NoNode
  var c = tail(tail(kids(d)))
  while !found(res) && !isNil(c) do
    if tyEq(applyTy(sub, kid(head(c), 0)), s) then res = applyTy(sub, kid(head(c), 1)) else ()
    c = tail(c)
  if !found(res) then errTy("no case of the match type matches", s, line) else ()
  res

// [A: Type] binders, {} evidence (a trait) or capabilities (a protocol), <at(f, S)> facts (vic-jxk); () values: not yet
def checkTypeDecl {r: Region} (ds0: Decls, d: Node): Unit =
  val ds = declsPrepend(groupBinders(kids(kid(d, 0))), ds0)
  var gs = kids(kid(d, 0))
  while !isNil(gs) do
    val g = head(gs)
    if !eqs(text(g), "[") && !eqs(text(g), "{") && !eqs(text(g), "<") && !eqs(text(g), "(") then err("not yet: binder group on a type", text(g), lineOf(g)) else ()
    if eqs(text(g), "<") then needTypeFacts(ds, d, g) else ()
    var bs = kids(g)
    while !isNil(bs) do
      val k = kid(head(bs), 0)
      // () values (vic-u2d.3): a compile-time value of I64, Bool or Str
      if eqs(text(g), "(") then
        if !(eqs(text(k), "I64") || eqs(text(k), "Bool") || eqs(text(k), "Str")) || !isNil(kids(k)) then err("not yet: value binder of type", text(k), lineOf(head(bs))) else ()
      else if eqs(text(g), "[") then
        if !eqs(text(k), "Type") || !isNil(kids(k)) then err("not yet: [] binder of kind", text(k), lineOf(head(bs))) else ()
      else if eqs(text(g), "<") || isProto(ds, text(k)) then ()
      else needTrait(ds, termTy(k))
      bs = tail(bs)
    gs = tail(gs)
  if num(d) == 2 then needPatterns(d) else ()

// a value match: each pattern is _ or a literal of the scrutinee's binder type
def needPatterns {r: Region} (d: Node): Unit =
  val b = find(valueBinders(kids(kid(d, 0))), Binder, text(kid(d, 1)))
  val t = text(kid(b, 0))
  var c = tail(tail(kids(d)))
  while !isNil(c) do
    val p = kid(head(c), 0)
    val k = kind(p)
    val ok = k == XName || (k == XInt && eqs(t, "I64")) || (k == XBool && eqs(t, "Bool")) || (k == XStr && eqs(t, "Str"))
    if !ok then err("value match pattern does not fit", t, lineOf(p)) else ()
    c = tail(c)

// the {} evidence in scope of a decl's types: a def's (a given's def: the given's) {} binders
def declEv {r: Region} (ds: Decls, d: Node): Nodes =
  if kind(d) == DFn then append(capEnv(ds, d), evEnv(ds, d))
  else if kind(d) == DGiven then groupsEv(ds, kids(kid(d, 0)))
  else NNil

// a def's {} capabilities as env entries (BVar n 2, t = protocol): the caps a fact type at a use can name
def capEnv {r: Region} (ds: Decls, d: Node): Nodes =
  var out = NNil
  var c = capParams(ds, d, NNil)
  while !isNil(c) do
    out = NCons(Node(BVar, text(head(c)), text(kid(head(c), 0)), 2, lineOf(head(c)), NNil), out)
    c = tail(c)
  out

// the protocol of type decl d's {} binder n, or ""
def typeBinderProto(ds: Decls, d: Node, n: Str): Str =
  var res = ""
  var gs = kids(kid(d, 0))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "{") then
      val b = find(kids(head(gs)), Binder, n)
      if found(b) && isProto(ds, text(kid(b, 0))) then res = text(kid(b, 0)) else ()
    else ()
    gs = tail(gs)
  res

// a type's facts: at(cap, State), cap a {} capability of the type, State a state of its protocol (no variables yet)
def needTypeFacts {r: Region} (ds: Decls, d: Node, g: Node): Unit =
  var c = kids(g)
  while !isNil(c) do
    val a = head(c)
    if !eqs(text(a), "at") || len(kids(a)) != 2 then err("not yet: fact on a type", text(a), lineOf(a)) else ()
    val p = typeBinderProto(ds, d, text(kid(a, 0)))
    if rt_str_len(p) == 0 then err("at: not a {} capability of this type:", text(kid(a, 0)), lineOf(a)) else ()
    if !has(protoStates(declList(ds), p), text(kid(a, 1))) then err("unknown protocol state in", p, lineOf(a)) else ()
    c = tail(c)

// the facts of type decl d at a use: each at(b, S) as the use scope's one cap of b's protocol, required in state S
def typeFacts {r: Region} (ds: Decls, env: Nodes, d: Node, line: I64): Nodes =
  var out = NNil
  var gs = kids(kid(d, 0))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "<") then
      var c = kids(head(gs))
      while !isNil(c) do
        val cap = theCap(env, typeBinderProto(ds, d, text(kid(head(c), 0))), line)
        out = NCons(Node(TyCap, cap, text(kid(head(c), 1)), 0, line, NNil), out)
        c = tail(c)
    else ()
    gs = tail(gs)
  out
