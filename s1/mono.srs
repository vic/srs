// Mono (vic-9l7.4 BD2): the instances of generic defs. A generic def is copied once per distinct type args its calls
// reach (C name f_<name>__<T1>_<T2>), [] binders replaced by the types; its kid 4 then holds the type args (Names).
// A generic extern keeps one C symbol: its [] binders are void* (vic B-Q6), so only pointer types fill them.
// BD2 type args are names the program declares, so the instances are finite and the loop ends.

// a def with [] binders: only its instances are code
def isGeneric(r: Region, d: Node): Bool = kind(d) == DFn && num(d) == 0 && !isNil(tparams(r, d))

// the checked program and the instances it reaches
def mono(r: Region, ds: Nodes): Nodes =
  var todo = NNil
  var c = ds
  while !isNil(c) do
    // a given's defs are reached by its evidence calls, not as roots
    if !isGeneric(r, head(c)) && kind(head(c)) != DGiven then todo = insts(r, head(c), todo) else ()
    c = tail(c)
  var made = NNil
  while !isNil(todo) do
    val x = head(todo)
    todo = tail(todo)
    val f = find(ds, DFn, text(x))
    if num(f) == 1 then needPointers(ds, x)
    else if !isMade(made, x) then
      val g = instantiate(r, f, kids(kid(x, 0)))
      made = NCons(g, made)
      todo = insts(r, kid(g, 2), todo)
    else ()
  val prog = append(r, ds, rev(r, made))
  append(r, prog, enumInsts(r, prog))

// the XInst nodes of e, onto acc
def insts(r: Region, e: Node, acc: Nodes): Nodes =
  var out = if kind(e) == XInst then NCons(e, acc) else acc
  var c = kids(e)
  while !isNil(c) do
    out = insts(r, head(c), out)
    c = tail(c)
  out

// an instance of x's callee at x's type args is made already
def isMade(made: Nodes, x: Node): Bool =
  var c = made
  var res = false
  while !res && !isNil(c) do
    res = eqs(text(head(c)), text(x)) && tysEq(kids(kid(head(c), 4)), kids(kid(x, 0)))
    c = tail(c)
  res

// f with its [] binders replaced by targs; kid 4 = the type args
def instantiate(r: Region, f: Node, targs: Nodes): Node =
  val g = substTy(r, f, tparams(r, f), targs)
  withKids(r, g, NCons(kid(g, 0), NCons(kid(g, 1), NCons(kid(g, 2), NCons(kid(g, 3), one(r, list(r, Names, lineOf(f), targs)))))))

def substTy(r: Region, e: Node, tps: Nodes, targs: Nodes): Node =
  val i = if kind(e) == Ty then index(tps, text(e)) else -1
  if i >= 0 then nth(targs, i)
  else
    var out = NNil
    var c = kids(e)
    while !isNil(c) do
      out = NCons(substTy(r, head(c), tps, targs), out)
      c = tail(c)
    withKids(r, e, rev(r, out))

// an extern's [] binder is a void* slot
def needPointers(ds: Nodes, x: Node): Unit =
  var c = kids(kid(x, 0))
  while !isNil(c) do
    if !isEnum(ds, text(head(c))) && !eqs(text(head(c)), "Ptr") then err("extern [] binder needs a pointer type (void*), not", text(head(c)), lineOf(x)) else ()
    c = tail(c)

// the instances of generic enums the program reaches: each enum T[args] its code names, closed over the fields
def enumInsts(r: Region, ds: Nodes): Nodes =
  val cs = allCases(r, ds)
  var todo = NNil
  var c = ds
  while !isNil(c) do
    val d = head(c)
    // not roots: generic defs and enums, givens (reached by evidence calls), traits (signatures only)
    val generic = isGeneric(r, d) || (kind(d) == DEnum && isGenericEnum(ds, d)) || kind(d) == DGiven || kind(d) == DTrait
    if !generic then todo = applied(r, ds, cs, d, todo) else ()
    c = tail(c)
  var made = NNil
  while !isNil(todo) do
    val t = head(todo)
    todo = tail(todo)
    if !isMadeEnum(made, t) then
      val en = find(ds, DEnum, text(t))
      val inst = enumInst(r, substTy(r, en, enumTParams(r, ds, text(t)), tyArgs(t)), tyArgs(t))
      made = NCons(inst, made)
      todo = applied(r, ds, cs, inst, todo)
    else ()
  rev(r, made)

// the generic enum types e names, onto acc: T[args] types, and the type of each case it builds (XNew)
def applied(r: Region, ds: Nodes, cs: Nodes, e: Node, acc: Nodes): Nodes =
  var out = acc
  if kind(e) == Ty && !isNil(tyArgs(e)) && isEnum(ds, text(e)) then out = NCons(e, out) else ()
  if kind(e) == XNew then out = NCons(Node(Ty, text2(find(cs, DCase, text(e))), "", 0, lineOf(e), one(r, Node(TyTo, "", "", 0, 0, kids(kid(e, 0))))), out) else ()
  var c = kids(e)
  while !isNil(c) do
    out = applied(r, ds, cs, head(c), out)
    c = tail(c)
  out

def isMadeEnum(made: Nodes, t: Node): Bool =
  var c = made
  var res = false
  while !res && !isNil(c) do
    res = eqs(text(head(c)), text(t)) && tysEq(enumArgs(head(c)), tyArgs(t))
    c = tail(c)
  res

// enum d at type args targs: every case keeps them as its kid 1
def enumInst(r: Region, d: Node, targs: Nodes): Node =
  var out = NNil
  var c = kids(d)
  while !isNil(c) do
    out = NCons(withKids(r, head(c), NCons(kid(head(c), 0), one(r, list(r, Names, lineOf(d), targs)))), out)
    c = tail(c)
  withKids(r, d, rev(r, out))
