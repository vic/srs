// <> Datalog facts of a signature (vic-9l7.8 BD5). before the params: what holds on entry; after the result: on exit
// (vic B-Q3: a call is a protocol step). atoms: at(cap, S) = the state of a {} capability, next(S1, op, S2) = a
// transition of its protocol. In a state position an Uppercase name is a state, a lowercase name a variable.
// A def with variables is checked once per solution of its entry facts (vic (a′)): its body must end in the exit
// state of that solution; a call binds the variables from Γ (one solution). Solutions: lib/datalog.srs.
// rules (`rule` decls, prelude): BD5b-2.

// x in a state position is a variable (lowercase), else a state
def isVarName(x: Str): Bool = rt_str_at(x, 0) >= 'a' && rt_str_at(x, 0) <= 'z'

// the value of variable x in the solution sol (Name s = var, t = state), or ""
def solValue(sol: Nodes, x: Str): Str = text2(find(sol, Name, x))

// the state of at(cap, S) in f's fact group out ("" entry, "out" exit) under sol, or "" (absent)
def capState(f: Node, cap: Str, out: Str, sol: Nodes): Str =
  var res = ""
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    val g = head(gs)
    if kind(g) == Group && eqs(text(g), "<") && eqs(text2(g), out) then
      var c = kids(g)
      while !isNil(c) do
        if eqs(text(head(c)), "at") && eqs(text(kid(head(c), 0)), cap) then
          val x = text(kid(head(c), 1))
          res = if isVarName(x) then solValue(sol, x) else x
        else ()
        c = tail(c)
    else ()
    gs = tail(gs)
  res

// the protocol of f's {} binder n, or ""
def binderProto(ds: Nodes, f: Node, n: Str): Str =
  var res = ""
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "{") then
      val b = find(kids(head(gs)), Binder, n)
      if found(b) && isProto(ds, text(kid(b, 0))) then res = text(kid(b, 0)) else ()
    else ()
    gs = tail(gs)
  res

// the protocols of f's {} capabilities, one Name each
def capProtos {r: Region} (ds: Nodes, f: Node): Nodes =
  var out = NNil
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "{") then
      var bs = kids(head(gs))
      while !isNil(bs) do
        val p = text(kid(head(bs), 0))
        if isProto(ds, p) && !has(out, p) then out = NCons(leaf(Name, p, 0), out) else ()
        bs = tail(bs)
    else ()
    gs = tail(gs)
  out

// the protocol of f's caps that has op, or ""
def opProto {r: Region} (ds: Nodes, f: Node, op: Str): Str =
  var res = ""
  var ps = capProtos(ds, f)
  while !isNil(ps) do
    if found(find(kids(kid(find(ds, DProto, text(head(ps))), 3)), DOp, op)) then res = text(head(ps)) else ()
    ps = tail(ps)
  res

// a state position: a variable, or a state of protocol p
def needState(ds: Nodes, p: Str, x: Node): Unit =
  if !isVarName(text(x)) && !has(protoStates(ds, p), text(x)) then err("unknown protocol state in", p, lineOf(x)) else ()

// the variables of the entry fact groups of f, each once, in written order
def entryVars {r: Region} (f: Node): Nodes =
  var out = NNil
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    val g = head(gs)
    if kind(g) == Group && eqs(text(g), "<") && rt_str_len(text2(g)) == 0 then
      var c = kids(g)
      while !isNil(c) do
        var xs = statePos(head(c))
        while !isNil(xs) do
          if isVarName(text(head(xs))) && !has(out, text(head(xs))) then out = NCons(leaf(Name, text(head(xs)), lineOf(head(xs))), out) else ()
          xs = tail(xs)
        c = tail(c)
    else ()
    gs = tail(gs)
  rev(out)

// the state positions of atom a: at(_, S) and next(S1, _, S2)
def statePos {r: Region} (a: Node): Nodes =
  if eqs(text(a), "at") then tail(kids(a))
  else if eqs(text(a), "next") then NCons(kid(a, 0), one(kid(a, 2)))
  else NNil

def hasVars {r: Region} (f: Node): Bool = !isNil(entryVars(f))

// each atom of the fact group g: at(cap, S) or (entry only) next(S1, op, S2); exit variables are entry variables
def needFacts {r: Region} (ds: Nodes, f: Node, g: Node): Unit =
  var c = kids(g)
  var seen = NNil
  while !isNil(c) do
    val a = head(c)
    if eqs(text(a), "at") && len(kids(a)) == 2 then
      val cap = text(kid(a, 0))
      val p = binderProto(ds, f, cap)
      if rt_str_len(p) == 0 then err("at: not a {} capability of this def:", cap, lineOf(a)) else ()
      needState(ds, p, kid(a, 1))
      if has(seen, cap) then err("two states of one capability in a fact group:", cap, lineOf(a)) else ()
      seen = NCons(kid(a, 0), seen)
    else if eqs(text(a), "next") && len(kids(a)) == 3 && rt_str_len(text2(g)) == 0 then
      val p = opProto(ds, f, text(kid(a, 1)))
      if rt_str_len(p) == 0 then err("next: not an op of a capability of this def:", text(kid(a, 1)), lineOf(a)) else ()
      needState(ds, p, kid(a, 0))
      needState(ds, p, kid(a, 2))
    else err("not yet: fact", text(a), lineOf(a))
    if rt_str_len(text2(g)) > 0 then needBound(f, a) else ()
    c = tail(c)

// an exit atom names only entry variables
def needBound {r: Region} (f: Node, a: Node): Unit =
  val vs = entryVars(f)
  var xs = statePos(a)
  while !isNil(xs) do
    if isVarName(text(head(xs))) && !has(vs, text(head(xs))) then err("fact variable not bound by the entry facts:", text(head(xs)), lineOf(a)) else ()
    xs = tail(xs)

// ── solutions (lib/datalog.srs) ──
def toArg {r: Region} (vars: Nodes, x: Str): Arg = if isVarName(x) && has(vars, x) then AVar(index(vars, x)) else AVal(VSym(x))

def toArgs {r: Region} (vars: Nodes, xs: Nodes): Args =
  if isNil(xs) then ArgNil else ArgCons(toArg(vars, text(head(xs))), toArgs(vars, tail(xs)))

// q(vars) :- the entry atoms of f
def query {r: Region} (f: Node, vars: Nodes): Clause =
  var body = LitNil
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    val g = head(gs)
    if kind(g) == Group && eqs(text(g), "<") && rt_str_len(text2(g)) == 0 then
      var c = kids(g)
      while !isNil(c) do
        body = LitCons(Pos(Atom(text(head(c)), toArgs(vars, kids(head(c))))), body)
        c = tail(c)
    else ()
    gs = tail(gs)
  Clause(Atom("q", varArgs(0, len(vars))), body)

def varArgs {r: Region} (i: I64, n: I64): Args = if i >= n then ArgNil else ArgCons(AVar(i), varArgs(i + 1, n))

// the transitions of f's protocols as next(S1, op, S2), onto edb
def nextFacts {r: Region} (ds: Nodes, f: Node, edb: Edb): Edb =
  var out = edb
  var ps = capProtos(ds, f)
  while !isNil(ps) do
    var ops = kids(kid(find(ds, DProto, text(head(ps))), 3))
    while !isNil(ops) do
      var ts = kids(kid(head(ops), 2))
      while !isNil(ts) do
        out = EdbCons(Fact("next", ValCons(VSym(text(head(ts))), ValCons(VSym(text(head(ops))), ValCons(VSym(text2(head(ts))), ValNil)))), out)
        ts = tail(ts)
      ops = tail(ops)
    ps = tail(ps)
  out

// at(cap, S) for each {} capability of f: its state in entry (a call), else every state of its protocol (a def)
def atFacts {r: Region} (ds: Nodes, f: Node, entry: Nodes, edb: Edb): Edb =
  var out = edb
  var gs = kids(kid(f, 4))
  while !isNil(gs) do
    if kind(head(gs)) == Group && eqs(text(head(gs)), "{") then
      var bs = kids(head(gs))
      while !isNil(bs) do
        val cap = text(head(bs))
        val p = text(kid(head(bs), 0))
        if isProto(ds, p) then
          val e = find(entry, Name, cap)
          var ss = if found(e) then one(leaf(Name, text2(e), 0)) else protoStates(ds, p)
          while !isNil(ss) do
            out = EdbCons(Fact("at", ValCons(VSym(cap), ValCons(VSym(text(head(ss))), ValNil))), out)
            ss = tail(ss)
        else ()
        bs = tail(bs)
    else ()
    gs = tail(gs)
  out

// the solutions of f's entry facts: each a list of Name(var, state); entry = Name(cap, state) of a call, or NNil
def solutions {r: Region} (ds: Nodes, f: Node, entry: Nodes): Nodes =
  val vars = entryVars(f)
  evalDatalog(ClCons(query(f, vars), ClNil), atFacts(ds, f, entry, nextFacts(ds, f, EdbNil))) match
    case Unsafe(_) =>
      err("internal: unsafe facts of", text(f), lineOf(f))
      NNil
    case NegCycle(_) =>
      err("internal: negation in facts of", text(f), lineOf(f))
      NNil
    case Model(db) => qSols(vars, db, lineOf(f))

// the q facts of a model, each as a solution, in model order
def qSols {r: Region} (vars: Nodes, db: Facts, line: I64): Nodes = db match
  case FactNil => NNil
  case FactCons(h, _, t) => h match
    case Fact(rel, vs) => if eqs(rel, "q") then NCons(list(Names, line, solOf(vars, vs)), qSols(vars, t, line)) else qSols(vars, t, line)

// var i = state i
def solOf {r: Region} (vars: Nodes, vs: Vals): Nodes =
  if isNil(vars) then NNil
  else vs match
    case ValNil => NNil
    case ValCons(v, t) => NCons(Node(Name, text(head(vars)), symOf(v), 0, 0, NNil), solOf(tail(vars), t))

def symOf(v: Val): Str = v match
  case VSym(s) => s
  case VInt(_) => ""

// the one solution of f's entry facts at a call: Γ gives each capability's state (entry)
def callSol {r: Region} (ds: Nodes, f: Node, entry: Nodes, line: I64): Nodes =
  val ss = solutions(ds, f, entry)
  if isNil(ss) then err("entry facts do not hold at the call of", text(f), line) else ()
  if !isNil(tail(ss)) then err("entry facts have more than one solution at the call of", text(f), line) else ()
  kids(head(ss))

// the solution a def's body and its C/Lean output use: the first one (states are erased in C and Lean), or NNil
def defSol {r: Region} (ds: Nodes, f: Node): Nodes = if hasVars(f) then kids(head(solutions(ds, f, NNil))) else NNil

// the entry of a call: each callee capability (m: GState s = callee binder, t = caller cap) at its state in Γ
def capEntry {r: Region} (m: Nodes, gam: Nodes): Nodes =
  if isNil(m) then NNil else NCons(Node(Name, text(head(m)), state(gam, text2(head(m))), 0, 0, NNil), capEntry(tail(m), gam))
