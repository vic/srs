// S1 Lean backend (C10 C11, vic/c/lean-backend.md): `s1 --lean files > X.lean`, so proofs target the srs impl.
// fn = Option-monad def + partial_fixpoint (none = exit). while = aux def `<fn>_w<line>` over the scope vars,
// returning the vars it assigns. regions and caps erased: values are immutable data. bracketed do: no layout.

def put(on: Bool, s: Str): Unit = if on then say(s) else ()
def putn(on: Bool, n: I64): Unit = if on then sayn(n) else ()
def lid(on: Bool, s: Str): Unit =
  put(on, "«")
  put(on, s)
  put(on, "»")

def lty(t: Node): Unit =
  val n = text(t)
  if eqs(n, "I64") then say("Int")
  else if eqs(n, "Str") then say("ByteArray")
  else if eqs(n, "Bool") || eqs(n, "Unit") then say(n)
  else lid(true, n)

def ctorName {r: Region} (on: Bool, ds: Decls, name: Str): Unit =
  lid(on, text2(findDecl(ds, DCase, name)))
  put(on, ".")
  lid(on, name)

def emitLean {r: Region} (ds0: Decls, ns: Str): Unit =
  // the call graph and its SCCs, once (Tarjan); ds knows the recursive fns
  val g = callGraph(ds0)
  val gm = dmAddAll(DTip, g)
  val sm = sccMap(gm, g)
  val ds = withRec(ds0, recSet(gm, sm, g))
  say("-- DO-NOT-EDIT. Generated by s1 --lean (s1/lean.srs, s1/leanspec.srs).\nimport Srs.Rt\nimport Srs.Auto\nset_option autoImplicit false\nnamespace Srs.")
  say(ns)
  say("\nopen Srs.Rt\n\n")
  // nullary enums alone, with decidable equality (`==` on them is lawful in proofs); data enums: one mutual block
  var c = declList(ds)
  while !isNil(c) do
    if kind(head(c)) == DEnum && nullary(head(c)) then
      leanEnum(head(c))
      say("  deriving DecidableEq\n")
    else ()
    c = tail(c)
  say("mutual\n")
  c = declList(ds)
  while !isNil(c) do
    if kind(head(c)) == DEnum && !nullary(head(c)) then leanEnum(head(c)) else ()
    c = tail(c)
  say("end\n\n")
  // spec defs: pure, before the impl (contracts use them)
  c = declList(ds)
  while !isNil(c) do
    if kind(head(c)) == DFn && num(head(c)) == 2 then specDef(ds, head(c)) else ()
    c = tail(c)
  specTheorems(ds)
  // each call-graph SCC after the SCCs it calls: a cycle = one mutual block, else a plain def (Lean needs
  // partial_fixpoint exactly on recursive defs)
  var done = DTip
  var more = true
  while more do
    more = false
    c = declList(ds)
    while !isNil(c) do
      val d = head(c)
      if kind(d) == DFn && num(d) == 0 && !inSet(done, text(d)) then
        val sc = sccOf(sm, text(d))
        if depsDone(gm, sc, done) then
          val rec = recIn(gm, sm, text(d))
          if rec then say("mutual\n") else ()
          var m = declList(ds)
          while !isNil(m) do
            if kind(head(m)) == DFn && has(sc, text(head(m))) then leanFn(ds, head(m), rec) else ()
            m = tail(m)
          if rec then say("end\n\n") else ()
          done = dmAddAll(done, sc)
          more = true
        else ()
      else ()
      c = tail(c)
  verification(ds)
  say("end Srs.")
  say(ns)
  say("\n")

// call graph: Name(s = fn, a = the user fns its body calls)
def callGraph {r: Region} (ds: Decls): Nodes =
  var out = NNil
  var c = declList(ds)
  while !isNil(c) do
    val d = head(c)
    if kind(d) == DFn && num(d) == 0 then out = NCons(Node(Name, text(d), "", 0, 0, callsOf(ds, kid(d, 2), NNil)), out) else ()
    c = tail(c)
  out

// the user fns e calls
def callsOf {r: Region} (ds: Decls, e: Node, acc: Nodes): Nodes =
  var out = acc
  if kind(e) == XCall then
    val f = findDecl(ds, DFn, text(e))
    if found(f) && num(f) == 0 && !has(out, text(e)) then out = NCons(leaf(Name, text(e), 0), out) else ()
  else ()
  var c = kids(e)
  while !isNil(c) do
    out = callsOf(ds, head(c), out)
    c = tail(c)
  out

def nullary(d: Node): Bool =
  var cs = kids(d)
  var ok = true
  while ok && !isNil(cs) do
    ok = isNil(kids(kid(head(cs), 0)))
    cs = tail(cs)
  ok

def leanEnum(d: Node): Unit =
  say("inductive ")
  lid(true, text(d))
  say(" where\n")
  var cs = kids(d)
  while !isNil(cs) do
    say("  | ")
    lid(true, text(head(cs)))
    var fs = kids(kid(head(cs), 0))
    while !isNil(fs) do
      say(" (")
      lid(true, text(head(fs)))
      say(" : ")
      lty(kid(head(fs), 0))
      say(")")
      fs = tail(fs)
    say("\n")
    cs = tail(cs)

def leanFn {r: Region} (ds: Decls, f: Node, fix: Bool): Unit =
  val ps = kids(kid(f, 0))
  val env = fnEnv(ds, sigParams(ds, f, defSol(ds, f)))
  val gam = fnGam(ds, sigParams(ds, f, defSol(ds, f)))
  // pass 1: the aux defs of its loops
  ls(ds, text(f), env, gam, kid(f, 2), false, 1)
  say("def ")
  lid(true, text(f))
  var c = ps
  while !isNil(c) do
    if !isProto(ds, text(kid(head(c), 0))) then
      say(" (")
      lid(true, text(head(c)))
      say(" : ")
      lty(kid(head(c), 0))
      say(")")
    else ()
    c = tail(c)
  say(" : Option ")
  lty(kid(f, 1))
  say(" := do {\n")
  ls(ds, text(f), env, gam, kid(f, 2), true, 1)
  say(if fix then "}\npartial_fixpoint\n\n" else "}\n\n")

// e as a do sequence. mode 1 = its value ends the sequence, 0 = discarded (Unit items)
def ls {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool, mode: I64): Unit =
  val k = kind(e)
  if k == XBlock then lsBlock(ds, fn, env, gam, kids(e), on, mode)
  else if k == XIf then
    put(on, "if ")
    lx(ds, fn, env, gam, kid(e, 0), on)
    put(on, " then {\n")
    ls(ds, fn, env, gam, kid(e, 1), on, mode)
    put(on, "} else {\n")
    ls(ds, fn, env, gam, kid(e, 2), on, mode)
    put(on, "};\n")
  else if k == XMatch then lsMatch(ds, fn, env, gam, e, on, mode)
  else if k == XWhile then
    if on then lsLoop(ds, fn, env, e, mode)
    else
      // nested loops first: an aux def comes after the defs it calls
      lx(ds, fn, env, gam, kid(e, 0), false)
      ls(ds, fn, env, gam, kid(e, 1), false, 0)
      leanAux(ds, fn, env, gam, e)
  else if k == XAssign then
    lid(on, text(e))
    put(on, " := ")
    lx(ds, fn, env, gam, kid(e, 0), on)
    put(on, ";\n")
    if mode == 1 then put(on, "pure ()\n") else ()
  else
    put(on, if mode == 1 then "pure " else "let _ := ")
    lx(ds, fn, env, gam, e, on)
    put(on, ";\n")

def lsBlock {r: Region} (ds: Decls, fn: Str, env0: Nodes, gam0: Nodes, ss: Nodes, on: Bool, mode: I64): Unit =
  var env = env0
  var gam = gam0
  var c = ss
  if isNil(c) then put(on, "pure ();\n") else ()
  while !isNil(c) do
    val s = head(c)
    val last = isNil(tail(c))
    if kind(s) == SClause then
      if last then put(on, if mode == 1 then "pure ()\n" else "") else ()
    else if kind(s) == SVal then
      put(on, if num(s) == 1 then "let mut " else "let ")
      lid(on, text(s))
      // val = bind (a lambda binder): partial_fixpoint cannot split a match on a let-variable
      if num(s) == 1 then
        put(on, " := ")
        lx(ds, fn, env, gam, kid(s, 0), on)
      else
        put(on, " ← ")
        lxAct(ds, fn, env, gam, kid(s, 0), on)
      put(on, ";\n")
      // the checker's own type of the bound value: the Lean types of the loop aux params
      val x = chk(ds, env, gam, kid(s, 0), NoNode)
      val t = if !isNil(tail(kids(s))) then kid(s, 1) else if num(s) == 1 then uncapped(text(tgTy(x))) else tgTy(x)
      gam = tgGam(x)
      env = NCons(Node(BVar, text(s), "", num(s), lineOf(s), one(t)), env)
      if last then put(on, "pure ();\n") else ()
    else if kind(s) == SHandle then
      // erased: values are immutable data in Lean; the cap is bound so the rest re-checks
      val p = findDecl(ds, DProto, text2(findDecl(ds, DHandler, text2(s))))
      env = NCons(Node(BVar, text(s), text(p), 2, lineOf(s), one(mkTy(text(p), NNil))), env)
      gam = NCons(Node(GState, text(s), text2(p), 0, 0, NNil), gam)
      if last then put(on, "pure ();\n") else ()
    else
      ls(ds, fn, env, gam, s, on, if last then mode else 0)
      gam = tgGam(chk(ds, env, gam, s, NoNode))
    c = tail(c)

def lsMatch {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool, mode: I64): Unit =
  put(on, "match ")
  lx(ds, fn, env, gam, kid(e, 0), on)
  put(on, " with\n")
  val sx = chk(ds, env, gam, kid(e, 0), NoNode)
  val en = findDecl(ds, DEnum, text(tgTy(sx)))
  var arms = tail(kids(e))
  while !isNil(arms) do
    val arm = head(arms)
    var env2 = env
    put(on, "| ")
    if eqs(text(arm), "_") then put(on, "_")
    else
      ctorName(on, ds, text(arm))
      var bs = tail(kids(arm))
      var fs = kids(kid(find(kids(en), DCase, text(arm)), 0))
      while !isNil(bs) do
        put(on, " ")
        if eqs(text(head(bs)), "_") then put(on, "_") else lid(on, text(head(bs)))
        env2 = NCons(Node(BVar, text(head(bs)), "", 0, lineOf(arm), one(kid(head(fs), 0))), env2)
        bs = tail(bs)
        fs = tail(fs)
    put(on, " => {\n")
    ls(ds, fn, env2, tgGam(sx), kid(arm, 0), on, mode)
    put(on, "}\n")
    arms = tail(arms)
  put(on, ";\n")

// vars in scope, innermost binding of each name; caps erased
def scope {r: Region} (env: Nodes): Nodes =
  var out = NNil
  var c = env
  while !isNil(c) do
    if num(head(c)) != 2 && !found(find(out, BVar, text(head(c)))) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(out)
def assigned {r: Region} (e: Node, acc: Nodes): Nodes =
  var out = if kind(e) == XAssign && !has(acc, text(e)) then NCons(leaf(Name, text(e), 0), acc) else acc
  var c = kids(e)
  while !isNil(c) do
    out = assigned(head(c), out)
    c = tail(c)
  out
// the scope vars a loop body assigns: the loop aux returns them
def mutated {r: Region} (sc: Nodes, body: Node): Nodes =
  val names = assigned(body, NNil)
  var out = NNil
  var c = sc
  while !isNil(c) do
    if has(names, text(head(c))) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(out)

// loop aux name = <fn>_loop<k>, k = loops of the fn on earlier lines: stable under edits outside the fn
def auxName(ds: Decls, on: Bool, fn: Str, e: Node): Unit =
  put(on, "«")
  put(on, fn)
  put(on, "_loop")
  putn(on, loopsBefore(kid(findDecl(ds, DFn, fn), 2), lineOf(e)))
  put(on, "»")
def loopsBefore(e: Node, line: I64): I64 =
  var n = if kind(e) == XWhile && lineOf(e) < line then 1 else 0
  var c = kids(e)
  while !isNil(c) do
    n = n + loopsBefore(head(c), line)
    c = tail(c)
  n
def auxArgs(on: Bool, sc: Nodes): Unit =
  var c = sc
  while !isNil(c) do
    put(on, " ")
    lid(on, text(head(c)))
    c = tail(c)
def tuple(on: Bool, mu: Nodes): Unit =
  if isNil(mu) then put(on, "()")
  else if isNil(tail(mu)) then lid(on, text(head(mu)))
  else
    put(on, "(")
    var c = mu
    while !isNil(c) do
      lid(on, text(head(c)))
      if !isNil(tail(c)) then put(on, ", ") else ()
      c = tail(c)
    put(on, ")")
def tupleTy(mu: Nodes): Unit =
  if isNil(mu) then say("Unit")
  else
    say("(")
    var c = mu
    while !isNil(c) do
      lty(kid(head(c), 0))
      if !isNil(tail(c)) then say(" × ") else ()
      c = tail(c)
    say(")")
// component i of an n-tuple (a, (b, c)): .2 i times, then .1 unless last
def proj(i: I64, n: I64): Unit =
  var k = 0
  while k < i do
    say(".2")
    k = k + 1
  if i < n - 1 then say(".1") else ()

def lsLoop {r: Region} (ds: Decls, fn: Str, env: Nodes, e: Node, mode: I64): Unit =
  val sc = scope(env)
  val mu = mutated(sc, kid(e, 1))
  say("let t_ ← ")
  auxName(ds, true, fn, e)
  auxArgs(true, captured(sc, mu))
  say(" ")
  tuple(true, mu)
  say(";\n")
  var c = mu
  var i = 0
  while !isNil(c) do
    lid(true, text(head(c)))
    say(" := t_")
    if len(mu) > 1 then proj(i, len(mu)) else ()
    say(";\n")
    i = i + 1
    c = tail(c)
  if mode == 1 then say("pure ()\n") else ()

def leanAux {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, e: Node): Unit =
  val sc = scope(env)
  val mu = mutated(sc, kid(e, 1))
  // canonical shape, the one Srs.loop_inv covers: aux cap st = do if (← cond st) then aux cap (← body st) else pure st
  say("def ")
  auxName(ds, true, fn, e)
  var c = captured(sc, mu)
  while !isNil(c) do
    say(" (")
    lid(true, text(head(c)))
    say(" : ")
    lty(kid(head(c), 0))
    say(")")
    c = tail(c)
  say(" (st' : ")
  tupleTy(mu)
  say(") : Option ")
  tupleTy(mu)
  say(" := do {\nif (← (fun (")
  tupleUsed(mu, kid(e, 0))
  say(" : ")
  tupleTy(mu)
  say(") => (do {\npure ")
  lx(ds, fn, env, gam, kid(e, 0), true)
  say("\n} : Option Bool)) st') then ")
  auxName(ds, true, fn, e)
  auxArgs(true, captured(sc, mu))
  say(" (← (fun (")
  tuple(true, mu)
  say(" : ")
  tupleTy(mu)
  say(") => (do {\n")
  c = mu
  while !isNil(c) do
    say("let mut ")
    lid(true, text(head(c)))
    say(" := ")
    lid(true, text(head(c)))
    say(";\n")
    c = tail(c)
  ls(ds, fn, env, gam, kid(e, 1), true, 0)
  say("pure ")
  tuple(true, mu)
  say("\n} : Option ")
  tupleTy(mu)
  say(")) st') else pure st'\n}\npartial_fixpoint\n\n")

// the tuple pattern, `_` for vars e does not read
def tupleUsed(mu: Nodes, e: Node): Unit =
  if isNil(mu) then say("()")
  else if isNil(tail(mu)) then useOr(head(mu), e)
  else
    say("(")
    var c = mu
    while !isNil(c) do
      useOr(head(c), e)
      if !isNil(tail(c)) then say(", ") else ()
      c = tail(c)
    say(")")
def useOr(v: Node, e: Node): Unit = if reads(e, text(v)) then lid(true, text(v)) else say("_")
def reads(e: Node, x: Str): Bool =
  var hit = kind(e) == XName && eqs(text(e), x)
  var c = kids(e)
  while !hit && !isNil(c) do
    hit = reads(head(c), x)
    c = tail(c)
  hit

// the scope vars a loop reads but does not assign
def captured {r: Region} (sc: Nodes, mu: Nodes): Nodes =
  var out = NNil
  var c = sc
  while !isNil(c) do
    if !found(find(mu, BVar, text(head(c)))) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(out)

// e as a Lean term; effects lifted with (← ..) in srs order; control in value position = a nested do
def lx {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool): Unit =
  val k = kind(e)
  if k == XInt then
    put(on, "(")
    putn(on, num(e))
    put(on, " : Int)")
  else if k == XBool then put(on, if num(e) == 1 then "true" else "false")
  else if k == XStr then
    put(on, "\"")
    put(on, text(e))
    put(on, "\".toUTF8")
  else if k == XUnit then put(on, "()")
  else if k == XName then
    if found(find(env, BVar, text(e))) then lid(on, text(e)) else ctorName(on, ds, text(e))
  else if k == XCall then
    val c = findDecl(ds, DCase, text(e))
    if found(c) then
      put(on, "(")
      ctorName(on, ds, text(e))
      lxArgs(ds, fn, env, gam, kids(e), NNil, on)
      put(on, ")")
    else
      put(on, "(← ")
      lid(on, text(e))
      lxArgs(ds, fn, env, gam, kids(e), kids(kid(findDecl(ds, DFn, text(e)), 0)), on)
      put(on, ")")
  else if k == XBin then lxBin(ds, fn, env, gam, e, on)
  else if k == XUn then
    put(on, if eqs(text(e), "-") then "(0 - " else "(!")
    lx(ds, fn, env, gam, kid(e, 0), on)
    put(on, ")")
  else if k == XMethod then put(on, "srs_unsupported_method")
  else
    put(on, "(← (do {\n")
    ls(ds, fn, env, gam, e, on, 1)
    put(on, "}))")

// e as a monadic action: lx without the outer `(← )` lift
def lxAct {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool): Unit =
  put(on, "(pure ")
  lx(ds, fn, env, gam, e, on)
  put(on, ")")

// call args; an arg at a capability param is erased
def lxArgs {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, xs: Nodes, ps0: Nodes, on: Bool): Unit =
  var a = xs
  var ps = ps0
  while !isNil(a) do
    val cap = !isNil(ps) && isProto(ds, text(kid(head(ps), 0)))
    if !cap then
      put(on, " ")
      lx(ds, fn, env, gam, head(a), on)
    else ()
    a = tail(a)
    ps = if isNil(ps) then ps else tail(ps)

def lxBin {r: Region} (ds: Decls, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool): Unit =
  val op = text(e)
  if eqs(op, "&&") || eqs(op, "||") then
    // short-circuit: b runs only when a does not decide
    put(on, "(← (do {\nif ")
    lx(ds, fn, env, gam, kid(e, 0), on)
    if eqs(op, "&&") then
      put(on, " then {\npure ")
      lx(ds, fn, env, gam, kid(e, 1), on)
      put(on, "\n} else {\npure false\n}\n}))")
    else
      put(on, " then {\npure true\n} else {\npure ")
      lx(ds, fn, env, gam, kid(e, 1), on)
      put(on, "\n}\n}))")
  else
    val cmp = eqs(op, "<") || eqs(op, "<=") || eqs(op, ">") || eqs(op, ">=")
    put(on, if cmp then "(decide (" else if eqs(op, "/") then "(Int.tdiv " else if eqs(op, "%") then "(Int.tmod " else "(")
    lx(ds, fn, env, gam, kid(e, 0), on)
    put(on, " ")
    if !eqs(op, "/") && !eqs(op, "%") then
      put(on, op)
      put(on, " ")
    else ()
    lx(ds, fn, env, gam, kid(e, 1), on)
    put(on, if cmp then "))" else ")")

// ── call-graph SCCs in one pass (vic-qf6, speed): Tarjan 1972, "Depth-first search and linear graph algorithms" ──
// info of a visited fn: Node(Name, f, "1" while on the stack else "", index, lowlink); a newer entry shadows an older one
enum Tarjan:
  case Tarjan(next: I64, info: DMap, stack: Nodes, comps: Nodes)

// g's node of f: Name(f, its callees)
def gGet(gm: DMap, f: Str): Node = find(dmGet(gm, strHash(f)), Name, f)

def inSet(m: DMap, x: Str): Bool = found(find(dmGet(m, strHash(x)), Name, x))

def tInfo(st: Tarjan, f: Str): Node = st match
  case Tarjan(_, info, _, _) => find(dmGet(info, strHash(f)), Name, f)

def tSet {r: Region} (st: Tarjan, x: Node): Tarjan = st match
  case Tarjan(n, info, stack, comps) => Tarjan(n, dmAdd(info, strHash(text(x)), x), stack, comps)

// lowlink(v) = min(lowlink(v), x)
def tLow {r: Region} (st: Tarjan, v: Str, x: I64): Tarjan =
  val iv = tInfo(st, v)
  if x < lineOf(iv) then tSet(st, Node(Name, v, text2(iv), num(iv), x, NNil)) else st

def tVisit {r: Region} (gm: DMap, v: Str, st0: Tarjan): Tarjan = st0 match
  case Tarjan(n, info, stack, comps) =>
    var st = Tarjan(n + 1, dmAdd(info, strHash(v), Node(Name, v, "1", n, n, NNil)), NCons(leaf(Name, v, 0), stack), comps)
    var c = kids(gGet(gm, v))
    while !isNil(c) do
      val w = text(head(c))
      val iw = tInfo(st, w)
      if !found(iw) then
        st = tVisit(gm, w, st)
        st = tLow(st, v, lineOf(tInfo(st, w)))
      else if eqs(text2(iw), "1") then st = tLow(st, v, num(iw))
      else ()
      c = tail(c)
    val iv = tInfo(st, v)
    if lineOf(iv) == num(iv) then tPop(st, v) else st

// v roots a component: pop it off the stack
def tPop {r: Region} (st0: Tarjan, v: Str): Tarjan = st0 match
  case Tarjan(n, info0, stack0, comps) =>
    var info = info0
    var stack = stack0
    var members = NNil
    var go = true
    while go && !isNil(stack) do
      val w = text(head(stack))
      val iw = find(dmGet(info, strHash(w)), Name, w)
      info = dmAdd(info, strHash(w), Node(Name, w, "", num(iw), lineOf(iw), NNil))
      members = NCons(leaf(Name, w, 0), members)
      stack = tail(stack)
      go = !eqs(w, v)
    Tarjan(n, info, stack, NCons(Node(Names, "", "", 0, 0, members), comps))

// fn -> Name(fn, the members of its SCC)
def sccMap {r: Region} (gm: DMap, g: Nodes): DMap =
  var st = Tarjan(0, DTip, NNil, NNil)
  var c = g
  while !isNil(c) do
    if !found(tInfo(st, text(head(c)))) then st = tVisit(gm, text(head(c)), st) else ()
    c = tail(c)
  var out = DTip
  var cs = tComps(st)
  while !isNil(cs) do
    var m = kids(head(cs))
    while !isNil(m) do
      out = dmAdd(out, strHash(text(head(m))), Node(Name, text(head(m)), "", 0, 0, kids(head(cs))))
      m = tail(m)
    cs = tail(cs)
  out

def tComps(st: Tarjan): Nodes = st match
  case Tarjan(_, _, _, comps) => comps

def sccOf(sm: DMap, f: Str): Nodes = kids(find(dmGet(sm, strHash(f)), Name, f))

// f is recursive: its SCC has 2+ fns, or f calls itself
def recIn(gm: DMap, sm: DMap, f: Str): Bool = len(sccOf(sm, f)) > 1 || has(kids(gGet(gm, f)), f)

// every callee of sc is in sc or done
def depsDone(gm: DMap, sc: Nodes, done: DMap): Bool =
  var ok = true
  var c = sc
  while ok && !isNil(c) do
    var w = kids(gGet(gm, text(head(c))))
    while ok && !isNil(w) do
      ok = inSet(done, text(head(w))) || has(sc, text(head(w)))
      w = tail(w)
    c = tail(c)
  ok

// the fns in a cycle of the call graph
def recSet {r: Region} (gm: DMap, sm: DMap, g: Nodes): DMap =
  var out = DTip
  var c = g
  while !isNil(c) do
    if recIn(gm, sm, text(head(c))) then out = dmAdd(out, strHash(text(head(c))), leaf(Name, text(head(c)), 0)) else ()
    c = tail(c)
  out
