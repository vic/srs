// S1 Lean backend (C10 C11, vic/c/lean-backend.md): `s1 --lean files > X.lean`, so proofs target the srs impl.
// fn = Option-monad def + partial_fixpoint (none = exit). while = aux def `<fn>_w<line>` over the scope vars,
// returning the vars it assigns. regions and caps erased: values are immutable data. bracketed do: no layout.

def put(on: Bool, s: Str): Unit = if on then say(s) else ()
def putn(on: Bool, n: I64): Unit = if on then sayn(n) else ()
def lid(on: Bool, s: Str): Unit =
  put(on, "«")
  put(on, s)
  put(on, "»")

def lty(t: Node): Unit =
  val n = text(t)
  if eqs(n, "I64") then say("Int")
  else if eqs(n, "Str") then say("ByteArray")
  else if eqs(n, "Bool") || eqs(n, "Unit") then say(n)
  else lid(true, n)

def ctorName(r: Region, on: Bool, ds: Nodes, name: Str): Unit =
  lid(on, text2(find(allCases(r, ds), DCase, name)))
  put(on, ".")
  lid(on, name)

def emitLean(r: Region, ds: Nodes, ns: Str): Unit =
  say("-- DO-NOT-EDIT. Generated by s1 --lean (s1/lean.srs, s1/leanspec.srs).\nimport Srs.Rt\nimport Srs.Auto\nset_option autoImplicit false\nnamespace Srs.")
  say(ns)
  say("\nopen Srs.Rt\n\n")
  // nullary enums alone, with decidable equality (`==` on them is lawful in proofs); data enums: one mutual block
  var c = ds
  while !isNil(c) do
    if kind(head(c)) == DEnum && nullary(head(c)) then
      leanEnum(head(c))
      say("  deriving DecidableEq\n")
    else ()
    c = tail(c)
  say("mutual\n")
  c = ds
  while !isNil(c) do
    if kind(head(c)) == DEnum && !nullary(head(c)) then leanEnum(head(c)) else ()
    c = tail(c)
  say("end\n\n")
  // spec defs: pure, before the impl (contracts use them)
  c = ds
  while !isNil(c) do
    if kind(head(c)) == DFn && num(head(c)) == 2 then specDef(r, ds, head(c)) else ()
    c = tail(c)
  // each call-graph SCC after the SCCs it calls: a cycle = one mutual block, else a plain def (Lean needs
  // partial_fixpoint exactly on recursive defs)
  val g = callGraph(r, ds)
  var done = NNil
  var more = true
  while more do
    more = false
    c = ds
    while !isNil(c) do
      val d = head(c)
      if kind(d) == DFn && num(d) == 0 && !has(done, text(d)) then
        val sc = scc(r, g, text(d))
        if subset(deps(r, g, sc), append(r, sc, done)) then
          val rec = len(sc) > 1 || has(reach(r, g, text(d)), text(d))
          if rec then say("mutual\n") else ()
          var m = ds
          while !isNil(m) do
            if kind(head(m)) == DFn && has(sc, text(head(m))) then leanFn(r, ds, head(m), rec) else ()
            m = tail(m)
          if rec then say("end\n\n") else ()
          done = append(r, sc, done)
          more = true
        else ()
      else ()
      c = tail(c)
  verification(r, ds)
  say("end Srs.")
  say(ns)
  say("\n")

// call graph: Name(s = fn, a = the user fns its body calls)
def callGraph(r: Region, ds: Nodes): Nodes =
  var out = NNil
  var c = ds
  while !isNil(c) do
    val d = head(c)
    if kind(d) == DFn && num(d) == 0 then out = NCons(Node(Name, text(d), "", 0, 0, callsOf(r, ds, kid(d, 2), NNil)), out) else ()
    c = tail(c)
  out
// the fns f reaches in one or more calls
def reach(r: Region, g: Nodes, f: Str): Nodes =
  var seen = NNil
  var todo = kids(find(g, Name, f))
  while !isNil(todo) do
    val n = text(head(todo))
    todo = tail(todo)
    if !has(seen, n) then
      seen = NCons(leaf(r, Name, n, 0), seen)
      todo = append(r, kids(find(g, Name, n)), todo)
    else ()
  seen
// the strongly connected component of f: f and every fn that f reaches and that reaches f
def scc(r: Region, g: Nodes, f: Str): Nodes =
  var out = one(r, leaf(r, Name, f, 0))
  var c = reach(r, g, f)
  while !isNil(c) do
    if !eqs(text(head(c)), f) && has(reach(r, g, text(head(c))), f) then out = NCons(head(c), out) else ()
    c = tail(c)
  out
// the fns the members of sc call
def deps(r: Region, g: Nodes, sc: Nodes): Nodes =
  var out = NNil
  var c = sc
  while !isNil(c) do
    out = append(r, kids(find(g, Name, text(head(c)))), out)
    c = tail(c)
  out

// the user fns e calls
def callsOf(r: Region, ds: Nodes, e: Node, acc: Nodes): Nodes =
  var out = acc
  if kind(e) == XCall then
    val f = find(ds, DFn, text(e))
    if found(f) && num(f) == 0 && !has(out, text(e)) then out = NCons(leaf(r, Name, text(e), 0), out) else ()
  else ()
  var c = kids(e)
  while !isNil(c) do
    out = callsOf(r, ds, head(c), out)
    c = tail(c)
  out

def nullary(d: Node): Bool =
  var cs = kids(d)
  var ok = true
  while ok && !isNil(cs) do
    ok = isNil(kids(kid(head(cs), 0)))
    cs = tail(cs)
  ok

def leanEnum(d: Node): Unit =
  say("inductive ")
  lid(true, text(d))
  say(" where\n")
  var cs = kids(d)
  while !isNil(cs) do
    say("  | ")
    lid(true, text(head(cs)))
    var fs = kids(kid(head(cs), 0))
    while !isNil(fs) do
      say(" (")
      lid(true, text(head(fs)))
      say(" : ")
      lty(kid(head(fs), 0))
      say(")")
      fs = tail(fs)
    say("\n")
    cs = tail(cs)

def leanFn(r: Region, ds: Nodes, f: Node, fix: Bool): Unit =
  val ps = kids(kid(f, 0))
  val env = fnEnv(r, ds, ps)
  val gam = fnGam(r, ds, ps)
  // pass 1: the aux defs of its loops
  ls(r, ds, text(f), env, gam, kid(f, 2), false, 1)
  say("def ")
  lid(true, text(f))
  var c = ps
  while !isNil(c) do
    if !isProto(ds, text(kid(head(c), 0))) then
      say(" (")
      lid(true, text(head(c)))
      say(" : ")
      lty(kid(head(c), 0))
      say(")")
    else ()
    c = tail(c)
  say(" : Option ")
  lty(kid(f, 1))
  say(" := do {\n")
  ls(r, ds, text(f), env, gam, kid(f, 2), true, 1)
  say(if fix then "}\npartial_fixpoint\n\n" else "}\n\n")

// e as a do sequence. mode 1 = its value ends the sequence, 0 = discarded (Unit items)
def ls(r: Region, ds: Nodes, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool, mode: I64): Unit =
  val k = kind(e)
  if k == XBlock then lsBlock(r, ds, fn, env, gam, kids(e), on, mode)
  else if k == XIf then
    put(on, "if ")
    lx(r, ds, fn, env, gam, kid(e, 0), on)
    put(on, " then {\n")
    ls(r, ds, fn, env, gam, kid(e, 1), on, mode)
    put(on, "} else {\n")
    ls(r, ds, fn, env, gam, kid(e, 2), on, mode)
    put(on, "};\n")
  else if k == XMatch then lsMatch(r, ds, fn, env, gam, e, on, mode)
  else if k == XWhile then
    if on then lsLoop(r, ds, fn, env, e, mode)
    else
      // nested loops first: an aux def comes after the defs it calls
      lx(r, ds, fn, env, gam, kid(e, 0), false)
      ls(r, ds, fn, env, gam, kid(e, 1), false, 0)
      leanAux(r, ds, fn, env, gam, e)
  else if k == XAssign then
    lid(on, text(e))
    put(on, " := ")
    lx(r, ds, fn, env, gam, kid(e, 0), on)
    put(on, ";\n")
    if mode == 1 then put(on, "pure ()\n") else ()
  else
    put(on, if mode == 1 then "pure " else "let _ := ")
    lx(r, ds, fn, env, gam, e, on)
    put(on, ";\n")

def lsBlock(r: Region, ds: Nodes, fn: Str, env0: Nodes, gam0: Nodes, ss: Nodes, on: Bool, mode: I64): Unit =
  var env = env0
  var gam = gam0
  var c = ss
  if isNil(c) then put(on, "pure ();\n") else ()
  while !isNil(c) do
    val s = head(c)
    val last = isNil(tail(c))
    if kind(s) == SClause then
      if last then put(on, if mode == 1 then "pure ()\n" else "") else ()
    else if kind(s) == SVal then
      put(on, if num(s) == 1 then "let mut " else "let ")
      lid(on, text(s))
      put(on, " := ")
      lx(r, ds, fn, env, gam, kid(s, 0), on)
      put(on, ";\n")
      // the checker's own type of the bound value: the Lean types of the loop aux params
      val x = chk(r, ds, env, gam, kid(s, 0))
      val t = if !isNil(tail(kids(s))) then kid(s, 1) else if num(s) == 1 then uncapped(r, text(tgTy(x))) else tgTy(x)
      gam = tgGam(x)
      env = NCons(Node(BVar, text(s), "", num(s), lineOf(s), one(r, t)), env)
      if last then put(on, "pure ();\n") else ()
    else if kind(s) == SHandle then
      // erased: values are immutable data in Lean; the cap is bound so the rest re-checks
      val p = find(ds, DProto, text2(find(ds, DHandler, text2(s))))
      env = NCons(Node(BVar, text(s), text(p), 2, lineOf(s), one(r, mkTy(r, text(p), NNil))), env)
      gam = NCons(Node(GState, text(s), text2(p), 0, 0, NNil), gam)
      if last then put(on, "pure ();\n") else ()
    else
      ls(r, ds, fn, env, gam, s, on, if last then mode else 0)
      gam = tgGam(chk(r, ds, env, gam, s))
    c = tail(c)

def lsMatch(r: Region, ds: Nodes, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool, mode: I64): Unit =
  put(on, "match ")
  lx(r, ds, fn, env, gam, kid(e, 0), on)
  put(on, " with\n")
  val sx = chk(r, ds, env, gam, kid(e, 0))
  val en = find(ds, DEnum, text(tgTy(sx)))
  var arms = tail(kids(e))
  while !isNil(arms) do
    val arm = head(arms)
    var env2 = env
    put(on, "| ")
    if eqs(text(arm), "_") then put(on, "_")
    else
      ctorName(r, on, ds, text(arm))
      var bs = tail(kids(arm))
      var fs = kids(kid(find(kids(en), DCase, text(arm)), 0))
      while !isNil(bs) do
        put(on, " ")
        if eqs(text(head(bs)), "_") then put(on, "_") else lid(on, text(head(bs)))
        env2 = NCons(Node(BVar, text(head(bs)), "", 0, lineOf(arm), one(r, kid(head(fs), 0))), env2)
        bs = tail(bs)
        fs = tail(fs)
    put(on, " => {\n")
    ls(r, ds, fn, env2, tgGam(sx), kid(arm, 0), on, mode)
    put(on, "}\n")
    arms = tail(arms)
  put(on, ";\n")

// vars in scope, innermost binding of each name; caps erased
def scope(r: Region, env: Nodes): Nodes =
  var out = NNil
  var c = env
  while !isNil(c) do
    if num(head(c)) != 2 && !found(find(out, BVar, text(head(c)))) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(r, out)
def assigned(r: Region, e: Node, acc: Nodes): Nodes =
  var out = if kind(e) == XAssign && !has(acc, text(e)) then NCons(leaf(r, Name, text(e), 0), acc) else acc
  var c = kids(e)
  while !isNil(c) do
    out = assigned(r, head(c), out)
    c = tail(c)
  out
// the scope vars a loop body assigns: the loop aux returns them
def mutated(r: Region, sc: Nodes, body: Node): Nodes =
  val names = assigned(r, body, NNil)
  var out = NNil
  var c = sc
  while !isNil(c) do
    if has(names, text(head(c))) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(r, out)

// loop aux name = <fn>_loop<k>, k = loops of the fn on earlier lines: stable under edits outside the fn
def auxName(ds: Nodes, on: Bool, fn: Str, e: Node): Unit =
  put(on, "«")
  put(on, fn)
  put(on, "_loop")
  putn(on, loopsBefore(kid(find(ds, DFn, fn), 2), lineOf(e)))
  put(on, "»")
def loopsBefore(e: Node, line: I64): I64 =
  var n = if kind(e) == XWhile && lineOf(e) < line then 1 else 0
  var c = kids(e)
  while !isNil(c) do
    n = n + loopsBefore(head(c), line)
    c = tail(c)
  n
def auxArgs(on: Bool, sc: Nodes): Unit =
  var c = sc
  while !isNil(c) do
    put(on, " ")
    lid(on, text(head(c)))
    c = tail(c)
def tuple(on: Bool, mu: Nodes): Unit =
  if isNil(mu) then put(on, "()")
  else if isNil(tail(mu)) then lid(on, text(head(mu)))
  else
    put(on, "(")
    var c = mu
    while !isNil(c) do
      lid(on, text(head(c)))
      if !isNil(tail(c)) then put(on, ", ") else ()
      c = tail(c)
    put(on, ")")
def tupleTy(mu: Nodes): Unit =
  if isNil(mu) then say("Unit")
  else
    say("(")
    var c = mu
    while !isNil(c) do
      lty(kid(head(c), 0))
      if !isNil(tail(c)) then say(" × ") else ()
      c = tail(c)
    say(")")
// component i of an n-tuple (a, (b, c)): .2 i times, then .1 unless last
def proj(i: I64, n: I64): Unit =
  var k = 0
  while k < i do
    say(".2")
    k = k + 1
  if i < n - 1 then say(".1") else ()

def lsLoop(r: Region, ds: Nodes, fn: Str, env: Nodes, e: Node, mode: I64): Unit =
  val sc = scope(r, env)
  val mu = mutated(r, sc, kid(e, 1))
  say("let t_ ← ")
  auxName(ds, true, fn, e)
  auxArgs(true, sc)
  say(";\n")
  var c = mu
  var i = 0
  while !isNil(c) do
    lid(true, text(head(c)))
    say(" := t_")
    if len(mu) > 1 then proj(i, len(mu)) else ()
    say(";\n")
    i = i + 1
    c = tail(c)
  if mode == 1 then say("pure ()\n") else ()

def leanAux(r: Region, ds: Nodes, fn: Str, env: Nodes, gam: Nodes, e: Node): Unit =
  val sc = scope(r, env)
  val mu = mutated(r, sc, kid(e, 1))
  say("def ")
  auxName(ds, true, fn, e)
  var c = sc
  while !isNil(c) do
    say(" (")
    lid(true, text(head(c)))
    say(" : ")
    lty(kid(head(c), 0))
    say(")")
    c = tail(c)
  say(" : Option ")
  tupleTy(mu)
  say(" := do {\n")
  c = mu
  while !isNil(c) do
    say("let mut ")
    lid(true, text(head(c)))
    say(" := ")
    lid(true, text(head(c)))
    say(";\n")
    c = tail(c)
  say("if ")
  lx(r, ds, fn, env, gam, kid(e, 0), true)
  say(" then {\n")
  ls(r, ds, fn, env, gam, kid(e, 1), true, 0)
  auxName(ds, true, fn, e)
  auxArgs(true, sc)
  say("\n} else {\npure ")
  tuple(true, mu)
  say("\n}\n}\npartial_fixpoint\n\n")

// e as a Lean term; effects lifted with (← ..) in srs order; control in value position = a nested do
def lx(r: Region, ds: Nodes, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool): Unit =
  val k = kind(e)
  if k == XInt then
    put(on, "(")
    putn(on, num(e))
    put(on, " : Int)")
  else if k == XBool then put(on, if num(e) == 1 then "true" else "false")
  else if k == XStr then
    put(on, "\"")
    put(on, text(e))
    put(on, "\".toUTF8")
  else if k == XUnit then put(on, "()")
  else if k == XName then
    if found(find(env, BVar, text(e))) then lid(on, text(e)) else ctorName(r, on, ds, text(e))
  else if k == XCall then
    val c = find(allCases(r, ds), DCase, text(e))
    if found(c) then
      put(on, "(")
      ctorName(r, on, ds, text(e))
      lxArgs(r, ds, fn, env, gam, kids(e), NNil, on)
      put(on, ")")
    else
      put(on, "(← ")
      lid(on, text(e))
      lxArgs(r, ds, fn, env, gam, kids(e), kids(kid(find(ds, DFn, text(e)), 0)), on)
      put(on, ")")
  else if k == XBin then lxBin(r, ds, fn, env, gam, e, on)
  else if k == XUn then
    put(on, if eqs(text(e), "-") then "(0 - " else "(!")
    lx(r, ds, fn, env, gam, kid(e, 0), on)
    put(on, ")")
  else if k == XMethod then put(on, "srs_unsupported_method")
  else
    put(on, "(← (do {\n")
    ls(r, ds, fn, env, gam, e, on, 1)
    put(on, "}))")

// call args; an arg at a capability param is erased
def lxArgs(r: Region, ds: Nodes, fn: Str, env: Nodes, gam: Nodes, xs: Nodes, ps0: Nodes, on: Bool): Unit =
  var a = xs
  var ps = ps0
  while !isNil(a) do
    val cap = !isNil(ps) && isProto(ds, text(kid(head(ps), 0)))
    if !cap then
      put(on, " ")
      lx(r, ds, fn, env, gam, head(a), on)
    else ()
    a = tail(a)
    ps = if isNil(ps) then ps else tail(ps)

def lxBin(r: Region, ds: Nodes, fn: Str, env: Nodes, gam: Nodes, e: Node, on: Bool): Unit =
  val op = text(e)
  if eqs(op, "&&") || eqs(op, "||") then
    // short-circuit: b runs only when a does not decide
    put(on, "(← (do {\nif ")
    lx(r, ds, fn, env, gam, kid(e, 0), on)
    if eqs(op, "&&") then
      put(on, " then {\npure ")
      lx(r, ds, fn, env, gam, kid(e, 1), on)
      put(on, "\n} else {\npure false\n}\n}))")
    else
      put(on, " then {\npure true\n} else {\npure ")
      lx(r, ds, fn, env, gam, kid(e, 1), on)
      put(on, "\n}\n}))")
  else
    val cmp = eqs(op, "<") || eqs(op, "<=") || eqs(op, ">") || eqs(op, ">=")
    put(on, if cmp then "(decide (" else if eqs(op, "/") then "(Int.tdiv " else if eqs(op, "%") then "(Int.tmod " else "(")
    lx(r, ds, fn, env, gam, kid(e, 0), on)
    put(on, " ")
    if !eqs(op, "/") && !eqs(op, "%") then
      put(on, op)
      put(on, " ")
    else ()
    lx(r, ds, fn, env, gam, kid(e, 1), on)
    put(on, if cmp then "))" else ")")
