// S1 Lean backend, verification part (C13): spec defs, contracts and loop invariants as Lean defs and theorems.
// Specs are pure: no ← (they call spec defs, constructors and the pure externs Srs.Rt.P only).

def clausesOf(f: Node): Nodes = if len(kids(f)) > 3 then kids(kid(f, 3)) else NNil
def clauseExprs(r: Region, cs: Nodes, kw: Str): Nodes =
  var out = NNil
  var c = cs
  while !isNil(c) do
    if kind(head(c)) == SClause && eqs(text(head(c)), kw) then out = NCons(kid(head(c), 0), out) else ()
    c = tail(c)
  rev(r, out)
def proofOf(cs: Nodes): Node = find(cs, SClause, "proof")

// e as a pure Lean term
def lp(r: Region, ds: Nodes, e: Node): Unit = lpr(r, ds, NoNode, e)

// res: the term `result` stands for (NoNode = the name «result»)
def lpr(r: Region, ds: Nodes, res: Node, e: Node): Unit =
  val k = kind(e)
  if k == XInt then
    say("(")
    sayn(num(e))
    say(" : Int)")
  else if k == XBool then say(if num(e) == 1 then "true" else "false")
  else if k == XStr then
    say("\"")
    say(text(e))
    say("\".toUTF8")
  else if k == XUnit then say("()")
  else if k == XName then
    if found(res) && eqs(text(e), "result") then lpr(r, ds, NoNode, res)
    else if found(find(allCases(r, ds), DCase, text(e))) then ctorName(r, true, ds, text(e)) else lid(true, text(e))
  else if k == XCall then
    val f = find(ds, DFn, text(e))
    say("(")
    if found(find(allCases(r, ds), DCase, text(e))) then ctorName(r, true, ds, text(e))
    else if found(f) && num(f) == 1 then
      say("Srs.Rt.P.")
      say(text(e))
    else if found(f) && num(f) == 2 then lid(true, text(e))
    else say("srs_spec_calls_only_spec_defs")
    var a = kids(e)
    while !isNil(a) do
      say(" ")
      lpr(r, ds, res, head(a))
      a = tail(a)
    say(")")
  else if k == XBin then
    val op = text(e)
    val cmp = eqs(op, "<") || eqs(op, "<=") || eqs(op, ">") || eqs(op, ">=")
    say(if cmp then "(decide (" else if eqs(op, "/") then "(Int.tdiv " else if eqs(op, "%") then "(Int.tmod " else "(")
    lpr(r, ds, res, kid(e, 0))
    if !eqs(op, "/") && !eqs(op, "%") then
      say(" ")
      say(op)
    else ()
    say(" ")
    lpr(r, ds, res, kid(e, 1))
    say(if cmp then "))" else ")")
  else if k == XUn then
    say(if eqs(text(e), "-") then "(0 - " else "(!")
    lpr(r, ds, res, kid(e, 0))
    say(")")
  else if k == XIf then
    say("(if ")
    lpr(r, ds, res, kid(e, 0))
    say(" then ")
    lpr(r, ds, res, kid(e, 1))
    say(" else ")
    lpr(r, ds, res, kid(e, 2))
    say(")")
  else if k == XMatch then
    say("(match ")
    lpr(r, ds, res, kid(e, 0))
    say(" with")
    var arms = tail(kids(e))
    while !isNil(arms) do
      val arm = head(arms)
      say(" | ")
      if eqs(text(arm), "_") then say("_")
      else
        ctorName(r, true, ds, text(arm))
        var bs = tail(kids(arm))
        while !isNil(bs) do
          say(" ")
          if eqs(text(head(bs)), "_") then say("_") else lid(true, text(head(bs)))
          bs = tail(bs)
      say(" => ")
      lpr(r, ds, res, kid(arm, 0))
      arms = tail(arms)
    say(")")
  else if k == XBlock then
    var c = kids(e)
    var opens = 0
    while !isNil(c) do
      val s = head(c)
      if kind(s) == SVal then
        say("(let ")
        lid(true, text(s))
        say(" := ")
        lpr(r, ds, res, kid(s, 0))
        say("; ")
        opens = opens + 1
      else if kind(s) == SClause then ()
      else lpr(r, ds, res, s)
      c = tail(c)
    while opens > 0 do
      say(")")
      opens = opens - 1
  else say("srs_unsupported_in_spec")

// conjunction of clause exprs, as Bool
def lpAll(r: Region, ds: Nodes, es: Nodes): Unit = lpAllR(r, ds, NoNode, es)
def lpAllR(r: Region, ds: Nodes, res: Node, es: Nodes): Unit =
  if isNil(es) then say("True")
  else
    say("(")
    var c = es
    while !isNil(c) do
      lpp(r, ds, res, head(c))
      if !isNil(tail(c)) then say(" ∧ ") else ()
      c = tail(c)
    say(")")

// a contract as a Prop: logic and comparisons as Lean props (facts simp and omega use), other terms `= true`
def lpp(r: Region, ds: Nodes, res: Node, e: Node): Unit =
  val op = text(e)
  if kind(e) == XBin && (eqs(op, "&&") || eqs(op, "||")) then
    say("(")
    lpp(r, ds, res, kid(e, 0))
    say(if eqs(op, "&&") then " ∧ " else " ∨ ")
    lpp(r, ds, res, kid(e, 1))
    say(")")
  else if kind(e) == XBin && (eqs(op, "==") || eqs(op, "!=") || eqs(op, "<") || eqs(op, "<=") || eqs(op, ">") || eqs(op, ">=")) then
    say("(")
    lpr(r, ds, res, kid(e, 0))
    say(if eqs(op, "==") then " = " else if eqs(op, "!=") then " ≠ " else if eqs(op, "<=") then " ≤ " else if eqs(op, ">=") then " ≥ " else " ")
    if eqs(op, "<") || eqs(op, ">") then
      say(op)
      say(" ")
    else ()
    lpr(r, ds, res, kid(e, 1))
    say(")")
  else if kind(e) == XForall || kind(e) == XExists then
    say(if kind(e) == XForall then "(∀ (" else "(∃ (")
    lid(true, text(e))
    say(" : ")
    lty(kid(e, 0))
    say("), ")
    lpp(r, ds, res, kid(e, 1))
    say(")")
  else if kind(e) == XUn && eqs(op, "!") then
    say("(¬ ")
    lpp(r, ds, res, kid(e, 0))
    say(")")
  else
    say("(")
    lpr(r, ds, res, e)
    say(" = true)")

def lparams(ds: Nodes, ps: Nodes): Unit =
  var c = ps
  while !isNil(c) do
    if !isProto(ds, text(kid(head(c), 0))) then
      say(" (")
      lid(true, text(head(c)))
      say(" : ")
      lty(kid(head(c), 0))
      say(")")
    else ()
    c = tail(c)

def specDef(r: Region, ds: Nodes, f: Node): Unit =
  say("def ")
  lid(true, text(f))
  lparams(ds, kids(kid(f, 0)))
  say(" : ")
  lty(kid(f, 1))
  say(" :=\n  ")
  lp(r, ds, kid(f, 2))
  val dec = clauseExprs(r, clausesOf(f), "decreases")
  if !isNil(dec) then
    say("\ntermination_by (")
    lp(r, ds, head(dec))
    say(").toNat")
  else ()
  say("\n\n")

// the proof of a contract: srs_auto with the `using` facts, induction, or Lean tactics
def proofText(r: Region, ds: Nodes, f: Node, p: Node): Unit =
  if found(p) && eqs(text2(p), "lean") then say(text(kid(p, 0)))
  else
    say("by\n  ")
    val lp0 = invLoop(r, kid(f, 2))
    if found(lp0) then loopSkeleton(r, ds, f, lp0, p, false)
    else if found(p) && eqs(text2(p), "by") then
      say("induction ")
      lid(true, text(kid(p, 0)))
      say(" <;> ")
      autoCall(r, ds, p, selfFacts(r, ds, f))
    else autoCall(r, ds, p, selfFacts(r, ds, f))

// srs_auto with the `proof using` facts + `extra` (the fns a loop calls): each fn and its contract theorem
def autoCall(r: Region, ds: Nodes, p: Node, extra: Nodes): Unit =
  say("srs_auto [")
  factList(r, ds, p, extra, true)
  say("]")

// the facts of a proof, comma separated (first: no leading comma): fns, their _eq/_spec/_ret theorems
def factList(r: Region, ds: Nodes, p: Node, extra: Nodes, first0: Bool): Unit =
  var c = eqSpecs(r, ds, if found(p) && eqs(text2(p), "using") then append(r, kids(p), extra) else extra)
  var first = first0
  while !isNil(c) do
    val f = find(ds, DFn, text(head(c)))
    // n 1 = the fn being proven: its own contract is not a fact yet
    val spec = found(f) && num(head(c)) == 0 && num(f) != 1 && !isNil(clauseExprs(r, clausesOf(f), "ensures"))
    val eqn = spec && isEqFn(r, ds, f)
    val ret = found(f) && num(head(c)) == 0 && !isNil(clauseExprs(r, clausesOf(f), "returns"))
    // a fn with an _eq or returns rule is used through it, not unfolded; a recursive fn never (unfolding never ends)
    if !eqn && !ret && !(found(f) && num(f) == 0 && isRec(r, ds, text(head(c)))) then
      if !first then say(", ") else ()
      factName(f, text(head(c)))
      first = false
    else ()
    if spec then
      if !first then say(", ") else ()
      say("«")
      say(text(head(c)))
      say(if eqn then "_eq»" else "_spec»")
      first = false
    else ()
    if ret then
      if !first then say(", ") else ()
      say("«")
      say(text(head(c)))
      say(if isNil(clauseExprs(r, clausesOf(f), "requires")) then "_ok»" else "_ret»")
      first = false
    else ()
    c = tail(c)

// a fact: a non-recursive match-defined spec def gives its equation lemmas, they rewrite constructors only
// (simp unfolds the def itself on a var into a match: simp_all loops on `c = t[c]` from such matches)
def factName(f: Node, name: Str): Unit =
  val b = if num(f) == 2 then kid(f, 2) else NoNode
  if kind(b) == XMatch && !selfCalls(b, name) then
    var i = 1
    var a = tail(kids(b))
    while !isNil(a) do
      if i > 1 then say(", ") else ()
      lid(true, name)
      say(".eq_")
      sayn(i)
      i = i + 1
      a = tail(a)
  else lid(true, name)
// name is on a call-graph cycle (Lean partial_fixpoint)
def isRec(r: Region, ds: Nodes, name: Str): Bool = has(reach(r, callGraph(r, ds), name), name)
// e calls name
def selfCalls(e: Node, name: Str): Bool =
  var hit = kind(e) == XCall && eqs(text(e), name)
  var c = kids(e)
  while !hit && !isNil(c) do
    hit = selfCalls(head(c), name)
    c = tail(c)
  hit
// f has an _eq rule: one `ensures result == E`, no requires
def isEqFn(r: Region, ds: Nodes, f: Node): Bool =
  val ce = clausesOf(f)
  num(f) == 0 && isNil(clauseExprs(r, ce, "requires")) && !isNil(clauseExprs(r, ce, "ensures")) && isNil(tail(clauseExprs(r, ce, "ensures"))) && resultEq(head(clauseExprs(r, ce, "ensures")))
// facts xs + the match-defined spec defs in the E of each fn used through its _eq rule: they rewrite only
// constructors. other spec defs there (if bodies) stay opaque: the proof reasons about them as atoms
def eqSpecs(r: Region, ds: Nodes, xs: Nodes): Nodes =
  var out = xs
  var c = xs
  while !isNil(c) do
    val f = find(ds, DFn, text(head(c)))
    if found(f) && num(head(c)) == 0 && isEqFn(r, ds, f) then
      var s = specCalls(r, ds, kid(head(clauseExprs(r, clausesOf(f), "ensures")), 1), NNil)
      while !isNil(s) do
        if kind(kid(find(ds, DFn, text(head(s))), 2)) == XMatch && !has(out, text(head(s))) then out = NCons(head(s), out) else ()
        s = tail(s)
    else ()
    c = tail(c)
  out

// theorem f_spec (params) (h : requires) : ∃ result, f params = some result ∧ ensures
def fnTheorem(r: Region, ds: Nodes, f: Node): Unit =
  val cs = clausesOf(f)
  val ens = clauseExprs(r, cs, "ensures")
  val req = clauseExprs(r, cs, "requires")
  if !isNil(ens) then
    say("theorem «")
    say(text(f))
    say("_spec»")
    // proof by induction x (no requires): ∀ x, one arm per case (Lean `induction` rejects mutual enums)
    // shortcut: x must be the last param (f_eq applies f_spec positionally), until args are named
    val p = proofOf(cs)
    val ind = if isNil(req) && found(p) && eqs(text2(p), "by") then text(kid(p, 0)) else ""
    lparams(ds, without(r, kids(kid(f, 0)), ind))
    if !isNil(req) then
      say(" (_h_req : ")
      lpAll(r, ds, req)
      say(")")
    else ()
    say(" :\n    ")
    if rt_str_len(ind) > 0 then
      say("∀ (")
      lid(true, ind)
      say(" : ")
      lty(kid(find(kids(kid(f, 0)), Param, ind), 0))
      say("), ")
    else ()
    say("∃ «result», ")
    lid(true, text(f))
    var c = kids(kid(f, 0))
    while !isNil(c) do
      if !isProto(ds, text(kid(head(c), 0))) then
        say(" ")
        lid(true, text(head(c)))
      else ()
      c = tail(c)
    say(" = some «result» ∧ ")
    lpAll(r, ds, ens)
    if rt_str_len(ind) > 0 then inductionArms(r, ds, f, p, ind, false) else
      say(" := ")
      proofText(r, ds, f, p)
    say("\n\n")
    if isNil(req) && isNil(tail(ens)) && resultEq(head(ens)) then eqTheorem(r, ds, f, kid(head(ens), 1)) else ()
  else ()
  val rets = clauseExprs(r, cs, "returns")
  if !isNil(rets) then retTheorem(r, ds, f, rets) else ()

// returns (C15): theorem f_ret (params) (h : requires) : ∀ result, f params = some result → returns. exit = no claim
def retTheorem(r: Region, ds: Nodes, f: Node, rets: Nodes): Unit =
  val cs = clausesOf(f)
  val req = clauseExprs(r, cs, "requires")
  val p = proofOf(cs)
  say("theorem «")
  say(text(f))
  say("_ret»")
  lparams(ds, kids(kid(f, 0)))
  if !isNil(req) then
    say(" (_h_req : ")
    lpAll(r, ds, req)
    say(")")
  else ()
  say(" :\n    ∀ «result», ")
  lid(true, text(f))
  largs(ds, kids(kid(f, 0)))
  say(" = some «result» → ")
  lpAll(r, ds, rets)
  say(" := by\n  refine Srs.ok_intro ?_\n  ")
  val lp0 = invLoop(r, kid(f, 2))
  if found(lp0) then loopSkeleton(r, ds, f, lp0, p, true)
  else
    // a recursive f unfolds once (a fact would unfold it forever); a loop w/o invariant stays opaque: the claim
    // must hold for any loop result (Srs.ok_true)
    if isRec(r, ds, text(f)) then
      say("rw [«")
      say(text(f))
      say("»]\n  ")
    else ()
    autoCall(r, ds, p, selfFacts(r, ds, f))
  say("\n\n")
  // callers use f through f_ok: ok (f params) P = ∀ result, f params = some result → returns → P result
  if isNil(req) then
    say("theorem «")
    say(text(f))
    say("_ok»")
    lparams(ds, kids(kid(f, 0)))
    say(" (P : ")
    lty(kid(f, 1))
    say(" → Prop) :\n    Srs.ok (")
    lid(true, text(f))
    largs(ds, kids(kid(f, 0)))
    say(") P = ∀ «result», ")
    lid(true, text(f))
    largs(ds, kids(kid(f, 0)))
    say(" = some «result» → ")
    lpAll(r, ds, rets)
    say(" → P «result» :=\n  Srs.ok_ret («")
    say(text(f))
    say("_ret»")
    largs(ds, kids(kid(f, 0)))
    say(") P\n\n")
  else ()

def verification(r: Region, ds: Nodes): Unit =
  var c = ds
  while !isNil(c) do
    if kind(head(c)) == DFn && num(head(c)) == 0 then fnTheorem(r, ds, head(c)) else ()
    c = tail(c)

// spec def f with ensures: theorem f_spec (params) : ensures, `result` = the call f params
def specTheorems(r: Region, ds: Nodes): Unit =
  var c = ds
  while !isNil(c) do
    val f = head(c)
    val ens = if kind(f) == DFn && num(f) == 2 then clauseExprs(r, clausesOf(f), "ensures") else NNil
    if !isNil(ens) then
      val p = proofOf(clausesOf(f))
      val ind = if found(p) && eqs(text2(p), "by") then text(kid(p, 0)) else ""
      say("theorem «")
      say(text(f))
      say("_spec»")
      lparams(ds, without(r, kids(kid(f, 0)), ind))
      say(" :\n    ")
      if rt_str_len(ind) > 0 then
        say("∀ (")
        lid(true, ind)
        say(" : ")
        lty(kid(find(kids(kid(f, 0)), Param, ind), 0))
        say("), ")
      else ()
      // `result` = the call itself: a fact simp can use
      var args = NNil
      var a = kids(kid(f, 0))
      while !isNil(a) do
        args = NCons(leaf(r, XName, text(head(a)), 0), args)
        a = tail(a)
      lpAllR(r, ds, Node(XCall, text(f), "", 0, 0, rev(r, args)), ens)
      if rt_str_len(ind) > 0 then inductionArms(r, ds, f, p, ind, true) else
        say(" := ")
        proofText(r, ds, f, p)
      say("\n\n")
    else ()
    c = tail(c)

// the first top-level loop of a fn body that has an invariant, else NoNode
def invLoop(r: Region, body: Node): Node =
  var res = NoNode
  var c = if kind(body) == XBlock then kids(body) else one(r, body)
  while !found(res) && !isNil(c) do
    val s = head(c)
    if kind(s) == XWhile && found(find(kids(kid(s, 1)), SClause, "invariant")) then res = s else ()
    c = tail(c)
  res

// env at loop w: params + the vals before it (types from the checker, as lsBlock does)
def loopEnv(r: Region, ds: Nodes, f: Node, w: Node): Nodes =
  var env = fnEnv(r, ds, sigParams(r, ds, f))
  var gam = fnGam(r, ds, sigParams(r, ds, f))
  var c = if kind(kid(f, 2)) == XBlock then kids(kid(f, 2)) else NNil
  while !isNil(c) && !(kind(head(c)) == XWhile && lineOf(head(c)) == lineOf(w)) do
    val s = head(c)
    if kind(s) == SVal then
      val x = chk(r, ds, env, gam, kid(s, 0), NoNode)
      val t = if !isNil(tail(kids(s))) then kid(s, 1) else if num(s) == 1 then uncapped(r, text(tgTy(x))) else tgTy(x)
      gam = tgGam(x)
      env = NCons(Node(BVar, text(s), "", num(s), lineOf(s), one(r, t)), env)
    else if kind(s) == SClause || kind(s) == SHandle then ()
    else gam = tgGam(chk(r, ds, env, gam, s, NoNode))
    c = tail(c)
  env

def rpat(mu: Nodes): Unit =
  if isNil(mu) then say("_")
  else if isNil(tail(mu)) then lid(true, text(head(mu)))
  else
    say("⟨")
    var c = mu
    while !isNil(c) do
      lid(true, text(head(c)))
      if !isNil(tail(c)) then say(", ") else ()
      c = tail(c)
    say("⟩")

// the user fns a fn body calls: unfolded by srs_auto, or rewritten by their _eq rule
def bodyCalls(r: Region, ds: Nodes, body: Node): Nodes =
  var out = NNil
  var c = callsOf(r, ds, body, NNil)
  while !isNil(c) do
    out = NCons(leaf(r, Name, text(head(c)), 0), out)
    c = tail(c)
  out

// the proof of a fn whose body loop has an invariant: Srs.loop_bind (ret: Srs.loop_ret_bind, partial) with the
// loop's invariant and measure; left: one turn keeps it (step), it holds on entry, the contract holds at exit
def loopSkeleton(r: Region, ds: Nodes, f: Node, w: Node, p: Node, ret: Bool): Unit =
  val env = loopEnv(r, ds, f, w)
  val sc = scope(r, env)
  val mu = mutated(r, sc, kid(w, 1))
  val cap = captured(r, sc, mu)
  val inv = clauseExprs(r, kids(kid(w, 1)), "invariant")
  val dec = clauseExprs(r, kids(kid(w, 1)), "decreases")
  val hints = append(r, bodyCalls(r, ds, kid(f, 2)), specClosure(r, ds, append(r, inv, append(r, dec, clauseExprs(r, clausesOf(f), if ret then "returns" else "ensures"))), NNil))
  say("rw [")
  lid(true, text(f))
  say("]\n  dsimp only\n  (try simp only [Srs.some_bind, pure_bind")
  factList(r, ds, p, hints, false)
  say("])\n  refine Srs.")
  say(if ret then "loop_ret_bind (" else "loop_bind (")
  auxName(ds, true, text(f), w)
  var c = cap
  while !isNil(c) do
    say(" _")
    c = tail(c)
  say(") _ _ (fun _ => by rw [")
  auxName(ds, true, text(f), w)
  say("]) (fun (")
  tuple(true, mu)
  say(" : ")
  tupleTy(mu)
  say(") => ")
  lpAll(r, ds, inv)
  say(") (fun (")
  tuple(true, mu)
  say(" : ")
  tupleTy(mu)
  say(") => (")
  if isNil(dec) then say("srs_loop_needs_decreases") else lp(r, ds, head(dec))
  say(").toNat) ?_ _ _ _ ?_ ?_\n  · rintro ")
  rpat(mu)
  say(if ret then " hI b hc hb\n    " else " hI\n    ")
  casesEnums(ds, condVars(r, ds, mu, kid(w, 0), kid(w, 1)))
  autoCall(r, ds, p, hints)
  say("\n  · ")
  autoCall(r, ds, p, hints)
  say("\n  · rintro ")
  rpat(mu)
  say(" hI hc\n    ")
  casesEnums(ds, condVars(r, ds, mu, kid(w, 0), kid(w, 1)))
  autoCall(r, ds, p, hints)

// case split on each enum- or Bool-typed loop var, and one level into its enum fields: conditions and bodies
// match on them
def casesEnums(ds: Nodes, mu: Nodes): Unit =
  var c = mu
  while !isNil(c) do
    val t = text(kid(head(c), 0))
    if isEnum(ds, t) then
      say("rcases ")
      lid(true, text(head(c)))
      say(" with ")
      enumPat(ds, t, 2)
      say(" <;> ")
    else if eqs(t, "Bool") then
      say("cases ")
      lid(true, text(head(c)))
      say(" <;> ")
    else ()
    c = tail(c)

// rcases pattern of enum t, `depth` levels deep
def enumPat(ds: Nodes, t: Str, depth: I64): Unit =
  if depth == 0 || !isEnum(ds, t) then say("_")
  else
    say("(")
    var cs = kids(find(ds, DEnum, t))
    while !isNil(cs) do
      var fs = kids(kid(head(cs), 0))
      if isNil(fs) then say("⟨⟩")
      else
        say("⟨")
        while !isNil(fs) do
          enumPat(ds, text(kid(head(fs), 0)), depth - 1)
          if !isNil(tail(fs)) then say(", ") else ()
          fs = tail(fs)
        say("⟩")
      if !isNil(tail(cs)) then say(" | ") else ()
      cs = tail(cs)
    say(")")

def without(r: Region, ps: Nodes, name: Str): Nodes =
  var out = NNil
  var c = ps
  while !isNil(c) do
    if !eqs(text(head(c)), name) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(r, out)

// proof by induction x: one arm per case of x's enum, an induction hypothesis per field of that enum
// (structural recursion: works for mutual enums too); gen: the hypothesis holds for all other params (accumulators)
def inductionArms(r: Region, ds: Nodes, f: Node, p: Node, x: Str, gen: Bool): Unit =
  val ty = text(kid(find(kids(kid(f, 0)), Param, x), 0))
  var cs = kids(find(ds, DEnum, ty))
  while !isNil(cs) do
    say("\n  | ")
    ctorName(r, true, ds, text(head(cs)))
    var fs = kids(kid(head(cs), 0))
    var i = 0
    while !isNil(fs) do
      say(" a")
      sayn(i)
      i = i + 1
      fs = tail(fs)
    say(" => by\n    ")
    fs = kids(kid(head(cs), 0))
    i = 0
    var ihs = NNil
    while !isNil(fs) do
      if eqs(text(kid(head(fs), 0)), ty) then
        say("have ih")
        sayn(i)
        say(" := ")
        var a = without(r, kids(kid(f, 0)), x)
        if gen && !isNil(a) then
          say("fun")
          var g = a
          while !isNil(g) do
            say(" ")
            lid(true, text(head(g)))
            g = tail(g)
          say(" => ")
        else ()
        say("«")
        say(text(f))
        say("_spec»")
        while !isNil(a) do
          say(" ")
          lid(true, text(head(a)))
          a = tail(a)
        say(" a")
        sayn(i)
        say("\n    ")
      else ()
      i = i + 1
      fs = tail(fs)
    autoCall(r, ds, p, selfFacts(r, ds, f))
    cs = tail(cs)

// a proof without loop: f itself (n 1 = not yet a fact), the fns its body calls, the spec defs its contract calls
def selfFacts(r: Region, ds: Nodes, f: Node): Nodes =
  val cs = clausesOf(f)
  NCons(Node(Name, text(f), "", 1, 0, NNil), append(r, bodyCalls(r, ds, kid(f, 2)), specClosure(r, ds, append(r, clauseExprs(r, cs, "requires"), append(r, clauseExprs(r, cs, "ensures"), clauseExprs(r, cs, "returns"))), NNil)))
// the spec defs exprs es call (unfolded by srs_auto); not the ones those call: they stay opaque
def specClosure(r: Region, ds: Nodes, es: Nodes, acc: Nodes): Nodes =
  var out = acc
  var c = es
  while !isNil(c) do
    out = specCalls(r, ds, head(c), out)
    c = tail(c)
  out
def specCalls(r: Region, ds: Nodes, e: Node, acc: Nodes): Nodes =
  var out = acc
  if kind(e) == XCall then
    val f = find(ds, DFn, text(e))
    if found(f) && num(f) == 2 && !has(out, text(e)) then
      out = NCons(leaf(r, Name, text(e), 0), out)
    else ()
  else ()
  var c = kids(e)
  while !isNil(c) do
    out = specCalls(r, ds, head(c), out)
    c = tail(c)
  out

// ensures `result == E`
def resultEq(e: Node): Bool = kind(e) == XBin && eqs(text(e), "==") && kind(kid(e, 0)) == XName && eqs(text(kid(e, 0)), "result")

// theorem f_eq (params) : f params = some E: the contract as a rewrite rule for the proofs of callers
def eqTheorem(r: Region, ds: Nodes, f: Node, e: Node): Unit =
  say("theorem «")
  say(text(f))
  say("_eq»")
  lparams(ds, kids(kid(f, 0)))
  say(" :\n    ")
  lid(true, text(f))
  largs(ds, kids(kid(f, 0)))
  say(" = some ")
  lp(r, ds, e)
  say(" := by\n  obtain ⟨_, h1, h2⟩ := «")
  say(text(f))
  say("_spec»")
  largs(ds, kids(kid(f, 0)))
  say("\n  rw [h1, h2]\n\n")

def largs(ds: Nodes, ps: Nodes): Unit =
  var c = ps
  while !isNil(c) do
    if !isProto(ds, text(kid(head(c), 0))) then
      say(" ")
      lid(true, text(head(c)))
    else ()
    c = tail(c)

// the loop vars the condition reads, or the body passes to a fn whose _eq rule is a non-recursive match: the
// case splits they need (that rule's equation lemmas rewrite constructors only)
def condVars(r: Region, ds: Nodes, mu: Nodes, cond: Node, body: Node): Nodes =
  var out = NNil
  var c = mu
  while !isNil(c) do
    if reads(cond, text(head(c))) || matchArg(r, ds, body, text(head(c))) then out = NCons(head(c), out) else ()
    c = tail(c)
  rev(r, out)
// e has a call g(.., x, ..) with g's _eq rule a non-recursive match-defined spec def
def matchArg(r: Region, ds: Nodes, e: Node, x: Str): Bool =
  var hit = kind(e) == XCall && nameArg(kids(e), x) && matchEq(r, ds, text(e))
  var c = kids(e)
  while !hit && !isNil(c) do
    hit = matchArg(r, ds, head(c), x)
    c = tail(c)
  hit
def nameArg(xs: Nodes, x: Str): Bool =
  var hit = false
  var c = xs
  while !hit && !isNil(c) do
    hit = kind(head(c)) == XName && eqs(text(head(c)), x)
    c = tail(c)
  hit
def matchEq(r: Region, ds: Nodes, g: Str): Bool =
  val f = find(ds, DFn, g)
  val s = if found(f) && isEqFn(r, ds, f) then find(ds, DFn, text(kid(head(clauseExprs(r, clausesOf(f), "ensures")), 1))) else NoNode
  num(s) == 2 && kind(kid(s, 2)) == XMatch && !selfCalls(kid(s, 2), text(s))
