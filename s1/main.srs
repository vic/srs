// S1: `s1 a.srs b.srs ... > out.c`. Decls of all files form one program.

def main(): I64 =
  handle r = Arena()
  var ds = NNil
  var i = 1
  while i < rt_argc() do
    val src = rt_read_file(rt_arg(i))
    if rt_str_len(src) < 0 then
      rt_eprint("srs: cannot read ")
      rt_eprint(rt_arg(i))
      rt_eprint("\n")
      rt_exit(1)
    else ()
    ds = append(r, ds, parseFile(r, lex(r, src)))
    i = i + 1
  check(r, ds)
  emitProgram(r, ds)
  0
