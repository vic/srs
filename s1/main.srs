// S1: `s1 a.srs b.srs ... > out.c`, or `s1 --lean NS a.srs ... > out.lean` (namespace Srs.NS) (s1/lean.srs). Decls of all files form one program.

def main(): I64 =
  handle r = Arena()
  val lean = rt_argc() > 1 && rt_str_eq(rt_arg(1), "--lean")
  var ds = NNil
  var i = if lean then 3 else 1
  while i < rt_argc() do
    val src = rt_read_file(rt_arg(i))
    if rt_str_len(src) < 0 then
      rt_eprint("srs: cannot read ")
      rt_eprint(rt_arg(i))
      rt_eprint("\n")
      rt_exit(1)
    else ()
    ds = append(ds, parseFile(lex(src)))
    i = i + 1
  val ds2 = check(ds)
  if lean then emitLean(mkDecls(expandTypes(mkDecls(ds))), rt_arg(2)) else emitProgram(mkDecls(mono(mkDecls(ds2))))
  0
