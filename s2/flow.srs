// s2 P2 FLOW, rung F1a (vic-m5r.3, vic/c/flow-design.md): protocol states as Datalog. Flow.facts walks one Ast.Fn and
// emits facts over its control-flow points; Flow.rules is a fixed rule library; D.solve gives what holds at each
// point, and a clash is a derived fact, returned as data. no join or loop code here: branches meet at a merge point
// and loops reach their fixpoint inside Datalog. F1a: handle, ops on a capability, if, while, blocks.
//
// a point exists only where something happens: a handle, an op step, the start of a branch, a merge, a loop head, a
// block end. a step's source point has no other out edge (branches start at fresh points), so a step moves only its
// capability and every other one keeps its state (frame).

// a capability in scope: its name, its id (unique in the fn), its protocol, the line of its handle
enum Flow.Cap:
  case Flow.Cap(name: Sym.Sym, id: I64, proto: Sym.Sym, line: I64)

// the walk so far: the next free id, the facts, the capabilities in scope (innermost first)
enum Flow.St:
  case Flow.St(next: I64, facts: Coll.List[D.Fact], caps: Coll.List[Flow.Cap])

// what the walk reads: the protocols, the handlers, the defs (a call reads its callee's signature), the enums (a
// constructor call allocates in the innermost Region), the type decls, the effect rows (s2/eff.srs)
enum Flow.Cx:
  case Flow.Cx(ps: Coll.List[Ast.Proto], hs: Coll.List[Ast.Handler], fns: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ts: Coll.List[Ast.TypeDecl], rows: Eff.Rows)

def Flow.cxHs(cx: Flow.Cx): Coll.List[Ast.Handler] =
  val Flow.Cx(_, hs, _, _, _, _) = cx
  hs

// the walk after an expression: its state and the point where control is now
enum Flow.At:
  case Flow.At(st: Flow.St, p: I64)

enum Flow.Clash:
  case Flow.Stuck(line: I64, cap: Sym.Sym)
  case Flow.Split(line: I64, cap: Sym.Sym)
  case Flow.Unended(line: I64, cap: Sym.Sym)
  // a call whose entry facts have more than one solution (s1/facts.srs:224); cap = the callee
  case Flow.Ambig(line: I64, cap: Sym.Sym)
  // a def whose body leaves a capability binder in another state than its exit fact says (s1/check.srs:525)
  case Flow.ExitBad(line: I64, cap: Sym.Sym)
  // a def whose entry facts have no solution (s1/check.srs:502); cap = the def
  case Flow.NoSol(line: I64, cap: Sym.Sym)
  // a value used after its region ended (s1 "use of value after its region ended"); cap = the region
  case Flow.Dead(line: I64, cap: Sym.Sym)
  // a block value that lives in a capability the block closes (s1 "value escapes the scope of its region")
  case Flow.Escape(line: I64, cap: Sym.Sym)
  // a value of a type with <at(c, S)> read where its capability is not in S (s1 "value needs c in state S"); name = the value
  case Flow.Stale(line: I64, x: Sym.Sym)

// every relation of Flow.rules and Flow.facts; Flow.relSym is the only place a relation name is a string
enum Flow.Rel:
  case Flow.RFlow
  case Flow.RStep
  case Flow.RAt
  case Flow.RCapOf
  case Flow.RCapName
  case Flow.RCapLine
  case Flow.RHandle
  case Flow.RClose
  case Flow.RMerge
  case Flow.RLine
  case Flow.RTr
  case Flow.RStart
  case Flow.REndOk
  case Flow.RSame
  case Flow.RWorld
  case Flow.RTouch
  case Flow.RMoved
  case Flow.RSeen
  case Flow.RStuck
  case Flow.RSplit
  case Flow.RSplitAt
  case Flow.RUnended
  case Flow.RUnendedAt
  case Flow.RCStep
  case Flow.RBind
  case Flow.RPre
  case Flow.RPost
  case Flow.RFirst
  case Flow.RNext
  case Flow.RLast
  case Flow.ROk
  case Flow.RFits
  case Flow.RCallee
  case Flow.RCSeen
  case Flow.RAmbig
  case Flow.RAmbigAt
  case Flow.REnter
  case Flow.RWant
  case Flow.RExitBad
  case Flow.RNoSol
  case Flow.RNoSolAt
  case Flow.RReadAt
  case Flow.RAssign
  case Flow.RAssignFrom
  case Flow.RAssigns
  case Flow.RHolds
  case Flow.REdge
  case Flow.RFin
  case Flow.RDead
  case Flow.REscCap
  case Flow.REscVar
  case Flow.REscape
  case Flow.RNeed
  case Flow.RSameS
  case Flow.RStale

def Flow.relSym(x: Flow.Rel): Sym.Sym = x match
  case Flow.RFlow => Sym.of("flow")
  case Flow.RStep => Sym.of("step")
  case Flow.RAt => Sym.of("at")
  case Flow.RCapOf => Sym.of("capOf")
  case Flow.RCapName => Sym.of("capName")
  case Flow.RCapLine => Sym.of("capLine")
  case Flow.RHandle => Sym.of("handle")
  case Flow.RClose => Sym.of("close")
  case Flow.RMerge => Sym.of("merge")
  case Flow.RLine => Sym.of("line")
  case Flow.RTr => Sym.of("tr")
  case Flow.RStart => Sym.of("start")
  case Flow.REndOk => Sym.of("endOk")
  case Flow.RSame => Sym.of("same")
  case Flow.RWorld => Sym.of("world")
  case Flow.RTouch => Sym.of("touch")
  case Flow.RMoved => Sym.of("moved")
  case Flow.RSeen => Sym.of("seen")
  case Flow.RStuck => Sym.of("stuck")
  case Flow.RSplit => Sym.of("split")
  case Flow.RSplitAt => Sym.of("splitAt")
  case Flow.RUnended => Sym.of("unended")
  case Flow.RUnendedAt => Sym.of("unendedAt")
  case Flow.RCStep => Sym.of("cstep")
  case Flow.RBind => Sym.of("bind")
  case Flow.RPre => Sym.of("pre")
  case Flow.RPost => Sym.of("post")
  case Flow.RFirst => Sym.of("firstParam")
  case Flow.RNext => Sym.of("nextParam")
  case Flow.RLast => Sym.of("lastParam")
  case Flow.ROk => Sym.of("ok")
  case Flow.RFits => Sym.of("fits")
  case Flow.RCallee => Sym.of("callee")
  case Flow.RCSeen => Sym.of("cseen")
  case Flow.RAmbig => Sym.of("ambig")
  case Flow.RAmbigAt => Sym.of("ambigAt")
  case Flow.REnter => Sym.of("enter")
  case Flow.RWant => Sym.of("want")
  case Flow.RExitBad => Sym.of("exitBad")
  case Flow.RNoSol => Sym.of("nosol")
  case Flow.RNoSolAt => Sym.of("noSolAt")
  case Flow.RReadAt => Sym.of("readAt")
  case Flow.RAssign => Sym.of("assign")
  case Flow.RAssignFrom => Sym.of("assignFrom")
  case Flow.RAssigns => Sym.of("assigns")
  case Flow.RHolds => Sym.of("holds")
  case Flow.REdge => Sym.of("edge")
  case Flow.RFin => Sym.of("fin")
  case Flow.RDead => Sym.of("dead")
  case Flow.REscCap => Sym.of("escCap")
  case Flow.REscVar => Sym.of("escVar")
  case Flow.REscape => Sym.of("escape")
  case Flow.RNeed => Sym.of("need")
  case Flow.RSameS => Sym.of("sameS")
  case Flow.RStale => Sym.of("stale")

// the clash relations of Flow.rules
enum Flow.Kind:
  case Flow.KStuck
  case Flow.KSplit
  case Flow.KUnended
  case Flow.KAmbig
  case Flow.KExitBad
  case Flow.KNoSol
  case Flow.KDead
  case Flow.KEscape
  case Flow.KStale

def Flow.relOf(k: Flow.Kind): Flow.Rel = k match
  case Flow.KStuck => Flow.RStuck
  case Flow.KSplit => Flow.RSplitAt
  case Flow.KUnended => Flow.RUnendedAt
  case Flow.KAmbig => Flow.RAmbigAt
  case Flow.KExitBad => Flow.RExitBad
  case Flow.KNoSol => Flow.RNoSolAt
  case Flow.KDead => Flow.RDead
  case Flow.KEscape => Flow.REscape
  case Flow.KStale => Flow.RStale

enum Flow.Verdict:
  case Flow.Ok
  case Flow.Bad(clashes: Coll.List[Flow.Clash])
  // the rule library is not a Datalog program (a bug in Flow.rules), as D.solve reports it
  case Flow.RulesUnsafe(rel: Sym.Sym)
  case Flow.RulesNegCycle(rel: Sym.Sym)
  // a clash relation holds a tuple that is not (line, name): a bug in Flow.rules, reported, never dropped
  case Flow.RulesIllTyped(rel: Sym.Sym)

// ── facts: one constructor per relation, with its arity and column types ──
def Flow.i(n: I64): D.Val = D.VInt(n)
def Flow.s(x: Sym.Sym): D.Val = D.VSym(x)
def Flow.fact1(rel: Flow.Rel, a: D.Val): D.Fact = D.Fact(Flow.relSym(rel), Coll.Cons(a, Coll.Nil))
def Flow.fact2(rel: Flow.Rel, a: D.Val, b: D.Val): D.Fact = D.Fact(Flow.relSym(rel), Coll.Cons(a, Coll.Cons(b, Coll.Nil)))
def Flow.fact4(rel: Flow.Rel, a: D.Val, b: D.Val, c: D.Val, d: D.Val): D.Fact = D.Fact(Flow.relSym(rel), Coll.Cons(a, Coll.Cons(b, Coll.Cons(c, Coll.Cons(d, Coll.Nil)))))
def Flow.fFlow(p: I64, q: I64): D.Fact = Flow.fact2(Flow.RFlow, Flow.i(p), Flow.i(q))
def Flow.fStep(p: I64, q: I64, cap: I64, op: Sym.Sym): D.Fact = Flow.fact4(Flow.RStep, Flow.i(p), Flow.i(q), Flow.i(cap), Flow.s(op))
def Flow.fLine(p: I64, line: I64): D.Fact = Flow.fact2(Flow.RLine, Flow.i(p), Flow.i(line))
def Flow.fMerge(m: I64): D.Fact = Flow.fact1(Flow.RMerge, Flow.i(m))
def Flow.fClose(e: I64, cap: I64): D.Fact = Flow.fact2(Flow.RClose, Flow.i(e), Flow.i(cap))
def Flow.fCapOf(cap: I64, proto: Sym.Sym): D.Fact = Flow.fact2(Flow.RCapOf, Flow.i(cap), Flow.s(proto))
def Flow.fCapName(cap: I64, name: Sym.Sym): D.Fact = Flow.fact2(Flow.RCapName, Flow.i(cap), Flow.s(name))
def Flow.fCapLine(cap: I64, line: I64): D.Fact = Flow.fact2(Flow.RCapLine, Flow.i(cap), Flow.i(line))
def Flow.fHandle(p: I64, cap: I64): D.Fact = Flow.fact2(Flow.RHandle, Flow.i(p), Flow.i(cap))
def Flow.fTr(proto: Sym.Sym, op: Sym.Sym, a: Sym.Sym, b: Sym.Sym): D.Fact = Flow.fact4(Flow.RTr, Flow.s(proto), Flow.s(op), Flow.s(a), Flow.s(b))
def Flow.fStart(proto: Sym.Sym, s: Sym.Sym): D.Fact = Flow.fact2(Flow.RStart, Flow.s(proto), Flow.s(s))
def Flow.fSame(a: Sym.Sym, b: Sym.Sym): D.Fact = Flow.fact2(Flow.RSame, Flow.s(a), Flow.s(b))
def Flow.fEndOk(proto: Sym.Sym, s: Sym.Sym): D.Fact = Flow.fact2(Flow.REndOk, Flow.s(proto), Flow.s(s))
def Flow.fWorld(w: I64): D.Fact = Flow.fact1(Flow.RWorld, Flow.i(w))
def Flow.fact3(rel: Flow.Rel, a: D.Val, b: D.Val, c: D.Val): D.Fact = D.Fact(Flow.relSym(rel), Coll.Cons(a, Coll.Cons(b, Coll.Cons(c, Coll.Nil))))
def Flow.fCStep(p: I64, q: I64): D.Fact = Flow.fact2(Flow.RCStep, Flow.i(p), Flow.i(q))
def Flow.fCallee(p: I64, f: Sym.Sym): D.Fact = Flow.fact2(Flow.RCallee, Flow.i(p), Flow.s(f))
def Flow.fBind(p: I64, m: I64, cap: I64): D.Fact = Flow.fact3(Flow.RBind, Flow.i(p), Flow.i(m), Flow.i(cap))
def Flow.fFirst(p: I64, m: I64): D.Fact = Flow.fact2(Flow.RFirst, Flow.i(p), Flow.i(m))
def Flow.fNext(p: I64, m: I64, n: I64): D.Fact = Flow.fact3(Flow.RNext, Flow.i(p), Flow.i(m), Flow.i(n))
def Flow.fLast(p: I64, m: I64): D.Fact = Flow.fact2(Flow.RLast, Flow.i(p), Flow.i(m))
def Flow.fPre(p: I64, j: I64, m: I64, s: Sym.Sym): D.Fact = Flow.fact4(Flow.RPre, Flow.i(p), Flow.i(j), Flow.i(m), Flow.s(s))
def Flow.fPost(p: I64, j: I64, m: I64, s: Sym.Sym): D.Fact = Flow.fact4(Flow.RPost, Flow.i(p), Flow.i(j), Flow.i(m), Flow.s(s))
// a solution id is equal to itself (ambig compares solution ids with !same, as split compares states)
def Flow.fSameI(j: I64): D.Fact = Flow.fact2(Flow.RSame, Flow.i(j), Flow.i(j))
def Flow.fEnter(p: I64, w: I64, cap: I64, s: Sym.Sym): D.Fact = Flow.fact4(Flow.REnter, Flow.i(p), Flow.i(w), Flow.i(cap), Flow.s(s))
def Flow.fWant(p: I64, w: I64, cap: I64, s: Sym.Sym): D.Fact = Flow.fact4(Flow.RWant, Flow.i(p), Flow.i(w), Flow.i(cap), Flow.s(s))
def Flow.fNoSol(line: I64, f: Sym.Sym): D.Fact = Flow.fact2(Flow.RNoSol, Flow.i(line), Flow.s(f))
def Flow.fReadAt(p: I64, x: Sym.Sym, line: I64): D.Fact = Flow.fact3(Flow.RReadAt, Flow.i(p), Flow.s(x), Flow.i(line))
def Flow.fAssign(p: I64, x: Sym.Sym, cap: I64): D.Fact = Flow.fact3(Flow.RAssign, Flow.i(p), Flow.s(x), Flow.i(cap))
def Flow.fAssignFrom(p: I64, x: Sym.Sym, y: Sym.Sym): D.Fact = Flow.fact3(Flow.RAssignFrom, Flow.i(p), Flow.s(x), Flow.s(y))
def Flow.fAssigns(p: I64, x: Sym.Sym): D.Fact = Flow.fact2(Flow.RAssigns, Flow.i(p), Flow.s(x))
def Flow.fEscCap(e: I64, cap: I64, line: I64): D.Fact = Flow.fact3(Flow.REscCap, Flow.i(e), Flow.i(cap), Flow.i(line))
def Flow.fEscVar(e: I64, y: Sym.Sym, line: I64): D.Fact = Flow.fact3(Flow.REscVar, Flow.i(e), Flow.s(y), Flow.i(line))
def Flow.fFin(proto: Sym.Sym, s: Sym.Sym): D.Fact = Flow.fact2(Flow.RFin, Flow.s(proto), Flow.s(s))

def Flow.add(st: Flow.St, f: D.Fact): Flow.St =
  val Flow.St(n, fs, cs) = st
  Flow.St(n, Coll.Cons(f, fs), cs)

// a fresh id
def Flow.fresh(st: Flow.St): Flow.At =
  val Flow.St(n, fs, cs) = st
  Flow.At(Flow.St(n + 1, fs, cs), n)

def Flow.edge(st: Flow.St, p: I64, q: I64): Flow.St = Flow.add(st, Flow.fFlow(p, q))

// a fresh point that control reaches from p
def Flow.next(st: Flow.St, p: I64): Flow.At =
  val Flow.At(st2, q) = Flow.fresh(st)
  Flow.At(Flow.edge(st2, p, q), q)

// the capability named x in scope, innermost first
def Flow.capNamed(cs: Coll.List[Flow.Cap], x: Sym.Sym): Coll.Option[Flow.Cap] = cs match
  case Coll.Nil => Coll.None
  case Coll.Cons(c, rest) =>
    val Flow.Cap(n, _, _, _) = c
    if Sym.eq(n, x) then Coll.Some(c) else Flow.capNamed(rest, x)

// the protocol a handler implements
def Flow.protoOf(hs: Coll.List[Ast.Handler], h: Sym.Sym): Coll.Option[Sym.Sym] = hs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Ast.Handler(_, n, p, _) = x
    if Sym.eq(n, h) then Coll.Some(p) else Flow.protoOf(rest, h)

// ── the walk: e from point p ──
def Flow.expr(cx: Flow.Cx, st: Flow.St, p: I64, e: Ast.Expr): Flow.At = e match
  case Ast.Call(line, f, _, chosen, xs) =>
    val Flow.At(st2, pa) = Flow.exprs(cx, st, p, xs)
    val Flow.Cx(ps, _, fns, es, _, _) = cx
    Flow.fnNamed(fns, f) match
      case Coll.Some(g) => Flow.call(ps, st2, pa, g, chosen, line)
      case Coll.None => if Flow.isCtor(es, f) then Flow.alloc(st2, pa, line) else Flow.request(st2, pa, Eff.reqOf(ps, f), line)
  case Ast.Method(line, recv, op, xs) =>
    val Flow.At(st2, pa) = Flow.exprs(cx, st, p, xs)
    val Flow.St(_, _, cs) = st2
    Flow.capNamed(cs, recv) match
      case Coll.None => Flow.At(st2, pa)
      case Coll.Some(c) => Flow.step(st2, pa, c, op, line)
  case Ast.Bin(_, _, l, rhs) =>
    val Flow.At(st2, p2) = Flow.expr(cx, st, p, l)
    Flow.expr(cx, st2, p2, rhs)
  case Ast.Un(_, _, x) => Flow.expr(cx, st, p, x)
  case Ast.If(line, c, t, x) =>
    val Flow.At(st1, pc) = Flow.expr(cx, st, p, c)
    val Flow.At(st2, t0) = Flow.next(st1, pc)
    val Flow.At(st3, pt) = Flow.expr(cx, st2, t0, t)
    val Flow.At(st4, e0) = Flow.next(st3, pc)
    val Flow.At(st5, pe) = Flow.expr(cx, st4, e0, x)
    val Flow.At(st6, m) = Flow.next(st5, pt)
    Flow.At(Flow.merge(Flow.edge(st6, pe, m), m, line), m)
  case Ast.While(line, c, b) =>
    val Flow.At(st1, h) = Flow.next(st, p)
    val Flow.At(st2, pc) = Flow.expr(cx, st1, h, c)
    val Flow.At(st3, b0) = Flow.next(st2, pc)
    val Flow.At(st4, pb) = Flow.expr(cx, st3, b0, b)
    val Flow.At(st5, x) = Flow.next(Flow.merge(Flow.edge(st4, pb, h), h, line), pc)
    Flow.At(st5, x)
  case Ast.Block(line, ss, last) => Flow.block(cx, st, p, ss, last, line)
  case Ast.Assign(_, x, v) => Flow.bindVal(cx, st, p, x, v)
  case Ast.Match(line, s, arms) =>
    val Flow.At(st1, ps) = Flow.expr(cx, st, p, s)
    val Flow.At(st2, m) = Flow.fresh(st1)
    val Flow.St(_, _, cs) = st2
    Flow.At(Flow.merge(Flow.arms(cx, st2, ps, m, Flow.srcs(cx, cs, s, Coll.Nil), arms), m, line), m)
  case Ast.Name(line, x) => Flow.At(Flow.add(st, Flow.fReadAt(p, x, line)), p)
  case _ => Flow.At(st, p)

// each arm a branch from ps (the point after the scrutinee) to the merge point m; its pattern binders hold what the
// scrutinee holds (sv)
def Flow.arms(cx: Flow.Cx, st: Flow.St, ps: I64, m: I64, sv: Coll.List[Flow.Src], arms: Coll.List[Ast.Arm]): Flow.St = arms match
  case Coll.Nil => st
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, pat, b) = a
    val binds = Flow.patBinds(pat)
    val Flow.At(st1, a0) = Flow.next(st, ps)
    val Flow.At(st2, a1) = Flow.assignAll(st1, a0, binds, sv)
    val Flow.At(st3, pa) = Flow.expr(cx, st2, a1, b)
    Flow.arms(cx, Flow.edge(st3, pa, m), ps, m, sv, rest)

// the names a pattern binds (a wildcard binds none)
def Flow.patBinds(p: Ast.Pat): Coll.List[Sym.Sym] = p match
  case Ast.PCase(_, binds) => binds
  case Ast.PAny => Coll.Nil

// ── CAPS (R3, flow-design.md; parity C1-C4): the regions a value lives in. a source is a capability (a constructor's
// Region, a callee's region binder) or a name (what that name holds at the read point) ──
enum Flow.Src:
  case Flow.SCap(c: I64)
  case Flow.SVar(x: Sym.Sym)

// the sources of e: a constructor lives in the innermost Region and in its args' sources; a call whose result is data
// (an enum) lives in the capabilities its region binders take, in the innermost Region when its row has Region, and in
// its args' sources (s1 rho); if, match and block take the union of their values
def Flow.srcs(cx: Flow.Cx, cs: Coll.List[Flow.Cap], e: Ast.Expr, acc: Coll.List[Flow.Src]): Coll.List[Flow.Src] = e match
  case Ast.Name(_, x) => Coll.Cons(Flow.SVar(x), acc)
  case Ast.Call(_, f, _, chosen, xs) =>
    val Flow.Cx(ps, _, fns, es, _, rows) = cx
    Flow.fnNamed(fns, f) match
      case Coll.Some(g) =>
        val Ast.Fn(_, _, gs, _, ret, _, _) = g
        val Ast.Ty(_, rn, _, _, _) = ret
        // a [] binder result may be any arg (pick) or made from one (a given's method): it lives in every arg's region
        // too (vic-m5r.15)
        val data = Flow.isEnumName(es, rn) || Ty.memberSym(rn, Ty.tparams(gs, Coll.Nil))
        val acc2 = if Eff.has(rows, f, Sym.of("Region")) then Flow.inRegion(cs, acc) else acc
        if data then Flow.srcsAll(cx, cs, xs, Flow.regionSrcs(cs, chosen, Flow.regionBs(Flow.capBs(ps, gs, 0, Coll.Nil), Coll.Nil), acc2)) else acc
      case Coll.None => if Flow.isCtor(es, f) then Flow.srcsAll(cx, cs, xs, Flow.inRegion(cs, acc)) else acc
  case Ast.If(_, _, t, x) => Flow.srcs(cx, cs, x, Flow.srcs(cx, cs, t, acc))
  case Ast.Block(_, _, last) => Flow.srcs(cx, cs, last, acc)
  case Ast.Match(_, _, arms) => Flow.srcsArms(cx, cs, arms, acc)
  // a method of {} evidence (a given turns an A into a B): its result keeps its args' regions
  case Ast.Method(_, _, _, xs) => Flow.srcsAll(cx, cs, xs, acc)
  case _ => acc

def Flow.srcsAll(cx: Flow.Cx, cs: Coll.List[Flow.Cap], xs: Coll.List[Ast.Expr], acc: Coll.List[Flow.Src]): Coll.List[Flow.Src] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Flow.srcsAll(cx, cs, rest, Flow.srcs(cx, cs, x, acc))

def Flow.srcsArms(cx: Flow.Cx, cs: Coll.List[Flow.Cap], arms: Coll.List[Ast.Arm], acc: Coll.List[Flow.Src]): Coll.List[Flow.Src] = arms match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, b) = a
    Flow.srcsArms(cx, cs, rest, Flow.srcs(cx, cs, b, acc))

def Flow.isEnumName(es: Coll.List[Ast.Enum], n: Sym.Sym): Bool = es match
  case Coll.Nil => false
  case Coll.Cons(e, rest) =>
    val Ast.Enum(_, name, _, _) = e
    if Sym.eq(name, n) then true else Flow.isEnumName(rest, n)

// the binders of protocol Region
def Flow.regionBs(bs: Coll.List[Flow.CapB], acc: Coll.List[Flow.CapB]): Coll.List[Flow.CapB] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Flow.CapB(_, _, proto) = b
    if Sym.eq(proto, Sym.of("Region")) then Flow.regionBs(rest, Coll.Cons(b, acc)) else Flow.regionBs(rest, acc)

// the caller capability each region binder takes (as at the call: the chosen name or the one in scope)
def Flow.regionSrcs(cs: Coll.List[Flow.Cap], chosen: Coll.List[Sym.Sym], bs: Coll.List[Flow.CapB], acc: Coll.List[Flow.Src]): Coll.List[Flow.Src] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) => Flow.capFor(cs, chosen, b) match
    case Coll.None => Flow.regionSrcs(cs, chosen, rest, acc)
    case Coll.Some(c) =>
      val Flow.Cap(_, id, _, _) = c
      Flow.regionSrcs(cs, chosen, rest, Coll.Cons(Flow.SCap(id), acc))

// x = v (val, var, assign): v is walked; when v has sources, a fresh point assigns them to x (strong update)
def Flow.bindVal(cx: Flow.Cx, st: Flow.St, p: I64, x: Sym.Sym, v: Ast.Expr): Flow.At =
  val Flow.At(st1, pv) = Flow.expr(cx, st, p, v)
  val Flow.St(_, _, cs) = st1
  Flow.assignAll(st1, pv, Coll.Cons(x, Coll.Nil), Flow.srcs(cx, cs, v, Coll.Nil))

// each x of xs gets the sources sv at a fresh point after p (no sources: nothing to assign, no point)
def Flow.assignAll(st: Flow.St, p: I64, xs: Coll.List[Sym.Sym], sv: Coll.List[Flow.Src]): Flow.At = sv match
  case Coll.Nil => Flow.At(st, p)
  case Coll.Cons(_, _) => xs match
    case Coll.Nil => Flow.At(st, p)
    case Coll.Cons(_, _) =>
      val Flow.At(st1, a) = Flow.next(st, p)
      val st2 = Flow.assignFacts(st1, a, xs, sv)
      Flow.next(st2, a)

def Flow.assignFacts(st: Flow.St, a: I64, xs: Coll.List[Sym.Sym], sv: Coll.List[Flow.Src]): Flow.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) => Flow.assignFacts(Flow.srcFacts(Flow.add(st, Flow.fAssigns(a, x)), a, x, sv), a, rest, sv)

def Flow.srcFacts(st: Flow.St, a: I64, x: Sym.Sym, sv: Coll.List[Flow.Src]): Flow.St = sv match
  case Coll.Nil => st
  case Coll.Cons(s, rest) => s match
    case Flow.SCap(c) => Flow.srcFacts(Flow.add(st, Flow.fAssign(a, x, c)), a, x, rest)
    case Flow.SVar(y) => Flow.srcFacts(Flow.add(st, Flow.fAssignFrom(a, x, y)), a, x, rest)

def Flow.exprs(cx: Flow.Cx, st: Flow.St, p: I64, xs: Coll.List[Ast.Expr]): Flow.At = xs match
  case Coll.Nil => Flow.At(st, p)
  case Coll.Cons(x, rest) =>
    val Flow.At(st2, p2) = Flow.expr(cx, st, p, x)
    Flow.exprs(cx, st2, p2, rest)

// m is a merge point (branches or a loop meet) at line
def Flow.merge(st: Flow.St, m: I64, line: I64): Flow.St =
  Flow.add(Flow.add(st, Flow.fMerge(m)), Flow.fLine(m, line))

// op on capability c after point p: a step from a fresh point of its own (its only out edge, its only line) to a
// fresh point
def Flow.step(st: Flow.St, p: I64, c: Flow.Cap, op: Sym.Sym, line: I64): Flow.At =
  val Flow.Cap(_, id, _, _) = c
  val Flow.At(st1, s) = Flow.next(st, p)
  val Flow.At(st2, q) = Flow.fresh(st1)
  val st3 = Flow.add(st2, Flow.fStep(s, q, id, op))
  Flow.At(Flow.add(st3, Flow.fLine(s, line)), q)

// a constructor call (written with args: a nullary case takes no ()) is a request on Region: an alloc step on the
// innermost Region in scope. none here: the def's implicit Region (its row, s2/eff.srs), owned by a caller
def Flow.alloc(st: Flow.St, p: I64, line: I64): Flow.At = Flow.request(st, p, Coll.Some(Eff.Req(Sym.of("Region"), Sym.of("alloc"))), line)

// a request P.op(...): a step of the innermost capability of P in scope (none: the implicit one, not tracked here)
def Flow.request(st: Flow.St, p: I64, q: Coll.Option[Eff.Req], line: I64): Flow.At = q match
  case Coll.None => Flow.At(st, p)
  case Coll.Some(rq) =>
    val Eff.Req(proto, op) = rq
    val Flow.St(_, _, cs) = st
    Flow.innermost(cs, proto) match
      case Coll.None => Flow.At(st, p)
      case Coll.Some(c) => Flow.step(st, p, c, op, line)

// the innermost Region in scope as a source (none: the implicit one, a caller's)
def Flow.inRegion(cs: Coll.List[Flow.Cap], acc: Coll.List[Flow.Src]): Coll.List[Flow.Src] = Flow.innermost(cs, Sym.of("Region")) match
  case Coll.None => acc
  case Coll.Some(c) =>
    val Flow.Cap(_, id, _, _) = c
    Coll.Cons(Flow.SCap(id), acc)

def Flow.innermost(cs: Coll.List[Flow.Cap], proto: Sym.Sym): Coll.Option[Flow.Cap] = cs match
  case Coll.Nil => Coll.None
  case Coll.Cons(c, rest) =>
    val Flow.Cap(_, _, p, _) = c
    if Sym.eq(p, proto) then Coll.Some(c) else Flow.innermost(rest, proto)

def Flow.isCtor(es: Coll.List[Ast.Enum], f: Sym.Sym): Bool = es match
  case Coll.Nil => false
  case Coll.Cons(e, rest) =>
    val Ast.Enum(_, _, _, cases) = e
    if Flow.caseIn(cases, f) then true else Flow.isCtor(rest, f)

def Flow.caseIn(cases: Coll.List[Ast.Case], f: Sym.Sym): Bool = cases match
  case Coll.Nil => false
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    if Sym.eq(n, f) then true else Flow.caseIn(rest, f)

// ── calls (R2, flow-design.md): the step point is the kind, so pre/post/param facts are per call site ──
// a capability binder of a callee: its {} binder name, its index among the {} binders (f{a, b}(x) picks by it), its
// protocol
enum Flow.CapB:
  case Flow.CapB(x: Sym.Sym, curly: I64, proto: Sym.Sym)

// a fact variable bound to a state
enum Flow.VS:
  case Flow.VS(x: Sym.Sym, s: Sym.Sym)

def Flow.fnNamed(fns: Coll.List[Ast.Fn], f: Sym.Sym): Coll.Option[Ast.Fn] = fns match
  case Coll.Nil => Coll.None
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, n, _, _, _, _, _) = g
    if Sym.eq(n, f) then Coll.Some(g) else Flow.fnNamed(rest, f)

def Flow.protoNamed(ps: Coll.List[Ast.Proto], n: Sym.Sym): Coll.Option[Ast.Proto] = ps match
  case Coll.Nil => Coll.None
  case Coll.Cons(p, rest) =>
    val Ast.Proto(_, name, _, _, _, _, _, _) = p
    if Sym.eq(name, n) then Coll.Some(p) else Flow.protoNamed(rest, n)

// the {} binders of the groups gs whose type is a protocol, in written order; i = the {} index of the next binder
def Flow.capBs(ps: Coll.List[Ast.Proto], gs: Coll.List[Ast.Group], i: I64, acc: Coll.List[Flow.CapB]): Coll.List[Flow.CapB] = gs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(g, rest) => g match
    case Ast.Evidence(bs) => Flow.capBsOf(ps, rest, bs, i, acc)
    case Ast.Types(_) => Flow.capBs(ps, rest, i, acc)
    case Ast.Facts(_) => Flow.capBs(ps, rest, i, acc)

def Flow.capBsOf(ps: Coll.List[Ast.Proto], gs: Coll.List[Ast.Group], bs: Coll.List[Ast.Binder], i: I64, acc: Coll.List[Flow.CapB]): Coll.List[Flow.CapB] = bs match
  case Coll.Nil => Flow.capBs(ps, gs, i, acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, ty) = b
    val Ast.Ty(_, tn, _, _, _) = ty
    Flow.protoNamed(ps, tn) match
      case Coll.None => Flow.capBsOf(ps, gs, rest, i + 1, acc)
      case Coll.Some(_) => Flow.capBsOf(ps, gs, rest, i + 1, Coll.Cons(Flow.CapB(x, i, tn), acc))

// the entry atoms of f (its <> groups before the params)
def Flow.entryAtoms(gs: Coll.List[Ast.Group], acc: Coll.List[Ast.Atom]): Coll.List[Ast.Atom] = gs match
  case Coll.Nil => acc
  case Coll.Cons(g, rest) => g match
    case Ast.Facts(atoms) => Flow.entryAtoms(rest, Coll.revOnto(Coll.rev(atoms), acc))
    case Ast.Types(_) => Flow.entryAtoms(rest, acc)
    case Ast.Evidence(_) => Flow.entryAtoms(rest, acc)

// the caller capability a binder takes: the chosen name (f{a}(x)), else the one capability of its protocol in scope;
// None when there is none or more than one (the names check reports it, s1/check.srs:643-660)
def Flow.capFor(cs: Coll.List[Flow.Cap], chosen: Coll.List[Sym.Sym], b: Flow.CapB): Coll.Option[Flow.Cap] =
  val Flow.CapB(_, i, proto) = b
  chosen match
    case Coll.Nil => Flow.onlyCap(cs, proto, Coll.None)
    case Coll.Cons(_, _) => Flow.nthSym(chosen, i) match
      case Coll.None => Coll.None
      case Coll.Some(n) => Flow.capOfProto(Flow.capNamed(cs, n), proto)

def Flow.capOfProto(c: Coll.Option[Flow.Cap], proto: Sym.Sym): Coll.Option[Flow.Cap] = c match
  case Coll.None => c
  case Coll.Some(x) =>
    val Flow.Cap(_, _, p, _) = x
    if Sym.eq(p, proto) then c else Coll.None

def Flow.nthSym(xs: Coll.List[Sym.Sym], i: I64): Coll.Option[Sym.Sym] = xs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) => if i == 0 then Coll.Some(x) else Flow.nthSym(rest, i - 1)

// the one capability of protocol proto in cs (a name shadowed by an inner one counts once)
def Flow.onlyCap(cs: Coll.List[Flow.Cap], proto: Sym.Sym, found: Coll.Option[Flow.Cap]): Coll.Option[Flow.Cap] = cs match
  case Coll.Nil => found
  case Coll.Cons(c, rest) =>
    val Flow.Cap(n, _, p, _) = c
    if !Sym.eq(p, proto) then Flow.onlyCap(rest, proto, found)
    else found match
      case Coll.None => Flow.onlyCap(rest, proto, Coll.Some(c))
      case Coll.Some(f) =>
        val Flow.Cap(fn, _, _, _) = f
        if Sym.eq(fn, n) then Flow.onlyCap(rest, proto, found) else Coll.None

// the caller capability of every binder, in order; None when one is missing
def Flow.capsFor(cs: Coll.List[Flow.Cap], chosen: Coll.List[Sym.Sym], bs: Coll.List[Flow.CapB], acc: Coll.List[Flow.Cap]): Coll.Option[Coll.List[Flow.Cap]] = bs match
  case Coll.Nil => Coll.Some(Coll.rev(acc))
  case Coll.Cons(b, rest) => Flow.capFor(cs, chosen, b) match
    case Coll.None => Coll.None
    case Coll.Some(c) => Flow.capsFor(cs, chosen, rest, Coll.Cons(c, acc))

// a call of g after point p: a step from a fresh point to a fresh point, each capability binder bound to its caller
// capability, and the solutions of g's entry facts as pre/post states per binder
def Flow.call(ps: Coll.List[Ast.Proto], st: Flow.St, p: I64, g: Ast.Fn, chosen: Coll.List[Sym.Sym], line: I64): Flow.At =
  val Ast.Fn(_, name, gs, _, _, exit, _) = g
  val bs = Flow.capBs(ps, gs, 0, Coll.Nil)
  val Flow.St(_, _, cs) = st
  bs match
    case Coll.Nil => Flow.At(st, p)
    case Coll.Cons(_, _) => Flow.capsFor(cs, chosen, bs, Coll.Nil) match
      case Coll.None => Flow.At(st, p)
      case Coll.Some(caps) =>
        val Flow.At(st1, s) = Flow.next(st, p)
        val Flow.At(st2, q) = Flow.fresh(st1)
        val st3 = Flow.add(Flow.add(Flow.add(st2, Flow.fCStep(s, q)), Flow.fLine(s, line)), Flow.fCallee(s, name))
        val st4 = Flow.binds(st3, s, caps, 0)
        val atoms = Flow.entryAtoms(gs, Coll.Nil)
        val vars = Flow.varsOf(atoms, Coll.Nil)
        Flow.At(Flow.sols(ps, st4, s, bs, atoms, exit, Flow.assigns(ps, Flow.ruleModels(ps, bs, Coll.Nil), bs, atoms, vars, Coll.Nil, Coll.Nil), 0), q)

// bind(s, i, c), and the param chain firstParam / nextParam / lastParam
def Flow.binds(st: Flow.St, s: I64, caps: Coll.List[Flow.Cap], i: I64): Flow.St = caps match
  case Coll.Nil => st
  case Coll.Cons(c, rest) =>
    val Flow.Cap(_, id, _, _) = c
    val st1 = Flow.add(st, Flow.fBind(s, i, id))
    val st2 = if i == 0 then Flow.add(st1, Flow.fFirst(s, i)) else Flow.add(st1, Flow.fNext(s, i - 1, i))
    val st3 = rest match
      case Coll.Nil => Flow.add(st2, Flow.fLast(s, i))
      case Coll.Cons(_, _) => st2
    Flow.binds(st3, s, rest, i + 1)

def Flow.isVar(x: Sym.Sym): Bool =
  val c = Str.at(Sym.str(x), 0)
  c >= 'a' && c <= 'z'

// the state positions of an atom: at(_, S), next(S1, _, S2), every arg of a rule atom (s1/facts.srs statePos)
def Flow.statePos(a: Ast.Atom): Coll.List[Ast.Term] =
  val Ast.Atom(_, rel, args) = a
  if Sym.eq(rel, Sym.of("at")) then Flow.dropOne(args)
  else if Sym.eq(rel, Sym.of("next")) then Flow.firstLast(args)
  else args

def Flow.dropOne(xs: Coll.List[Ast.Term]): Coll.List[Ast.Term] = xs match
  case Coll.Nil => xs
  case Coll.Cons(_, rest) => rest

def Flow.firstLast(xs: Coll.List[Ast.Term]): Coll.List[Ast.Term] = xs match
  case Coll.Cons(a, r1) => r1 match
    case Coll.Cons(_, r2) => r2 match
      case Coll.Cons(b, _) => Coll.Cons(a, Coll.Cons(b, Coll.Nil))
      case Coll.Nil => Coll.Nil
    case Coll.Nil => Coll.Nil
  case Coll.Nil => Coll.Nil

def Flow.termSym(t: Ast.Term): Coll.Option[Sym.Sym] = t match
  case Ast.TName(n) => Coll.Some(n)
  case Ast.TNum(_) => Coll.None

// the fact variables of the atoms, each once, in written order
def Flow.varsOf(atoms: Coll.List[Ast.Atom], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = atoms match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(a, rest) => Flow.varsOf(rest, Flow.varsIn(Flow.statePos(a), acc))

def Flow.varsIn(ts: Coll.List[Ast.Term], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ts match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) => Flow.termSym(t) match
    case Coll.None => Flow.varsIn(rest, acc)
    case Coll.Some(x) => if Flow.isVar(x) && !Flow.memberSym(x, acc) then Flow.varsIn(rest, Coll.Cons(x, acc)) else Flow.varsIn(rest, acc)

// every assignment of vars to states (each over the states of all binder protocols) whose next and rule atoms hold
def Flow.assigns(ps: Coll.List[Ast.Proto], ms: Coll.List[Flow.PM], bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], vars: Coll.List[Sym.Sym], a: Coll.List[Flow.VS], acc: Coll.List[Coll.List[Flow.VS]]): Coll.List[Coll.List[Flow.VS]] = vars match
  case Coll.Nil => if Flow.atomsHold(ps, ms, bs, atoms, a) then Coll.Cons(a, acc) else acc
  case Coll.Cons(x, rest) => Flow.assignEach(ps, ms, bs, atoms, x, rest, a, Flow.statesOf(ps, bs, Coll.Nil), acc)

def Flow.assignEach(ps: Coll.List[Ast.Proto], ms: Coll.List[Flow.PM], bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], x: Sym.Sym, rest: Coll.List[Sym.Sym], a: Coll.List[Flow.VS], ss: Coll.List[Sym.Sym], acc: Coll.List[Coll.List[Flow.VS]]): Coll.List[Coll.List[Flow.VS]] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, more) => Flow.assignEach(ps, ms, bs, atoms, x, rest, a, more, Flow.assigns(ps, ms, bs, atoms, rest, Coll.Cons(Flow.VS(x, s), a), acc))

// the states of the binder protocols, each once
def Flow.statesOf(ps: Coll.List[Ast.Proto], bs: Coll.List[Flow.CapB], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Flow.CapB(_, _, proto) = b
    Flow.protoNamed(ps, proto) match
      case Coll.None => Flow.statesOf(ps, rest, acc)
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, states, _, _, _, _, _) = pr
        Flow.statesOf(ps, rest, Flow.addNew(states, acc))

def Flow.addNew(xs: Coll.List[Sym.Sym], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => if Flow.memberSym(x, acc) then Flow.addNew(rest, acc) else Flow.addNew(rest, Coll.Cons(x, acc))

// a name under an assignment: a variable's state, else the name itself
def Flow.resolve(a: Coll.List[Flow.VS], x: Sym.Sym): Sym.Sym = a match
  case Coll.Nil => x
  case Coll.Cons(v, rest) =>
    val Flow.VS(y, s) = v
    if Sym.eq(x, y) then s else Flow.resolve(rest, x)

// every next(S1, op, S2) atom is a transition of op in a binder protocol, and every rule atom holds in the rule model of
// a binder protocol (at atoms are pre/post states, not filters)
def Flow.atomsHold(ps: Coll.List[Ast.Proto], ms: Coll.List[Flow.PM], bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], a: Coll.List[Flow.VS]): Bool = atoms match
  case Coll.Nil => true
  case Coll.Cons(at, rest) =>
    val Ast.Atom(_, rel, args) = at
    if Sym.eq(rel, Sym.of("at")) then Flow.atomsHold(ps, ms, bs, rest, a)
    else if Sym.eq(rel, Sym.of("next")) then
      Flow.nextHolds(ps, bs, args, a) match
        case Coll.Nil => false
        case Coll.Cons(_, _) => Flow.atomsHold(ps, ms, bs, rest, a)
    else if Flow.ruleHolds(ms, rel, Flow.tupleOf(args, a, Coll.Nil)) then Flow.atomsHold(ps, ms, bs, rest, a)
    else false

// ── protocol rule defs (s1/facts.srs, vic 2026-11-05: a protocol is its own Datalog program): each binder protocol with
// rule defs is solved once over its next facts; a rule atom of a def holds when its tuple is in that model ──
enum Flow.PM:
  case Flow.PM(proto: Sym.Sym, m: D.Model)

// the args of an atom under an assignment, as values
def Flow.tupleOf(ts: Coll.List[Ast.Term], a: Coll.List[Flow.VS], acc: Coll.List[D.Val]): Coll.List[D.Val] = ts match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(t, rest) => t match
    case Ast.TName(n) => Flow.tupleOf(rest, a, Coll.Cons(D.VSym(Flow.resolve(a, n)), acc))
    case Ast.TNum(v) => Flow.tupleOf(rest, a, Coll.Cons(D.VInt(v), acc))

def Flow.ruleHolds(ms: Coll.List[Flow.PM], rel: Sym.Sym, t: Coll.List[D.Val]): Bool = ms match
  case Coll.Nil => false
  case Coll.Cons(pm, rest) =>
    val Flow.PM(_, m) = pm
    if Flow.inTuples(D.tuples(m, rel), t) then true else Flow.ruleHolds(rest, rel, t)

def Flow.inTuples(ts: Coll.List[Coll.List[D.Val]], t: Coll.List[D.Val]): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(u, rest) => if D.tupleEq(u, t) then true else Flow.inTuples(rest, t)

// the rule model of every binder protocol that has rule defs (a protocol whose rules D rejects has none: the decl check
// reports it)
def Flow.ruleModels(ps: Coll.List[Ast.Proto], bs: Coll.List[Flow.CapB], acc: Coll.List[Flow.PM]): Coll.List[Flow.PM] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Flow.CapB(_, _, proto) = b
    Flow.protoNamed(ps, proto) match
      case Coll.None => Flow.ruleModels(ps, rest, acc)
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, _, _, _, _, ops, rules) = pr
        rules match
          case Coll.Nil => Flow.ruleModels(ps, rest, acc)
          case Coll.Cons(_, _) => D.solve(Flow.ruleDefs(rules, Coll.Nil), Flow.nextFacts(ops, Coll.Nil)) match
            case D.Solved(m) => Flow.ruleModels(ps, rest, Coll.Cons(Flow.PM(proto, m), acc))
            case D.Unsafe(_) => Flow.ruleModels(ps, rest, acc)
            case D.NegCycle(_) => Flow.ruleModels(ps, rest, acc)

// next(S1, op, S2) for every transition of every op
def Flow.nextFacts(ops: Coll.List[Ast.Op], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = ops match
  case Coll.Nil => acc
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, name, _, _, trs) = o
    Flow.nextFacts(rest, Flow.nextOf(name, trs, acc))

def Flow.nextOf(op: Sym.Sym, trs: Coll.List[Ast.Trans], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = trs match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) =>
    val Ast.Trans(a, b) = t
    Flow.nextOf(op, rest, Coll.Cons(D.Fact(Sym.of("next"), Coll.Cons(D.VSym(a), Coll.Cons(D.VSym(op), Coll.Cons(D.VSym(b), Coll.Nil)))), acc))

// rule def name(params) = body as a D.Rule: variables are the lowercase names in state positions (the op of next is a
// constant), numbered in first-seen order from the params
def Flow.ruleDefs(rs: Coll.List[Ast.RuleDef], acc: Coll.List[D.Rule]): Coll.List[D.Rule] = rs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(rd, rest) =>
    val Ast.RuleDef(_, name, params, body) = rd
    val vs = Flow.varsOf(body, Coll.rev(params))
    Flow.ruleDefs(rest, Coll.Cons(D.Rule(D.Atom(name, Flow.argsOfNames(params, vs, Coll.Nil)), Flow.bodyLits(body, vs, Coll.Nil)), acc))

def Flow.argOf(x: Sym.Sym, vs: Coll.List[Sym.Sym]): D.Arg = Flow.indexSym(vs, x, 0) match
  case Coll.Some(i) => D.AVar(i)
  case Coll.None => D.AVal(D.VSym(x))

def Flow.indexSym(xs: Coll.List[Sym.Sym], x: Sym.Sym, i: I64): Coll.Option[I64] = xs match
  case Coll.Nil => Coll.None
  case Coll.Cons(y, rest) => if Sym.eq(x, y) then Coll.Some(i) else Flow.indexSym(rest, x, i + 1)

def Flow.argsOfNames(xs: Coll.List[Sym.Sym], vs: Coll.List[Sym.Sym], acc: Coll.List[D.Arg]): Coll.List[D.Arg] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(x, rest) => Flow.argsOfNames(rest, vs, Coll.Cons(Flow.argOf(x, vs), acc))

// a body atom: next keeps its op as a constant, any other relation maps each name (variable or constant)
def Flow.bodyLits(atoms: Coll.List[Ast.Atom], vs: Coll.List[Sym.Sym], acc: Coll.List[D.Lit]): Coll.List[D.Lit] = atoms match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(at, rest) =>
    val Ast.Atom(_, rel, args) = at
    Flow.bodyLits(rest, vs, Coll.Cons(D.Pos(D.Atom(rel, Flow.termArgs(args, vs, Coll.Nil))), acc))

// the args of an atom: a name in vs is a variable, any other a constant (the op of next is never in vs: statePos skips it)
def Flow.termArgs(ts: Coll.List[Ast.Term], vs: Coll.List[Sym.Sym], acc: Coll.List[D.Arg]): Coll.List[D.Arg] = ts match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(t, rest) => t match
    case Ast.TNum(v) => Flow.termArgs(rest, vs, Coll.Cons(D.AVal(D.VInt(v)), acc))
    case Ast.TName(n) => Flow.termArgs(rest, vs, Coll.Cons(Flow.argOf(n, vs), acc))

// the binder protocols with a transition op: S1 -> S2 for the args of a next atom (empty = it does not hold)
def Flow.nextHolds(ps: Coll.List[Ast.Proto], bs: Coll.List[Flow.CapB], args: Coll.List[Ast.Term], a: Coll.List[Flow.VS]): Coll.List[Flow.CapB] = args match
  case Coll.Cons(t1, r1) => r1 match
    case Coll.Cons(t2, r2) => r2 match
      case Coll.Cons(t3, _) => Flow.nextIn(ps, bs, Flow.termSym(t1), Flow.termSym(t2), Flow.termSym(t3), a, Coll.Nil)
      case Coll.Nil => Coll.Nil
    case Coll.Nil => Coll.Nil
  case Coll.Nil => Coll.Nil

def Flow.nextIn(ps: Coll.List[Ast.Proto], bs: Coll.List[Flow.CapB], s1: Coll.Option[Sym.Sym], op: Coll.Option[Sym.Sym], s2: Coll.Option[Sym.Sym], a: Coll.List[Flow.VS], acc: Coll.List[Flow.CapB]): Coll.List[Flow.CapB] = s1 match
  case Coll.None => acc
  case Coll.Some(x1) => op match
    case Coll.None => acc
    case Coll.Some(o) => s2 match
      case Coll.None => acc
      case Coll.Some(x2) => Flow.withTrans(ps, bs, Flow.resolve(a, x1), o, Flow.resolve(a, x2), acc)

def Flow.withTrans(ps: Coll.List[Ast.Proto], bs: Coll.List[Flow.CapB], a: Sym.Sym, op: Sym.Sym, b: Sym.Sym, acc: Coll.List[Flow.CapB]): Coll.List[Flow.CapB] = bs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) =>
    val Flow.CapB(_, _, proto) = x
    val ok: Bool = Flow.protoNamed(ps, proto) match
      case Coll.None => false
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
        Flow.opHas(ops, op, a, b)
    if ok then Flow.withTrans(ps, rest, a, op, b, Coll.Cons(x, acc)) else Flow.withTrans(ps, rest, a, op, b, acc)

def Flow.opHas(ops: Coll.List[Ast.Op], op: Sym.Sym, a: Sym.Sym, b: Sym.Sym): Bool = ops match
  case Coll.Nil => false
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, name, _, _, trs) = o
    if Sym.eq(name, op) && Flow.transHas(trs, a, b) then true else Flow.opHas(rest, op, a, b)

def Flow.transHas(trs: Coll.List[Ast.Trans], a: Sym.Sym, b: Sym.Sym): Bool = trs match
  case Coll.Nil => false
  case Coll.Cons(t, rest) =>
    val Ast.Trans(x, y) = t
    if Sym.eq(x, a) && Sym.eq(y, b) then true else Flow.transHas(rest, a, b)

// the state an at(binder, S) atom gives under a, or None when the binder has no such atom
def Flow.atState(atoms: Coll.List[Ast.Atom], x: Sym.Sym, a: Coll.List[Flow.VS]): Coll.Option[Sym.Sym] = atoms match
  case Coll.Nil => Coll.None
  case Coll.Cons(at, rest) =>
    val Ast.Atom(_, rel, args) = at
    if Sym.eq(rel, Sym.of("at")) then Flow.atArgs(args, x, a, rest) else Flow.atState(rest, x, a)

def Flow.atArgs(args: Coll.List[Ast.Term], x: Sym.Sym, a: Coll.List[Flow.VS], rest: Coll.List[Ast.Atom]): Coll.Option[Sym.Sym] = args match
  case Coll.Cons(t1, r1) => r1 match
    case Coll.Cons(t2, _) => Flow.termSym(t1) match
      case Coll.Some(c) => if Sym.eq(c, x) then Flow.resolved(Flow.termSym(t2), a) else Flow.atState(rest, x, a)
      case Coll.None => Flow.atState(rest, x, a)
    case Coll.Nil => Flow.atState(rest, x, a)
  case Coll.Nil => Flow.atState(rest, x, a)

def Flow.resolved(t: Coll.Option[Sym.Sym], a: Coll.List[Flow.VS]): Coll.Option[Sym.Sym] = t match
  case Coll.None => t
  case Coll.Some(s) => Coll.Some(Flow.resolve(a, s))

// solution j per assignment: pre = the entry at() state, else the protocol start (s1/check.srs:899); post = the exit
// at() state, else pre
def Flow.sols(ps: Coll.List[Ast.Proto], st: Flow.St, s: I64, bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], exit: Coll.List[Ast.Atom], as: Coll.List[Coll.List[Flow.VS]], j: I64): Flow.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) => Flow.sols(ps, Flow.prePost(ps, Flow.add(st, Flow.fSameI(j)), s, j, bs, atoms, exit, a, 0), s, bs, atoms, exit, rest, j + 1)

def Flow.prePost(ps: Coll.List[Ast.Proto], st: Flow.St, s: I64, j: I64, bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], exit: Coll.List[Ast.Atom], a: Coll.List[Flow.VS], m: I64): Flow.St = bs match
  case Coll.Nil => st
  case Coll.Cons(b, rest) =>
    val Flow.CapB(x, _, proto) = b
    val pre: Coll.Option[Sym.Sym] = Flow.atState(atoms, x, a) match
      case Coll.Some(e) => Coll.Some(e)
      case Coll.None => Flow.startOf(ps, proto)
    pre match
      case Coll.None => Flow.prePost(ps, st, s, j, rest, atoms, exit, a, m + 1)
      case Coll.Some(e) =>
        val post: Sym.Sym = Flow.atState(exit, x, a) match
          case Coll.Some(o) => o
          case Coll.None => e
        Flow.prePost(ps, Flow.add(Flow.add(st, Flow.fPre(s, j, m, e)), Flow.fPost(s, j, m, post)), s, j, rest, atoms, exit, a, m + 1)

def Flow.startOf(ps: Coll.List[Ast.Proto], proto: Sym.Sym): Coll.Option[Sym.Sym] = Flow.protoNamed(ps, proto) match
  case Coll.None => Coll.None
  case Coll.Some(pr) =>
    val Ast.Proto(_, _, _, start, _, _, _, _) = pr
    Coll.Some(start)

// a block: its statements, its value, then a block end point where its own capabilities end their scope
def Flow.block(cx: Flow.Cx, st: Flow.St, p: I64, ss: Coll.List[Ast.Stmt], last: Ast.Expr, line: I64): Flow.At =
  val Flow.St(_, _, outer) = st
  val Flow.At(st1, p1) = Flow.stmts(cx, st, p, ss)
  val Flow.At(st2, p2) = Flow.expr(cx, st1, p1, last)
  val Flow.At(st3, e) = Flow.next(st2, p2)
  val Flow.St(n, fs, inner) = st3
  // a block that closes capabilities: its value must not live in one of them (escape)
  val fs2 = if Coll.length(inner) <= Coll.length(outer) then fs else Flow.escFacts(Flow.srcs(cx, inner, last, Coll.Nil), e, line, fs)
  Flow.At(Flow.St(n, Flow.closes(inner, outer, e, fs2), outer), e)

def Flow.escFacts(sv: Coll.List[Flow.Src], e: I64, line: I64, fs: Coll.List[D.Fact]): Coll.List[D.Fact] = sv match
  case Coll.Nil => fs
  case Coll.Cons(s, rest) => s match
    case Flow.SCap(c) => Flow.escFacts(rest, e, line, Coll.Cons(Flow.fEscCap(e, c, line), fs))
    case Flow.SVar(y) => Flow.escFacts(rest, e, line, Coll.Cons(Flow.fEscVar(e, y, line), fs))

// close(e, c) for every capability of inner that is not in outer (the block's own, innermost first)
def Flow.closes(inner: Coll.List[Flow.Cap], outer: Coll.List[Flow.Cap], e: I64, fs: Coll.List[D.Fact]): Coll.List[D.Fact] =
  if Coll.length(inner) <= Coll.length(outer) then fs
  else inner match
    case Coll.Nil => fs
    case Coll.Cons(c, rest) =>
      val Flow.Cap(_, id, _, _) = c
      Flow.closes(rest, outer, e, Coll.Cons(Flow.fClose(e, id), fs))

def Flow.stmts(cx: Flow.Cx, st: Flow.St, p: I64, ss: Coll.List[Ast.Stmt]): Flow.At = ss match
  case Coll.Nil => Flow.At(st, p)
  case Coll.Cons(s, rest) =>
    val Flow.At(st2, p2) = Flow.stmt(cx, st, p, s)
    Flow.stmts(cx, st2, p2, rest)

def Flow.stmt(cx: Flow.Cx, st: Flow.St, p: I64, s: Ast.Stmt): Flow.At = s match
  case Ast.Val(_, x, ann, e) => Flow.bindVal(cx, Flow.needs(cx, st, x, ann), p, x, e)
  case Ast.Var(_, x, _, e) => Flow.bindVal(cx, st, p, x, e)
  case Ast.Do(e) => Flow.expr(cx, st, p, e)
  case Ast.Check(_, _, e) => Flow.expr(cx, st, p, e)
  case Ast.Handle(line, x, h, xs) =>
    val Flow.At(st1, pa) = Flow.exprs(cx, st, p, xs)
    Flow.protoOf(Flow.cxHs(cx), h) match
      case Coll.None => Flow.At(st1, pa)
      case Coll.Some(proto) =>
        val Flow.At(st2, id) = Flow.fresh(st1)
        val Flow.St(n, fs, cs) = st2
        val st3 = Flow.St(n, fs, Coll.Cons(Flow.Cap(x, id, proto, line), cs))
        val st4 = Flow.add(Flow.add(st3, Flow.fCapOf(id, proto)), Flow.fCapName(id, x))
        Flow.At(Flow.add(Flow.add(st4, Flow.fCapLine(id, line)), Flow.fHandle(pa, id)), pa)

// ── the protocols as facts: transitions, end states (an end state, or a state whose drop op reaches one), states ──
def Flow.protoFacts(ps: Coll.List[Ast.Proto], fs: Coll.List[D.Fact]): Coll.List[D.Fact] = ps match
  case Coll.Nil => fs
  case Coll.Cons(p, rest) =>
    val Ast.Proto(_, name, states, start, ends, dropOp, ops, _) = p
    val fs1 = Flow.opFacts(name, ops, fs)
    val fs2 = Flow.stateFacts(name, start, states, ends, dropOp, ops, fs1)
    Flow.protoFacts(rest, fs2)

def Flow.opFacts(proto: Sym.Sym, ops: Coll.List[Ast.Op], fs: Coll.List[D.Fact]): Coll.List[D.Fact] = ops match
  case Coll.Nil => fs
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, name, _, _, trs) = o
    Flow.opFacts(proto, rest, Flow.transFacts(proto, name, trs, fs))

def Flow.transFacts(proto: Sym.Sym, op: Sym.Sym, trs: Coll.List[Ast.Trans], fs: Coll.List[D.Fact]): Coll.List[D.Fact] = trs match
  case Coll.Nil => fs
  case Coll.Cons(t, rest) =>
    val Ast.Trans(a, b) = t
    Flow.transFacts(proto, op, rest, Coll.Cons(Flow.fTr(proto, op, a, b), fs))

def Flow.stateFacts(proto: Sym.Sym, start: Sym.Sym, states: Coll.List[Sym.Sym], ends: Coll.List[Sym.Sym], dropOp: Coll.Option[Sym.Sym], ops: Coll.List[Ast.Op], fs: Coll.List[D.Fact]): Coll.List[D.Fact] = states match
  case Coll.Nil => Coll.Cons(Flow.fStart(proto, start), fs)
  case Coll.Cons(s, rest) =>
    val fs1 = Coll.Cons(Flow.fSame(s, s), fs)
    val fs2 = if Flow.endsAfterDrop(s, ends, dropOp, ops) then Coll.Cons(Flow.fEndOk(proto, s), fs1) else fs1
    val fs3 = if Flow.memberSym(s, ends) then Coll.Cons(Flow.fFin(proto, s), fs2) else fs2
    Flow.stateFacts(proto, start, rest, ends, dropOp, ops, fs3)

def Flow.memberSym(x: Sym.Sym, xs: Coll.List[Sym.Sym]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(h, t) => if Sym.eq(h, x) then true else Flow.memberSym(x, t)

// s is an end state, or the drop op takes s to an end state
def Flow.endsAfterDrop(s: Sym.Sym, ends: Coll.List[Sym.Sym], dropOp: Coll.Option[Sym.Sym], ops: Coll.List[Ast.Op]): Bool =
  if Flow.memberSym(s, ends) then true
  else dropOp match
    case Coll.None => false
    case Coll.Some(d) => Flow.dropReaches(s, d, ends, ops)

def Flow.dropReaches(s: Sym.Sym, d: Sym.Sym, ends: Coll.List[Sym.Sym], ops: Coll.List[Ast.Op]): Bool = ops match
  case Coll.Nil => false
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, name, _, _, trs) = o
    if Sym.eq(name, d) then Flow.transReaches(s, trs, ends) else Flow.dropReaches(s, d, ends, rest)

def Flow.transReaches(s: Sym.Sym, trs: Coll.List[Ast.Trans], ends: Coll.List[Sym.Sym]): Bool = trs match
  case Coll.Nil => false
  case Coll.Cons(t, rest) =>
    val Ast.Trans(a, b) = t
    if Sym.eq(a, s) && Flow.memberSym(b, ends) then true else Flow.transReaches(s, rest, ends)

// ── the rule library (variables are numbered per rule) ──
def Flow.v(n: I64): D.Arg = D.AVar(n)
def Flow.atom(rel: Flow.Rel, xs: Coll.List[I64]): D.Atom = D.Atom(Flow.relSym(rel), Flow.vars(xs))
def Flow.vars(xs: Coll.List[I64]): Coll.List[D.Arg] = xs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(x, rest) => Coll.Cons(Flow.v(x), Flow.vars(rest))
def Flow.l1 [A: Type] (a: A): Coll.List[A] = Coll.Cons(a, Coll.Nil)
def Flow.l2 [A: Type] (a: A, b: A): Coll.List[A] = Coll.Cons(a, Flow.l1(b))
def Flow.l3 [A: Type] (a: A, b: A, c: A): Coll.List[A] = Coll.Cons(a, Flow.l2(b, c))
def Flow.l4 [A: Type] (a: A, b: A, c: A, d: A): Coll.List[A] = Coll.Cons(a, Flow.l3(b, c, d))
def Flow.l5 [A: Type] (a: A, b: A, c: A, d: A, e: A): Coll.List[A] = Coll.Cons(a, Flow.l4(b, c, d, e))
def Flow.pos(rel: Flow.Rel, xs: Coll.List[I64]): D.Lit = D.Pos(Flow.atom(rel, xs))
def Flow.neg(rel: Flow.Rel, xs: Coll.List[I64]): D.Lit = D.Neg(Flow.atom(rel, xs))
def Flow.rule(rel: Flow.Rel, xs: Coll.List[I64], body: Coll.List[D.Lit]): D.Rule = D.Rule(Flow.atom(rel, xs), body)

// variables: p 0, q 1, w 2, c 3, s 4, t 5, op 6, proto 7, line 8, name 9
def Flow.rules(): Coll.List[D.Rule] =
  // a handle puts its capability in the start state of its protocol (world 0: one world until facts with variables)
  val enter = Flow.rule(Flow.RAt, Flow.l4(0, 2, 3, 4), Flow.l4(Flow.pos(Flow.RHandle, Flow.l2(0, 3)), Flow.pos(Flow.RCapOf, Flow.l2(3, 7)), Flow.pos(Flow.RStart, Flow.l2(7, 4)), Flow.pos(Flow.RWorld, Flow.l1(2))))
  // frame along control edges; a capability ends at the block end that closes it
  val frame = Flow.rule(Flow.RAt, Flow.l4(1, 2, 3, 4), Flow.l3(Flow.pos(Flow.RFlow, Flow.l2(0, 1)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4)), Flow.neg(Flow.RClose, Flow.l2(0, 3))))
  // a step moves its capability only
  val touch = Flow.rule(Flow.RTouch, Flow.l2(0, 3), Flow.l1(Flow.pos(Flow.RStep, Flow.l4(0, 1, 3, 6))))
  val keep = Flow.rule(Flow.RAt, Flow.l4(1, 2, 3, 4), Flow.l3(Flow.pos(Flow.RStep, Flow.l4(0, 1, 5, 6)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4)), Flow.neg(Flow.RTouch, Flow.l2(0, 3))))
  val move = Flow.rule(Flow.RAt, Flow.l4(1, 2, 3, 5), Flow.l4(Flow.pos(Flow.RStep, Flow.l4(0, 1, 3, 6)), Flow.pos(Flow.RCapOf, Flow.l2(3, 7)), Flow.pos(Flow.RTr, Flow.l4(7, 6, 4, 5)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4))))
  val moved = Flow.rule(Flow.RMoved, Flow.l2(0, 2), Flow.l4(Flow.pos(Flow.RStep, Flow.l4(0, 1, 3, 6)), Flow.pos(Flow.RCapOf, Flow.l2(3, 7)), Flow.pos(Flow.RTr, Flow.l4(7, 6, 4, 5)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4))))
  val seen = Flow.rule(Flow.RSeen, Flow.l3(0, 2, 3), Flow.l2(Flow.pos(Flow.RStep, Flow.l4(0, 1, 3, 6)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4))))
  // clashes: the line and the capability's name
  val stuck = Flow.rule(Flow.RStuck, Flow.l2(8, 9), Flow.l4(Flow.pos(Flow.RSeen, Flow.l3(0, 2, 3)), Flow.neg(Flow.RMoved, Flow.l2(0, 2)), Flow.pos(Flow.RLine, Flow.l2(0, 8)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))
  val split = Flow.rule(Flow.RSplit, Flow.l2(8, 3), Flow.l5(Flow.pos(Flow.RMerge, Flow.l1(0)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 5)), Flow.neg(Flow.RSame, Flow.l2(4, 5)), Flow.pos(Flow.RLine, Flow.l2(0, 8))))
  val splitN = Flow.rule(Flow.RSplitAt, Flow.l2(8, 9), Flow.l2(Flow.pos(Flow.RSplit, Flow.l2(8, 3)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))
  val unended = Flow.rule(Flow.RUnended, Flow.l2(8, 3), Flow.l5(Flow.pos(Flow.RClose, Flow.l2(0, 3)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4)), Flow.pos(Flow.RCapOf, Flow.l2(3, 7)), Flow.neg(Flow.REndOk, Flow.l2(7, 4)), Flow.pos(Flow.RCapLine, Flow.l2(3, 8))))
  val unendedN = Flow.rule(Flow.RUnendedAt, Flow.l2(8, 9), Flow.l2(Flow.pos(Flow.RUnended, Flow.l2(8, 3)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))
  val f1 = Coll.Cons(enter, Coll.Cons(frame, Coll.Cons(touch, Coll.Cons(keep, Coll.Cons(move, Coll.Cons(moved, Coll.Cons(seen, Coll.Cons(stuck, Coll.Cons(split, Coll.Cons(splitN, Coll.Cons(unended, Coll.Cons(unendedN, Coll.Nil))))))))))))
  Coll.revOnto(Coll.rev(f1), Coll.revOnto(Coll.rev(Flow.callRules()), Flow.capsRules()))

// R2 for calls (flow-design.md): the call point p is its own kind; j 10, m 11, n 12, i 13
def Flow.callRules(): Coll.List[D.Rule] =
  // a bound capability is touched: no frame across the call, its state comes from the solution that fits
  val touchB = Flow.rule(Flow.RTouch, Flow.l2(0, 3), Flow.l1(Flow.pos(Flow.RBind, Flow.l3(0, 11, 3))))
  val cframe = Flow.rule(Flow.RAt, Flow.l4(1, 2, 3, 4), Flow.l3(Flow.pos(Flow.RCStep, Flow.l2(0, 1)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4)), Flow.neg(Flow.RTouch, Flow.l2(0, 3))))
  // solution j fits when every param is in its pre state: a positive chain over the params
  val ok1 = Flow.rule(Flow.ROk, Flow.l4(0, 2, 10, 11), Flow.l4(Flow.pos(Flow.RFirst, Flow.l2(0, 11)), Flow.pos(Flow.RPre, Flow.l4(0, 10, 11, 4)), Flow.pos(Flow.RBind, Flow.l3(0, 11, 3)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4))))
  val ok2 = Flow.rule(Flow.ROk, Flow.l4(0, 2, 10, 12), Flow.l5(Flow.pos(Flow.ROk, Flow.l4(0, 2, 10, 11)), Flow.pos(Flow.RNext, Flow.l3(0, 11, 12)), Flow.pos(Flow.RPre, Flow.l4(0, 10, 12, 4)), Flow.pos(Flow.RBind, Flow.l3(0, 12, 3)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4))))
  val fits = Flow.rule(Flow.RFits, Flow.l3(0, 2, 10), Flow.l2(Flow.pos(Flow.ROk, Flow.l4(0, 2, 10, 11)), Flow.pos(Flow.RLast, Flow.l2(0, 11))))
  val cmove = Flow.rule(Flow.RAt, Flow.l4(1, 2, 3, 4), Flow.l4(Flow.pos(Flow.RFits, Flow.l3(0, 2, 10)), Flow.pos(Flow.RCStep, Flow.l2(0, 1)), Flow.pos(Flow.RPost, Flow.l4(0, 10, 11, 4)), Flow.pos(Flow.RBind, Flow.l3(0, 11, 3))))
  val cmoved = Flow.rule(Flow.RMoved, Flow.l2(0, 2), Flow.l1(Flow.pos(Flow.RFits, Flow.l3(0, 2, 10))))
  val cseen = Flow.rule(Flow.RCSeen, Flow.l2(0, 2), Flow.l2(Flow.pos(Flow.RBind, Flow.l3(0, 11, 3)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4))))
  // clashes: no solution fits (stuck, as an op), more than one fits (ambig); the name is the callee
  val cstuck = Flow.rule(Flow.RStuck, Flow.l2(8, 9), Flow.l4(Flow.pos(Flow.RCSeen, Flow.l2(0, 2)), Flow.neg(Flow.RMoved, Flow.l2(0, 2)), Flow.pos(Flow.RLine, Flow.l2(0, 8)), Flow.pos(Flow.RCallee, Flow.l2(0, 9))))
  val ambig = Flow.rule(Flow.RAmbig, Flow.l2(0, 2), Flow.l3(Flow.pos(Flow.RFits, Flow.l3(0, 2, 10)), Flow.pos(Flow.RFits, Flow.l3(0, 2, 13)), Flow.neg(Flow.RSame, Flow.l2(10, 13))))
  val ambigN = Flow.rule(Flow.RAmbigAt, Flow.l2(8, 9), Flow.l3(Flow.pos(Flow.RAmbig, Flow.l2(0, 2)), Flow.pos(Flow.RLine, Flow.l2(0, 8)), Flow.pos(Flow.RCallee, Flow.l2(0, 9))))
  // the def side: a binder enters in its world's pre state; it must leave in the world's post state (exitBad)
  val enterB = Flow.rule(Flow.RAt, Flow.l4(0, 2, 3, 4), Flow.l1(Flow.pos(Flow.REnter, Flow.l4(0, 2, 3, 4))))
  val exitBad = Flow.rule(Flow.RExitBad, Flow.l2(8, 9), Flow.l5(Flow.pos(Flow.RWant, Flow.l4(0, 2, 3, 4)), Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 5)), Flow.neg(Flow.RSame, Flow.l2(4, 5)), Flow.pos(Flow.RCapLine, Flow.l2(3, 8)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))
  val noSol = Flow.rule(Flow.RNoSolAt, Flow.l2(8, 9), Flow.l1(Flow.pos(Flow.RNoSol, Flow.l2(8, 9))))
  Coll.Cons(touchB, Coll.Cons(cframe, Coll.Cons(ok1, Coll.Cons(ok2, Coll.Cons(fits, Coll.Cons(cmove, Coll.Cons(cmoved, Coll.Cons(cseen, Coll.Cons(cstuck, Coll.Cons(ambig, Coll.Cons(ambigN, Coll.Cons(enterB, Coll.Cons(exitBad, Coll.Cons(noSol, Coll.Nil))))))))))))))

// the facts of fn f: its walk from a first point, the protocols. each solution j of f's entry facts is world j: the
// capability binders enter point 0 in their pre states and must leave the body in their post states (s1/check.srs:498);
// no binders: one world. no solution: the def has none (NoSol)
def Flow.facts(cx: Flow.Cx, f: Ast.Fn): Coll.List[D.Fact] =
  val Ast.Fn(line, name, gs, _, _, exit, body) = f
  val Flow.Cx(ps, _, _, _, _, _) = cx
  val bs = Flow.capBs(ps, gs, 0, Coll.Nil)
  val atoms = Flow.entryAtoms(gs, Coll.Nil)
  val as: Coll.List[Coll.List[Flow.VS]] = bs match
    case Coll.Nil => Coll.Cons(Coll.Nil, Coll.Nil)
    case Coll.Cons(_, _) => Flow.assigns(ps, Flow.ruleModels(ps, bs, Coll.Nil), bs, atoms, Flow.varsOf(atoms, Coll.Nil), Coll.Nil, Coll.Nil)
  val st0 = Flow.binderCaps(Flow.St(1, Coll.Nil, Coll.Nil), bs, line)
  val Flow.St(_, _, caps) = st0
  val st1 = Flow.worlds(ps, st0, Coll.rev(caps), bs, atoms, exit, as, 0, Flow.Entry)
  val walked: Flow.At = body match
    case Ast.Extern => Flow.At(st1, 0)
    case Ast.Def(_, e) => Flow.expr(cx, st1, 0, e)
  val Flow.At(st2, e) = walked
  val st3 = Flow.worlds(ps, st2, Coll.rev(caps), bs, atoms, exit, as, 0, Flow.Exit(e))
  val st4 = as match
    case Coll.Nil => Flow.add(st3, Flow.fNoSol(line, name))
    case Coll.Cons(_, _) => st3
  val Flow.St(_, fs, _) = st4
  Flow.protoFacts(ps, fs)

// which end of the body world facts are for: the entry (world, enter) or the exit at point e (want)
enum Flow.End:
  case Flow.Entry
  case Flow.Exit(e: I64)

// each capability binder is a capability in scope from point 0, named and lined by the def
def Flow.binderCaps(st: Flow.St, bs: Coll.List[Flow.CapB], line: I64): Flow.St = bs match
  case Coll.Nil => st
  case Coll.Cons(b, rest) =>
    val Flow.CapB(x, _, proto) = b
    val Flow.At(st1, id) = Flow.fresh(st)
    val Flow.St(n, fs, cs) = st1
    val st2 = Flow.St(n, fs, Coll.Cons(Flow.Cap(x, id, proto, line), cs))
    Flow.binderCaps(Flow.add(Flow.add(Flow.add(st2, Flow.fCapOf(id, proto)), Flow.fCapName(id, x)), Flow.fCapLine(id, line)), rest, line)

// per solution j: world(j) and enter(0, j, c, pre) at the entry, want(e, j, c, post) at the exit
def Flow.worlds(ps: Coll.List[Ast.Proto], st: Flow.St, caps: Coll.List[Flow.Cap], bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], exit: Coll.List[Ast.Atom], as: Coll.List[Coll.List[Flow.VS]], j: I64, end: Flow.End): Flow.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) =>
    val st1 = end match
      case Flow.Entry => Flow.add(st, Flow.fWorld(j))
      case Flow.Exit(_) => st
    Flow.worlds(ps, Flow.worldCaps(ps, st1, caps, bs, atoms, exit, a, j, end), caps, bs, atoms, exit, rest, j + 1, end)

def Flow.worldCaps(ps: Coll.List[Ast.Proto], st: Flow.St, caps: Coll.List[Flow.Cap], bs: Coll.List[Flow.CapB], atoms: Coll.List[Ast.Atom], exit: Coll.List[Ast.Atom], a: Coll.List[Flow.VS], j: I64, end: Flow.End): Flow.St = caps match
  case Coll.Nil => st
  case Coll.Cons(c, crest) => bs match
    case Coll.Nil => st
    case Coll.Cons(b, brest) =>
      val Flow.Cap(_, id, _, _) = c
      val Flow.CapB(x, _, proto) = b
      val pre: Coll.Option[Sym.Sym] = Flow.atState(atoms, x, a) match
        case Coll.Some(s) => Coll.Some(s)
        case Coll.None => Flow.startOf(ps, proto)
      val st1: Flow.St = pre match
        case Coll.None => st
        case Coll.Some(s) => end match
          case Flow.Entry => Flow.add(st, Flow.fEnter(0, j, id, s))
          case Flow.Exit(e) => Flow.atState(exit, x, a) match
            case Coll.Some(o) => Flow.add(st, Flow.fWant(e, j, id, o))
            case Coll.None => Flow.add(st, Flow.fWant(e, j, id, s))
      Flow.worldCaps(ps, st1, crest, brest, atoms, exit, a, j, end)

// ── the verdict: the clash relations read back. a tuple of another shape than (line, name) means Flow.rules is wrong:
// the whole reading is IllTyped (a verdict), so no clash value holds a bad tuple ──
enum Flow.Read:
  case Flow.Got(cs: Coll.List[Flow.Clash])
  case Flow.IllTyped(rel: Sym.Sym)

def Flow.clashes(m: D.Model, k: Flow.Kind, prev: Flow.Read): Flow.Read = prev match
  case Flow.IllTyped(_) => prev
  case Flow.Got(acc) => Flow.clashList(k, D.tuples(m, Flow.relSym(Flow.relOf(k))), acc)

def Flow.clashList(k: Flow.Kind, ts: Coll.List[Coll.List[D.Val]], acc: Coll.List[Flow.Clash]): Flow.Read = ts match
  case Coll.Nil => Flow.Got(acc)
  case Coll.Cons(t, rest) => Flow.clashOf(k, t) match
    case Coll.None => Flow.IllTyped(Flow.relSym(Flow.relOf(k)))
    case Coll.Some(c) => Flow.clashList(k, rest, Coll.Cons(c, acc))

// a clash tuple is (line, capability name), exactly two values
def Flow.clashOf(k: Flow.Kind, t: Coll.List[D.Val]): Coll.Option[Flow.Clash] = t match
  case Coll.Cons(a, rest) => rest match
    case Coll.Cons(b, more) => more match
      case Coll.Nil => Flow.clashLN(k, a, b)
      case Coll.Cons(_, _) => Coll.None
    case Coll.Nil => Coll.None
  case Coll.Nil => Coll.None

def Flow.clashLN(k: Flow.Kind, a: D.Val, b: D.Val): Coll.Option[Flow.Clash] = a match
  case D.VInt(line) => b match
    case D.VSym(name) => Coll.Some(Flow.make(k, line, name))
    case D.VInt(_) => Coll.None
  case D.VSym(_) => Coll.None

// every clash relation of a solved model, read
def Flow.readAll(m: D.Model): Flow.Read =
  Flow.clashes(m, Flow.KStale, Flow.clashes(m, Flow.KStuck, Flow.clashes(m, Flow.KSplit, Flow.clashes(m, Flow.KUnended, Flow.clashes(m, Flow.KAmbig, Flow.clashes(m, Flow.KExitBad, Flow.clashes(m, Flow.KNoSol, Flow.clashes(m, Flow.KDead, Flow.clashes(m, Flow.KEscape, Flow.Got(Coll.Nil))))))))))

def Flow.make(k: Flow.Kind, line: I64, name: Sym.Sym): Flow.Clash = k match
  case Flow.KStuck => Flow.Stuck(line, name)
  case Flow.KSplit => Flow.Split(line, name)
  case Flow.KUnended => Flow.Unended(line, name)
  case Flow.KAmbig => Flow.Ambig(line, name)
  case Flow.KExitBad => Flow.ExitBad(line, name)
  case Flow.KNoSol => Flow.NoSol(line, name)
  case Flow.KDead => Flow.Dead(line, name)
  case Flow.KEscape => Flow.Escape(line, name)
  case Flow.KStale => Flow.Stale(line, name)

def Flow.verdictOf(rd: Flow.Read): Flow.Verdict = rd match
  case Flow.IllTyped(rel) => Flow.RulesIllTyped(rel)
  case Flow.Got(cs) => cs match
    case Coll.Nil => Flow.Ok
    case Coll.Cons(_, _) => Flow.Bad(cs)

def Flow.check(cx: Flow.Cx, f: Ast.Fn): Flow.Verdict =
  D.solve(Flow.rules(), Flow.facts(cx, f)) match
    case D.Solved(m) => Flow.verdictOf(Flow.readAll(m))
    case D.Unsafe(rel) => Flow.RulesUnsafe(rel)
    case D.NegCycle(rel) => Flow.RulesNegCycle(rel)

// CAPS (R3): what each name holds flows along every edge; an assignment replaces it (strong update), a join is the union,
// a loop reaches its fixpoint. x 14, y 15
def Flow.capsRules(): Coll.List[D.Rule] =
  val e1 = Flow.rule(Flow.REdge, Flow.l2(0, 1), Flow.l1(Flow.pos(Flow.RFlow, Flow.l2(0, 1))))
  val e2 = Flow.rule(Flow.REdge, Flow.l2(0, 1), Flow.l1(Flow.pos(Flow.RStep, Flow.l4(0, 1, 3, 6))))
  val e3 = Flow.rule(Flow.REdge, Flow.l2(0, 1), Flow.l1(Flow.pos(Flow.RCStep, Flow.l2(0, 1))))
  val h1 = Flow.rule(Flow.RHolds, Flow.l3(1, 14, 3), Flow.l2(Flow.pos(Flow.RAssign, Flow.l3(0, 14, 3)), Flow.pos(Flow.REdge, Flow.l2(0, 1))))
  val h2 = Flow.rule(Flow.RHolds, Flow.l3(1, 14, 3), Flow.l3(Flow.pos(Flow.RAssignFrom, Flow.l3(0, 14, 15)), Flow.pos(Flow.RHolds, Flow.l3(0, 15, 3)), Flow.pos(Flow.REdge, Flow.l2(0, 1))))
  val h3 = Flow.rule(Flow.RHolds, Flow.l3(1, 14, 3), Flow.l3(Flow.pos(Flow.REdge, Flow.l2(0, 1)), Flow.pos(Flow.RHolds, Flow.l3(0, 14, 3)), Flow.neg(Flow.RAssigns, Flow.l2(0, 14))))
  // a read of x at p uses every region x holds there; a region in an end state is dead
  val dead = Flow.rule(Flow.RDead, Flow.l2(8, 9), Coll.Cons(Flow.pos(Flow.RReadAt, Flow.l3(0, 14, 8)), Coll.Cons(Flow.pos(Flow.RHolds, Flow.l3(0, 14, 3)), Flow.l4(Flow.pos(Flow.RAt, Flow.l4(0, 2, 3, 4)), Flow.pos(Flow.RCapOf, Flow.l2(3, 7)), Flow.pos(Flow.RFin, Flow.l2(7, 4)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))))
  // a block value in a capability the block closes escapes
  val esc1 = Flow.rule(Flow.REscape, Flow.l2(8, 9), Flow.l3(Flow.pos(Flow.REscCap, Flow.l3(0, 3, 8)), Flow.pos(Flow.RClose, Flow.l2(0, 3)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))
  val esc2 = Flow.rule(Flow.REscape, Flow.l2(8, 9), Flow.l4(Flow.pos(Flow.REscVar, Flow.l3(0, 15, 8)), Flow.pos(Flow.RHolds, Flow.l3(0, 15, 3)), Flow.pos(Flow.RClose, Flow.l2(0, 3)), Flow.pos(Flow.RCapName, Flow.l2(3, 9))))
  // a value whose type needs its capability in state S is read where the capability is in another state (vars: P 0,
  // X 1, L 2, C 3, S 4, W 5, S2 6)
  val stale = Flow.rule(Flow.RStale, Flow.l2(2, 1), Flow.l4(Flow.pos(Flow.RReadAt, Flow.l3(0, 1, 2)), Flow.pos(Flow.RNeed, Flow.l3(1, 3, 4)), Flow.pos(Flow.RAt, Flow.l4(0, 5, 3, 6)), Flow.neg(Flow.RSameS, Flow.l2(6, 4))))
  Coll.Cons(e1, Coll.Cons(e2, Coll.Cons(e3, Coll.Cons(h1, Coll.Cons(h2, Coll.Cons(h3, Coll.Cons(dead, Coll.Cons(esc1, Coll.Cons(esc2, Flow.l1(stale))))))))))

// x: T where T's decl has <at(b, S)> with b a {} capability of protocol P: x needs the one P in scope in state S at
// every read (vic-jxk type facts); sameS gives the states of P to compare
def Flow.needs(cx: Flow.Cx, st: Flow.St, x: Sym.Sym, ann: Coll.Option[Ast.Ty]): Flow.St = ann match
  case Coll.None => st
  case Coll.Some(t) =>
    val Ast.Ty(_, tn, _, _, _) = t
    val Flow.Cx(ps, _, _, _, ts, _) = cx
    Flow.typeDecl(ts, tn) match
      case Coll.None => st
      case Coll.Some(td) =>
        val Ast.TypeDecl(_, _, gs, _, _) = td
        Flow.needAtoms(ps, Ty.evidence(gs, Coll.Nil), x, Flow.entryAtoms(gs, Coll.Nil), st)

def Flow.typeDecl(ts: Coll.List[Ast.TypeDecl], n: Sym.Sym): Coll.Option[Ast.TypeDecl] = ts match
  case Coll.Nil => Coll.None
  case Coll.Cons(td, rest) =>
    val Ast.TypeDecl(_, m, _, _, _) = td
    if Sym.eq(m, n) then Coll.Some(td) else Flow.typeDecl(rest, n)

def Flow.needAtoms(ps: Coll.List[Ast.Proto], ev: Coll.List[Ast.Binder], x: Sym.Sym, as: Coll.List[Ast.Atom], st: Flow.St): Flow.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) =>
    val Ast.Atom(_, rel, args) = a
    val st2 = if Str.eq(Sym.str(rel), "at") then Flow.needAt(ps, ev, x, args, st) else st
    Flow.needAtoms(ps, ev, x, rest, st2)

def Flow.needAt(ps: Coll.List[Ast.Proto], ev: Coll.List[Ast.Binder], x: Sym.Sym, args: Coll.List[Ast.Term], st: Flow.St): Flow.St = Fx.nth(args, 0) match
  case Coll.None => st
  case Coll.Some(b) => Fx.nth(args, 1) match
    case Coll.None => st
    case Coll.Some(s) => Flow.binderProto(ev, b) match
      case Coll.None => st
      case Coll.Some(p) =>
        val Flow.St(_, _, caps) = st
        Flow.onlyCap(caps, p, Coll.None) match
          case Coll.None => st
          case Coll.Some(c) =>
            val Flow.Cap(_, id, _, _) = c
            Flow.sameStates(ps, p, Flow.add(st, Flow.fact3(Flow.RNeed, Flow.s(x), Flow.i(id), Flow.s(s))))

def Flow.binderProto(bs: Coll.List[Ast.Binder], b: Sym.Sym): Coll.Option[Sym.Sym] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Ast.Binder(_, n, t) = x
    val Ast.Ty(_, tn, _, _, _) = t
    if Sym.eq(n, b) then Coll.Some(tn) else Flow.binderProto(rest, b)

def Flow.sameStates(ps: Coll.List[Ast.Proto], p: Sym.Sym, st: Flow.St): Flow.St = ps match
  case Coll.Nil => st
  case Coll.Cons(pr, rest) =>
    val Ast.Proto(_, n, states, _, _, _, _, _) = pr
    if Sym.eq(n, p) then Flow.sameAll(states, st) else Flow.sameStates(rest, p, st)

def Flow.sameAll(ss: Coll.List[Sym.Sym], st: Flow.St): Flow.St = ss match
  case Coll.Nil => st
  case Coll.Cons(s, rest) => Flow.sameAll(rest, Flow.add(st, Flow.fact2(Flow.RSameS, Flow.s(s), Flow.s(s))))
