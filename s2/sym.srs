// a name with its hash (s2 component 1, vic 2026-11-06): two names compare as integers; their strings are compared
// only on a hash tie. no global table: a Sym carries its own hash.
enum Sym.Sym:
  case Sym.Sym(h: I64, s: Str)

def Sym.of {r: Region} (s: Str): Sym.Sym = Sym.Sym(strHash(s), s)

def Sym.hash(a: Sym.Sym): I64 =
  val Sym.Sym(h, _) = a
  h

def Sym.str(a: Sym.Sym): Str =
  val Sym.Sym(_, s) = a
  s

def Sym.eq(a: Sym.Sym, b: Sym.Sym): Bool =
  val Sym.Sym(h1, s1) = a
  val Sym.Sym(h2, s2) = b
  h1 == h2 && rt_str_eq(s1, s2)
