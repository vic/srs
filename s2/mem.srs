// s2 MEM (vic-gux0, vic/c/mem-design.md): where a program allocates. A constructor call with fields, or Array.fill /
// Array.tabulate, is a site. A site fills the innermost Region handle around it in its def, else each Region its def
// runs under. A site is many when it can run twice in one life of its region: in a loop, or in a def that is many.
// Many is the safe answer (Birkedal, Tofte, Vejlstrup, POPL 1996, sec. 4: all multiplicities infinite is a solution),
// so once is what needs proof. A def with two call sites is many; the entry of a call cycle has two (one from outside),
// and the rest of the cycle is many through its caller. One Datalog program:
//   reached(G) :- reached(F), call(F, G)
//   run(G, R) :- callIn(R, G) | callFree(F, G), run(F, R)
//   fills(S, R) :- siteIn(S, R) | siteFree(S, F), run(F, R)
//   manyDef(G) :- multi(G) | loopCall(G) | callFree(F, G), manyDef(F)
//   live(R) :- regionIn(R, F), reached(F)
// Not seen yet: handler and given bodies, allocating externs ({r: Region} binders): a later rung.
enum Mem.Rel:
  case Mem.RCall
  case Mem.RCallIn
  case Mem.RCallFree
  case Mem.RSiteIn
  case Mem.RSiteFree
  case Mem.RMulti
  case Mem.RLoopCall
  case Mem.RRegionIn
  case Mem.RReached
  case Mem.RRun
  case Mem.RFills
  case Mem.RManyDef
  case Mem.RLive

// Mem.relSym is the only place a relation name is a string
def Mem.relSym(rel: Mem.Rel): Sym.Sym = rel match
  case Mem.RCall => Sym.of("call")
  case Mem.RCallIn => Sym.of("callIn")
  case Mem.RCallFree => Sym.of("callFree")
  case Mem.RSiteIn => Sym.of("siteIn")
  case Mem.RSiteFree => Sym.of("siteFree")
  case Mem.RMulti => Sym.of("multi")
  case Mem.RLoopCall => Sym.of("loopCall")
  case Mem.RRegionIn => Sym.of("regionIn")
  case Mem.RReached => Sym.of("reached")
  case Mem.RRun => Sym.of("run")
  case Mem.RFills => Sym.of("fills")
  case Mem.RManyDef => Sym.of("manyDef")
  case Mem.RLive => Sym.of("live")

def Mem.atom(rel: Mem.Rel, xs: Coll.List[I64]): D.Atom = D.Atom(Mem.relSym(rel), Pure.vars(xs))
def Mem.pos(rel: Mem.Rel, xs: Coll.List[I64]): D.Lit = D.Pos(Mem.atom(rel, xs))
def Mem.lits2(a: D.Lit, b: D.Lit): Coll.List[D.Lit] = Coll.Cons(a, Coll.Cons(b, Coll.Nil))
def Mem.lit1(a: D.Lit): Coll.List[D.Lit] = Coll.Cons(a, Coll.Nil)

def Mem.rules(): Coll.List[D.Rule] =
  val reach = D.Rule(Mem.atom(Mem.RReached, Pure.one(1)), Mem.lits2(Mem.pos(Mem.RReached, Pure.one(0)), Mem.pos(Mem.RCall, Pure.two(0, 1))))
  val run1 = D.Rule(Mem.atom(Mem.RRun, Pure.two(1, 0)), Mem.lit1(Mem.pos(Mem.RCallIn, Pure.two(0, 1))))
  val run2 = D.Rule(Mem.atom(Mem.RRun, Pure.two(1, 2)), Mem.lits2(Mem.pos(Mem.RCallFree, Pure.two(0, 1)), Mem.pos(Mem.RRun, Pure.two(0, 2))))
  val fill1 = D.Rule(Mem.atom(Mem.RFills, Pure.two(0, 1)), Mem.lit1(Mem.pos(Mem.RSiteIn, Pure.two(0, 1))))
  val fill2 = D.Rule(Mem.atom(Mem.RFills, Pure.two(0, 2)), Mem.lits2(Mem.pos(Mem.RSiteFree, Pure.two(0, 1)), Mem.pos(Mem.RRun, Pure.two(1, 2))))
  val m1 = D.Rule(Mem.atom(Mem.RManyDef, Pure.one(0)), Mem.lit1(Mem.pos(Mem.RMulti, Pure.one(0))))
  val m2 = D.Rule(Mem.atom(Mem.RManyDef, Pure.one(0)), Mem.lit1(Mem.pos(Mem.RLoopCall, Pure.one(0))))
  val m3 = D.Rule(Mem.atom(Mem.RManyDef, Pure.one(1)), Mem.lits2(Mem.pos(Mem.RCallFree, Pure.two(0, 1)), Mem.pos(Mem.RManyDef, Pure.one(0))))
  val live = D.Rule(Mem.atom(Mem.RLive, Pure.one(0)), Mem.lits2(Mem.pos(Mem.RRegionIn, Pure.two(0, 1)), Mem.pos(Mem.RReached, Pure.one(1))))
  Coll.Cons(reach, Coll.Cons(run1, Coll.Cons(run2, Coll.Cons(fill1, Coll.Cons(fill2, Coll.Cons(m1, Coll.Cons(m2, Coll.Cons(m3, Coll.Cons(live, Coll.Nil)))))))))

def Mem.f1(rel: Mem.Rel, a: D.Val): D.Fact = D.Fact(Mem.relSym(rel), Coll.Cons(a, Coll.Nil))
def Mem.f2(rel: Mem.Rel, a: D.Val, b: D.Val): D.Fact = D.Fact(Mem.relSym(rel), Coll.Cons(a, Coll.Cons(b, Coll.Nil)))

// a site: the def it is in, its line, the constructor (or Array.fill), and whether a loop of its own def holds it
enum Mem.Site:
  case Mem.Site(f: Sym.Sym, line: I64, ctor: Sym.Sym, loop: Bool)

// a Region handle: the def it is in, its line, its name and its handler
enum Mem.Region:
  case Mem.Region(f: Sym.Sym, line: I64, x: Sym.Sym, h: Sym.Sym)

// what the walk knows of the program: defs by name, the constructors that allocate (a case with fields), the handlers
// whose protocol is Region
enum Mem.Cx:
  case Mem.Cx(fns: Coll.SMap[Ast.Fn], ctors: Coll.SMap[Coll.List[Ast.Binder]], regionHs: Coll.SMap[Bool], ss: Eff.Syms)

// where a walk is: the def, the innermost Region handle of the def around it (an id), and whether a loop holds it
enum Mem.At:
  case Mem.At(f: Sym.Sym, reg: Coll.Option[I64], loop: Bool)

// the walk's result so far: sites and regions by id (ids count up from 0), facts, call sites per callee, free calls
enum Mem.W:
  case Mem.W(sites: Coll.IMap[Mem.Site], ns: I64, regions: Coll.IMap[Mem.Region], nr: I64, facts: Coll.List[D.Fact], calls: Coll.SMap[I64], free: Coll.List[Mem.Edge])

// a call that opens no region: f calls g in the region f runs in
enum Mem.Edge:
  case Mem.Edge(f: Sym.Sym, g: Sym.Sym)

def Mem.fact(w: Mem.W, x: D.Fact): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  Mem.W(ss, ns, rs, nr, Coll.Cons(x, fs), cs, fr)

def Mem.site(w: Mem.W, at: Mem.At, line: I64, ctor: Sym.Sym): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  val Mem.At(f, reg, loop) = at
  val x: D.Fact = reg match
    case Coll.Some(r) => Mem.f2(Mem.RSiteIn, D.VInt(ns), D.VInt(r))
    case Coll.None => Mem.f2(Mem.RSiteFree, D.VInt(ns), D.VSym(f))
  Mem.W(Coll.insert(ss, ns, Mem.Site(f, line, ctor, loop)), ns + 1, rs, nr, Coll.Cons(x, fs), cs, fr)

def Mem.count(cs: Coll.SMap[I64], g: Sym.Sym): I64 = Coll.sLookup(cs, g) match
  case Coll.Some(n) => n
  case Coll.None => 0

def Mem.call(w: Mem.W, at: Mem.At, g: Sym.Sym): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  val Mem.At(f, reg, loop) = at
  val c = Mem.f2(Mem.RCall, D.VSym(f), D.VSym(g))
  val fs2 = if loop then Coll.Cons(Mem.f1(Mem.RLoopCall, D.VSym(g)), Coll.Cons(c, fs)) else Coll.Cons(c, fs)
  val cs2 = Coll.sInsert(cs, g, Mem.count(cs, g) + 1)
  reg match
    case Coll.Some(r) => Mem.W(ss, ns, rs, nr, Coll.Cons(Mem.f2(Mem.RCallIn, D.VInt(r), D.VSym(g)), fs2), cs2, fr)
    case Coll.None => Mem.W(ss, ns, rs, nr, Coll.Cons(Mem.f2(Mem.RCallFree, D.VSym(f), D.VSym(g)), fs2), cs2, Coll.Cons(Mem.Edge(f, g), fr))

// a new Region handle in def f: its id is the next one; the rest of the block runs under it
def Mem.region(w: Mem.W, f: Sym.Sym, line: I64, x: Sym.Sym, h: Sym.Sym): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  Mem.W(ss, ns, Coll.insert(rs, nr, Mem.Region(f, line, x, h)), nr + 1, Coll.Cons(Mem.f2(Mem.RRegionIn, D.VInt(nr), D.VSym(f)), fs), cs, fr)

def Mem.nextRegion(w: Mem.W): I64 =
  val Mem.W(_, _, _, nr, _, _, _) = w
  nr

def Mem.isIn [V: Type] (m: Coll.SMap[V], s: Sym.Sym): Bool = Coll.sLookup(m, s) match
  case Coll.Some(_) => true
  case Coll.None => false

def Mem.expr(cx: Mem.Cx, at: Mem.At, w: Mem.W, e: Ast.Expr): Mem.W = e match
  case Ast.Call(line, f, _, _, args) =>
    val Mem.Cx(fns, ctors, _, ss) = cx
    val w2 = if Mem.allocates(ctors, f) || Eff.isArrayNew(ss, f) then Mem.site(w, at, line, f) else if Mem.isIn(fns, f) then Mem.call(w, at, f) else w
    Mem.exprs(cx, at, w2, args)
  case Ast.Method(_, _, _, args) => Mem.exprs(cx, at, w, args)
  case Ast.Resume(_, _, x) => Mem.expr(cx, at, w, x)
  case Ast.Bin(_, _, l, r) => Mem.expr(cx, at, Mem.expr(cx, at, w, l), r)
  case Ast.Un(_, _, x) => Mem.expr(cx, at, w, x)
  case Ast.If(_, c, t, x) => Mem.expr(cx, at, Mem.expr(cx, at, Mem.expr(cx, at, w, c), t), x)
  case Ast.Match(_, s, arms) => Mem.arms(cx, at, Mem.expr(cx, at, w, s), arms)
  case Ast.Block(_, stmts, last) => Mem.stmts(cx, at, w, stmts, last)
  case Ast.While(_, c, body) =>
    val Mem.At(f, reg, _) = at
    val inLoop = Mem.At(f, reg, true)
    Mem.expr(cx, inLoop, Mem.expr(cx, inLoop, w, c), body)
  case Ast.Assign(_, _, x) => Mem.expr(cx, at, w, x)
  case Ast.Quant(_, _, _, _, x) => Mem.expr(cx, at, w, x)
  case Ast.Int(_, _) => w
  case Ast.Bool(_, _) => w
  case Ast.Str(_, _) => w
  case Ast.Unit(_) => w
  case Ast.Name(_, _) => w

def Mem.exprs(cx: Mem.Cx, at: Mem.At, w: Mem.W, es: Coll.List[Ast.Expr]): Mem.W = es match
  case Coll.Nil => w
  case Coll.Cons(e, rest) => Mem.exprs(cx, at, Mem.expr(cx, at, w, e), rest)

def Mem.arms(cx: Mem.Cx, at: Mem.At, w: Mem.W, arms: Coll.List[Ast.Arm]): Mem.W = arms match
  case Coll.Nil => w
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, body) = a
    Mem.arms(cx, at, Mem.expr(cx, at, w, body), rest)

// a block: a handle of a Region handler opens a region over the rest of the block
def Mem.stmts(cx: Mem.Cx, at: Mem.At, w: Mem.W, ss: Coll.List[Ast.Stmt], last: Ast.Expr): Mem.W = ss match
  case Coll.Nil => Mem.expr(cx, at, w, last)
  case Coll.Cons(s, rest) => s match
    case Ast.Handle(line, x, h, args) =>
      val Mem.Cx(_, _, rhs, _) = cx
      val w2 = Mem.exprs(cx, at, w, args)
      val Mem.At(f, _, loop) = at
      if Mem.isIn(rhs, h) then Mem.stmts(cx, Mem.At(f, Coll.Some(Mem.nextRegion(w2)), loop), Mem.region(w2, f, line, x, h), rest, last)
      else Mem.stmts(cx, at, w2, rest, last)
    case Ast.Val(_, _, _, e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)
    case Ast.Var(_, _, _, e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)
    case Ast.Do(e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)
    case Ast.Check(_, _, e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)

def Mem.decls(cx: Mem.Cx, w: Mem.W, ds: Coll.List[Ast.Decl]): Mem.W = ds match
  case Coll.Nil => w
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) =>
      val Ast.Fn(_, n, _, _, _, _, body) = f
      val w2: Mem.W = body match
        case Ast.Def(_, e) => Mem.expr(cx, Mem.At(n, Coll.None, false), w, e)
        case Ast.Extern(_) => w
      Mem.decls(cx, w2, rest)
    case _ => Mem.decls(cx, w, rest)

// every case and its fields (a case with none is a static: it allocates nothing); and the Region handlers
def Mem.ctors(ds: Coll.List[Ast.Decl], m: Coll.SMap[Coll.List[Ast.Binder]]): Coll.SMap[Coll.List[Ast.Binder]] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DEnum(e) =>
      val Ast.Enum(_, _, _, cases) = e
      Mem.ctors(rest, Mem.caseCtors(cases, m))
    case _ => Mem.ctors(rest, m)

def Mem.caseCtors(cs: Coll.List[Ast.Case], m: Coll.SMap[Coll.List[Ast.Binder]]): Coll.SMap[Coll.List[Ast.Binder]] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, fields) = c
    Mem.caseCtors(rest, Coll.sInsert(m, n, fields))

def Mem.regionHs(ds: Coll.List[Ast.Decl], m: Coll.SMap[Bool]): Coll.SMap[Bool] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DHandler(h) =>
      val Ast.Handler(_, n, p, _, _) = h
      Mem.regionHs(rest, if Sym.eq(p, Sym.of("Region")) then Coll.sInsert(m, n, true) else m)
    case _ => Mem.regionHs(rest, m)

def Mem.fnList(ds: Coll.List[Ast.Decl], acc: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) => Mem.fnList(rest, Coll.Cons(f, acc))
    case _ => Mem.fnList(rest, acc)

// multi(G) for a callee with two or more call sites
def Mem.multis(fns: Coll.List[Ast.Fn], cs: Coll.SMap[I64], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = fns match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, _, _, _, _) = f
    Mem.multis(rest, cs, if Mem.count(cs, n) >= 2 then Coll.Cons(Mem.f1(Mem.RMulti, D.VSym(n)), acc) else acc)

// ── the report: per live region (by line), its sites (by line) and their multiplicity ──
enum Mem.Why:
  case Mem.InLoop
  case Mem.Sites(f: Sym.Sym, n: I64)
  case Mem.LoopCalled(f: Sym.Sym)
  case Mem.Via(f: Sym.Sym)

enum Mem.Mult:
  case Mem.Once
  case Mem.Many(why: Mem.Why)

enum Mem.Row:
  case Mem.Row(line: I64, ctor: Sym.Sym, bytes: Coll.Option[I64], dies: Bool, m: Mem.Mult)

enum Mem.Block:
  case Mem.Block(line: I64, x: Sym.Sym, h: Sym.Sym, rows: Coll.List[Mem.Row])

enum Mem.Report:
  case Mem.Ok(bs: Coll.List[Mem.Block], rs: Coll.List[Mem.Reuse])
  case Mem.RulesBad(rel: Sym.Sym)

// what the model says, by name or id
enum Mem.Model:
  case Mem.Model(manyDef: Coll.SMap[Bool], loopCall: Coll.SMap[Bool], byRegion: Coll.IMap[Coll.List[I64]], live: Coll.List[I64], bytes: Coll.IMap[Coll.List[Emit.SiteB]], esc: Coll.List[Mem.ESiteR])

def Mem.report(ds: Coll.List[Ast.Decl], sb: Coll.List[Emit.SiteB]): Mem.Report =
  val fl = Mem.fnList(ds, Coll.Nil)
  val cx = Mem.Cx(Ty.idxFns(fl, Coll.sEmpty()), Mem.ctors(ds, Coll.sEmpty()), Mem.regionHs(ds, Coll.sEmpty()), Eff.syms())
  val w = Mem.decls(cx, Mem.W(Coll.Tip, 0, Coll.Tip, 0, Coll.Nil, Coll.sEmpty(), Coll.Nil), ds)
  val Mem.W(sites, ns, regions, nr, fs, cs, free) = w
  val facts = Coll.Cons(Mem.f1(Mem.RReached, D.VSym(Sym.of("main"))), Mem.multis(fl, cs, fs))
  D.solve(Mem.rules(), facts) match
    case D.Solved(m) =>
      val md = Mem.Model(Mem.names(D.tuples(m, Mem.relSym(Mem.RManyDef)), Coll.sEmpty()), Mem.names(D.tuples(m, Mem.relSym(Mem.RLoopCall)), Coll.sEmpty()), Mem.group(D.tuples(m, Mem.relSym(Mem.RFills)), Coll.Tip), Mem.ints(D.tuples(m, Mem.relSym(Mem.RLive)), Coll.Nil), Mem.siteMap(sb, Coll.Tip), Mem.escapeSites(cx, ds))
      Mem.Ok(Mem.blocks(md, cs, free, sites, ns, regions, Mem.byLine(Mem.regionKeys(regions, nr, Mem.liveOf(md), Coll.Nil)), Coll.Nil), Mem.byReuseLine(Mem.reuses(ds)))
    case D.Unsafe(rel) => Mem.RulesBad(rel)
    case D.NegCycle(rel) => Mem.RulesBad(rel)

def Mem.liveOf(md: Mem.Model): Coll.List[I64] =
  val Mem.Model(_, _, _, live, _, _) = md
  live

def Mem.names(ts: Coll.List[Coll.List[D.Val]], m: Coll.SMap[Bool]): Coll.SMap[Bool] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VSym(n) => Mem.names(rest, Coll.sInsert(m, n, true))
      case D.VInt(_) => Mem.names(rest, m)
    case Coll.Nil => Mem.names(rest, m)

def Mem.ints(ts: Coll.List[Coll.List[D.Val]], acc: Coll.List[I64]): Coll.List[I64] = ts match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VInt(n) => Mem.ints(rest, Coll.Cons(n, acc))
      case D.VSym(_) => Mem.ints(rest, acc)
    case Coll.Nil => Mem.ints(rest, acc)

// fills(S, R) grouped: region id to its site ids
def Mem.group(ts: Coll.List[Coll.List[D.Val]], m: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(a, tl) => tl match
      case Coll.Cons(b, _) => a match
        case D.VInt(s) => b match
          case D.VInt(r) => Mem.group(rest, Coll.insert(m, r, Coll.Cons(s, Mem.idsOf(m, r))))
          case D.VSym(_) => Mem.group(rest, m)
        case D.VSym(_) => Mem.group(rest, m)
      case Coll.Nil => Mem.group(rest, m)
    case Coll.Nil => Mem.group(rest, m)

def Mem.idsOf(m: Coll.IMap[Coll.List[I64]], k: I64): Coll.List[I64] = Coll.lookup(m, k) match
  case Coll.Some(xs) => xs
  case Coll.None => Coll.Nil

// a key that orders by line, then by id: id < n, so line * n + id is unique (both below 2^31 in any real program)
def Mem.regionKeys(rs: Coll.IMap[Mem.Region], n: I64, ids: Coll.List[I64], acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] = ids match
  case Coll.Nil => acc
  case Coll.Cons(r, rest) => Coll.lookup(rs, r) match
    case Coll.Some(x) =>
      val Mem.Region(_, line, _, _) = x
      Mem.regionKeys(rs, n, rest, Coll.Cons(Coll.KV(line * n + r, r), acc))
    case Coll.None => Mem.regionKeys(rs, n, rest, acc)

def Mem.siteKeys(ss: Coll.IMap[Mem.Site], n: I64, ids: Coll.List[I64], acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] = ids match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => Coll.lookup(ss, s) match
    case Coll.Some(x) =>
      val Mem.Site(_, line, _, _) = x
      Mem.siteKeys(ss, n, rest, Coll.Cons(Coll.KV(line * n + s, s), acc))
    case Coll.None => Mem.siteKeys(ss, n, rest, acc)

def Mem.byLine(kvs: Coll.List[Coll.KV[I64]]): Coll.List[I64] =
  val Coll.Sorted(xs) = Coll.sortDedup(kvs)
  Mem.vals(xs, Coll.Nil)

def Mem.vals(xs: Coll.List[Coll.KV[I64]], acc: Coll.List[I64]): Coll.List[I64] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(_, v) = kv
    Mem.vals(rest, Coll.Cons(v, acc))

def Mem.blocks(md: Mem.Model, cs: Coll.SMap[I64], free: Coll.List[Mem.Edge], ss: Coll.IMap[Mem.Site], ns: I64, rs: Coll.IMap[Mem.Region], ids: Coll.List[I64], acc: Coll.List[Mem.Block]): Coll.List[Mem.Block] = ids match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(r, rest) => Coll.lookup(rs, r) match
    case Coll.Some(x) =>
      val Mem.Region(_, line, nm, h) = x
      val Mem.Model(_, _, byRegion, _, _, _) = md
      val rows = Mem.rows(md, cs, free, ss, Mem.byLine(Mem.siteKeys(ss, ns, Mem.idsOf(byRegion, r), Coll.Nil)), Coll.Nil)
      Mem.blocks(md, cs, free, ss, ns, rs, rest, Coll.Cons(Mem.Block(line, nm, h, rows), acc))
    case Coll.None => Mem.blocks(md, cs, free, ss, ns, rs, rest, acc)

def Mem.rows(md: Mem.Model, cs: Coll.SMap[I64], free: Coll.List[Mem.Edge], ss: Coll.IMap[Mem.Site], ids: Coll.List[I64], acc: Coll.List[Mem.Row]): Coll.List[Mem.Row] = ids match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(s, rest) => Coll.lookup(ss, s) match
    case Coll.Some(x) =>
      val Mem.Site(f, line, ctor, loop) = x
      Mem.rows(md, cs, free, ss, rest, Coll.Cons(Mem.Row(line, ctor, Mem.bytesAt(md, line, ctor), Mem.dies(md, f, line, ctor), Mem.multOf(md, cs, free, f, loop)), acc))
    case Coll.None => Mem.rows(md, cs, free, ss, rest, acc)

// a site in a loop of its def, else its def's reason to be many: its own call sites, a call in a loop, or a caller
// that is many
def Mem.multOf(md: Mem.Model, cs: Coll.SMap[I64], free: Coll.List[Mem.Edge], f: Sym.Sym, loop: Bool): Mem.Mult =
  val Mem.Model(manyDef, loopCall, _, _, _, _) = md
  if loop then Mem.Many(Mem.InLoop)
  else if !Mem.isIn(manyDef, f) then Mem.Once
  else if Mem.count(cs, f) >= 2 then Mem.Many(Mem.Sites(f, Mem.count(cs, f)))
  else if Mem.isIn(loopCall, f) then Mem.Many(Mem.LoopCalled(f))
  else Mem.Many(Mem.Via(Mem.manyCaller(manyDef, free, f)))

// the first free caller of f that is many (the model has one: manyDef(f) came from such a caller)
def Mem.manyCaller(manyDef: Coll.SMap[Bool], free: Coll.List[Mem.Edge], f: Sym.Sym): Sym.Sym = free match
  case Coll.Nil => f
  case Coll.Cons(e, rest) =>
    val Mem.Edge(a, b) = e
    if Sym.eq(b, f) && Mem.isIn(manyDef, a) then a else Mem.manyCaller(manyDef, rest, f)

// the constructor sites by line: each instance of a def adds one entry for its site
def Mem.siteMap(sb: Coll.List[Emit.SiteB], m: Coll.IMap[Coll.List[Emit.SiteB]]): Coll.IMap[Coll.List[Emit.SiteB]] = sb match
  case Coll.Nil => m
  case Coll.Cons(s, rest) =>
    val Emit.SiteB(line, _, _) = s
    Mem.siteMap(rest, Coll.insert(m, line, Coll.Cons(s, Mem.sitesAt(m, line))))

def Mem.sitesAt(m: Coll.IMap[Coll.List[Emit.SiteB]], line: I64): Coll.List[Emit.SiteB] = Coll.lookup(m, line) match
  case Coll.Some(xs) => xs
  case Coll.None => Coll.Nil

// the bytes of one box of ctor at line: the largest over the instances of its def; none for an Array.fill (its
// size is known at run time) or a def no instance reaches
def Mem.bytesAt(md: Mem.Model, line: I64, ctor: Sym.Sym): Coll.Option[I64] =
  val Mem.Model(_, _, _, _, bm, _) = md
  Mem.maxBytes(Mem.sitesAt(bm, line), ctor, Coll.None)

def Mem.maxBytes(xs: Coll.List[Emit.SiteB], ctor: Sym.Sym, best: Coll.Option[I64]): Coll.Option[I64] = xs match
  case Coll.Nil => best
  case Coll.Cons(s, rest) =>
    val Emit.SiteB(_, c, b) = s
    val now: Coll.Option[I64] = best match
      case Coll.Some(x) => if Sym.eq(c, ctor) && b > x then Coll.Some(b) else best
      case Coll.None => if Sym.eq(c, ctor) then Coll.Some(b) else best
    Mem.maxBytes(rest, ctor, now)


// ── M4: does a box die in the def that makes it (vic/c/mem-design.md "M4b") ──
// A Datalog escape analysis in the shape of Doop's points-to (a value reaches a place only through a rule) and nanofil's
// escape.pl (a use that is not known to be local escapes). Nodes are a def's names, its sites, its call results and its
// result. flow(A, B), inside one def: a value at A can be at B (a val, var or assignment, a match pattern from its
// scrutinee, a box's args into the box). A call of a def G with a body gives argOf(A, G, i, C): arg i at A, result at C.
// sink(A): a use no rule follows (an op's args, a resume, a handle's args, any call that is not a def with a body:
// Array.put, a Cell op, an extern). Each def's params get summaries (Whaley-Rinard style), so every relation is linear in
// the program: retP(G, i) param i can reach G's result, sinkP(G, i) it can reach a sink. A box escapes its def when its
// node reaches the def's result or a sink; else it dies there. A site without a fact escapes.
//   retR(N) :- isRet(N) | flow(N, M), retR(M) | argOf(N, G, I, C), retP(G, I), retR(C)
//   sinkR(N) :- sink(N) | flow(N, M), sinkR(M) | argOf(N, G, I, C), sinkP(G, I) | argOf(N, G, I, C), retP(G, I), sinkR(C)
//   retP(G, I) :- param(G, I, P), retR(P)        sinkP(G, I) :- param(G, I, P), sinkR(P)
//   esc(S) :- siteOf(S, F), retR(site S of F) | siteOf(S, F), sinkR(site S of F)
enum Mem.ERel:
  case Mem.EFlow
  case Mem.ESink
  case Mem.ERet
  case Mem.ESiteOf
  case Mem.EArgOf
  case Mem.EParam
  case Mem.ERetR
  case Mem.ESinkR
  case Mem.ERetP
  case Mem.ESinkP
  case Mem.EEsc

def Mem.eSym(r: Mem.ERel): Sym.Sym = r match
  case Mem.EFlow => Sym.of("eflow")
  case Mem.ESink => Sym.of("esink")
  case Mem.ERet => Sym.of("eret")
  case Mem.ESiteOf => Sym.of("esiteOf")
  case Mem.EArgOf => Sym.of("eargOf")
  case Mem.EParam => Sym.of("eparam")
  case Mem.ERetR => Sym.of("eretR")
  case Mem.ESinkR => Sym.of("esinkR")
  case Mem.ERetP => Sym.of("eretP")
  case Mem.ESinkP => Sym.of("esinkP")
  case Mem.EEsc => Sym.of("eesc")

// a node: kind (Mem.kVar, kSite, kCall, kRet), its def, its key (a name, a site id, a line, 0)
enum Mem.Node:
  case Mem.Node(k: I64, d: Sym.Sym, x: D.Val)

def Mem.kVar(): I64 = 0
def Mem.kSite(): I64 = 1
def Mem.kCall(): I64 = 2
def Mem.kRet(): I64 = 3

def Mem.nVar(f: Sym.Sym, x: Sym.Sym): Mem.Node = Mem.Node(Mem.kVar(), f, D.VSym(x))
def Mem.nRet(f: Sym.Sym): Mem.Node = Mem.Node(Mem.kRet(), f, D.VInt(0))

def Mem.nVals(n: Mem.Node, rest: Coll.List[D.Val]): Coll.List[D.Val] =
  val Mem.Node(k, d, x) = n
  Coll.Cons(D.VSym(d), Coll.Cons(x, Coll.Cons(D.VInt(k), rest)))

// a site the walk saw: its id, def, line and constructor
enum Mem.ESite:
  case Mem.ESite(id: I64, f: Sym.Sym, line: I64, ctor: Sym.Sym)

// a site and whether its box dies in its def
enum Mem.ESiteR:
  case Mem.ESiteR(f: Sym.Sym, line: I64, ctor: Sym.Sym, dead: Bool)

// the walk's state: facts, the next site id, the sites
enum Mem.EW:
  case Mem.EW(facts: Coll.List[D.Fact], n: I64, sites: Coll.List[Mem.ESite])

// the state after an expression, and the nodes its value can come from
enum Mem.EV:
  case Mem.EV(w: Mem.EW, ns: Coll.List[Mem.Node])

def Mem.eFact(w: Mem.EW, x: D.Fact): Mem.EW =
  val Mem.EW(fs, n, ss) = w
  Mem.EW(Coll.Cons(x, fs), n, ss)

def Mem.flowTo(w: Mem.EW, ns: Coll.List[Mem.Node], b: Mem.Node): Mem.EW = ns match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => Mem.flowTo(Mem.eFact(w, D.Fact(Mem.eSym(Mem.EFlow), Mem.nVals(a, Mem.nVals(b, Coll.Nil)))), rest, b)

def Mem.sinkAll(w: Mem.EW, ns: Coll.List[Mem.Node]): Mem.EW = ns match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => Mem.sinkAll(Mem.eFact(w, D.Fact(Mem.eSym(Mem.ESink), Mem.nVals(a, Coll.Nil))), rest)

// a type whose values hold no box
def Mem.scalar(t: Ast.Ty): Bool =
  val Ast.Ty(_, n, _, _, _) = t
  val x = Sym.str(n)
  Str.eq(x, "I64") || Str.eq(x, "Bool") || Str.eq(x, "Unit") || Str.eq(x, "U8") || Str.eq(x, "U32") || Str.eq(x, "U64") || Str.eq(x, "I32")

// a case with fields: its constructor allocates a box
def Mem.allocates(ctors: Coll.SMap[Coll.List[Ast.Binder]], f: Sym.Sym): Bool = Coll.sLookup(ctors, f) match
  case Coll.Some(fs) => fs match
    case Coll.Cons(_, _) => true
    case Coll.Nil => false
  case Coll.None => false

def Mem.eExpr(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, e: Ast.Expr): Mem.EV = e match
  // a nullary case named without parens is a static: no box, no node
  case Ast.Name(_, x) =>
    val Mem.Cx(_, ctors, _, _) = cx
    if Mem.isIn(ctors, x) then Mem.EV(w, Coll.Nil) else Mem.EV(w, Coll.Cons(Mem.nVar(f, x), Coll.Nil))
  case Ast.Call(line, g, _, _, args) => Mem.eCall(cx, f, w, line, g, args)
  case Ast.Method(line, _, _, args) =>
    val Mem.EV(w2, ns) = Mem.eExprs(cx, f, w, args, Coll.Nil)
    Mem.unknown(Mem.sinkAll(w2, ns), Mem.Node(Mem.kCall(), f, D.VInt(line)))
  case Ast.Resume(_, _, x) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, x)
    Mem.EV(Mem.sinkAll(w2, ns), Coll.Nil)
  case Ast.Bin(_, _, l, r) =>
    val Mem.EV(w2, _) = Mem.eExprs(cx, f, w, Coll.Cons(l, Coll.Cons(r, Coll.Nil)), Coll.Nil)
    Mem.EV(w2, Coll.Nil)
  case Ast.Un(_, _, x) =>
    val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, x)
    Mem.EV(w2, Coll.Nil)
  case Ast.If(_, c, t, x) =>
    val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, c)
    Mem.eExprs(cx, f, w2, Coll.Cons(t, Coll.Cons(x, Coll.Nil)), Coll.Nil)
  case Ast.Match(_, s, arms) =>
    val Mem.EV(w2, ss) = Mem.eExpr(cx, f, w, s)
    Mem.eArms(cx, f, w2, ss, arms, Coll.Nil)
  case Ast.Block(_, stmts, last) => Mem.eStmts(cx, f, w, stmts, last)
  case Ast.While(_, c, body) =>
    val Mem.EV(w2, _) = Mem.eExprs(cx, f, w, Coll.Cons(c, Coll.Cons(body, Coll.Nil)), Coll.Nil)
    Mem.EV(w2, Coll.Nil)
  case Ast.Assign(_, x, v) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, v)
    Mem.EV(Mem.flowTo(w2, ns, Mem.nVar(f, x)), Coll.Nil)
  case Ast.Quant(_, _, _, _, _) => Mem.EV(w, Coll.Nil)
  case Ast.Int(_, _) => Mem.EV(w, Coll.Nil)
  case Ast.Bool(_, _) => Mem.EV(w, Coll.Nil)
  case Ast.Str(_, _) => Mem.EV(w, Coll.Nil)
  case Ast.Unit(_) => Mem.EV(w, Coll.Nil)

// a call: a constructor that allocates is a site holding its args; a def with a body takes each arg into its param and
// gives its result (none when the result type holds no box); anything else (Array.put, a Cell op, an extern, a read
// xs(i) of a local array) keeps its args: they are sinks, and its value is the named local's
def Mem.eCall(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, line: I64, g: Sym.Sym, args: Coll.List[Ast.Expr]): Mem.EV =
  val Mem.Cx(fns, ctors, _, ss) = cx
  val Mem.EA(w2, nss) = Mem.eArgs(cx, f, w, args, Coll.Nil)
  if Mem.allocates(ctors, g) || Eff.isArrayNew(ss, g) then
    val Mem.EW(fs, n, sites) = w2
    val node = Mem.Node(Mem.kSite(), f, D.VInt(n))
    val w3 = Mem.EW(Coll.Cons(D.Fact(Mem.eSym(Mem.ESiteOf), Coll.Cons(D.VInt(n), Coll.Cons(D.VSym(f), Coll.Nil))), fs), n + 1, Coll.Cons(Mem.ESite(n, f, line, g), sites))
    val held: Coll.List[Coll.List[Mem.Node]] = Coll.sLookup(ctors, g) match
      case Coll.Some(fields) => Mem.boxed(nss, fields, Coll.Nil)
      case Coll.None => nss match
        case Coll.Cons(_, rest) => rest
        case Coll.Nil => Coll.Nil
    Mem.EV(Mem.flowTo(w3, Mem.flat(held, Coll.Nil), node), Coll.Cons(node, Coll.Nil))
  else if Mem.isIn(ctors, g) then Mem.EV(w2, Coll.Nil)
  else Coll.sLookup(fns, g) match
    case Coll.Some(gf) =>
      val Ast.Fn(_, _, _, ps, ret, _, body) = gf
      body match
        case Ast.Def(_, _) =>
          val node = Mem.Node(Mem.kCall(), f, D.VInt(line))
          val w3 = Mem.toParams(g, node, w2, nss, ps, 0)
          if Mem.scalar(ret) then Mem.EV(w3, Coll.Nil) else Mem.EV(w3, Coll.Cons(node, Coll.Nil))
        case Ast.Extern(_) => Mem.unknown(Mem.sinkAll(w2, Mem.flat(nss, Coll.Nil)), Mem.Node(Mem.kCall(), f, D.VInt(line)))
    case Coll.None => Mem.unknown(Mem.sinkAll(w2, Mem.flat(nss, Coll.Nil)), Mem.nVar(f, g))

// each arg's nodes, in arg order (the list of lists is built reversed and turned once)
def Mem.eArgs(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, es: Coll.List[Ast.Expr], acc: Coll.List[Coll.List[Mem.Node]]): Mem.EA = es match
  case Coll.Nil => Mem.EA(w, Coll.rev(acc))
  case Coll.Cons(e, rest) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
    Mem.eArgs(cx, f, w2, rest, Coll.Cons(ns, acc))

enum Mem.EA:
  case Mem.EA(w: Mem.EW, nss: Coll.List[Coll.List[Mem.Node]])

def Mem.flat(nss: Coll.List[Coll.List[Mem.Node]], acc: Coll.List[Mem.Node]): Coll.List[Mem.Node] = nss match
  case Coll.Nil => acc
  case Coll.Cons(ns, rest) => Mem.flat(rest, Coll.revOnto(ns, acc))

// argOf(A, g, i, C) for each node A of arg i, with C the call's result node (an arg past the params is a sink)
def Mem.toParams(g: Sym.Sym, c: Mem.Node, w: Mem.EW, nss: Coll.List[Coll.List[Mem.Node]], ps: Coll.List[Ast.Binder], i: I64): Mem.EW = nss match
  case Coll.Nil => w
  case Coll.Cons(ns, rest) => ps match
    case Coll.Cons(_, prest) => Mem.toParams(g, c, Mem.argOf(w, ns, g, i, c), rest, prest, i + 1)
    case Coll.Nil => Mem.toParams(g, c, Mem.sinkAll(w, ns), rest, Coll.Nil, i + 1)

def Mem.argOf(w: Mem.EW, ns: Coll.List[Mem.Node], g: Sym.Sym, i: I64, c: Mem.Node): Mem.EW = ns match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => Mem.argOf(Mem.eFact(w, D.Fact(Mem.eSym(Mem.EArgOf), Mem.nVals(a, Coll.Cons(D.VSym(g), Coll.Cons(D.VInt(i), Mem.nVals(c, Coll.Nil)))))), rest, g, i, c)

// param(g, i, node of param i) for each param of g
def Mem.params(g: Sym.Sym, w: Mem.EW, ps: Coll.List[Ast.Binder], i: I64): Mem.EW = ps match
  case Coll.Nil => w
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, _) = p
    Mem.params(g, Mem.eFact(w, D.Fact(Mem.eSym(Mem.EParam), Coll.Cons(D.VSym(g), Coll.Cons(D.VInt(i), Mem.nVals(Mem.nVar(g, x), Coll.Nil))))), rest, i + 1)

def Mem.eExprs(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, es: Coll.List[Ast.Expr], acc: Coll.List[Mem.Node]): Mem.EV = es match
  case Coll.Nil => Mem.EV(w, acc)
  case Coll.Cons(e, rest) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
    Mem.eExprs(cx, f, w2, rest, Coll.revOnto(ns, acc))

def Mem.eArms(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, ss: Coll.List[Mem.Node], arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.Node]): Mem.EV = arms match
  case Coll.Nil => Mem.EV(w, acc)
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, body) = a
    val w2: Mem.EW = p match
      case Ast.PCase(_, binds) => Mem.bindPat(f, w, ss, binds)
      case Ast.PAny => w
    val Mem.EV(w3, ns) = Mem.eExpr(cx, f, w2, body)
    Mem.eArms(cx, f, w3, ss, rest, Coll.revOnto(ns, acc))

def Mem.bindPat(f: Sym.Sym, w: Mem.EW, ss: Coll.List[Mem.Node], xs: Coll.List[Sym.Sym]): Mem.EW = xs match
  case Coll.Nil => w
  case Coll.Cons(x, rest) => Mem.bindPat(f, Mem.flowTo(w, ss, Mem.nVar(f, x)), ss, rest)

def Mem.eStmts(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, ss: Coll.List[Ast.Stmt], last: Ast.Expr): Mem.EV = ss match
  case Coll.Nil => Mem.eExpr(cx, f, w, last)
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, x, _, e) =>
      val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, Mem.flowTo(w2, ns, Mem.nVar(f, x)), rest, last)
    case Ast.Var(_, x, _, e) =>
      val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, Mem.flowTo(w2, ns, Mem.nVar(f, x)), rest, last)
    case Ast.Handle(_, _, _, args) =>
      val Mem.EV(w2, ns) = Mem.eExprs(cx, f, w, args, Coll.Nil)
      Mem.eStmts(cx, f, Mem.sinkAll(w2, ns), rest, last)
    case Ast.Do(e) =>
      val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, w2, rest, last)
    case Ast.Check(_, _, e) =>
      val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, w2, rest, last)

// every def with a body: its result node and the facts of its body
def Mem.eDecls(cx: Mem.Cx, w: Mem.EW, ds: Coll.List[Ast.Decl]): Mem.EW = ds match
  case Coll.Nil => w
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(fn) =>
      val Ast.Fn(_, n, _, ps, _, _, body) = fn
      val w3: Mem.EW = body match
        case Ast.Def(_, e) =>
          val r = Mem.nRet(n)
          val w1 = Mem.params(n, Mem.eFact(w, D.Fact(Mem.eSym(Mem.ERet), Mem.nVals(r, Coll.Nil))), ps, 0)
          val Mem.EV(w2, ns) = Mem.eExpr(cx, n, w1, e)
          Mem.flowTo(w2, ns, r)
        case Ast.Extern(_) => w
      Mem.eDecls(cx, w3, rest)
    case _ => Mem.eDecls(cx, w, rest)

def Mem.eAtom(r: Mem.ERel, xs: Coll.List[D.Arg]): D.Atom = D.Atom(Mem.eSym(r), xs)
def Mem.v(i: I64): D.Arg = D.AVar(i)

// node args: def, key, kind as vars a, b, c (def first: D indexes the first bound column, and a def has few nodes)
def Mem.n3(a: I64, b: I64, c: I64, rest: Coll.List[D.Arg]): Coll.List[D.Arg] = Coll.Cons(Mem.v(a), Coll.Cons(Mem.v(b), Coll.Cons(Mem.v(c), rest)))

// var numbers: N = 0 1 2, M = 3 4 5, G = 6, I = 7, C = 8 9 10
def Mem.nN(): Coll.List[D.Arg] = Mem.n3(0, 1, 2, Coll.Nil)
def Mem.argOfA(): D.Lit = D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n3(0, 1, 2, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n3(8, 9, 10, Coll.Nil))))))
def Mem.gi(r: Mem.ERel): D.Lit = D.Pos(Mem.eAtom(r, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Coll.Nil))))
def Mem.atC(r: Mem.ERel): D.Lit = D.Pos(Mem.eAtom(r, Mem.n3(8, 9, 10, Coll.Nil)))
def Mem.lits3(a: D.Lit, b: D.Lit, c: D.Lit): Coll.List[D.Lit] = Coll.Cons(a, Mem.lits2(b, c))

// r(N) :- base(N) | flow(N, M), r(M): the reach part of retR and sinkR
def Mem.reach(r: Mem.ERel, base: Mem.ERel): Coll.List[D.Rule] =
  val r1 = D.Rule(Mem.eAtom(r, Mem.nN()), Mem.lit1(D.Pos(Mem.eAtom(base, Mem.nN()))))
  val r2 = D.Rule(Mem.eAtom(r, Mem.nN()), Mem.lits2(D.Pos(Mem.eAtom(Mem.EFlow, Mem.n3(0, 1, 2, Mem.n3(3, 4, 5, Coll.Nil)))), D.Pos(Mem.eAtom(r, Mem.n3(3, 4, 5, Coll.Nil)))))
  Coll.Cons(r1, Coll.Cons(r2, Coll.Nil))

// p(G, I) :- param(G, I, P), r(P)
def Mem.summary(p: Mem.ERel, r: Mem.ERel): D.Rule =
  D.Rule(Mem.eAtom(p, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Coll.Nil))), Mem.lits2(D.Pos(Mem.eAtom(Mem.EParam, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n3(0, 1, 2, Coll.Nil))))), D.Pos(Mem.eAtom(r, Mem.nN()))))

def Mem.eRules(): Coll.List[D.Rule] =
  val retC = D.Rule(Mem.eAtom(Mem.ERetR, Mem.nN()), Mem.lits3(Mem.argOfA(), Mem.gi(Mem.ERetP), Mem.atC(Mem.ERetR)))
  val sinkP = D.Rule(Mem.eAtom(Mem.ESinkR, Mem.nN()), Mem.lits2(Mem.argOfA(), Mem.gi(Mem.ESinkP)))
  val sinkC = D.Rule(Mem.eAtom(Mem.ESinkR, Mem.nN()), Mem.lits3(Mem.argOfA(), Mem.gi(Mem.ERetP), Mem.atC(Mem.ESinkR)))
  val site = Coll.Cons(Mem.v(1), Coll.Cons(Mem.v(0), Coll.Cons(D.AVal(D.VInt(Mem.kSite())), Coll.Nil)))
  val siteOf = D.Pos(Mem.eAtom(Mem.ESiteOf, Coll.Cons(Mem.v(0), Coll.Cons(Mem.v(1), Coll.Nil))))
  val esc1 = D.Rule(Mem.eAtom(Mem.EEsc, Coll.Cons(Mem.v(0), Coll.Nil)), Mem.lits2(siteOf, D.Pos(Mem.eAtom(Mem.ERetR, site))))
  val esc2 = D.Rule(Mem.eAtom(Mem.EEsc, Coll.Cons(Mem.v(0), Coll.Nil)), Mem.lits2(siteOf, D.Pos(Mem.eAtom(Mem.ESinkR, site))))
  val own = Coll.Cons(retC, Coll.Cons(sinkP, Coll.Cons(sinkC, Coll.Cons(Mem.summary(Mem.ERetP, Mem.ERetR), Coll.Cons(Mem.summary(Mem.ESinkP, Mem.ESinkR), Coll.Cons(esc1, Coll.Cons(esc2, Coll.Nil)))))))
  Coll.revOnto(Coll.rev(Mem.reach(Mem.ERetR, Mem.ERet)), Coll.revOnto(Coll.rev(Mem.reach(Mem.ESinkR, Mem.ESink)), own))

// every site with whether its box dies; when the rules are not a program, every site escapes (the safe answer)
def Mem.escapeSites(cx: Mem.Cx, ds: Coll.List[Ast.Decl]): Coll.List[Mem.ESiteR] =
  val Mem.EW(fs, _, sites) = Mem.eDecls(cx, Mem.EW(Coll.Nil, 0, Coll.Nil), ds)
  D.solve(Mem.eRules(), fs) match
    case D.Solved(m) => Mem.marks(sites, Mem.idSet(D.tuples(m, Mem.eSym(Mem.EEsc)), Coll.Tip), true, Coll.Nil)
    case D.Unsafe(_) => Mem.marks(sites, Coll.Tip, false, Coll.Nil)
    case D.NegCycle(_) => Mem.marks(sites, Coll.Tip, false, Coll.Nil)

def Mem.idSet(ts: Coll.List[Coll.List[D.Val]], m: Coll.IMap[Bool]): Coll.IMap[Bool] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VInt(i) => Mem.idSet(rest, Coll.insert(m, i, true))
      case D.VSym(_) => Mem.idSet(rest, m)
    case Coll.Nil => Mem.idSet(rest, m)

def Mem.marks(ss: Coll.List[Mem.ESite], esc: Coll.IMap[Bool], ok: Bool, acc: Coll.List[Mem.ESiteR]): Coll.List[Mem.ESiteR] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) =>
    val Mem.ESite(id, f, line, ctor) = s
    val dead: Bool = Coll.lookup(esc, id) match
      case Coll.Some(_) => false
      case Coll.None => ok
    Mem.marks(rest, esc, ok, Coll.Cons(Mem.ESiteR(f, line, ctor, dead), acc))

// a site of def f at line with ctor dies when the analysis saw it and every box made there dies
def Mem.dies(md: Mem.Model, f: Sym.Sym, line: I64, ctor: Sym.Sym): Bool =
  val Mem.Model(_, _, _, _, _, rs) = md
  Mem.allDead(rs, f, line, ctor, false)

def Mem.allDead(rs: Coll.List[Mem.ESiteR], f: Sym.Sym, line: I64, ctor: Sym.Sym, seen: Bool): Bool = rs match
  case Coll.Nil => seen
  case Coll.Cons(r, rest) =>
    val Mem.ESiteR(g, l, c, dead) = r
    if l == line && Sym.eq(g, f) && Sym.eq(c, ctor) then dead && Mem.allDead(rest, f, line, ctor, true)
    else Mem.allDead(rest, f, line, ctor, seen)

// ── M7a: which matches can rebuild their box in place (vic/c/mem-design.md "M7") ──
// a box is SHARED when two references to it can be live: a least fixpoint over M4's nodes. A var read on two paths of
// one run (a sum in a block, the max over if and match arms, twice inside a while) is shared; sharing flows forward
// along flow (val, var, pattern binds, box args: a box built from a shared value is shared, so a field taken out of an
// unshared box is unshared), from an arg into the callee's param, and from a callee's shared result into the call. A
// value with no known origin (a read xs(i), an extern or op result, a param of a handler or given fn, which dispatch
// calls) is shared. A match on a var x that is not shared, read once (the match), can write a box of its arm into x's
// cell: the reuse table. Report only (M7b writes the C).
//   shared(N) :- multi(N) | unknown(N) | flow(M, N), shared(M) | argOf(M, G, I, C), shared(M), param(G, I, N)
//              | argOf(_, G, _, N), shared(ret node of G)
enum Mem.UC:
  case Mem.UC(x: Sym.Sym, n: I64)

def Mem.ucGet(m: Coll.List[Mem.UC], x: Sym.Sym): I64 = m match
  case Coll.Nil => 0
  case Coll.Cons(u, rest) =>
    val Mem.UC(y, n) = u
    if Sym.eq(x, y) then n else Mem.ucGet(rest, x)

// m with x's count set to n
def Mem.ucSet(m: Coll.List[Mem.UC], x: Sym.Sym, n: I64): Coll.List[Mem.UC] = m match
  case Coll.Nil => Coll.Cons(Mem.UC(x, n), Coll.Nil)
  case Coll.Cons(u, rest) =>
    val Mem.UC(y, _) = u
    if Sym.eq(x, y) then Coll.Cons(Mem.UC(x, n), rest) else Coll.Cons(u, Mem.ucSet(rest, x, n))

def Mem.ucAdd(m: Coll.List[Mem.UC], x: Sym.Sym, k: I64): Coll.List[Mem.UC] = Mem.ucSet(m, x, Mem.ucGet(m, x) + k)

// a with each count of b added k times
def Mem.ucSum(a: Coll.List[Mem.UC], b: Coll.List[Mem.UC], k: I64): Coll.List[Mem.UC] = b match
  case Coll.Nil => a
  case Coll.Cons(u, rest) =>
    val Mem.UC(x, n) = u
    Mem.ucSum(Mem.ucAdd(a, x, n * k), rest, k)

def Mem.ucMax(a: Coll.List[Mem.UC], b: Coll.List[Mem.UC]): Coll.List[Mem.UC] = b match
  case Coll.Nil => a
  case Coll.Cons(u, rest) =>
    val Mem.UC(x, n) = u
    Mem.ucMax(if n > Mem.ucGet(a, x) then Mem.ucSet(a, x, n) else a, rest)

def Mem.uses(e: Ast.Expr, m: Coll.List[Mem.UC]): Coll.List[Mem.UC] = e match
  case Ast.Name(_, x) => Mem.ucAdd(m, x, 1)
  case Ast.Call(_, f, _, _, args) => Mem.usesAll(args, Mem.ucAdd(m, f, 1))
  case Ast.Method(_, r, _, args) => Mem.usesAll(args, Mem.ucAdd(m, r, 1))
  case Ast.Resume(_, _, x) => Mem.uses(x, m)
  case Ast.Bin(_, _, l, r) => Mem.uses(r, Mem.uses(l, m))
  case Ast.Un(_, _, x) => Mem.uses(x, m)
  case Ast.If(_, c, t, x) => Mem.ucSum(Mem.uses(c, m), Mem.ucMax(Mem.uses(t, Coll.Nil), Mem.uses(x, Coll.Nil)), 1)
  case Ast.Match(_, s, arms) => Mem.ucSum(Mem.uses(s, m), Mem.armUses(arms, Coll.Nil), 1)
  case Ast.Block(_, ss, last) => Mem.uses(last, Mem.stmtUses(ss, m))
  case Ast.While(_, c, body) => Mem.ucSum(m, Mem.uses(body, Mem.uses(c, Coll.Nil)), 2)
  case Ast.Assign(_, _, x) => Mem.uses(x, m)
  case Ast.Quant(_, _, _, _, _) => m
  case Ast.Int(_, _) => m
  case Ast.Bool(_, _) => m
  case Ast.Str(_, _) => m
  case Ast.Unit(_) => m

def Mem.usesAll(es: Coll.List[Ast.Expr], m: Coll.List[Mem.UC]): Coll.List[Mem.UC] = es match
  case Coll.Nil => m
  case Coll.Cons(e, rest) => Mem.usesAll(rest, Mem.uses(e, m))

def Mem.armUses(arms: Coll.List[Ast.Arm], m: Coll.List[Mem.UC]): Coll.List[Mem.UC] = arms match
  case Coll.Nil => m
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, body) = a
    Mem.armUses(rest, Mem.ucMax(m, Mem.uses(body, Coll.Nil)))

def Mem.stmtUses(ss: Coll.List[Ast.Stmt], m: Coll.List[Mem.UC]): Coll.List[Mem.UC] = ss match
  case Coll.Nil => m
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, _, e) => Mem.stmtUses(rest, Mem.uses(e, m))
    case Ast.Var(_, _, _, e) => Mem.stmtUses(rest, Mem.uses(e, m))
    case Ast.Handle(_, _, _, args) => Mem.stmtUses(rest, Mem.usesAll(args, m))
    case Ast.Do(e) => Mem.stmtUses(rest, Mem.uses(e, m))
    case Ast.Check(_, _, e) => Mem.stmtUses(rest, Mem.uses(e, m))

// the sharing seeds of def f: each name read twice, and (for a fn that dispatch calls) each param
enum Mem.SRel7:
  case Mem.RMulti7
  case Mem.RUnknown7
  case Mem.RShared7

def Mem.s7(r: Mem.SRel7): Sym.Sym = r match
  case Mem.RMulti7 => Sym.of("emulti")
  case Mem.RUnknown7 => Sym.of("eunknown")
  case Mem.RShared7 => Sym.of("eshared")

def Mem.multiFacts(f: Sym.Sym, m: Coll.List[Mem.UC], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = m match
  case Coll.Nil => acc
  case Coll.Cons(u, rest) =>
    val Mem.UC(x, n) = u
    Mem.multiFacts(f, rest, if n >= 2 then Coll.Cons(D.Fact(Mem.s7(Mem.RMulti7), Mem.nVals(Mem.nVar(f, x), Coll.Nil)), acc) else acc)

def Mem.paramSeeds(f: Sym.Sym, ps: Coll.List[Ast.Binder], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, _) = p
    Mem.paramSeeds(f, rest, Coll.Cons(D.Fact(Mem.s7(Mem.RUnknown7), Mem.nVals(Mem.nVar(f, x), Coll.Nil)), acc))

// the fns of handlers and givens: dispatch calls them, so their params have no known origin; their bodies are walked as
// defs so the calls they make give argOf facts
def Mem.dispatchFns(ds: Coll.List[Ast.Decl], acc: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = ds match
  case Coll.Nil => acc
  case Coll.Cons(d, rest) => d match
    case Ast.DHandler(h) =>
      val Ast.Handler(_, _, _, fs, _) = h
      Mem.dispatchFns(rest, Coll.revOnto(fs, acc))
    case Ast.DGiven(g) =>
      val Ast.Given(_, _, _, fs) = g
      Mem.dispatchFns(rest, Coll.revOnto(fs, acc))
    case _ => Mem.dispatchFns(rest, acc)

def Mem.asDecls(fs: Coll.List[Ast.Fn], acc: Coll.List[Ast.Decl]): Coll.List[Ast.Decl] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) => Mem.asDecls(rest, Coll.Cons(Ast.DFn(f), acc))

def Mem.fnSeeds(fs: Coll.List[Ast.Fn], dispatch: Bool, acc: Coll.List[D.Fact]): Coll.List[D.Fact] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, ps, _, _, body) = f
    val acc2: Coll.List[D.Fact] = body match
      case Ast.Def(_, e) => Mem.multiFacts(n, Mem.uses(e, Coll.Nil), acc)
      case Ast.Extern(_) => acc
    Mem.fnSeeds(rest, dispatch, if dispatch then Mem.paramSeeds(n, ps, acc2) else acc2)

def Mem.sh(xs: Coll.List[D.Arg]): D.Lit = D.Pos(D.Atom(Mem.s7(Mem.RShared7), xs))

def Mem.sharedRules(): Coll.List[D.Rule] =
  val head = D.Atom(Mem.s7(Mem.RShared7), Mem.nN())
  val r1 = D.Rule(head, Mem.lit1(D.Pos(D.Atom(Mem.s7(Mem.RMulti7), Mem.nN()))))
  val r2 = D.Rule(head, Mem.lit1(D.Pos(D.Atom(Mem.s7(Mem.RUnknown7), Mem.nN()))))
  val r3 = D.Rule(head, Mem.lits2(D.Pos(Mem.eAtom(Mem.EFlow, Mem.n3(3, 4, 5, Mem.n3(0, 1, 2, Coll.Nil)))), Mem.sh(Mem.n3(3, 4, 5, Coll.Nil))))
  val r4 = D.Rule(head, Mem.lits3(D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n3(3, 4, 5, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n3(8, 9, 10, Coll.Nil)))))), Mem.sh(Mem.n3(3, 4, 5, Coll.Nil)), D.Pos(Mem.eAtom(Mem.EParam, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.nN()))))))
  val retG = Coll.Cons(Mem.v(6), Coll.Cons(D.AVal(D.VInt(0)), Coll.Cons(D.AVal(D.VInt(Mem.kRet())), Coll.Nil)))
  val r5 = D.Rule(head, Mem.lits2(D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n3(3, 4, 5, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.nN()))))), Mem.sh(retG)))
  Coll.Cons(r1, Coll.Cons(r2, Coll.Cons(r3, Coll.Cons(r4, Coll.Cons(r5, Coll.Nil)))))

// a reuse: the match at line, on x, whose arm takes apart case c and builds ctor (a case of the same enum)
enum Mem.Reuse:
  case Mem.Reuse(line: I64, x: Sym.Sym, c: Sym.Sym, ctor: Sym.Sym)

def Mem.reuses(ds: Coll.List[Ast.Decl]): Coll.List[Mem.Reuse] =
  val fl = Mem.fnList(ds, Coll.Nil)
  val cx = Mem.Cx(Ty.idxFns(fl, Coll.sEmpty()), Mem.ctors(ds, Coll.sEmpty()), Mem.regionHs(ds, Coll.sEmpty()), Eff.syms())
  val dfs = Mem.dispatchFns(ds, Coll.Nil)
  val Mem.EW(efs, _, _) = Mem.eDecls(cx, Mem.EW(Coll.Nil, 0, Coll.Nil), Coll.revOnto(Mem.asDecls(dfs, Coll.Nil), ds))
  val seeds = Mem.fnSeeds(dfs, true, Mem.fnSeeds(fl, false, Coll.Nil))
  D.solve(Mem.sharedRules(), Coll.revOnto(seeds, efs)) match
    case D.Solved(m) => Mem.scanFns(Mem.caseEnums(ds, Coll.sEmpty()), cx, Mem.sharedSet(D.tuples(m, Mem.s7(Mem.RShared7)), Coll.sEmpty()), fl, Coll.Nil)
    case D.Unsafe(_) => Coll.Nil
    case D.NegCycle(_) => Coll.Nil

// shared var nodes by def: def -> the names shared in it
def Mem.sharedSet(ts: Coll.List[Coll.List[D.Val]], m: Coll.SMap[Coll.SMap[Bool]]): Coll.SMap[Coll.SMap[Bool]] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(d, t2) => t2 match
      case Coll.Cons(x, t3) => t3 match
        case Coll.Cons(k, _) => Mem.sharedSet(rest, Mem.addShared(m, d, x, k))
        case Coll.Nil => Mem.sharedSet(rest, m)
      case Coll.Nil => Mem.sharedSet(rest, m)
    case Coll.Nil => Mem.sharedSet(rest, m)

def Mem.addShared(m: Coll.SMap[Coll.SMap[Bool]], d: D.Val, x: D.Val, k: D.Val): Coll.SMap[Coll.SMap[Bool]] = d match
  case D.VSym(f) => x match
    case D.VSym(n) => k match
      case D.VInt(kk) =>
        if kk == Mem.kVar() then
          val inner: Coll.SMap[Bool] = Coll.sLookup(m, f) match
            case Coll.Some(s) => s
            case Coll.None => Coll.sEmpty()
          Coll.sInsert(m, f, Coll.sInsert(inner, n, true))
        else m
      case D.VSym(_) => m
    case D.VInt(_) => m
  case D.VInt(_) => m

def Mem.isShared(sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, x: Sym.Sym): Bool = Coll.sLookup(sh, f) match
  case Coll.Some(s) => Mem.isIn(s, x)
  case Coll.None => false

// each case's enum
def Mem.caseEnums(ds: Coll.List[Ast.Decl], m: Coll.SMap[Sym.Sym]): Coll.SMap[Sym.Sym] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DEnum(e) =>
      val Ast.Enum(_, en, _, cases) = e
      Mem.caseEnums(rest, Mem.casesOf(cases, en, m))
    case _ => Mem.caseEnums(rest, m)

def Mem.casesOf(cs: Coll.List[Ast.Case], en: Sym.Sym, m: Coll.SMap[Sym.Sym]): Coll.SMap[Sym.Sym] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    Mem.casesOf(rest, en, Coll.sInsert(m, n, en))

def Mem.sameEnum(ce: Coll.SMap[Sym.Sym], a: Sym.Sym, b: Sym.Sym): Bool = Coll.sLookup(ce, a) match
  case Coll.Some(x) => Coll.sLookup(ce, b) match
    case Coll.Some(y) => Sym.eq(x, y)
    case Coll.None => false
  case Coll.None => false

def Mem.scanFns(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], fs: Coll.List[Ast.Fn], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, _, _, _, body) = f
    val acc2: Coll.List[Mem.Reuse] = body match
      case Ast.Def(_, e) => Mem.scan(ce, cx, sh, n, e, acc)
      case Ast.Extern(_) => acc
    Mem.scanFns(ce, cx, sh, rest, acc2)

// every match on an unshared var: each arm on a case with fields pairs with the first box of the same enum its body builds
def Mem.scan(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, e: Ast.Expr, acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = e match
  case Ast.Match(line, s, arms) =>
    val acc2: Coll.List[Mem.Reuse] = s match
      case Ast.Name(_, x) => if Mem.isShared(sh, f, x) then acc else Mem.armReuse(ce, cx, line, x, arms, acc)
      case _ => acc
    Mem.scanArms(ce, cx, sh, f, arms, Mem.scan(ce, cx, sh, f, s, acc2))
  case Ast.Call(_, _, _, _, args) => Mem.scanAll(ce, cx, sh, f, args, acc)
  case Ast.Method(_, _, _, args) => Mem.scanAll(ce, cx, sh, f, args, acc)
  case Ast.Resume(_, _, x) => Mem.scan(ce, cx, sh, f, x, acc)
  case Ast.Bin(_, _, l, r) => Mem.scan(ce, cx, sh, f, r, Mem.scan(ce, cx, sh, f, l, acc))
  case Ast.Un(_, _, x) => Mem.scan(ce, cx, sh, f, x, acc)
  case Ast.If(_, c, t, x) => Mem.scanAll(ce, cx, sh, f, Coll.Cons(c, Coll.Cons(t, Coll.Cons(x, Coll.Nil))), acc)
  case Ast.Block(_, ss, last) => Mem.scan(ce, cx, sh, f, last, Mem.scanStmts(ce, cx, sh, f, ss, acc))
  case Ast.While(_, c, b) => Mem.scan(ce, cx, sh, f, b, Mem.scan(ce, cx, sh, f, c, acc))
  case Ast.Assign(_, _, x) => Mem.scan(ce, cx, sh, f, x, acc)
  case _ => acc

def Mem.scanAll(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, es: Coll.List[Ast.Expr], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = es match
  case Coll.Nil => acc
  case Coll.Cons(e, rest) => Mem.scanAll(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))

def Mem.scanArms(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = arms match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, b) = a
    Mem.scanArms(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, b, acc))

def Mem.scanStmts(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, ss: Coll.List[Ast.Stmt], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, _, e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))
    case Ast.Var(_, _, _, e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))
    case Ast.Handle(_, _, _, args) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scanAll(ce, cx, sh, f, args, acc))
    case Ast.Do(e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))
    case Ast.Check(_, _, e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))

def Mem.armReuse(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, line: I64, x: Sym.Sym, arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = arms match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, b) = a
    val acc2: Coll.List[Mem.Reuse] = p match
      case Ast.PCase(c, _) =>
        val Mem.Cx(_, ctors, _, _) = cx
        val k: Coll.Option[Sym.Sym] = if Mem.allocates(ctors, c) then Mem.firstBuild(ce, cx, c, b) else Coll.None
        k match
          case Coll.Some(kk) => Coll.Cons(Mem.Reuse(line, x, c, kk), acc)
          case Coll.None => acc
      case Ast.PAny => acc
    Mem.armReuse(ce, cx, line, x, rest, acc2)

// the first box of c's enum that e builds, in evaluation order
def Mem.firstBuild(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, c: Sym.Sym, e: Ast.Expr): Coll.Option[Sym.Sym] = e match
  case Ast.Call(_, g, _, _, args) =>
    val Mem.Cx(_, ctors, _, _) = cx
    Mem.firstOf(ce, cx, c, args) match
      case Coll.Some(k) => Coll.Some(k)
      case Coll.None => if Mem.allocates(ctors, g) && Mem.sameEnum(ce, c, g) then Coll.Some(g) else Coll.None
  case Ast.If(_, _, t, x) => Mem.firstOf(ce, cx, c, Coll.Cons(t, Coll.Cons(x, Coll.Nil)))
  case Ast.Block(_, _, last) => Mem.firstBuild(ce, cx, c, last)
  case _ => Coll.None

def Mem.firstOf(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, c: Sym.Sym, es: Coll.List[Ast.Expr]): Coll.Option[Sym.Sym] = es match
  case Coll.Nil => Coll.None
  case Coll.Cons(e, rest) => Mem.firstBuild(ce, cx, c, e) match
    case Coll.Some(k) => Coll.Some(k)
    case Coll.None => Mem.firstOf(ce, cx, c, rest)

// reuses by line (line * n + i is unique: i < n)
def Mem.byReuseLine(rs: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] =
  val Coll.Sorted(xs) = Coll.sortDedup(Mem.reuseKeys(rs, Coll.length(rs) + 1, 0, Coll.Nil))
  Mem.reuseVals(xs, Coll.Nil)

def Mem.reuseKeys(rs: Coll.List[Mem.Reuse], n: I64, i: I64, acc: Coll.List[Coll.KV[Mem.Reuse]]): Coll.List[Coll.KV[Mem.Reuse]] = rs match
  case Coll.Nil => acc
  case Coll.Cons(r, rest) =>
    val Mem.Reuse(line, _, _, _) = r
    Mem.reuseKeys(rest, n, i + 1, Coll.Cons(Coll.KV(line * n + i, r), acc))

def Mem.reuseVals(xs: Coll.List[Coll.KV[Mem.Reuse]], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(_, r) = kv
    Mem.reuseVals(rest, Coll.Cons(r, acc))

// a value of unknown origin (an op or extern result, a read xs(i) of a local array: the array keeps its element): its
// node, seeded shared for M7
def Mem.unknown(w: Mem.EW, n: Mem.Node): Mem.EV = Mem.EV(Mem.eFact(w, D.Fact(Mem.s7(Mem.RUnknown7), Mem.nVals(n, Coll.Nil))), Coll.Cons(n, Coll.Nil))

// the args a box holds: those of its fields whose type can hold a box (a scalar field holds a number, not a reference);
// (an Array.fill or Array.tabulate is no case: it holds every arg but its length)
def Mem.boxed(nss: Coll.List[Coll.List[Mem.Node]], fields: Coll.List[Ast.Binder], acc: Coll.List[Coll.List[Mem.Node]]): Coll.List[Coll.List[Mem.Node]] = nss match
  case Coll.Nil => acc
  case Coll.Cons(ns, rest) => fields match
    case Coll.Cons(fd, frest) =>
      val Ast.Binder(_, _, t) = fd
      Mem.boxed(rest, frest, if Mem.scalar(t) then acc else Coll.Cons(ns, acc))
    case Coll.Nil => Mem.boxed(rest, Coll.Nil, Coll.Cons(ns, acc))
