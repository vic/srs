// s2 MEM (vic-gux0, vic/c/mem-design.md): where a program allocates. A constructor call with fields, or Array.fill /
// Array.tabulate, is a site. A site fills the innermost Region handle around it in its def, else each Region its def
// runs under. A site is many when it can run twice in one life of its region: in a loop, or in a def that is many.
// Many is the safe answer (Birkedal, Tofte, Vejlstrup, POPL 1996, sec. 4: all multiplicities infinite is a solution),
// so once is what needs proof. A def with two call sites is many; the entry of a call cycle has two (one from outside),
// and the rest of the cycle is many through its caller. One Datalog program:
//   reached(G) :- reached(F), call(F, G)
//   run(G, R) :- callIn(R, G) | callFree(F, G), run(F, R)
//   fills(S, R) :- siteIn(S, R) | siteFree(S, F), run(F, R)
//   manyDef(G) :- multi(G) | loopCall(G) | callFree(F, G), manyDef(F)
//   live(R) :- regionIn(R, F), reached(F)
// Not seen yet: handler and given bodies, allocating externs ({r: Region} binders): a later rung.
enum Mem.Rel:
  case Mem.RCall
  case Mem.RCallIn
  case Mem.RCallFree
  case Mem.RSiteIn
  case Mem.RSiteFree
  case Mem.RMulti
  case Mem.RLoopCall
  case Mem.RRegionIn
  case Mem.RReached
  case Mem.RRun
  case Mem.RFills
  case Mem.RManyDef
  case Mem.RLive
  case Mem.RInside
  case Mem.RTop
  case Mem.ROutl
  case Mem.RCallAt
  case Mem.RCallFreeAt

// Mem.relSym is the only place a relation name is a string
def Mem.relSym(rel: Mem.Rel): Sym.Sym = rel match
  case Mem.RCall => Sym.of("call")
  case Mem.RCallIn => Sym.of("callIn")
  case Mem.RCallFree => Sym.of("callFree")
  case Mem.RSiteIn => Sym.of("siteIn")
  case Mem.RSiteFree => Sym.of("siteFree")
  case Mem.RMulti => Sym.of("multi")
  case Mem.RLoopCall => Sym.of("loopCall")
  case Mem.RRegionIn => Sym.of("regionIn")
  case Mem.RReached => Sym.of("reached")
  case Mem.RRun => Sym.of("run")
  case Mem.RFills => Sym.of("fills")
  case Mem.RManyDef => Sym.of("manyDef")
  case Mem.RLive => Sym.of("live")
  case Mem.RInside => Sym.of("inside")
  case Mem.RTop => Sym.of("top")
  case Mem.ROutl => Sym.of("outl")
  case Mem.RCallAt => Sym.of("callAt")
  case Mem.RCallFreeAt => Sym.of("callFreeAt")

def Mem.atom(rel: Mem.Rel, xs: Coll.List[I64]): D.Atom = D.Atom(Mem.relSym(rel), Pure.vars(xs))
def Mem.pos(rel: Mem.Rel, xs: Coll.List[I64]): D.Lit = D.Pos(Mem.atom(rel, xs))
def Mem.lits2(a: D.Lit, b: D.Lit): Coll.List[D.Lit] = Coll.Cons(a, Coll.Cons(b, Coll.Nil))
def Mem.lit1(a: D.Lit): Coll.List[D.Lit] = Coll.Cons(a, Coll.Nil)

def Mem.rules(): Coll.List[D.Rule] =
  val reach = D.Rule(Mem.atom(Mem.RReached, Pure.one(1)), Mem.lits2(Mem.pos(Mem.RReached, Pure.one(0)), Mem.pos(Mem.RCall, Pure.two(0, 1))))
  val run1 = D.Rule(Mem.atom(Mem.RRun, Pure.two(1, 0)), Mem.lit1(Mem.pos(Mem.RCallIn, Pure.two(0, 1))))
  val run2 = D.Rule(Mem.atom(Mem.RRun, Pure.two(1, 2)), Mem.lits2(Mem.pos(Mem.RCallFree, Pure.two(0, 1)), Mem.pos(Mem.RRun, Pure.two(0, 2))))
  val fill1 = D.Rule(Mem.atom(Mem.RFills, Pure.two(0, 1)), Mem.lit1(Mem.pos(Mem.RSiteIn, Pure.two(0, 1))))
  val fill2 = D.Rule(Mem.atom(Mem.RFills, Pure.two(0, 2)), Mem.lits2(Mem.pos(Mem.RSiteFree, Pure.two(0, 1)), Mem.pos(Mem.RRun, Pure.two(1, 2))))
  val m1 = D.Rule(Mem.atom(Mem.RManyDef, Pure.one(0)), Mem.lit1(Mem.pos(Mem.RMulti, Pure.one(0))))
  val m2 = D.Rule(Mem.atom(Mem.RManyDef, Pure.one(0)), Mem.lit1(Mem.pos(Mem.RLoopCall, Pure.one(0))))
  val m3 = D.Rule(Mem.atom(Mem.RManyDef, Pure.one(1)), Mem.lits2(Mem.pos(Mem.RCallFree, Pure.two(0, 1)), Mem.pos(Mem.RManyDef, Pure.one(0))))
  val live = D.Rule(Mem.atom(Mem.RLive, Pure.one(0)), Mem.lits2(Mem.pos(Mem.RRegionIn, Pure.two(0, 1)), Mem.pos(Mem.RReached, Pure.one(1))))
  // outl(R1, R2): R1 outlives R2: R2 is handled inside R1, or at the top of a def that runs in R1; and on through outl
  val o1 = D.Rule(Mem.atom(Mem.ROutl, Pure.two(0, 1)), Mem.lit1(Mem.pos(Mem.RInside, Pure.two(1, 0))))
  val o2 = D.Rule(Mem.atom(Mem.ROutl, Pure.two(0, 1)), Mem.lits2(Mem.pos(Mem.RTop, Pure.two(1, 2)), Mem.pos(Mem.RRun, Pure.two(2, 0))))
  val o3 = D.Rule(Mem.atom(Mem.ROutl, Pure.two(0, 2)), Mem.lits2(Mem.pos(Mem.ROutl, Pure.two(0, 1)), Mem.pos(Mem.ROutl, Pure.two(1, 2))))
  Coll.Cons(reach, Coll.Cons(run1, Coll.Cons(run2, Coll.Cons(fill1, Coll.Cons(fill2, Coll.Cons(m1, Coll.Cons(m2, Coll.Cons(m3, Coll.Cons(live, Coll.Cons(o1, Coll.Cons(o2, Coll.Cons(o3, Coll.Nil))))))))))))

def Mem.f1(rel: Mem.Rel, a: D.Val): D.Fact = D.Fact(Mem.relSym(rel), Coll.Cons(a, Coll.Nil))
def Mem.f2(rel: Mem.Rel, a: D.Val, b: D.Val): D.Fact = D.Fact(Mem.relSym(rel), Coll.Cons(a, Coll.Cons(b, Coll.Nil)))
def Mem.f3(rel: Mem.Rel, a: D.Val, b: D.Val, c: D.Val): D.Fact = D.Fact(Mem.relSym(rel), Coll.Cons(a, Coll.Cons(b, Coll.Cons(c, Coll.Nil))))

// a site: the def it is in, its line, the constructor (or Array.fill), and whether a loop of its own def holds it
enum Mem.Site:
  case Mem.Site(f: Sym.Sym, line: I64, ctor: Sym.Sym, loop: Bool)

// a Region handle: the def it is in, its line, its name and its handler
enum Mem.Region:
  case Mem.Region(f: Sym.Sym, line: I64, x: Sym.Sym, h: Sym.Sym, end: I64)

// what the walk knows of the program: defs by name, the constructors that allocate (a case with fields), the handlers
// whose protocol is Region
enum Mem.Cx:
  case Mem.Cx(fns: Coll.SMap[Ast.Fn], ctors: Coll.SMap[Coll.List[Ast.Binder]], regionHs: Coll.SMap[Bool], ss: Eff.Syms, bound: Coll.SMap[Coll.SMap[Mem.LV]], quiet: Coll.SMap[Bool])
// where a walk is: the def, the innermost Region handle of the def around it (an id), whether a loop holds it, and the
// handles in scope by name (a call that chooses one, f{r}(..), runs f in that region)
enum Mem.At:
  case Mem.At(f: Sym.Sym, reg: Coll.Option[I64], loop: Bool, scope: Coll.SMap[I64])

// the walk's result so far: sites and regions by id (ids count up from 0), facts, call sites per callee, free calls
enum Mem.W:
  case Mem.W(sites: Coll.IMap[Mem.Site], ns: I64, regions: Coll.IMap[Mem.Region], nr: I64, facts: Coll.List[D.Fact], calls: Coll.SMap[I64], free: Coll.List[Mem.Edge])

// a call that opens no region: f calls g in the region f runs in
enum Mem.Edge:
  case Mem.Edge(f: Sym.Sym, g: Sym.Sym)

def Mem.fact(w: Mem.W, x: D.Fact): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  Mem.W(ss, ns, rs, nr, Coll.Cons(x, fs), cs, fr)

def Mem.site(w: Mem.W, at: Mem.At, line: I64, ctor: Sym.Sym): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  val Mem.At(f, reg, loop, _) = at
  val x: D.Fact = reg match
    case Coll.Some(r) => Mem.f2(Mem.RSiteIn, D.VInt(ns), D.VInt(r))
    case Coll.None => Mem.f2(Mem.RSiteFree, D.VInt(ns), D.VSym(f))
  Mem.W(Coll.insert(ss, ns, Mem.Site(f, line, ctor, loop)), ns + 1, rs, nr, Coll.Cons(x, fs), cs, fr)

def Mem.count(cs: Coll.SMap[I64], g: Sym.Sym): I64 = Coll.sLookup(cs, g) match
  case Coll.Some(n) => n
  case Coll.None => 0

def Mem.call(w: Mem.W, at: Mem.At, line: I64, g: Sym.Sym): Mem.W = Mem.callN(w, at, line, g, 1)

// a call of g at another region of the same call site: no new site for the count
def Mem.callNoCount(w: Mem.W, at: Mem.At, line: I64, g: Sym.Sym): Mem.W = Mem.callN(w, at, line, g, 0)

// a call of g that adds k to its call-site count
def Mem.callN(w: Mem.W, at: Mem.At, line: I64, g: Sym.Sym, k: I64): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  val Mem.At(f, reg, loop, _) = at
  val c = Mem.f2(Mem.RCall, D.VSym(f), D.VSym(g))
  val fs2 = if loop then Coll.Cons(Mem.f1(Mem.RLoopCall, D.VSym(g)), Coll.Cons(c, fs)) else Coll.Cons(c, fs)
  val cs2 = Coll.sInsert(cs, g, Mem.count(cs, g) + k)
  reg match
    case Coll.Some(r) => Mem.W(ss, ns, rs, nr, Coll.Cons(Mem.f3(Mem.RCallAt, D.VSym(f), D.VInt(line), D.VInt(r)), Coll.Cons(Mem.f2(Mem.RCallIn, D.VInt(r), D.VSym(g)), fs2)), cs2, fr)
    case Coll.None => Mem.W(ss, ns, rs, nr, Coll.Cons(Mem.f2(Mem.RCallFreeAt, D.VSym(f), D.VInt(line)), Coll.Cons(Mem.f2(Mem.RCallFree, D.VSym(f), D.VSym(g)), fs2)), cs2, Coll.Cons(Mem.Edge(f, g), fr))

// a new Region handle in def f: its id is the next one; the rest of the block runs under it. It lives inside the
// innermost region handled around it in f (inside(R, outer)), else inside each region f runs in (top(R, f))
def Mem.region(w: Mem.W, f: Sym.Sym, line: I64, x: Sym.Sym, h: Sym.Sym, outer: Coll.Option[I64], end: I64): Mem.W =
  val Mem.W(ss, ns, rs, nr, fs, cs, fr) = w
  val nest: D.Fact = outer match
    case Coll.Some(o) => Mem.f2(Mem.RInside, D.VInt(nr), D.VInt(o))
    case Coll.None => Mem.f2(Mem.RTop, D.VInt(nr), D.VSym(f))
  Mem.W(ss, ns, Coll.insert(rs, nr, Mem.Region(f, line, x, h, end)), nr + 1, Coll.Cons(nest, Coll.Cons(Mem.f2(Mem.RRegionIn, D.VInt(nr), D.VSym(f)), fs)), cs, fr)

def Mem.nextRegion(w: Mem.W): I64 =
  val Mem.W(_, _, _, nr, _, _, _) = w
  nr

def Mem.isIn [V: Type] (m: Coll.SMap[V], s: Sym.Sym): Bool = Coll.sLookup(m, s) match
  case Coll.Some(_) => true
  case Coll.None => false

// at, in the region of each chosen evidence name: a handle in scope is its region (f{r}(..) runs f in r); any other
// name (an evidence param of this def) is a region this def runs in. Which of two chosen regions a box of f goes to is
// the type checker's (El), not this walk's: f runs in each of them (no region is missed); none chosen: at
def Mem.chosenAts(at: Mem.At, chosen: Coll.List[Sym.Sym], acc: Coll.List[Mem.At]): Coll.List[Mem.At] = chosen match
  case Coll.Nil => acc match
    case Coll.Nil => Coll.Cons(at, Coll.Nil)
    case Coll.Cons(_, _) => acc
  case Coll.Cons(x, rest) =>
    val Mem.At(f, _, loop, sc) = at
    val r: Coll.Option[I64] = Coll.sLookup(sc, x)
    r match
      case Coll.Some(id) => Mem.chosenAts(at, rest, Coll.Cons(Mem.At(f, Coll.Some(id), loop, sc), acc))
      case Coll.None => Mem.chosenAts(at, rest, Coll.Cons(Mem.At(f, Coll.None, loop, sc), acc))

// a call of f at each of ats (one call site: its count goes up once)
def Mem.callAll(w: Mem.W, ats: Coll.List[Mem.At], line: I64, f: Sym.Sym): Mem.W = ats match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => rest match
    case Coll.Nil => Mem.call(w, a, line, f)
    case Coll.Cons(_, _) => Mem.callAll(Mem.callNoCount(w, a, line, f), rest, line, f)

def Mem.expr(cx: Mem.Cx, at: Mem.At, w: Mem.W, e: Ast.Expr): Mem.W = e match
  case Ast.Call(line, f, _, chosen, args) =>
    val Mem.Cx(fns, ctors, _, ss, _, _) = cx
    val ats = Mem.chosenAts(at, chosen, Coll.Nil)
    val at2: Mem.At = ats match
      case Coll.Cons(a, _) => a
      case Coll.Nil => at
    val w2 = if Mem.allocates(ctors, f) || Eff.isArrayNew(ss, f) then Mem.site(w, at2, line, f) else if Mem.isIn(fns, f) then Mem.callAll(w, ats, line, f) else w
    Mem.exprs(cx, at, w2, args)
  case Ast.Method(_, _, _, args) => Mem.exprs(cx, at, w, args)
  case Ast.Resume(_, _, x) => Mem.expr(cx, at, w, x)
  case Ast.Bin(_, _, l, r) => Mem.expr(cx, at, Mem.expr(cx, at, w, l), r)
  case Ast.Un(_, _, x) => Mem.expr(cx, at, w, x)
  case Ast.If(_, c, t, x) => Mem.expr(cx, at, Mem.expr(cx, at, Mem.expr(cx, at, w, c), t), x)
  case Ast.Match(_, s, arms) => Mem.arms(cx, at, Mem.expr(cx, at, w, s), arms)
  case Ast.Block(_, stmts, last) => Mem.stmts(cx, at, w, stmts, last)
  case Ast.While(_, c, body) =>
    val Mem.At(f, reg, _, sc) = at
    val inLoop = Mem.At(f, reg, true, sc)
    Mem.expr(cx, inLoop, Mem.expr(cx, inLoop, w, c), body)
  case Ast.Assign(_, _, x) => Mem.expr(cx, at, w, x)
  case Ast.Quant(_, _, _, _, x) => Mem.expr(cx, at, w, x)
  case Ast.Int(_, _) => w
  case Ast.Bool(_, _) => w
  case Ast.Str(_, _) => w
  case Ast.Unit(_) => w
  case Ast.Name(_, _) => w

def Mem.exprs(cx: Mem.Cx, at: Mem.At, w: Mem.W, es: Coll.List[Ast.Expr]): Mem.W = es match
  case Coll.Nil => w
  case Coll.Cons(e, rest) => Mem.exprs(cx, at, Mem.expr(cx, at, w, e), rest)

def Mem.arms(cx: Mem.Cx, at: Mem.At, w: Mem.W, arms: Coll.List[Ast.Arm]): Mem.W = arms match
  case Coll.Nil => w
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, body) = a
    Mem.arms(cx, at, Mem.expr(cx, at, w, body), rest)

// a block: a handle of a Region handler opens a region over the rest of the block
def Mem.stmts(cx: Mem.Cx, at: Mem.At, w: Mem.W, ss: Coll.List[Ast.Stmt], last: Ast.Expr): Mem.W = ss match
  case Coll.Nil => Mem.expr(cx, at, w, last)
  case Coll.Cons(s, rest) => s match
    case Ast.Handle(line, x, h, args) =>
      val Mem.Cx(_, _, rhs, _, _, _) = cx
      val w2 = Mem.exprs(cx, at, w, args)
      val Mem.At(f, outer, loop, sc) = at
      if Mem.isIn(rhs, h) then Mem.stmts(cx, Mem.At(f, Coll.Some(Mem.nextRegion(w2)), loop, Coll.sInsert(sc, x, Mem.nextRegion(w2))), Mem.region(w2, f, line, x, h, outer, Mem.lastLine(last, Mem.lastStmts(rest, line))), rest, last)
      else Mem.stmts(cx, at, w2, rest, last)
    case Ast.Val(_, _, _, e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)
    case Ast.Var(_, _, _, e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)
    case Ast.Do(e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)
    case Ast.Check(_, _, e) => Mem.stmts(cx, at, Mem.expr(cx, at, w, e), rest, last)

def Mem.decls(cx: Mem.Cx, w: Mem.W, ds: Coll.List[Ast.Decl]): Mem.W = ds match
  case Coll.Nil => w
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) =>
      val Ast.Fn(_, n, _, _, _, _, body) = f
      val w2: Mem.W = body match
        case Ast.Def(_, e) => Mem.expr(cx, Mem.At(n, Coll.None, false, Coll.sEmpty()), w, e)
        case Ast.Extern(_) => w
      Mem.decls(cx, w2, rest)
    case _ => Mem.decls(cx, w, rest)

// every case and its fields (a case with none is a static: it allocates nothing); and the Region handlers
def Mem.ctors(ds: Coll.List[Ast.Decl], m: Coll.SMap[Coll.List[Ast.Binder]]): Coll.SMap[Coll.List[Ast.Binder]] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DEnum(e) =>
      val Ast.Enum(_, _, _, cases) = e
      Mem.ctors(rest, Mem.caseCtors(cases, m))
    case _ => Mem.ctors(rest, m)

def Mem.caseCtors(cs: Coll.List[Ast.Case], m: Coll.SMap[Coll.List[Ast.Binder]]): Coll.SMap[Coll.List[Ast.Binder]] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, fields) = c
    Mem.caseCtors(rest, Coll.sInsert(m, n, fields))

def Mem.regionHs(ds: Coll.List[Ast.Decl], m: Coll.SMap[Bool]): Coll.SMap[Bool] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DHandler(h) =>
      val Ast.Handler(_, n, p, _, _) = h
      Mem.regionHs(rest, if Sym.eq(p, Sym.of("Region")) then Coll.sInsert(m, n, true) else m)
    case _ => Mem.regionHs(rest, m)

def Mem.fnList(ds: Coll.List[Ast.Decl], acc: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) => Mem.fnList(rest, Coll.Cons(f, acc))
    case _ => Mem.fnList(rest, acc)

// multi(G) for a callee with two or more call sites
def Mem.multis(fns: Coll.List[Ast.Fn], cs: Coll.SMap[I64], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = fns match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, _, _, _, _) = f
    Mem.multis(rest, cs, if Mem.count(cs, n) >= 2 then Coll.Cons(Mem.f1(Mem.RMulti, D.VSym(n)), acc) else acc)

// ── the report: per live region (by line), its sites (by line) and their multiplicity ──
enum Mem.Why:
  case Mem.InLoop
  case Mem.Sites(f: Sym.Sym, n: I64)
  case Mem.LoopCalled(f: Sym.Sym)
  case Mem.Via(f: Sym.Sym)

enum Mem.Mult:
  case Mem.Once
  case Mem.Many(why: Mem.Why)

enum Mem.Row:
  case Mem.Row(line: I64, f: Sym.Sym, ctor: Sym.Sym, bytes: Coll.Option[I64], dies: Bool, m: Mem.Mult)

// a handled region: the def f that handles it at line as x with handler h, its sites, the defs whose sites fill it (in
// order of first site), and the lines of its manual frees (x.free()); the drop op frees it at the end of its block when
// it is still live
enum Mem.Block:
  case Mem.Block(id: I64, line: I64, f: Sym.Sym, x: Sym.Sym, h: Sym.Sym, rows: Coll.List[Mem.Row], defs: Coll.List[Sym.Sym], frees: Coll.List[I64], end: I64)

// a call x.free() in def f at line
enum Mem.FreeAt:
  case Mem.FreeAt(f: Sym.Sym, line: I64, x: Sym.Sym)

enum Mem.Report:
  case Mem.Ok(bs: Coll.List[Mem.Block], pf: Coll.List[Mem.FreeAt], vs: Coll.List[Mem.VarRec], ms: Coll.List[Mem.MoveRec], rs: Coll.List[Mem.ReuseRec], cs: Coll.List[Mem.Compact], bad: Coll.List[Mem.Fail], dead: Coll.IMap[I64])
  case Mem.RulesBad(rel: Sym.Sym)

// what the model says, by name or id
enum Mem.Model:
  case Mem.Model(manyDef: Coll.SMap[Bool], loopCall: Coll.SMap[Bool], byRegion: Coll.IMap[Coll.List[I64]], live: Coll.List[I64], bytes: Coll.IMap[Coll.List[Emit.SiteB]], esc: Coll.List[Mem.ESiteR])

// ── one name per binder (Polonius has one local per binding): a binder whose name its def already bound (a shadow, or
// the same name in a sibling scope) is renamed x#n (its nth binder in the def); each use takes the name of the binder
// in scope ──
// a walk's names: cur maps a source name to the name of the binder in scope (lexical), seen holds every name the def
// bound so far with its count (in walk order, across scopes)
enum Mem.Sc:
  case Mem.Sc(cur: Coll.SMap[Sym.Sym], seen: Coll.SMap[I64])

enum Mem.UsE:
  case Mem.UsE(e: Ast.Expr, seen: Coll.SMap[I64])

enum Mem.UsEs:
  case Mem.UsEs(es: Coll.List[Ast.Expr], seen: Coll.SMap[I64])

enum Mem.UsB:
  case Mem.UsB(ss: Coll.List[Ast.Stmt], last: Ast.Expr, seen: Coll.SMap[I64])

enum Mem.UsA:
  case Mem.UsA(arms: Coll.List[Ast.Arm], seen: Coll.SMap[I64])

// the name x bound at line takes: x the first time in its def, x@line after
enum Mem.Bound:
  case Mem.Bound(sc: Mem.Sc, x: Sym.Sym)

def Mem.bindName(sc: Mem.Sc, x: Sym.Sym): Mem.Bound =
  val Mem.Sc(cur, seen) = sc
  val n = Mem.count(seen, x)
  val y = if n > 0 then Mem.fresh(x, n + 1) else x
  Mem.Bound(Mem.Sc(Coll.sInsert(cur, x, y), Coll.sInsert(seen, x, n + 1)), y)

def Mem.fresh(x: Sym.Sym, n: I64): Sym.Sym =
  Console.captureBegin()
  Console.print(Sym.str(x))
  Console.print("#")
  Console.printI64(n)
  Sym.of(Console.captureEnd())

def Mem.nameIn(sc: Mem.Sc, x: Sym.Sym): Sym.Sym =
  val Mem.Sc(cur, _) = sc
  Coll.sLookup(cur, x) match
    case Coll.Some(y) => y
    case Coll.None => x

def Mem.namesIn(sc: Mem.Sc, xs: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = xs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(x, rest) => Coll.Cons(Mem.nameIn(sc, x), Mem.namesIn(sc, rest))

def Mem.withSeen(sc: Mem.Sc, seen: Coll.SMap[I64]): Mem.Sc =
  val Mem.Sc(cur, _) = sc
  Mem.Sc(cur, seen)

def Mem.seenOf(sc: Mem.Sc): Coll.SMap[I64] =
  val Mem.Sc(_, seen) = sc
  seen

def Mem.unshadow(ds: Coll.List[Ast.Decl], acc: Coll.List[Ast.Decl]): Coll.List[Ast.Decl] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) => Mem.unshadow(rest, Coll.Cons(Ast.DFn(Mem.usFn(f)), acc))
    case Ast.DHandler(h) =>
      val Ast.Handler(line, n, p, fs, shots) = h
      Mem.unshadow(rest, Coll.Cons(Ast.DHandler(Ast.Handler(line, n, p, Mem.usFns(fs), shots)), acc))
    case Ast.DGiven(g) =>
      val Ast.Given(line, gs, head, fs) = g
      Mem.unshadow(rest, Coll.Cons(Ast.DGiven(Ast.Given(line, gs, head, Mem.usFns(fs))), acc))
    case _ => Mem.unshadow(rest, Coll.Cons(d, acc))

def Mem.usFns(fs: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) => Coll.Cons(Mem.usFn(f), Mem.usFns(rest))

// params are bound first (distinct names: no rename), then the body
def Mem.usFn(f: Ast.Fn): Ast.Fn =
  val Ast.Fn(line, n, gs, ps, ret, exit, body) = f
  body match
    case Ast.Def(cs, e) =>
      val Mem.UsE(e2, _) = Mem.usx(Mem.usParams(ps, Mem.Sc(Coll.sEmpty(), Coll.sEmpty())), e)
      Ast.Fn(line, n, gs, ps, ret, exit, Ast.Def(cs, e2))
    case Ast.Extern(_) => f

def Mem.usParams(ps: Coll.List[Ast.Binder], sc: Mem.Sc): Mem.Sc = ps match
  case Coll.Nil => sc
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, _) = p
    val Mem.Bound(sc2, _) = Mem.bindName(sc, x)
    Mem.usParams(rest, sc2)

def Mem.usx(sc: Mem.Sc, e: Ast.Expr): Mem.UsE = e match
  case Ast.Name(line, x) => Mem.UsE(Ast.Name(line, Mem.nameIn(sc, x)), Mem.seenOf(sc))
  case Ast.Call(line, g, ts, ch, args) =>
    val Mem.UsEs(as, s) = Mem.usxs(sc, args)
    Mem.UsE(Ast.Call(line, g, ts, Mem.namesIn(sc, ch), as), s)
  case Ast.Method(line, r, op, args) =>
    val Mem.UsEs(as, s) = Mem.usxs(sc, args)
    Mem.UsE(Ast.Method(line, Mem.nameIn(sc, r), op, as), s)
  case Ast.Resume(line, k, x) =>
    val Mem.UsE(x2, s) = Mem.usx(sc, x)
    Mem.UsE(Ast.Resume(line, k, x2), s)
  case Ast.Bin(line, op, l, r) =>
    val Mem.UsE(l2, s1) = Mem.usx(sc, l)
    val Mem.UsE(r2, s2) = Mem.usx(Mem.withSeen(sc, s1), r)
    Mem.UsE(Ast.Bin(line, op, l2, r2), s2)
  case Ast.Un(line, op, x) =>
    val Mem.UsE(x2, s) = Mem.usx(sc, x)
    Mem.UsE(Ast.Un(line, op, x2), s)
  case Ast.If(line, c, t, x) =>
    val Mem.UsE(c2, s1) = Mem.usx(sc, c)
    val Mem.UsE(t2, s2) = Mem.usx(Mem.withSeen(sc, s1), t)
    val Mem.UsE(x2, s3) = Mem.usx(Mem.withSeen(sc, s2), x)
    Mem.UsE(Ast.If(line, c2, t2, x2), s3)
  case Ast.Match(line, s, arms) =>
    val Mem.UsE(s2, k1) = Mem.usx(sc, s)
    val Mem.UsA(as, k2) = Mem.usArms(Mem.withSeen(sc, k1), arms, Coll.Nil)
    Mem.UsE(Ast.Match(line, s2, as), k2)
  case Ast.Block(line, ss, last) =>
    val Mem.UsB(ss2, last2, k) = Mem.usStmts(sc, ss, last, Coll.Nil)
    Mem.UsE(Ast.Block(line, ss2, last2), k)
  case Ast.While(line, c, b) =>
    val Mem.UsE(c2, s1) = Mem.usx(sc, c)
    val Mem.UsE(b2, s2) = Mem.usx(Mem.withSeen(sc, s1), b)
    Mem.UsE(Ast.While(line, c2, b2), s2)
  case Ast.Assign(line, x, v) =>
    val Mem.UsE(v2, s) = Mem.usx(sc, v)
    Mem.UsE(Ast.Assign(line, Mem.nameIn(sc, x), v2), s)
  case Ast.Quant(line, q, x, t, body) =>
    val Mem.Bound(sc2, y) = Mem.bindName(sc, x)
    val Mem.UsE(b2, s) = Mem.usx(sc2, body)
    Mem.UsE(Ast.Quant(line, q, y, t, b2), s)
  case _ => Mem.UsE(e, Mem.seenOf(sc))

def Mem.usxs(sc: Mem.Sc, es: Coll.List[Ast.Expr]): Mem.UsEs = es match
  case Coll.Nil => Mem.UsEs(Coll.Nil, Mem.seenOf(sc))
  case Coll.Cons(e, rest) =>
    val Mem.UsE(e2, s1) = Mem.usx(sc, e)
    val Mem.UsEs(rest2, s2) = Mem.usxs(Mem.withSeen(sc, s1), rest)
    Mem.UsEs(Coll.Cons(e2, rest2), s2)

// each arm binds its pattern vars for its body only
def Mem.usArms(sc: Mem.Sc, arms: Coll.List[Ast.Arm], acc: Coll.List[Ast.Arm]): Mem.UsA = arms match
  case Coll.Nil => Mem.UsA(Coll.rev(acc), Mem.seenOf(sc))
  case Coll.Cons(a, rest) =>
    val Ast.Arm(line, p, b) = a
    p match
      case Ast.PCase(c, xs) =>
        val Mem.BoundAll(sc2, ys) = Mem.bindAll(sc, xs, Coll.Nil)
        val Mem.UsE(b2, s) = Mem.usx(sc2, b)
        Mem.usArms(Mem.withSeen(sc, s), rest, Coll.Cons(Ast.Arm(line, Ast.PCase(c, ys), b2), acc))
      case Ast.PAny =>
        val Mem.UsE(b2, s) = Mem.usx(sc, b)
        Mem.usArms(Mem.withSeen(sc, s), rest, Coll.Cons(Ast.Arm(line, p, b2), acc))

enum Mem.BoundAll:
  case Mem.BoundAll(sc: Mem.Sc, xs: Coll.List[Sym.Sym])

def Mem.bindAll(sc: Mem.Sc, xs: Coll.List[Sym.Sym], acc: Coll.List[Sym.Sym]): Mem.BoundAll = xs match
  case Coll.Nil => Mem.BoundAll(sc, Coll.rev(acc))
  case Coll.Cons(x, rest) =>
    val Mem.Bound(sc2, y) = Mem.bindName(sc, x)
    Mem.bindAll(sc2, rest, Coll.Cons(y, acc))

// a val, var or handle binds its name for the rest of the block (its own expression sees the outer binder)
def Mem.usStmts(sc: Mem.Sc, ss: Coll.List[Ast.Stmt], last: Ast.Expr, acc: Coll.List[Ast.Stmt]): Mem.UsB = ss match
  case Coll.Nil =>
    val Mem.UsE(last2, s) = Mem.usx(sc, last)
    Mem.UsB(Coll.rev(acc), last2, s)
  case Coll.Cons(st, rest) => st match
    case Ast.Val(line, x, ann, e) =>
      val Mem.UsE(e2, s) = Mem.usx(sc, e)
      val Mem.Bound(sc2, y) = Mem.bindName(Mem.withSeen(sc, s), x)
      Mem.usStmts(sc2, rest, last, Coll.Cons(Ast.Val(line, y, ann, e2), acc))
    case Ast.Var(line, x, ann, e) =>
      val Mem.UsE(e2, s) = Mem.usx(sc, e)
      val Mem.Bound(sc2, y) = Mem.bindName(Mem.withSeen(sc, s), x)
      Mem.usStmts(sc2, rest, last, Coll.Cons(Ast.Var(line, y, ann, e2), acc))
    case Ast.Handle(line, x, h, args) =>
      val Mem.UsEs(as, s) = Mem.usxs(sc, args)
      val Mem.Bound(sc2, y) = Mem.bindName(Mem.withSeen(sc, s), x)
      Mem.usStmts(sc2, rest, last, Coll.Cons(Ast.Handle(line, y, h, as), acc))
    case Ast.Do(e) =>
      val Mem.UsE(e2, s) = Mem.usx(sc, e)
      Mem.usStmts(Mem.withSeen(sc, s), rest, last, Coll.Cons(Ast.Do(e2), acc))
    case Ast.Check(line, k, e) =>
      val Mem.UsE(e2, s) = Mem.usx(sc, e)
      Mem.usStmts(Mem.withSeen(sc, s), rest, last, Coll.Cons(Ast.Check(line, k, e2), acc))

// what a report computes: Full (--mem: every relation, the T4 liveness and moves too) or ForEmit (the optimized C: what
// codegen reads; liveness costs about 1.6x the analysis and no codegen reads it yet)
enum Mem.Need:
  case Mem.Full
  case Mem.ForEmit

def Mem.report(ds0: Coll.List[Ast.Decl], sb: Coll.List[Emit.SiteB], need: Mem.Need): Mem.Report =
  val ds = Mem.unshadow(ds0, Coll.Nil)
  val fl = Mem.fnList(ds, Coll.Nil)
  val dfs = Mem.dispatchFns(ds, Coll.Nil)
  // the names each def binds (params, val, var, pattern, handle): only these are var nodes; a name no binder gives is a
  // nullary case, a global or an effect op, and holds no box of a handled region
  val bound = Mem.liveFns(Coll.revOnto(dfs, fl), Coll.sEmpty())
  val cx = Mem.Cx(Ty.idxFns(fl, Coll.sEmpty()), Mem.ctors(ds, Coll.sEmpty()), Mem.regionHs(ds, Coll.sEmpty()), Eff.syms(), bound, Mem.quietPs(ds, Coll.sEmpty()))
  val w = Mem.decls(cx, Mem.W(Coll.Tip, 0, Coll.Tip, 0, Coll.Nil, Coll.sEmpty(), Coll.Nil), ds)
  val Mem.W(sites, ns, regions, nr, fs, cs, free) = w
  val facts = Coll.Cons(Mem.f1(Mem.RReached, D.VSym(Sym.of("main"))), Mem.multis(fl, cs, fs))
  // one walk, one intern and one solve serve every analysis: their relations have distinct names. The walk takes the
  // handler and given fns too (dispatch calls them: their params are seeded shared); a def's escape is its own
  val Mem.EW(efs, _, esites) = Mem.eDecls(cx, Mem.EW(Coll.Nil, 0, Coll.Nil), Coll.revOnto(Mem.asDecls(dfs, Coll.Nil), ds))
  val it = Mem.interned(Coll.revOnto(Mem.fnSeeds(bound, dfs, true, Mem.fnSeeds(bound, fl, false, Coll.Nil)), efs))
  val all0 = Coll.revOnto(facts, Coll.revOnto(Mem.factsOf(it), Mem.siteFacts(Mem.siteList(sites, 0, ns, Coll.Nil), Mem.sFacts(fs, Coll.Nil))))
  val byDef = Mem.sitesByDef(sites, 0, ns, Coll.sEmpty())
  val all1 = Mem.callFacts(fs, it, Mem.esmFacts(esites, byDef, all0))
  val Mem.IT(itDefs, _, _, _, _) = it
  val ps0 = Mem.PS(0, Coll.Nil, Coll.Tip)
  val Mem.PS(_, pfacts, pat) = need match
    case Mem.Full => Mem.pFns(Coll.revOnto(dfs, fl), itDefs, ps0)
    case Mem.ForEmit => ps0
  val all = Coll.revOnto(pfacts, all1)
  val prs: Coll.List[D.Rule] = need match
    case Mem.Full => Mem.pRules()
    case Mem.ForEmit => Coll.Nil
  D.solve(Coll.revOnto(Coll.rev(prs), Coll.revOnto(Coll.rev(Mem.rules()), Coll.revOnto(Coll.rev(Mem.eRules()), Coll.revOnto(Coll.rev(Mem.sharedRules()), Coll.revOnto(Coll.rev(Mem.rinRules()), Coll.revOnto(Coll.rev(Mem.moveRules()), Coll.revOnto(Coll.rev(Mem.failRules()), Mem.sRules()))))))), all) match
    case D.Solved(m) =>
      val mvd = Mem.movedBy(D.tuples(m, Mem.pSym(Mem.PMoved)), pat, Coll.sEmpty())
      val esc = Mem.marks(esites, Mem.idSet(D.tuples(m, Mem.eSym(Mem.EEsc)), Coll.Tip), true, Coll.Nil)
      val md = Mem.Model(Mem.names(D.tuples(m, Mem.relSym(Mem.RManyDef)), Coll.sEmpty()), Mem.names(D.tuples(m, Mem.relSym(Mem.RLoopCall)), Coll.sEmpty()), Mem.group(D.tuples(m, Mem.relSym(Mem.RFills)), Coll.Tip), Mem.ints(D.tuples(m, Mem.relSym(Mem.RLive)), Coll.Nil), Mem.siteMap(sb, Coll.Tip), esc)
      val reuse = Mem.scanFns(Mem.caseEnums(ds, Coll.sEmpty()), cx, Mem.sharedSet(Mem.varMap(it), D.tuples(m, Mem.s7(Mem.RShared7)), Coll.sEmpty()), fl, Coll.Nil)
      val need = Mem.names(D.tuples(m, Mem.sSym(Mem.SNeed)), Coll.sEmpty())
      val skip = Mem.names(D.tuples(m, Mem.sSym(Mem.SRunSink)), Mem.names(D.tuples(m, Mem.sSym(Mem.SSelf)), Mem.regionDefs(regions, 0, nr, Coll.sEmpty())))
      val compact = Mem.pickCompacts(need, skip, Mem.names(D.tuples(m, Mem.sSym(Mem.SNewRet)), Coll.sEmpty()), Mem.names(D.tuples(m, Mem.relSym(Mem.RManyDef)), Coll.sEmpty()), fl, Coll.Nil)
      val mf = Mem.manualFrees(fl, Coll.Nil)
      val bs = Mem.blocks(md, cs, free, Mem.NoIndex, sites, ns, regions, mf, Mem.byLine(Mem.regionKeys(regions, nr, Mem.liveOf(md), Coll.Nil)), Coll.Nil)
      val Mem.IT(defs, next, vars, _, mvs) = it
      val sm = Mem.Sh7(Mem.idSet(D.tuples(m, Mem.s7(Mem.RMulti7)), Coll.Tip), Mem.idSet(D.tuples(m, Mem.s7(Mem.RUnknown7)), Coll.Tip), Mem.idSet(D.tuples(m, Mem.s7(Mem.RShared7)), Coll.Tip))
      val rin = Mem.groupN(D.tuples(m, Mem.eSym(Mem.ERin)), Coll.Tip)
      val Mem.Unnoded(_, extra) = Mem.unnoded(Coll.sEntries(bound, Coll.Nil), defs, Mem.Unnoded(next, Coll.Nil))
      val vrs = Mem.withMoved(Coll.revOnto(Coll.rev(Mem.varRecs(vars, rin, sm, bound, Coll.Nil)), Coll.rev(extra)), mvd, Coll.Nil)
      val Mem.Sh7(_, _, shared) = sm
      val mv0 = Mem.movesOf(D.tuples(m, Mem.eSym(Mem.EMRes)), Mem.MResult, Mem.movesOf(D.tuples(m, Mem.eSym(Mem.EMArg)), Mem.MArg, Coll.Nil))
      val outl = Mem.groupN(D.tuples(m, Mem.relSym(Mem.ROutl)), Coll.Tip)
      val mrs = Mem.moveRecs(Coll.revOnto(mv0, mvs), rin, Mem.groupN(D.tuples(m, Mem.eSym(Mem.EOwn)), Coll.Tip), shared, outl, Coll.Nil)
      Mem.Ok(bs, Mem.paramFrees(mf, bs, Coll.Nil), vrs, mrs, Mem.reuseRecs(Mem.byReuseLine(reuse), Mem.RegionsOf(defs, rin, Mem.groupN(D.tuples(m, Mem.relSym(Mem.RFills)), Coll.Tip), byDef, outl), Coll.Nil), Mem.reachedOnly(compact, Mem.names(D.tuples(m, Mem.relSym(Mem.RReached)), Coll.sEmpty()), Coll.Nil), Coll.revOnto(Mem.uafFails(bs, Mem.varsByDef(vrs, Coll.sEmpty()), Coll.Nil), Mem.noRegionFails(Coll.rev(esites), Mem.idSet(D.tuples(m, Mem.eSym(Mem.ENoRegion)), Coll.Tip), Coll.Nil)), Mem.deadLines(bs, Mem.varsByDef(vrs, Coll.sEmpty()), fs, Coll.Tip))
    case D.Unsafe(rel) => Mem.RulesBad(rel)
    case D.NegCycle(rel) => Mem.RulesBad(rel)

// why a var node is shared: read twice on one run, no known origin, or reached from a shared node (flow, arg, result)
enum Mem.Why7:
  case Mem.NotShared
  case Mem.ByMulti
  case Mem.ByUnknown
  case Mem.ByFlow

// a var node: its id, def and name, the regions whose boxes it can hold (rin), why it is shared, and its lines: where it
// is bound (0 when unknown: a name no binder of its def gives) and every line that reads it, newest first
enum Mem.VarRec:
  case Mem.VarRec(id: I64, f: Sym.Sym, x: Sym.Sym, regions: Coll.List[I64], why: Mem.Why7, lv: Mem.LV, moved: Coll.List[I64])

// a move's region safety: a move that stores no box (bind, assign, pattern, ret, arg, result: the target names the same
// box); a field move whose every source region outlives (or is) every region of the new box; else the first pair that
// fails: a box of region from stored into a box of the shorter-lived region into
enum Mem.Safe:
  case Mem.NoStore
  case Mem.Outlives
  case Mem.Shorter(from: I64, into: I64)

// a move, whether its source is unshared (the value moves, no other reference reads it), the regions of both ends, and
// its safety
enum Mem.MoveRec:
  case Mem.MoveRec(m: Mem.Move, unique: Bool, from: Coll.List[I64], to: Coll.List[I64], safe: Mem.Safe)

def Mem.moveRecs(ms: Coll.List[Mem.Move], rin: Coll.IMap[Coll.List[I64]], own: Coll.IMap[Coll.List[I64]], shared: Coll.IMap[Bool], outl: Coll.IMap[Coll.List[I64]], acc: Coll.List[Mem.MoveRec]): Coll.List[Mem.MoveRec] = ms match
  case Coll.Nil => acc
  case Coll.Cons(m, rest) =>
    val Mem.Move(k, _, a, b) = m
    val ra = Mem.idsOf(rin, a)
    // a field move's target is the new box: its own region, not the regions of the boxes it holds
    val rb: Coll.List[I64] = k match
      case Mem.MField => Mem.idsOf(own, b)
      case _ => Mem.idsOf(rin, b)
    val safe: Mem.Safe = k match
      case Mem.MField => Mem.safeAll(ra, rb, outl)
      case _ => Mem.NoStore
    Mem.moveRecs(rest, rin, own, shared, outl, Coll.Cons(Mem.MoveRec(m, !Mem.hasId(shared, a), ra, rb, safe), acc))

// every region of xs outlives (or is) every region of ys
def Mem.safeAll(xs: Coll.List[I64], ys: Coll.List[I64], outl: Coll.IMap[Coll.List[I64]]): Mem.Safe = xs match
  case Coll.Nil => Mem.Outlives
  case Coll.Cons(x, rest) => Mem.safeEach(x, ys, rest, ys, outl)

def Mem.safeEach(x: I64, ys: Coll.List[I64], rest: Coll.List[I64], all: Coll.List[I64], outl: Coll.IMap[Coll.List[I64]]): Mem.Safe = ys match
  case Coll.Nil => Mem.safeAll(rest, all, outl)
  case Coll.Cons(y, more) =>
    if x == y || Mem.inList(y, Mem.idsOf(outl, x)) then Mem.safeEach(x, more, rest, all, outl) else Mem.Shorter(x, y)

def Mem.inList(y: I64, xs: Coll.List[I64]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(x, rest) => if x == y then true else Mem.inList(y, rest)

// the var nodes in id order (vars is newest first)
def Mem.varRecs(vars: Coll.List[Coll.KV[Mem.VarOf]], rin: Coll.IMap[Coll.List[I64]], sm: Mem.Sh7, lv: Coll.SMap[Coll.SMap[Mem.LV]], acc: Coll.List[Mem.VarRec]): Coll.List[Mem.VarRec] = vars match
  case Coll.Nil => acc
  case Coll.Cons(kv, rest) =>
    val Coll.KV(i, vo) = kv
    val Mem.VarOf(f, x) = vo
    Mem.varRecs(rest, rin, sm, lv, Coll.Cons(Mem.VarRec(i, f, x, Mem.idsOf(rin, i), Mem.whyOf(sm, i), Mem.lvOf(lv, f, x), Coll.Nil), acc))

// the binders no fact names (no node: a scalar read only by ops), ids from i on, newest first onto acc: every binder
// gets a record (Polonius var_defined_at / var_used_at)
enum Mem.Unnoded:
  case Mem.Unnoded(i: I64, acc: Coll.List[Mem.VarRec])

def Mem.unnoded(fs: Coll.List[Coll.SEntry[Coll.SMap[Mem.LV]]], defs: Coll.SMap[Mem.DefIds], u: Mem.Unnoded): Mem.Unnoded = fs match
  case Coll.Nil => u
  case Coll.Cons(e, rest) =>
    val Coll.SEntry(f, m) = e
    val names: Coll.SMap[I64] = Coll.sLookup(defs, f) match
      case Coll.Some(d) =>
        val Mem.DefIds(ns, _) = d
        ns
      case Coll.None => Coll.sEmpty()
    Mem.unnoded(rest, defs, Mem.unnodedIn(f, Coll.sEntries(m, Coll.Nil), names, u))

def Mem.unnodedIn(f: Sym.Sym, xs: Coll.List[Coll.SEntry[Mem.LV]], names: Coll.SMap[I64], u: Mem.Unnoded): Mem.Unnoded = xs match
  case Coll.Nil => u
  case Coll.Cons(e, rest) =>
    val Coll.SEntry(x, lv) = e
    val Mem.Unnoded(i, acc) = u
    val Mem.LV(_, _, n, _, k) = lv
    // n = 0: a name read but not bound in f (a nullary case such as Coll.Nil), no var
    val u2: Mem.Unnoded = Coll.sLookup(names, x) match
      case Coll.Some(_) => u
      case Coll.None => k match
        case Mem.BCap => u
        case Mem.BVal => if n == 0 then u else Mem.Unnoded(i + 1, Coll.Cons(Mem.VarRec(i, f, x, Coll.Nil, Mem.NotShared, lv, Coll.Nil), acc))
    Mem.unnodedIn(f, rest, names, u2)

// and each line that reads it, newest first. A read inside a while counts at the loop's last line: the loop runs again.
// binds: how many binders give the name in the def (shadowing: more than one, and their lines merge); assigned: an
// assignment changes its boxes at a point; k: a value or a handle's capability
enum Mem.LV:
  case Mem.LV(defAt: I64, uses: Coll.List[I64], binds: I64, assigned: Bool, k: Mem.BindK)

// what a binder names: a value (a param, val, var or pattern) or a capability (a handle: a region is in regions, not vars)
enum Mem.BindK:
  case Mem.BVal
  case Mem.BCap

// def f binds x (a param, val, var, pattern or handle)
def Mem.binds(lv: Coll.SMap[Coll.SMap[Mem.LV]], f: Sym.Sym, x: Sym.Sym): Bool =
  val Mem.LV(_, _, n, _, _) = Mem.lvOf(lv, f, x)
  n > 0

def Mem.lvOf(lv: Coll.SMap[Coll.SMap[Mem.LV]], f: Sym.Sym, x: Sym.Sym): Mem.LV = Coll.sLookup(lv, f) match
  case Coll.Some(m) => Mem.lvIn(m, x)
  case Coll.None => Mem.LV(0, Coll.Nil, 0, false, Mem.BVal)

def Mem.lvIn(m: Coll.SMap[Mem.LV], x: Sym.Sym): Mem.LV = Coll.sLookup(m, x) match
  case Coll.Some(v) => v
  case Coll.None => Mem.LV(0, Coll.Nil, 0, false, Mem.BVal)

// the largest line of a list (0 when empty)
def Mem.maxOf(xs: Coll.List[I64], m: I64): I64 = xs match
  case Coll.Nil => m
  case Coll.Cons(x, rest) => Mem.maxOf(rest, if x > m then x else m)

// each fn's names: params bound at the fn's line, then its body
def Mem.liveFns(fs: Coll.List[Ast.Fn], acc: Coll.SMap[Coll.SMap[Mem.LV]]): Coll.SMap[Coll.SMap[Mem.LV]] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(line, n, _, ps, _, _, body) = f
    val m0: Coll.SMap[Mem.LV] = Coll.sLookup(acc, n) match
      case Coll.Some(m) => m
      case Coll.None => Coll.sEmpty()
    val m1 = Mem.lvParams(ps, line, m0)
    val m2: Coll.SMap[Mem.LV] = body match
      case Ast.Def(_, e) => Mem.lvx(e, 0, m1)
      case Ast.Extern(_) => m1
    Mem.liveFns(rest, Coll.sInsert(acc, n, m2))

def Mem.lvParams(ps: Coll.List[Ast.Binder], line: I64, m: Coll.SMap[Mem.LV]): Coll.SMap[Mem.LV] = ps match
  case Coll.Nil => m
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, _) = p
    Mem.lvParams(rest, line, Mem.lvBind(m, x, line, Mem.BVal))

def Mem.lvBind(m: Coll.SMap[Mem.LV], x: Sym.Sym, line: I64, k: Mem.BindK): Coll.SMap[Mem.LV] =
  val Mem.LV(_, us, n, a, _) = Mem.lvIn(m, x)
  Coll.sInsert(m, x, Mem.LV(line, us, n + 1, a, k))

// x is assigned in its def (its boxes change at a point: the analysis has no kill, so it claims nothing after a free)
def Mem.lvAssign(m: Coll.SMap[Mem.LV], x: Sym.Sym): Coll.SMap[Mem.LV] =
  val Mem.LV(d, us, n, _, k) = Mem.lvIn(m, x)
  Coll.sInsert(m, x, Mem.LV(d, us, n, true, k))

// a read of x at line, or at floor when a loop around it ends later
def Mem.lvUse(m: Coll.SMap[Mem.LV], x: Sym.Sym, line: I64, floor: I64): Coll.SMap[Mem.LV] =
  val Mem.LV(d, us, n, a, k) = Mem.lvIn(m, x)
  Coll.sInsert(m, x, Mem.LV(d, Coll.Cons(if line > floor then line else floor, us), n, a, k))

def Mem.lvx(e: Ast.Expr, floor: I64, m: Coll.SMap[Mem.LV]): Coll.SMap[Mem.LV] = e match
  case Ast.Name(line, x) => Mem.lvUse(m, x, line, floor)
  // a call of a name the def binds reads it (xs(i): an array read)
  case Ast.Call(line, g, _, _, args) =>
    val Mem.LV(_, _, n, _, _) = Mem.lvIn(m, g)
    Mem.lvxs(args, floor, if n > 0 then Mem.lvUse(m, g, line, floor) else m)
  case Ast.Method(_, _, _, args) => Mem.lvxs(args, floor, m)
  case Ast.Resume(_, _, x) => Mem.lvx(x, floor, m)
  case Ast.Bin(_, _, l, r) => Mem.lvx(r, floor, Mem.lvx(l, floor, m))
  case Ast.Un(_, _, x) => Mem.lvx(x, floor, m)
  case Ast.If(_, c, t, x) => Mem.lvxs(Coll.Cons(c, Coll.Cons(t, Coll.Cons(x, Coll.Nil))), floor, m)
  case Ast.Match(_, s, arms) => Mem.lvArms(arms, floor, Mem.lvx(s, floor, m))
  case Ast.Block(_, ss, last) => Mem.lvx(last, floor, Mem.lvStmts(ss, floor, m))
  case Ast.While(_, c, b) =>
    val end = Mem.lastLine(b, Mem.lastLine(c, floor))
    Mem.lvx(b, end, Mem.lvx(c, end, m))
  case Ast.Assign(_, x, v) => Mem.lvx(v, floor, Mem.lvAssign(m, x))
  case _ => m

def Mem.lvxs(es: Coll.List[Ast.Expr], floor: I64, m: Coll.SMap[Mem.LV]): Coll.SMap[Mem.LV] = es match
  case Coll.Nil => m
  case Coll.Cons(e, rest) => Mem.lvxs(rest, floor, Mem.lvx(e, floor, m))

def Mem.lvArms(arms: Coll.List[Ast.Arm], floor: I64, m: Coll.SMap[Mem.LV]): Coll.SMap[Mem.LV] = arms match
  case Coll.Nil => m
  case Coll.Cons(a, rest) =>
    val Ast.Arm(line, p, b) = a
    val m2: Coll.SMap[Mem.LV] = p match
      case Ast.PCase(_, xs) => Mem.lvBinds(xs, line, m)
      case Ast.PAny => m
    Mem.lvArms(rest, floor, Mem.lvx(b, floor, m2))

def Mem.lvBinds(xs: Coll.List[Sym.Sym], line: I64, m: Coll.SMap[Mem.LV]): Coll.SMap[Mem.LV] = xs match
  case Coll.Nil => m
  case Coll.Cons(x, rest) => Mem.lvBinds(rest, line, Mem.lvBind(m, x, line, Mem.BVal))

def Mem.lvStmts(ss: Coll.List[Ast.Stmt], floor: I64, m: Coll.SMap[Mem.LV]): Coll.SMap[Mem.LV] = ss match
  case Coll.Nil => m
  case Coll.Cons(s, rest) => s match
    case Ast.Val(line, x, _, e) => Mem.lvStmts(rest, floor, Mem.lvBind(Mem.lvx(e, floor, m), x, line, Mem.BVal))
    case Ast.Var(line, x, _, e) => Mem.lvStmts(rest, floor, Mem.lvBind(Mem.lvx(e, floor, m), x, line, Mem.BVal))
    case Ast.Handle(line, x, _, args) => Mem.lvStmts(rest, floor, Mem.lvBind(Mem.lvxs(args, floor, m), x, line, Mem.BCap))
    case Ast.Do(e) => Mem.lvStmts(rest, floor, Mem.lvx(e, floor, m))
    case Ast.Check(_, _, e) => Mem.lvStmts(rest, floor, Mem.lvx(e, floor, m))

// the last line an expression spans (at least floor): the largest line of its parts
def Mem.lastLine(e: Ast.Expr, floor: I64): I64 = e match
  case Ast.Name(line, _) => if line > floor then line else floor
  case Ast.Int(line, _) => if line > floor then line else floor
  case Ast.Call(line, _, _, _, args) => Mem.lastLines(args, if line > floor then line else floor)
  case Ast.Method(line, _, _, args) => Mem.lastLines(args, if line > floor then line else floor)
  case Ast.Resume(_, _, x) => Mem.lastLine(x, floor)
  case Ast.Bin(_, _, l, r) => Mem.lastLine(r, Mem.lastLine(l, floor))
  case Ast.Un(_, _, x) => Mem.lastLine(x, floor)
  case Ast.If(_, c, t, x) => Mem.lastLines(Coll.Cons(c, Coll.Cons(t, Coll.Cons(x, Coll.Nil))), floor)
  case Ast.Match(_, s, arms) => Mem.lastArms(arms, Mem.lastLine(s, floor))
  case Ast.Block(_, ss, last) => Mem.lastLine(last, Mem.lastStmts(ss, floor))
  case Ast.While(_, c, b) => Mem.lastLine(b, Mem.lastLine(c, floor))
  case Ast.Assign(line, _, x) => Mem.lastLine(x, if line > floor then line else floor)
  case _ => floor

def Mem.lastLines(es: Coll.List[Ast.Expr], floor: I64): I64 = es match
  case Coll.Nil => floor
  case Coll.Cons(e, rest) => Mem.lastLines(rest, Mem.lastLine(e, floor))

def Mem.lastArms(arms: Coll.List[Ast.Arm], floor: I64): I64 = arms match
  case Coll.Nil => floor
  case Coll.Cons(a, rest) =>
    val Ast.Arm(line, _, b) = a
    Mem.lastArms(rest, Mem.lastLine(b, if line > floor then line else floor))

def Mem.lastStmts(ss: Coll.List[Ast.Stmt], floor: I64): I64 = ss match
  case Coll.Nil => floor
  case Coll.Cons(s, rest) => s match
    case Ast.Val(line, _, _, e) => Mem.lastStmts(rest, Mem.lastLine(e, if line > floor then line else floor))
    case Ast.Var(line, _, _, e) => Mem.lastStmts(rest, Mem.lastLine(e, if line > floor then line else floor))
    case Ast.Handle(line, _, _, args) => Mem.lastStmts(rest, Mem.lastLines(args, if line > floor then line else floor))
    case Ast.Do(e) => Mem.lastStmts(rest, Mem.lastLine(e, floor))
    case Ast.Check(_, _, e) => Mem.lastStmts(rest, Mem.lastLine(e, floor))

// the node sets of the sharing relations
enum Mem.Sh7:
  case Mem.Sh7(multi: Coll.IMap[Bool], unknown: Coll.IMap[Bool], shared: Coll.IMap[Bool])

def Mem.whyOf(sm: Mem.Sh7, i: I64): Mem.Why7 =
  val Mem.Sh7(multi, unknown, shared) = sm
  if Mem.hasId(multi, i) then Mem.ByMulti
  else if Mem.hasId(unknown, i) then Mem.ByUnknown
  else if Mem.hasId(shared, i) then Mem.ByFlow
  else Mem.NotShared

def Mem.hasId(m: Coll.IMap[Bool], i: I64): Bool = Coll.lookup(m, i) match
  case Coll.Some(_) => true
  case Coll.None => false

// the second column of each (I64, I64) tuple, under its first
def Mem.groupN(ts: Coll.List[Coll.List[D.Val]], m: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(a, tl) => tl match
      case Coll.Cons(b, _) => a match
        case D.VInt(n) => b match
          case D.VInt(r) => Mem.groupN(rest, Coll.insert(m, n, Coll.Cons(r, Mem.idsOf(m, n))))
          case D.VSym(_) => Mem.groupN(rest, m)
        case D.VSym(_) => Mem.groupN(rest, m)
      case Coll.Nil => Mem.groupN(rest, m)
    case Coll.Nil => Mem.groupN(rest, m)

def Mem.liveOf(md: Mem.Model): Coll.List[I64] =
  val Mem.Model(_, _, _, live, _, _) = md
  live

def Mem.names(ts: Coll.List[Coll.List[D.Val]], m: Coll.SMap[Bool]): Coll.SMap[Bool] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VSym(n) => Mem.names(rest, Coll.sInsert(m, n, true))
      case D.VInt(_) => Mem.names(rest, m)
    case Coll.Nil => Mem.names(rest, m)

def Mem.ints(ts: Coll.List[Coll.List[D.Val]], acc: Coll.List[I64]): Coll.List[I64] = ts match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VInt(n) => Mem.ints(rest, Coll.Cons(n, acc))
      case D.VSym(_) => Mem.ints(rest, acc)
    case Coll.Nil => Mem.ints(rest, acc)

// fills(S, R) grouped: region id to its site ids
def Mem.group(ts: Coll.List[Coll.List[D.Val]], m: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(a, tl) => tl match
      case Coll.Cons(b, _) => a match
        case D.VInt(s) => b match
          case D.VInt(r) => Mem.group(rest, Coll.insert(m, r, Coll.Cons(s, Mem.idsOf(m, r))))
          case D.VSym(_) => Mem.group(rest, m)
        case D.VSym(_) => Mem.group(rest, m)
      case Coll.Nil => Mem.group(rest, m)
    case Coll.Nil => Mem.group(rest, m)

def Mem.idsOf(m: Coll.IMap[Coll.List[I64]], k: I64): Coll.List[I64] = Coll.lookup(m, k) match
  case Coll.Some(xs) => xs
  case Coll.None => Coll.Nil

// a key that orders by line, then by id: id < n, so line * n + id is unique (both below 2^31 in any real program)
def Mem.regionKeys(rs: Coll.IMap[Mem.Region], n: I64, ids: Coll.List[I64], acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] = ids match
  case Coll.Nil => acc
  case Coll.Cons(r, rest) => Coll.lookup(rs, r) match
    case Coll.Some(x) =>
      val Mem.Region(_, line, _, _, _) = x
      Mem.regionKeys(rs, n, rest, Coll.Cons(Coll.KV(line * n + r, r), acc))
    case Coll.None => Mem.regionKeys(rs, n, rest, acc)

def Mem.siteKeys(ss: Coll.IMap[Mem.Site], n: I64, ids: Coll.List[I64], acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] = ids match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => Coll.lookup(ss, s) match
    case Coll.Some(x) =>
      val Mem.Site(_, line, _, _) = x
      Mem.siteKeys(ss, n, rest, Coll.Cons(Coll.KV(line * n + s, s), acc))
    case Coll.None => Mem.siteKeys(ss, n, rest, acc)

def Mem.byLine(kvs: Coll.List[Coll.KV[I64]]): Coll.List[I64] =
  val Coll.Sorted(xs) = Coll.sortDedup(kvs)
  Mem.vals(xs, Coll.Nil)

def Mem.vals(xs: Coll.List[Coll.KV[I64]], acc: Coll.List[I64]): Coll.List[I64] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(_, v) = kv
    Mem.vals(rest, Coll.Cons(v, acc))

def Mem.blocks(md: Mem.Model, cs: Coll.SMap[I64], free: Coll.List[Mem.Edge], fc: Mem.FC, ss: Coll.IMap[Mem.Site], ns: I64, rs: Coll.IMap[Mem.Region], mf: Coll.List[Mem.FreeAt], ids: Coll.List[I64], acc: Coll.List[Mem.Block]): Coll.List[Mem.Block] = ids match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(r, rest) => Coll.lookup(rs, r) match
    case Coll.Some(x) =>
      val Mem.Region(f, line, nm, h, end) = x
      val Mem.Model(_, _, byRegion, _, _, _) = md
      val Mem.Rs(rows, fc2) =
        Mem.rows(md, cs, free, fc, ss, Mem.byLine(Mem.siteKeys(ss, ns, Mem.idsOf(byRegion, r), Coll.Nil)), Coll.Nil)
      val b =
        Mem.Block(r, line, f, nm, h, rows, Mem.rowDefs(rows, Coll.sEmpty(), Coll.Nil), Mem.freeLines(mf, f, nm, line, Coll.Nil), end)
      Mem.blocks(md, cs, free, fc2, ss, ns, rs, mf, rest, Coll.Cons(b, acc))
    case Coll.None => Mem.blocks(md, cs, free, fc, ss, ns, rs, mf, rest, acc)

// the defs of rows, each once, in order of first row
def Mem.rowDefs(rows: Coll.List[Mem.Row], seen: Coll.SMap[Bool], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = rows match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(r, rest) =>
    val Mem.Row(_, f, _, _, _, _) = r
    if Mem.isIn(seen, f) then Mem.rowDefs(rest, seen, acc) else Mem.rowDefs(rest, Coll.sInsert(seen, f, true), Coll.Cons(f, acc))

// the lines of the calls x.free() in def f after the handle at line, in order
def Mem.freeLines(mf: Coll.List[Mem.FreeAt], f: Sym.Sym, x: Sym.Sym, line: I64, acc: Coll.List[I64]): Coll.List[I64] = mf match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(m, rest) =>
    val Mem.FreeAt(g, l, y) = m
    if l > line && Sym.eq(g, f) && Sym.eq(x, y) then Mem.freeLines(rest, f, x, line, Coll.Cons(l, acc)) else Mem.freeLines(rest, f, x, line, acc)

// the frees of no region its def handles: x is a {} Region param, so the free ends the region its caller passes
def Mem.paramFrees(mf: Coll.List[Mem.FreeAt], bs: Coll.List[Mem.Block], acc: Coll.List[Mem.FreeAt]): Coll.List[Mem.FreeAt] = mf match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(m, rest) => Mem.paramFrees(rest, bs, if Mem.freedIn(m, bs) then acc else Coll.Cons(m, acc))

def Mem.freedIn(m: Mem.FreeAt, bs: Coll.List[Mem.Block]): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(b, rest) =>
    val Mem.FreeAt(f, l, x) = m
    val Mem.Block(_, line, g, y, _, _, _, _, _) = b
    if l > line && Sym.eq(f, g) && Sym.eq(x, y) then true else Mem.freedIn(m, rest)

// every call x.free() in the bodies of fs, in program order
def Mem.manualFrees(fs: Coll.List[Ast.Fn], acc: Coll.List[Mem.FreeAt]): Coll.List[Mem.FreeAt] = fs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, _, _, _, body) = f
    val acc2: Coll.List[Mem.FreeAt] = body match
      case Ast.Def(_, e) => Mem.mfx(n, e, acc)
      case Ast.Extern(_) => acc
    Mem.manualFrees(rest, acc2)

def Mem.mfx(f: Sym.Sym, e: Ast.Expr, acc: Coll.List[Mem.FreeAt]): Coll.List[Mem.FreeAt] = e match
  case Ast.Method(line, r, op, args) =>
    val acc2 = if Str.eq(Sym.str(op), "free") then Coll.Cons(Mem.FreeAt(f, line, r), acc) else acc
    Mem.mfxs(f, args, acc2)
  case Ast.Call(_, _, _, _, args) => Mem.mfxs(f, args, acc)
  case Ast.Resume(_, _, x) => Mem.mfx(f, x, acc)
  case Ast.Bin(_, _, l, r) => Mem.mfx(f, r, Mem.mfx(f, l, acc))
  case Ast.Un(_, _, x) => Mem.mfx(f, x, acc)
  case Ast.If(_, c, t, x) => Mem.mfxs(f, Coll.Cons(c, Coll.Cons(t, Coll.Cons(x, Coll.Nil))), acc)
  case Ast.Match(_, s, arms) => Mem.mfArms(f, arms, Mem.mfx(f, s, acc))
  case Ast.Block(_, ss, last) => Mem.mfx(f, last, Mem.mfStmts(f, ss, acc))
  case Ast.While(_, c, b) => Mem.mfx(f, b, Mem.mfx(f, c, acc))
  case Ast.Assign(_, _, x) => Mem.mfx(f, x, acc)
  case _ => acc

def Mem.mfxs(f: Sym.Sym, es: Coll.List[Ast.Expr], acc: Coll.List[Mem.FreeAt]): Coll.List[Mem.FreeAt] = es match
  case Coll.Nil => acc
  case Coll.Cons(e, rest) => Mem.mfxs(f, rest, Mem.mfx(f, e, acc))

def Mem.mfArms(f: Sym.Sym, arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.FreeAt]): Coll.List[Mem.FreeAt] = arms match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, b) = a
    Mem.mfArms(f, rest, Mem.mfx(f, b, acc))

def Mem.mfStmts(f: Sym.Sym, ss: Coll.List[Ast.Stmt], acc: Coll.List[Mem.FreeAt]): Coll.List[Mem.FreeAt] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, _, e) => Mem.mfStmts(f, rest, Mem.mfx(f, e, acc))
    case Ast.Var(_, _, _, e) => Mem.mfStmts(f, rest, Mem.mfx(f, e, acc))
    case Ast.Handle(_, _, _, args) => Mem.mfStmts(f, rest, Mem.mfxs(f, args, acc))
    case Ast.Do(e) => Mem.mfStmts(f, rest, Mem.mfx(f, e, acc))
    case Ast.Check(_, _, e) => Mem.mfStmts(f, rest, Mem.mfx(f, e, acc))

// the rows of the sites ids; fc = the first-caller index, built at the first Via site (most programs have none). A
// site in a loop of its def is many; else its def's reason to be many: its own call sites, a call in a loop, or a
// caller that is many (Via)
def Mem.rows(md: Mem.Model, cs: Coll.SMap[I64], free: Coll.List[Mem.Edge], fc: Mem.FC, ss: Coll.IMap[Mem.Site], ids: Coll.List[I64], acc: Coll.List[Mem.Row]): Mem.Rs = ids match
  case Coll.Nil => Mem.Rs(Coll.rev(acc), fc)
  case Coll.Cons(s, rest) => Coll.lookup(ss, s) match
    case Coll.Some(x) =>
      val Mem.Site(f, line, ctor, loop) = x
      val Mem.Model(manyDef, loopCall, _, _, _, _) = md
      if loop then
        Mem.rows(md, cs, free, fc, ss, rest, Coll.Cons(Mem.rowOf(md, f, line, ctor, Mem.Many(Mem.InLoop)), acc))
      else if !Mem.isIn(manyDef, f) then
        Mem.rows(md, cs, free, fc, ss, rest, Coll.Cons(Mem.rowOf(md, f, line, ctor, Mem.Once), acc))
      else if Mem.count(cs, f) >= 2 then
        Mem.rows(md, cs, free, fc, ss, rest, Coll.Cons(Mem.rowOf(md, f, line, ctor, Mem.Many(Mem.Sites(f, Mem.count(cs, f)))), acc))
      else if Mem.isIn(loopCall, f) then
        Mem.rows(md, cs, free, fc, ss, rest, Coll.Cons(Mem.rowOf(md, f, line, ctor, Mem.Many(Mem.LoopCalled(f))), acc))
      else
        val first: Coll.SMap[Sym.Sym] = fc match
          case Mem.NoIndex => Mem.firstCallers(manyDef, free, Coll.sEmpty())
          case Mem.Index(m) => m
        val via = Mem.Many(Mem.Via(Mem.manyCaller(first, f)))
        Mem.rows(md, cs, free, Mem.Index(first), ss, rest, Coll.Cons(Mem.rowOf(md, f, line, ctor, via), acc))
    case Coll.None => Mem.rows(md, cs, free, fc, ss, rest, acc)

def Mem.rowOf(md: Mem.Model, f: Sym.Sym, line: I64, ctor: Sym.Sym, m: Mem.Mult): Mem.Row =
  Mem.Row(line, f, ctor, Mem.bytesAt(md, line, ctor), Mem.dies(md, f, line, ctor), m)

enum Mem.Rs:
  case Mem.Rs(rows: Coll.List[Mem.Row], fc: Mem.FC)

// the first-caller index: not built yet, or each callee's first free caller that is many (Mem.firstCallers)
enum Mem.FC:
  case Mem.NoIndex
  case Mem.Index(first: Coll.SMap[Sym.Sym])

// the first free caller of f that is many (the model has one: manyDef(f) came from such a caller): one lookup per
// site, not a scan of every call
def Mem.manyCaller(first: Coll.SMap[Sym.Sym], f: Sym.Sym): Sym.Sym = Coll.sLookup(first, f) match
  case Coll.None => f
  case Coll.Some(a) => a

// for each callee, its first free caller (in call order) that is many: set once per callee
def Mem.firstCallers(manyDef: Coll.SMap[Bool], es: Coll.List[Mem.Edge], m: Coll.SMap[Sym.Sym]): Coll.SMap[Sym.Sym] = es match
  case Coll.Nil => m
  case Coll.Cons(e, rest) =>
    val Mem.Edge(a, b) = e
    if Mem.isIn(manyDef, a) && !Mem.isIn(m, b) then Mem.firstCallers(manyDef, rest, Coll.sInsert(m, b, a))
    else Mem.firstCallers(manyDef, rest, m)

// the constructor sites by line: each instance of a def adds one entry for its site
def Mem.siteMap(sb: Coll.List[Emit.SiteB], m: Coll.IMap[Coll.List[Emit.SiteB]]): Coll.IMap[Coll.List[Emit.SiteB]] = sb match
  case Coll.Nil => m
  case Coll.Cons(s, rest) =>
    val Emit.SiteB(line, _, _) = s
    Mem.siteMap(rest, Coll.insert(m, line, Coll.Cons(s, Mem.sitesAt(m, line))))

def Mem.sitesAt(m: Coll.IMap[Coll.List[Emit.SiteB]], line: I64): Coll.List[Emit.SiteB] = Coll.lookup(m, line) match
  case Coll.Some(xs) => xs
  case Coll.None => Coll.Nil

// the bytes of one box of ctor at line: the largest over the instances of its def; none for an Array.fill (its
// size is known at run time) or a def no instance reaches
def Mem.bytesAt(md: Mem.Model, line: I64, ctor: Sym.Sym): Coll.Option[I64] =
  val Mem.Model(_, _, _, _, bm, _) = md
  Mem.maxBytes(Mem.sitesAt(bm, line), ctor, Coll.None)

def Mem.maxBytes(xs: Coll.List[Emit.SiteB], ctor: Sym.Sym, best: Coll.Option[I64]): Coll.Option[I64] = xs match
  case Coll.Nil => best
  case Coll.Cons(s, rest) =>
    val Emit.SiteB(_, c, b) = s
    val now: Coll.Option[I64] = best match
      case Coll.Some(x) => if Sym.eq(c, ctor) && b > x then Coll.Some(b) else best
      case Coll.None => if Sym.eq(c, ctor) then Coll.Some(b) else best
    Mem.maxBytes(rest, ctor, now)


// ── M4: does a box die in the def that makes it (vic/c/mem-design.md "M4b") ──
// A Datalog escape analysis in the shape of Doop's points-to (a value reaches a place only through a rule) and nanofil's
// escape.pl (a use that is not known to be local escapes). Nodes are a def's names, its sites, its call results and its
// result. flow(A, B), inside one def: a value at A can be at B (a val, var or assignment, a match pattern from its
// scrutinee, a box's args into the box). A call of a def G with a body gives argOf(A, G, i, C): arg i at A, result at C.
// sink(A): a use no rule follows (an op's args, a resume, a handle's args, any call that is not a def with a body:
// Array.put, a Cell op, an extern). Each def's params get summaries (Whaley-Rinard style), so every relation is linear in
// the program: retP(G, i) param i can reach G's result, sinkP(G, i) it can reach a sink. A box escapes its def when its
// node reaches the def's result or a sink; else it dies there. A site without a fact escapes.
//   retR(N) :- isRet(N) | flow(N, M), retR(M) | argOf(N, G, I, C), retP(G, I), retR(C)
//   sinkR(N) :- sink(N) | flow(N, M), sinkR(M) | argOf(N, G, I, C), sinkP(G, I) | argOf(N, G, I, C), retP(G, I), sinkR(C)
//   retP(G, I) :- param(G, I, P), retR(P)        sinkP(G, I) :- param(G, I, P), sinkR(P)
//   esc(S) :- siteOf(S, F), retR(site S of F) | siteOf(S, F), sinkR(site S of F)
// T3 (a box apart from its contents, Polonius child_path at one level): flow splits into alias(A, B) (a val, var,
// assignment, return), field(A, B) (A stored into box B) and load(A, B) (B read out of a field of A: a pattern, an array
// element). retC(N): a box reachable through N's fields reaches the result. retR walks alias only, so a box whose field
// alone is returned dies:
//   retR(N) :- alias(N, M), retR(M) | field(N, M), retC(M)
//   retC(N) :- retR(N) | alias(N, M), retC(M) | load(N, M), retC(M)   (retR implies retC: load/field into retR are
//   covered: a field store into retC reaches retR, then retC)
//   retPC(G, I) :- param(G, I, P), retC(P) (so retP implies retPC); at a call: retC(N) :- argOf(N, G, I, C),
//   retPC(G, I), retC(C); sinkC(N) :- argOf(N, G, I, C), sinkPC(G, I) | argOf(N, G, I, C), retPC(G, I), sinkC(C)
enum Mem.ERel:
  case Mem.EAlias
  case Mem.EField
  case Mem.ELoad
  case Mem.ERetC
  case Mem.ESinkC
  case Mem.ERetPC
  case Mem.ESinkPC
  case Mem.EFlow
  case Mem.ESink
  case Mem.ERet
  case Mem.ESiteOf
  case Mem.EArgOf
  case Mem.EParam
  case Mem.ERetR
  case Mem.ESinkR
  case Mem.ERetP
  case Mem.ESinkP
  case Mem.EEsc
  case Mem.ENode
  case Mem.ERetOf
  case Mem.ESiteNode
  case Mem.ESm
  case Mem.ERin
  case Mem.ECallOf
  case Mem.ECallIn
  case Mem.ECallFree
  case Mem.EMArg
  case Mem.EMRes
  case Mem.EOwn
  case Mem.EHasOwn
  case Mem.ENoRegion

def Mem.eSym(r: Mem.ERel): Sym.Sym = r match
  case Mem.EAlias => Sym.of("ealias")
  case Mem.EField => Sym.of("efield")
  case Mem.ELoad => Sym.of("eload")
  case Mem.ERetC => Sym.of("eretC")
  case Mem.ESinkC => Sym.of("esinkC")
  case Mem.ERetPC => Sym.of("eretPC")
  case Mem.ESinkPC => Sym.of("esinkPC")
  case Mem.EFlow => Sym.of("eflow")
  case Mem.ESink => Sym.of("esink")
  case Mem.ERet => Sym.of("eret")
  case Mem.ESiteOf => Sym.of("esiteOf")
  case Mem.EArgOf => Sym.of("eargOf")
  case Mem.EParam => Sym.of("eparam")
  case Mem.ERetR => Sym.of("eretR")
  case Mem.ESinkR => Sym.of("esinkR")
  case Mem.ERetP => Sym.of("eretP")
  case Mem.ESinkP => Sym.of("esinkP")
  case Mem.EEsc => Sym.of("eesc")
  case Mem.ENode => Sym.of("enode")
  case Mem.ERetOf => Sym.of("eretOf")
  case Mem.ESiteNode => Sym.of("esiteNode")
  case Mem.ESm => Sym.of("esm")
  case Mem.ERin => Sym.of("erin")
  case Mem.ECallOf => Sym.of("ecallOf")
  case Mem.ECallIn => Sym.of("ecallIn")
  case Mem.ECallFree => Sym.of("ecallFree")
  case Mem.EMArg => Sym.of("emarg")
  case Mem.EMRes => Sym.of("emres")
  case Mem.EOwn => Sym.of("eown")
  case Mem.EHasOwn => Sym.of("ehasOwn")
  case Mem.ENoRegion => Sym.of("enoRegion")

// a node: kind (Mem.kVar, kSite, kCall, kRet), its def, its key (a name, a site id, a line, 0)
enum Mem.Node:
  case Mem.Node(k: I64, d: Sym.Sym, x: D.Val)

def Mem.kVar(): I64 = 0
def Mem.kSite(): I64 = 1
def Mem.kCall(): I64 = 2
def Mem.kRet(): I64 = 3

def Mem.nVar(f: Sym.Sym, x: Sym.Sym): Mem.Node = Mem.Node(Mem.kVar(), f, D.VSym(x))
def Mem.nRet(f: Sym.Sym): Mem.Node = Mem.Node(Mem.kRet(), f, D.VInt(0))

// a site the walk saw: its id, def, line and constructor
enum Mem.ESite:
  case Mem.ESite(id: I64, f: Sym.Sym, line: I64, ctor: Sym.Sym)

// a site and whether its box dies in its def
enum Mem.ESiteR:
  case Mem.ESiteR(f: Sym.Sym, line: I64, ctor: Sym.Sym, dead: Bool)

// the walk's state: facts, the next site id, the sites
enum Mem.EW:
  case Mem.EW(facts: Coll.List[Mem.EF], n: I64, sites: Coll.List[Mem.ESite])

// the state after an expression, and the nodes its value can come from
enum Mem.EV:
  case Mem.EV(w: Mem.EW, ns: Coll.List[Mem.Node])

def Mem.eFact(w: Mem.EW, x: Mem.EF): Mem.EW =
  val Mem.EW(fs, n, ss) = w
  Mem.EW(Coll.Cons(x, fs), n, ss)

// a move of each node of ns into b, of kind k
def Mem.flowTo(w: Mem.EW, ns: Coll.List[Mem.Node], b: Mem.Node, k: Mem.MoveK): Mem.EW = ns match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => Mem.flowTo(Mem.eFact(w, Mem.FFlow(a, b, k)), rest, b, k)

def Mem.sinkAll(w: Mem.EW, ns: Coll.List[Mem.Node]): Mem.EW = ns match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => Mem.sinkAll(Mem.eFact(w, Mem.FSink(a)), rest)

// a type whose values hold no box
def Mem.scalar(t: Ast.Ty): Bool =
  val Ast.Ty(_, n, _, _, _) = t
  val x = Sym.str(n)
  Str.eq(x, "I64") || Str.eq(x, "Bool") || Str.eq(x, "Unit") || Str.eq(x, "U8") || Str.eq(x, "U32") || Str.eq(x, "U64") || Str.eq(x, "I32") || Str.eq(x, "F64")

// a case with fields: its constructor allocates a box
def Mem.allocates(ctors: Coll.SMap[Coll.List[Ast.Binder]], f: Sym.Sym): Bool = Coll.sLookup(ctors, f) match
  case Coll.Some(fs) => fs match
    case Coll.Cons(_, _) => true
    case Coll.Nil => false
  case Coll.None => false

def Mem.eExpr(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, e: Ast.Expr): Mem.EV = e match
  // a name its def binds is a var node; any other name (a nullary case, a global) is a static: no box, no node
  case Ast.Name(_, x) =>
    val Mem.Cx(_, _, _, _, bound, _) = cx
    if Mem.binds(bound, f, x) then Mem.EV(w, Coll.Cons(Mem.nVar(f, x), Coll.Nil)) else Mem.EV(w, Coll.Nil)
  case Ast.Call(line, g, _, _, args) => Mem.eCall(cx, f, w, line, g, args)
  case Ast.Method(line, _, _, args) =>
    val Mem.EV(w2, ns) = Mem.eExprs(cx, f, w, args, Coll.Nil)
    Mem.unknown(Mem.sinkAll(w2, ns), Mem.Node(Mem.kCall(), f, D.VInt(line)))
  case Ast.Resume(_, _, x) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, x)
    Mem.EV(Mem.sinkAll(w2, ns), Coll.Nil)
  case Ast.Bin(_, _, l, r) =>
    val Mem.EV(w2, _) = Mem.eExprs(cx, f, w, Coll.Cons(l, Coll.Cons(r, Coll.Nil)), Coll.Nil)
    Mem.EV(w2, Coll.Nil)
  case Ast.Un(_, _, x) =>
    val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, x)
    Mem.EV(w2, Coll.Nil)
  case Ast.If(_, c, t, x) =>
    val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, c)
    Mem.eExprs(cx, f, w2, Coll.Cons(t, Coll.Cons(x, Coll.Nil)), Coll.Nil)
  case Ast.Match(_, s, arms) =>
    val Mem.EV(w2, ss) = Mem.eExpr(cx, f, w, s)
    Mem.eArms(cx, f, w2, ss, arms, Coll.Nil)
  case Ast.Block(_, stmts, last) => Mem.eStmts(cx, f, w, stmts, last)
  case Ast.While(_, c, body) =>
    val Mem.EV(w2, _) = Mem.eExprs(cx, f, w, Coll.Cons(c, Coll.Cons(body, Coll.Nil)), Coll.Nil)
    Mem.EV(w2, Coll.Nil)
  case Ast.Assign(_, x, v) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, v)
    Mem.EV(Mem.flowTo(w2, ns, Mem.nVar(f, x), Mem.MAssign), Coll.Nil)
  case Ast.Quant(_, _, _, _, _) => Mem.EV(w, Coll.Nil)
  case Ast.Int(_, _) => Mem.EV(w, Coll.Nil)
  case Ast.Bool(_, _) => Mem.EV(w, Coll.Nil)
  case Ast.Str(_, _) => Mem.EV(w, Coll.Nil)
  case Ast.Unit(_) => Mem.EV(w, Coll.Nil)

// a call: a constructor that allocates is a site holding its args; a def with a body takes each arg into its param and
// gives its result (none when the result type holds no box); anything else (Array.put, a Cell op, an extern, a read
// xs(i) of a local array) keeps its args: they are sinks, and its value is the named local's
def Mem.eCall(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, line: I64, g: Sym.Sym, args: Coll.List[Ast.Expr]): Mem.EV =
  val Mem.Cx(fns, ctors, _, ss, bound, quiet) = cx
  val Mem.EA(w2, nss) = Mem.eArgs(cx, f, w, args, Coll.Nil)
  if Mem.allocates(ctors, g) || Eff.isArrayNew(ss, g) then
    val Mem.EW(fs, n, sites) = w2
    val node = Mem.Node(Mem.kSite(), f, D.VInt(n))
    val w3 = Mem.EW(Coll.Cons(Mem.FSite(n, f), fs), n + 1, Coll.Cons(Mem.ESite(n, f, line, g), sites))
    val held: Coll.List[Coll.List[Mem.Node]] = Coll.sLookup(ctors, g) match
      case Coll.Some(fields) => Mem.boxed(nss, fields, Coll.Nil)
      case Coll.None => nss match
        case Coll.Cons(_, rest) => rest
        case Coll.Nil => Coll.Nil
    Mem.EV(Mem.flowTo(w3, Mem.flat(held, Coll.Nil), node, Mem.MField), Coll.Cons(node, Coll.Nil))
  else if Mem.isIn(ctors, g) then Mem.EV(w2, Coll.Nil)
  // xs(i) of an array the def binds: the element comes out of xs (a pattern move: it holds xs's regions) and stays in
  // the array, so it is shared (unknown), never a unique box to reuse
  else if Mem.binds(bound, f, g) then
    val el = Mem.Node(Mem.kCall(), f, D.VInt(line))
    Mem.unknown(Mem.flowTo(w2, Coll.Cons(Mem.nVar(f, g), Coll.Nil), el, Mem.MPattern), el)
  else Coll.sLookup(fns, g) match
    case Coll.Some(gf) =>
      val Ast.Fn(_, _, _, ps, ret, _, body) = gf
      body match
        case Ast.Def(_, _) =>
          val node = Mem.Node(Mem.kCall(), f, D.VInt(line))
          val w3 = Mem.toParams(g, node, w2, nss, ps, 0)
          if Mem.scalar(ret) then Mem.EV(w3, Coll.Nil) else Mem.EV(Mem.eFact(w3, Mem.FCallOf(node, g)), Coll.Cons(node, Coll.Nil))
        case Ast.Extern(_) =>
          val en = Mem.Node(Mem.kCall(), f, D.VInt(line))
          Mem.unknown(Mem.externArgs(w2, nss, ps, en, Mem.scalar(ret)), en)
    // no def: an op (P.op) or an unknown call. An op of a quiet protocol (Mem.quietPs: every handler stateless, every
    // op param a Str or a scalar; srs has no mutable global) borrows its args: they can reach only its result (an
    // alias flow) or a forwarded op of such a protocol; any other call keeps them (sinks)
    case Coll.None =>
      val on = Mem.Node(Mem.kCall(), f, D.VInt(line))
      val ns = Mem.flat(nss, Coll.Nil)
      val w3 = if Mem.quietOp(quiet, g) then Mem.flowTo(w2, ns, on, Mem.MBind) else Mem.sinkAll(w2, ns)
      Mem.unknown(w3, on)

// each arg's nodes, in arg order (the list of lists is built reversed and turned once)
def Mem.eArgs(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, es: Coll.List[Ast.Expr], acc: Coll.List[Coll.List[Mem.Node]]): Mem.EA = es match
  case Coll.Nil => Mem.EA(w, Coll.rev(acc))
  case Coll.Cons(e, rest) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
    Mem.eArgs(cx, f, w2, rest, Coll.Cons(ns, acc))

enum Mem.EA:
  case Mem.EA(w: Mem.EW, nss: Coll.List[Coll.List[Mem.Node]])

def Mem.flat(nss: Coll.List[Coll.List[Mem.Node]], acc: Coll.List[Mem.Node]): Coll.List[Mem.Node] = nss match
  case Coll.Nil => acc
  case Coll.Cons(ns, rest) => Mem.flat(rest, Coll.revOnto(ns, acc))

// argOf(A, g, i, C) for each node A of arg i, with C the call's result node (an arg past the params is a sink)
def Mem.toParams(g: Sym.Sym, c: Mem.Node, w: Mem.EW, nss: Coll.List[Coll.List[Mem.Node]], ps: Coll.List[Ast.Binder], i: I64): Mem.EW = nss match
  case Coll.Nil => w
  case Coll.Cons(ns, rest) => ps match
    case Coll.Cons(p, prest) =>
      val Ast.Binder(_, _, pty) = p
      // a scalar param holds no box: its arg takes no edge into it
      val w2 = if Mem.scalar(pty) then w else Mem.argOf(w, ns, g, i, c)
      Mem.toParams(g, c, w2, rest, prest, i + 1)
    case Coll.Nil => Mem.toParams(g, c, Mem.sinkAll(w, ns), rest, Coll.Nil, i + 1)

def Mem.argOf(w: Mem.EW, ns: Coll.List[Mem.Node], g: Sym.Sym, i: I64, c: Mem.Node): Mem.EW = ns match
  case Coll.Nil => w
  case Coll.Cons(a, rest) => Mem.argOf(Mem.eFact(w, Mem.FArgOf(a, g, i, c)), rest, g, i, c)

// param(g, i, node of param i) for each param of g
def Mem.params(g: Sym.Sym, w: Mem.EW, ps: Coll.List[Ast.Binder], i: I64): Mem.EW = ps match
  case Coll.Nil => w
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, _) = p
    Mem.params(g, Mem.eFact(w, Mem.FParam(g, i, Mem.nVar(g, x))), rest, i + 1)

def Mem.eExprs(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, es: Coll.List[Ast.Expr], acc: Coll.List[Mem.Node]): Mem.EV = es match
  case Coll.Nil => Mem.EV(w, acc)
  case Coll.Cons(e, rest) =>
    val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
    Mem.eExprs(cx, f, w2, rest, Coll.revOnto(ns, acc))

def Mem.eArms(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, ss: Coll.List[Mem.Node], arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.Node]): Mem.EV = arms match
  case Coll.Nil => Mem.EV(w, acc)
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, body) = a
    val w2: Mem.EW = p match
      case Ast.PCase(c, binds) =>
        val Mem.Cx(_, ctors, _, _, _, _) = cx
        val fields: Coll.List[Ast.Binder] = Coll.sLookup(ctors, c) match
          case Coll.Some(xs) => xs
          case Coll.None => Coll.Nil
        Mem.bindPat(f, w, ss, binds, fields)
      case Ast.PAny => w
    val Mem.EV(w3, ns) = Mem.eExpr(cx, f, w2, body)
    Mem.eArms(cx, f, w3, ss, rest, Coll.revOnto(ns, acc))

// each pattern var takes the scrutinee's nodes, but a var of a scalar field (its case's field type) holds no box
def Mem.bindPat(f: Sym.Sym, w: Mem.EW, ss: Coll.List[Mem.Node], xs: Coll.List[Sym.Sym], fields: Coll.List[Ast.Binder]): Mem.EW = xs match
  case Coll.Nil => w
  case Coll.Cons(x, rest) => fields match
    case Coll.Cons(b, frest) =>
      val Ast.Binder(_, _, ty) = b
      val w2 = if Mem.scalar(ty) then w else Mem.flowTo(w, ss, Mem.nVar(f, x), Mem.MPattern)
      Mem.bindPat(f, w2, ss, rest, frest)
    case Coll.Nil => Mem.bindPat(f, Mem.flowTo(w, ss, Mem.nVar(f, x), Mem.MPattern), ss, rest, Coll.Nil)

def Mem.eStmts(cx: Mem.Cx, f: Sym.Sym, w: Mem.EW, ss: Coll.List[Ast.Stmt], last: Ast.Expr): Mem.EV = ss match
  case Coll.Nil => Mem.eExpr(cx, f, w, last)
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, x, _, e) =>
      val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, Mem.flowTo(w2, ns, Mem.nVar(f, x), Mem.MBind), rest, last)
    case Ast.Var(_, x, _, e) =>
      val Mem.EV(w2, ns) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, Mem.flowTo(w2, ns, Mem.nVar(f, x), Mem.MBind), rest, last)
    case Ast.Handle(_, _, _, args) =>
      val Mem.EV(w2, ns) = Mem.eExprs(cx, f, w, args, Coll.Nil)
      Mem.eStmts(cx, f, Mem.sinkAll(w2, ns), rest, last)
    case Ast.Do(e) =>
      val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, w2, rest, last)
    case Ast.Check(_, _, e) =>
      val Mem.EV(w2, _) = Mem.eExpr(cx, f, w, e)
      Mem.eStmts(cx, f, w2, rest, last)

// every def with a body: its result node and the facts of its body
def Mem.eDecls(cx: Mem.Cx, w: Mem.EW, ds: Coll.List[Ast.Decl]): Mem.EW = ds match
  case Coll.Nil => w
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(fn) =>
      val Ast.Fn(_, n, _, ps, _, _, body) = fn
      val w3: Mem.EW = body match
        case Ast.Def(_, e) =>
          val r = Mem.nRet(n)
          val w1 = Mem.params(n, Mem.eFact(w, Mem.FRet(r, n)), ps, 0)
          val Mem.EV(w2, ns) = Mem.eExpr(cx, n, w1, e)
          Mem.flowTo(w2, ns, r, Mem.MRet)
        case Ast.Extern(_) => w
      Mem.eDecls(cx, w3, rest)
    case _ => Mem.eDecls(cx, w, rest)

def Mem.eAtom(r: Mem.ERel, xs: Coll.List[D.Arg]): D.Atom = D.Atom(Mem.eSym(r), xs)
def Mem.v(i: I64): D.Arg = D.AVar(i)

// a node arg: one var a (Mem.intern gives each node one id, so the column D indexes is exact)
def Mem.n1(a: I64, rest: Coll.List[D.Arg]): Coll.List[D.Arg] = Coll.Cons(Mem.v(a), rest)

// var numbers: N = 0 1 2, M = 3 4 5, G = 6, I = 7, C = 8 9 10
def Mem.nN(): Coll.List[D.Arg] = Mem.n1(0, Coll.Nil)
def Mem.argOfA(): D.Lit = D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n1(0, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n1(8, Coll.Nil))))))
def Mem.gi(r: Mem.ERel): D.Lit = D.Pos(Mem.eAtom(r, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Coll.Nil))))
def Mem.atC(r: Mem.ERel): D.Lit = D.Pos(Mem.eAtom(r, Mem.n1(8, Coll.Nil)))
def Mem.lits3(a: D.Lit, b: D.Lit, c: D.Lit): Coll.List[D.Lit] = Coll.Cons(a, Mem.lits2(b, c))

// the reach part of retR/retC (or sinkR/sinkC) over base: r(N) :- base(N); the T3 rules of the comment above
def Mem.reach(r: Mem.ERel, c: Mem.ERel, base: Mem.ERel): Coll.List[D.Rule] =
  val rN = Mem.eAtom(r, Mem.nN())
  val cN = Mem.eAtom(c, Mem.nN())
  val rM = D.Pos(Mem.eAtom(r, Mem.n1(3, Coll.Nil)))
  val cM = D.Pos(Mem.eAtom(c, Mem.n1(3, Coll.Nil)))
  val alias = D.Pos(Mem.eAtom(Mem.EAlias, Mem.n1(0, Mem.n1(3, Coll.Nil))))
  val field = D.Pos(Mem.eAtom(Mem.EField, Mem.n1(0, Mem.n1(3, Coll.Nil))))
  val load = D.Pos(Mem.eAtom(Mem.ELoad, Mem.n1(0, Mem.n1(3, Coll.Nil))))
  val r1 = D.Rule(rN, Mem.lit1(D.Pos(Mem.eAtom(base, Mem.nN()))))
  val r2 = D.Rule(rN, Mem.lits2(alias, rM))
  val r3 = D.Rule(rN, Mem.lits2(field, cM))
  val c1 = D.Rule(cN, Mem.lit1(D.Pos(rN)))
  val c2 = D.Rule(cN, Mem.lits2(alias, cM))
  val c4 = D.Rule(cN, Mem.lits2(load, cM))
  Coll.Cons(r1, Coll.Cons(r2, Coll.Cons(r3, Coll.Cons(c1, Coll.Cons(c2, Coll.Cons(c4, Coll.Nil))))))

// p(G, I) :- param(G, I, P), r(P)
def Mem.summary(p: Mem.ERel, r: Mem.ERel): D.Rule =
  D.Rule(Mem.eAtom(p, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Coll.Nil))), Mem.lits2(D.Pos(Mem.eAtom(Mem.EParam, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n1(0, Coll.Nil))))), D.Pos(Mem.eAtom(r, Mem.nN()))))

def Mem.eRules(): Coll.List[D.Rule] =
  val retC = D.Rule(Mem.eAtom(Mem.ERetR, Mem.nN()), Mem.lits3(Mem.argOfA(), Mem.gi(Mem.ERetP), Mem.atC(Mem.ERetR)))
  val sinkP = D.Rule(Mem.eAtom(Mem.ESinkR, Mem.nN()), Mem.lits2(Mem.argOfA(), Mem.gi(Mem.ESinkP)))
  val sinkC = D.Rule(Mem.eAtom(Mem.ESinkR, Mem.nN()), Mem.lits3(Mem.argOfA(), Mem.gi(Mem.ERetP), Mem.atC(Mem.ESinkR)))
  val site = Coll.Cons(Mem.v(1), Coll.Nil)
  val siteOf = D.Pos(Mem.eAtom(Mem.ESiteNode, Coll.Cons(Mem.v(0), Coll.Cons(Mem.v(1), Coll.Nil))))
  val esc1 = D.Rule(Mem.eAtom(Mem.EEsc, Coll.Cons(Mem.v(0), Coll.Nil)), Mem.lits2(siteOf, D.Pos(Mem.eAtom(Mem.ERetR, site))))
  val esc2 = D.Rule(Mem.eAtom(Mem.EEsc, Coll.Cons(Mem.v(0), Coll.Nil)), Mem.lits2(siteOf, D.Pos(Mem.eAtom(Mem.ESinkR, site))))
  val own = Coll.Cons(retC, Coll.Cons(sinkP, Coll.Cons(sinkC, Coll.Cons(Mem.summary(Mem.ERetP, Mem.ERetR), Coll.Cons(Mem.summary(Mem.ESinkP, Mem.ESinkR), Coll.Cons(esc1, Coll.Cons(esc2, Coll.Nil)))))))
  val nC = D.Atom(Mem.eSym(Mem.ERetC), Mem.nN())
  val sC = D.Atom(Mem.eSym(Mem.ESinkC), Mem.nN())
  val rc3 = D.Rule(nC, Mem.lits3(Mem.argOfA(), Mem.gi(Mem.ERetPC), Mem.atC(Mem.ERetC)))
  val sc1 = D.Rule(sC, Mem.lits2(Mem.argOfA(), Mem.gi(Mem.ESinkPC)))
  val sc4 = D.Rule(sC, Mem.lits3(Mem.argOfA(), Mem.gi(Mem.ERetPC), Mem.atC(Mem.ESinkC)))
  val sums = Coll.Cons(Mem.summary(Mem.ERetPC, Mem.ERetC), Coll.Cons(Mem.summary(Mem.ESinkPC, Mem.ESinkC), own))
  val cs = Coll.Cons(rc3, Coll.Cons(sc1, Coll.Cons(sc4, sums)))
  Coll.revOnto(Coll.rev(Mem.reach(Mem.ERetR, Mem.ERetC, Mem.ERet)), Coll.revOnto(Coll.rev(Mem.reach(Mem.ESinkR, Mem.ESinkC, Mem.ESink)), cs))

def Mem.idSet(ts: Coll.List[Coll.List[D.Val]], m: Coll.IMap[Bool]): Coll.IMap[Bool] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VInt(i) => Mem.idSet(rest, Coll.insert(m, i, true))
      case D.VSym(_) => Mem.idSet(rest, m)
    case Coll.Nil => Mem.idSet(rest, m)

def Mem.marks(ss: Coll.List[Mem.ESite], esc: Coll.IMap[Bool], ok: Bool, acc: Coll.List[Mem.ESiteR]): Coll.List[Mem.ESiteR] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) =>
    val Mem.ESite(id, f, line, ctor) = s
    val dead: Bool = Coll.lookup(esc, id) match
      case Coll.Some(_) => false
      case Coll.None => ok
    Mem.marks(rest, esc, ok, Coll.Cons(Mem.ESiteR(f, line, ctor, dead), acc))

// a site of def f at line with ctor dies when the analysis saw it and every box made there dies
def Mem.dies(md: Mem.Model, f: Sym.Sym, line: I64, ctor: Sym.Sym): Bool =
  val Mem.Model(_, _, _, _, _, rs) = md
  Mem.allDead(rs, f, line, ctor, false)

def Mem.allDead(rs: Coll.List[Mem.ESiteR], f: Sym.Sym, line: I64, ctor: Sym.Sym, seen: Bool): Bool = rs match
  case Coll.Nil => seen
  case Coll.Cons(r, rest) =>
    val Mem.ESiteR(g, l, c, dead) = r
    if l == line && Sym.eq(g, f) && Sym.eq(c, ctor) then dead && Mem.allDead(rest, f, line, ctor, true)
    else Mem.allDead(rest, f, line, ctor, seen)

// ── M7a: which matches can rebuild their box in place (vic/c/mem-design.md "M7") ──
// a box is SHARED when two references to it can be live: a least fixpoint over M4's nodes. A var read on two paths of
// one run (a sum in a block, the max over if and match arms, twice inside a while) is shared; sharing flows forward
// along flow (val, var, pattern binds, box args: a box built from a shared value is shared, so a field taken out of an
// unshared box is unshared), from an arg into the callee's param, and from a callee's shared result into the call. A
// value with no known origin (a read xs(i), an extern or op result, a param of a handler or given fn, which dispatch
// calls) is shared. A match on a var x that is not shared, read once (the match), can write a box of its arm into x's
// cell: the reuse table. Report only (M7b writes the C).
//   shared(N) :- multi(N) | unknown(N) | flow(M, N), shared(M) | argOf(M, G, I, C), shared(M), param(G, I, N)
//              | callOf(N, G), shared(ret node of G)
// the use count of each name a def reads: a Sym map, and its keys newest first
enum Mem.UC:
  case Mem.UC(m: Coll.SMap[I64], ks: Coll.List[Sym.Sym])

def Mem.ucNone(): Mem.UC = Mem.UC(Coll.sEmpty(), Coll.Nil)

def Mem.ucCount(m: Coll.SMap[I64], x: Sym.Sym): I64 = Coll.sLookup(m, x) match
  case Coll.Some(n) => n
  case Coll.None => 0

// u with k added to the count of x
def Mem.ucAdd(u: Mem.UC, x: Sym.Sym, k: I64): Mem.UC = u match
  case Mem.UC(m, ks) => Coll.sLookup(m, x) match
    case Coll.Some(n) => Mem.UC(Coll.sInsert(m, x, n + k), ks)
    case Coll.None => Mem.UC(Coll.sInsert(m, x, k), Coll.Cons(x, ks))

// u with the count of x raised to n
def Mem.ucRaise(u: Mem.UC, x: Sym.Sym, n: I64): Mem.UC = u match
  case Mem.UC(m, ks) => Coll.sLookup(m, x) match
    case Coll.Some(c) => if n > c then Mem.UC(Coll.sInsert(m, x, n), ks) else u
    case Coll.None => Mem.UC(Coll.sInsert(m, x, n), Coll.Cons(x, ks))

// a with each count of b (keys of b oldest first) added k times
def Mem.ucSum(a: Mem.UC, m: Coll.SMap[I64], ks: Coll.List[Sym.Sym], k: I64): Mem.UC = ks match
  case Coll.Nil => a
  case Coll.Cons(x, rest) => Mem.ucSum(Mem.ucAdd(a, x, Mem.ucCount(m, x) * k), m, rest, k)

def Mem.ucMax(a: Mem.UC, m: Coll.SMap[I64], ks: Coll.List[Sym.Sym]): Mem.UC = ks match
  case Coll.Nil => a
  case Coll.Cons(x, rest) => Mem.ucMax(Mem.ucRaise(a, x, Mem.ucCount(m, x)), m, rest)

def Mem.ucSumAll(a: Mem.UC, b: Mem.UC, k: I64): Mem.UC = b match
  case Mem.UC(m, ks) => Mem.ucSum(a, m, Coll.rev(ks), k)

def Mem.ucMaxAll(a: Mem.UC, b: Mem.UC): Mem.UC = b match
  case Mem.UC(m, ks) => Mem.ucMax(a, m, Coll.rev(ks))

def Mem.uses(e: Ast.Expr, m: Mem.UC): Mem.UC = e match
  case Ast.Name(_, x) => Mem.ucAdd(m, x, 1)
  // a callee is a def, not a name: it has no count
  case Ast.Call(_, _, _, _, args) => Mem.usesAll(args, m)
  case Ast.Method(_, r, _, args) => Mem.usesAll(args, Mem.ucAdd(m, r, 1))
  case Ast.Resume(_, _, x) => Mem.uses(x, m)
  case Ast.Bin(_, _, l, r) => Mem.uses(r, Mem.uses(l, m))
  case Ast.Un(_, _, x) => Mem.uses(x, m)
  case Ast.If(_, c, t, x) => Mem.ucSumAll(Mem.uses(c, m), Mem.ucMaxAll(Mem.uses(t, Mem.ucNone()), Mem.uses(x, Mem.ucNone())), 1)
  case Ast.Match(_, s, arms) => Mem.ucSumAll(Mem.uses(s, m), Mem.armUses(arms, Mem.ucNone()), 1)
  case Ast.Block(_, ss, last) => Mem.uses(last, Mem.stmtUses(ss, m))
  case Ast.While(_, c, body) => Mem.ucSumAll(m, Mem.uses(body, Mem.uses(c, Mem.ucNone())), 2)
  case Ast.Assign(_, _, x) => Mem.uses(x, m)
  case Ast.Quant(_, _, _, _, _) => m
  case Ast.Int(_, _) => m
  case Ast.Bool(_, _) => m
  case Ast.Str(_, _) => m
  case Ast.Unit(_) => m

def Mem.usesAll(es: Coll.List[Ast.Expr], m: Mem.UC): Mem.UC = es match
  case Coll.Nil => m
  case Coll.Cons(e, rest) => Mem.usesAll(rest, Mem.uses(e, m))

def Mem.armUses(arms: Coll.List[Ast.Arm], m: Mem.UC): Mem.UC = arms match
  case Coll.Nil => m
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, body) = a
    Mem.armUses(rest, Mem.ucMaxAll(m, Mem.uses(body, Mem.ucNone())))

def Mem.stmtUses(ss: Coll.List[Ast.Stmt], m: Mem.UC): Mem.UC = ss match
  case Coll.Nil => m
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, _, e) => Mem.stmtUses(rest, Mem.uses(e, m))
    case Ast.Var(_, _, _, e) => Mem.stmtUses(rest, Mem.uses(e, m))
    case Ast.Handle(_, _, _, args) => Mem.stmtUses(rest, Mem.usesAll(args, m))
    case Ast.Do(e) => Mem.stmtUses(rest, Mem.uses(e, m))
    case Ast.Check(_, _, e) => Mem.stmtUses(rest, Mem.uses(e, m))

// the sharing seeds of def f: each name read twice, and (for a fn that dispatch calls) each param
enum Mem.SRel7:
  case Mem.RMulti7
  case Mem.RUnknown7
  case Mem.RShared7

def Mem.s7(r: Mem.SRel7): Sym.Sym = r match
  case Mem.RMulti7 => Sym.of("emulti")
  case Mem.RUnknown7 => Sym.of("eunknown")
  case Mem.RShared7 => Sym.of("eshared")

def Mem.multiFacts(bound: Coll.SMap[Coll.SMap[Mem.LV]], f: Sym.Sym, u: Mem.UC, acc: Coll.List[Mem.EF]): Coll.List[Mem.EF] = u match
  case Mem.UC(m, ks) => Mem.multiKs(bound, f, m, Coll.rev(ks), acc)

def Mem.multiKs(bound: Coll.SMap[Coll.SMap[Mem.LV]], f: Sym.Sym, m: Coll.SMap[I64], ks: Coll.List[Sym.Sym], acc: Coll.List[Mem.EF]): Coll.List[Mem.EF] = ks match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) =>
    Mem.multiKs(bound, f, m, rest, if Mem.ucCount(m, x) >= 2 && Mem.binds(bound, f, x) then Coll.Cons(Mem.FMulti(Mem.nVar(f, x)), acc) else acc)

def Mem.paramSeeds(f: Sym.Sym, ps: Coll.List[Ast.Binder], acc: Coll.List[Mem.EF]): Coll.List[Mem.EF] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, _) = p
    Mem.paramSeeds(f, rest, Coll.Cons(Mem.FUnknown(Mem.nVar(f, x)), acc))

// the fns of handlers and givens: dispatch calls them, so their params have no known origin; their bodies are walked as
// defs so the calls they make give argOf facts
def Mem.dispatchFns(ds: Coll.List[Ast.Decl], acc: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = ds match
  case Coll.Nil => acc
  case Coll.Cons(d, rest) => d match
    case Ast.DHandler(h) =>
      val Ast.Handler(_, _, _, fs, _) = h
      Mem.dispatchFns(rest, Coll.revOnto(fs, acc))
    case Ast.DGiven(g) =>
      val Ast.Given(_, _, _, fs) = g
      Mem.dispatchFns(rest, Coll.revOnto(fs, acc))
    case _ => Mem.dispatchFns(rest, acc)

def Mem.asDecls(fs: Coll.List[Ast.Fn], acc: Coll.List[Ast.Decl]): Coll.List[Ast.Decl] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) => Mem.asDecls(rest, Coll.Cons(Ast.DFn(f), acc))

def Mem.fnSeeds(bound: Coll.SMap[Coll.SMap[Mem.LV]], fs: Coll.List[Ast.Fn], dispatch: Bool, acc: Coll.List[Mem.EF]): Coll.List[Mem.EF] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, ps, _, _, body) = f
    val acc2: Coll.List[Mem.EF] = body match
      case Ast.Def(_, e) => Mem.multiFacts(bound, n, Mem.uses(e, Mem.ucNone()), acc)
      case Ast.Extern(_) => acc
    Mem.fnSeeds(bound, rest, dispatch, if dispatch then Mem.paramSeeds(n, ps, acc2) else acc2)

def Mem.sh(xs: Coll.List[D.Arg]): D.Lit = D.Pos(D.Atom(Mem.s7(Mem.RShared7), xs))

// the sanity checks (Doop sanity.dl shape): each relation must be empty on every program. noRegion(E): a site of a
// reached def whose box has no region (vars: E 14, F 6, N 0, R 12)
//   hasOwn(N) :- own(N, R)        noRegion(E) :- esiteOf(E, F), reached(F), esiteNode(E, N), !hasOwn(N)
def Mem.failRules(): Coll.List[D.Rule] =
  val has = D.Rule(Mem.eAtom(Mem.EHasOwn, Mem.nN()), Mem.lit1(D.Pos(Mem.eAtom(Mem.EOwn, Mem.n1(0, Coll.Cons(Mem.v(12), Coll.Nil))))))
  val siteOf = D.Pos(Mem.eAtom(Mem.ESiteOf, Coll.Cons(Mem.v(14), Coll.Cons(Mem.v(6), Coll.Nil))))
  val reached = D.Pos(D.Atom(Mem.relSym(Mem.RReached), Coll.Cons(Mem.v(6), Coll.Nil)))
  val node = D.Pos(Mem.eAtom(Mem.ESiteNode, Coll.Cons(Mem.v(14), Mem.nN())))
  val none = D.Rule(Mem.eAtom(Mem.ENoRegion, Coll.Cons(Mem.v(14), Coll.Nil)), Coll.Cons(siteOf, Coll.Cons(reached, Coll.Cons(node, Mem.lit1(D.Neg(Mem.eAtom(Mem.EHasOwn, Mem.nN())))))))
  Coll.Cons(has, Coll.Cons(none, Coll.Nil))

// a failed sanity check, each with what it names: a site of a reached def whose box has no region (def, line, ctor); a
// var that can hold a box of region r, read at line use after r.free() at line free in the def that handles r (Polonius
// errors: a live loan invalidated)
enum Mem.Fail:
  case Mem.FNoRegion(f: Sym.Sym, line: I64, ctor: Sym.Sym)
  case Mem.FUseAfterFree(f: Sym.Sym, x: Sym.Sym, use: I64, r: I64, free: I64)

def Mem.noRegionFails(es: Coll.List[Mem.ESite], bad: Coll.IMap[Bool], acc: Coll.List[Mem.Fail]): Coll.List[Mem.Fail] = es match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(e, rest) =>
    val Mem.ESite(id, f, line, ctor) = e
    Mem.noRegionFails(rest, bad, if Mem.hasId(bad, id) then Coll.Cons(Mem.FNoRegion(f, line, ctor), acc) else acc)

// each manual free of a handled region against the vars of its def that can hold its boxes: a read after the free.
// Only a var never assigned: the analysis has no kill at an assignment, so for an assigned var it claims nothing
// (vars[].assigned shows which)
def Mem.uafFails(bs: Coll.List[Mem.Block], byDef: Coll.SMap[Coll.List[Mem.VarRec]], acc: Coll.List[Mem.Fail]): Coll.List[Mem.Fail] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Mem.Block(r, _, f, _, _, _, _, frees, _) = b
    val vs: Coll.List[Mem.VarRec] = Coll.sLookup(byDef, f) match
      case Coll.Some(xs) => xs
      case Coll.None => Coll.Nil
    Mem.uafFails(rest, byDef, Mem.uafFrees(frees, r, vs, acc))

def Mem.uafFrees(frees: Coll.List[I64], r: I64, vs: Coll.List[Mem.VarRec], acc: Coll.List[Mem.Fail]): Coll.List[Mem.Fail] = frees match
  case Coll.Nil => acc
  case Coll.Cons(l, rest) => Mem.uafFrees(rest, r, vs, Mem.uafVars(vs, r, l, acc))

def Mem.uafVars(vs: Coll.List[Mem.VarRec], r: I64, free: I64, acc: Coll.List[Mem.Fail]): Coll.List[Mem.Fail] = vs match
  case Coll.Nil => acc
  case Coll.Cons(v, rest) =>
    val Mem.VarRec(_, f, x, regions, _, lv, _) = v
    val Mem.LV(_, uses, _, assigned, _) = lv
    val last = Mem.maxOf(uses, 0)
    Mem.uafVars(rest, r, free, if last > free && !assigned && Mem.inList(r, regions) then Coll.Cons(Mem.FUseAfterFree(f, x, last, r, free), acc) else acc)

// ── M11: the last line that can touch each handled region (Polonius liveness at region grain): after it the region
// could be freed (today its drop frees it at its block end) ──
// by region id: the largest of the handle's line, the last read of a var of its def that can hold its boxes, a site of
// its def in it, and a call of its def that runs in it (callAt: the callee fills it during the call)
def Mem.deadLines(bs: Coll.List[Mem.Block], vbd: Coll.SMap[Coll.List[Mem.VarRec]], fs: Coll.List[D.Fact], acc: Coll.IMap[I64]): Coll.IMap[I64] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Mem.Block(r, line, f, _, _, rows, _, _, _) = b
    val vs: Coll.List[Mem.VarRec] = Coll.sLookup(vbd, f) match
      case Coll.Some(xs) => xs
      case Coll.None => Coll.Nil
    val d = Mem.callsIn(fs, f, r, Mem.rowsIn(rows, f, Mem.varsLast(vs, r, line)))
    Mem.deadLines(rest, vbd, fs, Coll.insert(acc, r, d))

def Mem.varsLast(vs: Coll.List[Mem.VarRec], r: I64, m: I64): I64 = vs match
  case Coll.Nil => m
  case Coll.Cons(v, rest) =>
    val Mem.VarRec(_, _, _, regions, _, lv, _) = v
    val Mem.LV(_, uses, _, _, _) = lv
    val last = Mem.maxOf(uses, 0)
    Mem.varsLast(rest, r, if Mem.inList(r, regions) && last > m then last else m)

def Mem.rowsIn(rows: Coll.List[Mem.Row], f: Sym.Sym, m: I64): I64 = rows match
  case Coll.Nil => m
  case Coll.Cons(x, rest) =>
    val Mem.Row(line, g, _, _, _, _) = x
    Mem.rowsIn(rest, f, if Sym.eq(f, g) && line > m then line else m)

// the calls of def f that run in region r (callAt(f, line, r) facts of the M1 walk)
def Mem.callsIn(fs: Coll.List[D.Fact], f: Sym.Sym, r: I64, m: I64): I64 = fs match
  case Coll.Nil => m
  case Coll.Cons(x, rest) =>
    val D.Fact(rel, vals) = x
    Mem.callsIn(rest, f, r, if Sym.eq(rel, Mem.relSym(Mem.RCallAt)) then Mem.callAtLine(vals, f, r, m) else m)

def Mem.callAtLine(vals: Coll.List[D.Val], f: Sym.Sym, r: I64, m: I64): I64 = vals match
  case Coll.Cons(fv, t1) => t1 match
    case Coll.Cons(lv, t2) => t2 match
      case Coll.Cons(rv, _) => fv match
        case D.VSym(g) => lv match
          case D.VInt(line) => rv match
            case D.VInt(q) => if Sym.eq(f, g) && q == r && line > m then line else m
            case D.VSym(_) => m
          case D.VSym(_) => m
        case D.VInt(_) => m
      case Coll.Nil => m
    case Coll.Nil => m
  case Coll.Nil => m

// the var records by def
def Mem.varsByDef(vs: Coll.List[Mem.VarRec], acc: Coll.SMap[Coll.List[Mem.VarRec]]): Coll.SMap[Coll.List[Mem.VarRec]] = vs match
  case Coll.Nil => acc
  case Coll.Cons(v, rest) =>
    val Mem.VarRec(_, f, _, _, _, _, _) = v
    val xs: Coll.List[Mem.VarRec] = Coll.sLookup(acc, f) match
      case Coll.Some(ys) => ys
      case Coll.None => Coll.Nil
    Mem.varsByDef(rest, Coll.sInsert(acc, f, Coll.Cons(v, xs)))

// the moves across a call: marg(M, G, P) an arg node into its callee's param, mres(X, G, C) a callee's result into its
// call (vars: M 3, G 6, I 7, C 8, P 0, X 11)
def Mem.moveRules(): Coll.List[D.Rule] =
  val arg = D.Rule(Mem.eAtom(Mem.EMArg, Coll.Cons(Mem.v(3), Coll.Cons(Mem.v(6), Mem.nN()))), Mem.lits2(D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n1(3, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n1(8, Coll.Nil)))))), D.Pos(Mem.eAtom(Mem.EParam, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.nN()))))))
  val res = D.Rule(Mem.eAtom(Mem.EMRes, Coll.Cons(Mem.v(11), Coll.Cons(Mem.v(6), Mem.n1(8, Coll.Nil)))), Mem.lits2(D.Pos(Mem.eAtom(Mem.ERetOf, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(11), Coll.Nil)))), D.Pos(Mem.eAtom(Mem.ECallOf, Mem.n1(8, Coll.Cons(Mem.v(6), Coll.Nil))))))
  Coll.Cons(arg, Coll.Cons(res, Coll.Nil))

// the (from, def, to) rows of a move relation as moves of kind k, onto acc
def Mem.movesOf(ts: Coll.List[Coll.List[D.Val]], k: Mem.MoveK, acc: Coll.List[Mem.Move]): Coll.List[Mem.Move] = ts match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) => Mem.movesOf(rest, k, Mem.moveRow(t, k, acc))

def Mem.moveRow(t: Coll.List[D.Val], k: Mem.MoveK, acc: Coll.List[Mem.Move]): Coll.List[Mem.Move] = t match
  case Coll.Cons(a, t1) => t1 match
    case Coll.Cons(g, t2) => t2 match
      case Coll.Cons(b, _) => a match
        case D.VInt(i) => g match
          case D.VSym(d) => b match
            case D.VInt(j) => Coll.Cons(Mem.Move(k, d, i, j), acc)
            case D.VSym(_) => acc
          case D.VInt(_) => acc
        case D.VSym(_) => acc
      case Coll.Nil => acc
    case Coll.Nil => acc
  case Coll.Nil => acc

// rin(N, R): node N can hold a box of region R (R = a handled region id; vars 12 = R, 13 = M1 site, 14 = escape site).
// A site node holds its site's regions (esm joins the escape walk's site to the M1 walk's, fills gives the regions);
// then the edges of shared: flow, arg into param, a callee's result into its call
//   rin(N, R) :- esiteNode(E, N), esm(E, S), fills(S, R) | flow(M, N), rin(M, R)
//              | argOf(M, G, I, C), rin(M, R), param(G, I, N)
//              | snewRet(G), ecallee(G, N), ecallKey(N, F, L), callAt(F, L, R)              (the call runs in R)
//              | snewRet(G), ecallee(G, N), ecallKey(N, F, L), callFreeAt(F, L), run(F, R)  (in a region F runs in)
//              | argOf(M, G, I, N), rin(M, R), retP(G, I)                                   (an arg reaches the result)
// own(N, R): the region of the box made at site node N itself (the seed alone: a field move stores into it)
def Mem.rinRules(): Coll.List[D.Rule] =
  val r12 = Coll.Cons(Mem.v(12), Coll.Nil)
  val head = Mem.eAtom(Mem.ERin, Mem.n1(0, r12))
  // written order is the probe order: esm first, so each delta (esm, fills or esiteNode) probes with a bound column
  val seed = D.Rule(head, Mem.lits3(D.Pos(Mem.eAtom(Mem.ESm, Coll.Cons(Mem.v(14), Coll.Cons(Mem.v(13), Coll.Nil)))), D.Pos(D.Atom(Mem.relSym(Mem.RFills), Coll.Cons(Mem.v(13), r12))), D.Pos(Mem.eAtom(Mem.ESiteNode, Coll.Cons(Mem.v(14), Mem.nN())))))
  val flow = D.Rule(head, Mem.lits2(D.Pos(Mem.eAtom(Mem.EFlow, Mem.n1(3, Mem.n1(0, Coll.Nil)))), D.Pos(Mem.eAtom(Mem.ERin, Mem.n1(3, r12)))))
  val arg = D.Rule(head, Mem.lits3(D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n1(3, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n1(8, Coll.Nil)))))), D.Pos(Mem.eAtom(Mem.ERin, Mem.n1(3, r12))), D.Pos(Mem.eAtom(Mem.EParam, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.nN()))))))
  // a call's result, by call (context-sensitive): boxes of the region the call runs in (ecallIn: a handled region;
  // ecallFree: a region its def runs in; the callee may build its result there), and what an arg brings when the arg
  // reaches the callee's result (retP). Vars: G 6, I 7, C 0, M 3, F 15
  val ret1 = D.Rule(head, Mem.lit1(D.Pos(Mem.eAtom(Mem.ECallIn, Mem.n1(0, r12)))))
  val ret2 = D.Rule(head, Mem.lits2(D.Pos(Mem.eAtom(Mem.ECallFree, Mem.n1(0, Coll.Cons(Mem.v(15), Coll.Nil)))), D.Pos(D.Atom(Mem.relSym(Mem.RRun), Coll.Cons(Mem.v(15), r12)))))
  val ret3 = D.Rule(head, Mem.lits3(D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n1(3, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.nN()))))), D.Pos(Mem.eAtom(Mem.ERin, Mem.n1(3, r12))), Mem.gi(Mem.ERetP)))
  val own = D.Rule(Mem.eAtom(Mem.EOwn, Mem.n1(0, r12)), Mem.lits3(D.Pos(Mem.eAtom(Mem.ESm, Coll.Cons(Mem.v(14), Coll.Cons(Mem.v(13), Coll.Nil)))), D.Pos(D.Atom(Mem.relSym(Mem.RFills), Coll.Cons(Mem.v(13), r12))), D.Pos(Mem.eAtom(Mem.ESiteNode, Coll.Cons(Mem.v(14), Mem.nN())))))
  Coll.Cons(own, Coll.Cons(seed, Coll.Cons(flow, Coll.Cons(arg, Coll.Cons(ret1, Coll.Cons(ret2, Coll.Cons(ret3, Coll.Nil)))))))

// esm(E, S): escape site E is M1 site S (the same def, line and ctor; two sites alike share their regions)
def Mem.esmFacts(es: Coll.List[Mem.ESite], byDef: Coll.SMap[Coll.List[Mem.KSite]], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = es match
  case Coll.Nil => acc
  case Coll.Cons(e, rest) =>
    val Mem.ESite(id, f, line, ctor) = e
    val ks: Coll.List[Mem.KSite] = Coll.sLookup(byDef, f) match
      case Coll.Some(xs) => xs
      case Coll.None => Coll.Nil
    val acc2: Coll.List[D.Fact] = Mem.kFind(ks, line, ctor) match
      case Coll.Some(s) => Coll.Cons(D.Fact(Mem.eSym(Mem.ESm), Coll.Cons(D.VInt(id), Coll.Cons(D.VInt(s), Coll.Nil))), acc)
      case Coll.None => acc
    Mem.esmFacts(rest, byDef, acc2)

// an M1 site by its line and ctor
enum Mem.KSite:
  case Mem.KSite(line: I64, ctor: Sym.Sym, id: I64, loop: Bool)

def Mem.kFind(ks: Coll.List[Mem.KSite], line: I64, ctor: Sym.Sym): Coll.Option[I64] = ks match
  case Coll.Nil => Coll.None
  case Coll.Cons(k, rest) =>
    val Mem.KSite(l, c, id, _) = k
    if l == line && Sym.eq(c, ctor) then Coll.Some(id) else Mem.kFind(rest, line, ctor)

// the M1 sites 0 .. ns - 1 by def
def Mem.sitesByDef(ss: Coll.IMap[Mem.Site], i: I64, ns: I64, acc: Coll.SMap[Coll.List[Mem.KSite]]): Coll.SMap[Coll.List[Mem.KSite]] =
  if i == ns then acc else Mem.sitesByDef(ss, i + 1, ns, Mem.addKSite(ss, i, acc))

def Mem.addKSite(ss: Coll.IMap[Mem.Site], i: I64, acc: Coll.SMap[Coll.List[Mem.KSite]]): Coll.SMap[Coll.List[Mem.KSite]] = Coll.lookup(ss, i) match
  case Coll.Some(s) =>
    val Mem.Site(f, line, ctor, loop) = s
    val xs: Coll.List[Mem.KSite] = Coll.sLookup(acc, f) match
      case Coll.Some(ys) => ys
      case Coll.None => Coll.Nil
    Coll.sInsert(acc, f, Coll.Cons(Mem.KSite(line, ctor, i, loop), xs))
  case Coll.None => acc

def Mem.sharedRules(): Coll.List[D.Rule] =
  val head = D.Atom(Mem.s7(Mem.RShared7), Mem.nN())
  val r1 = D.Rule(head, Mem.lit1(D.Pos(D.Atom(Mem.s7(Mem.RMulti7), Mem.nN()))))
  val r2 = D.Rule(head, Mem.lit1(D.Pos(D.Atom(Mem.s7(Mem.RUnknown7), Mem.nN()))))
  val r3 = D.Rule(head, Mem.lits2(D.Pos(Mem.eAtom(Mem.EFlow, Mem.n1(3, Mem.n1(0, Coll.Nil)))), Mem.sh(Mem.n1(3, Coll.Nil))))
  val r4 = D.Rule(head, Mem.lits3(D.Pos(Mem.eAtom(Mem.EArgOf, Mem.n1(3, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.n1(8, Coll.Nil)))))), Mem.sh(Mem.n1(3, Coll.Nil)), D.Pos(Mem.eAtom(Mem.EParam, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(7), Mem.nN()))))))
  // written order is the probe order of the other atoms: retOf first, so callOf is probed with G bound
  val retOf = D.Pos(Mem.eAtom(Mem.ERetOf, Coll.Cons(Mem.v(6), Coll.Cons(Mem.v(11), Coll.Nil))))
  val r5 = D.Rule(head, Mem.lits3(retOf, Mem.sh(Coll.Cons(Mem.v(11), Coll.Nil)), D.Pos(Mem.eAtom(Mem.ECallOf, Mem.n1(0, Coll.Cons(Mem.v(6), Coll.Nil))))))
  Coll.Cons(r1, Coll.Cons(r2, Coll.Cons(r3, Coll.Cons(r4, Coll.Cons(r5, Coll.Nil)))))
// a reuse: the match at line in def f, on x, whose arm takes apart case c and builds ctor (a case of the same enum) at line at
// a reuse: the match at line, on x, whose arm takes apart case c and builds ctor (a case of the same enum)
enum Mem.Reuse:
  case Mem.Reuse(line: I64, f: Sym.Sym, x: Sym.Sym, c: Sym.Sym, ctor: Sym.Sym, at: I64)

// a box an arm builds: its line and ctor
enum Mem.Built:
  case Mem.Built(line: I64, ctor: Sym.Sym)

// shared var nodes by def: def -> the names shared in it
def Mem.sharedSet(vars: Coll.BMap[Mem.VarOf], ts: Coll.List[Coll.List[D.Val]], m: Coll.SMap[Coll.SMap[Bool]]): Coll.SMap[Coll.SMap[Bool]] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(v, _) => v match
      case D.VInt(i) => Mem.sharedSet(vars, rest, Mem.addShared(vars, m, i))
      case D.VSym(_) => Mem.sharedSet(vars, rest, m)
    case Coll.Nil => Mem.sharedSet(vars, rest, m)

// a shared node that is a var: its def and name into m (a site or call node is never a scrutinee name)
def Mem.addShared(vars: Coll.BMap[Mem.VarOf], m: Coll.SMap[Coll.SMap[Bool]], i: I64): Coll.SMap[Coll.SMap[Bool]] =
  Coll.bLookup(vars, i) match
    case Coll.Some(vo) =>
      val Mem.VarOf(f, n) = vo
      val inner: Coll.SMap[Bool] = Coll.sLookup(m, f) match
        case Coll.Some(s) => s
        case Coll.None => Coll.sEmpty()
      Coll.sInsert(m, f, Coll.sInsert(inner, n, true))
    case Coll.None => m

def Mem.isShared(sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, x: Sym.Sym): Bool = Coll.sLookup(sh, f) match
  case Coll.Some(s) => Mem.isIn(s, x)
  case Coll.None => false

// each case's enum
def Mem.caseEnums(ds: Coll.List[Ast.Decl], m: Coll.SMap[Sym.Sym]): Coll.SMap[Sym.Sym] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DEnum(e) =>
      val Ast.Enum(_, en, _, cases) = e
      Mem.caseEnums(rest, Mem.casesOf(cases, en, m))
    case _ => Mem.caseEnums(rest, m)

def Mem.casesOf(cs: Coll.List[Ast.Case], en: Sym.Sym, m: Coll.SMap[Sym.Sym]): Coll.SMap[Sym.Sym] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    Mem.casesOf(rest, en, Coll.sInsert(m, n, en))

def Mem.sameEnum(ce: Coll.SMap[Sym.Sym], a: Sym.Sym, b: Sym.Sym): Bool = Coll.sLookup(ce, a) match
  case Coll.Some(x) => Coll.sLookup(ce, b) match
    case Coll.Some(y) => Sym.eq(x, y)
    case Coll.None => false
  case Coll.None => false

def Mem.scanFns(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], fs: Coll.List[Ast.Fn], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, _, _, _, body) = f
    val acc2: Coll.List[Mem.Reuse] = body match
      case Ast.Def(_, e) => Mem.scan(ce, cx, sh, n, e, acc)
      case Ast.Extern(_) => acc
    Mem.scanFns(ce, cx, sh, rest, acc2)

// every match on an unshared var: each arm on a case with fields pairs with the first box of the same enum its body builds
def Mem.scan(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, e: Ast.Expr, acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = e match
  case Ast.Match(line, s, arms) =>
    val acc2: Coll.List[Mem.Reuse] = s match
      case Ast.Name(_, x) => if Mem.isShared(sh, f, x) then acc else Mem.armReuse(ce, cx, f, line, x, arms, acc)
      case _ => acc
    Mem.scanArms(ce, cx, sh, f, arms, Mem.scan(ce, cx, sh, f, s, acc2))
  case Ast.Call(_, _, _, _, args) => Mem.scanAll(ce, cx, sh, f, args, acc)
  case Ast.Method(_, _, _, args) => Mem.scanAll(ce, cx, sh, f, args, acc)
  case Ast.Resume(_, _, x) => Mem.scan(ce, cx, sh, f, x, acc)
  case Ast.Bin(_, _, l, r) => Mem.scan(ce, cx, sh, f, r, Mem.scan(ce, cx, sh, f, l, acc))
  case Ast.Un(_, _, x) => Mem.scan(ce, cx, sh, f, x, acc)
  case Ast.If(_, c, t, x) => Mem.scanAll(ce, cx, sh, f, Coll.Cons(c, Coll.Cons(t, Coll.Cons(x, Coll.Nil))), acc)
  case Ast.Block(_, ss, last) => Mem.scan(ce, cx, sh, f, last, Mem.scanStmts(ce, cx, sh, f, ss, acc))
  case Ast.While(_, c, b) => Mem.scan(ce, cx, sh, f, b, Mem.scan(ce, cx, sh, f, c, acc))
  case Ast.Assign(_, _, x) => Mem.scan(ce, cx, sh, f, x, acc)
  case _ => acc

def Mem.scanAll(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, es: Coll.List[Ast.Expr], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = es match
  case Coll.Nil => acc
  case Coll.Cons(e, rest) => Mem.scanAll(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))

def Mem.scanArms(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = arms match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, b) = a
    Mem.scanArms(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, b, acc))

def Mem.scanStmts(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, sh: Coll.SMap[Coll.SMap[Bool]], f: Sym.Sym, ss: Coll.List[Ast.Stmt], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, _, e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))
    case Ast.Var(_, _, _, e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))
    case Ast.Handle(_, _, _, args) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scanAll(ce, cx, sh, f, args, acc))
    case Ast.Do(e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))
    case Ast.Check(_, _, e) => Mem.scanStmts(ce, cx, sh, f, rest, Mem.scan(ce, cx, sh, f, e, acc))

def Mem.armReuse(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, f: Sym.Sym, line: I64, x: Sym.Sym, arms: Coll.List[Ast.Arm], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = arms match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, b) = a
    val acc2: Coll.List[Mem.Reuse] = p match
      case Ast.PCase(c, _) =>
        val Mem.Cx(_, ctors, _, _, _, _) = cx
        val k: Coll.Option[Mem.Built] = if Mem.allocates(ctors, c) then Mem.firstBuild(ce, cx, c, b) else Coll.None
        k match
          case Coll.Some(kk) =>
            val Mem.Built(at, kc) = kk
            Coll.Cons(Mem.Reuse(line, f, x, c, kc, at), acc)
          case Coll.None => acc
      case Ast.PAny => acc
    Mem.armReuse(ce, cx, f, line, x, rest, acc2)

// the first box of c's enum that e builds, in evaluation order
def Mem.firstBuild(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, c: Sym.Sym, e: Ast.Expr): Coll.Option[Mem.Built] = e match
  case Ast.Call(gl, g, _, _, args) =>
    val Mem.Cx(_, ctors, _, _, _, _) = cx
    Mem.firstOf(ce, cx, c, args) match
      case Coll.Some(k) => Coll.Some(k)
      case Coll.None => if Mem.allocates(ctors, g) && Mem.sameEnum(ce, c, g) then Coll.Some(Mem.Built(gl, g)) else Coll.None
  case Ast.If(_, _, t, x) => Mem.firstOf(ce, cx, c, Coll.Cons(t, Coll.Cons(x, Coll.Nil)))
  case Ast.Block(_, _, last) => Mem.firstBuild(ce, cx, c, last)
  case _ => Coll.None

def Mem.firstOf(ce: Coll.SMap[Sym.Sym], cx: Mem.Cx, c: Sym.Sym, es: Coll.List[Ast.Expr]): Coll.Option[Mem.Built] = es match
  case Coll.Nil => Coll.None
  case Coll.Cons(e, rest) => Mem.firstBuild(ce, cx, c, e) match
    case Coll.Some(k) => Coll.Some(k)
    case Coll.None => Mem.firstOf(ce, cx, c, rest)

// a reuse writes the new box into x's cell, so the box lives in x's region: ok when each region x can hold outlives (or
// is) each region the box would be made in; unknown when either set is empty (no proof); ambiguous when its def has
// two boxes of the ctor on the line (which one the arm builds is not known); inLoop when a loop of its def holds the
// box (each turn would overwrite the cell)
enum Mem.RV:
  case Mem.ROk
  case Mem.RShorter(x: I64, box: I64)
  case Mem.RUnknown
  case Mem.RAmbiguous
  case Mem.RInLoop

enum Mem.ReuseRec:
  case Mem.ReuseRec(r: Mem.Reuse, xr: Coll.List[I64], br: Coll.List[I64], v: Mem.RV)

// the region facts of a reuse: x's var node regions (rin) and the regions of its box's M1 site (fills)
enum Mem.RegionsOf:
  case Mem.RegionsOf(defs: Coll.SMap[Mem.DefIds], rin: Coll.IMap[Coll.List[I64]], fills: Coll.IMap[Coll.List[I64]], byDef: Coll.SMap[Coll.List[Mem.KSite]], outl: Coll.IMap[Coll.List[I64]])

def Mem.reuseRecs(rs: Coll.List[Mem.Reuse], ro: Mem.RegionsOf, acc: Coll.List[Mem.ReuseRec]): Coll.List[Mem.ReuseRec] = rs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(r, rest) =>
    val Mem.Reuse(_, f, x, _, k, at) = r
    val Mem.RegionsOf(defs, rin, fills, byDef, outl) = ro
    val Mem.DefIds(names, _) = Mem.defIds(defs, f)
    val xr: Coll.List[I64] = Coll.sLookup(names, x) match
      case Coll.Some(i) => Mem.idsOf(rin, i)
      case Coll.None => Coll.Nil
    val ks: Coll.List[Mem.KSite] = Coll.sLookup(byDef, f) match
      case Coll.Some(xs) => xs
      case Coll.None => Coll.Nil
    val same = Mem.kAll(ks, at, k, Coll.Nil)
    val br: Coll.List[I64] = same match
      case Coll.Cons(s, _) =>
        val Mem.KSite(_, _, id, _) = s
        Mem.idsOf(fills, id)
      case Coll.Nil => Coll.Nil
    Mem.reuseRecs(rest, ro, Coll.Cons(Mem.ReuseRec(r, xr, br, Mem.reuseVerdict(same, xr, br, outl)), acc))

// the M1 sites of ks at line with ctor
def Mem.kAll(ks: Coll.List[Mem.KSite], line: I64, ctor: Sym.Sym, acc: Coll.List[Mem.KSite]): Coll.List[Mem.KSite] = ks match
  case Coll.Nil => acc
  case Coll.Cons(k, rest) =>
    val Mem.KSite(l, c, _, _) = k
    Mem.kAll(rest, line, ctor, if l == line && Sym.eq(c, ctor) then Coll.Cons(k, acc) else acc)

def Mem.inLoop(same: Coll.List[Mem.KSite]): Bool = same match
  case Coll.Nil => false
  case Coll.Cons(k, rest) =>
    val Mem.KSite(_, _, _, loop) = k
    loop || Mem.inLoop(rest)

def Mem.reuseVerdict(same: Coll.List[Mem.KSite], xr: Coll.List[I64], br: Coll.List[I64], outl: Coll.IMap[Coll.List[I64]]): Mem.RV =
  if Coll.length(same) > 1 then Mem.RAmbiguous
  else if Mem.inLoop(same) then Mem.RInLoop
  else if Coll.length(xr) == 0 || Coll.length(br) == 0 then Mem.RUnknown
  else
    val s: Mem.Safe = Mem.safeAll(xr, br, outl)
    s match
      case Mem.Shorter(a, b) => Mem.RShorter(a, b)
      case Mem.Outlives => Mem.ROk
      case Mem.NoStore => Mem.ROk

// ── M13 (the mem optimization): the box an arm builds goes into the matched box's cell where the verdict is ok ──
// a reuse to emit: the line of the box its arm builds, and its ctor (the match is the key)
enum Mem.ReuseAt:
  case Mem.ReuseAt(at: I64, ctor: Sym.Sym)

// the ok reuses by match line
def Mem.reuseTable(r: Mem.Report): Coll.IMap[Mem.ReuseAt] = r match
  case Mem.Ok(_, _, _, _, rs, _, _, _) => Mem.okReuses(rs, Coll.Tip)
  case Mem.RulesBad(_) => Coll.Tip

def Mem.okReuses(rs: Coll.List[Mem.ReuseRec], m: Coll.IMap[Mem.ReuseAt]): Coll.IMap[Mem.ReuseAt] = rs match
  case Coll.Nil => m
  case Coll.Cons(rr, rest) =>
    val Mem.ReuseRec(r, _, _, v) = rr
    val Mem.Reuse(line, _, _, _, k, at) = r
    val m2: Coll.IMap[Mem.ReuseAt] = v match
      case Mem.ROk => Coll.insert(m, line, Mem.ReuseAt(at, k))
      case _ => m
    Mem.okReuses(rest, m2)

// inside the arms of a reused match on local x of type ty: the box at line at with ctor ctor goes into x's cell when it
// has type ty too (one generic case at two type args is two C structs, of two sizes)
enum Mem.Cell:
  case Mem.Cell(x: Sym.Sym, ty: K.Term, at: I64, ctor: Sym.Sym)

def Mem.intoRes(res: Ty.Result, t: Coll.IMap[Mem.ReuseAt]): Ty.Result =
  val Ty.Result(cl, is, s, fs, hs, gvs) = res
  Ty.Result(cl, is, s, Mem.intoFns(fs, t), hs, gvs)

def Mem.intoFns(fs: Coll.List[El.Fn], t: Coll.IMap[Mem.ReuseAt]): Coll.List[El.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val El.Fn(l, n, tps, caps, ps, ret, body) = f
    val b2: El.Body = body match
      case El.Def(e) => El.Def(Mem.intoE(t, Coll.None, e))
      case El.Extern(_, _) => body
    Coll.Cons(El.Fn(l, n, tps, caps, ps, ret, b2), Mem.intoFns(rest, t))

def Mem.intoE(t: Coll.IMap[Mem.ReuseAt], cell: Coll.Option[Mem.Cell], e: El.Expr): El.Expr = e match
  case El.New(l, en, ts, c, at, args) =>
    val args2 = Mem.intoEs(t, cell, args)
    val at2: El.Alloc = cell match
      case Coll.Some(cl) =>
        val Mem.Cell(x, ty, a, k) = cl
        if l == a && Sym.eq(c, k) && Mem.termEq(K.Con(en, ts), ty) then El.Into(x) else at
      case Coll.None => at
    El.New(l, en, ts, c, at2, args2)
  case El.Match(l, x, en, arms) =>
    val cell2: Coll.Option[Mem.Cell] = x match
      case El.Local(_, v) => Coll.lookup(t, l) match
        case Coll.Some(ra) =>
          val Mem.ReuseAt(a, k) = ra
          Coll.Some(Mem.Cell(v, en, a, k))
        case Coll.None => cell
      case _ => cell
    El.Match(l, Mem.intoE(t, cell, x), en, Mem.intoArms(t, cell2, arms))
  case El.CallFn(l, f, ts, caps, args) => El.CallFn(l, f, ts, caps, Mem.intoEs(t, cell, args))
  case El.MHandled(l, x, h, caps, args, rest, a, ans) => El.MHandled(l, x, h, caps, Mem.intoEs(t, cell, args), Mem.intoE(t, cell, rest), a, ans)
  case El.Resume(l, k, x) => El.Resume(l, k, Mem.intoE(t, cell, x))
  case El.Op(l, recv, ty, op, args, cs) => El.Op(l, recv, ty, op, Mem.intoEs(t, cell, args), cs)
  case El.TCall(l, ty, op, caps, args) => El.TCall(l, ty, op, caps, Mem.intoEs(t, cell, args))
  case El.Bin(l, op, a, b) => El.Bin(l, op, Mem.intoE(t, cell, a), Mem.intoE(t, cell, b))
  case El.Un(l, op, x) => El.Un(l, op, Mem.intoE(t, cell, x))
  case El.If(l, c, th, x) => El.If(l, Mem.intoE(t, cell, c), Mem.intoE(t, cell, th), Mem.intoE(t, cell, x))
  case El.Block(l, ss, last) => El.Block(l, Mem.intoSs(t, cell, ss), Mem.intoE(t, Mem.cellAfter(cell, ss), last))
  case El.While(l, c, b) => El.While(l, Mem.intoE(t, cell, c), Mem.intoE(t, cell, b))
  case El.Assign(l, x, v) => El.Assign(l, x, Mem.intoE(t, cell, v))
  case El.Index(l, x, i) => El.Index(l, x, Mem.intoE(t, cell, i))
  case El.Slice(l, x, o) => El.Slice(l, Mem.intoE(t, cell, x), Mem.intoE(t, cell, o))
  case El.Fill(l, r, n, x, a) => El.Fill(l, r, Mem.intoE(t, cell, n), Mem.intoE(t, cell, x), a)
  case El.Tab(l, r, n, a, i, g) => El.Tab(l, r, Mem.intoE(t, cell, n), a, i, Mem.intoE(t, cell, g))
  case El.CellNew(l, r, v, a) => El.CellNew(l, r, Mem.intoE(t, cell, v), a)
  case El.CellGet(l, c) => El.CellGet(l, Mem.intoE(t, cell, c))
  case El.CField(l, c, n, f, ty) => El.CField(l, Mem.intoE(t, cell, c), n, f, ty)
  case El.CellPut(l, c, v, d) => El.CellPut(l, Mem.intoE(t, cell, c), Mem.intoE(t, cell, v), d)
  case El.ArrPut(l, x, i, v) => El.ArrPut(l, x, Mem.intoE(t, cell, i), Mem.intoE(t, cell, v))
  case El.Blit(l, x, a, b, k) => El.Blit(l, x, Mem.intoE(t, cell, a), Mem.intoE(t, cell, b), Mem.intoE(t, cell, k))
  case _ => e

def Mem.intoEs(t: Coll.IMap[Mem.ReuseAt], cell: Coll.Option[Mem.Cell], es: Coll.List[El.Expr]): Coll.List[El.Expr] = es match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(x, rest) => Coll.Cons(Mem.intoE(t, cell, x), Mem.intoEs(t, cell, rest))

def Mem.intoArms(t: Coll.IMap[Mem.ReuseAt], cell: Coll.Option[Mem.Cell], as: Coll.List[El.Arm]): Coll.List[El.Arm] = as match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(a, rest) =>
    val El.Arm(l, p, b) = a
    val cell2: Coll.Option[Mem.Cell] = p match
      case Ast.PCase(_, xs) => Mem.unless(cell, xs)
      case Ast.PAny => cell
    Coll.Cons(El.Arm(l, p, Mem.intoE(t, cell2, b)), Mem.intoArms(t, cell, rest))

// cell, unless one of xs rebinds its var (then the name is no longer the matched box)
def Mem.unless(cell: Coll.Option[Mem.Cell], xs: Coll.List[Sym.Sym]): Coll.Option[Mem.Cell] = cell match
  case Coll.Some(cl) =>
    val Mem.Cell(x, _, _, _) = cl
    if Mem.symIn(x, xs) then Coll.None else cell
  case Coll.None => cell

def Mem.symIn(x: Sym.Sym, xs: Coll.List[Sym.Sym]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(y, rest) => Sym.eq(x, y) || Mem.symIn(x, rest)

// two types are the same term (a type var only equals itself)
def Mem.termEq(a: K.Term, b: K.Term): Bool = a match
  case K.Var(n) => b match
    case K.Var(m) => n == m
    case _ => false
  case K.Int(v) => b match
    case K.Int(w) => v == w
    case _ => false
  case K.Con(f, xs) => b match
    case K.Con(g, ys) => Sym.eq(f, g) && Mem.termsEq(xs, ys)
    case _ => false

def Mem.termsEq(xs: Coll.List[K.Term], ys: Coll.List[K.Term]): Bool = xs match
  case Coll.Nil => ys match
    case Coll.Nil => true
    case Coll.Cons(_, _) => false
  case Coll.Cons(x, xr) => ys match
    case Coll.Nil => false
    case Coll.Cons(y, yr) => Mem.termEq(x, y) && Mem.termsEq(xr, yr)

// cell after the statements of a block (a val or handle that rebinds its var ends it)
def Mem.cellAfter(cell: Coll.Option[Mem.Cell], ss: Coll.List[El.Stmt]): Coll.Option[Mem.Cell] = ss match
  case Coll.Nil => cell
  case Coll.Cons(s, rest) => s match
    case El.Val(_, x, _, _, _) => Mem.cellAfter(Mem.unless(cell, Coll.Cons(x, Coll.Nil)), rest)
    case El.Handle(_, x, _, _, _) => Mem.cellAfter(Mem.unless(cell, Coll.Cons(x, Coll.Nil)), rest)
    case El.Do(_) => Mem.cellAfter(cell, rest)

def Mem.intoSs(t: Coll.IMap[Mem.ReuseAt], cell: Coll.Option[Mem.Cell], ss: Coll.List[El.Stmt]): Coll.List[El.Stmt] = ss match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) => s match
    case El.Val(l, x, ty, mut, v) => Coll.Cons(El.Val(l, x, ty, mut, Mem.intoE(t, cell, v)), Mem.intoSs(t, Mem.unless(cell, Coll.Cons(x, Coll.Nil)), rest))
    case El.Handle(l, x, h, caps, args) => Coll.Cons(El.Handle(l, x, h, caps, Mem.intoEs(t, cell, args)), Mem.intoSs(t, Mem.unless(cell, Coll.Cons(x, Coll.Nil)), rest))
    case El.Do(v) => Coll.Cons(El.Do(Mem.intoE(t, cell, v)), Mem.intoSs(t, cell, rest))

// reuses by line (line * n + i is unique: i < n)
def Mem.byReuseLine(rs: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] =
  val Coll.Sorted(xs) = Coll.sortDedup(Mem.reuseKeys(rs, Coll.length(rs) + 1, 0, Coll.Nil))
  Mem.reuseVals(xs, Coll.Nil)

def Mem.reuseKeys(rs: Coll.List[Mem.Reuse], n: I64, i: I64, acc: Coll.List[Coll.KV[Mem.Reuse]]): Coll.List[Coll.KV[Mem.Reuse]] = rs match
  case Coll.Nil => acc
  case Coll.Cons(r, rest) =>
    val Mem.Reuse(line, _, _, _, _, _) = r
    Mem.reuseKeys(rest, n, i + 1, Coll.Cons(Coll.KV(line * n + i, r), acc))

def Mem.reuseVals(xs: Coll.List[Coll.KV[Mem.Reuse]], acc: Coll.List[Mem.Reuse]): Coll.List[Mem.Reuse] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(_, r) = kv
    Mem.reuseVals(rest, Coll.Cons(r, acc))

// a value of unknown origin (an op or extern result, a read xs(i) of a local array: the array keeps its element): its
// node, seeded shared for M7
def Mem.unknown(w: Mem.EW, n: Mem.Node): Mem.EV = Mem.EV(Mem.eFact(w, Mem.FUnknown(n)), Coll.Cons(n, Coll.Nil))

// the args a box holds: those of its fields whose type can hold a box (a scalar field holds a number, not a reference);
// (an Array.fill or Array.tabulate is no case: it holds every arg but its length)
def Mem.boxed(nss: Coll.List[Coll.List[Mem.Node]], fields: Coll.List[Ast.Binder], acc: Coll.List[Coll.List[Mem.Node]]): Coll.List[Coll.List[Mem.Node]] = nss match
  case Coll.Nil => acc
  case Coll.Cons(ns, rest) => fields match
    case Coll.Cons(fd, frest) =>
      val Ast.Binder(_, _, t) = fd
      Mem.boxed(rest, frest, if Mem.scalar(t) then acc else Coll.Cons(ns, acc))
    case Coll.Nil => Mem.boxed(rest, Coll.Nil, Coll.Cons(ns, acc))

// ── M6a: which defs can run in a scratch region and copy out their result (vic/c/mem-design.md M6) ──
// F can when its run makes an unbounded number of boxes, no box of its run reaches a sink, and its result can hold boxes
// of its run: the copy of the result (into the caller's region) is then all that outlives the run, and the scratch
// region with the rest is freed. Report only (M6b writes the copy).
//   unb(G) :- self(G), allocs(G) | loopAlloc(G) | call(G, H), unb(H)
//   need(F) :- call(F, G), unb(G) | loopAlloc(F)
// not a candidate: a def with a self call (a handle in its block stops the self tail call from being a C loop), main,
// a def that opens a region, the prelude's own Srs.* code, a def with a {} binder (two Regions in scope).
enum Mem.SRel:
  case Mem.SSelf
  case Mem.SAllocs
  case Mem.SLoopAlloc
  case Mem.SUnb
  case Mem.SNeed
  case Mem.SRunSink
  case Mem.SNewRet

def Mem.sSym(r: Mem.SRel): Sym.Sym = r match
  case Mem.SSelf => Sym.of("sself")
  case Mem.SAllocs => Sym.of("sallocs")
  case Mem.SLoopAlloc => Sym.of("sloopAlloc")
  case Mem.SUnb => Sym.of("sunb")
  case Mem.SNeed => Sym.of("sneed")
  case Mem.SRunSink => Sym.of("srunSink")
  case Mem.SNewRet => Sym.of("snewRet")

def Mem.sAtom(r: Mem.SRel, xs: Coll.List[I64]): D.Atom = D.Atom(Mem.sSym(r), Pure.vars(xs))

def Mem.sRules(): Coll.List[D.Rule] =
  val u1 = D.Rule(Mem.sAtom(Mem.SUnb, Pure.one(0)), Mem.lits2(D.Pos(Mem.sAtom(Mem.SSelf, Pure.one(0))), D.Pos(Mem.sAtom(Mem.SAllocs, Pure.one(0)))))
  val u2 = D.Rule(Mem.sAtom(Mem.SUnb, Pure.one(0)), Mem.lit1(D.Pos(Mem.sAtom(Mem.SLoopAlloc, Pure.one(0)))))
  val u3 = D.Rule(Mem.sAtom(Mem.SUnb, Pure.one(0)), Mem.lits2(Mem.pos(Mem.RCall, Pure.two(0, 1)), D.Pos(Mem.sAtom(Mem.SUnb, Pure.one(1)))))
  val n1 = D.Rule(Mem.sAtom(Mem.SNeed, Pure.one(0)), Mem.lits2(Mem.pos(Mem.RCall, Pure.two(0, 1)), D.Pos(Mem.sAtom(Mem.SUnb, Pure.one(1)))))
  val n2 = D.Rule(Mem.sAtom(Mem.SNeed, Pure.one(0)), Mem.lit1(D.Pos(Mem.sAtom(Mem.SLoopAlloc, Pure.one(0)))))
  Coll.Cons(u1, Coll.Cons(u2, Coll.Cons(u3, Coll.Cons(n1, Coll.Cons(n2, Mem.runRules())))))

def Mem.sFact1(r: Mem.SRel, a: Sym.Sym): D.Fact = D.Fact(Mem.sSym(r), Coll.Cons(D.VSym(a), Coll.Nil))

// the facts the compact rules add to the M1 walk's: call(F, G) with F == G gives sself (the rules read call itself);
// each site gives sallocs and, in a loop of its def, sloopAlloc
def Mem.sFacts(fs: Coll.List[D.Fact], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = fs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) =>
    val D.Fact(rel, vals) = x
    if Sym.eq(rel, Mem.relSym(Mem.RCall)) then Mem.sFacts(rest, Mem.selfOf(vals, acc)) else Mem.sFacts(rest, acc)

def Mem.selfOf(vals: Coll.List[D.Val], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = vals match
  case Coll.Cons(a, t) => t match
    case Coll.Cons(b, _) => if D.veq(a, b) then Coll.Cons(D.Fact(Mem.sSym(Mem.SSelf), Coll.Cons(a, Coll.Nil)), acc) else acc
    case Coll.Nil => acc
  case Coll.Nil => acc

def Mem.siteFacts(ss: Coll.List[Mem.Site], acc: Coll.List[D.Fact]): Coll.List[D.Fact] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) =>
    val Mem.Site(f, _, _, loop) = s
    val acc2 = Coll.Cons(Mem.sFact1(Mem.SAllocs, f), acc)
    Mem.siteFacts(rest, if loop then Coll.Cons(Mem.sFact1(Mem.SLoopAlloc, f), acc2) else acc2)

def Mem.siteList(m: Coll.IMap[Mem.Site], i: I64, n: I64, acc: Coll.List[Mem.Site]): Coll.List[Mem.Site] =
  if i == n then acc
  else Coll.lookup(m, i) match
    case Coll.Some(s) => Mem.siteList(m, i + 1, n, Coll.Cons(s, acc))
    case Coll.None => Mem.siteList(m, i + 1, n, acc)

def Mem.regionDefs(m: Coll.IMap[Mem.Region], i: I64, n: I64, acc: Coll.SMap[Bool]): Coll.SMap[Bool] =
  if i == n then acc
  else Coll.lookup(m, i) match
    case Coll.Some(r) =>
      val Mem.Region(f, _, _, _, _) = r
      Mem.regionDefs(m, i + 1, n, Coll.sInsert(acc, f, true))
    case Coll.None => Mem.regionDefs(m, i + 1, n, acc)

// a source list with a new box in it: a site of the def, or a call result that can hold one
// the program with a scratch region opened at the top of each chosen def
// a node N (var 1) of def F (var 0) of kind k: enode(N, F, k), then r(N)
def Mem.ofKind(r: Mem.ERel, k: I64): Coll.List[D.Lit] = Mem.lits2(D.Pos(Mem.eAtom(Mem.ENode, Coll.Cons(D.AVar(1), Coll.Cons(D.AVar(0), Coll.Cons(D.AVal(D.VInt(k)), Coll.Nil))))), D.Pos(Mem.eAtom(r, Coll.Cons(D.AVar(1), Coll.Nil))))

// runSink(F): a box made during F's run reaches a sink (in F or a callee); newRet(F): F's result can hold a box made
// during its run (a site or a call result of F reaches F's result)
def Mem.runRules(): Coll.List[D.Rule] =
  val f0 = Coll.Cons(D.AVar(0), Coll.Nil)
  val rs1 = D.Rule(Mem.sAtom(Mem.SRunSink, Pure.one(0)), Mem.ofKind(Mem.ESinkR, Mem.kSite()))
  val rs2 = D.Rule(Mem.sAtom(Mem.SRunSink, Pure.one(0)), Mem.ofKind(Mem.ESinkR, Mem.kCall()))
  val rs3 = D.Rule(Mem.sAtom(Mem.SRunSink, Pure.one(0)), Mem.lits2(Mem.pos(Mem.RCall, Pure.two(0, 1)), D.Pos(Mem.sAtom(Mem.SRunSink, Pure.one(1)))))
  val b1 = D.Rule(D.Atom(Mem.sSym(Mem.SNewRet), f0), Mem.ofKind(Mem.ERetR, Mem.kSite()))
  val b2 = D.Rule(D.Atom(Mem.sSym(Mem.SNewRet), f0), Mem.ofKind(Mem.ERetR, Mem.kCall()))
  Coll.Cons(rs1, Coll.Cons(rs2, Coll.Cons(rs3, Coll.Cons(b1, Coll.Cons(b2, Coll.Nil)))))

// a candidate: its name and line
enum Mem.Compact:
  case Mem.Compact(line: I64, f: Sym.Sym, runs: Mem.Runs)

// how often a def runs per life of its region: Once (no loop or recursion repeats it: not RManyDef) or Many
enum Mem.Runs:
  case Mem.RunsOnce
  case Mem.RunsMany

def Mem.pickCompacts(need: Coll.SMap[Bool], skip: Coll.SMap[Bool], newRet: Coll.SMap[Bool], many: Coll.SMap[Bool], fs: Coll.List[Ast.Fn], acc: Coll.List[Mem.Compact]): Coll.List[Mem.Compact] = fs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(f, rest) =>
    val Ast.Fn(line, n, gs, _, _, _, _) = f
    val x = Sym.str(n)
    val srs = Str.len(x) > 4 && Str.eq(Str.slice(x, 0, 4), "Srs.")
    val ok = Mem.isIn(need, n) && Mem.isIn(newRet, n) && !Mem.isIn(skip, n) && !Str.eq(x, "main") && !srs && !Mem.hasEvidence(gs)
    val runs: Mem.Runs = if Mem.isIn(many, n) then Mem.RunsMany else Mem.RunsOnce
    Mem.pickCompacts(need, skip, newRet, many, rest, if ok then Coll.Cons(Mem.Compact(line, n, runs), acc) else acc)

// a def with a {} binder: a second Region in its scope would make its implicit summons ambiguous (error[no-capability])
def Mem.hasEvidence(gs: Coll.List[Ast.Group]): Bool = gs match
  case Coll.Nil => false
  case Coll.Cons(g, rest) => g match
    case Ast.Evidence(bs) => bs match
      case Coll.Cons(_, _) => true
      case Coll.Nil => Mem.hasEvidence(rest)
    case Ast.Types(_) => Mem.hasEvidence(rest)
    case Ast.Facts(_) => Mem.hasEvidence(rest)

// the candidates main reaches, in order
def Mem.reachedOnly(cs: Coll.List[Mem.Compact], reached: Coll.SMap[Bool], acc: Coll.List[Mem.Compact]): Coll.List[Mem.Compact] = cs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(c, rest) =>
    val Mem.Compact(_, f, _) = c
    Mem.reachedOnly(rest, reached, if Mem.isIn(reached, f) then Coll.Cons(c, acc) else acc)

// ── the walk's facts, typed: a node is (def, key, kind) here; Mem.intern gives each node one id, so a probe on a node
// binds the column D indexes exactly (a def column first scanned every node of the def) ──
enum Mem.EF:
  case Mem.FFlow(a: Mem.Node, b: Mem.Node, k: Mem.MoveK)
  case Mem.FSink(a: Mem.Node)
  case Mem.FArgOf(a: Mem.Node, g: Sym.Sym, i: I64, c: Mem.Node)
  case Mem.FCallOf(c: Mem.Node, g: Sym.Sym)
  case Mem.FParam(g: Sym.Sym, i: I64, p: Mem.Node)
  case Mem.FRet(r: Mem.Node, f: Sym.Sym)
  case Mem.FSite(s: I64, f: Sym.Sym)
  case Mem.FMulti(a: Mem.Node)
  case Mem.FUnknown(a: Mem.Node)

enum Mem.DefIds:
  case Mem.DefIds(names: Coll.SMap[I64], byKind: Coll.IMap[Coll.IMap[I64]])

// how a value moves from one node to another: into a val or var, by assignment, into a pattern var, into a field of a
// new box, into the result of its def, into a callee's param, from a callee's result into its call
enum Mem.MoveK:
  case Mem.MBind
  case Mem.MAssign
  case Mem.MPattern
  case Mem.MField
  case Mem.MRet
  case Mem.MArg
  case Mem.MResult

// a move of kind k in def d from node id from to node id to
enum Mem.Move:
  case Mem.Move(k: Mem.MoveK, d: Sym.Sym, from: I64, to: I64)

// the ids given so far, the next, each var node's def and name newest first (sharing is read back by name), the facts,
// and the moves newest first
enum Mem.IT:
  case Mem.IT(defs: Coll.SMap[Mem.DefIds], next: I64, vars: Coll.List[Coll.KV[Mem.VarOf]], out: Coll.List[D.Fact], moves: Coll.List[Mem.Move])

enum Mem.VarOf:
  case Mem.VarOf(f: Sym.Sym, x: Sym.Sym)

enum Mem.Got:
  case Mem.Got(it: Mem.IT, id: I64)

def Mem.defIds(defs: Coll.SMap[Mem.DefIds], d: Sym.Sym): Mem.DefIds = Coll.sLookup(defs, d) match
  case Coll.Some(x) => x
  case Coll.None => Mem.DefIds(Coll.sEmpty(), Coll.Tip)

// the id of node n, new the first time; a node with an int key is found by its kind, then its key: a site and a call of
// the same number are two nodes. Only an int-keyed node gets an enode(N, def, kind) fact: Mem.ofKind reads sites and
// calls, and a var node (the only one keyed by a name) is read back through vars
def Mem.idOf(it: Mem.IT, n: Mem.Node): Mem.Got =
  val Mem.Node(k, d, x) = n
  val Mem.IT(defs, next, vars, out, mv) = it
  val Mem.DefIds(names, byKind) = Mem.defIds(defs, d)
  x match
    case D.VSym(s) => Coll.sLookup(names, s) match
      case Coll.Some(i) => Mem.Got(it, i)
      case Coll.None => Mem.Got(Mem.IT(Coll.sInsert(defs, d, Mem.DefIds(Coll.sInsert(names, s, next), byKind)), next + 1, Coll.Cons(Coll.KV(next, Mem.VarOf(d, s)), vars), out, mv), next)
    case D.VInt(v) =>
      val ints: Coll.IMap[I64] = Coll.lookup(byKind, k) match
        case Coll.Some(m) => m
        case Coll.None => Coll.Tip
      Coll.lookup(ints, v) match
        case Coll.Some(i) => Mem.Got(it, i)
        case Coll.None => Mem.Got(Mem.IT(Coll.sInsert(defs, d, Mem.DefIds(names, Coll.insert(byKind, k, Coll.insert(ints, v, next)))), next + 1, vars, Coll.Cons(D.Fact(Mem.eSym(Mem.ENode), Coll.Cons(D.VInt(next), Coll.Cons(D.VSym(d), Coll.Cons(D.VInt(k), Coll.Nil)))), out), mv), next)

def Mem.emit(it: Mem.IT, rel: Sym.Sym, vals: Coll.List[D.Val]): Mem.IT =
  val Mem.IT(defs, next, vars, out, mv) = it
  Mem.IT(defs, next, vars, Coll.Cons(D.Fact(rel, vals), out), mv)

def Mem.one(i: I64): Coll.List[D.Val] = Coll.Cons(D.VInt(i), Coll.Nil)

def Mem.intern(fs: Coll.List[Mem.EF], it: Mem.IT): Mem.IT = fs match
  case Coll.Nil => it
  case Coll.Cons(x, rest) => Mem.intern(rest, Mem.intern1(x, it))

def Mem.intern1(x: Mem.EF, it: Mem.IT): Mem.IT = x match
  case Mem.FFlow(a, b, k) =>
    val Mem.Got(it1, i) = Mem.idOf(it, a)
    val Mem.Got(it2, j) = Mem.idOf(it1, b)
    val Mem.IT(defs, next, vars, out, mv) = it2
    val Mem.Node(_, d, _) = b
    val kr: Mem.ERel = k match
      case Mem.MField => Mem.EField
      case Mem.MPattern => Mem.ELoad
      case _ => Mem.EAlias
    val out2 = Coll.Cons(D.Fact(Mem.eSym(kr), Coll.Cons(D.VInt(i), Mem.one(j))), Coll.Cons(D.Fact(Mem.eSym(Mem.EFlow), Coll.Cons(D.VInt(i), Mem.one(j))), out))
    Mem.IT(defs, next, vars, out2, Coll.Cons(Mem.Move(k, d, i, j), mv))
  case Mem.FSink(a) =>
    val Mem.Got(it1, i) = Mem.idOf(it, a)
    Mem.emit(it1, Mem.eSym(Mem.ESink), Mem.one(i))
  case Mem.FArgOf(a, g, k, c) =>
    val Mem.Got(it1, i) = Mem.idOf(it, a)
    val Mem.Got(it2, j) = Mem.idOf(it1, c)
    Mem.emit(it2, Mem.eSym(Mem.EArgOf), Coll.Cons(D.VInt(i), Coll.Cons(D.VSym(g), Coll.Cons(D.VInt(k), Mem.one(j)))))
  case Mem.FCallOf(c, g) =>
    val Mem.Got(it1, j) = Mem.idOf(it, c)
    Mem.emit(it1, Mem.eSym(Mem.ECallOf), Coll.Cons(D.VInt(j), Coll.Cons(D.VSym(g), Coll.Nil)))
  case Mem.FParam(g, k, p) =>
    val Mem.Got(it1, j) = Mem.idOf(it, p)
    Mem.emit(it1, Mem.eSym(Mem.EParam), Coll.Cons(D.VSym(g), Coll.Cons(D.VInt(k), Mem.one(j))))
  case Mem.FRet(r, f) =>
    val Mem.Got(it1, j) = Mem.idOf(it, r)
    Mem.emit(Mem.emit(it1, Mem.eSym(Mem.ERet), Mem.one(j)), Mem.eSym(Mem.ERetOf), Coll.Cons(D.VSym(f), Mem.one(j)))
  case Mem.FSite(s, f) =>
    val Mem.Got(it1, j) = Mem.idOf(it, Mem.Node(Mem.kSite(), f, D.VInt(s)))
    Mem.emit(Mem.emit(it1, Mem.eSym(Mem.ESiteOf), Coll.Cons(D.VInt(s), Coll.Cons(D.VSym(f), Coll.Nil))), Mem.eSym(Mem.ESiteNode), Coll.Cons(D.VInt(s), Mem.one(j)))
  case Mem.FMulti(a) =>
    val Mem.Got(it1, i) = Mem.idOf(it, a)
    Mem.emit(it1, Mem.s7(Mem.RMulti7), Mem.one(i))
  case Mem.FUnknown(a) =>
    val Mem.Got(it1, i) = Mem.idOf(it, a)
    Mem.emit(it1, Mem.s7(Mem.RUnknown7), Mem.one(i))

def Mem.interned(fs: Coll.List[Mem.EF]): Mem.IT = Mem.intern(fs, Mem.IT(Coll.sEmpty(), 0, Coll.Nil, Coll.Nil, Coll.Nil))

// the escape walk's call node of each M1 call record, onto acc: ecallIn(C, R) for a call that runs in handled region
// R (callAt), ecallFree(C, F) for a call that runs in a region its def F runs in (callFreeAt). A call with no call
// node (its callee returns a scalar, or no box) gives nothing
def Mem.callFacts(fs: Coll.List[D.Fact], it: Mem.IT, acc: Coll.List[D.Fact]): Coll.List[D.Fact] = fs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) =>
    val D.Fact(rel, vals) = x
    val acc2: Coll.List[D.Fact] =
      if Sym.eq(rel, Mem.relSym(Mem.RCallAt)) then Mem.callFact(Mem.eSym(Mem.ECallIn), vals, it, acc)
      else if Sym.eq(rel, Mem.relSym(Mem.RCallFreeAt)) then Mem.callFact(Mem.eSym(Mem.ECallFree), vals, it, acc)
      else acc
    Mem.callFacts(rest, it, acc2)

// vals = f, line, then the last column (a region, or none: then f): rel(C, last) for the call node C of (f, line)
def Mem.callFact(rel: Sym.Sym, vals: Coll.List[D.Val], it: Mem.IT, acc: Coll.List[D.Fact]): Coll.List[D.Fact] = vals match
  case Coll.Cons(fv, t1) => t1 match
    case Coll.Cons(lv, t2) => fv match
      case D.VSym(f) => lv match
        case D.VInt(line) =>
          val last: D.Val = t2 match
            case Coll.Cons(r, _) => r
            case Coll.Nil => fv
          Mem.findCall(it, f, line) match
            case Coll.Some(c) => Coll.Cons(D.Fact(rel, Coll.Cons(D.VInt(c), Coll.Cons(last, Coll.Nil))), acc)
            case Coll.None => acc
        case D.VSym(_) => acc
      case D.VInt(_) => acc
    case Coll.Nil => acc
  case Coll.Nil => acc

// the id of the call node of def f at line, when the walk made one (no insert)
def Mem.findCall(it: Mem.IT, f: Sym.Sym, line: I64): Coll.Option[I64] =
  val Mem.IT(defs, _, _, _, _) = it
  val Mem.DefIds(_, byKind) = Mem.defIds(defs, f)
  Coll.lookup(byKind, Mem.kCall()) match
    case Coll.Some(ints) => Coll.lookup(ints, line)
    case Coll.None => Coll.None

// each var node's def and name by id, built once: the ids were given in order, so the list is one run
def Mem.varMap(it: Mem.IT): Coll.BMap[Mem.VarOf] =
  val Mem.IT(_, _, vars, _, _) = it
  Coll.bFromSorted(Coll.sortDedup(vars))

def Mem.factsOf(it: Mem.IT): Coll.List[D.Fact] =
  val Mem.IT(_, _, _, out, _) = it
  out
// ── T4: program points and control-flow edges (Polonius cfg_edge, var_defined_at, var_used_at), liveness and moves
// as D rules (Polonius var_live_on_entry: output/liveness.rs:97-100) ──
// A point is one read of a var the def binds, one binder (val, var, pattern, param, assignment), or one join (after an
// if or a match); its id is unique in the program, so a (name, point) pair names one var of one def. Edges follow
// evaluation order; an if or a match forks at its cond or scrutinee and joins after; a while's body ends with an edge
// back to its head.
//   liveIn(X, P) :- use(X, P)            liveOut(X, P) :- liveIn(X, Q), redge(Q, P)
//   liveIn(X, P) :- liveOut(X, P), !pdef(X, P)        moved(X, P) :- use(X, P), !liveOut(X, P)
enum Mem.PRel:
  case Mem.PUse
  case Mem.PDef
  case Mem.PREdge
  case Mem.PLiveIn
  case Mem.PLiveOut
  case Mem.PMoved

def Mem.pSym(r: Mem.PRel): Sym.Sym = r match
  case Mem.PUse => Sym.of("puse")
  case Mem.PDef => Sym.of("pdef")
  case Mem.PREdge => Sym.of("predge")
  case Mem.PLiveIn => Sym.of("pliveIn")
  case Mem.PLiveOut => Sym.of("pliveOut")
  case Mem.PMoved => Sym.of("pmoved")

// a point's line and def
enum Mem.PAt:
  case Mem.PAt(line: I64, f: Sym.Sym)

// the walk state: the next point id, the facts, each point's line and def
enum Mem.PS:
  case Mem.PS(next: I64, out: Coll.List[D.Fact], at: Coll.IMap[Mem.PAt])

// a walk result: the state and the last point
enum Mem.PR:
  case Mem.PR(s: Mem.PS, p: I64)

def Mem.pFact(r: Mem.PRel, a: D.Val, b: D.Val): D.Fact = D.Fact(Mem.pSym(r), Coll.Cons(a, Coll.Cons(b, Coll.Nil)))

// an edge prev -> q (stored reversed: the liveness join binds q first)
def Mem.pEdge(s: Mem.PS, prev: I64, q: I64): Mem.PS =
  val Mem.PS(n, out, at) = s
  Mem.PS(n, Coll.Cons(Mem.pFact(Mem.PREdge, D.VInt(q), D.VInt(prev)), out), at)

// a new point of def f at line after prev
def Mem.pNew(s: Mem.PS, f: Sym.Sym, prev: I64, line: I64): Mem.PR =
  val Mem.PS(n, out, at) = s
  Mem.PR(Mem.pEdge(Mem.PS(n + 1, out, Coll.insert(at, n, Mem.PAt(line, f))), prev, n), n)

// x read (r = PUse) or bound (r = PDef) at point p
def Mem.pAdd(s: Mem.PS, r: Mem.PRel, x: Sym.Sym, p: I64): Mem.PS =
  val Mem.PS(n, out, at) = s
  Mem.PS(n, Coll.Cons(Mem.pFact(r, D.VSym(x), D.VInt(p)), out), at)

// a read of x at line when x is a var node of f (a var that can hold a box: a scalar, a nullary case, a global or a
// def name gets no point, so liveness is computed only where a move can free or reuse memory)
def Mem.pRead(cx: Mem.PCx, s: Mem.PS, prev: I64, line: I64, x: Sym.Sym): Mem.PR =
  val Mem.PCx(f, nodes) = cx
  Coll.sLookup(nodes, x) match
    case Coll.Some(_) =>
      val Mem.PR(s2, q) = Mem.pNew(s, f, prev, line)
      Mem.PR(Mem.pAdd(s2, Mem.PUse, x, q), q)
    case Coll.None => Mem.PR(s, prev)

// a binder point of x at line (a var node only)
def Mem.pBind(cx: Mem.PCx, s: Mem.PS, prev: I64, line: I64, x: Sym.Sym): Mem.PR =
  val Mem.PCx(f, nodes) = cx
  Coll.sLookup(nodes, x) match
    case Coll.Some(_) =>
      val Mem.PR(s2, q) = Mem.pNew(s, f, prev, line)
      Mem.PR(Mem.pAdd(s2, Mem.PDef, x, q), q)
    case Coll.None => Mem.PR(s, prev)

// the def and its var nodes (Mem.DefIds names)
enum Mem.PCx:
  case Mem.PCx(f: Sym.Sym, nodes: Coll.SMap[I64])

def Mem.pw(cx: Mem.PCx, e: Ast.Expr, prev: I64, s: Mem.PS): Mem.PR = e match
  case Ast.Name(line, x) => Mem.pRead(cx, s, prev, line, x)
  case Ast.Call(line, g, _, _, args) =>
    val Mem.PR(s2, q) = Mem.pws(cx, args, prev, s)
    Mem.pRead(cx, s2, q, line, g)
  case Ast.Method(_, _, _, args) => Mem.pws(cx, args, prev, s)
  case Ast.Resume(_, _, x) => Mem.pw(cx, x, prev, s)
  case Ast.Bin(_, _, l, r) =>
    val Mem.PR(s2, q) = Mem.pw(cx, l, prev, s)
    Mem.pw(cx, r, q, s2)
  case Ast.Un(_, _, x) => Mem.pw(cx, x, prev, s)
  case Ast.If(line, c, t, x) =>
    val Mem.PCx(f, _) = cx
    val Mem.PR(s1, pc) = Mem.pw(cx, c, prev, s)
    val Mem.PR(s2, pt) = Mem.pw(cx, t, pc, s1)
    val Mem.PR(s3, px) = Mem.pw(cx, x, pc, s2)
    val Mem.PR(s4, j) = Mem.pNew(s3, f, pt, line)
    Mem.PR(Mem.pEdge(s4, px, j), j)
  case Ast.Match(line, sc, arms) =>
    val Mem.PCx(f, _) = cx
    val Mem.PR(s1, ps) = Mem.pw(cx, sc, prev, s)
    val Mem.PEnds(s2, ends) = Mem.pArms(cx, arms, ps, s1, Coll.Nil)
    val Mem.PS(n, out, at) = s2
    val j = n
    Mem.PR(Mem.pJoin(Mem.PS(n + 1, out, Coll.insert(at, j, Mem.PAt(line, f))), ends, j), j)
  case Ast.Block(_, ss, last) =>
    val Mem.PR(s2, q) = Mem.pss(cx, ss, prev, s)
    Mem.pw(cx, last, q, s2)
  case Ast.While(line, c, b) =>
    val Mem.PCx(f, _) = cx
    val Mem.PR(s1, h) = Mem.pNew(s, f, prev, line)
    val Mem.PR(s2, pc) = Mem.pw(cx, c, h, s1)
    val Mem.PR(s3, pb) = Mem.pw(cx, b, pc, s2)
    Mem.PR(Mem.pEdge(s3, pb, h), pc)
  case Ast.Assign(line, x, v) =>
    val Mem.PR(s2, q) = Mem.pw(cx, v, prev, s)
    Mem.pBind(cx, s2, q, line, x)
  case Ast.Quant(_, _, _, _, x) => Mem.pw(cx, x, prev, s)
  case _ => Mem.PR(s, prev)

def Mem.pws(cx: Mem.PCx, es: Coll.List[Ast.Expr], prev: I64, s: Mem.PS): Mem.PR = es match
  case Coll.Nil => Mem.PR(s, prev)
  case Coll.Cons(e, rest) =>
    val Mem.PR(s2, q) = Mem.pw(cx, e, prev, s)
    Mem.pws(cx, rest, q, s2)

// the arms' end points (each arm starts at a point after the scrutinee that binds its pattern)
enum Mem.PEnds:
  case Mem.PEnds(s: Mem.PS, ends: Coll.List[I64])

def Mem.pArms(cx: Mem.PCx, arms: Coll.List[Ast.Arm], ps: I64, s: Mem.PS, ends: Coll.List[I64]): Mem.PEnds = arms match
  case Coll.Nil => Mem.PEnds(s, ends)
  case Coll.Cons(a, rest) =>
    val Mem.PCx(f, _) = cx
    val Ast.Arm(line, p, b) = a
    val Mem.PR(s1, q) = Mem.pNew(s, f, ps, line)
    val s2: Mem.PS = p match
      case Ast.PCase(_, xs) => Mem.pDefs(s1, xs, q)
      case Ast.PAny => s1
    val Mem.PR(s3, e) = Mem.pw(cx, b, q, s2)
    Mem.pArms(cx, rest, ps, s3, Coll.Cons(e, ends))

def Mem.pDefs(s: Mem.PS, xs: Coll.List[Sym.Sym], p: I64): Mem.PS = xs match
  case Coll.Nil => s
  case Coll.Cons(x, rest) => Mem.pDefs(Mem.pAdd(s, Mem.PDef, x, p), rest, p)

def Mem.pJoin(s: Mem.PS, ends: Coll.List[I64], j: I64): Mem.PS = ends match
  case Coll.Nil => s
  case Coll.Cons(e, rest) => Mem.pJoin(Mem.pEdge(s, e, j), rest, j)

def Mem.pss(cx: Mem.PCx, ss: Coll.List[Ast.Stmt], prev: I64, s: Mem.PS): Mem.PR = ss match
  case Coll.Nil => Mem.PR(s, prev)
  case Coll.Cons(st, rest) => st match
    case Ast.Val(line, x, _, e) =>
      val Mem.PR(s2, q) = Mem.pw(cx, e, prev, s)
      val Mem.PR(s3, d) = Mem.pBind(cx, s2, q, line, x)
      Mem.pss(cx, rest, d, s3)
    case Ast.Var(line, x, _, e) =>
      val Mem.PR(s2, q) = Mem.pw(cx, e, prev, s)
      val Mem.PR(s3, d) = Mem.pBind(cx, s2, q, line, x)
      Mem.pss(cx, rest, d, s3)
    case Ast.Handle(_, _, _, args) =>
      val Mem.PR(s2, q) = Mem.pws(cx, args, prev, s)
      Mem.pss(cx, rest, q, s2)
    case Ast.Do(e) =>
      val Mem.PR(s2, q) = Mem.pw(cx, e, prev, s)
      Mem.pss(cx, rest, q, s2)
    case Ast.Check(_, _, e) =>
      val Mem.PR(s2, q) = Mem.pw(cx, e, prev, s)
      Mem.pss(cx, rest, q, s2)

// each fn: an entry point that binds its params, then its body
def Mem.pFns(fs: Coll.List[Ast.Fn], defs: Coll.SMap[Mem.DefIds], s: Mem.PS): Mem.PS = fs match
  case Coll.Nil => s
  case Coll.Cons(fn, rest) =>
    val Ast.Fn(line, f, _, ps, _, _, body) = fn
    val nodes: Coll.SMap[I64] = Coll.sLookup(defs, f) match
      case Coll.Some(d) =>
        val Mem.DefIds(ns, _) = d
        ns
      case Coll.None => Coll.sEmpty()
    val Mem.PS(n, out, at) = s
    val s1 = Mem.pParams(Mem.PS(n + 1, out, Coll.insert(at, n, Mem.PAt(line, f))), ps, n)
    val s2: Mem.PS = body match
      case Ast.Def(_, e) =>
        val Mem.PR(s3, _) = Mem.pw(Mem.PCx(f, nodes), e, n, s1)
        s3
      case Ast.Extern(_) => s1
    Mem.pFns(rest, defs, s2)

def Mem.pParams(s: Mem.PS, ps: Coll.List[Ast.Binder], p: I64): Mem.PS = ps match
  case Coll.Nil => s
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, _) = b
    Mem.pParams(Mem.pAdd(s, Mem.PDef, x, p), rest, p)

def Mem.pRules(): Coll.List[D.Rule] =
  val xp = Coll.Cons(Mem.v(0), Coll.Cons(Mem.v(1), Coll.Nil))
  val xq = Coll.Cons(Mem.v(0), Coll.Cons(Mem.v(2), Coll.Nil))
  val qp = Coll.Cons(Mem.v(2), Coll.Cons(Mem.v(1), Coll.Nil))
  val use = D.Pos(D.Atom(Mem.pSym(Mem.PUse), xp))
  val inP = D.Atom(Mem.pSym(Mem.PLiveIn), xp)
  val outP = D.Atom(Mem.pSym(Mem.PLiveOut), xp)
  val l1 = D.Rule(inP, Mem.lit1(use))
  val l2 = D.Rule(outP, Mem.lits2(D.Pos(D.Atom(Mem.pSym(Mem.PLiveIn), xq)), D.Pos(D.Atom(Mem.pSym(Mem.PREdge), qp))))
  val l3 = D.Rule(inP, Mem.lits2(D.Pos(outP), D.Neg(D.Atom(Mem.pSym(Mem.PDef), xp))))
  val mv = D.Rule(D.Atom(Mem.pSym(Mem.PMoved), xp), Mem.lits2(use, D.Neg(outP)))
  Coll.Cons(l1, Coll.Cons(l2, Coll.Cons(l3, Coll.Cons(mv, Coll.Nil))))

// the moved points of each var, by def then name: moved(x, p) tuples grouped by the def of point p
def Mem.movedBy(ts: Coll.List[Coll.List[D.Val]], at: Coll.IMap[Mem.PAt], acc: Coll.SMap[Coll.SMap[Coll.List[I64]]]): Coll.SMap[Coll.SMap[Coll.List[I64]]] = ts match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(xv, t1) => t1 match
      case Coll.Cons(pv, _) => xv match
        case D.VSym(x) => pv match
          case D.VInt(p) => Coll.lookup(at, p) match
            case Coll.Some(pa) =>
              val Mem.PAt(line, f) = pa
              val m: Coll.SMap[Coll.List[I64]] = Coll.sLookup(acc, f) match
                case Coll.Some(mm) => mm
                case Coll.None => Coll.sEmpty()
              val ls: Coll.List[I64] = Coll.sLookup(m, x) match
                case Coll.Some(l) => l
                case Coll.None => Coll.Nil
              Mem.movedBy(rest, at, Coll.sInsert(acc, f, Coll.sInsert(m, x, Coll.Cons(line, ls))))
            case Coll.None => Mem.movedBy(rest, at, acc)
          case D.VSym(_) => Mem.movedBy(rest, at, acc)
        case D.VInt(_) => Mem.movedBy(rest, at, acc)
      case Coll.Nil => Mem.movedBy(rest, at, acc)
    case Coll.Nil => Mem.movedBy(rest, at, acc)

// each record with its moved lines (T4: a read after which the var is not live on any path, Polonius path_moved_at);
// whether the value has another reference is the separate shared field
def Mem.withMoved(vs: Coll.List[Mem.VarRec], mvd: Coll.SMap[Coll.SMap[Coll.List[I64]]], acc: Coll.List[Mem.VarRec]): Coll.List[Mem.VarRec] = vs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(v, rest) =>
    val Mem.VarRec(i, f, x, regions, why, lv, _) = v
    val ls: Coll.List[I64] = Coll.sLookup(mvd, f) match
      case Coll.Some(m) => Coll.sLookup(m, x) match
        case Coll.Some(l) => l
        case Coll.None => Coll.Nil
      case Coll.None => Coll.Nil
    Mem.withMoved(rest, mvd, Coll.Cons(Mem.VarRec(i, f, x, regions, why, lv, ls), acc))

// the args of an extern call: a Str arg is borrowed (every Str extern reads its bytes during the call and keeps no
// pointer: lib/prelude.srs Str.*, rt_print, rt_fs_*), and when the extern returns a value that can hold one (Str.slice
// returns a view of its arg) the arg flows to the result; any other non-scalar arg (a Ptr: raw memory) is a sink
def Mem.externArgs(w: Mem.EW, nss: Coll.List[Coll.List[Mem.Node]], ps: Coll.List[Ast.Binder], r: Mem.Node, retScalar: Bool): Mem.EW = nss match
  case Coll.Nil => w
  case Coll.Cons(ns, rest) => ps match
    case Coll.Nil => Mem.externArgs(Mem.sinkAll(w, ns), rest, Coll.Nil, r, retScalar)
    case Coll.Cons(p, prest) =>
      val Ast.Binder(_, _, t) = p
      val Ast.Ty(_, tn, _, _, _) = t
      val isStr = Str.eq(Sym.str(tn), "Str")
      val w2: Mem.EW = if isStr && retScalar then w else if isStr then Mem.flowTo(w, ns, r, Mem.MBind) else Mem.sinkAll(w, ns)
      Mem.externArgs(w2, rest, prest, r, retScalar)

// the quiet protocols, as true: every handler is stateless (E5) and every op takes only Str or scalar params (an arg
// can hold no other arg, so a stateless op cannot store one arg into another); else false
def Mem.quietPs(ds: Coll.List[Ast.Decl], m: Coll.SMap[Bool]): Coll.SMap[Bool] = ds match
  case Coll.Nil => Mem.trueOnly(Coll.sEntries(m, Coll.Nil), Coll.sEmpty())
  case Coll.Cons(d, rest) => d match
    case Ast.DHandler(h) =>
      val Ast.Handler(_, _, p, fs, _) = h
      Mem.quietPs(rest, Mem.quietAnd(m, p, !Mem.hasInit(fs)))
    case Ast.DProto(pr) =>
      val Ast.Proto(_, p, _, _, _, _, ops, _) = pr
      Mem.quietPs(rest, Mem.quietAnd(m, p, Mem.plainOps(ops)))
    case _ => Mem.quietPs(rest, m)

def Mem.quietAnd(m: Coll.SMap[Bool], p: Sym.Sym, ok: Bool): Coll.SMap[Bool] =
  val prev: Bool = Coll.sLookup(m, p) match
    case Coll.Some(b) => b
    case Coll.None => true
  Coll.sInsert(m, p, prev && ok)

// every op param is a Str or a scalar
def Mem.plainOps(ops: Coll.List[Ast.Op]): Bool = ops match
  case Coll.Nil => true
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, _, _, ps, _, _) = o
    Mem.plainParams(ps) && Mem.plainOps(rest)

def Mem.plainParams(ps: Coll.List[Ast.Binder]): Bool = ps match
  case Coll.Nil => true
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    (Mem.scalar(t) || Str.eq(Sym.str(n), "Str")) && Mem.plainParams(rest)

def Mem.trueOnly(xs: Coll.List[Coll.SEntry[Bool]], acc: Coll.SMap[Bool]): Coll.SMap[Bool] = xs match
  case Coll.Nil => acc
  case Coll.Cons(e, rest) =>
    val Coll.SEntry(p, b) = e
    Mem.trueOnly(rest, if b then Coll.sInsert(acc, p, true) else acc)

// a handler keeps state: its init is not the parser's stateless one (Parse.stateless: init(): Ptr = Srs.noState())
def Mem.hasInit(fs: Coll.List[Ast.Fn]): Bool = fs match
  case Coll.Nil => false
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, n, _, _, _, _, body) = g
    val noState: Bool = body match
      case Ast.Def(_, e) => e match
        case Ast.Call(_, h, _, _, _) => Str.eq(Sym.str(h), "Srs.noState")
        case _ => false
      case Ast.Extern(_) => false
    (Str.eq(Sym.str(n), "init") && !noState) || Mem.hasInit(rest)

// g is P.op with P a quiet protocol: the text before g's last dot is a key of quiet
def Mem.quietOp(quiet: Coll.SMap[Bool], g: Sym.Sym): Bool =
  val s = Sym.str(g)
  val k = Mem.lastDot(s, Str.len(s) - 1)
  if k <= 0 then false else Mem.isIn(quiet, Sym.of(Str.slice(s, 0, k)))

// the index of the last dot at or before i, -1 when none
def Mem.lastDot(s: Str, i: I64): I64 = if i < 0 then 0 - 1 else if Str.at(s, i) == 46 then i else Mem.lastDot(s, i - 1)

// the defs whose calls run in a scratch Arena (M12a): the compact defs that run once
def Mem.scratchSet(r: Mem.Report): Coll.SMap[Bool] = r match
  case Mem.Ok(_, _, _, _, _, cs, _, _) => Mem.onceDefs(cs, Coll.sEmpty())
  case Mem.RulesBad(_) => Coll.sEmpty()

def Mem.onceDefs(cs: Coll.List[Mem.Compact], m: Coll.SMap[Bool]): Coll.SMap[Bool] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Mem.Compact(_, f, runs) = c
    val m2: Coll.SMap[Bool] = runs match
      case Mem.RunsOnce => Coll.sInsert(m, f, true)
      case Mem.RunsMany => m
    Mem.onceDefs(rest, m2)

// ── field usage (layout by usage, the mem optimization): how often the program reads each field of each case: a match
// arm or a val pattern on case c with a binder that is not `_` at field i reads field i of c. Emit lays a case's word
// fields in this order (most read first, next to the tag) ──
def Mem.fieldUse(ds: Coll.List[Ast.Decl]): Coll.SMap[Coll.IMap[I64]] = Mem.useFns(Mem.fnList(ds, Coll.Nil), Coll.sEmpty())

def Mem.useFns(fs: Coll.List[Ast.Fn], m: Coll.SMap[Coll.IMap[I64]]): Coll.SMap[Coll.IMap[I64]] = fs match
  case Coll.Nil => m
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, _, _, _, _, _, body) = f
    val m2: Coll.SMap[Coll.IMap[I64]] = body match
      case Ast.Def(_, e) => Mem.useE(e, m)
      case Ast.Extern(_) => m
    Mem.useFns(rest, m2)

def Mem.useE(e: Ast.Expr, m: Coll.SMap[Coll.IMap[I64]]): Coll.SMap[Coll.IMap[I64]] = e match
  case Ast.Call(_, _, _, _, args) => Mem.useEs(args, m)
  case Ast.Method(_, _, _, args) => Mem.useEs(args, m)
  case Ast.Resume(_, _, x) => Mem.useE(x, m)
  case Ast.Bin(_, _, l, r) => Mem.useE(r, Mem.useE(l, m))
  case Ast.Un(_, _, x) => Mem.useE(x, m)
  case Ast.If(_, c, t, x) => Mem.useE(x, Mem.useE(t, Mem.useE(c, m)))
  case Ast.Match(_, s, arms) => Mem.useArms(arms, Mem.useE(s, m))
  case Ast.Block(_, ss, last) => Mem.useE(last, Mem.useSs(ss, m))
  case Ast.While(_, c, b) => Mem.useE(b, Mem.useE(c, m))
  case Ast.Assign(_, _, x) => Mem.useE(x, m)
  case Ast.Quant(_, _, _, _, x) => Mem.useE(x, m)
  case _ => m

def Mem.useEs(es: Coll.List[Ast.Expr], m: Coll.SMap[Coll.IMap[I64]]): Coll.SMap[Coll.IMap[I64]] = es match
  case Coll.Nil => m
  case Coll.Cons(e, rest) => Mem.useEs(rest, Mem.useE(e, m))

def Mem.useSs(ss: Coll.List[Ast.Stmt], m: Coll.SMap[Coll.IMap[I64]]): Coll.SMap[Coll.IMap[I64]] = ss match
  case Coll.Nil => m
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, _, e) => Mem.useSs(rest, Mem.useE(e, m))
    case Ast.Var(_, _, _, e) => Mem.useSs(rest, Mem.useE(e, m))
    case Ast.Handle(_, _, _, args) => Mem.useSs(rest, Mem.useEs(args, m))
    case Ast.Do(e) => Mem.useSs(rest, Mem.useE(e, m))
    case Ast.Check(_, _, e) => Mem.useSs(rest, Mem.useE(e, m))

def Mem.useArms(arms: Coll.List[Ast.Arm], m: Coll.SMap[Coll.IMap[I64]]): Coll.SMap[Coll.IMap[I64]] = arms match
  case Coll.Nil => m
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, b) = a
    val m2: Coll.SMap[Coll.IMap[I64]] = p match
      case Ast.PCase(c, xs) => Mem.useBinds(c, xs, 0, m)
      case Ast.PAny => m
    Mem.useArms(rest, Mem.useE(b, m2))

// each binder of case c that is not `_`: one more read of its field
def Mem.useBinds(c: Sym.Sym, xs: Coll.List[Sym.Sym], i: I64, m: Coll.SMap[Coll.IMap[I64]]): Coll.SMap[Coll.IMap[I64]] = xs match
  case Coll.Nil => m
  case Coll.Cons(x, rest) =>
    if Str.eq(Sym.str(x), "_") then Mem.useBinds(c, rest, i + 1, m)
    else
      val cm: Coll.IMap[I64] = Coll.sLookup(m, c) match
        case Coll.Some(z) => z
        case Coll.None => Coll.Tip
      val k: I64 = Coll.lookup(cm, i) match
        case Coll.Some(v) => v
        case Coll.None => 0
      Mem.useBinds(c, rest, i + 1, Coll.sInsert(m, c, Coll.insert(cm, i, k + 1)))
