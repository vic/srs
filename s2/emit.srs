// s2 self-host rung B2 (vic/c/s2-emit-spec.md): the C of an elaborated program at its mono instances, as s1/emit.srs
// prints it. the input typed with no clash, so every name the lookups read is declared. one C file to stdout.

// a case: its tag (declaration index), its enum and its fields
enum Emit.CaseAt:
  case Emit.CaseAt(tag: I64, en: Ast.Enum, c: Ast.Case)

// how a constructor allocates: an inline bump when the program has the Arena handler (rt/srs_rt.c:24-25), else the vtable
enum Emit.Alloc:
  case Emit.Inline
  case Emit.VTable

// the declarations emit reads, by name
enum Emit.Cx:
  case Emit.Cx(s: Coll.IMap[K.Term], fns: Coll.SMap[El.Fn], cases: Coll.SMap[Emit.CaseAt], enums: Coll.SMap[Ast.Enum], protos: Coll.SMap[Ast.Proto], hprotos: Coll.SMap[Sym.Sym], alloc: Emit.Alloc)

// a C local: a param p_x, or a binding v_x_n (n = the number of locals bound before it)
enum Emit.Name:
  case Emit.P(x: Sym.Sym)
  case Emit.L(x: Sym.Sym, n: I64)

enum Emit.Env:
  case Emit.Env(vs: Coll.List[Emit.Name], n: I64)

// a capability opened by a handle: its protocol's drop op runs at the end of the block if it is still live
enum Emit.Drop:
  case Emit.Drop(c: Emit.Name, proto: Sym.Sym)

// a C param: a capability (srs_cap*) or a value of a ground type
enum Emit.Slot:
  case Emit.SCap(x: Sym.Sym)
  case Emit.SVal(x: Sym.Sym, t: K.Term)

// the fn being printed: name and ground type args (a self call with them in tail position is a jump), the binder
// substitution, the C params, the ground result
enum Emit.Fi:
  case Emit.Fi(self: Sym.Sym, targs: Coll.List[K.Term], sub: Coll.List[Ty.Bind], slots: Coll.List[Emit.Slot], ret: K.Term)

// tail position: a self call there is a jump
enum Emit.Pos:
  case Emit.Tail
  case Emit.Inner

// what a signature names: a def instance f_, a runtime symbol, a handler fn h_<H>_, a given fn g_<Trait><args>_
enum Emit.Kind:
  case Emit.KDef
  case Emit.KExtern
  case Emit.KHandler(h: Sym.Sym)
  case Emit.KGiven(head: K.Term)

// args after the first print a comma before them
enum Emit.Sep:
  case Emit.First
  case Emit.Comma

// the test of a match arm: a `_` arm always holds, a case arm tests the tag
enum Emit.Guard:
  case Emit.Always
  case Emit.Tag(tag: I64)

// a declaration's layout (enum struct, fn prototype) or its code (nullary statics, fn body)
enum Emit.Part:
  case Emit.Layout
  case Emit.Code

// ── the declarations by name ──
def Emit.cxOf {r: Region} (ds: Coll.List[Ast.Decl], s: Coll.IMap[K.Term], fs: Coll.List[El.Fn]): Emit.Cx =
  Emit.cxDecls(ds, Emit.Cx(s, Emit.fnMap(fs, Coll.sEmpty()), Coll.sEmpty(), Coll.sEmpty(), Coll.sEmpty(), Coll.sEmpty(), Emit.VTable))

def Emit.fnMap {r: Region} (fs: Coll.List[El.Fn], m: Coll.SMap[El.Fn]): Coll.SMap[El.Fn] = fs match
  case Coll.Nil => m
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, _) = f
    Emit.fnMap(rest, Coll.sInsert(m, n, f))

def Emit.cxDecls {r: Region} (ds: Coll.List[Ast.Decl], cx: Emit.Cx): Emit.Cx = ds match
  case Coll.Nil => cx
  case Coll.Cons(d, rest) =>
    val Emit.Cx(s, fns, cs, es, ps, hp, al) = cx
    d match
      case Ast.DEnum(e) =>
        val Ast.Enum(_, n, _, cases) = e
        Emit.cxDecls(rest, Emit.Cx(s, fns, Emit.caseMap(cases, e, 0, cs), Coll.sInsert(es, n, e), ps, hp, al))
      case Ast.DProto(p) =>
        val Ast.Proto(_, n, _, _, _, _, _, _) = p
        Emit.cxDecls(rest, Emit.Cx(s, fns, cs, es, Coll.sInsert(ps, n, p), hp, al))
      case Ast.DHandler(h) =>
        val Ast.Handler(_, n, p, _) = h
        Emit.cxDecls(rest, Emit.Cx(s, fns, cs, es, ps, Coll.sInsert(hp, n, p), if rt_str_eq(Sym.str(n), "Arena") then Emit.Inline else al))
      case _ => Emit.cxDecls(rest, cx)

def Emit.caseMap {r: Region} (cs: Coll.List[Ast.Case], e: Ast.Enum, i: I64, m: Coll.SMap[Emit.CaseAt]): Coll.SMap[Emit.CaseAt] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    Emit.caseMap(rest, e, i + 1, Coll.sInsert(m, n, Emit.CaseAt(i, e, c)))

def Emit.isProto {r: Region} (cx: Emit.Cx, n: Sym.Sym): Bool =
  val Emit.Cx(_, _, _, _, ps, _, _) = cx
  Coll.sLookup(ps, n) match
    case Coll.Some(_) => true
    case Coll.None => false

def Emit.caseAt {r: Region} (cx: Emit.Cx, c: Sym.Sym): Coll.Option[Emit.CaseAt] =
  val Emit.Cx(_, _, cs, _, _, _, _) = cx
  Coll.sLookup(cs, c)

def Emit.subst(cx: Emit.Cx): Coll.IMap[K.Term] =
  val Emit.Cx(s, _, _, _, _, _, _) = cx
  s

def Emit.grAll {r: Region} (cx: Emit.Cx, fi: Emit.Fi, ts: Coll.List[K.Term]): Coll.List[K.Term] =
  val Emit.Fi(_, _, sub, _, _) = fi
  Mono.groundAll(Emit.subst(cx), sub, ts, Coll.Nil)

def Emit.gr {r: Region} (cx: Emit.Cx, fi: Emit.Fi, t: K.Term): K.Term =
  val Emit.Fi(_, _, sub, _, _) = fi
  Mono.ground(Emit.subst(cx), sub, t)

// ── names (spec sec 2) ──
// x with each `.` as `__`
def Emit.id(x: Sym.Sym): Unit = Emit.idFrom(Sym.str(x), 0, 0, rt_str_len(Sym.str(x)))

def Emit.idFrom(s: Str, b: I64, i: I64, n: I64): Unit =
  if i == n then rt_print(rt_str_slice(s, b, i))
  else if rt_str_at(s, i) == 46 then
    rt_print(rt_str_slice(s, b, i))
    rt_print("__")
    Emit.idFrom(s, i + 1, i + 1, n)
  else Emit.idFrom(s, b, i + 1, n)

def Emit.mangle(t: K.Term): Unit = t match
  case K.Con(n, args) =>
    Emit.id(n)
    args match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        rt_print("_")
        rt_print_i64(Coll.length(args))
        Emit.mangleArgs(args)
  case K.Int(v) => rt_print_i64(v)
  case K.Var(v) =>
    rt_print("V")
    rt_print_i64(v)

def Emit.mangleArgs(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    rt_print("_")
    Emit.mangle(t)
    Emit.mangleArgs(rest)

// an instance suffix: nothing for no type args
def Emit.suffix(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(_, _) =>
    rt_print("_")
    Emit.mangleArgs(ts)

def Emit.enumName(n: Sym.Sym, args: Coll.List[K.Term]): Unit =
  Emit.id(n)
  Emit.suffix(args)

def Emit.cname(v: Emit.Name): Unit = v match
  case Emit.P(x) =>
    rt_print("p_")
    Emit.id(x)
  case Emit.L(x, n) =>
    rt_print("v_")
    Emit.id(x)
    rt_print("_")
    rt_print_i64(n)

// the innermost local named x
def Emit.local(vs: Coll.List[Emit.Name], x: Sym.Sym): Unit = vs match
  case Coll.Nil => Emit.id(x)
  case Coll.Cons(v, rest) => if Sym.eq(Emit.nameOf(v), x) then Emit.cname(v) else Emit.local(rest, x)

def Emit.nameOf(v: Emit.Name): Sym.Sym = v match
  case Emit.P(x) => x
  case Emit.L(x, _) => x

def Emit.vs(env: Emit.Env): Coll.List[Emit.Name] =
  val Emit.Env(vs, _) = env
  vs

def Emit.envN(env: Emit.Env): I64 =
  val Emit.Env(_, n) = env
  n

def Emit.bind {r: Region} (env: Emit.Env, x: Sym.Sym): Emit.Env =
  val Emit.Env(vs, n) = env
  Emit.Env(Coll.Cons(Emit.L(x, n), vs), n + 1)

// ── types (spec sec 3): a ground term ──
def Emit.ctype {r: Region} (cx: Emit.Cx, t: K.Term): Unit = t match
  case K.Con(n, args) =>
    val x = Sym.str(n)
    if rt_str_eq(x, "I64") || rt_str_eq(x, "Unit") then rt_print("int64_t")
    else if rt_str_eq(x, "Bool") then rt_print("bool")
    else if rt_str_eq(x, "Str") then rt_print("srs_str")
    else if rt_str_eq(x, "Ptr") then rt_print("void*")
    else if Emit.isProto(cx, n) then rt_print("srs_cap*")
    else
      rt_print("struct E_")
      Emit.enumName(n, args)
      rt_print("*")
  case _ => rt_print("int64_t")

// ── expressions (spec sec 4) ──
def Emit.ex {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, pos: Emit.Pos, e: El.Expr): Unit = e match
  case El.Int(_, v) =>
    rt_print("((int64_t)")
    rt_print_i64(v)
    rt_print(")")
  case El.Bool(_, v) => rt_print(if v then "true" else "false")
  case El.Str(_, s) =>
    rt_print("((srs_str){(const uint8_t*)\"")
    rt_print(s)
    rt_print("\", ")
    rt_print_i64(Emit.unescLen(s, 0, 0))
    rt_print("})")
  case El.Unit(_) => rt_print("((int64_t)0)")
  case El.Local(_, x) => Emit.local(Emit.vs(env), x)
  case El.CallFn(_, f, ts, caps, args) =>
    val gts = Emit.grAll(cx, fi, ts)
    if Emit.isTail(pos) && Emit.isSelf(fi, f, gts) then Emit.jump(cx, fi, env, caps, args)
    else
      Emit.fnName(cx, f, gts)
      rt_print("(")
      Emit.capArgs(env, caps, Emit.First)
      Emit.args(cx, fi, env, args, if Coll.length(caps) == 0 then Emit.First else Emit.Comma)
      rt_print(")")
  case El.New(_, en, ts, c, reg, args) => Emit.ctor(cx, fi, env, en, Emit.grAll(cx, fi, ts), c, reg, args)
  case El.Nullary(_, _, ts, c) =>
    rt_print("(&N_")
    Emit.id(c)
    Emit.suffix(Emit.grAll(cx, fi, ts))
    rt_print(")")
  case El.Op(_, recv, ty, op, args) => Emit.op(cx, fi, env, recv, Emit.gr(cx, fi, ty), op, args)
  case El.Bin(_, op, l, x) =>
    rt_print("(")
    Emit.ex(cx, fi, env, Emit.Inner, l)
    rt_print(Emit.binOp(op))
    Emit.ex(cx, fi, env, Emit.Inner, x)
    rt_print(")")
  case El.Un(_, op, x) =>
    rt_print(Emit.unOp(op))
    Emit.ex(cx, fi, env, Emit.Inner, x)
    rt_print(")")
  case El.If(_, c, t, x) =>
    rt_print("(")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    rt_print(" ? ")
    Emit.ex(cx, fi, env, pos, t)
    rt_print(" : ")
    Emit.ex(cx, fi, env, pos, x)
    rt_print(")")
  case El.Match(_, x, _, arms) =>
    rt_print("({ __auto_type s")
    rt_print_i64(Emit.envN(env))
    rt_print(" = ")
    Emit.ex(cx, fi, env, Emit.Inner, x)
    rt_print("; ")
    Emit.arms(cx, fi, env, pos, arms)
    rt_print("; })")
  case El.Block(_, ss, last) =>
    rt_print("({ ")
    Emit.block(cx, fi, env, pos, ss, last, Coll.Nil)
  case El.While(_, c, b) =>
    rt_print("({ while (")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    rt_print(") { (void)(")
    Emit.ex(cx, fi, env, Emit.Inner, b)
    rt_print("); } (int64_t)0; })")
  case El.Assign(_, x, v) =>
    rt_print("(")
    Emit.local(Emit.vs(env), x)
    rt_print(" = (")
    Emit.ex(cx, fi, env, Emit.Inner, v)
    rt_print("), (int64_t)0)")
  case El.Bad(_) => rt_print("0")

def Emit.binOp(op: Ast.BinOp): Str = op match
  case Ast.Add => " + "
  case Ast.Sub => " - "
  case Ast.Mul => " * "
  case Ast.Div => " / "
  case Ast.Mod => " % "
  case Ast.Lt => " < "
  case Ast.Le => " <= "
  case Ast.Gt => " > "
  case Ast.Ge => " >= "
  case Ast.Eq => " == "
  case Ast.Ne => " != "
  case Ast.And => " && "
  case Ast.Or => " || "

def Emit.unOp(op: Ast.UnOp): Str = op match
  case Ast.Neg => "(-"
  case Ast.Not => "(!"

// the length of a literal: an escape counts as one char
def Emit.unescLen(s: Str, i: I64, n: I64): I64 =
  if i >= rt_str_len(s) then n
  else if rt_str_at(s, i) == 92 then Emit.unescLen(s, i + 2, n + 1)
  else Emit.unescLen(s, i + 1, n + 1)

def Emit.isTail(pos: Emit.Pos): Bool = pos match
  case Emit.Tail => true
  case Emit.Inner => false

def Emit.isSelf(fi: Emit.Fi, f: Sym.Sym, ts: Coll.List[K.Term]): Bool =
  val Emit.Fi(self, sts, _, _, _) = fi
  Sym.eq(f, self) && Mono.termsEq(ts, sts)

def Emit.fnName {r: Region} (cx: Emit.Cx, f: Sym.Sym, ts: Coll.List[K.Term]): Unit =
  val Emit.Cx(_, fns, _, _, _, _, _) = cx
  Coll.sLookup(fns, f) match
    case Coll.Some(g) =>
      val El.Fn(_, _, _, _, _, _, body) = g
      body match
        case El.Extern => Emit.id(f)
        case _ => Emit.defName(f, ts)
    case Coll.None => Emit.defName(f, ts)

def Emit.defName(f: Sym.Sym, ts: Coll.List[K.Term]): Unit =
  rt_print("f_")
  Emit.id(f)
  Emit.suffix(ts)

def Emit.sep(s: Emit.Sep): Unit = s match
  case Emit.First => ()
  case Emit.Comma => rt_print(", ")

def Emit.capArgs(env: Emit.Env, caps: Coll.List[Sym.Sym], s: Emit.Sep): Unit = caps match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    Emit.sep(s)
    Emit.local(Emit.vs(env), c)
    Emit.capArgs(env, rest, Emit.Comma)

def Emit.args {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, xs: Coll.List[El.Expr], s: Emit.Sep): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    Emit.sep(s)
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Emit.args(cx, fi, env, rest, Emit.Comma)

// a self tail call (spec sec 4.4): every arg to a temp, then to its param, then back to the top of the body
def Emit.jump {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr]): Unit =
  val Emit.Fi(_, _, _, slots, ret) = fi
  rt_print("({ ")
  Emit.temps(cx, fi, env, slots, caps, args, 0)
  Emit.sets(slots, 0)
  rt_print("goto srs_tail; (")
  Emit.ctype(cx, ret)
  rt_print("){0}; })")

def Emit.temps {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, slots: Coll.List[Emit.Slot], caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr], i: I64): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(_) => caps match
      case Coll.Nil => ()
      case Coll.Cons(c, crest) =>
        rt_print("srs_cap* t")
        rt_print_i64(i)
        rt_print(" = ")
        Emit.local(Emit.vs(env), c)
        rt_print("; ")
        Emit.temps(cx, fi, env, rest, crest, args, i + 1)
    case Emit.SVal(_, t) => args match
      case Coll.Nil => ()
      case Coll.Cons(a, arest) =>
        Emit.ctype(cx, t)
        rt_print(" t")
        rt_print_i64(i)
        rt_print(" = ")
        Emit.ex(cx, fi, env, Emit.Inner, a)
        rt_print("; ")
        Emit.temps(cx, fi, env, rest, caps, arest, i + 1)

def Emit.sets(slots: Coll.List[Emit.Slot], i: I64): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) =>
    rt_print("p_")
    Emit.id(Emit.slotName(sl))
    rt_print(" = t")
    rt_print_i64(i)
    rt_print("; ")
    Emit.sets(rest, i + 1)

def Emit.slotName(sl: Emit.Slot): Sym.Sym = sl match
  case Emit.SCap(x) => x
  case Emit.SVal(x, _) => x

// a constructor (spec sec 4.3): its own case's size in the region reg, then the fields in order
def Emit.ctor {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, en: Sym.Sym, ts: Coll.List[K.Term], c: Sym.Sym, reg: Sym.Sym, args: Coll.List[El.Expr]): Unit = Emit.caseAt(cx, c) match
  case Coll.None => rt_print("0")
  case Coll.Some(ca) =>
    val Emit.CaseAt(tag, _, cs) = ca
    val Ast.Case(_, _, fields) = cs
    val Emit.Cx(_, _, _, _, _, _, al) = cx
    val n = Emit.envN(env)
    rt_print("({ struct E_")
    Emit.enumName(en, ts)
    rt_print("* o")
    rt_print_i64(n)
    rt_print(" = (struct E_")
    Emit.enumName(en, ts)
    rt_print("*)")
    al match
      case Emit.Inline =>
        rt_print("srs_alloc(")
        Emit.local(Emit.vs(env), reg)
        rt_print(", ")
      case Emit.VTable =>
        rt_print("((void*(*)(void*, int64_t))(")
        Emit.local(Emit.vs(env), reg)
        rt_print("->vt[")
        rt_print_i64(Emit.opIndex(cx, Sym.of("Region"), Sym.of("alloc")))
        rt_print("]))(")
        Emit.local(Emit.vs(env), reg)
        rt_print("->self, ")
    rt_print("(int64_t)(offsetof(struct E_")
    Emit.enumName(en, ts)
    rt_print(", u) + sizeof(((struct E_")
    Emit.enumName(en, ts)
    rt_print("*)0)->u.C_")
    Emit.id(c)
    rt_print("))); o")
    rt_print_i64(n)
    rt_print("->tag = ")
    rt_print_i64(tag)
    rt_print(";")
    Emit.fieldSets(cx, fi, env, n, c, fields, args)
    rt_print(" o")
    rt_print_i64(n)
    rt_print("; })")

def Emit.fieldSets {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, n: I64, c: Sym.Sym, fs: Coll.List[Ast.Binder], xs: Coll.List[El.Expr]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, frest) => xs match
    case Coll.Nil => ()
    case Coll.Cons(x, xrest) =>
      val Ast.Binder(_, fx, _) = f
      rt_print(" o")
      rt_print_i64(n)
      rt_print("->u.C_")
      Emit.id(c)
      rt_print(".f_")
      Emit.id(fx)
      rt_print(" = ")
      Emit.ex(cx, fi, env, Emit.Inner, x)
      rt_print(";")
      Emit.fieldSets(cx, fi, env, n, c, frest, xrest)

// the index of op in protocol p's op list
def Emit.opIndex {r: Region} (cx: Emit.Cx, p: Sym.Sym, op: Sym.Sym): I64 =
  val Emit.Cx(_, _, _, _, ps, _, _) = cx
  Coll.sLookup(ps, p) match
    case Coll.None => 0
    case Coll.Some(pr) =>
      val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
      Emit.opIn(ops, op, 0)

def Emit.opIn(os: Coll.List[Ast.Op], op: Sym.Sym, i: I64): I64 = os match
  case Coll.Nil => i
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, n, _, _, _) = o
    if Sym.eq(n, op) then i else Emit.opIn(rest, op, i + 1)

// recv.op(args): through the capability's vtable (an op whose every transition ends the protocol clears live), or a
// trait method of {} evidence: the given's static fn (rung T2)
def Emit.op {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, recv: Sym.Sym, ty: K.Term, op: Sym.Sym, args: Coll.List[El.Expr]): Unit = ty match
  case K.Con(pn, targs) =>
    val Emit.Cx(_, _, _, _, ps, _, _) = cx
    Coll.sLookup(ps, pn) match
      case Coll.Some(p) =>
        val Ast.Proto(_, _, _, _, ends, _, ops, _) = p
        Ty.opIn(ops, op) match
          case Coll.Some(o) =>
            val Ast.Op(_, _, ops2, oret, trans) = o
            rt_print("({ __auto_type r_ = ((")
            Emit.ctype(cx, Ty.term(oret, Coll.Nil))
            rt_print("(*)(void*")
            Emit.opTys(cx, ops2)
            rt_print("))(")
            Emit.local(Emit.vs(env), recv)
            rt_print("->vt[")
            rt_print_i64(Emit.opIn(ops, op, 0))
            rt_print("]))(")
            Emit.local(Emit.vs(env), recv)
            rt_print("->self")
            Emit.args(cx, fi, env, args, Emit.Comma)
            rt_print("); ")
            if Emit.kills(trans, ends) then
              Emit.local(Emit.vs(env), recv)
              rt_print("->live = 0; ")
            else ()
            rt_print("r_; })")
          case Coll.None => rt_print("0")
      case Coll.None =>
        rt_print("g_")
        Emit.id(pn)
        Emit.suffix(targs)
        rt_print("_")
        Emit.id(op)
        rt_print("(")
        Emit.args(cx, fi, env, args, Emit.First)
        rt_print(")")
  case _ => rt_print("0")

def Emit.opTys {r: Region} (cx: Emit.Cx, ps: Coll.List[Ast.Binder]): Unit = ps match
  case Coll.Nil => ()
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, _, t) = p
    rt_print(", ")
    Emit.ctype(cx, Ty.term(t, Coll.Nil))
    Emit.opTys(cx, rest)

// every transition of the op ends the protocol (and it has one)
def Emit.kills(ts: Coll.List[Ast.Trans], ends: Coll.List[Sym.Sym]): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(_, _) => Emit.allEnd(ts, ends)

def Emit.allEnd(ts: Coll.List[Ast.Trans], ends: Coll.List[Sym.Sym]): Bool = ts match
  case Coll.Nil => true
  case Coll.Cons(t, rest) =>
    val Ast.Trans(_, to) = t
    if Ty.memberSym(to, ends) then Emit.allEnd(rest, ends) else false

// match (spec sec 4.1): the scrutinee once in s<n>; the last arm has no tag test
def Emit.arms {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, pos: Emit.Pos, as: Coll.List[El.Arm]): Unit = as match
  case Coll.Nil => ()
  case Coll.Cons(a, rest) =>
    val El.Arm(_, p, b) = a
    val n = Emit.envN(env)
    p match
      case Ast.PAny =>
        Emit.test(rest, n, Emit.Always)
        rt_print("({ ")
        Emit.ex(cx, fi, env, pos, b)
        rt_print("; })")
      case Ast.PCase(c, binds) => Emit.caseAt(cx, c) match
        case Coll.None => rt_print("0")
        case Coll.Some(ca) =>
          val Emit.CaseAt(tag, _, cs) = ca
          val Ast.Case(_, _, fields) = cs
          Emit.test(rest, n, Emit.Tag(tag))
          rt_print("({ ")
          Emit.ex(cx, fi, Emit.binds(env, n, c, binds, fields), pos, b)
          rt_print("; })")
    rest match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        rt_print(" : ")
        Emit.arms(cx, fi, env, pos, rest)

// the test of an arm that is not the last
def Emit.test(rest: Coll.List[El.Arm], n: I64, g: Emit.Guard): Unit = rest match
  case Coll.Nil => ()
  case Coll.Cons(_, _) => g match
    case Emit.Always => rt_print("1 ? ")
    case Emit.Tag(tag) =>
      rt_print("s")
      rt_print_i64(n)
      rt_print("->tag == ")
      rt_print_i64(tag)
      rt_print(" ? ")

// each binder of an arm (not `_`) to its case field of s<n>
def Emit.binds {r: Region} (env: Emit.Env, n: I64, c: Sym.Sym, xs: Coll.List[Sym.Sym], fs: Coll.List[Ast.Binder]): Emit.Env = xs match
  case Coll.Nil => env
  case Coll.Cons(x, rest) => fs match
    case Coll.Nil => env
    case Coll.Cons(f, frest) =>
      if rt_str_eq(Sym.str(x), "_") then Emit.binds(env, n, c, rest, frest)
      else
        val Ast.Binder(_, fx, _) = f
        val env2 = Emit.bind(env, x)
        rt_print("__auto_type ")
        Emit.cname(Emit.L(x, Emit.envN(env)))
        rt_print(" = s")
        rt_print_i64(n)
        rt_print("->u.C_")
        Emit.id(c)
        rt_print(".f_")
        Emit.id(fx)
        rt_print("; ")
        Emit.binds(env2, n, c, rest, frest)

// a block (spec sec 4.2): statements in order, the last expression in res_, then the drops of its handles (latest first)
def Emit.block {r: Region} (cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, pos: Emit.Pos, ss: Coll.List[El.Stmt], last: El.Expr, drops: Coll.List[Emit.Drop]): Unit = ss match
  case Coll.Nil =>
    rt_print("__auto_type res_ = ")
    Emit.ex(cx, fi, env, Emit.lastPos(drops, pos), last)
    rt_print("; ")
    Emit.drops(cx, drops)
    rt_print("res_; })")
  case Coll.Cons(s, rest) => s match
    case El.Val(_, x, ty, _, e) =>
      Emit.ctype(cx, Emit.gr(cx, fi, ty))
      rt_print(" ")
      Emit.cname(Emit.L(x, Emit.envN(env)))
      rt_print(" = ")
      Emit.ex(cx, fi, env, Emit.Inner, e)
      rt_print("; ")
      Emit.block(cx, fi, Emit.bind(env, x), pos, rest, last, drops)
    case El.Handle(_, x, h, args) =>
      val v = Emit.L(x, Emit.envN(env))
      rt_print("srs_cap ")
      Emit.cname(v)
      rt_print("_v = { h_")
      Emit.id(h)
      rt_print("_init(")
      Emit.args(cx, fi, env, args, Emit.First)
      rt_print("), vt_")
      Emit.id(h)
      rt_print(", 1 }; srs_cap* ")
      Emit.cname(v)
      rt_print(" = &")
      Emit.cname(v)
      rt_print("_v; ")
      Emit.block(cx, fi, Emit.bind(env, x), pos, rest, last, Coll.Cons(Emit.Drop(v, Emit.protoOfH(cx, h)), drops))
    case El.Do(e) =>
      rt_print("(void)(")
      Emit.ex(cx, fi, env, Emit.Inner, e)
      rt_print("); ")
      Emit.block(cx, fi, env, pos, rest, last, drops)

// a block with a handle is not a tail position: its drops run after the last expression
def Emit.lastPos(drops: Coll.List[Emit.Drop], pos: Emit.Pos): Emit.Pos = drops match
  case Coll.Nil => pos
  case Coll.Cons(_, _) => Emit.Inner

def Emit.drops {r: Region} (cx: Emit.Cx, ds: Coll.List[Emit.Drop]): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, rest) =>
    val Emit.Drop(v, p) = d
    val Emit.Cx(_, _, _, _, ps, _, _) = cx
    Coll.sLookup(ps, p) match
      case Coll.None => ()
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, _, _, _, dop, ops, _) = pr
        dop match
          case Coll.None => ()
          case Coll.Some(o) =>
            rt_print("if (")
            Emit.cname(v)
            rt_print("->live) ((int64_t(*)(void*))(")
            Emit.cname(v)
            rt_print("->vt[")
            rt_print_i64(Emit.opIn(ops, o, 0))
            rt_print("]))(")
            Emit.cname(v)
            rt_print("->self); ")
    Emit.drops(cx, rest)

// the protocol of handler h
def Emit.protoOfH {r: Region} (cx: Emit.Cx, h: Sym.Sym): Sym.Sym =
  val Emit.Cx(_, _, _, _, _, hp, _) = cx
  Coll.sLookup(hp, h) match
    case Coll.Some(p) => p
    case Coll.None => h

// ── a self call in tail position (spec sec 4.4): the body then gets the srs_tail label ──
def Emit.hasTail {r: Region} (cx: Emit.Cx, fi: Emit.Fi, e: El.Expr): Bool = e match
  case El.CallFn(_, f, ts, _, _) => Emit.isSelf(fi, f, Emit.grAll(cx, fi, ts))
  case El.If(_, _, t, x) => Emit.hasTail(cx, fi, t) || Emit.hasTail(cx, fi, x)
  case El.Match(_, _, _, arms) => Emit.armsTail(cx, fi, arms)
  case El.Block(_, ss, last) => if Emit.hasHandle(ss) then false else Emit.hasTail(cx, fi, last)
  case _ => false

def Emit.armsTail {r: Region} (cx: Emit.Cx, fi: Emit.Fi, as: Coll.List[El.Arm]): Bool = as match
  case Coll.Nil => false
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    if Emit.hasTail(cx, fi, b) then true else Emit.armsTail(cx, fi, rest)

def Emit.hasHandle(ss: Coll.List[El.Stmt]): Bool = ss match
  case Coll.Nil => false
  case Coll.Cons(s, rest) => s match
    case El.Handle(_, _, _, _) => true
    case _ => Emit.hasHandle(rest)

// ── an instance as the fn emit prints ──
def Emit.fiOf {r: Region} (cx: Emit.Cx, i: Mono.Inst): Emit.Fi =
  val Mono.Inst(f, sub) = i
  val El.Fn(_, name, tps, caps, ps, ret, _) = f
  Emit.Fi(name, Emit.targsOf(sub, tps, Coll.Nil), sub, Emit.slots(cx, sub, caps, ps), Mono.ground(Emit.subst(cx), sub, ret))

def Emit.targsOf {r: Region} (sub: Coll.List[Ty.Bind], tps: Coll.List[Sym.Sym], acc: Coll.List[K.Term]): Coll.List[K.Term] = tps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(x, rest) => Ty.lookup(sub, x) match
    case Coll.Some(t) => Emit.targsOf(sub, rest, Coll.Cons(t, acc))
    case Coll.None => Emit.targsOf(sub, rest, Coll.Cons(K.Con(x, Coll.Nil), acc))

// the capabilities first, then the params
def Emit.slots {r: Region} (cx: Emit.Cx, sub: Coll.List[Ty.Bind], caps: Coll.List[Sym.Sym], ps: Coll.List[El.Param]): Coll.List[Emit.Slot] = caps match
  case Coll.Cons(c, rest) => Coll.Cons(Emit.SCap(c), Emit.slots(cx, sub, rest, ps))
  case Coll.Nil => Emit.valSlots(cx, sub, ps, Coll.Nil)

def Emit.valSlots {r: Region} (cx: Emit.Cx, sub: Coll.List[Ty.Bind], ps: Coll.List[El.Param], acc: Coll.List[Emit.Slot]): Coll.List[Emit.Slot] = ps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(p, rest) =>
    val El.Param(x, t) = p
    Emit.valSlots(cx, sub, rest, Coll.Cons(Emit.SVal(x, Mono.ground(Emit.subst(cx), sub, t)), acc))

def Emit.isDef(i: Mono.Inst): Bool =
  val Mono.Inst(f, _) = i
  val El.Fn(_, _, _, _, _, _, body) = f
  body match
    case El.Def(_) => true
    case _ => false

// ── signatures (spec sec 3) and bodies (sec 4.4) ──
def Emit.sig {r: Region} (cx: Emit.Cx, fi: Emit.Fi, k: Emit.Kind): Unit =
  val Emit.Fi(self, targs, _, slots, ret) = fi
  k match
    case Emit.KExtern => ()
    case _ => rt_print("static ")
  Emit.ctype(cx, ret)
  rt_print(" ")
  k match
    case Emit.KDef => Emit.defName(self, targs)
    case Emit.KExtern => Emit.id(self)
    case Emit.KHandler(h) =>
      rt_print("h_")
      Emit.id(h)
      rt_print("_")
      Emit.id(self)
    case Emit.KGiven(head) =>
      rt_print("g_")
      Emit.termName(head)
      rt_print("_")
      Emit.id(self)
  rt_print("(")
  slots match
    case Coll.Nil => rt_print("void")
    case Coll.Cons(_, _) => Emit.params(cx, slots, Emit.First)
  rt_print(")")

def Emit.params {r: Region} (cx: Emit.Cx, slots: Coll.List[Emit.Slot], s: Emit.Sep): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) =>
    Emit.sep(s)
    sl match
      case Emit.SCap(_) => rt_print("srs_cap*")
      case Emit.SVal(_, t) => Emit.ctype(cx, t)
    rt_print(" p_")
    Emit.id(Emit.slotName(sl))
    Emit.params(cx, rest, Emit.Comma)

def Emit.paramEnv {r: Region} (slots: Coll.List[Emit.Slot], acc: Coll.List[Emit.Name]): Emit.Env = slots match
  case Coll.Nil => Emit.Env(acc, 0)
  case Coll.Cons(sl, rest) => Emit.paramEnv(rest, Coll.Cons(Emit.P(Emit.slotName(sl)), acc))

// a def loops on its self tail calls; a handler fn does not (s1 emit.srs:270-275)
def Emit.body {r: Region} (cx: Emit.Cx, fi: Emit.Fi, k: Emit.Kind, e: El.Expr): Unit =
  val Emit.Fi(_, _, _, slots, _) = fi
  Emit.sig(cx, fi, k)
  val pos = k match
    case Emit.KDef => if Emit.hasTail(cx, fi, e) then Emit.Tail else Emit.Inner
    case _ => Emit.Inner
  pos match
    case Emit.Tail => rt_print(" { srs_tail: return ")
    case Emit.Inner => rt_print(" { return ")
  Emit.ex(cx, fi, Emit.paramEnv(slots, Coll.Nil), pos, e)
  rt_print("; }\n")

// ── the enum instances the C names: of every signature and expression, closed over their fields (spec sec 1 B, C) ──
def Emit.instTys {r: Region} (cx: Emit.Cx, is: Coll.List[Mono.Inst], acc: Coll.List[K.Term]): Coll.List[K.Term] = is match
  case Coll.Nil => acc
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, _) = i
    val El.Fn(_, _, _, _, _, _, body) = f
    body match
      case El.Def(e) =>
        val fi = Emit.fiOf(cx, i)
        val Emit.Fi(_, _, _, slots, ret) = fi
        Emit.instTys(cx, rest, Emit.exTys(cx, fi, e, Emit.slotTys(slots, Coll.Cons(ret, acc))))
      case _ => Emit.instTys(cx, rest, acc)

def Emit.slotTys {r: Region} (slots: Coll.List[Emit.Slot], acc: Coll.List[K.Term]): Coll.List[K.Term] = slots match
  case Coll.Nil => acc
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(_) => Emit.slotTys(rest, acc)
    case Emit.SVal(_, t) => Emit.slotTys(rest, Coll.Cons(t, acc))

def Emit.exTys {r: Region} (cx: Emit.Cx, fi: Emit.Fi, e: El.Expr, acc: Coll.List[K.Term]): Coll.List[K.Term] = e match
  case El.CallFn(_, _, _, _, args) => Emit.exsTys(cx, fi, args, acc)
  case El.New(_, en, ts, _, _, args) => Emit.exsTys(cx, fi, args, Coll.Cons(K.Con(en, Emit.grAll(cx, fi, ts)), acc))
  case El.Nullary(_, en, ts, _) => Coll.Cons(K.Con(en, Emit.grAll(cx, fi, ts)), acc)
  case El.Op(_, _, _, _, args) => Emit.exsTys(cx, fi, args, acc)
  case El.Bin(_, _, l, x) => Emit.exTys(cx, fi, x, Emit.exTys(cx, fi, l, acc))
  case El.Un(_, _, x) => Emit.exTys(cx, fi, x, acc)
  case El.If(_, c, t, x) => Emit.exTys(cx, fi, x, Emit.exTys(cx, fi, t, Emit.exTys(cx, fi, c, acc)))
  case El.Match(_, x, en, arms) => Emit.armsTys(cx, fi, arms, Emit.exTys(cx, fi, x, Coll.Cons(Emit.gr(cx, fi, en), acc)))
  case El.Block(_, ss, last) => Emit.exTys(cx, fi, last, Emit.stmtsTys(cx, fi, ss, acc))
  case El.While(_, c, b) => Emit.exTys(cx, fi, b, Emit.exTys(cx, fi, c, acc))
  case El.Assign(_, _, x) => Emit.exTys(cx, fi, x, acc)
  case _ => acc

def Emit.exsTys {r: Region} (cx: Emit.Cx, fi: Emit.Fi, xs: Coll.List[El.Expr], acc: Coll.List[K.Term]): Coll.List[K.Term] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Emit.exsTys(cx, fi, rest, Emit.exTys(cx, fi, x, acc))

def Emit.armsTys {r: Region} (cx: Emit.Cx, fi: Emit.Fi, as: Coll.List[El.Arm], acc: Coll.List[K.Term]): Coll.List[K.Term] = as match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    Emit.armsTys(cx, fi, rest, Emit.exTys(cx, fi, b, acc))

def Emit.stmtsTys {r: Region} (cx: Emit.Cx, fi: Emit.Fi, ss: Coll.List[El.Stmt], acc: Coll.List[K.Term]): Coll.List[K.Term] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => s match
    case El.Val(_, _, ty, _, e) => Emit.stmtsTys(cx, fi, rest, Emit.exTys(cx, fi, e, Coll.Cons(Emit.gr(cx, fi, ty), acc)))
    case El.Handle(_, _, _, args) => Emit.stmtsTys(cx, fi, rest, Emit.exsTys(cx, fi, args, acc))
    case El.Do(e) => Emit.stmtsTys(cx, fi, rest, Emit.exTys(cx, fi, e, acc))

// the distinct enum terms of todo and of their fields, in the order found (seen: by hash bucket)
def Emit.closeEnums {r: Region} (cx: Emit.Cx, todo: Coll.List[K.Term], seen: Coll.BTree[Coll.List[K.Term]], out: Coll.List[K.Term]): Coll.List[K.Term] = todo match
  case Coll.Nil => Coll.rev(out)
  case Coll.Cons(t, rest) => t match
    case K.Con(n, args) =>
      val Emit.Cx(_, _, _, es, _, _, _) = cx
      val h = Mono.thash(t, 0)
      Coll.sLookup(es, n) match
        case Coll.None => Emit.closeEnums(cx, rest, seen, out)
        case Coll.Some(e) =>
          if Emit.inTerms(Coll.bTGetOr(seen, h, Coll.Nil), t) then Emit.closeEnums(cx, rest, seen, out)
          else Emit.closeEnums(cx, Emit.fieldTys(e, args, rest), Coll.bPushT(seen, h, t), Coll.Cons(t, out))
    case _ => Emit.closeEnums(cx, rest, seen, out)

def Emit.inTerms(ts: Coll.List[K.Term], t: K.Term): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(x, rest) => if Mono.termEq(x, t) then true else Emit.inTerms(rest, t)

// the field types of enum e at args
def Emit.fieldTys {r: Region} (e: Ast.Enum, args: Coll.List[K.Term], acc: Coll.List[K.Term]): Coll.List[K.Term] =
  val Ast.Enum(_, _, gs, cases) = e
  Emit.casesTys(cases, Ty.zipBind(Ty.tparams(gs, Coll.Nil), args, Coll.Nil), acc)

def Emit.casesTys {r: Region} (cs: Coll.List[Ast.Case], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = cs match
  case Coll.Nil => acc
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, fs) = c
    Emit.casesTys(rest, tv, Emit.bindersTys(fs, tv, acc))

def Emit.bindersTys {r: Region} (fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Binder(_, _, t) = f
    Emit.bindersTys(rest, tv, Coll.Cons(Ty.term(t, tv), acc))

// ── enum structs and nullary statics (spec sec 1.1) ──
def Emit.fwds(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    rt_print("struct E_")
    Emit.termName(t)
    rt_print(";\n")
    Emit.fwds(rest)

def Emit.termName(t: K.Term): Unit = t match
  case K.Con(n, args) => Emit.enumName(n, args)
  case _ => Emit.mangle(t)

def Emit.structs {r: Region} (cx: Emit.Cx, ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Emit.withEnum(cx, t, Emit.Layout)
    Emit.structs(cx, rest)

def Emit.statics {r: Region} (cx: Emit.Cx, ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Emit.withEnum(cx, t, Emit.Code)
    Emit.statics(cx, rest)

// the struct (Layout) or the nullary statics (Code) of enum term t
def Emit.withEnum {r: Region} (cx: Emit.Cx, t: K.Term, what: Emit.Part): Unit = t match
  case K.Con(n, args) =>
    val Emit.Cx(_, _, _, es, _, _, _) = cx
    Coll.sLookup(es, n) match
      case Coll.None => ()
      case Coll.Some(e) =>
        val Ast.Enum(_, _, gs, cases) = e
        val tv = Ty.zipBind(Ty.tparams(gs, Coll.Nil), args, Coll.Nil)
        what match
          case Emit.Layout =>
            rt_print("struct E_")
            Emit.enumName(n, args)
            rt_print(" { int64_t tag; union {")
            Emit.caseStructs(cx, cases, tv)
            rt_print(" int64_t none_; } u; };\n")
          case Emit.Code => Emit.nullaries(n, args, cases, 0)
  case _ => ()

def Emit.caseStructs {r: Region} (cx: Emit.Cx, cs: Coll.List[Ast.Case], tv: Coll.List[Ty.Bind]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, cn, fs) = c
    fs match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        rt_print(" struct {")
        Emit.fieldDecls(cx, fs, tv)
        rt_print(" } C_")
        Emit.id(cn)
        rt_print(";")
    Emit.caseStructs(cx, rest, tv)

def Emit.fieldDecls {r: Region} (cx: Emit.Cx, fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val Ast.Binder(_, x, t) = f
    rt_print(" ")
    Emit.ctype(cx, Ty.term(t, tv))
    rt_print(" f_")
    Emit.id(x)
    rt_print(";")
    Emit.fieldDecls(cx, rest, tv)

def Emit.nullaries(n: Sym.Sym, args: Coll.List[K.Term], cs: Coll.List[Ast.Case], i: I64): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, cn, fs) = c
    fs match
      case Coll.Nil =>
        rt_print("static struct E_")
        Emit.enumName(n, args)
        rt_print(" N_")
        Emit.id(cn)
        Emit.suffix(args)
        rt_print(" = { ")
        rt_print_i64(i)
        rt_print(", { 0 } };\n")
      case Coll.Cons(_, _) => ()
    Emit.nullaries(n, args, rest, i + 1)

// ── prototypes (spec sec 1 D), vtables (E), bodies (G) ──
def Emit.externs {r: Region} (cx: Emit.Cx, fs: Coll.List[El.Fn]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, tps, _, _, _, body) = f
    body match
      case El.Extern => tps match
        case Coll.Nil =>
          Emit.sig(cx, Emit.fiOf(cx, Mono.Inst(f, Coll.Nil)), Emit.KExtern)
          rt_print(";\n")
        case Coll.Cons(_, _) => ()
      case _ => ()
    Emit.externs(cx, rest)

def Emit.protos {r: Region} (cx: Emit.Cx, is: Coll.List[Mono.Inst]): Unit = is match
  case Coll.Nil => ()
  case Coll.Cons(i, rest) =>
    if Emit.isDef(i) then
      Emit.sig(cx, Emit.fiOf(cx, i), Emit.KDef)
      rt_print(";\n")
    else ()
    Emit.protos(cx, rest)

def Emit.bodies {r: Region} (cx: Emit.Cx, is: Coll.List[Mono.Inst]): Unit = is match
  case Coll.Nil => ()
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, _) = i
    val El.Fn(_, _, _, _, _, _, body) = f
    body match
      case El.Def(e) => Emit.body(cx, Emit.fiOf(cx, i), Emit.KDef, e)
      case _ => ()
    Emit.bodies(cx, rest)

// the fns of every handler: prototypes (Layout) or bodies (Code)
def Emit.handlers {r: Region} (cx: Emit.Cx, hs: Coll.List[El.Handler], what: Emit.Part): Unit = hs match
  case Coll.Nil => ()
  case Coll.Cons(h, rest) =>
    val El.Handler(hn, _, fs) = h
    Emit.implFns(cx, Emit.KHandler(hn), fs, what)
    Emit.handlers(cx, rest, what)

// the fns of every given (spec sec 2 fname: g_<Trait><args>_<m>, a static call per instance)
def Emit.givens {r: Region} (cx: Emit.Cx, gs: Coll.List[El.Given], what: Emit.Part): Unit = gs match
  case Coll.Nil => ()
  case Coll.Cons(g, rest) =>
    val El.Given(head, fs) = g
    Emit.implFns(cx, Emit.KGiven(head), fs, what)
    Emit.givens(cx, rest, what)

def Emit.implFns {r: Region} (cx: Emit.Cx, k: Emit.Kind, fs: Coll.List[El.Fn], what: Emit.Part): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, _, _, _, _, body) = f
    val fi = Emit.fiOf(cx, Mono.Inst(f, Coll.Nil))
    what match
      case Emit.Layout =>
        Emit.sig(cx, fi, k)
        rt_print(";\n")
      case Emit.Code => body match
        case El.Def(e) => Emit.body(cx, fi, k, e)
        case _ => ()
    Emit.implFns(cx, k, rest, what)

// the vtable of a handler: its fn per op of its protocol, in the protocol's op order (spec sec 5.1)
def Emit.vtables {r: Region} (cx: Emit.Cx, hs: Coll.List[El.Handler]): Unit = hs match
  case Coll.Nil => ()
  case Coll.Cons(h, rest) =>
    val El.Handler(hn, p, _) = h
    val Emit.Cx(_, _, _, _, ps, _, _) = cx
    rt_print("static void* const vt_")
    Emit.id(hn)
    rt_print("[] = {")
    Coll.sLookup(ps, p) match
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
        Emit.vtOps(hn, ops)
      case Coll.None => ()
    rt_print(" 0 };\n")
    Emit.vtables(cx, rest)

def Emit.vtOps(hn: Sym.Sym, ops: Coll.List[Ast.Op]): Unit = ops match
  case Coll.Nil => ()
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, n, _, _, _) = o
    rt_print(" (void*)h_")
    Emit.id(hn)
    rt_print("_")
    Emit.id(n)
    rt_print(",")
    Emit.vtOps(hn, rest)

// the inline Arena bump (spec sec 5.2): the chunk layout of rt/srs_rt.c:24-25
def Emit.allocFast {r: Region} (cx: Emit.Cx): Unit =
  rt_print("typedef struct srs_chunk { struct srs_chunk* next; size_t used, cap; } srs_chunk;\n")
  rt_print("static inline void* srs_alloc(srs_cap* c, int64_t size) {\n")
  rt_print("  if (c->vt == vt_Arena) {\n")
  rt_print("    srs_chunk* h = *(srs_chunk**)c->self;\n")
  rt_print("    size_t n = ((size_t)size + 15) & ~(size_t)15;\n")
  rt_print("    if (h && h->used + n <= h->cap) { void* p = (char*)(h + 1) + h->used; h->used += n; return p; }\n")
  rt_print("    return rt_arena_alloc(c->self, size);\n")
  rt_print("  }\n")
  rt_print("  return ((void*(*)(void*, int64_t))c->vt[")
  rt_print_i64(Emit.opIndex(cx, Sym.of("Region"), Sym.of("alloc")))
  rt_print("])(c->self, size);\n")
  rt_print("}\n")

def Emit.hasMain {r: Region} (cx: Emit.Cx): Bool =
  val Emit.Cx(_, fns, _, _, _, _, _) = cx
  Coll.sLookup(fns, Sym.of("main")) match
    case Coll.Some(_) => true
    case Coll.None => false

// ── the program (spec sec 1): one C file to stdout ──
def Emit.program {r: Region} (ds: Coll.List[Ast.Decl], res: Ty.Result): Unit =
  val Ty.Result(_, _, s, fs, hs, gvs) = res
  val cx = Emit.cxOf(ds, s, fs)
  val is = Mono.run(res)
  val ens = Emit.closeEnums(cx, Emit.instTys(cx, is, Coll.Nil), Coll.BTip, Coll.Nil)
  rt_print("// DO-NOT-EDIT. Generated by srs (s2/emit.srs).\n")
  rt_print("#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n")
  rt_print("typedef struct { const uint8_t* p; int64_t n; } srs_str;\n")
  rt_print("typedef struct { void* self; void* const* vt; int64_t live; } srs_cap;\n")
  rt_print("void rt_init(int argc, char** argv);\n")
  Emit.fwds(ens)
  Emit.structs(cx, ens)
  Emit.statics(cx, ens)
  Emit.externs(cx, fs)
  Emit.protos(cx, is)
  Emit.handlers(cx, hs, Emit.Layout)
  Emit.givens(cx, gvs, Emit.Layout)
  Emit.vtables(cx, hs)
  val Emit.Cx(_, _, _, _, _, _, al) = cx
  al match
    case Emit.Inline => Emit.allocFast(cx)
    case Emit.VTable => ()
  Emit.bodies(cx, is)
  Emit.handlers(cx, hs, Emit.Code)
  Emit.givens(cx, gvs, Emit.Code)
  if Emit.hasMain(cx) then rt_print("int main(int argc, char** argv) { rt_init(argc, argv); return (int)f_main(); }\n") else ()
