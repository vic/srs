// s2 self-host rung B2 (vic/c/s2-emit-spec.md): the C of an elaborated program at its mono instances, as s1/emit.srs
// prints it. the input typed with no clash, so every name the lookups read is declared. one C file to stdout.

// a case: its tag (declaration index), its enum and its fields
enum Emit.CaseAt:
  case Emit.CaseAt(tag: I64, en: Ast.Enum, c: Ast.Case)

// how a constructor allocates: an inline bump when the program has the Srs.Arena handler (rt/srs_rt.c:24-25), else the vtable
enum Emit.Alloc:
  case Emit.Inline
  case Emit.VTable

def Emit.isInline(al: Emit.Alloc): Bool = al match
  case Emit.Inline => true
  case Emit.VTable => false

// the declarations emit reads, by name
enum Emit.Cx:
  case Emit.Cx(s: K.Subst, fns: Coll.SMap[El.Fn], cases: Coll.SMap[Emit.CaseAt], enums: Coll.SMap[Ast.Enum], protos: Coll.SMap[Ast.Proto], hprotos: Coll.SMap[Sym.Sym], alloc: Emit.Alloc, nominal: Coll.SMap[K.Term], statics: Coll.List[Emit.Static])

// a C local: a param p_x, or a binding v_x_n (n = the number of locals bound before it)
enum Emit.Name:
  case Emit.P(x: Sym.Sym)
  case Emit.L(x: Sym.Sym, n: I64)

enum Emit.Env:
  case Emit.Env(vs: Coll.List[Emit.Name], n: I64)

// a capability opened by a handle: its protocol's drop op runs at the end of the block if it is still live
enum Emit.Drop:
  case Emit.Drop(c: Emit.Name, proto: Sym.Sym)

// a C param: a capability (srs_cap*) or a value of a ground type
enum Emit.Slot:
  case Emit.SCap(x: Sym.Sym)
  case Emit.SVal(x: Sym.Sym, t: K.Term)

// the fn being printed: name and ground type args (a self call with them in tail position is a jump), the binder
// substitution, the C params, the ground result
enum Emit.Fi:
  case Emit.Fi(self: Sym.Sym, targs: Coll.List[K.Term], sub: Coll.List[Ty.Bind], slots: Coll.List[Emit.Slot], ret: K.Term)

// tail position: a self call there is a jump
enum Emit.Pos:
  case Emit.Tail
  case Emit.Inner

// what a signature names: a def instance f_, a runtime symbol, a handler fn h_<H>_, a given fn g_<Trait><args>_
enum Emit.Kind:
  case Emit.KDef
  case Emit.KExtern
  case Emit.KHandler(h: Sym.Sym)
  case Emit.KGiven(head: K.Term)

// args after the first print a comma before them
enum Emit.Sep:
  case Emit.First
  case Emit.Comma

// the test of a match arm: a `_` arm always holds, a case arm tests the tag
enum Emit.Guard:
  case Emit.Always
  case Emit.Tag(tag: I64)

// a declaration's layout (enum struct, fn prototype) or its code (nullary statics, fn body)
enum Emit.Part:
  case Emit.Layout
  case Emit.Code

// ── the declarations by name ──
def Emit.cxOf(ds: Coll.List[Ast.Decl], s: K.Subst, fs: Coll.List[El.Fn], sc: Coll.List[Emit.Static]): Emit.Cx =
  Emit.cxDecls(ds, Emit.Cx(s, Emit.fnMap(fs, Coll.sEmpty()), Coll.sEmpty(), Coll.sEmpty(), Coll.sEmpty(), Coll.sEmpty(), Emit.VTable, Coll.sEmpty(), sc))

def Emit.fnMap(fs: Coll.List[El.Fn], m: Coll.SMap[El.Fn]): Coll.SMap[El.Fn] = fs match
  case Coll.Nil => m
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, _) = f
    Emit.fnMap(rest, Coll.sInsert(m, n, f))

def Emit.cxDecls(ds: Coll.List[Ast.Decl], cx: Emit.Cx): Emit.Cx = ds match
  case Coll.Nil => cx
  case Coll.Cons(d, rest) =>
    val Emit.Cx(s, fns, cs, es, ps, hp, al, nm, sc) = cx
    d match
      case Ast.DEnum(e) =>
        val Ast.Enum(_, n, _, cases) = e
        Emit.cxDecls(rest, Emit.Cx(s, fns, Emit.caseMap(cases, e, 0, cs), Coll.sInsert(es, n, e), ps, hp, al, nm, sc))
      case Ast.DProto(p) =>
        val Ast.Proto(_, n, _, _, _, _, _, _) = p
        Emit.cxDecls(rest, Emit.Cx(s, fns, cs, es, Coll.sInsert(ps, n, p), hp, al, nm, sc))
      case Ast.DHandler(h) =>
        val Ast.Handler(_, n, p, _, _) = h
        Emit.cxDecls(rest, Emit.Cx(s, fns, cs, es, ps, Coll.sInsert(hp, n, p), if Str.eq(Sym.str(n), "Srs.Arena") then Emit.Inline else al, nm, sc))
      // a type with <> facts stays nominal through typing (s2/tlevel.srs Tl.nominal): in C it is its body's type
      case Ast.DType(td) =>
        val Ast.TypeDecl(_, n, _, _, body) = td
        body match
          case Ast.Alias(t) => Emit.cxDecls(rest, Emit.Cx(s, fns, cs, es, ps, hp, al, Coll.sInsert(nm, n, Ty.term(t, Coll.Nil)), sc))
          // an extern "libc" struct: its C type is a pointer to the header struct (Emit.ctype reads the CStruct. marker)
          case Ast.CStruct(_) => Emit.cxDecls(rest, Emit.Cx(s, fns, cs, es, ps, hp, al, Coll.sInsert(nm, n, K.Con(Eff.dotted("CStruct", n), Coll.Nil)), sc))
          case _ => Emit.cxDecls(rest, cx)
      case _ => Emit.cxDecls(rest, cx)

def Emit.caseMap(cs: Coll.List[Ast.Case], e: Ast.Enum, i: I64, m: Coll.SMap[Emit.CaseAt]): Coll.SMap[Emit.CaseAt] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    Emit.caseMap(rest, e, i + 1, Coll.sInsert(m, n, Emit.CaseAt(i, e, c)))

def Emit.isProto(cx: Emit.Cx, n: Sym.Sym): Bool =
  val Emit.Cx(_, _, _, _, ps, _, _, _, _) = cx
  Coll.sLookup(ps, n) match
    case Coll.Some(_) => true
    case Coll.None => false

def Emit.caseAt(cx: Emit.Cx, c: Sym.Sym): Coll.Option[Emit.CaseAt] =
  val Emit.Cx(_, _, cs, _, _, _, _, _, _) = cx
  Coll.sLookup(cs, c)

def Emit.subst(cx: Emit.Cx): K.Subst =
  val Emit.Cx(s, _, _, _, _, _, _, _, _) = cx
  s

def Emit.grAll(cx: Emit.Cx, fi: Emit.Fi, ts: Coll.List[K.Term]): Coll.List[K.Term] =
  val Emit.Fi(_, _, sub, _, _) = fi
  Mono.groundAll(Emit.subst(cx), sub, ts, Coll.Nil)

def Emit.gr(cx: Emit.Cx, fi: Emit.Fi, t: K.Term): K.Term =
  val Emit.Fi(_, _, sub, _, _) = fi
  Mono.ground(Emit.subst(cx), sub, t)

// ── names (spec sec 2) ──
// x with each `.` as `__`
def Emit.id(x: Sym.Sym): Unit = Emit.idFrom(Sym.str(x), 0, 0, Str.len(Sym.str(x)))

def Emit.idFrom(s: Str, b: I64, i: I64, n: I64): Unit =
  if i == n then Console.print(Str.slice(s, b, i))
  else if Str.at(s, i) == 46 then
    Console.print(Str.slice(s, b, i))
    Console.print("__")
    Emit.idFrom(s, i + 1, i + 1, n)
  else Emit.idFrom(s, b, i + 1, n)

def Emit.mangle(t: K.Term): Unit = t match
  case K.Con(n, args) =>
    Emit.id(n)
    args match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("_")
        Console.printI64(Coll.length(args))
        Emit.mangleArgs(args)
  case K.Int(v) => Console.printI64(v)
  case K.Var(v) =>
    Console.print("V")
    Console.printI64(v)

def Emit.mangleArgs(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Console.print("_")
    Emit.mangle(t)
    Emit.mangleArgs(rest)

// an instance suffix: nothing for no type args
def Emit.suffix(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(_, _) =>
    Console.print("_")
    Emit.mangleArgs(ts)

def Emit.enumName(n: Sym.Sym, args: Coll.List[K.Term]): Unit =
  Emit.id(n)
  Emit.suffix(args)

def Emit.cname(v: Emit.Name): Unit = v match
  case Emit.P(x) =>
    Console.print("p_")
    Emit.id(x)
  case Emit.L(x, n) =>
    Console.print("v_")
    Emit.id(x)
    Console.print("_")
    Console.printI64(n)

// the innermost local named x
def Emit.local(vs: Coll.List[Emit.Name], x: Sym.Sym): Unit = vs match
  case Coll.Nil => Emit.id(x)
  case Coll.Cons(v, rest) => if Sym.eq(Emit.nameOf(v), x) then Emit.cname(v) else Emit.local(rest, x)

def Emit.nameOf(v: Emit.Name): Sym.Sym = v match
  case Emit.P(x) => x
  case Emit.L(x, _) => x

def Emit.vs(env: Emit.Env): Coll.List[Emit.Name] =
  val Emit.Env(vs, _) = env
  vs

def Emit.envN(env: Emit.Env): I64 =
  val Emit.Env(_, n) = env
  n

def Emit.bind(env: Emit.Env, x: Sym.Sym): Emit.Env =
  val Emit.Env(vs, n) = env
  Emit.Env(Coll.Cons(Emit.L(x, n), vs), n + 1)

// ── types (spec sec 3): a ground term ──
def Emit.ctype(cx: Emit.Cx, t: K.Term): Unit = t match
  case K.Con(n, args) =>
    val x = Sym.str(n)
    if Str.eq(x, "I64") || Str.eq(x, "Unit") then Console.print("int64_t")
    else if Str.eq(x, "Bool") then Console.print("bool")
    else if Str.eq(x, "Str") then Console.print("srs_str")
    else if Str.eq(x, "Ptr") then Console.print("void*")
    else if Str.eq(x, "U32") then Console.print("uint32_t")
    else if Str.eq(x, "U8") then Console.print("uint8_t")
    else if Str.eq(x, "I32") then Console.print("int32_t")
    else if Str.eq(x, "CStr") then Console.print("const char*")
    else if Str.len(x) > 8 && Str.eq(Str.slice(x, 0, 8), "CStruct.") then Emit.cstructPtr(Str.slice(x, 8, Str.len(x)))
    else if Str.eq(x, "U64") then Console.print("uint64_t")
    // A1: Array[A](n) is one pointer to its elements (no header); Cell[A] a pointer to its word
    else if Str.eq(x, "Array") || Str.eq(x, "Cell") then Emit.arrayC(cx, args)
    else if Emit.isProto(cx, n) then Console.print("srs_cap*")
    else Emit.nominalOf(cx, n) match
      case Coll.Some(b) => Emit.ctype(cx, b)
      case Coll.None =>
        Console.print("struct E_")
        Emit.enumName(n, args)
        Console.print("*")
  case _ => Console.print("int64_t")

def Emit.arrayC(cx: Emit.Cx, args: Coll.List[K.Term]): Unit = args match
  case Coll.Cons(a, _) =>
    Emit.ctype(cx, a)
    Console.print("*")
  case Coll.Nil => Console.print("void*")

def Emit.nominalOf(cx: Emit.Cx, n: Sym.Sym): Coll.Option[K.Term] =
  val Emit.Cx(_, _, _, _, _, _, _, nm, _) = cx
  Coll.sLookup(nm, n)

// ── expressions (spec sec 4) ──
def Emit.ex(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, pos: Emit.Pos, e: El.Expr): Unit = e match
  case El.Int(_, v, k) =>
    val c: Str = k match
      case El.KI64 => "((int64_t)"
      case El.KU32 => "((uint32_t)"
      case El.KU64 => "((uint64_t)"
    Console.print(c)
    Console.printI64(v)
    Console.print(")")
  case El.Bool(_, v) => Console.print(if v then "true" else "false")
  case El.Str(_, s) =>
    Console.print("((srs_str){(const uint8_t*)\"")
    Console.print(s)
    Console.print("\", ")
    Console.printI64(Emit.unescLen(s, 0, 0))
    Console.print("})")
  case El.Unit(_) => Console.print("((int64_t)0)")
  case El.Local(_, x) => Emit.local(Emit.vs(env), x)
  case El.CallFn(_, f, ts, caps, args) =>
    val gts = Emit.grAll(cx, fi, ts)
    if Emit.isTail(pos) && Emit.isSelf(fi, f, gts) then Emit.jump(cx, fi, env, caps, args)
    else if Coll.length(args) == 0 && Emit.isLibcValCall(cx, f) then Emit.libcValRead(cx, f)
    else
      val cast = Emit.externCast(cx, f, gts)
      cast match
        case Coll.Some(t) =>
          Console.print("((")
          Emit.ctype(cx, t)
          Console.print(")")
        case Coll.None => ()
      Emit.fnName(cx, f, gts)
      Console.print("(")
      Emit.capArgs(env, caps, Emit.First)
      Emit.args(cx, fi, env, args, if Coll.length(caps) == 0 then Emit.First else Emit.Comma)
      Console.print(")")
      cast match
        case Coll.Some(_) => Console.print(")")
        case Coll.None => ()
  case El.New(_, en, ts, c, at, args) => at match
    case El.In(reg) => Emit.ctor(cx, fi, env, en, Emit.grAll(cx, fi, ts), c, reg, args)
    case El.Comptime => Console.print("0")
  // a nullary case is P_, the address of its read-only static (Emit.nullaries)
  case El.Nullary(_, _, ts, c) =>
    Console.print("P_")
    Emit.id(c)
    Emit.suffix(Emit.grAll(cx, fi, ts))
  case El.Op(_, recv, ty, op, args, caps) => Emit.op(cx, fi, env, recv, Emit.gr(cx, fi, ty), op, args, caps)
  // a multi-shot handle: the locals in scope by address, then the first segment (Emit.mSite prints the segments)
  case El.MHandled(_, _, _, _, _, _, _, _) =>
    Console.print("({ void* e0_[] = { ")
    Emit.addrNames(Coll.rev(Emit.vs(env)), Emit.First)
    Console.print(" }; ")
    Emit.msName(fi, 0)
    Console.print("(e0_, 0); })")
  // resume k(v) in a site's op fn: the next segment with its locals
  case El.Resume(_, _, x) =>
    Console.print("k_(ke_, ")
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Console.print(")")
  case El.TCall(_, ty, op, caps, args) => Emit.tcall(cx, fi, env, Emit.gr(cx, fi, ty), op, caps, args)
  case El.Bin(_, op, l, x) =>
    Console.print("(")
    Emit.ex(cx, fi, env, Emit.Inner, l)
    Console.print(Emit.binOp(op))
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Console.print(")")
  case El.Un(_, op, x) =>
    Console.print(Emit.unOp(op))
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Console.print(")")
  case El.If(_, c, t, x) =>
    Console.print("(")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    Console.print(" ? ")
    Emit.ex(cx, fi, env, pos, t)
    Console.print(" : ")
    Emit.ex(cx, fi, env, pos, x)
    Console.print(")")
  case El.Match(_, x, _, arms) =>
    Console.print("({ __auto_type s")
    Console.printI64(Emit.envN(env))
    Console.print(" = ")
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Console.print("; ")
    Emit.arms(cx, fi, env, pos, arms)
    Console.print("; })")
  case El.Block(_, ss, last) =>
    Console.print("({ ")
    Emit.block(cx, fi, env, pos, ss, last, Coll.Nil)
  case El.While(_, c, b) =>
    Console.print("({ while (")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    Console.print(") { (void)(")
    Emit.ex(cx, fi, env, Emit.Inner, b)
    Console.print("); } (int64_t)0; })")
  case El.Assign(_, x, v) =>
    Console.print("(")
    Emit.local(Emit.vs(env), x)
    Console.print(" = (")
    Emit.ex(cx, fi, env, Emit.Inner, v)
    Console.print("), (int64_t)0)")
  case El.Fill(_, reg, n, x, a) => Emit.newArray(cx, fi, env, reg, n, Emit.gr(cx, fi, a), Sym.of("fill.i"), x, true)
  case El.Tab(_, reg, n, a, i, g) => Emit.newArray(cx, fi, env, reg, n, Emit.gr(cx, fi, a), i, g, false)
  // A1 Cell[A]: a pointer to one word
  case El.CellNew(_, reg, v, a) =>
    val t = Emit.gr(cx, fi, a)
    Console.print("({ ")
    Emit.ctype(cx, t)
    Console.print("* cp_ = (")
    Emit.ctype(cx, t)
    Console.print("*)")
    Emit.allocOpen(cx, env, reg)
    Console.print("(int64_t)sizeof(")
    Emit.ctype(cx, t)
    Console.print(")); *cp_ = (")
    Emit.ex(cx, fi, env, Emit.Inner, v)
    Console.print("); cp_; })")
  // extern "libc" struct: a call of the emitted srs_cnew_<name> (Emit.cnewFns): sizeof(struct name) zeroed bytes in the Region; a field is read through the real header struct
  case El.CNew(_, reg, name) =>
    Console.print("srs_cnew_")
    Emit.cid(name)
    Console.print("(")
    Emit.local(Emit.vs(env), reg)
    Console.print(")")
  case El.CField(_, c, name, field, t) =>
    Console.print("((")
    Emit.ctype(cx, Emit.gr(cx, fi, t))
    Console.print(")(((struct ")
    Emit.cid(name)
    Console.print("*)(")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    Console.print("))->")
    Console.print(Sym.str(field))
    Console.print("))")
  case El.CellGet(_, c) =>
    Console.print("(*(")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    Console.print("))")
  case El.CellPut(_, c, v) =>
    Console.print("(*(")
    Emit.ex(cx, fi, env, Emit.Inner, c)
    Console.print(") = (")
    Emit.ex(cx, fi, env, Emit.Inner, v)
    Console.print("), (int64_t)0)")
  // A1b: the index is proved in range (Ty.arrPut): a plain store, no branch
  case El.ArrPut(_, x, i, v) =>
    Console.print("(")
    Emit.local(Emit.vs(env), x)
    Console.print("[")
    Emit.ex(cx, fi, env, Emit.Inner, i)
    Console.print("] = (")
    Emit.ex(cx, fi, env, Emit.Inner, v)
    Console.print("), (int64_t)0)")
  // Ty.blit: the copy is in range for every s, so a plain memcpy of min(m, len s) bytes
  case El.Blit(_, x, a, b, m) =>
    Console.print("(Array__blit(&")
    Emit.local(Emit.vs(env), x)
    Console.print("[")
    Emit.ex(cx, fi, env, Emit.Inner, a)
    Console.print("], ")
    Emit.ex(cx, fi, env, Emit.Inner, b)
    Console.print(", ")
    Emit.ex(cx, fi, env, Emit.Inner, m)
    Console.print("), (int64_t)0)")
  // A1: the index is proved in range (Ty.index): a plain load, no branch
  case El.Index(_, x, i) =>
    Emit.local(Emit.vs(env), x)
    Console.print("[")
    Emit.ex(cx, fi, env, Emit.Inner, i)
    Console.print("]")
  case El.Slice(_, x, o) =>
    Console.print("(")
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Console.print(" + ")
    Emit.ex(cx, fi, env, Emit.Inner, o)
    Console.print(")")
  case El.Bad(_) => Console.print("0")

// A1 Array.fill / Array.tabulate: n elements of C type a in region reg, every one written before the array is seen
// (once: x evaluated once for fill; per index i: g for tabulate). n <= 0 gives no element; a byte count past 2^62
// saturates, so the region fails with out of memory instead of a short block
def Emit.newArray(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, reg: Sym.Sym, n: El.Expr, a: K.Term, i: Sym.Sym, g: El.Expr, once: Bool): Unit =
  Console.print("({ int64_t an_ = (")
  Emit.ex(cx, fi, env, Emit.Inner, n)
  Console.print("); ")
  if once then
    Emit.ctype(cx, a)
    Console.print(" ax_ = (")
    Emit.ex(cx, fi, env, Emit.Inner, g)
    Console.print("); ")
  else ()
  Emit.ctype(cx, a)
  Console.print("* ap_ = (")
  Emit.ctype(cx, a)
  Console.print("*)")
  Emit.allocOpen(cx, env, reg)
  Console.print("an_ <= 0 ? 0 : an_ >(int64_t)(((int64_t)1 << 62) / sizeof(")
  Emit.ctype(cx, a)
  Console.print(")) ? ((int64_t)1 << 62) : an_ * (int64_t)sizeof(")
  Emit.ctype(cx, a)
  Console.print(")); ")
  val env2 = Emit.bind(env, i)
  Console.print("for (int64_t ")
  Emit.local(Emit.vs(env2), i)
  Console.print(" = 0; ")
  Emit.local(Emit.vs(env2), i)
  Console.print(" < an_; ")
  Emit.local(Emit.vs(env2), i)
  Console.print("++) ap_[")
  Emit.local(Emit.vs(env2), i)
  Console.print("] = ")
  if once then Console.print("ax_") else Emit.ex(cx, fi, env2, Emit.Inner, g)
  Console.print("; ap_; })")

// the start of an allocation call in region reg, up to the size arg (as Emit.ctor: the inline bump when Srs.Arena is in
// the program, else the region's alloc op)
def Emit.allocOpen(cx: Emit.Cx, env: Emit.Env, reg: Sym.Sym): Unit =
  val Emit.Cx(_, _, _, _, _, _, al, _, _) = cx
  al match
    case Emit.Inline =>
      Console.print("srs_alloc(")
      Emit.local(Emit.vs(env), reg)
      Console.print(", ")
    case Emit.VTable =>
      Console.print("((void*(*)(void*, int64_t))(")
      Emit.local(Emit.vs(env), reg)
      Console.print("->vt[")
      Console.printI64(Emit.opIndex(cx, Sym.of("Region"), Sym.of("alloc")))
      Console.print("]))(")
      Emit.local(Emit.vs(env), reg)
      Console.print("->self, ")

def Emit.binOp(op: Ast.BinOp): Str = op match
  case Ast.Add => " + "
  case Ast.Sub => " - "
  case Ast.Mul => " * "
  case Ast.Div => " / "
  case Ast.Mod => " % "
  case Ast.Lt => " < "
  case Ast.Le => " <= "
  case Ast.Gt => " > "
  case Ast.Ge => " >= "
  case Ast.Eq => " == "
  case Ast.Ne => " != "
  case Ast.And => " && "
  case Ast.Or => " || "
  // on uint32_t / uint64_t (Ty.bin); a shift count is already n & 31 or n & 63 (Ty.shift): no C undefined behavior
  case Ast.BitOr => " | "
  case Ast.BitXor => " ^ "
  case Ast.BitAnd => " & "
  case Ast.Shl => " << "
  case Ast.Shr => " >> "

def Emit.unOp(op: Ast.UnOp): Str = op match
  case Ast.Neg => "(-"
  case Ast.Not => "(!"
  case Ast.BitNot => "(~"

// the length of a literal: an escape counts as one char
def Emit.unescLen(s: Str, i: I64, n: I64): I64 =
  if i >= Str.len(s) then n
  else if Str.at(s, i) == 92 then Emit.unescLen(s, i + 2, n + 1)
  else Emit.unescLen(s, i + 1, n + 1)

def Emit.isTail(pos: Emit.Pos): Bool = pos match
  case Emit.Tail => true
  case Emit.Inner => false

def Emit.isSelf(fi: Emit.Fi, f: Sym.Sym, ts: Coll.List[K.Term]): Bool =
  val Emit.Fi(self, sts, _, _, _) = fi
  Sym.eq(f, self) && Mono.termsEq(ts, sts)

def Emit.fnName(cx: Emit.Cx, f: Sym.Sym, ts: Coll.List[K.Term]): Unit =
  val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
  Coll.sLookup(fns, f) match
    case Coll.Some(g) =>
      val El.Fn(_, _, _, _, _, _, body) = g
      body match
        case El.Extern(_, _) => Emit.id(f)
        case _ => Emit.defName(f, ts)
    case Coll.None => Emit.defName(f, ts)

def Emit.defName(f: Sym.Sym, ts: Coll.List[K.Term]): Unit =
  Console.print("f_")
  Emit.id(f)
  Emit.suffix(ts)

def Emit.sep(s: Emit.Sep): Unit = s match
  case Emit.First => ()
  case Emit.Comma => Console.print(", ")

def Emit.capArgs(env: Emit.Env, caps: Coll.List[Sym.Sym], s: Emit.Sep): Unit = caps match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    Emit.sep(s)
    Emit.local(Emit.vs(env), c)
    Emit.capArgs(env, rest, Emit.Comma)

// h_H_init(caps, args): the handler's state
def Emit.initCall(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, h: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr]): Unit =
  Console.print("h_")
  Emit.id(h)
  Console.print("_init(")
  Emit.capArgs(env, caps, Emit.First)
  Emit.args(cx, fi, env, args, if Coll.length(caps) == 0 then Emit.First else Emit.Comma)
  Console.print(")")

// a handler with a row (E1b): its state and the capabilities of the handle site, the self of its ops (srs_env)
def Emit.handleEnv(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, v: Emit.Name, h: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr]): Unit = caps match
  case Coll.Nil => ()
  case Coll.Cons(_, _) =>
    Console.print("struct { void* st; srs_cap* c[")
    Console.printI64(Coll.length(caps))
    Console.print("]; } ")
    Emit.cname(v)
    Console.print("_e = { ")
    Emit.initCall(cx, fi, env, h, caps, args)
    Console.print(", { ")
    Emit.capArgs(env, caps, Emit.First)
    Console.print(" } }; ")

// the self of a handle's capability: the handler's state, or its env when the handler keeps capabilities
def Emit.capSelf(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, v: Emit.Name, h: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr]): Unit = caps match
  case Coll.Nil => Emit.initCall(cx, fi, env, h, caps, args)
  case Coll.Cons(_, _) =>
    Console.print("&")
    Emit.cname(v)
    Console.print("_e")

def Emit.args(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, xs: Coll.List[El.Expr], s: Emit.Sep): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    Emit.sep(s)
    Emit.ex(cx, fi, env, Emit.Inner, x)
    Emit.args(cx, fi, env, rest, Emit.Comma)

// a self tail call (spec sec 4.4): every arg to a temp, then to its param, then back to the top of the body
def Emit.jump(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr]): Unit =
  val Emit.Fi(_, _, _, slots, ret) = fi
  Console.print("({ ")
  Emit.temps(cx, fi, env, slots, caps, args, 0)
  Emit.sets(slots, 0)
  Console.print("goto srs_tail; (")
  Emit.ctype(cx, ret)
  Console.print("){0}; })")

def Emit.temps(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, slots: Coll.List[Emit.Slot], caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr], i: I64): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(_) => caps match
      case Coll.Nil => ()
      case Coll.Cons(c, crest) =>
        Console.print("srs_cap* t")
        Console.printI64(i)
        Console.print(" = ")
        Emit.local(Emit.vs(env), c)
        Console.print("; ")
        Emit.temps(cx, fi, env, rest, crest, args, i + 1)
    case Emit.SVal(_, t) => args match
      case Coll.Nil => ()
      case Coll.Cons(a, arest) =>
        Emit.ctype(cx, t)
        Console.print(" t")
        Console.printI64(i)
        Console.print(" = ")
        Emit.ex(cx, fi, env, Emit.Inner, a)
        Console.print("; ")
        Emit.temps(cx, fi, env, rest, caps, arest, i + 1)

def Emit.sets(slots: Coll.List[Emit.Slot], i: I64): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) =>
    Console.print("p_")
    Emit.id(Emit.slotName(sl))
    Console.print(" = t")
    Console.printI64(i)
    Console.print("; ")
    Emit.sets(rest, i + 1)

def Emit.slotName(sl: Emit.Slot): Sym.Sym = sl match
  case Emit.SCap(x) => x
  case Emit.SVal(x, _) => x

// a constructor (spec sec 4.3): its own case's size in the region reg, then the fields in order
def Emit.ctor(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, en: Sym.Sym, ts: Coll.List[K.Term], c: Sym.Sym, reg: Sym.Sym, args: Coll.List[El.Expr]): Unit = Emit.caseAt(cx, c) match
  case Coll.None => Console.print("0")
  case Coll.Some(ca) =>
    val Emit.CaseAt(tag, _, cs) = ca
    val Ast.Case(_, _, fields) = cs
    val Emit.Cx(_, _, _, _, _, _, al, _, _) = cx
    val n = Emit.envN(env)
    Console.print("({ struct E_")
    Emit.enumName(en, ts)
    Console.print("* o")
    Console.printI64(n)
    Console.print(" = (struct E_")
    Emit.enumName(en, ts)
    Console.print("*)")
    al match
      case Emit.Inline =>
        Console.print("srs_alloc(")
        Emit.local(Emit.vs(env), reg)
        Console.print(", ")
      case Emit.VTable =>
        Console.print("((void*(*)(void*, int64_t))(")
        Emit.local(Emit.vs(env), reg)
        Console.print("->vt[")
        Console.printI64(Emit.opIndex(cx, Sym.of("Region"), Sym.of("alloc")))
        Console.print("]))(")
        Emit.local(Emit.vs(env), reg)
        Console.print("->self, ")
    Console.print("(int64_t)(offsetof(struct E_")
    Emit.enumName(en, ts)
    Console.print(", u) + sizeof(((struct E_")
    Emit.enumName(en, ts)
    Console.print("*)0)->u.C_")
    Emit.id(c)
    Console.print("))); o")
    Console.printI64(n)
    // the tag is written through the case struct (its t_), as every field is: one union member per box
    Console.print("->u.C_")
    Emit.id(c)
    Console.print(".t_ = ")
    Console.printI64(tag)
    Console.print(";")
    Emit.fieldSets(cx, fi, env, n, c, fields, args)
    Console.print(" o")
    Console.printI64(n)
    Console.print("; })")

def Emit.fieldSets(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, n: I64, c: Sym.Sym, fs: Coll.List[Ast.Binder], xs: Coll.List[El.Expr]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, frest) => xs match
    case Coll.Nil => ()
    case Coll.Cons(x, xrest) =>
      val Ast.Binder(_, fx, _) = f
      Console.print(" o")
      Console.printI64(n)
      Console.print("->u.C_")
      Emit.id(c)
      Console.print(".f_")
      Emit.id(fx)
      Console.print(" = ")
      Emit.ex(cx, fi, env, Emit.Inner, x)
      Console.print(";")
      Emit.fieldSets(cx, fi, env, n, c, frest, xrest)

// the index of op in protocol p's op list
def Emit.opIndex(cx: Emit.Cx, p: Sym.Sym, op: Sym.Sym): I64 =
  val Emit.Cx(_, _, _, _, ps, _, _, _, _) = cx
  Coll.sLookup(ps, p) match
    case Coll.None => 0
    case Coll.Some(pr) =>
      val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
      Emit.opIn(ops, op, 0)

def Emit.opIn(os: Coll.List[Ast.Op], op: Sym.Sym, i: I64): I64 = os match
  case Coll.Nil => i
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, n, _, _, _, _) = o
    if Sym.eq(n, op) then i else Emit.opIn(rest, op, i + 1)

// recv.op(args): through the capability's vtable (an op whose every transition ends the protocol clears live), or a
// trait method of {} evidence: the given's static fn (rung T2)
def Emit.op(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, recv: Sym.Sym, ty: K.Term, op: Sym.Sym, args: Coll.List[El.Expr], caps: Coll.List[Sym.Sym]): Unit = ty match
  case K.Con(pn, targs) =>
    val Emit.Cx(_, _, _, _, ps, _, al, _, _) = cx
    // r.alloc(n) bumps through srs_alloc as a constructor does: the capability holds an Arena's bump (Emit.allocFast)
    if Sym.eq(pn, Sym.of("Region")) && Sym.eq(op, Sym.of("alloc")) && Emit.isInline(al) then
      Console.print("srs_alloc(")
      Emit.local(Emit.vs(env), recv)
      Emit.args(cx, fi, env, args, Emit.Comma)
      Console.print(")")
    else Coll.sLookup(ps, pn) match
      case Coll.Some(p) =>
        val Ast.Proto(_, _, _, _, ends, _, ops, _) = p
        Ty.opIn(ops, op) match
          case Coll.Some(o) =>
            val Ast.Op(_, _, _, ops2, oret, trans) = o
            Console.print("({ __auto_type r_ = ((")
            Emit.ctype(cx, Ty.term(oret, Coll.Nil))
            Console.print("(*)(void*")
            Emit.capTys(caps)
            Emit.opTys(cx, ops2)
            Console.print("))(")
            Emit.local(Emit.vs(env), recv)
            Console.print("->vt[")
            Console.printI64(Emit.opIn(ops, op, 0))
            Console.print("]))(")
            Emit.local(Emit.vs(env), recv)
            Console.print("->self")
            Emit.capLocals(env, caps)
            Emit.args(cx, fi, env, args, Emit.Comma)
            Console.print("); ")
            if Emit.kills(trans, ends) then
              Emit.local(Emit.vs(env), recv)
              Console.print("->live = 0; ")
            else ()
            Console.print("r_; })")
          case Coll.None => Console.print("0")
      case Coll.None => Console.print("0")
  case _ => Console.print("0")

// a trait method on {} evidence of a ground goal type: a static call to the given's fn, the caller's capabilities first
def Emit.tcall(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, ty: K.Term, op: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr]): Unit = ty match
  case K.Con(tn, targs) =>
    Console.print("g_")
    Emit.id(tn)
    Emit.suffix(targs)
    Console.print("_")
    Emit.id(op)
    Console.print("(")
    Emit.capArgs(env, caps, Emit.First)
    Emit.args(cx, fi, env, args, if Coll.length(caps) == 0 then Emit.First else Emit.Comma)
    Console.print(")")
  case _ => Console.print("0")

// the capabilities an op's own {} binders take, after self: their C types in the vtable call's cast, and their values
def Emit.capTys(caps: Coll.List[Sym.Sym]): Unit = caps match
  case Coll.Nil => ()
  case Coll.Cons(_, rest) =>
    Console.print(", srs_cap*")
    Emit.capTys(rest)

def Emit.capLocals(env: Emit.Env, caps: Coll.List[Sym.Sym]): Unit = caps match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    Console.print(", ")
    Emit.local(Emit.vs(env), c)
    Emit.capLocals(env, rest)

def Emit.opTys(cx: Emit.Cx, ps: Coll.List[Ast.Binder]): Unit = ps match
  case Coll.Nil => ()
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, _, t) = p
    Console.print(", ")
    Emit.ctype(cx, Ty.term(t, Coll.Nil))
    Emit.opTys(cx, rest)

// every transition of the op ends the protocol (and it has one)
def Emit.kills(ts: Coll.List[Ast.Trans], ends: Coll.List[Sym.Sym]): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(_, _) => Emit.allEnd(ts, ends)

def Emit.allEnd(ts: Coll.List[Ast.Trans], ends: Coll.List[Sym.Sym]): Bool = ts match
  case Coll.Nil => true
  case Coll.Cons(t, rest) =>
    val Ast.Trans(_, to) = t
    if Ty.memberSym(to, ends) then Emit.allEnd(rest, ends) else false

// match (spec sec 4.1): the scrutinee once in s<n>; the last arm has no tag test
def Emit.arms(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, pos: Emit.Pos, as: Coll.List[El.Arm]): Unit = as match
  case Coll.Nil => ()
  case Coll.Cons(a, rest) =>
    val El.Arm(_, p, b) = a
    val n = Emit.envN(env)
    p match
      case Ast.PAny =>
        Emit.test(rest, n, Emit.Always)
        Console.print("({ ")
        Emit.ex(cx, fi, env, pos, b)
        Console.print("; })")
      case Ast.PCase(c, binds) => Emit.caseAt(cx, c) match
        case Coll.None => Console.print("0")
        case Coll.Some(ca) =>
          val Emit.CaseAt(tag, _, cs) = ca
          val Ast.Case(_, _, fields) = cs
          Emit.test(rest, n, Emit.Tag(tag))
          Console.print("({ ")
          Emit.ex(cx, fi, Emit.binds(env, n, c, binds, fields), pos, b)
          Console.print("; })")
    rest match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(" : ")
        Emit.arms(cx, fi, env, pos, rest)

// the test of an arm that is not the last
def Emit.test(rest: Coll.List[El.Arm], n: I64, g: Emit.Guard): Unit = rest match
  case Coll.Nil => ()
  case Coll.Cons(_, _) => g match
    case Emit.Always => Console.print("1 ? ")
    case Emit.Tag(tag) =>
      Console.print("s")
      Console.printI64(n)
      Console.print("->tag == ")
      Console.printI64(tag)
      Console.print(" ? ")

// each binder of an arm (not `_`) to its case field of s<n>
def Emit.binds(env: Emit.Env, n: I64, c: Sym.Sym, xs: Coll.List[Sym.Sym], fs: Coll.List[Ast.Binder]): Emit.Env = xs match
  case Coll.Nil => env
  case Coll.Cons(x, rest) => fs match
    case Coll.Nil => env
    case Coll.Cons(f, frest) =>
      if Str.eq(Sym.str(x), "_") then Emit.binds(env, n, c, rest, frest)
      else
        val Ast.Binder(_, fx, _) = f
        val env2 = Emit.bind(env, x)
        Console.print("__auto_type ")
        Emit.cname(Emit.L(x, Emit.envN(env)))
        Console.print(" = s")
        Console.printI64(n)
        Console.print("->u.C_")
        Emit.id(c)
        Console.print(".f_")
        Emit.id(fx)
        Console.print("; ")
        Emit.binds(env2, n, c, rest, frest)

// a block (spec sec 4.2): statements in order, the last expression in res_, then the drops of its handles (latest first)
def Emit.block(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, pos: Emit.Pos, ss: Coll.List[El.Stmt], last: El.Expr, drops: Coll.List[Emit.Drop]): Unit = ss match
  case Coll.Nil =>
    Console.print("__auto_type res_ = ")
    Emit.ex(cx, fi, env, Emit.lastPos(drops, pos), last)
    Console.print("; ")
    Emit.drops(cx, drops)
    Console.print("res_; })")
  case Coll.Cons(s, rest) => s match
    case El.Val(_, x, ty, _, e) =>
      Emit.ctype(cx, Emit.gr(cx, fi, ty))
      Console.print(" ")
      Emit.cname(Emit.L(x, Emit.envN(env)))
      Console.print(" = ")
      Emit.ex(cx, fi, env, Emit.Inner, e)
      Console.print("; ")
      Emit.block(cx, fi, Emit.bind(env, x), pos, rest, last, drops)
    case El.Handle(_, x, h, caps, args) =>
      val v = Emit.L(x, Emit.envN(env))
      val p = Emit.protoOfH(cx, h)
      Emit.handleEnv(cx, fi, env, v, h, caps, args)
      // the one handle of a static capability (Emit.staticsOf) fills the file-static instance every row reads
      if Emit.isStatic(cx, p) then
        Console.print("s_eff__")
        Emit.id(p)
        Console.print(".self = ")
        Emit.capSelf(cx, fi, env, v, h, caps, args)
        Console.print("; srs_cap* ")
        Emit.cname(v)
        Console.print(" = eff__")
        Emit.id(p)
        Console.print("; ")
      else
        Console.print("srs_cap ")
        Emit.cname(v)
        Console.print("_v = { ")
        Emit.capSelf(cx, fi, env, v, h, caps, args)
        Console.print(", vt_")
        Emit.id(h)
        Console.print(", 1 }; srs_cap* ")
        Emit.cname(v)
        Console.print(" = &")
        Emit.cname(v)
        Console.print("_v; ")
      Emit.block(cx, fi, Emit.bind(env, x), pos, rest, last, Coll.Cons(Emit.Drop(v, p), drops))
    case El.Do(e) =>
      Console.print("(void)(")
      Emit.ex(cx, fi, env, Emit.Inner, e)
      Console.print("); ")
      Emit.block(cx, fi, env, pos, rest, last, drops)

// a block with a handle is not a tail position: its drops run after the last expression
def Emit.lastPos(drops: Coll.List[Emit.Drop], pos: Emit.Pos): Emit.Pos = drops match
  case Coll.Nil => pos
  case Coll.Cons(_, _) => Emit.Inner

def Emit.drops(cx: Emit.Cx, ds: Coll.List[Emit.Drop]): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, rest) =>
    val Emit.Drop(v, p) = d
    val Emit.Cx(_, _, _, _, ps, _, _, _, _) = cx
    Coll.sLookup(ps, p) match
      case Coll.None => ()
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, _, _, _, dop, ops, _) = pr
        dop match
          case Coll.None => ()
          case Coll.Some(o) =>
            Console.print("if (")
            Emit.cname(v)
            Console.print("->live) ((int64_t(*)(void*))(")
            Emit.cname(v)
            Console.print("->vt[")
            Console.printI64(Emit.opIn(ops, o, 0))
            Console.print("]))(")
            Emit.cname(v)
            Console.print("->self); ")
    Emit.drops(cx, rest)

// the protocol of handler h
def Emit.protoOfH(cx: Emit.Cx, h: Sym.Sym): Sym.Sym =
  val Emit.Cx(_, _, _, _, _, hp, _, _, _) = cx
  Coll.sLookup(hp, h) match
    case Coll.Some(p) => p
    case Coll.None => h

// ── a self call in tail position (spec sec 4.4): the body then gets the srs_tail label ──
def Emit.hasTail(cx: Emit.Cx, fi: Emit.Fi, e: El.Expr): Bool = e match
  case El.CallFn(_, f, ts, _, _) => Emit.isSelf(fi, f, Emit.grAll(cx, fi, ts))
  case El.If(_, _, t, x) => Emit.hasTail(cx, fi, t) || Emit.hasTail(cx, fi, x)
  case El.Match(_, _, _, arms) => Emit.armsTail(cx, fi, arms)
  case El.Block(_, ss, last) => if Emit.hasHandle(ss) then false else Emit.hasTail(cx, fi, last)
  case _ => false

def Emit.armsTail(cx: Emit.Cx, fi: Emit.Fi, as: Coll.List[El.Arm]): Bool = as match
  case Coll.Nil => false
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    if Emit.hasTail(cx, fi, b) then true else Emit.armsTail(cx, fi, rest)

def Emit.hasHandle(ss: Coll.List[El.Stmt]): Bool = ss match
  case Coll.Nil => false
  case Coll.Cons(s, rest) => s match
    case El.Handle(_, _, _, _, _) => true
    case _ => Emit.hasHandle(rest)

// ── an instance as the fn emit prints ──
def Emit.fiOf(cx: Emit.Cx, i: Mono.Inst): Emit.Fi =
  val Mono.Inst(f, sub, _) = i
  val El.Fn(_, name, tps, caps, ps, ret, _) = f
  Emit.Fi(name, Emit.targsOf(sub, tps, Coll.Nil), sub, Emit.slots(cx, sub, caps, ps), Mono.ground(Emit.subst(cx), sub, ret))

def Emit.targsOf(sub: Coll.List[Ty.Bind], tps: Coll.List[Sym.Sym], acc: Coll.List[K.Term]): Coll.List[K.Term] = tps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(x, rest) => Ty.lookup(sub, x) match
    case Coll.Some(t) => Emit.targsOf(sub, rest, Coll.Cons(t, acc))
    case Coll.None => Emit.targsOf(sub, rest, Coll.Cons(K.Con(x, Coll.Nil), acc))

// the capabilities first, then the params
def Emit.slots(cx: Emit.Cx, sub: Coll.List[Ty.Bind], caps: Coll.List[Sym.Sym], ps: Coll.List[El.Param]): Coll.List[Emit.Slot] = caps match
  case Coll.Cons(c, rest) => Coll.Cons(Emit.SCap(c), Emit.slots(cx, sub, rest, ps))
  case Coll.Nil => Emit.valSlots(cx, sub, ps, Coll.Nil)

def Emit.valSlots(cx: Emit.Cx, sub: Coll.List[Ty.Bind], ps: Coll.List[El.Param], acc: Coll.List[Emit.Slot]): Coll.List[Emit.Slot] = ps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(p, rest) =>
    val El.Param(x, t) = p
    Emit.valSlots(cx, sub, rest, Coll.Cons(Emit.SVal(x, Mono.ground(Emit.subst(cx), sub, t)), acc))

def Emit.isDef(i: Mono.Inst): Bool =
  val Mono.Inst(f, _, _) = i
  val El.Fn(_, _, _, _, _, _, body) = f
  body match
    case El.Def(_) => true
    case _ => false

// ── signatures (spec sec 3) and bodies (sec 4.4) ──
def Emit.sig(cx: Emit.Cx, fi: Emit.Fi, k: Emit.Kind): Unit =
  val Emit.Fi(self, targs, _, slots, ret) = fi
  k match
    case Emit.KExtern => ()
    case _ => Console.print("static ")
  Emit.ctype(cx, ret)
  Console.print(" ")
  k match
    case Emit.KDef => Emit.defName(self, targs)
    case Emit.KExtern => Emit.id(self)
    case Emit.KHandler(h) =>
      Console.print("h_")
      Emit.id(h)
      Console.print("_")
      Emit.id(self)
    case Emit.KGiven(head) =>
      Console.print("g_")
      Emit.termName(head)
      Console.print("_")
      Emit.id(self)
  Console.print("(")
  slots match
    case Coll.Nil => Console.print("void")
    case Coll.Cons(_, _) => Emit.params(cx, slots, Emit.First)
  Console.print(")")

def Emit.params(cx: Emit.Cx, slots: Coll.List[Emit.Slot], s: Emit.Sep): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) =>
    Emit.sep(s)
    sl match
      case Emit.SCap(_) => Console.print("srs_cap*")
      case Emit.SVal(_, t) => Emit.ctype(cx, t)
    Console.print(" p_")
    Emit.id(Emit.slotName(sl))
    Emit.params(cx, rest, Emit.Comma)

def Emit.paramEnv(slots: Coll.List[Emit.Slot], acc: Coll.List[Emit.Name]): Emit.Env = slots match
  case Coll.Nil => Emit.Env(acc, 0)
  case Coll.Cons(sl, rest) => Emit.paramEnv(rest, Coll.Cons(Emit.P(Emit.slotName(sl)), acc))

// a def loops on its self tail calls; a handler fn does not (s1 emit.srs:270-275)
def Emit.body(cx: Emit.Cx, fi: Emit.Fi, k: Emit.Kind, e: El.Expr): Unit =
  val Emit.Fi(_, _, _, slots, _) = fi
  Emit.sig(cx, fi, k)
  val pos = k match
    case Emit.KDef => if Emit.hasTail(cx, fi, e) then Emit.Tail else Emit.Inner
    case _ => Emit.Inner
  pos match
    case Emit.Tail => Console.print(" { srs_tail: return ")
    case Emit.Inner => Console.print(" { return ")
  Emit.ex(cx, fi, Emit.paramEnv(slots, Coll.Nil), pos, e)
  Console.print("; }\n")

// ── the enum instances the C names: of every signature and expression, closed over their fields (spec sec 1 B, C) ──
// the types of the handler fns (a typed handler state: an enum only init and the ops name still needs its C struct)
def Emit.hfnTys(hs: Coll.List[El.Handler], acc: Coll.List[K.Term]): Coll.List[K.Term] = hs match
  case Coll.Nil => acc
  case Coll.Cons(h, rest) =>
    val El.Handler(_, _, fs, shots) = h
    val ts: Coll.List[K.Term] = shots match
      case Ast.OneShot => Emit.fnsTys(fs, acc)
      case Ast.MultiShot(_, _) => acc
    Emit.hfnTys(rest, ts)

def Emit.fnsTys(fs: Coll.List[El.Fn], acc: Coll.List[K.Term]): Coll.List[K.Term] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, _, _, ps, ret, _) = f
    Emit.fnsTys(rest, Emit.paramTys(ps, Coll.Cons(ret, acc)))

def Emit.paramTys(ps: Coll.List[El.Param], acc: Coll.List[K.Term]): Coll.List[K.Term] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) =>
    val El.Param(_, t) = p
    Emit.paramTys(rest, Coll.Cons(t, acc))

def Emit.instTys(cx: Emit.Cx, is: Coll.List[Mono.Inst], acc: Coll.List[K.Term]): Coll.List[K.Term] = is match
  case Coll.Nil => acc
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, _, _) = i
    val El.Fn(_, _, _, _, _, _, body) = f
    body match
      case El.Def(e) =>
        val fi = Emit.fiOf(cx, i)
        val Emit.Fi(_, _, _, slots, ret) = fi
        Emit.instTys(cx, rest, Emit.exTys(cx, fi, e, Emit.slotTys(slots, Coll.Cons(ret, acc))))
      case _ => Emit.instTys(cx, rest, acc)

def Emit.slotTys(slots: Coll.List[Emit.Slot], acc: Coll.List[K.Term]): Coll.List[K.Term] = slots match
  case Coll.Nil => acc
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(_) => Emit.slotTys(rest, acc)
    case Emit.SVal(_, t) => Emit.slotTys(rest, Coll.Cons(t, acc))

def Emit.exTys(cx: Emit.Cx, fi: Emit.Fi, e: El.Expr, acc: Coll.List[K.Term]): Coll.List[K.Term] = e match
  case El.CallFn(_, _, _, _, args) => Emit.exsTys(cx, fi, args, acc)
  case El.New(_, en, ts, _, _, args) => Emit.exsTys(cx, fi, args, Coll.Cons(K.Con(en, Emit.grAll(cx, fi, ts)), acc))
  case El.Nullary(_, en, ts, _) => Coll.Cons(K.Con(en, Emit.grAll(cx, fi, ts)), acc)
  case El.Op(_, _, _, _, args, _) => Emit.exsTys(cx, fi, args, acc)
  case El.MHandled(_, _, _, _, args, rest, _, _) => Emit.exsTys(cx, fi, Coll.Cons(rest, args), acc)
  case El.Resume(_, _, x) => Emit.exsTys(cx, fi, Coll.Cons(x, Coll.Nil), acc)
  case El.TCall(_, _, _, _, args) => Emit.exsTys(cx, fi, args, acc)
  case El.Bin(_, _, l, x) => Emit.exTys(cx, fi, x, Emit.exTys(cx, fi, l, acc))
  case El.Un(_, _, x) => Emit.exTys(cx, fi, x, acc)
  case El.If(_, c, t, x) => Emit.exTys(cx, fi, x, Emit.exTys(cx, fi, t, Emit.exTys(cx, fi, c, acc)))
  case El.Match(_, x, en, arms) => Emit.armsTys(cx, fi, arms, Emit.exTys(cx, fi, x, Coll.Cons(Emit.gr(cx, fi, en), acc)))
  case El.Block(_, ss, last) => Emit.exTys(cx, fi, last, Emit.stmtsTys(cx, fi, ss, acc))
  case El.While(_, c, b) => Emit.exTys(cx, fi, b, Emit.exTys(cx, fi, c, acc))
  case El.Assign(_, _, x) => Emit.exTys(cx, fi, x, acc)
  case El.Index(_, _, i) => Emit.exTys(cx, fi, i, acc)
  case El.Slice(_, x, o) => Emit.exTys(cx, fi, o, Emit.exTys(cx, fi, x, acc))
  case El.Fill(_, _, n, x, a) => Emit.exTys(cx, fi, x, Emit.exTys(cx, fi, n, Coll.Cons(Emit.gr(cx, fi, a), acc)))
  case El.Tab(_, _, n, a, _, g) => Emit.exTys(cx, fi, g, Emit.exTys(cx, fi, n, Coll.Cons(Emit.gr(cx, fi, a), acc)))
  case El.CellNew(_, _, v, a) => Emit.exTys(cx, fi, v, Coll.Cons(Emit.gr(cx, fi, a), acc))
  case El.CellGet(_, c) => Emit.exTys(cx, fi, c, acc)
  case El.CNew(_, _, _) => acc
  case El.CField(_, c, _, _, _) => Emit.exTys(cx, fi, c, acc)
  case El.CellPut(_, c, v) => Emit.exTys(cx, fi, v, Emit.exTys(cx, fi, c, acc))
  case El.ArrPut(_, _, i, v) => Emit.exTys(cx, fi, v, Emit.exTys(cx, fi, i, acc))
  case El.Blit(_, _, a, b, m) => Emit.exTys(cx, fi, m, Emit.exTys(cx, fi, b, Emit.exTys(cx, fi, a, acc)))
  case _ => acc

def Emit.exsTys(cx: Emit.Cx, fi: Emit.Fi, xs: Coll.List[El.Expr], acc: Coll.List[K.Term]): Coll.List[K.Term] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Emit.exsTys(cx, fi, rest, Emit.exTys(cx, fi, x, acc))

def Emit.armsTys(cx: Emit.Cx, fi: Emit.Fi, as: Coll.List[El.Arm], acc: Coll.List[K.Term]): Coll.List[K.Term] = as match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    Emit.armsTys(cx, fi, rest, Emit.exTys(cx, fi, b, acc))

def Emit.stmtsTys(cx: Emit.Cx, fi: Emit.Fi, ss: Coll.List[El.Stmt], acc: Coll.List[K.Term]): Coll.List[K.Term] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => s match
    case El.Val(_, _, ty, _, e) => Emit.stmtsTys(cx, fi, rest, Emit.exTys(cx, fi, e, Coll.Cons(Emit.gr(cx, fi, ty), acc)))
    case El.Handle(_, _, _, _, args) => Emit.stmtsTys(cx, fi, rest, Emit.exsTys(cx, fi, args, acc))
    case El.Do(e) => Emit.stmtsTys(cx, fi, rest, Emit.exTys(cx, fi, e, acc))

// the distinct enum terms of todo and of their fields, in the order found (seen: by hash bucket)
def Emit.closeEnums(cx: Emit.Cx, todo: Coll.List[K.Term], seen: Coll.BTree[Coll.List[K.Term]], out: Coll.List[K.Term]): Coll.List[K.Term] = todo match
  case Coll.Nil => Coll.rev(out)
  case Coll.Cons(t, rest) => t match
    case K.Con(n, args) =>
      val Emit.Cx(_, _, _, es, _, _, _, _, _) = cx
      val h = Mono.thash(t, 0)
      Coll.sLookup(es, n) match
        case Coll.None => Emit.closeEnums(cx, rest, seen, out)
        case Coll.Some(e) =>
          if Emit.inTerms(Coll.bTGetOr(seen, h, Coll.Nil), t) then Emit.closeEnums(cx, rest, seen, out)
          else Emit.closeEnums(cx, Emit.fieldTys(e, args, rest), Coll.bPushT(seen, h, t), Coll.Cons(t, out))
    case _ => Emit.closeEnums(cx, rest, seen, out)

def Emit.inTerms(ts: Coll.List[K.Term], t: K.Term): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(x, rest) => if Mono.termEq(x, t) then true else Emit.inTerms(rest, t)

// the field types of enum e at args
def Emit.fieldTys(e: Ast.Enum, args: Coll.List[K.Term], acc: Coll.List[K.Term]): Coll.List[K.Term] =
  val Ast.Enum(_, _, gs, cases) = e
  Emit.casesTys(cases, Ty.zipBind(Ty.tparams(gs, Coll.Nil), args, Coll.Nil), acc)

def Emit.casesTys(cs: Coll.List[Ast.Case], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = cs match
  case Coll.Nil => acc
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, fs) = c
    Emit.casesTys(rest, tv, Emit.bindersTys(fs, tv, acc))

def Emit.bindersTys(fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Ast.Binder(_, _, t) = f
    Emit.bindersTys(rest, tv, Coll.Cons(Ty.term(t, tv), acc))

// ── enum structs and nullary statics (spec sec 1.1) ──
def Emit.fwds(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Console.print("struct E_")
    Emit.termName(t)
    Console.print(";\n")
    Emit.fwds(rest)

def Emit.termName(t: K.Term): Unit = t match
  case K.Con(n, args) => Emit.enumName(n, args)
  case _ => Emit.mangle(t)

def Emit.structs(cx: Emit.Cx, ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Emit.withEnum(cx, t, Emit.Layout)
    Emit.structs(cx, rest)

def Emit.statics(cx: Emit.Cx, ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    Emit.withEnum(cx, t, Emit.Code)
    Emit.statics(cx, rest)

// the struct (Layout) or the nullary statics (Code) of enum term t
def Emit.withEnum(cx: Emit.Cx, t: K.Term, what: Emit.Part): Unit = t match
  case K.Con(n, args) =>
    val Emit.Cx(_, _, _, es, _, _, _, _, _) = cx
    Coll.sLookup(es, n) match
      case Coll.None => ()
      case Coll.Some(e) =>
        val Ast.Enum(_, _, gs, cases) = e
        val tv = Ty.zipBind(Ty.tparams(gs, Coll.Nil), args, Coll.Nil)
        what match
          // the tag and every case struct start at offset 0: a case struct begins with its own copy of the tag (t_),
          // so its one-byte fields share the tag's word and a box is just its case struct
          case Emit.Layout =>
            val w = Emit.tagWidth(Coll.length(cases))
            Console.print("struct E_")
            Emit.enumName(n, args)
            Console.print(" { union { ")
            Emit.tagType(w)
            Console.print(" tag; union {")
            Emit.caseStructs(cx, cases, tv, w)
            Console.print(" ")
            Emit.tagType(w)
            Console.print(" none_; } u; }; };\n")
          case Emit.Code => Emit.nullaries(n, args, cases, 0)
  case _ => ()

def Emit.caseStructs(cx: Emit.Cx, cs: Coll.List[Ast.Case], tv: Coll.List[Ty.Bind], w: Emit.TagW): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, cn, fs) = c
    fs match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(" struct { ")
        Emit.tagType(w)
        Console.print(" t_;")
        Emit.fieldDecls(cx, fs, tv, Emit.AByte)
        Emit.fieldDecls(cx, fs, tv, Emit.AWord)
        Console.print(" } C_")
        Emit.id(cn)
        Console.print(";")
    Emit.caseStructs(cx, rest, tv, w)

// the fields of alignment a, in declaration order (fields are read and written by name, so their order is free)
def Emit.fieldDecls(cx: Emit.Cx, fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], a: Emit.Align): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val Ast.Binder(_, x, t) = f
    val ft = Ty.term(t, tv)
    if Emit.sameAlign(Emit.alignOf(cx, ft), a) then
      Console.print(" ")
      Emit.ctype(cx, ft)
      Console.print(" f_")
      Emit.id(x)
      Console.print(";")
    else ()
    Emit.fieldDecls(cx, rest, tv, a)

// a tag is the smallest unsigned C int that holds the case count
enum Emit.TagW:
  case Emit.T8
  case Emit.T16
  case Emit.T32

def Emit.tagWidth(cases: I64): Emit.TagW = if cases <= 256 then Emit.T8 else if cases <= 65536 then Emit.T16 else Emit.T32

def Emit.tagType(w: Emit.TagW): Unit = w match
  case Emit.T8 => Console.print("uint8_t")
  case Emit.T16 => Console.print("uint16_t")
  case Emit.T32 => Console.print("uint32_t")

// a field's C alignment (Emit.ctype): bool is one byte; every other field type is an 8-byte word
enum Emit.Align:
  case Emit.AByte
  case Emit.AWord

def Emit.alignOf(cx: Emit.Cx, t: K.Term): Emit.Align = t match
  case K.Con(n, _) =>
    if Str.eq(Sym.str(n), "Bool") then Emit.AByte
    else Emit.nominalOf(cx, n) match
      case Coll.Some(b) => Emit.alignOf(cx, b)
      case Coll.None => Emit.AWord
  case _ => Emit.AWord

def Emit.sameAlign(a: Emit.Align, b: Emit.Align): Bool = a match
  case Emit.AByte => Emit.isByte(b)
  case Emit.AWord => if Emit.isByte(b) then false else true

def Emit.isByte(a: Emit.Align): Bool = a match
  case Emit.AByte => true
  case Emit.AWord => false

def Emit.nullaries(n: Sym.Sym, args: Coll.List[K.Term], cs: Coll.List[Ast.Case], i: I64): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, cn, fs) = c
    fs match
      case Coll.Nil =>
        Console.print("static const struct E_")
        Emit.enumName(n, args)
        Console.print(" N_")
        Emit.id(cn)
        Emit.suffix(args)
        Console.print(" = { .tag = ")
        Console.printI64(i)
        Console.print(" };\n")
        // no box is written after its constructor, so the static is const data; P_ is its address as the value's
        // type (a const pointer: the C compiler folds a match on it)
        Console.print("static struct E_")
        Emit.enumName(n, args)
        Console.print("* const P_")
        Emit.id(cn)
        Emit.suffix(args)
        Console.print(" = (struct E_")
        Emit.enumName(n, args)
        Console.print("*)&N_")
        Emit.id(cn)
        Emit.suffix(args)
        Console.print(";\n")
      case Coll.Cons(_, _) => ()
    Emit.nullaries(n, args, rest, i + 1)

// ── prototypes (spec sec 1 D), vtables (E), bodies (G) ──
def Emit.externs(cx: Emit.Cx, fs: Coll.List[El.Fn], cs: Coll.ISet): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, tps, _, _, _, body) = f
    body match
      case El.Extern(abi, ghost) => abi match
        case Ast.AbiSrs =>
          if Emit.strInline(n) || !Emit.keepExtern(abi, cs, n) then ()
          else
            // one C symbol for every instance: a [] binder slot is void* (spec sec 3 slotType)
            Emit.sig(cx, Emit.fiOf(cx, Mono.Inst(f, Emit.ptrs(tps, Coll.Nil), Mono.Top)), Emit.KExtern)
            Console.print(";\n")
        case _ =>
          if !Emit.keepExtern(abi, cs, n) then ()
          else
            Emit.libcSig(cx, Emit.fiOf(cx, Mono.Inst(f, Emit.ptrs(tps, Coll.Nil), Mono.Top)), ghost, Emit.isVarAbi(abi))
            Console.print(";\n")
      case _ => ()
    Emit.externs(cx, rest, cs)

// an extern keeps its prototype when its program calls it; a libc extern declared in a user file always does: the
// declaration alone is what the C compiler checks against the libc headers (cneg/libc_wrong_ret). A libc extern of the
// prelude (S2c.read marks it AbiLibcPre) is kept only when called, as a libc val is never printed
def Emit.keepExtern(abi: Ast.Abi, cs: Coll.ISet, n: Sym.Sym): Bool = abi match
  case Ast.AbiLibc => true
  case Ast.AbiLibcVar => true
  case Ast.AbiLibcVal => false
  case Ast.AbiLibcPre => Coll.setHas(cs, Sym.hash(n))
  case Ast.AbiSrs => Coll.setHas(cs, Sym.hash(n))

// the prototype of a libc extern: the C compiler checks it against the real declaration (C11 6.7p4). A ghost param (an
// Array length) is no C param, an Array param is void* (the call converts uint8_t* to it), `...` ends a variadic one
def Emit.libcSig(cx: Emit.Cx, fi: Emit.Fi, ghost: Coll.List[Bool], va: Bool): Unit =
  val Emit.Fi(self, _, _, slots, ret) = fi
  Emit.ctype(cx, ret)
  Console.print(" ")
  Emit.id(self)
  Console.print("(")
  val kept = Emit.keptVals(slots, ghost, 0)
  Emit.libcParams(cx, slots, ghost, Emit.First)
  if va then Console.print(if kept == 0 then "..." else ", ...") else if kept == 0 then Console.print("void") else ()
  Console.print(")")

def Emit.keptVals(slots: Coll.List[Emit.Slot], ghost: Coll.List[Bool], n: I64): I64 = slots match
  case Coll.Nil => n
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(_) => Emit.keptVals(rest, ghost, n)
    case Emit.SVal(_, _) => ghost match
      case Coll.Nil => Emit.keptVals(rest, Coll.Nil, n + 1)
      case Coll.Cons(g, grest) => Emit.keptVals(rest, grest, if g then n else n + 1)

def Emit.libcParams(cx: Emit.Cx, slots: Coll.List[Emit.Slot], ghost: Coll.List[Bool], s: Emit.Sep): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(_) => Emit.libcParams(cx, rest, ghost, s)
    case Emit.SVal(x, t) =>
      val g: Bool = ghost match
        case Coll.Nil => false
        case Coll.Cons(b, _) => b
      val grest: Coll.List[Bool] = ghost match
        case Coll.Nil => Coll.Nil
        case Coll.Cons(_, r) => r
      if g then Emit.libcParams(cx, rest, grest, s)
      else
        Emit.sep(s)
        Emit.libcCType(cx, t)
        Console.print(" p_")
        Emit.id(x)
        Emit.libcParams(cx, rest, grest, Emit.Comma)

def Emit.libcCType(cx: Emit.Cx, t: K.Term): Unit = t match
  case K.Con(n, _) => if Str.eq(Sym.str(n), "Array") then Console.print("void*") else Emit.ctype(cx, t)
  case _ => Emit.ctype(cx, t)

def Emit.isVarAbi(abi: Ast.Abi): Bool = abi match
  case Ast.AbiLibcVar => true
  case _ => false

def Emit.cid(n: Sym.Sym): Unit = Console.print(Sym.str(n))

def Emit.cstructPtr(s: Str): Unit =
  Console.print("struct ")
  Console.print(s)
  Console.print("*")



// the allocation of an extern "libc" struct, as a function so no statement expression is emitted at the use: only for the structs
// a program creates (Seen.cs holds their names)
def Emit.cnewFns(cx: Emit.Cx, ds: Coll.List[Ast.Decl], cs: Coll.ISet): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, rest) =>
    d match
      case Ast.DType(td) =>
        val Ast.TypeDecl(_, name, _, _, body) = td
        body match
          case Ast.CStruct(_) => if Coll.setHas(cs, Sym.hash(name)) then Emit.cnewFn(cx, name) else ()
          case _ => ()
      case _ => ()
    Emit.cnewFns(cx, rest, cs)

def Emit.cnewFn(cx: Emit.Cx, name: Sym.Sym): Unit =
  Console.print("static inline struct ")
  Emit.cid(name)
  Console.print("* srs_cnew_")
  Emit.cid(name)
  Console.print("(srs_cap* c) { struct ")
  Emit.cid(name)
  Console.print("* p = (struct ")
  Emit.cid(name)
  Console.print("*)")
  Emit.allocOpenC(cx)
  Console.print("(int64_t)sizeof(struct ")
  Emit.cid(name)
  Console.print(")); memset(p, 0, sizeof(struct ")
  Emit.cid(name)
  Console.print(")); return p; }\n")

// the allocator call open for the capability param c (as Emit.allocOpen for a local)
def Emit.allocOpenC(cx: Emit.Cx): Unit =
  val Emit.Cx(_, _, _, _, _, _, al, _, _) = cx
  al match
    case Emit.Inline => Console.print("srs_alloc(c, ")
    case Emit.VTable =>
      Console.print("((void*(*)(void*, int64_t))(c->vt[")
      Console.printI64(Emit.opIndex(cx, Sym.of("Region"), Sym.of("alloc")))
      Console.print("]))(c->self, ")

// each declared libc struct field is checked against the real header: its C type must be the srs type's C type (C11 _Generic in a
// static assert), and a field the struct does not have is the C compiler's "no member named"
def Emit.cstructChecks(cx: Emit.Cx, ds: Coll.List[Ast.Decl]): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, rest) =>
    d match
      case Ast.DType(td) =>
        val Ast.TypeDecl(_, name, _, _, body) = td
        body match
          case Ast.CStruct(fs) => Emit.cfieldChecks(cx, name, fs)
          case _ => ()
      case _ => ()
    Emit.cstructChecks(cx, rest)

def Emit.cfieldChecks(cx: Emit.Cx, name: Sym.Sym, fs: Coll.List[Ast.CField]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val Ast.CField(_, fname, fty) = f
    val Ast.Ty(_, tn, _, _, _) = fty
    Console.print("_Static_assert(_Generic(((struct ")
    Emit.cid(name)
    Console.print("*)0)->")
    Console.print(Sym.str(fname))
    Console.print(", ")
    Emit.ctype(cx, K.Con(tn, Coll.Nil))
    Console.print(": 1, default: 0), \"libc struct ")
    Emit.cid(name)
    Console.print(".")
    Console.print(Sym.str(fname))
    Console.print(" is not ")
    Console.print(Sym.str(tn))
    Console.print("\");\n")
    Emit.cfieldChecks(cx, name, rest)
// a libc val has no prototype: it is read as ((T)(NAME)) at each use (Emit.ex, El.CallFn)
def Emit.isLibcVal(abi: Ast.Abi): Bool = abi match
  case Ast.AbiLibcVal => true
  case _ => false

// the type of a libc val named f
def Emit.libcValTy(cx: Emit.Cx, f: Sym.Sym): Coll.Option[K.Term] =
  val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
  Coll.sLookup(fns, f) match
    case Coll.Some(g) =>
      val El.Fn(_, _, _, _, _, ret, body) = g
      body match
        case El.Extern(abi, _) => if Emit.isLibcVal(abi) then Coll.Some(ret) else Coll.None
        case _ => Coll.None
    case Coll.None => Coll.None

def Emit.isLibcValCall(cx: Emit.Cx, f: Sym.Sym): Bool = Emit.libcValTy(cx, f) match
  case Coll.Some(_) => true
  case Coll.None => false

// ((T)(NAME)): the cast gives the srs type whatever the C type of the macro
def Emit.libcValRead(cx: Emit.Cx, f: Sym.Sym): Unit = Emit.libcValTy(cx, f) match
  case Coll.Some(t) =>
    Console.print("((")
    Emit.ctype(cx, t)
    Console.print(")(")
    Emit.id(f)
    Console.print("))")
  case Coll.None => ()

// a program with a libc extern includes the libc headers, so the C compiler checks our prototype of each libc extern
// against the real declaration (C11 6.7p4: two declarations of one function must agree, else "conflicting types")
def Emit.libcHeaders(fs: Coll.List[El.Fn], ds: Coll.List[Ast.Decl], cs: Coll.ISet): Unit =
  if Emit.anyLibc(fs, cs) || Emit.anyCStruct(ds) then Console.print("#include <errno.h>\n#include <fcntl.h>\n#include <unistd.h>\n#include <sys/stat.h>\n#include <sys/mman.h>\nstatic inline int32_t rt_os_errno(void) { return errno; }\n") else ()

// a program that declares an extern "libc" struct includes the libc headers: the C compiler checks every field against them
def Emit.anyCStruct(ds: Coll.List[Ast.Decl]): Bool = ds match
  case Coll.Nil => false
  case Coll.Cons(d, rest) => d match
    case Ast.DType(td) =>
      val Ast.TypeDecl(_, _, _, _, body) = td
      body match
        case Ast.CStruct(_) => true
        case _ => Emit.anyCStruct(rest)
    case _ => Emit.anyCStruct(rest)

// a libc extern of a user file, or a libc function or val of the prelude that the program calls
def Emit.anyLibc(fs: Coll.List[El.Fn], cs: Coll.ISet): Bool = fs match
  case Coll.Nil => false
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, body) = f
    body match
      case El.Def(_) => Emit.anyLibc(rest, cs)
      case El.Extern(abi, _) => abi match
        case Ast.AbiLibc => true
        case Ast.AbiLibcVar => true
        case Ast.AbiLibcVal => if Coll.setHas(cs, Sym.hash(n)) then true else Emit.anyLibc(rest, cs)
        case Ast.AbiLibcPre => if Coll.setHas(cs, Sym.hash(n)) then true else Emit.anyLibc(rest, cs)
        case Ast.AbiSrs => Emit.anyLibc(rest, cs)

// the pure string primitives of lib/prelude.srs are static inline in every program (Emit.strPrims): no call per byte
def Emit.strInline(n: Sym.Sym): Bool =
  Sym.eq(n, Sym.of("Str.ofBytes")) || Sym.eq(n, Sym.of("rt_os_errno")) || Sym.eq(n, Sym.of("Str.len")) || Sym.eq(n, Sym.of("Str.at")) || Sym.eq(n, Sym.of("Str.slice")) || Sym.eq(n, Sym.of("Str.eq")) || Emit.wordInline(Sym.str(n))

// the word conversions of lib/prelude.srs, static inline too (Emit.wordPrims)
def Emit.wordInline(s: Str): Bool =
  Str.eq(s, "U32.of") || Str.eq(s, "U32.ofU64") || Str.eq(s, "U64.of") || Str.eq(s, "U64.ofI64") || Str.eq(s, "I64.of") || Str.eq(s, "I64.ofU64") || Str.eq(s, "Str.u32le") || Str.eq(s, "Str.u64le") || Str.eq(s, "U8.of") || Str.eq(s, "I64.ofU8") || Str.eq(s, "I32.of") || Str.eq(s, "I64.ofI32") || Emit.ptrPrim(s)

// C conversion to an unsigned type is mod 2^width (C11 6.3.1.3p2); uint64_t to int64_t above INT64_MAX and int64_t to int32_t out of range are
// implementation-defined (6.3.1.3p3), two's complement on every target compiler (gcc, clang)
// the raw-memory prims of the srs Arena (lib/prelude.srs, rt_ptr_*): callable only in the fns of a Srs.* handler
// (Ty.rtCall). A block is read and written by int64_t word index; rt_globals is the process-lifetime state block of the
// allocator (one file-static, zeroed; one thread, as the C arena it replaces)
def Emit.ptrPrim(s: Str): Bool =
  Str.eq(s, "rt_ptr_get") || Str.eq(s, "rt_ptr_set") || Str.eq(s, "rt_ptr_add") || Str.eq(s, "rt_ptr_addr") || Str.eq(s, "rt_ptr_of") || Str.eq(s, "rt_globals")

def Emit.ptrPrims(cs: Coll.ISet): Unit =
  Emit.primIf(cs, "rt_ptr_get", "static inline int64_t rt_ptr_get(void* p, int64_t i) { return ((int64_t*)p)[i]; }\n")
  Emit.primIf(cs, "rt_ptr_set", "static inline int64_t rt_ptr_set(void* p, int64_t i, int64_t v) { ((int64_t*)p)[i] = v; return 0; }\n")
  Emit.primIf(cs, "rt_ptr_add", "static inline void* rt_ptr_add(void* p, int64_t n) { return (char*)p + n; }\n")
  Emit.primIf(cs, "rt_ptr_addr", "static inline uint64_t rt_ptr_addr(void* p) { return (uint64_t)(uintptr_t)p; }\n")
  Emit.primIf(cs, "rt_ptr_of", "static inline void* rt_ptr_of(uint64_t a) { return (void*)(uintptr_t)a; }\n")
  Emit.primIf(cs, "rt_globals", "static int64_t srs_globals[16];\nstatic inline void* rt_globals(void) { return srs_globals; }\n")

// a prim line only in a program that calls the prim (pay per use)
def Emit.primIf(cs: Coll.ISet, name: Str, text: Str): Unit =
  if Coll.setHas(cs, Sym.hash(Sym.of(name))) then Console.print(text) else ()
def Emit.wordPrims(): Unit =
  Console.print("static inline uint32_t U32__of(int64_t x) { return (uint32_t)x; }\n")
  Console.print("static inline uint32_t U32__ofU64(uint64_t x) { return (uint32_t)x; }\n")
  Console.print("static inline uint64_t U64__of(uint32_t x) { return x; }\n")
  Console.print("static inline uint64_t U64__ofI64(int64_t x) { return (uint64_t)x; }\n")
  Console.print("static inline int64_t I64__of(uint32_t x) { return x; }\n")
  Console.print("static inline int64_t I64__ofU64(uint64_t x) { return (int64_t)x; }\n")
  Console.print("static inline uint8_t U8__of(int64_t x) { return (uint8_t)x; }\n")
  Console.print("static inline int64_t I64__ofU8(uint8_t x) { return x; }\n")
  Console.print("static inline int32_t I32__of(int64_t x) { return (int32_t)x; }\n")
  Console.print("static inline int64_t I64__ofI32(int32_t x) { return x; }\n")
  Emit.wordLoad("32", "uint32_t", "4", "__builtin_bswap32")
  Emit.wordLoad("64", "uint64_t", "8", "__builtin_bswap64")

// Str.u32le / Str.u64le: one load when the whole word is in [0, n) (memcpy, byte swapped on a big endian target), else
// the bytes in range and 0 for the rest. i >= n returns first, so i + k cannot overflow
def Emit.wordLoad(bits: Str, ty: Str, bytes: Str, swap: Str): Unit =
  Console.print("static inline ")
  Console.print(ty)
  Console.print(" Str__u")
  Console.print(bits)
  Console.print("le(srs_str s, int64_t i) {\n  ")
  Console.print(ty)
  Console.print(" v = 0;\n  if (i >= 0 && i <= s.n - ")
  Console.print(bytes)
  Console.print(") {\n    memcpy(&v, s.p + i, ")
  Console.print(bytes)
  Console.print(");\n#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n    v = ")
  Console.print(swap)
  Console.print("(v);\n#endif\n    return v;\n  }\n  if (i >= s.n) return 0;\n  for (int64_t k = 0; k < ")
  Console.print(bytes)
  Console.print("; k++) if (i + k >= 0 && i + k < s.n) v |= (")
  Console.print(ty)
  Console.print(")s.p[i + k] << (8 * k);\n  return v;\n}\n")
// the semantics of rt_str_* in rt/srs_rt.c: at is -1 out of range; slice clamps b to [0, n] and e to [b, n]
// Str__at tests 0 <= i < n as one unsigned compare: a negative i becomes at least 2^63 as a uint64_t and n <= INT64_MAX, so the one test is equal to the two signed ones (one cmp and one branch, not setcc pairs)
// the semantics of rt_str_* in rt/srs_rt.c: at is -1 out of range; slice clamps b to [0, n] and e to [b, n]
def Emit.strPrims(): Unit =
  Console.print("static inline int64_t Str__len(srs_str s) { return s.n; }\n")
  Console.print("static inline int64_t Str__at(srs_str s, int64_t i) { return (uint64_t)i < (uint64_t)s.n ? s.p[i] : -1; }\n")
  Console.print("static inline srs_str Str__slice(srs_str s, int64_t b, int64_t e) {\n")
  Console.print("  if (b < 0) b = 0;\n  if (e > s.n) e = s.n;\n  if (e < b) e = b;\n")
  Console.print("  return (srs_str){s.p + b, e - b};\n}\n")
  Console.print("static inline bool Str__eq(srs_str a, srs_str b) { return a.n == b.n && memcmp(a.p, b.p, (size_t)a.n) == 0; }\n")
  Console.print("static inline srs_str Str__ofBytes(void* r, int64_t n, uint8_t* xs) { return (srs_str){xs, n}; }\n")
  Console.print("static inline void Array__blit(uint8_t* d, srs_str s, int64_t m) { int64_t k = m < s.n ? m : s.n; if (k > 0) memcpy(d, s.p, (size_t)k); }\n")

def Emit.ptrs(tps: Coll.List[Sym.Sym], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = tps match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Emit.ptrs(rest, Coll.Cons(Ty.Bind(x, Ty.con("Ptr")), acc))

// a generic extern whose result is a [] binder returns void*: the call casts it to the instance's type (spec sec 4 XInst)
def Emit.externCast(cx: Emit.Cx, f: Sym.Sym, gts: Coll.List[K.Term]): Coll.Option[K.Term] =
  val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
  Coll.sLookup(fns, f) match
    case Coll.Some(g) =>
      val El.Fn(_, _, tps, _, _, ret, body) = g
      body match
        case El.Extern(_, _) => ret match
          case K.Con(n, xs) => if Coll.length(xs) == 0 then Ty.lookup(Ty.zipBind(tps, gts, Coll.Nil), n) else Coll.None
          case _ => Coll.None
        case _ => Coll.None
    case Coll.None => Coll.None

def Emit.protos(cx: Emit.Cx, is: Coll.List[Mono.Inst]): Unit = is match
  case Coll.Nil => ()
  case Coll.Cons(i, rest) =>
    if Emit.isDef(i) then
      Emit.sig(cx, Emit.fiOf(cx, i), Emit.kindOf(i))
      Console.print(";\n")
    else ()
    Emit.protos(cx, rest)

def Emit.bodies(cx: Emit.Cx, hs: Coll.List[El.Handler], is: Coll.List[Mono.Inst]): Unit = is match
  case Coll.Nil => ()
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, _, _) = i
    val El.Fn(_, _, _, _, _, _, body) = f
    val fi = Emit.fiOf(cx, i)
    body match
      case El.Def(e) =>
        Emit.mSite(cx, hs, fi, e, Emit.Layout)
        Emit.body(cx, fi, Emit.kindOf(i), e)
        Emit.mSite(cx, hs, fi, e, Emit.Code)
      case _ => ()
    Emit.bodies(cx, hs, rest)

// ── a multi-shot handle (vic-hm63 C3.3; k = a top-level C fn + a context, the Zig shape): the rest of its block is cut at
// each top-level op of its capability into segment fns ms_<F>_<i>(void** e_, V v_). A segment reads the live locals
// from e_ under their own C names (their frames are alive: k is never stored, ruling A), runs its statements, then
// calls the site's op fn mh_<F>_<op>(next segment, its locals, caps, self, args), whose resume k(v) is k_(ke_, v), or
// at the end returns done(last) or last. Ty.mhPlace keeps a site the last of F's body block (one per fn).
enum Emit.MS:
  case Emit.MS(outer: Coll.List[El.Stmt], caps: Coll.List[Sym.Sym], x: Sym.Sym, h: Sym.Sym, rest: El.Expr, a: K.Term, ans: K.Term)

def Emit.msOf(e: El.Expr): Coll.Option[Emit.MS] = e match
  case El.MHandled(_, x, h, caps, _, rest, a, ans) => Coll.Some(Emit.MS(Coll.Nil, caps, x, h, rest, a, ans))
  case El.Block(_, ss, last) => last match
    case El.MHandled(_, x, h, caps, _, rest, a, ans) => Coll.Some(Emit.MS(ss, caps, x, h, rest, a, ans))
    case _ => Coll.None
  case _ => Coll.None

// a live local and its C type
enum Emit.TN:
  case Emit.TN(v: Emit.Name, t: Emit.CT)

enum Emit.CT:
  case Emit.CVal(t: K.Term)
  case Emit.CCap
  // a CPS fn's k_ (ANS (*)(void**, V)) and ke_ (void**)
  case Emit.CK(ans: K.Term, v: K.Term)
  case Emit.CKe

// the typed locals of F's params and of the statements before the site, as Emit.block binds them
def Emit.paramTN(slots: Coll.List[Emit.Slot], acc: Coll.List[Emit.TN]): Coll.List[Emit.TN] = slots match
  case Coll.Nil => acc
  case Coll.Cons(sl, rest) => sl match
    case Emit.SCap(x) => Emit.paramTN(rest, Coll.Cons(Emit.TN(Emit.P(x), Emit.CCap), acc))
    case Emit.SVal(x, t) => Emit.paramTN(rest, Coll.Cons(Emit.TN(Emit.P(x), Emit.CVal(t)), acc))

enum Emit.Scope:
  case Emit.Scope(env: Emit.Env, tns: Coll.List[Emit.TN])

def Emit.scopeOf(cx: Emit.Cx, fi: Emit.Fi, sc: Emit.Scope, ss: Coll.List[El.Stmt]): Emit.Scope = ss match
  case Coll.Nil => sc
  case Coll.Cons(s, rest) =>
    val Emit.Scope(env, tns) = sc
    val sc2: Emit.Scope = s match
      case El.Val(_, y, ty, _, _) => Emit.Scope(Emit.bind(env, y), Coll.Cons(Emit.TN(Emit.L(y, Emit.envN(env)), Emit.CVal(Emit.gr(cx, fi, ty))), tns))
      case El.Handle(_, y, _, _, _) => Emit.Scope(Emit.bind(env, y), Coll.Cons(Emit.TN(Emit.L(y, Emit.envN(env)), Emit.CCap), tns))
      case El.Do(_) => sc
    Emit.scopeOf(cx, fi, sc2, rest)

def Emit.startScope(cx: Emit.Cx, fi: Emit.Fi, ms: Emit.MS): Emit.Scope =
  val Emit.Fi(_, _, _, slots, _) = fi
  val Emit.MS(outer, _, _, _, _, _, _) = ms
  Emit.scopeOf(cx, fi, Emit.Scope(Emit.paramEnv(slots, Coll.Nil), Emit.paramTN(slots, Coll.Nil)), outer)

// the rest's statements and its last expression
def Emit.restParts(rest: El.Expr): El.Expr = rest match
  case El.Block(_, _, last) => last
  case _ => rest

def Emit.restStmts(rest: El.Expr): Coll.List[El.Stmt] = rest match
  case El.Block(_, ss, _) => ss
  case _ => Coll.Nil

def Emit.msName(fi: Emit.Fi, i: I64): Unit =
  val Emit.Fi(self, targs, _, _, _) = fi
  Console.print("ms_")
  Emit.id(self)
  Emit.suffix(targs)
  Console.print("_")
  Console.printI64(i)

def Emit.mhName(fi: Emit.Fi, op: Sym.Sym): Unit =
  val Emit.Fi(self, targs, _, _, _) = fi
  Console.print("mh_")
  Emit.id(self)
  Emit.suffix(targs)
  Console.print("_")
  Emit.id(op)

// the handler of a site and its proto
def Emit.mHandler(hs: Coll.List[El.Handler], h: Sym.Sym): Coll.Option[El.Handler] = hs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val El.Handler(n, _, _, _) = x
    if Sym.eq(n, h) then Coll.Some(x) else Emit.mHandler(rest, h)

// the declared result of op of the site's capability (what its segment takes)
def Emit.opV(cx: Emit.Cx, p: Sym.Sym, op: Sym.Sym): K.Term =
  val Emit.Cx(_, _, _, _, ps, _, _, _, _) = cx
  Coll.sLookup(ps, p) match
    case Coll.Some(pr) =>
      val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
      Ty.opIn(ops, op) match
        case Coll.Some(o) =>
          val Ast.Op(_, _, _, _, oret, _) = o
          Ty.term(oret, Coll.Nil)
        case Coll.None => Ty.con("Unit")
    case Coll.None => Ty.con("Unit")

def Emit.mSite(cx: Emit.Cx, hs: Coll.List[El.Handler], fi: Emit.Fi, e: El.Expr, what: Emit.Part): Unit = Emit.msOf(e) match
  case Coll.None => ()
  case Coll.Some(ms) =>
    val Emit.MS(_, _, x, h, rest, a, ans) = ms
    Emit.mHandler(hs, h) match
      case Coll.None => ()
      case Coll.Some(hd) =>
        val El.Handler(_, p, hfs, _) = hd
        val ga = Emit.gr(cx, fi, a)
        val gans = Emit.gr(cx, fi, ans)
        val Emit.MS(_, caps, _, _, _, _, _) = ms
        Emit.mOps(cx, fi, p, hfs, ga, gans, what)
        val rest2 = Emit.normLast(cx, p, x, rest, ga)
        val sc = Emit.SC(fi, fi, p, hfs, gans, x, Coll.length(caps), Emit.USite(caps, rest2))
        val ss = Emit.restStmts(rest2)
        Emit.segs(cx, sc, Emit.startScope(cx, fi, ms), ss, 0, Ty.con("I64"), Coll.None, what)
        Emit.cpsFns(cx, fi, p, hfs, gans, Coll.length(caps), Emit.cpsOf(x, ss, Coll.Nil), Coll.Nil, what)

// ── C3.4: the fns a site reaches whose row holds its capability p, each as a site copy in CPS: cg_<F>_<g>(k_, ke_,
// site caps, params) runs g's body cut at its ops of p and its CPS calls; its end returns k_(ke_, last) ──
// what a segment chain belongs to: the site's rest, or a CPS fn g (gv: its result, the type its k_ takes)
enum Emit.U:
  case Emit.USite(caps: Coll.List[Sym.Sym], rest: El.Expr)
  case Emit.UFn(g: Sym.Sym, gv: K.Term, last: El.Expr)
  // an arm of an if whose arms hold cuts: its chain ends in the parent's join segment j (nested ops)
  case Emit.UArm(parent: Emit.SC, j: I64, a: I64, last: El.Expr)

// a chain: the site fn (names), the fn whose expressions are printed, the capability, the handler fns, the answer, the
// name of the capability local that marks ops and CPS calls, the number of site caps, the unit
enum Emit.SC:
  case Emit.SC(sfi: Emit.Fi, efi: Emit.Fi, p: Sym.Sym, hfs: Coll.List[El.Fn], gans: K.Term, k: Sym.Sym, nsc: I64, u: Emit.U)

// a cut in last position (bead vic-tecg) becomes `val ms.last = cut; ms.last`: its value comes back to a segment
// t: the value type of e (an if with cut arms in last position takes it)
def Emit.normLast(cx: Emit.Cx, p: Sym.Sym, k: Sym.Sym, e: El.Expr, t: K.Term): El.Expr = e match
  case El.Block(l, ss, last) => Emit.lastCut(cx, p, k, last, t) match
    case Coll.Some(v) => El.Block(l, Coll.revOnto(Coll.rev(ss), Coll.Cons(v, Coll.Nil)), El.Local(l, Sym.of("ms.last")))
    case Coll.None => e
  case _ => Emit.lastCut(cx, p, k, e, t) match
    case Coll.Some(v) => El.Block(0, Coll.Cons(v, Coll.Nil), El.Local(0, Sym.of("ms.last")))
    case Coll.None => e

def Emit.lastCut(cx: Emit.Cx, p: Sym.Sym, k: Sym.Sym, e: El.Expr, t: K.Term): Coll.Option[El.Stmt] = Emit.cutE(k, e) match
  case Coll.Some(c) => Coll.Some(Emit.lastVal(cx, p, 0, c))
  case Coll.None => e match
    case El.If(l, _, a, b) => if Emit.armCut(k, a) || Emit.armCut(k, b) then Coll.Some(El.Val(l, Sym.of("ms.last"), t, false, e)) else Coll.None
    case _ => Coll.None

// an arm holds a cut: it is one, or a block with one as a whole statement or last
def Emit.armCut(k: Sym.Sym, e: El.Expr): Bool = e match
  case El.Block(_, ss, last) => Emit.anyCut(k, ss) || Emit.isSome(Emit.cutE(k, last)) || Emit.ifCut(k, last)
  case _ => Emit.isSome(Emit.cutE(k, e))

def Emit.ifCut(k: Sym.Sym, e: El.Expr): Bool = e match
  case El.If(_, _, a, b) => Emit.armCut(k, a) || Emit.armCut(k, b)
  case _ => false

def Emit.anyCut(k: Sym.Sym, ss: Coll.List[El.Stmt]): Bool = ss match
  case Coll.Nil => false
  case Coll.Cons(s, rest) => if Emit.isSome(Emit.cutOf(k, s)) || Emit.isSome(Emit.branchOf(k, s)) then true else Emit.anyCut(k, rest)

def Emit.isSome(o: Coll.Option[El.Expr]): Bool = o match
  case Coll.Some(_) => true
  case Coll.None => false

// a statement whose value is an if with cut arms (a branch cut): the if
def Emit.branchOf(k: Sym.Sym, s: El.Stmt): Coll.Option[El.Expr] =
  val e: El.Expr = s match
    case El.Val(_, _, _, _, x) => x
    case El.Do(x) => x
    case El.Handle(l, _, _, _, _) => El.Unit(l)
  if Emit.ifCut(k, e) then Coll.Some(e) else Coll.None

def Emit.lastVal(cx: Emit.Cx, p: Sym.Sym, l: I64, c: El.Expr): El.Stmt =
  val t: K.Term = c match
    case El.Op(_, _, _, op, _, _) => Emit.opV(cx, p, op)
    case El.CallFn(_, f, _, _, _) =>
      val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
      Coll.sLookup(fns, f) match
        case Coll.Some(gf) =>
          val Emit.Fi(_, _, _, _, gv) = Emit.fiOf(cx, Mono.Inst(gf, Coll.Nil, Mono.Top))
          gv
        case Coll.None => Ty.con("Unit")
    case _ => Ty.con("Unit")
  El.Val(l, Sym.of("ms.last"), t, false, c)

// the CPS fns called as whole top-level vals or statements of ss (their caps hold k)
def Emit.cpsOf(k: Sym.Sym, ss: Coll.List[El.Stmt], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) => Emit.cutOf(k, s) match
    case Coll.Some(e) => e match
      case El.CallFn(_, f, _, _, _) => Emit.cpsOf(k, rest, Coll.Cons(f, acc))
      case _ => Emit.cpsOf(k, rest, acc)
    case Coll.None => Emit.branchOf(k, s) match
      case Coll.Some(e) => Emit.cpsOf(k, rest, Emit.cpsOfE(k, e, acc))
      case Coll.None => Emit.cpsOf(k, rest, acc)

// the CPS calls in the arms of a branch cut (whole, statements, last)
def Emit.cpsOfE(k: Sym.Sym, e: El.Expr, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = e match
  case El.CallFn(_, f, _, caps, _) => if Ty.memberSym(k, caps) then Coll.Cons(f, acc) else acc
  case El.If(_, _, a, b) => Emit.cpsOfE(k, b, Emit.cpsOfE(k, a, acc))
  case El.Block(_, ss, last) => Emit.cpsOfE(k, last, Emit.cpsOf(k, ss, acc))
  case _ => acc

def Emit.cpsFns(cx: Emit.Cx, sfi: Emit.Fi, p: Sym.Sym, hfs: Coll.List[El.Fn], gans: K.Term, nsc: I64, todo: Coll.List[Sym.Sym], seen: Coll.List[Sym.Sym], what: Emit.Part): Unit = todo match
  case Coll.Nil => ()
  case Coll.Cons(g, rest) =>
    val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
    if Ty.memberSym(g, seen) then Emit.cpsFns(cx, sfi, p, hfs, gans, nsc, rest, seen, what)
    else Coll.sLookup(fns, g) match
      case Coll.None => Emit.cpsFns(cx, sfi, p, hfs, gans, nsc, rest, Coll.Cons(g, seen), what)
      case Coll.Some(gf) =>
        val El.Fn(_, _, _, _, _, _, body) = gf
        val gfi = Emit.fiOf(cx, Mono.Inst(gf, Coll.Nil, Mono.Top))
        val Emit.Fi(_, _, _, gslots, gv) = gfi
        val k = Eff.dotted("eff", p)
        val vslots = Emit.dropCap(gslots, k)
        val e: El.Expr = body match
          case El.Def(b) => b
          case El.Extern(_, _) => El.Unit(0)
        val e2 = Emit.normLast(cx, p, k, e, gv)
        val gss = Emit.restStmts(e2)
        val sc = Emit.SC(sfi, gfi, p, hfs, gans, k, nsc, Emit.UFn(g, gv, Emit.restParts(e2)))
        val sc0 = Emit.Scope(Emit.paramEnv(vslots, Coll.Nil), Emit.kTNs(gans, gv, nsc, Emit.paramTN(vslots, Coll.Nil)))
        Emit.cgSig(cx, sfi, g, gans, gv, nsc, vslots)
        what match
          case Emit.Layout =>
            Console.print(";\n")
            Emit.segsNext(cx, sc, sc0, gss, 0, what)
          case Emit.Code =>
            Console.print(" { ")
            Emit.segBody(cx, sc, sc0, gss, 0)
        Emit.cpsFns(cx, sfi, p, hfs, gans, nsc, Emit.cpsOf(k, gss, rest), Coll.Cons(g, seen), what)

def Emit.dropCap(slots: Coll.List[Emit.Slot], k: Sym.Sym): Coll.List[Emit.Slot] = slots match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) => s match
    case Emit.SCap(x) => if Sym.eq(x, k) then Emit.dropCap(rest, k) else Coll.Cons(s, Emit.dropCap(rest, k))
    case Emit.SVal(_, _) => Coll.Cons(s, Emit.dropCap(rest, k))

// k_, ke_ and the site caps sc<i> of a CPS fn, as live locals after its params
def Emit.kTNs(gans: K.Term, gv: K.Term, nsc: I64, acc: Coll.List[Emit.TN]): Coll.List[Emit.TN] =
  Emit.scTNs(nsc, 0, Coll.Cons(Emit.TN(Emit.P(Sym.of("ke_")), Emit.CKe), Coll.Cons(Emit.TN(Emit.P(Sym.of("k_")), Emit.CK(gans, gv)), acc)))

def Emit.scTNs(n: I64, i: I64, acc: Coll.List[Emit.TN]): Coll.List[Emit.TN] =
  if i == n then acc else Emit.scTNs(n, i + 1, Coll.Cons(Emit.TN(Emit.scName(i), Emit.CCap), acc))

def Emit.scName(i: I64): Emit.Name = Emit.L(Sym.of("sc"), i)

// static ANS cg_<F>_<g>(ANS (*p_k_)(void**, GV), void** p_ke_, srs_cap* v_sc_0.., params)
def Emit.cgSig(cx: Emit.Cx, sfi: Emit.Fi, g: Sym.Sym, gans: K.Term, gv: K.Term, nsc: I64, vslots: Coll.List[Emit.Slot]): Unit =
  Console.print("static ")
  Emit.ctype(cx, gans)
  Console.print(" ")
  Emit.cgName(sfi, g)
  Console.print("(")
  Emit.ctype(cx, gans)
  Console.print(" (*p_k_)(void**, ")
  Emit.ctype(cx, gv)
  Console.print("), void** p_ke_")
  Emit.scParams(nsc, 0)
  Emit.params(cx, vslots, Emit.Comma)
  Console.print(")")

def Emit.scParams(n: I64, i: I64): Unit =
  if i == n then ()
  else
    Console.print(", srs_cap* ")
    Emit.cname(Emit.scName(i))
    Emit.scParams(n, i + 1)

def Emit.cgName(sfi: Emit.Fi, g: Sym.Sym): Unit =
  val Emit.Fi(self, targs, _, _, _) = sfi
  Console.print("cg_")
  Emit.id(self)
  Emit.suffix(targs)
  Console.print("_")
  Emit.id(g)

// the name of segment i of a chain
def Emit.segName(sc: Emit.SC, i: I64): Unit =
  val Emit.SC(sfi, _, _, _, _, _, _, u) = sc
  u match
    case Emit.USite(_, _) => Emit.msName(sfi, i)
    case Emit.UFn(g, _, _) =>
      Emit.cgName(sfi, g)
      Console.print("_")
      Console.printI64(i)
    case Emit.UArm(parent, j, a, _) =>
      Emit.segName(parent, j)
      Console.print("a")
      Console.printI64(a)
      Console.print("_")
      Console.printI64(i)

// the site caps as args: the site's caps by name, or a CPS fn's sc<i>
def Emit.siteCaps(sc: Emit.SC, env: Emit.Env): Unit =
  val Emit.SC(_, _, _, _, _, _, nsc, u) = sc
  u match
    case Emit.USite(caps, _) => Emit.capArgs(env, caps, Emit.Comma)
    case Emit.UFn(_, _, _) => Emit.scArgs(nsc, 0)
    case Emit.UArm(parent, _, _, _) => Emit.siteCaps(parent, env)

def Emit.scArgs(n: I64, i: I64): Unit =
  if i == n then ()
  else
    Console.print(", ")
    Emit.cname(Emit.scName(i))
    Emit.scArgs(n, i + 1)

// the site's handler fns (not init): mh_<F>_<op>(ANS (*k_)(void**, V), void** ke_, slots) for an op with k, else (slots)
def Emit.mOps(cx: Emit.Cx, fi: Emit.Fi, p: Sym.Sym, hfs: Coll.List[El.Fn], ga: K.Term, gans: K.Term, what: Emit.Part): Unit = hfs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, tps, _, _, _, body) = f
    if Str.eq(Sym.str(n), "init") then Emit.mOps(cx, fi, p, rest, ga, gans, what)
    else
      val sub: Coll.List[Ty.Bind] = tps match
        case Coll.Cons(av, _) => Coll.Cons(Ty.Bind(av, ga), Coll.Nil)
        case Coll.Nil => Coll.Nil
      val hfi = Emit.fiOf(cx, Mono.Inst(f, sub, Mono.Top))
      val Emit.Fi(_, _, _, hslots, hret) = hfi
      val withK = !Str.eq(Sym.str(n), "done")
      Console.print("static ")
      Emit.ctype(cx, hret)
      Console.print(" ")
      Emit.mhName(fi, n)
      Console.print("(")
      if withK then
        Emit.ctype(cx, gans)
        Console.print(" (*k_)(void**, ")
        Emit.ctype(cx, Emit.opV(cx, p, n))
        Console.print("), void** ke_")
        Emit.params(cx, hslots, Emit.Comma)
      else Emit.params(cx, hslots, Emit.First)
      Console.print(")")
      what match
        case Emit.Layout => Console.print(";\n")
        case Emit.Code => body match
          case El.Def(b) =>
            Console.print(" { return ")
            Emit.ex(cx, hfi, Emit.paramEnv(hslots, Coll.Nil), Emit.Inner, b)
            Console.print("; }\n")
          case _ => Console.print(" { return 0; }\n")
      Emit.mOps(cx, fi, p, rest, ga, gans, what)

// segment i of the rest, from statement list ss: read the scope's locals from e_, bind the previous op's value, then
// the statements up to the next op (a call into the op fn) or to the end (done or last). v: the type segment i takes
def Emit.segs(cx: Emit.Cx, sc: Emit.SC, scope: Emit.Scope, ss: Coll.List[El.Stmt], i: I64, v: K.Term, bindV: Coll.Option[El.Stmt], what: Emit.Part): Unit =
  val Emit.SC(_, efi, _, _, gans, _, _, _) = sc
  Console.print("static ")
  Emit.ctype(cx, gans)
  Console.print(" ")
  Emit.segName(sc, i)
  Console.print("(void** e_, ")
  Emit.ctype(cx, v)
  Console.print(" v_)")
  what match
    case Emit.Layout =>
      Console.print(";\n")
      Emit.segsNext(cx, sc, scope, ss, i, what)
    case Emit.Code =>
      Console.print(" { ")
      val Emit.Scope(env0, tns) = scope
      Emit.reads(cx, Coll.rev(tns), 0)
      val sc1: Emit.Scope = bindV match
        case Coll.None =>
          Console.print("(void)v_; ")
          scope
        case Coll.Some(s) => s match
          case El.Val(_, y, ty, _, _) =>
            Emit.ctype(cx, Emit.gr(cx, efi, ty))
            Console.print(" ")
            Emit.cname(Emit.L(y, Emit.envN(env0)))
            Console.print(" = v_; ")
            Emit.scopeOf(cx, efi, scope, Coll.Cons(s, Coll.Nil))
          case _ =>
            Console.print("(void)v_; ")
            scope
      Emit.segBody(cx, sc, sc1, ss, i)

// the type the segment after a cut takes: the op's declared result, or the CPS callee's result
def Emit.cutV(cx: Emit.Cx, sc: Emit.SC, e: El.Expr): K.Term =
  val Emit.SC(_, _, p, _, _, _, _, _) = sc
  e match
    case El.Op(_, _, _, op, _, _) => Emit.opV(cx, p, op)
    case El.CallFn(_, f, _, _, _) =>
      val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
      Coll.sLookup(fns, f) match
        case Coll.Some(gf) =>
          val Emit.Fi(_, _, _, _, gv) = Emit.fiOf(cx, Mono.Inst(gf, Coll.Nil, Mono.Top))
          gv
        case Coll.None => Ty.con("Unit")
    case _ => Ty.con("Unit")

// Layout: the prototypes of every later segment
def Emit.segsNext(cx: Emit.Cx, sc: Emit.SC, scope: Emit.Scope, ss: Coll.List[El.Stmt], i: I64, what: Emit.Part): Unit = ss match
  case Coll.Nil => ()
  case Coll.Cons(s, rest) =>
    val Emit.SC(_, efi, _, _, _, k, _, _) = sc
    Emit.cutOf(k, s) match
      case Coll.None => Emit.branchOf(k, s) match
        case Coll.None => Emit.segsNext(cx, sc, Emit.scopeOf(cx, efi, scope, Coll.Cons(s, Coll.Nil)), rest, i, what)
        case Coll.Some(ife) =>
          Emit.armChains(cx, sc, scope, i, s, ife, what)
          Emit.segs(cx, sc, scope, rest, i + 1, Emit.joinV(cx, efi, s), Coll.Some(s), what)
      case Coll.Some(o) => Emit.segs(cx, sc, scope, rest, i + 1, Emit.cutV(cx, sc, o), Coll.Some(s), what)

// the value type a branch cut's join takes: the val's type (a statement: Unit)
def Emit.joinV(cx: Emit.Cx, efi: Emit.Fi, s: El.Stmt): K.Term = s match
  case El.Val(_, _, ty, _, _) => Emit.gr(cx, efi, ty)
  case _ => Ty.con("Unit")

// the chain of arm a of a branch cut (an arm with a cut): its statements, ending in the join segment i + 1
def Emit.armSC(cx: Emit.Cx, sc: Emit.SC, i: I64, s: El.Stmt, a: I64, arm: El.Expr): Emit.SC =
  val Emit.SC(sfi, efi, p, hfs, gans, k, nsc, _) = sc
  val ne = Emit.normLast(cx, p, k, arm, Emit.joinV(cx, efi, s))
  Emit.SC(sfi, efi, p, hfs, gans, k, nsc, Emit.UArm(sc, i + 1, a, Emit.restParts(ne)))

def Emit.armStmts(cx: Emit.Cx, sc: Emit.SC, s: El.Stmt, arm: El.Expr): Coll.List[El.Stmt] =
  val Emit.SC(_, efi, p, _, _, k, _, _) = sc
  Emit.restStmts(Emit.normLast(cx, p, k, arm, Emit.joinV(cx, efi, s)))

def Emit.armChains(cx: Emit.Cx, sc: Emit.SC, scope: Emit.Scope, i: I64, s: El.Stmt, ife: El.Expr, what: Emit.Part): Unit =
  val Emit.SC(_, _, _, _, _, k, _, _) = sc
  ife match
    case El.If(_, _, ta, fa) =>
      if Emit.armCut(k, ta) then Emit.segs(cx, Emit.armSC(cx, sc, i, s, 0, ta), scope, Emit.armStmts(cx, sc, s, ta), 0, Ty.con("I64"), Coll.None, what) else ()
      if Emit.armCut(k, fa) then Emit.segs(cx, Emit.armSC(cx, sc, i, s, 1, fa), scope, Emit.armStmts(cx, sc, s, fa), 0, Ty.con("I64"), Coll.None, what) else ()
    case _ => ()

// the jump of one arm of a branch cut: into its chain, or (no cut) its value straight to the join
def Emit.armJump(cx: Emit.Cx, sc: Emit.SC, env: Emit.Env, i: I64, s: El.Stmt, a: I64, arm: El.Expr): Unit =
  val Emit.SC(_, efi, _, _, _, k, _, _) = sc
  if Emit.armCut(k, arm) then
    Emit.segName(Emit.armSC(cx, sc, i, s, a, arm), 0)
    Console.print("(e2_, 0)")
  else
    Emit.segName(sc, i + 1)
    Console.print("(e2_, ")
    Emit.ex(cx, efi, env, Emit.Inner, arm)
    Console.print(")")

// Code: statements until the next cut or the end, then the next segment fn
def Emit.segBody(cx: Emit.Cx, sc: Emit.SC, scope: Emit.Scope, ss: Coll.List[El.Stmt], i: I64): Unit =
  val Emit.SC(sfi, efi, _, hfs, _, k, _, u) = sc
  val Emit.Scope(env, tns) = scope
  ss match
    case Coll.Nil =>
      u match
        case Emit.UArm(_, _, _, _) =>
          Console.print("void* ej_[] = { ")
          Emit.addrs(Coll.rev(tns), Emit.First)
          Console.print(" }; ")
        case _ => ()
      Console.print("return ")
      u match
        // an arm's end: its value to the join segment, with the locals (the parent's come first)
        case Emit.UArm(parent, j, _, last) =>
          Emit.segName(parent, j)
          Console.print("(ej_, ")
          Emit.ex(cx, efi, env, Emit.Inner, last)
          Console.print(")")
        case Emit.USite(caps, rest) =>
          if Emit.hasDone(hfs) then
            Emit.mhName(sfi, Sym.of("done"))
            Console.print("(")
            Emit.capArgs(env, caps, Emit.First)
            val sp: Emit.Sep = if Coll.length(caps) == 0 then Emit.First else Emit.Comma
            Emit.sep(sp)
            Console.print("0, ")
            Emit.ex(cx, efi, env, Emit.Inner, Emit.restParts(rest))
            Console.print(")")
          else Emit.ex(cx, efi, env, Emit.Inner, Emit.restParts(rest))
        // a CPS fn's end: its value to the caller's next segment
        case Emit.UFn(_, _, last) =>
          Console.print("p_k_(p_ke_, ")
          Emit.ex(cx, efi, env, Emit.Inner, last)
          Console.print(")")
      Console.print("; }\n")
    case Coll.Cons(s, more) => Emit.cutOf(k, s) match
      case Coll.None => Emit.branchOf(k, s) match
        case Coll.None =>
          Emit.stmt(cx, efi, env, s)
          Emit.segBody(cx, sc, Emit.scopeOf(cx, efi, scope, Coll.Cons(s, Coll.Nil)), more, i)
        // a branch cut: each arm jumps to its chain (or its value to the join), the join binds the val and goes on
        case Coll.Some(ife) => ife match
          case El.If(_, c, ta, fa) =>
            Console.print("void* e2_[] = { ")
            Emit.addrs(Coll.rev(tns), Emit.First)
            Console.print(" }; if (")
            Emit.ex(cx, efi, env, Emit.Inner, c)
            Console.print(") return ")
            Emit.armJump(cx, sc, env, i, s, 0, ta)
            Console.print("; else return ")
            Emit.armJump(cx, sc, env, i, s, 1, fa)
            Console.print("; }\n")
            Emit.armChains(cx, sc, scope, i, s, ife, Emit.Code)
            Emit.segs(cx, sc, scope, more, i + 1, Emit.joinV(cx, efi, s), Coll.Some(s), Emit.Code)
          case _ => ()
      case Coll.Some(o) =>
        Console.print("void* e2_[] = { ")
        Emit.addrs(Coll.rev(tns), Emit.First)
        Console.print(" }; return ")
        o match
          // an op of p: the site's op fn, with the next segment as k
          case El.Op(_, _, _, op, args, _) =>
            Emit.mhName(sfi, op)
            Console.print("(")
            Emit.segName(sc, i + 1)
            Console.print(", e2_")
            Emit.siteCaps(sc, env)
            Console.print(", 0")
            Emit.args(cx, efi, env, args, Emit.Comma)
          // a CPS call: the callee's site copy, with the next segment as its k
          case El.CallFn(_, f, _, caps, args) =>
            Emit.cgName(sfi, f)
            Console.print("(")
            Emit.segName(sc, i + 1)
            Console.print(", e2_")
            Emit.siteCaps(sc, env)
            Emit.capArgs(env, Emit.without(caps, k), Emit.Comma)
            Emit.args(cx, efi, env, args, Emit.Comma)
          case _ => Console.print("0")
        Console.print("); }\n")
        Emit.segs(cx, sc, scope, more, i + 1, Emit.cutV(cx, sc, o), Coll.Some(s), Emit.Code)

def Emit.without(xs: Coll.List[Sym.Sym], k: Sym.Sym): Coll.List[Sym.Sym] = xs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(x, rest) => if Sym.eq(x, k) then Emit.without(rest, k) else Coll.Cons(x, Emit.without(rest, k))

// a cut: an op of the capability k, or a call of a CPS fn (its caps hold k), as a whole val or statement
def Emit.cutOf(k: Sym.Sym, s: El.Stmt): Coll.Option[El.Expr] = s match
  case El.Val(_, _, _, _, e) => Emit.cutE(k, e)
  case El.Do(e) => Emit.cutE(k, e)
  case El.Handle(_, _, _, _, _) => Coll.None

def Emit.cutE(k: Sym.Sym, e: El.Expr): Coll.Option[El.Expr] = e match
  case El.Op(_, recv, _, _, _, _) => if Sym.eq(recv, k) then Coll.Some(e) else Coll.None
  case El.CallFn(_, _, _, caps, _) => if Ty.memberSym(k, caps) then Coll.Some(e) else Coll.None
  case _ => Coll.None

def Emit.hasDone(fs: Coll.List[El.Fn]): Bool = fs match
  case Coll.Nil => false
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, _) = f
    if Str.eq(Sym.str(n), "done") then true else Emit.hasDone(rest)

// one statement of a segment, as Emit.block prints it
def Emit.stmt(cx: Emit.Cx, fi: Emit.Fi, env: Emit.Env, s: El.Stmt): Unit = s match
  case El.Val(_, y, ty, _, e) =>
    Emit.ctype(cx, Emit.gr(cx, fi, ty))
    Console.print(" ")
    Emit.cname(Emit.L(y, Emit.envN(env)))
    Console.print(" = ")
    Emit.ex(cx, fi, env, Emit.Inner, e)
    Console.print("; ")
  case El.Do(e) =>
    Console.print("(void)(")
    Emit.ex(cx, fi, env, Emit.Inner, e)
    Console.print("); ")
  case El.Handle(_, _, _, _, _) => ()

// T name = *(T*)e_[j] for each live local, in scope order
def Emit.reads(cx: Emit.Cx, tns: Coll.List[Emit.TN], j: I64): Unit = tns match
  case Coll.Nil => ()
  case Coll.Cons(tn, rest) =>
    val Emit.TN(v, t) = tn
    t match
      case Emit.CK(ans, kv) =>
        Emit.ctype(cx, ans)
        Console.print(" (*")
        Emit.cname(v)
        Console.print(")(void**, ")
        Emit.ctype(cx, kv)
        Console.print(") = *(")
        Emit.ctype(cx, ans)
        Console.print(" (**)(void**, ")
        Emit.ctype(cx, kv)
        Console.print("))e_[")
      case _ =>
        Emit.cty(cx, t)
        Console.print(" ")
        Emit.cname(v)
        Console.print(" = *(")
        Emit.cty(cx, t)
        Console.print("*)e_[")
    Console.printI64(j)
    Console.print("]; ")
    Emit.reads(cx, rest, j + 1)

def Emit.cty(cx: Emit.Cx, t: Emit.CT): Unit = t match
  case Emit.CVal(k) => Emit.ctype(cx, k)
  case Emit.CCap => Console.print("srs_cap*")
  case Emit.CK(_, _) => Console.print("void*")
  case Emit.CKe => Console.print("void**")

def Emit.addrNames(vs: Coll.List[Emit.Name], s: Emit.Sep): Unit = vs match
  case Coll.Nil => s match
    case Emit.First => Console.print("0")
    case Emit.Comma => ()
  case Coll.Cons(v, rest) =>
    Emit.sep(s)
    Console.print("&")
    Emit.cname(v)
    Emit.addrNames(rest, Emit.Comma)

def Emit.addrs(tns: Coll.List[Emit.TN], s: Emit.Sep): Unit = tns match
  case Coll.Nil => s match
    case Emit.First => Console.print("0")
    case Emit.Comma => ()
  case Coll.Cons(tn, rest) =>
    val Emit.TN(v, _) = tn
    Emit.sep(s)
    Console.print("&")
    Emit.cname(v)
    Emit.addrs(rest, Emit.Comma)

// the fns of every handler: prototypes (Layout) or bodies (Code)
def Emit.handlers(cx: Emit.Cx, hs: Coll.List[El.Handler], what: Emit.Part): Unit = hs match
  case Coll.Nil => ()
  case Coll.Cons(h, rest) =>
    val El.Handler(hn, _, fs, _) = h
    Emit.implFns(cx, Emit.KHandler(hn), fs, what)
    Emit.handlers(cx, rest, what)

def Emit.implFns(cx: Emit.Cx, k: Emit.Kind, fs: Coll.List[El.Fn], what: Emit.Part): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, _, _, _, _, body) = f
    val fi = Emit.fiOf(cx, Mono.Inst(f, Coll.Nil, Mono.Top))
    what match
      case Emit.Layout =>
        Emit.sig(cx, fi, k)
        Console.print(";\n")
      case Emit.Code => body match
        case El.Def(e) => Emit.body(cx, fi, k, e)
        case _ => ()
    Emit.implFns(cx, k, rest, what)

// the handlers with a vtable: a multi-shot handler has none (its fns are printed per site, Emit.mSite)
def Emit.oneShot(hs: Coll.List[El.Handler]): Coll.List[El.Handler] = hs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(h, rest) =>
    val El.Handler(_, _, _, shots) = h
    shots match
      case Ast.OneShot => Coll.Cons(h, Emit.oneShot(rest))
      case Ast.MultiShot(_, _) => Emit.oneShot(rest)

// the vtable of a handler: its fn per op of its protocol, in the protocol's op order (spec sec 5.1)
def Emit.vtables(cx: Emit.Cx, hs: Coll.List[El.Handler]): Unit = hs match
  case Coll.Nil => ()
  case Coll.Cons(h, rest) =>
    val El.Handler(hn, p, fs, _) = h
    val Emit.Cx(_, _, _, _, ps, _, _, _, _) = cx
    val pre: Str = Emit.slotPre(cx, p, fs)
    Emit.wrappers(cx, p, hn, fs)
    Console.print("static void* const vt_")
    Emit.id(hn)
    Console.print("[] = {")
    Coll.sLookup(ps, p) match
      case Coll.Some(pr) =>
        val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
        Emit.vtOps(cx, p, pre, hn, ops)
      case Coll.None => ()
    Console.print(" 0 };\n")
    Emit.vtables(cx, rest)

// the vtable slot prefix: w_ (wrapper: env pointer + op params) for a handler with a row, else the h_ fn itself
def Emit.slotPre(cx: Emit.Cx, p: Sym.Sym, fs: Coll.List[El.Fn]): Str = if Emit.hasRow(cx, p, fs) then "w_" else "h_"

// a handler with a row (E1b): every fn takes the same implicit capabilities
def Emit.hasRow(cx: Emit.Cx, p: Sym.Sym, fs: Coll.List[El.Fn]): Bool = fs match
  case Coll.Nil => false
  case Coll.Cons(f, _) =>
    val El.Fn(_, name, _, caps, _, _, _) = f
    Coll.length(caps) > Emit.ownN(cx, p, name)

// the {} binders an op declares itself (the caller's capabilities, passed per call after self): its fn's first caps
def Emit.ownN(cx: Emit.Cx, p: Sym.Sym, op: Sym.Sym): I64 =
  val Emit.Cx(_, _, _, _, ps, _, _, _, _) = cx
  Coll.sLookup(ps, p) match
    case Coll.None => 0
    case Coll.Some(pr) =>
      val Ast.Proto(_, _, _, _, _, _, ops, _) = pr
      Emit.ownIn(ops, op)

def Emit.ownIn(ops: Coll.List[Ast.Op], op: Sym.Sym): I64 = ops match
  case Coll.Nil => 0
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, n, ogs, _, _, _) = o
    if Sym.eq(n, op) then Coll.length(Ty.evidence(ogs, Coll.Nil)) else Emit.ownIn(rest, op)

// its vtable entries: w_H_op(srs_env* e, args) calls h_H_op(e->c[0], .., e->st, args) (init is not in the vtable)
def Emit.wrappers(cx: Emit.Cx, p: Sym.Sym, hn: Sym.Sym, fs: Coll.List[El.Fn]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, name, _, caps, _, _, _) = f
    if Coll.length(caps) > 0 && !Str.eq(Sym.str(name), "init") then
      val Emit.Fi(_, _, _, slots, ret) = Emit.fiOf(cx, Mono.Inst(f, Coll.Nil, Mono.Top))
      val own = Emit.ownN(cx, p, name)
      // the op's own binders come first in the fn's caps and are passed per call: w_H_op(e, own caps, args); the rest of
      // the caps are the handler's row, from its env
      val ownSlots = Emit.takeCaps(slots, own)
      Console.print("static ")
      Emit.ctype(cx, ret)
      Console.print(" w_")
      Emit.id(hn)
      Console.print("_")
      Emit.id(name)
      Console.print("(void* e_")
      Emit.params(cx, ownSlots, Emit.Comma)
      Emit.params(cx, Emit.opSlots(slots), Emit.Comma)
      Console.print(") { srs_env* e = (srs_env*)e_; return h_")
      Emit.id(hn)
      Console.print("_")
      Emit.id(name)
      Console.print("(")
      Emit.ownArgs(ownSlots, Emit.First)
      Emit.envCaps(0, Coll.length(caps) - own)
      Console.print("e->st")
      Emit.slotArgs(Emit.opSlots(slots))
      Console.print("); }\n")
    else ()
    Emit.wrappers(cx, p, hn, rest)

// the first n capability slots
def Emit.takeCaps(slots: Coll.List[Emit.Slot], n: I64): Coll.List[Emit.Slot] = if n <= 0 then Coll.Nil else slots match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) => s match
    case Emit.SCap(_) => Coll.Cons(s, Emit.takeCaps(rest, n - 1))
    case Emit.SVal(_, _) => Coll.Nil

def Emit.ownArgs(slots: Coll.List[Emit.Slot], s: Emit.Sep): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(sl, rest) =>
    Emit.sep(s)
    Console.print("p_")
    Emit.id(Emit.slotName(sl))
    Console.print(", ")
    Emit.ownArgs(rest, Emit.First)

// the op's own params: no capability, no self
def Emit.opSlots(slots: Coll.List[Emit.Slot]): Coll.List[Emit.Slot] = slots match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) => s match
    case Emit.SCap(_) => Emit.opSlots(rest)
    case Emit.SVal(_, _) => rest

def Emit.envCaps(i: I64, n: I64): Unit =
  if i < n then
    Console.print("e->c[")
    Console.printI64(i)
    Console.print("], ")
    Emit.envCaps(i + 1, n)
  else ()

def Emit.slotArgs(slots: Coll.List[Emit.Slot]): Unit = slots match
  case Coll.Nil => ()
  case Coll.Cons(s, rest) =>
    Console.print(", p_")
    Emit.id(Emit.slotName(s))
    Emit.slotArgs(rest)

def Emit.vtOps(cx: Emit.Cx, p: Sym.Sym, pre: Str, hn: Sym.Sym, ops: Coll.List[Ast.Op]): Unit = ops match
  case Coll.Nil => ()
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, n, _, _, _, _) = o
    Console.print(" (void*)")
    Console.print(if Emit.ownIn(ops, n) > 0 then "w_" else pre)
    Emit.id(hn)
    Console.print("_")
    Emit.id(n)
    Console.print(",")
    Emit.vtOps(cx, p, pre, hn, rest)

// the inline Arena bump (spec sec 5.2): the free bytes of an Arena's head chunk are cur..end of its capability, so an
// allocation is a compare and a bump with no vtable test. The slow path (end reached, or a Region handler that is not
// an Arena: its cur and end stay null) runs the handler's alloc; for an Arena it writes the bump back into the head
// chunk (the chunk layout of the Srs.Arena handler in lib/prelude.srs), lets its alloc open a chunk, and takes the new head's free bytes
def Emit.allocFast(cx: Emit.Cx): Unit =
  Console.print("typedef struct srs_chunk { struct srs_chunk* next; size_t used, cap; } srs_chunk;\n")
  Console.print("__attribute__((noinline)) static void* srs_alloc_slow(srs_cap* c, int64_t size) {\n")
  Console.print("  if (c->vt == vt_Srs__Arena) {\n")
  Console.print("    srs_chunk** hp = (srs_chunk**)c->self;\n")
  Console.print("    if (c->end) (*hp)->used = (size_t)(c->cur - (char*)(*hp + 1));\n")
  Console.print("    void* p = h_Srs__Arena_alloc(c->self, size);\n")
  Console.print("    c->cur = (char*)(*hp + 1) + (*hp)->used; c->end = (char*)(*hp + 1) + (*hp)->cap;\n")
  Console.print("    return p;\n")
  Console.print("  }\n")
  Console.print("  return ((void*(*)(void*, int64_t))c->vt[")
  Console.printI64(Emit.opIndex(cx, Sym.of("Region"), Sym.of("alloc")))
  Console.print("])(c->self, size);\n")
  Console.print("}\n")
  // an 8-byte granule: no box field is aligned to more than 8 (Emit.alignOf), and chunk data starts 8-aligned
  Console.print("static inline void* srs_alloc(srs_cap* c, int64_t size) {\n")
  Console.print("  size_t n = ((size_t)size + 7) & ~(size_t)7;\n")
  Console.print("  char* p = c->cur;\n")
  Console.print("  if ((size_t)(c->end - p) >= n) { c->cur = p + n; return p; }\n")
  Console.print("  return srs_alloc_slow(c, size);\n")
  // srs_cap_alloc: the one non-static entry to the allocator, for a C extern given a capability (rt/srs_cap.h). Every
  // Inline program carries it: an unused fn costs no run time, and a check for such externs would walk every fn
  Console.print("}\nvoid* srs_cap_alloc(srs_cap* c, int64_t size) { return srs_alloc(c, size); }\n")

def Emit.hasMain(cx: Emit.Cx): Bool =
  val Emit.Cx(_, fns, _, _, _, _, _, _, _) = cx
  Coll.sLookup(fns, Sym.of("main")) match
    case Coll.Some(_) => true
    case Coll.None => false

// ── static capabilities ──
// A protocol P is static when the program opens exactly one handle of it, a top-level statement of main's body (a
// one-shot El.Handle; a multi-shot El.MHandled anywhere is a second handle), and no fn calls main. main runs once,
// and before that handle no handler of P exists (a request there is error[unhandled-effect]), so one instance of P lives
// while the program runs, and every srs_cap* of P a fn receives is that instance: a capability is erased
// (error[capability-erased]), it reaches a fn only as a capability argument or a handler's kept capability. The defs
// then read it from the file-static eff__P instead of a C param for their row binder eff.P, and their calls stop
// passing it: constant propagation of a single-valued param. Region (Srs.Arena or Srs.Heap) follows the same rule when
// the program also writes no Region binder {r: Region} (a call f{r}(x) names a region: Emit.namesRegion); a second Region
// handle anywhere, a sub-region or a named region keeps the Region param in every def. An Arena's bump (cur, end) lives
// in its capability, so the static instance holds it.
enum Emit.Static:
  case Emit.Static(proto: Sym.Sym, h: Sym.Sym, x: Sym.Sym)

// the protocol of every handle site in the program, whether some fn calls main, the handlers named at a handle site (hn)
// and the externs called (cs); ex = every extern of the program: sets of the names' hashes (a hash tie only keeps one more handler or extern)
enum Emit.Seen:
  case Emit.Seen(ps: Coll.List[Sym.Sym], callsMain: Bool, hn: Coll.ISet, cs: Coll.ISet, ex: Coll.ISet)

def Emit.isStatic(cx: Emit.Cx, p: Sym.Sym): Bool =
  val Emit.Cx(_, _, _, _, _, _, _, _, st) = cx
  Emit.staticIn(st, p)

def Emit.staticIn(st: Coll.List[Emit.Static], p: Sym.Sym): Bool = st match
  case Coll.Nil => false
  case Coll.Cons(s, rest) =>
    val Emit.Static(q, _, _) = s
    if Sym.eq(q, p) then true else Emit.staticIn(rest, p)

def Emit.staticsOf(cx: Emit.Cx, ds: Coll.List[Ast.Decl], res: Ty.Result, roots: Emit.Seen): Coll.List[Emit.Static] =
  val Ty.Result(_, _, _, fs, hs, _) = res
  val Emit.Seen(ps, called, _, _, _) = Emit.seenHs(cx, hs, roots)
  if called then Coll.Nil else Emit.mainStatics(cx, ps, Emit.namesRegion(ds), Emit.mainStmts(fs), Coll.Nil)

// the program writes a Region binder {r: Region}: a def, a handler fn, a given fn or a trait method takes a named
// region, so a call can name one (f{r}(x)) and Region stays a param (Emit.mainStatics)
def Emit.namesRegion(ds: Coll.List[Ast.Decl]): Bool = ds match
  case Coll.Nil => false
  case Coll.Cons(d, rest) =>
    val named = d match
      case Ast.DFn(f) => Emit.declFnNamesRegion(f)
      case Ast.DVal(f) => Emit.fnNamesRegion(f)
      case Ast.DHandler(h) =>
        val Ast.Handler(_, _, _, fns, _) = h
        Emit.fnsNameRegion(fns)
      case Ast.DTrait(t) =>
        val Ast.Trait(_, _, gs, sigs) = t
        Emit.groupsNameRegion(gs) || Emit.fnsNameRegion(sigs)
      case Ast.DGiven(g) =>
        val Ast.Given(_, gs, _, fns) = g
        Emit.groupsNameRegion(gs) || Emit.fnsNameRegion(fns)
      case _ => false
    named || Emit.namesRegion(rest)

def Emit.fnsNameRegion(fs: Coll.List[Ast.Fn]): Bool = fs match
  case Coll.Nil => false
  case Coll.Cons(f, rest) => Emit.fnNamesRegion(f) || Emit.fnsNameRegion(rest)

def Emit.fnNamesRegion(f: Ast.Fn): Bool =
  val Ast.Fn(_, _, gs, _, _, _, _) = f
  Emit.groupsNameRegion(gs)

// a top-level extern is C, with no body to name a region in: its binder (Str.ofBytes) names none the caller chooses, so
// it must not turn Region static off for every program that carries the prelude. a trait method signature is also an
// Ast.Extern body, but it does name one, so it goes through fnNamesRegion
def Emit.declFnNamesRegion(f: Ast.Fn): Bool =
  val Ast.Fn(_, _, _, _, _, _, body) = f
  body match
    case Ast.Extern(_) => false
    case _ => Emit.fnNamesRegion(f)

def Emit.groupsNameRegion(gs: Coll.List[Ast.Group]): Bool = gs match
  case Coll.Nil => false
  case Coll.Cons(g, rest) => g match
    case Ast.Evidence(bs) => Emit.bindersNameRegion(bs) || Emit.groupsNameRegion(rest)
    case _ => Emit.groupsNameRegion(rest)

def Emit.bindersNameRegion(bs: Coll.List[Ast.Binder]): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Sym.eq(n, Sym.of("Region")) || Emit.bindersNameRegion(rest)

def Emit.mainStmts(fs: Coll.List[El.Fn]): Coll.List[El.Stmt] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, body) = f
    if Sym.eq(n, Sym.of("main")) then body match
      case El.Def(e) => e match
        case El.Block(_, ss, _) => ss
        case _ => Coll.Nil
      case El.Extern(_, _) => Coll.Nil
    else Emit.mainStmts(rest)

// Region is static only when no region is named (named: Emit.namesRegion); its one handle (Srs.Arena or Srs.Heap) is the
// count of 1, so a second Region handle anywhere (two in main, a sub-region in a fn) keeps the param program-wide
def Emit.mainStatics(cx: Emit.Cx, ps: Coll.List[Sym.Sym], named: Bool, ss: Coll.List[El.Stmt], acc: Coll.List[Emit.Static]): Coll.List[Emit.Static] = ss match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(s, rest) => s match
    case El.Handle(_, _, h, _, _) =>
      val p = Emit.protoOfH(cx, h)
      if Emit.countSym(ps, p, 0) == 1 && !(named && Sym.eq(p, Sym.of("Region"))) then Emit.mainStatics(cx, ps, named, rest, Coll.Cons(Emit.Static(p, h, Eff.dotted("eff", p)), acc))
      else Emit.mainStatics(cx, ps, named, rest, acc)
    case _ => Emit.mainStatics(cx, ps, named, rest, acc)

def Emit.countSym(xs: Coll.List[Sym.Sym], x: Sym.Sym, n: I64): I64 = xs match
  case Coll.Nil => n
  case Coll.Cons(y, rest) => Emit.countSym(rest, x, if Sym.eq(x, y) then n + 1 else n)

def Emit.saw(cx: Emit.Cx, s: Emit.Seen, h: Sym.Sym): Emit.Seen =
  val Emit.Seen(ps, called, hn, cs, ex) = s
  Emit.Seen(Coll.Cons(Emit.protoOfH(cx, h), ps), called, Coll.setAdd(hn, Sym.hash(h)), cs, ex)

def Emit.seenFns(cx: Emit.Cx, fs: Coll.List[El.Fn], s: Emit.Seen): Emit.Seen = fs match
  case Coll.Nil => s
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, _, _, _, _, body) = f
    val s1 = body match
      case El.Def(e) => Emit.seenE(cx, e, s)
      case El.Extern(_, _) => s
    Emit.seenFns(cx, rest, s1)

def Emit.seenHs(cx: Emit.Cx, hs: Coll.List[El.Handler], s: Emit.Seen): Emit.Seen = hs match
  case Coll.Nil => s
  case Coll.Cons(h, rest) =>
    val El.Handler(_, _, fs, _) = h
    Emit.seenHs(cx, rest, Emit.seenFns(cx, fs, s))

def Emit.seenGvs(cx: Emit.Cx, gs: Coll.List[El.Given], s: Emit.Seen): Emit.Seen = gs match
  case Coll.Nil => s
  case Coll.Cons(g, rest) =>
    val El.Given(_, _, _, fs) = g
    Emit.seenGvs(cx, rest, Emit.seenFns(cx, fs, s))

def Emit.seenE(cx: Emit.Cx, e: El.Expr, s: Emit.Seen): Emit.Seen = e match
  case El.CallFn(_, f, _, _, args) =>
    val Emit.Seen(ps, called, hn, cs, ex) = s
    Emit.seenEs(cx, args, Emit.Seen(ps, called || Sym.eq(f, Sym.of("main")), hn, Emit.seenCall(cs, ex, f), ex))
  case El.New(_, _, _, _, _, args) => Emit.seenEs(cx, args, s)
  case El.Op(_, _, _, _, args, _) => Emit.seenEs(cx, args, s)
  case El.MHandled(_, _, h, _, args, rest, _, _) => Emit.seenEs(cx, Coll.Cons(rest, args), Emit.saw(cx, s, h))
  case El.Resume(_, _, x) => Emit.seenE(cx, x, s)
  case El.TCall(_, _, _, _, args) => Emit.seenEs(cx, args, s)
  case El.Bin(_, _, l, x) => Emit.seenE(cx, x, Emit.seenE(cx, l, s))
  case El.Un(_, _, x) => Emit.seenE(cx, x, s)
  case El.If(_, c, t, x) => Emit.seenE(cx, x, Emit.seenE(cx, t, Emit.seenE(cx, c, s)))
  case El.Match(_, x, _, arms) => Emit.seenArms(cx, arms, Emit.seenE(cx, x, s))
  case El.Block(_, ss, last) => Emit.seenE(cx, last, Emit.seenSs(cx, ss, s))
  case El.While(_, c, b) => Emit.seenE(cx, b, Emit.seenE(cx, c, s))
  case El.Assign(_, _, x) => Emit.seenE(cx, x, s)
  case El.Index(_, _, i) => Emit.seenE(cx, i, s)
  case El.Slice(_, x, o) => Emit.seenE(cx, o, Emit.seenE(cx, x, s))
  case El.Fill(_, _, n, x, _) => Emit.seenE(cx, x, Emit.seenE(cx, n, s))
  case El.Tab(_, _, n, _, _, g) => Emit.seenE(cx, g, Emit.seenE(cx, n, s))
  case El.CellNew(_, _, v, _) => Emit.seenE(cx, v, s)
  case El.CellGet(_, c) => Emit.seenE(cx, c, s)
  case El.CNew(_, _, n) =>
    val Emit.Seen(ps, called, hn, cs, ex) = s
    Emit.Seen(ps, called, hn, Coll.setAdd(cs, Sym.hash(n)), ex)
  case El.CField(_, c, _, _, _) => Emit.seenE(cx, c, s)
  case El.CellPut(_, c, v) => Emit.seenE(cx, v, Emit.seenE(cx, c, s))
  case El.ArrPut(_, _, i, v) => Emit.seenE(cx, v, Emit.seenE(cx, i, s))
  case El.Blit(_, _, a, b, m) => Emit.seenE(cx, m, Emit.seenE(cx, b, Emit.seenE(cx, a, s)))
  case _ => s

def Emit.seenEs(cx: Emit.Cx, xs: Coll.List[El.Expr], s: Emit.Seen): Emit.Seen = xs match
  case Coll.Nil => s
  case Coll.Cons(x, rest) => Emit.seenEs(cx, rest, Emit.seenE(cx, x, s))

// what a program needs of the handlers and externs (pay per use): the handlers named at a handle site in its defs or
// givens, then those named in the fns of a needed handler, until no more; the Arena too when allocFast is on (it reads
// vt_Srs__Arena). Seen.cs holds every fn those bodies call, so an extern is needed when it is in cs.
enum Emit.Reach:
  case Emit.Reach(s: Emit.Seen, done: Coll.SMap[Bool], grew: Bool)

def Emit.roots(cx: Emit.Cx, fs: Coll.List[El.Fn], gvs: Coll.List[El.Given]): Emit.Seen =
  val Emit.Cx(_, _, _, _, _, _, al, _, _) = cx
  val base: Coll.ISet = al match
    case Emit.Inline => Coll.setAdd(Coll.setEmpty(), Sym.hash(Sym.of("Srs.Arena")))
    case Emit.VTable => Coll.setEmpty()
  Emit.seenGvs(cx, gvs, Emit.seenFns(cx, fs, Emit.Seen(Coll.Nil, false, base, Coll.setEmpty(), Emit.externSet(fs, Coll.setEmpty()))))

def Emit.reach(cx: Emit.Cx, hs: Coll.List[El.Handler], s: Emit.Seen, done: Coll.SMap[Bool]): Emit.Seen =
  val Emit.Reach(s2, done2, grew) = Emit.reachHs(cx, hs, Emit.Reach(s, done, false))
  if grew then Emit.reach(cx, hs, s2, done2) else s2

def Emit.reachHs(cx: Emit.Cx, hs: Coll.List[El.Handler], r: Emit.Reach): Emit.Reach = hs match
  case Coll.Nil => r
  case Coll.Cons(h, rest) =>
    val El.Handler(n, _, fs, _) = h
    val Emit.Reach(s, done, _) = r
    val Emit.Seen(_, _, hn, _, _) = s
    if Coll.setHas(hn, Sym.hash(n)) then
      if Pure.has(done, n) then Emit.reachHs(cx, rest, r)
      else Emit.reachHs(cx, rest, Emit.Reach(Emit.seenFns(cx, fs, s), Coll.sInsert(done, n, true), true))
    else Emit.reachHs(cx, rest, r)

// the externs of a program, and a call of one of them recorded in cs
def Emit.externSet(fs: Coll.List[El.Fn], ex: Coll.ISet): Coll.ISet = fs match
  case Coll.Nil => ex
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, body) = f
    body match
      case El.Extern(_, _) => Emit.externSet(rest, Coll.setAdd(ex, Sym.hash(n)))
      case El.Def(_) => Emit.externSet(rest, ex)

def Emit.seenCall(cs: Coll.ISet, ex: Coll.ISet, f: Sym.Sym): Coll.ISet =
  val h = Sym.hash(f)
  if Coll.setHas(ex, h) then (if Coll.setHas(cs, h) then cs else Coll.setAdd(cs, h)) else cs

// the handlers a program needs
def Emit.keepHs(hs: Coll.List[El.Handler], hn: Coll.ISet): Coll.List[El.Handler] = hs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(h, rest) =>
    val El.Handler(n, _, _, _) = h
    if Coll.setHas(hn, Sym.hash(n)) then Coll.Cons(h, Emit.keepHs(rest, hn)) else Emit.keepHs(rest, hn)

def Emit.seenArms(cx: Emit.Cx, as: Coll.List[El.Arm], s: Emit.Seen): Emit.Seen = as match
  case Coll.Nil => s
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    Emit.seenArms(cx, rest, Emit.seenE(cx, b, s))

def Emit.seenSs(cx: Emit.Cx, ss: Coll.List[El.Stmt], s: Emit.Seen): Emit.Seen = ss match
  case Coll.Nil => s
  case Coll.Cons(st, rest) => st match
    case El.Val(_, _, _, _, e) => Emit.seenSs(cx, rest, Emit.seenE(cx, e, s))
    case El.Handle(_, _, h, _, args) => Emit.seenSs(cx, rest, Emit.seenEs(cx, args, Emit.saw(cx, s, h)))
    case El.Do(e) => Emit.seenSs(cx, rest, Emit.seenE(cx, e, s))

// the program without the row binders eff.P of the static capabilities: a def drops them from its capabilities, and
// each call of a def drops the arguments at their positions (m: the defs before the drop)
def Emit.withStatics(cx: Emit.Cx, res: Ty.Result, st: Coll.List[Emit.Static]): Ty.Result = st match
  case Coll.Nil => res
  case Coll.Cons(_, _) =>
    val Ty.Result(cl, ins, s, fs, hs, gvs) = res
    val xs = Emit.staticNames(st)
    val Emit.Cx(_, m, _, _, _, _, _, _, _) = cx
    Ty.Result(cl, ins, s, Emit.dropFns(m, xs, true, fs), Emit.dropHs(m, xs, hs), Emit.dropGvs(m, xs, gvs))

def Emit.staticNames(st: Coll.List[Emit.Static]): Coll.List[Sym.Sym] = st match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) =>
    val Emit.Static(_, _, x) = s
    Coll.Cons(x, Emit.staticNames(rest))

def Emit.dropFns(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], isDef: Bool, fs: Coll.List[El.Fn]): Coll.List[El.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val El.Fn(line, n, tps, caps, ps, ret, body) = f
    val caps1 = if isDef then Emit.capsLess(caps, xs) else caps
    // a def that calls a def with a dropped eff.P passes it a P capability: its own eff.P (s2/eff.srs: needs(G, P)
    // and no handle of P in scope give row(F, P)), a written binder, or main's handle; any other def is kept as is
    val body1: El.Body = if isDef && !Emit.mayPass(caps, xs) && !Sym.eq(n, Sym.of("main")) then body else Emit.dropBody(m, xs, body)
    Coll.Cons(El.Fn(line, n, tps, caps1, ps, ret, body1), Emit.dropFns(m, xs, isDef, rest))

def Emit.dropBody(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], body: El.Body): El.Body = body match
  case El.Def(e) => El.Def(Emit.dropE(m, xs, e))
  case El.Extern(a, g) => El.Extern(a, g)

// caps has a dropped binder, or a written binder (a name that is not a row binder eff.X)
def Emit.mayPass(caps: Coll.List[Sym.Sym], xs: Coll.List[Sym.Sym]): Bool = caps match
  case Coll.Nil => false
  case Coll.Cons(c, rest) => if Ty.memberSym(c, xs) || !Emit.isRowName(Sym.str(c)) then true else Emit.mayPass(rest, xs)

// eff.X (101 e, 102 f, 46 .), the name Eff.capNames gives a row binder
def Emit.isRowName(s: Str): Bool = Str.len(s) > 4 && Str.at(s, 0) == 101 && Str.at(s, 1) == 102 && Str.at(s, 2) == 102 && Str.at(s, 3) == 46

def Emit.dropHs(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], hs: Coll.List[El.Handler]): Coll.List[El.Handler] = hs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(h, rest) =>
    val El.Handler(n, p, fs, shots) = h
    Coll.Cons(El.Handler(n, p, Emit.dropFns(m, xs, false, fs), shots), Emit.dropHs(m, xs, rest))

def Emit.dropGvs(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], gs: Coll.List[El.Given]): Coll.List[El.Given] = gs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(g, rest) =>
    val El.Given(tps, ev, head, fs) = g
    Coll.Cons(El.Given(tps, ev, head, Emit.dropFns(m, xs, false, fs)), Emit.dropGvs(m, xs, rest))

def Emit.capsLess(caps: Coll.List[Sym.Sym], xs: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = caps match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(c, rest) => if Ty.memberSym(c, xs) then Emit.capsLess(rest, xs) else Coll.Cons(c, Emit.capsLess(rest, xs))

// the caller's capabilities acs for the callee's binders pcs, without those at a dropped binder
def Emit.capsAt(pcs: Coll.List[Sym.Sym], acs: Coll.List[Sym.Sym], xs: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = pcs match
  case Coll.Nil => acs
  case Coll.Cons(pc, prest) => acs match
    case Coll.Nil => Coll.Nil
    case Coll.Cons(ac, arest) => if Ty.memberSym(pc, xs) then Emit.capsAt(prest, arest, xs) else Coll.Cons(ac, Emit.capsAt(prest, arest, xs))

def Emit.dropE(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], e: El.Expr): El.Expr = e match
  case El.CallFn(l, f, ts, caps, args) =>
    val caps1: Coll.List[Sym.Sym] = Coll.sLookup(m, f) match
      case Coll.Some(g) =>
        val El.Fn(_, _, _, pcs, _, _, _) = g
        Emit.capsAt(pcs, caps, xs)
      case Coll.None => caps
    El.CallFn(l, f, ts, caps1, Emit.dropEs(m, xs, args))
  case El.New(l, en, ts, c, at, args) => El.New(l, en, ts, c, at, Emit.dropEs(m, xs, args))
  case El.MHandled(l, x, h, caps, args, rest, a, ans) => El.MHandled(l, x, h, caps, Emit.dropEs(m, xs, args), Emit.dropE(m, xs, rest), a, ans)
  case El.Resume(l, k, x) => El.Resume(l, k, Emit.dropE(m, xs, x))
  case El.Op(l, recv, ty, op, args, cs) => El.Op(l, recv, ty, op, Emit.dropEs(m, xs, args), cs)
  case El.TCall(l, ty, op, caps, args) => El.TCall(l, ty, op, caps, Emit.dropEs(m, xs, args))
  case El.Bin(l, op, a, b) => El.Bin(l, op, Emit.dropE(m, xs, a), Emit.dropE(m, xs, b))
  case El.Un(l, op, x) => El.Un(l, op, Emit.dropE(m, xs, x))
  case El.If(l, c, t, x) => El.If(l, Emit.dropE(m, xs, c), Emit.dropE(m, xs, t), Emit.dropE(m, xs, x))
  case El.Match(l, x, en, arms) => El.Match(l, Emit.dropE(m, xs, x), en, Emit.dropArms(m, xs, arms))
  case El.Block(l, ss, last) => El.Block(l, Emit.dropSs(m, xs, ss), Emit.dropE(m, xs, last))
  case El.While(l, c, b) => El.While(l, Emit.dropE(m, xs, c), Emit.dropE(m, xs, b))
  case El.Assign(l, x, v) => El.Assign(l, x, Emit.dropE(m, xs, v))
  case El.Index(l, x, i) => El.Index(l, x, Emit.dropE(m, xs, i))
  case El.Slice(l, x, o) => El.Slice(l, Emit.dropE(m, xs, x), Emit.dropE(m, xs, o))
  case El.Fill(l, r, n, x, a) => El.Fill(l, r, Emit.dropE(m, xs, n), Emit.dropE(m, xs, x), a)
  case El.Tab(l, r, n, a, i, g) => El.Tab(l, r, Emit.dropE(m, xs, n), a, i, Emit.dropE(m, xs, g))
  case El.CellNew(l, r, v, a) => El.CellNew(l, r, Emit.dropE(m, xs, v), a)
  case El.CellGet(l, c) => El.CellGet(l, Emit.dropE(m, xs, c))
  case El.CNew(l, r, n) => El.CNew(l, r, n)
  case El.CField(l, c, n, f, t) => El.CField(l, Emit.dropE(m, xs, c), n, f, t)
  case El.CellPut(l, c, v) => El.CellPut(l, Emit.dropE(m, xs, c), Emit.dropE(m, xs, v))
  case El.ArrPut(l, x, i, v) => El.ArrPut(l, x, Emit.dropE(m, xs, i), Emit.dropE(m, xs, v))
  case El.Blit(l, x, a, b, k) => El.Blit(l, x, Emit.dropE(m, xs, a), Emit.dropE(m, xs, b), Emit.dropE(m, xs, k))
  case _ => e

def Emit.dropEs(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], es: Coll.List[El.Expr]): Coll.List[El.Expr] = es match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(x, rest) => Coll.Cons(Emit.dropE(m, xs, x), Emit.dropEs(m, xs, rest))

def Emit.dropArms(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], as: Coll.List[El.Arm]): Coll.List[El.Arm] = as match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(a, rest) =>
    val El.Arm(l, p, b) = a
    Coll.Cons(El.Arm(l, p, Emit.dropE(m, xs, b)), Emit.dropArms(m, xs, rest))

def Emit.dropSs(m: Coll.SMap[El.Fn], xs: Coll.List[Sym.Sym], ss: Coll.List[El.Stmt]): Coll.List[El.Stmt] = ss match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) =>
    val s1 = s match
      case El.Val(l, x, ty, mut, v) => El.Val(l, x, ty, mut, Emit.dropE(m, xs, v))
      case El.Handle(l, x, h, caps, args) => El.Handle(l, x, h, caps, Emit.dropEs(m, xs, args))
      case El.Do(v) => El.Do(Emit.dropE(m, xs, v))
    Coll.Cons(s1, Emit.dropSs(m, xs, rest))

// cx with the defs after the drop and the static capabilities (the declarations are the same)
def Emit.withFns(cx: Emit.Cx, fs: Coll.List[El.Fn], st: Coll.List[Emit.Static]): Emit.Cx = st match
  case Coll.Nil => cx
  case Coll.Cons(_, _) =>
    val Emit.Cx(s, _, cs, es, ps, hp, al, nm, _) = cx
    Emit.Cx(s, Emit.fnMap(fs, Coll.sEmpty()), cs, es, ps, hp, al, nm, st)

// the instance of each static capability: its vtable is fixed, main's handle fills its self
def Emit.staticCaps(st: Coll.List[Emit.Static]): Unit = st match
  case Coll.Nil => ()
  case Coll.Cons(s, rest) =>
    val Emit.Static(p, h, _) = s
    Console.print("static srs_cap s_eff__")
    Emit.id(p)
    Console.print(" = { 0, vt_")
    Emit.id(h)
    Console.print(", 1, 0, 0 };\nstatic srs_cap* const eff__")
    Emit.id(p)
    Console.print(" = &s_eff__")
    Emit.id(p)
    Console.print(";\n")
    Emit.staticCaps(rest)

// ── the program (spec sec 1): one C file to stdout ──
def Emit.program(ds: Coll.List[Ast.Decl], res0: Ty.Result): Unit =
  val Ty.Result(_, _, s, fs0, _, _) = res0
  val cx0 = Emit.cxOf(ds, s, fs0, Coll.Nil)
  val Ty.Result(_, _, _, fs00, _, gvs00) = res0
  val roots = Emit.roots(cx0, fs00, gvs00)
  val st = Emit.staticsOf(cx0, ds, res0, roots)
  val res = Emit.withStatics(cx0, res0, st)
  val Ty.Result(_, _, _, fs, hs, _) = res
  val cx = Emit.withFns(cx0, fs, st)
  val Emit.Seen(_, _, hn, cs, _) = Emit.reach(cx, hs, roots, Coll.sEmpty())
  val hsu = Emit.keepHs(hs, hn)
  val is = Mono.run(res)
  val ens = Emit.closeEnums(cx, Emit.instTys(cx, is, Emit.hfnTys(hs, Coll.Nil)), Coll.BTip, Coll.Nil)
  Console.print("// DO-NOT-EDIT. Generated by srs (s2/emit.srs).\n")
  Console.print("#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <string.h>\n")
  Emit.libcHeaders(fs, ds, cs)
  Emit.cstructChecks(cx, ds)
  Console.print("typedef struct { const uint8_t* p; int64_t n; } srs_str;\n")
  Emit.strPrims()
  Emit.wordPrims()
  Emit.ptrPrims(cs)
  // cur, end: the free bytes of an Arena capability's head chunk (Emit.allocFast); null until its first alloc, and
  // always null for other handlers
  Console.print("typedef struct srs_cap { void* self; void* const* vt; int64_t live; char* cur; char* end; } srs_cap;\n")
  Console.print("typedef struct { void* st; srs_cap* c[]; } srs_env;\n")
  Console.print("void rt_init(int argc, char** argv);\n")
  Emit.fwds(ens)
  Emit.structs(cx, ens)
  Emit.statics(cx, ens)
  Emit.externs(cx, fs, cs)
  Emit.protos(cx, is)
  Emit.handlers(cx, Emit.oneShot(hsu), Emit.Layout)
  Emit.vtables(cx, Emit.oneShot(hsu))
  Emit.staticCaps(st)
  val Emit.Cx(_, _, _, _, _, _, al, _, _) = cx
  al match
    case Emit.Inline => Emit.allocFast(cx)
    case Emit.VTable => ()
  Emit.cnewFns(cx, ds, cs)
  Emit.bodies(cx, hs, is)
  Emit.handlers(cx, Emit.oneShot(hsu), Emit.Code)
  if Emit.hasMain(cx) then Console.print("int main(int argc, char** argv) { rt_init(argc, argv); return (int)f_main(); }\n") else ()

// a def instance is f_<name><args>; a given method instance is named by its goal
def Emit.kindOf(i: Mono.Inst): Emit.Kind =
  val Mono.Inst(_, _, site) = i
  site match
    case Mono.Top => Emit.KDef
    case Mono.Impl(goal) => Emit.KGiven(goal)
