// s2 P6 FRONT (vic-m5r.27): the lexer. tokens and layout as s1/lex.srs (TNl, TIndent, TDedent): a deeper line opens an
// indent, a shallower one closes every indent above it, a newline inside ( or [ is not a token. a module member
// Upper.name is one identifier (vic 2026-11-06). an error is data (Lex.Bad), never an exit.

// a token and its line; an int carries its value
enum Lex.Tok:
  case Lex.TIdent(s: Str, line: I64)
  case Lex.TInt(v: I64, line: I64)
  case Lex.TStr(s: Str, line: I64)
  case Lex.TChar(s: Str, line: I64)
  case Lex.TOp(s: Str, line: I64)
  case Lex.TNl(line: I64)
  case Lex.TIndent(line: I64)
  case Lex.TDedent(line: I64)
  case Lex.TEof(line: I64)

// why a source does not lex
enum Lex.Why:
  case Lex.Tab
  case Lex.BadDedent
  case Lex.Unterminated
  case Lex.BadChar
  // a hex literal of 2^63 or more (an int token is an I64)
  case Lex.BigHex

enum Lex.Result:
  case Lex.Toks(ts: Coll.List[Lex.Tok])
  case Lex.Bad(line: I64, why: Lex.Why)

def Lex.isAlpha(c: I64): Bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
def Lex.isDigit(c: I64): Bool = c >= '0' && c <= '9'
def Lex.isPunct(c: I64): Bool =
  c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' || c == ',' || c == ':' || c == '=' || c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '<' || c == '>' || c == '!' || c == '.' || c == '^' || c == '@' || c == '&' || c == '|' || c == '~'
def Lex.isTwo(a: I64, b: I64): Bool =
  (a == '=' && b == '>') || (a == '=' && b == '=') || (a == '!' && b == '=') || (a == '<' && b == '=') || (a == '>' && b == '=') || (a == '&' && b == '&') || (a == '|' && b == '|') || (a == '~' && b == '>') || (a == '<' && b == '<') || (a == '>' && b == '>')

// the width of the operator token at i (c, then b): >>> is the one three-char operator
def Lex.opWidth(src: Str, i: I64, c: I64, b: I64): I64 =
  if c == '>' && b == '>' && Str.at(src, i + 2) == '>' then 3 else if Lex.isTwo(c, b) then 2 else 1

// a hex digit's value, or -1
def Lex.hexVal(c: I64): I64 =
  if Lex.isDigit(c) then c - '0' else if c >= 'a' && c <= 'f' then c - 'a' + 10 else if c >= 'A' && c <= 'F' then c - 'A' + 10 else -1

// the value of the hex digits from i, or -1 when it reaches 2^63 (v < 2^59 keeps v * 16 + 15 below 2^63: no overflow)
def Lex.hex(src: Str, i: I64, v: I64): I64 =
  val d = Lex.hexVal(Str.at(src, i))
  if d < 0 then v else if v >= 576460752303423488 then -1 else Lex.hex(src, i + 1, v * 16 + d)
def Lex.hexEnd(src: Str, i: I64): I64 = if Lex.hexVal(Str.at(src, i)) >= 0 then Lex.hexEnd(src, i + 1) else i

// the last token is a layout token (no TNl after it)
def Lex.layoutLast(out: Coll.List[Lex.Tok]): Bool = out match
  case Coll.Nil => true
  case Coll.Cons(t, _) => t match
    case Lex.TNl(_) => true
    case Lex.TIndent(_) => true
    case Lex.TDedent(_) => true
    case _ => false

// the end of a run of spaces from i
def Lex.spaces(src: Str, i: I64): I64 = if Str.at(src, i) == ' ' then Lex.spaces(src, i + 1) else i

// the end of a run of letters and digits from i
def Lex.word(src: Str, i: I64): I64 = if Lex.isAlpha(Str.at(src, i)) || Lex.isDigit(Str.at(src, i)) then Lex.word(src, i + 1) else i

// the end of an identifier that starts with an upper case letter: Upper(.name)*
def Lex.dotted(src: Str, i: I64): I64 =
  if Str.at(src, i) == '.' && Lex.isAlpha(Str.at(src, i + 1)) then Lex.dotted(src, Lex.word(src, i + 1)) else i

// the value of the digits from i (and where they end)
def Lex.digits(src: Str, i: I64, v: I64): I64 = if Lex.isDigit(Str.at(src, i)) then Lex.digits(src, i + 1, v * 10 + (Str.at(src, i) - '0')) else v
def Lex.digitsEnd(src: Str, i: I64): I64 = if Lex.isDigit(Str.at(src, i)) then Lex.digitsEnd(src, i + 1) else i

// the closing quote q of a literal from i (a backslash skips the next character), or the line end
def Lex.litEnd(src: Str, i: I64, n: I64, q: I64): I64 =
  if i >= n then i
  else if Str.at(src, i) == q || Str.at(src, i) == '\n' then i
  else if Str.at(src, i) == '\\' then Lex.litEnd(src, i + 2, n, q)
  else Lex.litEnd(src, i + 1, n, q)

// the end of a comment from i (the newline stays)
def Lex.lineEnd(src: Str, i: I64, n: I64): I64 = if i < n && Str.at(src, i) != '\n' then Lex.lineEnd(src, i + 1, n) else i

def Lex.top(ind: Coll.List[I64]): I64 = ind match
  case Coll.Nil => 0
  case Coll.Cons(c, _) => c

def Lex.lex(src: Str): Lex.Result = Lex.lexFrom(src, 1)

// src whose first line has number line (a file after others: its lines continue the numbering, so a line names a file)
def Lex.lexFrom(src: Str, line: I64): Lex.Result = Lex.go(src, Str.len(src), 0, line, 0, true, Coll.Cons(0, Coll.Nil), Coll.Nil)

// the scan from i: depth = open ( and [, bol = at the start of a line, ind = the indent stack, out = tokens, newest first
def Lex.go(src: Str, n: I64, i: I64, line: I64, depth: I64, bol: Bool, ind: Coll.List[I64], out: Coll.List[Lex.Tok]): Lex.Result =
  if i >= n then Lex.finish(line, ind, out)
  else if bol && depth == 0 then
    val j = Lex.spaces(src, i)
    val col = j - i
    val c = Str.at(src, j)
    if c == '\t' then Lex.Bad(line, Lex.Tab)
    else if c == -1 || c == '\n' || (c == '/' && Str.at(src, j + 1) == '/') then Lex.go(src, n, j, line, depth, false, ind, out)
    else if col > Lex.top(ind) then Lex.go(src, n, j, line, depth, false, Coll.Cons(col, ind), Coll.Cons(Lex.TIndent(line), out))
    else Lex.dedent(src, n, j, line, col, ind, out)
  else
    val c = Str.at(src, i)
    if c == '\n' then Lex.go(src, n, i + 1, line + 1, depth, true, ind, if depth == 0 && !Lex.layoutLast(out) then Coll.Cons(Lex.TNl(line), out) else out)
    else if c == ' ' || c == '\r' then Lex.go(src, n, i + 1, line, depth, bol, ind, out)
    else if c == '/' && Str.at(src, i + 1) == '/' then Lex.go(src, n, Lex.lineEnd(src, i, n), line, depth, bol, ind, out)
    else if Lex.isAlpha(c) then
      val e0 = Lex.word(src, i)
      val e = if c >= 'A' && c <= 'Z' then Lex.dotted(src, e0) else e0
      Lex.go(src, n, e, line, depth, bol, ind, Coll.Cons(Lex.TIdent(Str.slice(src, i, e), line), out))
    else if Lex.isDigit(c) then
      // 0x: a hex literal (tested only on a digit: the lexer's hot path stays as it was)
      if c == '0' && Str.at(src, i + 1) == 'x' && Lex.hexVal(Str.at(src, i + 2)) >= 0 then
        val v = Lex.hex(src, i + 2, 0)
        if v < 0 then Lex.Bad(line, Lex.BigHex) else Lex.go(src, n, Lex.hexEnd(src, i + 2), line, depth, bol, ind, Coll.Cons(Lex.TInt(v, line), out))
      else Lex.go(src, n, Lex.digitsEnd(src, i), line, depth, bol, ind, Coll.Cons(Lex.TInt(Lex.digits(src, i, 0), line), out))
    else if c == '"' || c == '\'' then
      val e = Lex.litEnd(src, i + 1, n, c)
      if Str.at(src, e) != c then Lex.Bad(line, Lex.Unterminated)
      else Lex.go(src, n, e + 1, line, depth, bol, ind, Coll.Cons(if c == '"' then Lex.TStr(Str.slice(src, i + 1, e), line) else Lex.TChar(Str.slice(src, i + 1, e), line), out))
    else
      val w = Lex.opWidth(src, i, c, Str.at(src, i + 1))
      if w == 1 && !Lex.isPunct(c) then Lex.Bad(line, Lex.BadChar)
      else
        val d = if c == '(' || c == '[' then depth + 1 else if (c == ')' || c == ']') && depth > 0 then depth - 1 else depth
        Lex.go(src, n, i + w, line, d, bol, ind, Coll.Cons(Lex.TOp(Str.slice(src, i, i + w), line), out))

// a line at column col, shallower than or as deep as the indent: close every deeper indent; col must be on the stack
def Lex.dedent(src: Str, n: I64, j: I64, line: I64, col: I64, ind: Coll.List[I64], out: Coll.List[Lex.Tok]): Lex.Result = ind match
  case Coll.Nil => Lex.Bad(line, Lex.BadDedent)
  case Coll.Cons(t, rest) =>
    if col < t then Lex.dedent(src, n, j, line, col, rest, Coll.Cons(Lex.TDedent(line), out))
    else if col == t then Lex.go(src, n, j, line, 0, false, ind, out)
    else Lex.Bad(line, Lex.BadDedent)

// the end: a last TNl, a TDedent for each open indent, TEof
def Lex.finish(line: I64, ind: Coll.List[I64], out: Coll.List[Lex.Tok]): Lex.Result =
  val out1: Coll.List[Lex.Tok] = out match
    case Coll.Nil => out
    case Coll.Cons(t, _) => t match
      case Lex.TNl(_) => out
      case Lex.TDedent(_) => out
      case _ => Coll.Cons(Lex.TNl(line), out)
  Lex.Toks(Lex.closeAll(line, ind, out1))

def Lex.closeAll(line: I64, ind: Coll.List[I64], out: Coll.List[Lex.Tok]): Coll.List[Lex.Tok] = ind match
  case Coll.Nil => Coll.rev(Coll.Cons(Lex.TEof(line), out))
  case Coll.Cons(t, rest) => if t > 0 then Lex.closeAll(line, rest, Coll.Cons(Lex.TDedent(line), out)) else Coll.rev(Coll.Cons(Lex.TEof(line), out))
