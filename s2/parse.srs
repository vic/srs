// s2 P6 FRONT (vic-m5r.27, vic/c/s2-front-spec.md): the parser, recursive descent over Lex tokens into the s2 Ast, as
// s1/parse.srs. each production returns Parse.Ok(value, rest) or Parse.Err(line, what was expected): an error is data.
// this rung: def, extern def, enum, protocol (states, start, end, drop, ops, rule defs), handler; binder groups
// [] {} <>; exit facts; types T[args]<caps>; every expression and statement s1 parses except forall/exists.

enum Parse.R [A: Type]:
  case Parse.Ok(v: A, ts: Coll.List[Lex.Tok])
  case Parse.Err(line: I64, want: Str)

// ── tokens ──
def Parse.eof(): Lex.Tok = Lex.TEof(0)

def Parse.peek(ts: Coll.List[Lex.Tok]): Lex.Tok = ts match
  case Coll.Nil => Parse.eof()
  case Coll.Cons(t, _) => t

def Parse.next(ts: Coll.List[Lex.Tok]): Coll.List[Lex.Tok] = ts match
  case Coll.Nil => ts
  case Coll.Cons(_, rest) => rest

def Parse.second(ts: Coll.List[Lex.Tok]): Lex.Tok = Parse.peek(Parse.next(ts))

def Parse.lineOf(t: Lex.Tok): I64 = t match
  case Lex.TIdent(_, l) => l
  case Lex.TInt(_, l) => l
  case Lex.TStr(_, l) => l
  case Lex.TChar(_, l) => l
  case Lex.TOp(_, l) => l
  case Lex.TLtGlued(l) => l
  case Lex.TNl(l) => l
  case Lex.TIndent(l) => l
  case Lex.TDedent(l) => l
  case Lex.TEof(l) => l

def Parse.line(ts: Coll.List[Lex.Tok]): I64 = Parse.lineOf(Parse.peek(ts))

def Parse.opIs(t: Lex.Tok, s: Str): Bool = t match
  case Lex.TOp(x, _) => Str.eq(x, s)
  case _ => false

def Parse.kwIs(t: Lex.Tok, s: Str): Bool = t match
  case Lex.TIdent(x, _) => Str.eq(x, s)
  case _ => false

def Parse.isOp(ts: Coll.List[Lex.Tok], s: Str): Bool = Parse.opIs(Parse.peek(ts), s)
def Parse.isKw(ts: Coll.List[Lex.Tok], s: Str): Bool = Parse.kwIs(Parse.peek(ts), s)

def Parse.isNl(ts: Coll.List[Lex.Tok]): Bool = Parse.peek(ts) match
  case Lex.TNl(_) => true
  case _ => false

def Parse.isIndent(ts: Coll.List[Lex.Tok]): Bool = Parse.peek(ts) match
  case Lex.TIndent(_) => true
  case _ => false

def Parse.isDedent(ts: Coll.List[Lex.Tok]): Bool = Parse.peek(ts) match
  case Lex.TDedent(_) => true
  case _ => false

// a < glued to the type before it: the start of a region list
def Parse.isGlued(ts: Coll.List[Lex.Tok]): Bool = Parse.peek(ts) match
  case Lex.TLtGlued(_) => true
  case _ => false

def Parse.isEof(ts: Coll.List[Lex.Tok]): Bool = Parse.peek(ts) match
  case Lex.TEof(_) => true
  case _ => false

def Parse.skipNl(ts: Coll.List[Lex.Tok]): Coll.List[Lex.Tok] = if Parse.isNl(ts) then Parse.skipNl(Parse.next(ts)) else ts

// the token after an op s, or Err
def Parse.op(ts: Coll.List[Lex.Tok], s: Str): Parse.R[I64] =
  if Parse.isOp(ts, s) then Parse.Ok(Parse.line(ts), Parse.next(ts)) else Parse.Err(Parse.line(ts), s)

def Parse.kw(ts: Coll.List[Lex.Tok], s: Str): Parse.R[I64] =
  if Parse.isKw(ts, s) then Parse.Ok(Parse.line(ts), Parse.next(ts)) else Parse.Err(Parse.line(ts), s)

def Parse.ident(ts: Coll.List[Lex.Tok]): Parse.R[Sym.Sym] = Parse.peek(ts) match
  case Lex.TIdent(x, _) => Parse.Ok(Sym.of(x), Parse.next(ts))
  case _ => Parse.Err(Parse.line(ts), "name")

// `:` NL IND: a layout block opens
def Parse.layoutOpen(ts: Coll.List[Lex.Tok]): Parse.R[I64] = Parse.op(ts, ":") match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(_, t1) =>
    if Parse.isNl(t1) && Parse.isIndent(Parse.next(t1)) then Parse.Ok(Parse.line(t1), Parse.next(Parse.next(t1))) else Parse.Err(Parse.line(t1), "indented block")

// the end of a line in a layout block: NL (consumed) or a DED that closes the block (left)
def Parse.endLine(ts: Coll.List[Lex.Tok]): Coll.List[Lex.Tok] = if Parse.isNl(ts) then Parse.next(ts) else ts

// ── the file ──
def Parse.file(ts: Coll.List[Lex.Tok]): Parse.R[Coll.List[Ast.Decl]] = Parse.decls(ts, Coll.Nil)

def Parse.decls(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Decl]): Parse.R[Coll.List[Ast.Decl]] =
  if Parse.isNl(ts) then Parse.decls(Parse.next(ts), acc)
  else if Parse.isEof(ts) then Parse.Ok(Coll.rev(acc), ts)
  else Parse.decl(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(d, t1) => Parse.decls(t1, Coll.Cons(d, acc))

def Parse.decl(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Decl] =
  if Parse.isKw(ts, "def") then Parse.wrapFn(Parse.fn(Parse.next(ts), Parse.line(ts), Parse.FDef))
  else if Parse.isKw(ts, "extern") then
    Parse.externAbi(Parse.next(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(abi, t0) => if Parse.isKw(t0, "struct") then Parse.cstruct(abi, Parse.line(ts), Parse.next(t0)) else if Parse.isKw(t0, "val") then Parse.wrapFn(Parse.libcVal(abi, Parse.line(ts), Parse.next(t0))) else Parse.kw(t0, "def") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t1) => Parse.wrapFn(Parse.libcName(abi, Parse.fn(t1, Parse.line(ts), Parse.FExtern(abi))))
  else if Parse.isKw(ts, "enum") then Parse.enumDecl(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "capability") then Parse.proto(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "handler") then Parse.handler(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "trait") then Parse.traitDecl(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "given") then Parse.givenDecl(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "type") then Parse.typeDecl(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "val") then Parse.topVal(Parse.valStmt(Parse.next(ts), Parse.line(ts), false))
  else Parse.Err(Parse.line(ts), "declaration")

// a top-level val x: T = e (vic 2026-11-09): a compile-time value, its type written; read as a nullary fn of body e
def Parse.topVal(rs: Parse.R[Ast.Stmt]): Parse.R[Ast.Decl] = rs match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(s, t1) => s match
    case Ast.Val(line, x, ann, e) => ann match
      case Coll.Some(ty) => Parse.Ok(Ast.DVal(Ast.Fn(line, x, Coll.Nil, Coll.Nil, ty, Coll.Nil, Ast.Def(Coll.Nil, e))), t1)
      case Coll.None => Parse.Err(line, "type of a top-level val (val x: T = e)")
    case _ => Parse.Err(Parse.line(t1), "top-level val")

// type Name groups [(value binders)] = body (s1/parse.srs:297-346)
def Parse.typeDecl(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Decl] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.groups(t1, Coll.Nil) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(gs, t2) =>
      val rv: Parse.R[Coll.List[Ast.Binder]] = if Parse.isOp(t2, "(") then Parse.params(t2) else Parse.Ok(Coll.Nil, t2)
      rv match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(vals, t3) => Parse.op(t3, "=") match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(_, t4) => Parse.typeBody(t4, vals) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(b, t5) => Parse.Ok(Ast.DType(Ast.TypeDecl(line, name, gs, vals, b)), t5)

// a value binder name followed by match: a value match; else a type, then match arms or not
def Parse.typeBody(ts: Coll.List[Lex.Tok], vals: Coll.List[Ast.Binder]): Parse.R[Ast.TBody] = Parse.peek(ts) match
  case Lex.TIdent(x, _) =>
    if Parse.kwIs(Parse.second(ts), "match") && Parse.binderNamed(vals, x) then
      Parse.armsOpen(Parse.next(Parse.next(ts))) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t1) => Parse.valArms(t1, Coll.Nil) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(as, t2) => Parse.Ok(Ast.ValMatch(Sym.of(x), as), t2)
    else Parse.tyBody(ts)
  case _ => Parse.tyBody(ts)

def Parse.binderNamed(bs: Coll.List[Ast.Binder], x: Str): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, n, _) = b
    if Str.eq(Sym.str(n), x) then true else Parse.binderNamed(rest, x)

def Parse.tyBody(ts: Coll.List[Lex.Tok]): Parse.R[Ast.TBody] = Parse.ty(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(t, t1) =>
    if Parse.isKw(t1, "match") then
      Parse.armsOpen(Parse.next(t1)) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t2) => Parse.tyArms(t2, Coll.Nil) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(as, t3) => Parse.Ok(Ast.TyMatch(t, as), t3)
    else Parse.Ok(Ast.Alias(t), t1)

// NL IND after match
def Parse.armsOpen(ts: Coll.List[Lex.Tok]): Parse.R[I64] =
  if Parse.isNl(ts) && Parse.isIndent(Parse.next(ts)) then Parse.Ok(Parse.line(ts), Parse.next(Parse.next(ts))) else Parse.Err(Parse.line(ts), "match arms")

def Parse.tyArms(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.TyArm]): Parse.R[Coll.List[Ast.TyArm]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.kw(ts, "case") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(line, t1) => Parse.ty(t1) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(p, t2) => Parse.op(t2, "=>") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t3) => Parse.ty(t3) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(res, t4) => Parse.tyArms(Parse.endLine(t4), Coll.Cons(Ast.TyArm(line, p, res), acc))

def Parse.valArms(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.ValArm]): Parse.R[Coll.List[Ast.ValArm]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.kw(ts, "case") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(line, t1) => Parse.valuePat(t1) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(p, t2) => Parse.op(t2, "=>") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t3) => Parse.ty(t3) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(res, t4) => Parse.valArms(Parse.endLine(t4), Coll.Cons(Ast.ValArm(line, p, res), acc))

// an int, a string, true, false or _
def Parse.valuePat(ts: Coll.List[Lex.Tok]): Parse.R[Ast.VPat] = Parse.peek(ts) match
  case Lex.TInt(v, _) => Parse.Ok(Ast.VInt(v), Parse.next(ts))
  case Lex.TStr(s, _) => Parse.Ok(Ast.VStr(s), Parse.next(ts))
  case Lex.TIdent(x, line) =>
    if Str.eq(x, "true") then Parse.Ok(Ast.VBool(true), Parse.next(ts))
    else if Str.eq(x, "false") then Parse.Ok(Ast.VBool(false), Parse.next(ts))
    else if Str.eq(x, "_") then Parse.Ok(Ast.VAny, Parse.next(ts))
    else Parse.Err(line, "a value pattern (int, string, true, false, _)")
  case _ => Parse.Err(Parse.line(ts), "a value pattern (int, string, true, false, _)")

// trait Name groups: NL IND (def signature, no body)* DED
def Parse.traitDecl(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Decl] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.groups(t1, Coll.Nil) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(gs, t2) => Parse.layoutOpen(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t3) => Parse.defs(t3, true, Coll.Nil) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(sigs, t4) => Parse.Ok(Ast.DTrait(Ast.Trait(line, name, gs, sigs)), t4)

// given groups Head[args]: NL IND (def ...)* DED
def Parse.givenDecl(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Decl] = Parse.groups(ts, Coll.Nil) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(gs, t1) => Parse.ty(t1) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(head, t2) => Parse.layoutOpen(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t3) => Parse.defs(t3, false, Coll.Nil) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(fs, t4) => Parse.Ok(Ast.DGiven(Ast.Given(line, gs, head, fs)), t4)

// defs until DED; sig = signatures only (a trait)
def Parse.defs(ts: Coll.List[Lex.Tok], sig: Bool, acc: Coll.List[Ast.Fn]): Parse.R[Coll.List[Ast.Fn]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.kw(ts, "def") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(line, t1) => Parse.fn(t1, line, if sig then Parse.FExtern(Ast.AbiSrs) else Parse.FDef) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(f, t2) => Parse.defs(Parse.endLine(t2), sig, Coll.Cons(f, acc))

// extern ["libc"] def: the ABI word after `extern`
def Parse.externAbi(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Abi] = Parse.peek(ts) match
  case Lex.TStr(s, l) =>
    if Str.eq(s, "libc") then Parse.Ok(Ast.AbiLibc, Parse.next(ts))
    else Parse.Err(l, "an extern ABI: write extern \"libc\" def or extern def")
  case _ => Parse.Ok(Ast.AbiSrs, ts)

// a libc extern names a C function: no `.` in its name
def Parse.libcName(abi: Ast.Abi, rf: Parse.R[Ast.Fn]): Parse.R[Ast.Fn] = rf match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(f, t) => abi match
    case Ast.AbiSrs => rf
    case Ast.AbiLibcVal => rf
    case Ast.AbiLibcPre => rf
    case _ =>
      val Ast.Fn(line, name, _, _, _, _, _) = f
      if Parse.hasDot(Sym.str(name), 0, Str.len(Sym.str(name))) then Parse.Err(line, "a libc extern names a C function: no '.' in its name") else rf

def Parse.hasDot(s: Str, i: I64, n: I64): Bool = if i == n then false else if Str.at(s, i) == 46 then true else Parse.hasDot(s, i + 1, n)

// extern "libc" struct name: an indented block of `field: I32|I64|U32|U64` lines; name is the C struct's tag (no `.`)
def Parse.cstruct(abi: Ast.Abi, line: I64, ts: Coll.List[Lex.Tok]): Parse.R[Ast.Decl] = abi match
  case Ast.AbiLibc => Parse.ident(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(name, t1) =>
      if Parse.hasDot(Sym.str(name), 0, Str.len(Sym.str(name))) then Parse.Err(line, "a libc struct names a C struct: no '.' in its name")
      else Parse.layoutOpen(t1) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t2) => Parse.cfields(t2, Coll.Nil) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(fs, t3) => Parse.Ok(Ast.DType(Ast.TypeDecl(line, name, Coll.Nil, Coll.Nil, Ast.CStruct(fs))), t3)
  case Ast.AbiLibcVar => Parse.Err(line, "a libc struct takes no `...`")
  case Ast.AbiLibcVal => Parse.Err(line, "a struct is declared only as extern \"libc\" struct name:")
  case Ast.AbiLibcPre => Parse.Err(line, "a struct is declared only as extern \"libc\" struct name:")
  case Ast.AbiSrs => Parse.Err(line, "a struct is declared only as extern \"libc\" struct name:")

def Parse.cfields(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.CField]): Parse.R[Coll.List[Ast.CField]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.ident(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(name, t1) => Parse.op(t1, ":") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.ty(t2) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(ty, t3) =>
          val Ast.Ty(_, tn, targs, _, _) = ty
          if Coll.length(targs) == 0 && Parse.cfieldTy(Sym.str(tn)) then Parse.cfields(Parse.endLine(t3), Coll.Cons(Ast.CField(Parse.line(ts), name, ty), acc))
          else Parse.Err(Parse.line(ts), "a libc struct field of type I32, I64, U32 or U64")

def Parse.cfieldTy(s: Str): Bool = Str.eq(s, "I32") || Str.eq(s, "I64") || Str.eq(s, "U32") || Str.eq(s, "U64")

// extern "libc" val NAME: T: a C constant or macro of type I32, I64 or U64, no `.` in its name
def Parse.libcVal(abi: Ast.Abi, line: I64, ts: Coll.List[Lex.Tok]): Parse.R[Ast.Fn] = abi match
  case Ast.AbiLibc => Parse.ident(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(name, t1) => Parse.op(t1, ":") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.ty(t2) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(ty, t3) =>
          val Ast.Ty(_, tn, targs, _, _) = ty
          if Parse.hasDot(Sym.str(name), 0, Str.len(Sym.str(name))) then Parse.Err(line, "a libc val names a C constant: no '.' in its name")
          else if Coll.length(targs) == 0 && Parse.libcValTy(Sym.str(tn)) then Parse.Ok(Ast.Fn(line, name, Coll.Nil, Coll.Nil, ty, Coll.Nil, Ast.Extern(Ast.AbiLibcVal)), t3)
          else Parse.Err(line, "a libc val of type I32, I64 or U64")
  case Ast.AbiSrs => Parse.Err(line, "a val is declared only as extern \"libc\" val NAME: I32")
  case Ast.AbiLibcVal => Parse.Err(line, "a val is declared only as extern \"libc\" val NAME: I32")
  case Ast.AbiLibcVar => Parse.Err(line, "a libc val takes no `...`")
  case Ast.AbiLibcPre => Parse.Err(line, "a val is declared only as extern \"libc\" val NAME: I32")

def Parse.libcValTy(s: Str): Bool = Str.eq(s, "I32") || Str.eq(s, "I64") || Str.eq(s, "U64")

// the ABI of an extern body; a def's body is replaced by Parse.bodyOf, its placeholder is the srs ABI
def Parse.abiOf(k: Parse.FnKind): Ast.Abi = k match
  case Parse.FExtern(abi) => abi
  case Parse.FDef => Ast.AbiSrs

def Parse.wrapFn(rf: Parse.R[Ast.Fn]): Parse.R[Ast.Decl] = rf match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(f, t1) => Parse.Ok(Ast.DFn(f), t1)

// which def: a def with a body, an extern def (or a trait method: no body)
enum Parse.FnKind:
  case Parse.FDef
  case Parse.FExtern(abi: Ast.Abi)

// the params of a def or extern, and whether they end in `...`: only a libc extern may (C variadics)
enum Parse.PS:
  case Parse.PS(ps: Coll.List[Ast.Binder], variadic: Bool)

def Parse.psOf(p: Parse.PS): Coll.List[Ast.Binder] = p match
  case Parse.PS(ps, _) => ps

def Parse.psVar(p: Parse.PS): Bool = p match
  case Parse.PS(_, va) => va

def Parse.fnParams(ts: Coll.List[Lex.Tok], k: Parse.FnKind): Parse.R[Parse.PS] = k match
  case Parse.FExtern(abi) => abi match
    case Ast.AbiLibc => Parse.op(ts, "(") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t1) => Parse.libcParams(t1, Coll.Nil)
    case _ => Parse.plainParams(ts)
  case Parse.FDef => Parse.plainParams(ts)

def Parse.plainParams(ts: Coll.List[Lex.Tok]): Parse.R[Parse.PS] = Parse.params(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(ps, t) => Parse.Ok(Parse.PS(ps, false), t)

// name: type, ... [, ...] ) : the `...` is three `.` tokens, last in the list
def Parse.libcParams(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Binder]): Parse.R[Parse.PS] =
  if Parse.isOp(ts, ")") then Parse.Ok(Parse.PS(Coll.rev(acc), false), Parse.next(ts))
  else if Parse.isOp(ts, ".") && Parse.isOp(Parse.next(ts), ".") && Parse.isOp(Parse.next(Parse.next(ts)), ".") then
    val t3 = Parse.next(Parse.next(Parse.next(ts)))
    if Parse.isOp(t3, ")") then Parse.Ok(Parse.PS(Coll.rev(acc), true), Parse.next(t3)) else Parse.Err(Parse.line(t3), ")")
  else Parse.ident(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(x, t1) => Parse.op(t1, ":") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.ty(t2) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(t, t3) =>
          val acc2 = Coll.Cons(Ast.Binder(Parse.line(ts), x, t), acc)
          if Parse.isOp(t3, ",") then Parse.libcParams(Parse.next(t3), acc2) else Parse.libcParams(t3, acc2)

// a libc extern ending in `...` is the variadic ABI
def Parse.abiVar(abi: Ast.Abi, va: Bool): Ast.Abi = if va then Ast.AbiLibcVar else abi

// def name groups (params) groups : ty [<atoms>] [= rhs]
def Parse.fn(ts: Coll.List[Lex.Tok], line: I64, k: Parse.FnKind): Parse.R[Ast.Fn] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.groups(t1, Coll.Nil) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(g1, t2) => Parse.fnParams(t2, k) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(pv, t3) => Parse.groups(t3, Coll.rev(g1)) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(gs, t4) => Parse.op(t4, ":") match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(_, t5) => Parse.ty(t5) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(ret, t6) => Parse.exitFacts(t6) match
              case Parse.Err(l, w) => Parse.Err(l, w)
              case Parse.Ok(exit, t7) => Parse.fnBody(t7, Ast.Fn(line, name, gs, Parse.psOf(pv), ret, exit, Ast.Extern(Parse.abiVar(Parse.abiOf(k), Parse.psVar(pv)))), k)

// the body of a def by its kind
def Parse.fnBody(ts: Coll.List[Lex.Tok], f: Ast.Fn, k: Parse.FnKind): Parse.R[Ast.Fn] = k match
  case Parse.FExtern(_) => Parse.Ok(f, ts)
  case Parse.FDef => Parse.bodyOf(ts, f)

// [NL IND clauses DED] = rhs (s1/parse.srs:88-89: the clauses sit between the signature and =)
def Parse.bodyOf(ts: Coll.List[Lex.Tok], f: Ast.Fn): Parse.R[Ast.Fn] =
  val Ast.Fn(line, name, gs, ps, ret, exit, _) = f
  val rc: Parse.R[Coll.List[Ast.Clause]] = if Parse.isNl(ts) && Parse.isIndent(Parse.next(ts)) then Parse.clauses(Parse.next(Parse.next(ts)), Coll.Nil) else Parse.Ok(Coll.Nil, ts)
  rc match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(cs, t0) => Parse.op(t0, "=") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t1) => Parse.rhs(t1) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(e, t2) => Parse.Ok(Ast.Fn(line, name, gs, ps, ret, exit, Ast.Def(cs, e)), t2)

// clauses until DED, one per line
def Parse.clauses(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Clause]): Parse.R[Coll.List[Ast.Clause]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.clause(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(c, t1) => Parse.clauses(Parse.endLine(t1), Coll.Cons(c, acc))

// requires|ensures|returns|decreases|invariant expr | proof using f, ... | proof by induction x | proof lean "..."
def Parse.clause(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Clause] =
  val line = Parse.line(ts)
  if Parse.isKw(ts, "proof") then Parse.proof(Parse.next(ts), line)
  else Parse.condOf(Parse.peek(ts)) match
    case Coll.None => Parse.Err(line, "requires, ensures, returns, decreases, invariant or proof")
    case Coll.Some(k) => Parse.expr(Parse.next(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(e, t1) => Parse.Ok(Ast.CondC(line, k, e), t1)

def Parse.condOf(t: Lex.Tok): Coll.Option[Ast.Cond] =
  if Parse.kwIs(t, "requires") then Coll.Some(Ast.Requires)
  else if Parse.kwIs(t, "ensures") then Coll.Some(Ast.Ensures)
  else if Parse.kwIs(t, "returns") then Coll.Some(Ast.Returns)
  else if Parse.kwIs(t, "decreases") then Coll.Some(Ast.Decreases)
  else if Parse.kwIs(t, "invariant") then Coll.Some(Ast.Invariant)
  else Coll.None

def Parse.proof(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Clause] =
  if Parse.isKw(ts, "using") then
    Parse.nameLine(Parse.next(ts), Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(xs, t1) => Parse.Ok(Ast.ProofUsing(line, xs), t1)
  else if Parse.isKw(ts, "by") then
    Parse.kw(Parse.next(ts), "induction") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t1) => Parse.ident(t1) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(x, t2) => Parse.Ok(Ast.ProofInduction(line, x), t2)
  else Parse.kw(ts, "lean") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t1) => Parse.peek(t1) match
      case Lex.TStr(s, _) => Parse.Ok(Ast.ProofLean(line, s), Parse.next(t1))
      case _ => Parse.Err(Parse.line(t1), "a string of Lean tactics")

// binder groups in written order: [binders] {binders} <atoms>; acc holds them reversed
def Parse.groups(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Group]): Parse.R[Coll.List[Ast.Group]] =
  if Parse.isOp(ts, "[") then Parse.moreGroups(Parse.binders(Parse.next(ts), "]", Coll.Nil), Parse.GTypes, acc)
  else if Parse.isOp(ts, "{") then Parse.moreGroups(Parse.binders(Parse.next(ts), "}", Coll.Nil), Parse.GEvidence, acc)
  else if Parse.isOp(ts, "<") then
    Parse.atoms(Parse.next(ts), Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(as, t1) => Parse.groups(t1, Coll.Cons(Ast.Facts(as), acc))
  else Parse.Ok(Coll.rev(acc), ts)

// which binder group: [] types or {} evidence
enum Parse.GKind:
  case Parse.GTypes
  case Parse.GEvidence

def Parse.moreGroups(rb: Parse.R[Coll.List[Ast.Binder]], kind: Parse.GKind, acc: Coll.List[Ast.Group]): Parse.R[Coll.List[Ast.Group]] = rb match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(bs, t1) => Parse.groups(t1, Coll.Cons(Parse.groupOf(kind, bs), acc))

def Parse.groupOf(k: Parse.GKind, bs: Coll.List[Ast.Binder]): Ast.Group = k match
  case Parse.GTypes => Ast.Types(bs)
  case Parse.GEvidence => Ast.Evidence(bs)

// name: ty, ... up to close; in {} a binder without a name is `_` (vic Q1: {Console} is {_: Console})
def Parse.binders(ts: Coll.List[Lex.Tok], close: Str, acc: Coll.List[Ast.Binder]): Parse.R[Coll.List[Ast.Binder]] =
  if Parse.isOp(ts, close) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else if Str.eq(close, "}") && !Parse.isOp(Parse.next(ts), ":") then Parse.binderTy(ts, Parse.line(ts), Sym.of("_"), close, acc)
  else Parse.ident(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(x, t1) => Parse.op(t1, ":") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.binderTy(t2, Parse.line(ts), x, close, acc)

def Parse.binderTy(ts: Coll.List[Lex.Tok], line: I64, x: Sym.Sym, close: Str, acc: Coll.List[Ast.Binder]): Parse.R[Coll.List[Ast.Binder]] = Parse.ty(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(t, t3) =>
    val acc2 = Coll.Cons(Ast.Binder(line, x, t), acc)
    if Parse.isOp(t3, ",") then Parse.binders(Parse.next(t3), close, acc2) else Parse.binders(t3, close, acc2)

def Parse.params(ts: Coll.List[Lex.Tok]): Parse.R[Coll.List[Ast.Binder]] = Parse.op(ts, "(") match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(_, t1) => Parse.binders(t1, ")", Coll.Nil)

// <a(x, y), b(z)> after the result type: the exit facts
def Parse.exitFacts(ts: Coll.List[Lex.Tok]): Parse.R[Coll.List[Ast.Atom]] =
  if Parse.isOp(ts, "<") then Parse.atoms(Parse.next(ts), Coll.Nil) else Parse.Ok(Coll.Nil, ts)

// rel(term, ...) , ... up to >
def Parse.atoms(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Atom]): Parse.R[Coll.List[Ast.Atom]] =
  if Parse.isOp(ts, ">") then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.atom(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(a, t1) => if Parse.isOp(t1, ",") then Parse.atoms(Parse.next(t1), Coll.Cons(a, acc)) else Parse.atoms(t1, Coll.Cons(a, acc))

// rel(terms); x: T is at(x, T); a r b is r(a, b) and a r is r(a) (vic 2026-11-09)
def Parse.atom(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Atom] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(a, t1) =>
    val line = Parse.line(ts)
    if Parse.isOp(t1, "(") then Parse.terms(Parse.next(t1), Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(xs, t3) => Parse.Ok(Ast.Atom(line, a, xs), t3)
    else if Parse.isOp(t1, ":") then Parse.ident(Parse.next(t1)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(s, t2) => Parse.Ok(Ast.Atom(line, Sym.of("at"), Coll.Cons(Ast.TName(a), Coll.Cons(Ast.TName(s), Coll.Nil))), t2)
    else Parse.ident(t1) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(r, t2) => Parse.peek(t2) match
        case Lex.TIdent(b, _) => Parse.Ok(Ast.Atom(line, r, Coll.Cons(Ast.TName(a), Coll.Cons(Ast.TName(Sym.of(b)), Coll.Nil))), Parse.next(t2))
        case _ => Parse.Ok(Ast.Atom(line, r, Coll.Cons(Ast.TName(a), Coll.Nil)), t2)

def Parse.terms(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Term]): Parse.R[Coll.List[Ast.Term]] =
  if Parse.isOp(ts, ")") then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else
    val tm: Parse.R[Ast.Term] = Parse.peek(ts) match
      case Lex.TInt(v, _) => Parse.Ok(Ast.TNum(v), Parse.next(ts))
      case Lex.TIdent(x, _) => Parse.Ok(Ast.TName(Sym.of(x)), Parse.next(ts))
      case _ => Parse.Err(Parse.line(ts), "term")
    tm match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(t, t1) => if Parse.isOp(t1, ",") then Parse.terms(Parse.next(t1), Coll.Cons(t, acc)) else Parse.terms(t1, Coll.Cons(t, acc))

// ty := name [ [ty, ...] ] [ (expr, ...) ] [<names>]: type args, compile-time value args, caps (a region list: a < glued to the type)
def Parse.ty(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Ty] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) =>
    val targs: Parse.R[Coll.List[Ast.Ty]] = if Parse.isOp(t1, "[") then Parse.tys(Parse.next(t1), "]", Coll.Nil) else Parse.Ok(Coll.Nil, t1)
    targs match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(args, t2) =>
        val tvals: Parse.R[Coll.List[Ast.Expr]] = if Parse.isOp(t2, "(") then Parse.args(t2) else Parse.Ok(Coll.Nil, t2)
        tvals match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(vals, t3) =>
            if Parse.isGlued(t3) then Parse.caps(Parse.line(ts), name, args, vals, Parse.next(t3))
            else if Parse.isOp(t3, "^") then Parse.Err(Parse.line(t3), "a region list: write T<r>, with the < glued to the type")
            else Parse.Ok(Ast.Ty(Parse.line(ts), name, args, Ast.Inferred, vals), t3)

// the names of a region list, after its <, up to > (the type's caps)
def Parse.caps(line: I64, name: Sym.Sym, args: Coll.List[Ast.Ty], vals: Coll.List[Ast.Expr], ts: Coll.List[Lex.Tok]): Parse.R[Ast.Ty] =
  Parse.names(ts, ">", Coll.Nil) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(cs, t1) => Parse.Ok(Ast.Ty(line, name, args, Ast.Stated(cs), vals), t1)

def Parse.tys(ts: Coll.List[Lex.Tok], close: Str, acc: Coll.List[Ast.Ty]): Parse.R[Coll.List[Ast.Ty]] =
  if Parse.isOp(ts, close) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.ty(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(t, t1) => if Parse.isOp(t1, ",") then Parse.tys(Parse.next(t1), close, Coll.Cons(t, acc)) else Parse.tys(t1, close, Coll.Cons(t, acc))

// names separated by commas up to close (close consumed)
def Parse.names(ts: Coll.List[Lex.Tok], close: Str, acc: Coll.List[Sym.Sym]): Parse.R[Coll.List[Sym.Sym]] =
  if Parse.isOp(ts, close) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.ident(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(x, t1) => if Parse.isOp(t1, ",") then Parse.names(Parse.next(t1), close, Coll.Cons(x, acc)) else Parse.names(t1, close, Coll.Cons(x, acc))

// names separated by commas to the end of a line (at least one)
def Parse.nameLine(ts: Coll.List[Lex.Tok], acc: Coll.List[Sym.Sym]): Parse.R[Coll.List[Sym.Sym]] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(x, t1) => if Parse.isOp(t1, ",") then Parse.nameLine(Parse.next(t1), Coll.Cons(x, acc)) else Parse.Ok(Coll.rev(Coll.Cons(x, acc)), t1)

// ── enum: enum Name groups: NL IND (case Name [(fields)] NL)* DED ──
def Parse.enumDecl(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Decl] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.groups(t1, Coll.Nil) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(gs, t2) => Parse.layoutOpen(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t3) => Parse.cases(t3, Coll.Nil) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(cs, t4) => Parse.Ok(Ast.DEnum(Ast.Enum(line, name, gs, cs)), t4)

def Parse.cases(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Case]): Parse.R[Coll.List[Ast.Case]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.kw(ts, "case") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(line, t1) => Parse.ident(t1) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(name, t2) =>
        if Parse.isOp(t2, "(") then
          Parse.params(t2) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(fs, t3) => Parse.cases(Parse.endLine(t3), Coll.Cons(Ast.Case(line, name, fs), acc))
        else Parse.cases(Parse.endLine(t2), Coll.Cons(Ast.Case(line, name, Coll.Nil), acc))

// ── capability (vic 2026-11-09): items until DED (state, start, stop, drop, transition, def,
// rule def). no state line: one state Live. a def's moves resolve to transitions once every item is read ──
enum Parse.Pr:
  case Parse.Pr(states: Coll.List[Sym.Sym], start: Sym.Sym, ends: Coll.List[Sym.Sym], drop: Coll.Option[Sym.Sym], ops: Coll.List[Parse.COp], rules: Coll.List[Ast.RuleDef], rels: Coll.List[Parse.Rel])

// transition r A -> B, ...: the pairs of relation r
enum Parse.Rel:
  case Parse.Rel(name: Sym.Sym, pairs: Coll.List[Ast.Trans])

// how a def moves its subject: <A> .. <B>, <s r t> .. <t>, or no facts (each state stays)
enum Parse.Moves:
  case Parse.Stay
  case Parse.Move(from: Sym.Sym, to: Sym.Sym)
  case Parse.ByRel(line: I64, rel: Sym.Sym)

enum Parse.COp:
  case Parse.COp(line: I64, name: Sym.Sym, groups: Coll.List[Ast.Group], params: Coll.List[Ast.Binder], ret: Ast.Ty, moves: Parse.Moves)

def Parse.proto(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Decl] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.layoutOpen(t1) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.items(t2, Parse.Pr(Coll.Nil, Sym.of(""), Coll.Nil, Coll.None, Coll.Nil, Coll.Nil, Coll.Nil)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(pr, t3) =>
        val Parse.Pr(ss0, st0, es0, dr, os, rs, rels) = pr
        val live = Coll.Cons(Sym.of("Live"), Coll.Nil)
        val ss: Coll.List[Sym.Sym] = ss0 match
          case Coll.Nil => live
          case Coll.Cons(_, _) => ss0
        val st = ss0 match
          case Coll.Nil => Sym.of("Live")
          case Coll.Cons(_, _) => st0
        val es: Coll.List[Sym.Sym] = ss0 match
          case Coll.Nil => live
          case Coll.Cons(_, _) => es0
        Parse.resolveOps(Coll.rev(os), ss, rels, Coll.Nil) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(aos, _) => Parse.Ok(Ast.DProto(Ast.Proto(line, name, ss, st, es, dr, aos, Coll.rev(rs))), t3)

def Parse.resolveOps(os: Coll.List[Parse.COp], ss: Coll.List[Sym.Sym], rels: Coll.List[Parse.Rel], acc: Coll.List[Ast.Op]): Parse.R[Coll.List[Ast.Op]] = os match
  case Coll.Nil => Parse.Ok(Coll.rev(acc), Coll.Nil)
  case Coll.Cons(o, rest) =>
    val Parse.COp(line, name, gs, ps, ret, mv) = o
    val rt: Parse.R[Coll.List[Ast.Trans]] = mv match
      case Parse.Stay => Parse.Ok(Parse.stays(ss), Coll.Nil)
      case Parse.Move(a, b) => Parse.Ok(Coll.Cons(Ast.Trans(a, b), Coll.Nil), Coll.Nil)
      case Parse.ByRel(l, r) => Parse.relPairs(rels, r) match
        case Coll.Some(trs) => Parse.Ok(trs, Coll.Nil)
        case Coll.None => Parse.Err(l, "a transition of this capability")
    rt match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(trs, _) => Parse.resolveOps(rest, ss, rels, Coll.Cons(Ast.Op(line, name, gs, ps, ret, trs), acc))

def Parse.stays(ss: Coll.List[Sym.Sym]): Coll.List[Ast.Trans] = ss match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(s, rest) => Coll.Cons(Ast.Trans(s, s), Parse.stays(rest))

def Parse.relPairs(rels: Coll.List[Parse.Rel], r: Sym.Sym): Coll.Option[Coll.List[Ast.Trans]] = rels match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Parse.Rel(n, prs) = x
    if Sym.eq(n, r) then Coll.Some(prs) else Parse.relPairs(rest, r)

def Parse.items(ts: Coll.List[Lex.Tok], pr: Parse.Pr): Parse.R[Parse.Pr] =
  val Parse.Pr(ss, st, es, dr, os, rs, rels) = pr
  if Parse.isDedent(ts) then Parse.Ok(pr, Parse.next(ts))
  else if Parse.isKw(ts, "state") then
    Parse.nameLine(Parse.next(ts), Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(xs, t1) => Parse.items(Parse.endLine(t1), Parse.Pr(xs, st, es, dr, os, rs, rels))
  else if Parse.isKw(ts, "start") then
    Parse.ident(Parse.next(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(x, t1) => Parse.items(Parse.endLine(t1), Parse.Pr(ss, x, es, dr, os, rs, rels))
  else if Parse.isKw(ts, "stop") then
    Parse.nameLine(Parse.next(ts), Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(xs, t1) => Parse.items(Parse.endLine(t1), Parse.Pr(ss, st, xs, dr, os, rs, rels))
  else if Parse.isKw(ts, "drop") then
    Parse.ident(Parse.next(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(x, t1) => Parse.items(Parse.endLine(t1), Parse.Pr(ss, st, es, Coll.Some(x), os, rs, rels))
  else if Parse.isKw(ts, "transition") then
    Parse.ident(Parse.next(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(r, t1) => Parse.trans(t1, Coll.Nil) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(prs, t2) => Parse.items(Parse.endLine(t2), Parse.Pr(ss, st, es, dr, os, rs, Coll.Cons(Parse.Rel(r, prs), rels)))
  else if Parse.isKw(ts, "def") then
    Parse.capDef(Parse.next(ts), Parse.line(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(o, t1) => Parse.items(Parse.endLine(t1), Parse.Pr(ss, st, es, dr, Coll.Cons(o, os), rs, rels))
  else if Parse.isKw(ts, "rule") then
    Parse.kw(Parse.next(ts), "def") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t1) => Parse.ruleDecl(t1, Parse.line(ts)) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(rd, t2) => Parse.items(Parse.endLine(t2), Parse.Pr(ss, st, es, dr, os, Coll.Cons(rd, rs), rels))
  else Parse.Err(Parse.line(ts), "capability item")

// the groups and params of a capability op: def name [<entry>] {groups} (params) [{groups}], as a def's signature
enum Parse.CS:
  case Parse.CS(gs: Coll.List[Ast.Group], ps: Coll.List[Ast.Binder])

def Parse.csGroups(c: Parse.CS): Coll.List[Ast.Group] = c match
  case Parse.CS(gs, _) => gs

def Parse.csParams(c: Parse.CS): Coll.List[Ast.Binder] = c match
  case Parse.CS(_, ps) => ps

def Parse.capSig(ts: Coll.List[Lex.Tok]): Parse.R[Parse.CS] = Parse.groups(ts, Coll.Nil) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(g1, t1) => Parse.params(t1) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(ps, t2) => Parse.groups(t2, Coll.rev(g1)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(gs, t3) => Parse.Ok(Parse.CS(gs, ps), t3)

// def name [<A> | <s r t>] (params): ty [<B> | <t>] in a capability
def Parse.capDef(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Parse.COp] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.entry(t1) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(en, t2) => Parse.capSig(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(cs, t3) => Parse.op(t3, ":") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t4) => Parse.opRet(t4) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(ret, t5) => Parse.exitState(t5) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(ex, t6) => Parse.moves(line, en, ex) match
              case Parse.Err(l, w) => Parse.Err(l, w)
              case Parse.Ok(mv, _) => Parse.Ok(Parse.COp(line, name, Parse.csGroups(cs), Parse.csParams(cs), ret, mv), t6)

// an op result: ty, or ty{names} (the receiver takes the type's {} binders: View{self}); a type with <...> takes no {}
def Parse.opRet(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Ty] = Parse.ty(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(t, t1) =>
    if Parse.isOp(t1, "{") then
      val Ast.Ty(l, n, args, caps, vals) = t
      caps match
        case Ast.Inferred => Parse.names(Parse.next(t1), "}", Coll.Nil) match
          case Parse.Err(l2, w) => Parse.Err(l2, w)
          case Parse.Ok(cs, t2) => Parse.Ok(Ast.Ty(l, n, args, Ast.Chosen(cs), vals), t2)
        case _ => Parse.Err(Parse.line(t1), "an exit state <B> (a type with <...> takes no {...})")
    else Parse.Ok(t, t1)

// the entry facts of a capability def: none, <A> (a state), or <s r t> (s moves to t by relation r)
enum Parse.Entry:
  case Parse.ENone
  case Parse.EState(s: Sym.Sym)
  case Parse.ERel(s: Sym.Sym, r: Sym.Sym, t: Sym.Sym)

def Parse.entry(ts: Coll.List[Lex.Tok]): Parse.R[Parse.Entry] =
  if Parse.isOp(ts, "<") then Parse.ident(Parse.next(ts)) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(a, t1) =>
      if Parse.isOp(t1, ">") then Parse.Ok(Parse.EState(a), Parse.next(t1))
      else Parse.ident(t1) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(r, t2) => Parse.ident(t2) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(b, t3) => Parse.op(t3, ">") match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(_, t4) => Parse.Ok(Parse.ERel(a, r, b), t4)
  else Parse.Ok(Parse.ENone, ts)

def Parse.exitState(ts: Coll.List[Lex.Tok]): Parse.R[Coll.Option[Sym.Sym]] =
  if Parse.isOp(ts, "<") then Parse.ident(Parse.next(ts)) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(b, t1) => Parse.op(t1, ">") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.Ok(Coll.Some(b), t2)
  else Parse.Ok(Coll.None, ts)

// <A> .. <B> moves A to B; <s r t> .. <t> moves by r (the exit is the relation's target); no facts: each state stays
def Parse.moves(line: I64, en: Parse.Entry, ex: Coll.Option[Sym.Sym]): Parse.R[Parse.Moves] = en match
  case Parse.ENone => ex match
    case Coll.None => Parse.Ok(Parse.Stay, Coll.Nil)
    case Coll.Some(_) => Parse.Err(line, "an entry state <A> for the exit state")
  case Parse.EState(a) => ex match
    case Coll.Some(b) => Parse.Ok(Parse.Move(a, b), Coll.Nil)
    case Coll.None => Parse.Err(line, "an exit state <B>")
  case Parse.ERel(_, r, t) => ex match
    case Coll.Some(b) => if Sym.eq(b, t) then Parse.Ok(Parse.ByRel(line, r), Coll.Nil) else Parse.Err(line, "the exit <t> of <s r t>")
    case Coll.None => Parse.Err(line, "the exit <t> of <s r t>")


def Parse.trans(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Trans]): Parse.R[Coll.List[Ast.Trans]] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(a, t1) => Parse.op(t1, "-") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.op(t2, ">") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t3) => Parse.ident(t3) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(b, t4) =>
          val acc2 = Coll.Cons(Ast.Trans(a, b), acc)
          if Parse.isOp(t4, ",") then Parse.trans(Parse.next(t4), acc2) else Parse.Ok(Coll.rev(acc2), t4)

// rule def name(params) = atom, ...
def Parse.ruleDecl(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.RuleDef] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.op(t1, "(") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.names(t2, ")", Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(ps, t3) => Parse.op(t3, "=") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t4) => Parse.ruleBody(t4, Coll.Nil) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(as, t5) => Parse.Ok(Ast.RuleDef(line, name, ps, as), t5)

def Parse.ruleBody(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Atom]): Parse.R[Coll.List[Ast.Atom]] = Parse.atom(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(a, t1) => if Parse.isOp(t1, ",") then Parse.ruleBody(Parse.next(t1), Coll.Cons(a, acc)) else Parse.Ok(Coll.rev(Coll.Cons(a, acc)), t1)

// ── handler: handler Name for Proto: NL IND (def ...)* DED ──
// handler H [A: Type] for P: the [A: Type] binder (the handled block's type) makes it multi-shot (vic-hm63 Q-M3)
def Parse.handler(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Decl] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(name, t1) => Parse.answer(t1) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(ans, t1b) => Parse.kw(t1b, "for") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.ident(t2) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(proto, t3) => Parse.layoutOpen(t3) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(_, t4) => Parse.hdefs(t4, Coll.Nil, Coll.Nil) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(hd, t5) =>
              val Parse.HDefs(fs, ks) = hd
              val shots: Ast.Shots = ans match
                case Coll.None => Ast.OneShot
                case Coll.Some(a) => Ast.MultiShot(a, ks)
              // the block type A is a [] binder of every fn of the handler, as a given's binders are its fns'
              val fs2: Coll.List[Ast.Fn] = ans match
                case Coll.None => fs
                case Coll.Some(a) => Parse.withTypeBinder(fs, Ast.Binder(line, a, Ast.Ty(line, Sym.of("Type"), Coll.Nil, Ast.Inferred, Coll.Nil)))
              Parse.Ok(Ast.DHandler(Ast.Handler(line, name, proto, Parse.stateless(fs2, line), shots)), t5)

def Parse.withTypeBinder(fs: Coll.List[Ast.Fn], b: Ast.Binder): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val Ast.Fn(l, n, gs, ps, ret, exit, body) = f
    Coll.Cons(Ast.Fn(l, n, Coll.Cons(Ast.Types(Coll.Cons(b, Coll.Nil)), gs), ps, ret, exit, body), Parse.withTypeBinder(rest, b))

def Parse.answer(ts: Coll.List[Lex.Tok]): Parse.R[Coll.Option[Sym.Sym]] =
  if Parse.isOp(ts, "[") then Parse.ident(Parse.next(ts)) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(a, t1) => Parse.op(t1, ":") match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(_, t2) => Parse.kw(t2, "Type") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t3) => Parse.op(t3, "]") match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(_, t4) => Parse.Ok(Coll.Some(a), t4)
  else Parse.Ok(Coll.None, ts)

enum Parse.HDefs:
  case Parse.HDefs(fs: Coll.List[Ast.Fn], ks: Coll.List[Ast.KOp])

// a handler's defs; def op(k, params): an untyped first param is the op's continuation (vic-hm63 Q-M1)
def Parse.hdefs(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Fn], ks: Coll.List[Ast.KOp]): Parse.R[Parse.HDefs] =
  if Parse.isDedent(ts) then Parse.Ok(Parse.HDefs(Coll.rev(acc), Coll.rev(ks)), Parse.next(ts))
  else Parse.kw(ts, "def") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(line, t1) =>
      val kp: Parse.KParam = Parse.kParam(t1)
      val Parse.KParam(k, t1b) = kp
      Parse.fn(t1b, line, Parse.FDef) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(f, t2) =>
          val Ast.Fn(_, n, _, _, _, _, _) = f
          val ks2: Coll.List[Ast.KOp] = k match
            case Coll.None => ks
            case Coll.Some(x) => Coll.Cons(Ast.KOp(n, x), ks)
          Parse.hdefs(Parse.endLine(t2), Coll.Cons(f, acc), ks2)

// name ( k , ...  or  name ( k ): the k, and the tokens without it (name ( ...)
enum Parse.KParam:
  case Parse.KParam(k: Coll.Option[Sym.Sym], ts: Coll.List[Lex.Tok])

def Parse.kParam(ts: Coll.List[Lex.Tok]): Parse.KParam = ts match
  case Coll.Nil => Parse.KParam(Coll.None, ts)
  case Coll.Cons(nameTok, t1) => t1 match
    case Coll.Nil => Parse.KParam(Coll.None, ts)
    case Coll.Cons(paren, t2) =>
      val t3 = Parse.next(t2)
      val bare = Parse.isOp(t1, "(") && (Parse.isOp(t3, ",") || Parse.isOp(t3, ")"))
      val kn: Coll.Option[Sym.Sym] = Parse.peek(t2) match
        case Lex.TIdent(x, _) => if bare then Coll.Some(Sym.of(x)) else Coll.None
        case _ => Coll.None
      kn match
        case Coll.None => Parse.KParam(Coll.None, ts)
        case Coll.Some(_) =>
          val rest = if Parse.isOp(t3, ",") then Parse.next(t3) else t3
          Parse.KParam(kn, Coll.Cons(nameTok, Coll.Cons(paren, rest)))

// a handler with no init keeps no state (E5, vic 2026-11-09: `handler Srs.Console for Console: def print(s: Str): Unit =
// ...`): it reads as init(): Ptr = Srs.noState() and a leading self: Ptr on each op, the shape every later phase knows
def Parse.stateless(fs: Coll.List[Ast.Fn], line: I64): Coll.List[Ast.Fn] =
  if Parse.hasInit(fs) then fs
  else
    val ptr = Ast.Ty(line, Sym.of("Ptr"), Coll.Nil, Ast.Inferred, Coll.Nil)
    val init = Ast.Fn(line, Sym.of("init"), Coll.Nil, Coll.Nil, ptr, Coll.Nil, Ast.Def(Coll.Nil, Ast.Call(line, Sym.of("Srs.noState"), Coll.Nil, Coll.Nil, Coll.Nil)))
    Coll.Cons(init, Parse.withSelf(fs, ptr))

def Parse.hasInit(fs: Coll.List[Ast.Fn]): Bool = fs match
  case Coll.Nil => false
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, n, _, _, _, _, _) = f
    if Str.eq(Sym.str(n), "init") then true else Parse.hasInit(rest)

def Parse.withSelf(fs: Coll.List[Ast.Fn], ptr: Ast.Ty): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val Ast.Fn(l, n, gs, ps, ret, exit, body) = f
    Coll.Cons(Ast.Fn(l, n, gs, Coll.Cons(Ast.Binder(l, Sym.of("self"), ptr), ps), ret, exit, body), Parse.withSelf(rest, ptr))

// ── bodies: rhs := NL IND block | expr ──
def Parse.rhs(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Expr] =
  if Parse.isNl(ts) && Parse.isIndent(Parse.next(ts)) then Parse.block(Parse.next(Parse.next(ts)), Parse.line(Parse.next(ts)))
  else Parse.expr(ts)

// a block: statements until DED (a NL between them is optional); its value is the last statement when it is an
// expression, else Unit. val C(a, b) = e takes the rest of the block as the body of a one-arm match
def Parse.block(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Expr] = Parse.stmts(ts, line, Coll.Nil)

def Parse.stmts(ts: Coll.List[Lex.Tok], line: I64, acc: Coll.List[Ast.Stmt]): Parse.R[Ast.Expr] =
  val t0 = Parse.skipNl(ts)
  if Parse.isDedent(t0) then Parse.Ok(Parse.blockOf(line, acc), Parse.next(t0))
  else if Parse.isKw(t0, "val") && Parse.isPatVal(Parse.next(t0)) then Parse.patVal(Parse.next(t0), Parse.line(t0), line, acc)
  else Parse.stmt(t0) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(s, t1) => Parse.stmts(t1, line, Coll.Cons(s, acc))

// the block of the statements acc (reversed): a last expression statement is the value
def Parse.blockOf(line: I64, acc: Coll.List[Ast.Stmt]): Ast.Expr = acc match
  case Coll.Nil => Ast.Block(line, Coll.Nil, Ast.Unit(line))
  case Coll.Cons(s, rest) => s match
    case Ast.Do(e) => Ast.Block(line, Coll.rev(rest), e)
    case _ => Ast.Block(line, Coll.rev(acc), Ast.Unit(line))

// val Upper(...) = e: the name starts with an upper case letter and ( follows
def Parse.isPatVal(ts: Coll.List[Lex.Tok]): Bool = Parse.peek(ts) match
  case Lex.TIdent(x, _) => Str.at(x, 0) >= 'A' && Str.at(x, 0) <= 'Z' && Parse.opIs(Parse.second(ts), "(")
  case _ => false

def Parse.patVal(ts: Coll.List[Lex.Tok], vline: I64, line: I64, acc: Coll.List[Ast.Stmt]): Parse.R[Ast.Expr] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(c, t1) => Parse.op(t1, "(") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.names(t2, ")", Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(bs, t3) => if Parse.nestedPat(bs) then Parse.Err(vline, "a nested pattern is not supported: bind it, then match: case W.W1(e) => e match ...") else Parse.op(t3, "=") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t4) => Parse.rhs(t4) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(e, t5) => Parse.stmts(t5, vline, Coll.Nil) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(body, t6) =>
              val m = Ast.Match(vline, e, Coll.Cons(Ast.Arm(vline, Ast.PCase(c, bs), body), Coll.Nil))
              Parse.Ok(Parse.blockOf(line, Coll.Cons(Ast.Do(m), acc)), t6)

def Parse.stmt(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Stmt] =
  if Parse.isKw(ts, "val") || Parse.isKw(ts, "var") then Parse.valStmt(Parse.next(ts), Parse.line(ts), Parse.isKw(ts, "var"))
  else if Parse.isKw(ts, "handle") then Parse.handleStmt(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "invariant") || Parse.isKw(ts, "decreases") then
    Parse.expr(Parse.next(ts)) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(e, t1) => Parse.Ok(Ast.Check(Parse.line(ts), if Parse.isKw(ts, "invariant") then Ast.LInvariant else Ast.LDecreases, e), t1)
  else Parse.expr(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(e, t1) => Parse.Ok(Ast.Do(e), t1)

// val x [: ty] = rhs
def Parse.valStmt(ts: Coll.List[Lex.Tok], line: I64, isVar: Bool): Parse.R[Ast.Stmt] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(x, t1) =>
    val ann: Parse.R[Coll.Option[Ast.Ty]] = if Parse.isOp(t1, ":") then Parse.someTy(Parse.ty(Parse.next(t1))) else Parse.Ok(Coll.None, t1)
    ann match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(a, t2) => Parse.op(t2, "=") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t3) => Parse.rhs(t3) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(e, t4) => Parse.Ok(if isVar then Ast.Var(line, x, a, e) else Ast.Val(line, x, a, e), t4)

def Parse.someTy(rt: Parse.R[Ast.Ty]): Parse.R[Coll.Option[Ast.Ty]] = rt match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(t, t1) => Parse.Ok(Coll.Some(t), t1)

// handle x = H(args)
def Parse.handleStmt(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Stmt] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(x, t1) => Parse.op(t1, "=") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.ident(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(h, t3) => Parse.args(t3) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(xs, t4) => Parse.Ok(Ast.Handle(line, x, h, xs), t4)

// ── expressions ──
def Parse.expr(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Expr] =
  if Parse.isKw(ts, "if") then Parse.ifExpr(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "while") then Parse.whileExpr(Parse.next(ts), Parse.line(ts))
  else if Parse.isKw(ts, "forall") || Parse.isKw(ts, "exists") then Parse.quant(Parse.next(ts), Parse.line(ts), if Parse.isKw(ts, "forall") then Ast.Forall else Ast.Exists)
  else Parse.peek(ts) match
    case Lex.TIdent(x, line) =>
      if Parse.opIs(Parse.second(ts), "=") then
        Parse.rhs(Parse.next(Parse.next(ts))) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(e, t1) => Parse.Ok(Ast.Assign(line, Sym.of(x), e), t1)
      else Parse.matchOf(Parse.binary(ts, 0))
    case _ => Parse.matchOf(Parse.binary(ts, 0))

// forall x: ty => expr, exists x: ty => expr (s1/parse.srs:544-548)
def Parse.quant(ts: Coll.List[Lex.Tok], line: I64, q: Ast.Q): Parse.R[Ast.Expr] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(x, t1) => Parse.op(t1, ":") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.ty(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(t, t3) => Parse.op(t3, "=>") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t4) => Parse.expr(t4) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(b, t5) => Parse.Ok(Ast.Quant(line, q, x, t, b), t5)

// e match NL IND (case pat => rhs)* DED: match is postfix on a whole binary expression
def Parse.matchOf(re: Parse.R[Ast.Expr]): Parse.R[Ast.Expr] = re match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(e, t1) =>
    if Parse.isKw(t1, "match") then
      val t2 = Parse.next(t1)
      if Parse.isNl(t2) && Parse.isIndent(Parse.next(t2)) then
        Parse.arms(Parse.next(Parse.next(t2)), Coll.Nil) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(as, t3) => Parse.Ok(Ast.Match(Parse.line(t1), e, as), t3)
      else Parse.Err(Parse.line(t2), "match arms")
    else re

def Parse.arms(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Arm]): Parse.R[Coll.List[Ast.Arm]] =
  if Parse.isDedent(ts) then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.kw(ts, "case") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(line, t1) => Parse.pat(t1) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(p, t2) => Parse.op(t2, "=>") match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(_, t3) => Parse.rhs(t3) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(b, t4) => Parse.arms(Parse.endLine(t4), Coll.Cons(Ast.Arm(line, p, b), acc))

// a ctor pattern's sub-patterns are binders (names): a dotted name is a nested pattern, which is not supported
def Parse.nestedPat(bs: Coll.List[Sym.Sym]): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(x, rest) => Parse.dottedName(Sym.str(x), 0, Str.len(Sym.str(x))) || Parse.nestedPat(rest)

def Parse.dottedName(s: Str, i: I64, n: I64): Bool = if i == n then false else if Str.at(s, i) == 46 then true else Parse.dottedName(s, i + 1, n)

// _ | Name [(names)]
def Parse.pat(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Pat] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(c, t1) =>
    if Str.eq(Sym.str(c), "_") then Parse.Ok(Ast.PAny, t1)
    else if Parse.isOp(t1, "(") then
      Parse.names(Parse.next(t1), ")", Coll.Nil) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(bs, t2) => if Parse.nestedPat(bs) then Parse.Err(Parse.line(ts), "a nested pattern is not supported: bind it, then match: case W.W1(e) => e match ...") else Parse.Ok(Ast.PCase(c, bs), t2)
    else Parse.Ok(Ast.PCase(c, Coll.Nil), t1)

// if c then rhs [NL] else rhs
def Parse.ifExpr(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Expr] = Parse.expr(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(c, t1) => Parse.kw(t1, "then") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.rhs(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(t, t3) =>
        val t4 = if Parse.isNl(t3) && Parse.kwIs(Parse.second(t3), "else") then Parse.next(t3) else t3
        Parse.kw(t4, "else") match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(_, t5) => Parse.rhs(t5) match
            case Parse.Err(l, w) => Parse.Err(l, w)
            case Parse.Ok(e, t6) => Parse.Ok(Ast.If(line, c, t, e), t6)

// while c do rhs
def Parse.whileExpr(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Expr] = Parse.expr(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(c, t1) => Parse.kw(t1, "do") match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(_, t2) => Parse.rhs(t2) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(b, t3) => Parse.Ok(Ast.While(line, c, b), t3)

// the binary operator of a token and its level (lowest first), or None (s1/parse.srs:593 opLevel)
enum Parse.BinTok:
  case Parse.BinTok(op: Ast.BinOp, level: I64)

def Parse.binOf(t: Lex.Tok): Coll.Option[Parse.BinTok] = t match
  case Lex.TOp(s, _) =>
    if Str.eq(s, "||") then Coll.Some(Parse.BinTok(Ast.Or, 0))
    else if Str.eq(s, "|") then Coll.Some(Parse.BinTok(Ast.BitOr, 0))
    else if Str.eq(s, "^") then Coll.Some(Parse.BinTok(Ast.BitXor, 1))
    else if Str.eq(s, "&&") then Coll.Some(Parse.BinTok(Ast.And, 2))
    else if Str.eq(s, "&") then Coll.Some(Parse.BinTok(Ast.BitAnd, 2))
    else if Str.eq(s, "==") then Coll.Some(Parse.BinTok(Ast.Eq, 3))
    else if Str.eq(s, "!=") then Coll.Some(Parse.BinTok(Ast.Ne, 3))
    else if Str.eq(s, "<") then Coll.Some(Parse.BinTok(Ast.Lt, 4))
    else if Str.eq(s, "<=") then Coll.Some(Parse.BinTok(Ast.Le, 4))
    else if Str.eq(s, ">") then Coll.Some(Parse.BinTok(Ast.Gt, 4))
    else if Str.eq(s, ">=") then Coll.Some(Parse.BinTok(Ast.Ge, 4))
    else if Str.eq(s, "<<") then Coll.Some(Parse.BinTok(Ast.Shl, 4))
    else if Str.eq(s, ">>") || Str.eq(s, ">>>") then Coll.Some(Parse.BinTok(Ast.Shr, 4))
    else if Str.eq(s, "+") then Coll.Some(Parse.BinTok(Ast.Add, 5))
    else if Str.eq(s, "-") then Coll.Some(Parse.BinTok(Ast.Sub, 5))
    else if Str.eq(s, "*") then Coll.Some(Parse.BinTok(Ast.Mul, 6))
    else if Str.eq(s, "/") then Coll.Some(Parse.BinTok(Ast.Div, 6))
    else if Str.eq(s, "%") then Coll.Some(Parse.BinTok(Ast.Mod, 6))
    else Coll.None
  case Lex.TLtGlued(_) => Coll.Some(Parse.BinTok(Ast.Lt, 4))
  case _ => Coll.None

// operators of level >= lvl, left associative
def Parse.binary(ts: Coll.List[Lex.Tok], lvl: I64): Parse.R[Ast.Expr] = Parse.unary(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(lhs, t1) => Parse.binLoop(lhs, t1, lvl)

def Parse.binLoop(lhs: Ast.Expr, ts: Coll.List[Lex.Tok], lvl: I64): Parse.R[Ast.Expr] = Parse.binOf(Parse.peek(ts)) match
  case Coll.None => Parse.Ok(lhs, ts)
  case Coll.Some(bt) =>
    val Parse.BinTok(op, l) = bt
    if l < lvl then Parse.Ok(lhs, ts)
    else Parse.binary(Parse.next(ts), l + 1) match
      case Parse.Err(el, w) => Parse.Err(el, w)
      case Parse.Ok(rhs, t2) => Parse.binLoop(Ast.Bin(Parse.line(ts), op, lhs, rhs), t2, lvl)

def Parse.unary(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Expr] =
  if Parse.isOp(ts, "-") then Parse.unOf(Parse.line(ts), Ast.Neg, Parse.unary(Parse.next(ts)))
  else if Parse.isOp(ts, "!") then Parse.unOf(Parse.line(ts), Ast.Not, Parse.unary(Parse.next(ts)))
  else if Parse.isOp(ts, "~") then Parse.unOf(Parse.line(ts), Ast.BitNot, Parse.unary(Parse.next(ts)))
  else Parse.primary(ts)

def Parse.unOf(line: I64, op: Ast.UnOp, re: Parse.R[Ast.Expr]): Parse.R[Ast.Expr] = re match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(e, t1) => Parse.Ok(Ast.Un(line, op, e), t1)

// the value of a char literal: one character, or a backslash escape (s1/parse.srs charValue)
def Parse.charValue(s: Str): I64 =
  if Str.len(s) == 1 then Str.at(s, 0)
  else
    val c = Str.at(s, 1)
    if c == 'n' then 10 else if c == 't' then 9 else if c == 'r' then 13 else if c == '0' then 0 else c

// resume k(v): exactly one value (vic-hm63 Q-M1)
def Parse.resume(ts: Coll.List[Lex.Tok], line: I64): Parse.R[Ast.Expr] = Parse.ident(ts) match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(k, t1) => Parse.args(t1) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(xs, t2) => xs match
      case Coll.Cons(x, rest) => if Coll.length(rest) == 0 then Parse.Ok(Ast.Resume(line, k, x), t2) else Parse.Err(line, "one value: resume k(v)")
      case Coll.Nil => Parse.Err(line, "one value: resume k(v)")

def Parse.primary(ts: Coll.List[Lex.Tok]): Parse.R[Ast.Expr] = Parse.peek(ts) match
  case Lex.TInt(v, line) => Parse.Ok(Ast.Int(line, v), Parse.next(ts))
  case Lex.TStr(s, line) => Parse.Ok(Ast.Str(line, s), Parse.next(ts))
  case Lex.TChar(s, line) => Parse.Ok(Ast.Int(line, Parse.charValue(s)), Parse.next(ts))
  case Lex.TIdent(x, line) =>
    val t1 = Parse.next(ts)
    if Str.eq(x, "true") then Parse.Ok(Ast.Bool(line, true), t1)
    else if Str.eq(x, "false") then Parse.Ok(Ast.Bool(line, false), t1)
    else if Str.eq(x, "resume") && !Parse.isOp(t1, "(") then Parse.resume(t1, line)
    else if Parse.isOp(t1, "(") then Parse.callOf(line, Sym.of(x), Coll.Nil, Coll.Nil, Parse.args(t1))
    else if Parse.isOp(t1, "[") || Parse.isOp(t1, "{") then Parse.callGroups(t1, line, Sym.of(x), Coll.Nil, Coll.Nil)
    else if Parse.isOp(t1, ".") then
      Parse.ident(Parse.next(t1)) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(op, t2) => Parse.args(t2) match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(xs, t3) => Parse.Ok(Ast.Method(line, Sym.of(x), op, xs), t3)
    else Parse.Ok(Ast.Name(line, Sym.of(x)), t1)
  case Lex.TOp(s, line) =>
    if Str.eq(s, "(") then
      val t1 = Parse.next(ts)
      if Parse.isOp(t1, ")") then Parse.Ok(Ast.Unit(line), Parse.next(t1))
      else Parse.expr(t1) match
        case Parse.Err(l, w) => Parse.Err(l, w)
        case Parse.Ok(e, t2) => Parse.op(t2, ")") match
          case Parse.Err(l, w) => Parse.Err(l, w)
          case Parse.Ok(_, t3) => Parse.Ok(e, t3)
    else Parse.Err(line, "expression")
  case _ => Parse.Err(Parse.line(ts), "expression")

// f[T, ...]{a, ...}(args): the groups in any order, then the args
def Parse.callGroups(ts: Coll.List[Lex.Tok], line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym]): Parse.R[Ast.Expr] =
  if Parse.isOp(ts, "[") then
    Parse.tys(Parse.next(ts), "]", Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(tys, t1) => Parse.callGroups(t1, line, f, Coll.revOnto(Coll.rev(targs), tys), chosen)
  else if Parse.isOp(ts, "{") then
    Parse.names(Parse.next(ts), "}", Coll.Nil) match
      case Parse.Err(l, w) => Parse.Err(l, w)
      case Parse.Ok(ns, t1) => Parse.callGroups(t1, line, f, targs, Coll.revOnto(Coll.rev(chosen), ns))
  else Parse.callOf(line, f, targs, chosen, Parse.args(ts))

def Parse.callOf(line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym], ra: Parse.R[Coll.List[Ast.Expr]]): Parse.R[Ast.Expr] = ra match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(xs, t1) => Parse.Ok(Ast.Call(line, f, targs, chosen, xs), t1)

// (expr, ...)
def Parse.args(ts: Coll.List[Lex.Tok]): Parse.R[Coll.List[Ast.Expr]] = Parse.op(ts, "(") match
  case Parse.Err(l, w) => Parse.Err(l, w)
  case Parse.Ok(_, t1) => Parse.exprs(t1, Coll.Nil)

def Parse.exprs(ts: Coll.List[Lex.Tok], acc: Coll.List[Ast.Expr]): Parse.R[Coll.List[Ast.Expr]] =
  if Parse.isOp(ts, ")") then Parse.Ok(Coll.rev(acc), Parse.next(ts))
  else Parse.expr(ts) match
    case Parse.Err(l, w) => Parse.Err(l, w)
    case Parse.Ok(e, t1) => if Parse.isOp(t1, ",") then Parse.exprs(Parse.next(t1), Coll.Cons(e, acc)) else Parse.exprs(t1, Coll.Cons(e, acc))

// a source: lex, then parse; a lex error is a parse error at its line
def Parse.source(src: Str): Parse.R[Coll.List[Ast.Decl]] = Parse.sourceFrom(src, 1)

// src whose first line has number line (Lex.lexFrom)
def Parse.sourceFrom(src: Str, line: I64): Parse.R[Coll.List[Ast.Decl]] = Lex.lexFrom(src, line) match
  case Lex.Bad(l, _) => Parse.Err(l, "lexable source")
  case Lex.Toks(ts) => Parse.file(ts)
