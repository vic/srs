// s2 B3 (vic/c/bits-blake3-design.md): BLAKE3 (O'Connor, Aumasson, Neves, Wilcox-O'Hearn 2020) in pure srs, one thread,
// no SIMD: the 32-byte hash of a Str's bytes. a chunk is 1 KiB of 64-byte blocks, each block one compression of 7
// rounds of G (unrolled: no allocation inside a block); chunks join in a left-full binary tree of parent nodes.
// oracle: tests/s2/b3.srs, the official test vectors

// a hash or a chaining value: 8 words; its bytes are each word little-endian, h0 first
enum B3.Hash:
  case B3.Hash(h0: U32, h1: U32, h2: U32, h3: U32, h4: U32, h5: U32, h6: U32, h7: U32)

// the IV (the SHA-256 IV): the key of an unkeyed hash
def B3.iv(): B3.Hash = B3.Hash(0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19)

