  val t433 = t405 + t416 + m3
  val t434 = U32.rotr(t398 ^ t433, 16)
  val t435 = t391 + t434
  val t436 = U32.rotr(t416 ^ t435, 12)
  val t437 = t433 + t436 + m4
  val t438 = U32.rotr(t434 ^ t437, 8)
  val t439 = t435 + t438
  val t440 = U32.rotr(t436 ^ t439, 7)
  val t441 = t413 + t392 + m7
  val t442 = U32.rotr(t406 ^ t441, 16)
  val t443 = t399 + t442
  val t444 = U32.rotr(t392 ^ t443, 12)
  val t445 = t441 + t444 + m13
  val t446 = U32.rotr(t442 ^ t445, 8)
  val t447 = t443 + t446
  val t448 = U32.rotr(t444 ^ t447, 7)
  B3.Hash(t421 ^ t439, t429 ^ t447, t437 ^ t423, t445 ^ t431, t448 ^ t430, t424 ^ t438, t432 ^ t446, t440 ^ t422)

// the byte at i as a word, 0 at or after e (the zero padding of a last block)
def B3.byte(s: Str, i: I64, e: I64): U32 = if i < e then U32.of(Str.at(s, i)) else 0

// the little-endian word at i
def B3.word(s: Str, i: I64, e: I64): U32 =
  if i + 4 <= e then Str.u32le(s, i)
  else B3.byte(s, i, e) | B3.byte(s, i + 1, e) << 8 | B3.byte(s, i + 2, e) << 16 | B3.byte(s, i + 3, e) << 24

// the block of s at b (the chunk ends at e)
def B3.block(cv: B3.Hash, s: Str, b: I64, e: I64, counter: U64, flags: U32): B3.Hash =
  val blen = if e - b < 64 then e - b else 64
  B3.compress(cv, B3.word(s, b, e), B3.word(s, b + 4, e), B3.word(s, b + 8, e), B3.word(s, b + 12, e), B3.word(s, b + 16, e), B3.word(s, b + 20, e), B3.word(s, b + 24, e), B3.word(s, b + 28, e), B3.word(s, b + 32, e), B3.word(s, b + 36, e), B3.word(s, b + 40, e), B3.word(s, b + 44, e), B3.word(s, b + 48, e), B3.word(s, b + 52, e), B3.word(s, b + 56, e), B3.word(s, b + 60, e), counter, blen, flags)

// the blocks of a chunk from b to e (at least one: the empty input is one empty block). flags: CHUNK_START 1 on
// the first, CHUNK_END 2 on the last, ROOT 8 on the last when the chunk is the whole tree
def B3.blocks(cv: B3.Hash, s: Str, b: I64, e: I64, counter: U64, first: U32, root: Bool): B3.Hash =
  val last = b + 64 >= e
  val flags = first | (if last then 2 else 0) | (if last && root then 8 else 0)
  val h = B3.block(cv, s, b, e, counter, flags)
  if last then h else B3.blocks(h, s, b + 64, e, counter, 0, root)

// the largest power of 2 that is at most n (n >= 1), from p
def B3.pow2(n: I64, p: I64): I64 = if p * 2 <= n then B3.pow2(n, p * 2) else p

// the subtree of the len bytes of s at off, whose first chunk is number c: one chunk, or a parent of a left subtree
// of the most chunks that are a power of 2 and leave at least one byte to the right (spec 2.1)
def B3.tree(s: Str, off: I64, len: I64, c: I64, root: Bool): B3.Hash =
  if len <= 1024 then B3.blocks(B3.iv(), s, off, off + len, U64.ofI64(c), 1, root)
  else
    val k = 1024 * B3.pow2((len - 1) / 1024, 1)
    val l = B3.tree(s, off, k, c, false)
    val r = B3.tree(s, off + k, len - k, c + k / 1024, false)
    B3.parent(l, r, root)

// a parent node: one block of the two children's chaining values, counter 0, PARENT 4 (and ROOT 8 at the top)
def B3.parent(l: B3.Hash, r: B3.Hash, root: Bool): B3.Hash =
  val B3.Hash(l0, l1, l2, l3, l4, l5, l6, l7) = l
  val B3.Hash(r0, r1, r2, r3, r4, r5, r6, r7) = r
  B3.compress(B3.iv(), l0, l1, l2, l3, l4, l5, l6, l7, r0, r1, r2, r3, r4, r5, r6, r7, 0, 64, if root then 12 else 4)

// the hash of the bytes of s
def B3.hash(s: Str): B3.Hash = B3.tree(s, 0, Str.len(s), 0, true)

// the hash as 64 lowercase hex digits, the bytes in order
def B3.printHex(h: B3.Hash): Unit =
  val B3.Hash(h0, h1, h2, h3, h4, h5, h6, h7) = h
  B3.hexWord(h0)
  B3.hexWord(h1)
  B3.hexWord(h2)
  B3.hexWord(h3)
  B3.hexWord(h4)
  B3.hexWord(h5)
  B3.hexWord(h6)
  B3.hexWord(h7)

// a word's 4 bytes, low byte first, two hex digits each
def B3.hexWord(w: U32): Unit =
  B3.hexByte(w)
  B3.hexByte(w >> 8)
  B3.hexByte(w >> 16)
  B3.hexByte(w >> 24)

def B3.hexByte(w: U32): Unit =
  B3.hexDigit(I64.of((w >> 4) & 15))
  B3.hexDigit(I64.of(w & 15))

def B3.hexDigit(d: I64): Unit = Console.printChar(if d < 10 then '0' + d else 'a' + d - 10)
