// s2 component 6: Datalog core: positive rules, semi-naive evaluation by round stamps (egglog): a relation keeps one
// set (dedup) and one index per probed column for all rounds; each row carries the round that derived it, and every
// bucket lists rows newest first, so in round r a body atom reads rows of round r-1 (recent: a bucket prefix), older
// rows (stable) or both, and each derivation is found once (atoms before the recent one read stable rows, after it
// both). each tuple is inserted once; a round ends by moving two counters. relations are compiled to integer ids;
// an atom reads the bucket of its first bound column; rounds are tail calls.
enum D.Val:
  case D.VSym(s: Sym.Sym)
  case D.VInt(v: I64)

enum D.Arg:
  case D.AVar(n: I64)
  case D.AVal(v: D.Val)

enum D.Atom:
  case D.Atom(rel: Sym.Sym, args: Coll.List[D.Arg])

// a body literal: an atom that must hold, or one that must not (stratified negation)
enum D.Lit:
  case D.Pos(a: D.Atom)
  case D.Neg(a: D.Atom)

// head :- body
enum D.Rule:
  case D.Rule(head: D.Atom, body: Coll.List[D.Lit])

enum D.Fact:
  case D.Fact(rel: Sym.Sym, vals: Coll.List[D.Val])

// hashing (no xor or shift on I64): h * D.mult() + x modulo the prime D.modulus(); every product stays below 2^63
// (h < 1e9+7, 31 * h < 2^35). a tuple's hash starts at D.seed()
def D.modulus(): I64 = 1000000007
def D.mult(): I64 = 31
def D.seed(): I64 = 7

def D.vhash(v: D.Val): I64 = v match
  case D.VSym(s) => Sym.hash(s)
  case D.VInt(n) => (n % D.modulus() + D.modulus()) % D.modulus()

def D.veq(a: D.Val, b: D.Val): Bool = a match
  case D.VSym(x) => b match
    case D.VSym(y) => Sym.eq(x, y)
    case D.VInt(_) => false
  case D.VInt(m) => b match
    case D.VInt(n) => m == n
    case D.VSym(_) => false

def D.tupleEq(a: Coll.List[D.Val], b: Coll.List[D.Val]): Bool = a match
  case Coll.Nil => b match
    case Coll.Nil => true
    case Coll.Cons(_, _) => false
  case Coll.Cons(x, xt) => b match
    case Coll.Nil => false
    case Coll.Cons(y, yt) => if D.veq(x, y) then D.tupleEq(xt, yt) else false

def D.thash(t: Coll.List[D.Val], h: I64): I64 = t match
  case Coll.Nil => h
  case Coll.Cons(v, rest) => D.thash(rest, (h * D.mult() + D.vhash(v)) % D.modulus())

def D.tupleHash(t: Coll.List[D.Val]): I64 = D.thash(t, D.seed())

// ── a relation: rows by tuple hash (dedup), by value hash for each probed column (ic), and all rows (scans); each list
// newest first. recent = rows of the last round, fresh = rows of this round ──
// a row and how it came to be (provenance, zhao-2020): an input fact (no round: it is older than every round), or a
// row made in round at by a compiled rule, which every row it makes shares. with the round stamp (a valid proof
// height: round r reads only older rows) D.why rebuilds a proof
enum D.Row:
  case D.Input(t: Coll.List[D.Val])
  case D.Made(at: I64, rule: D.CRule, t: Coll.List[D.Val])

def D.tupleOf(row: D.Row): Coll.List[D.Val] = row match
  case D.Input(t) => t
  case D.Made(_, _, t) => t

def D.stampOf(row: D.Row): I64 = row match
  case D.Input(_) => D.inputRound()
  case D.Made(at, _, _) => at

enum D.Rel:
  case D.Rel(ic: Coll.List[I64], set: Coll.BTree[Coll.List[D.Row]], cols: Coll.BTree[Coll.BTree[Coll.List[D.Row]]], all: Coll.List[D.Row], recent: I64, fresh: I64)

def D.newRel(ic: Coll.List[I64]): D.Rel = D.Rel(ic, Coll.BTip, Coll.BTip, Coll.Nil, 0, 0)

def D.bucket(m: Coll.BTree[Coll.List[D.Row]], h: I64): Coll.List[D.Row] = Coll.bTGetOr(m, h, Coll.Nil)

def D.inRows(rows: Coll.List[D.Row], t: Coll.List[D.Val]): Bool = rows match
  case Coll.Nil => false
  case Coll.Cons(row, rest) =>
    val u = D.tupleOf(row)
    if D.tupleEq(u, t) then true else D.inRows(rest, t)

def D.has(rl: D.Rel, t: Coll.List[D.Val]): Bool =
  val D.Rel(_, set, _, _, _, _) = rl
  D.inRows(D.bucket(set, D.tupleHash(t)), t)

// the values of t from column c on (no allocation): Nil when t has no column c
def D.from(t: Coll.List[D.Val], c: I64): Coll.List[D.Val] =
  if c == 0 then t
  else t match
    case Coll.Nil => Coll.Nil
    case Coll.Cons(_, rest) => D.from(rest, c - 1)

// row added under each column of ic; a tuple without column c is not under c (no atom that probes c matches it)
def D.indexCols(cols: Coll.BTree[Coll.BTree[Coll.List[D.Row]]], row: D.Row, t: Coll.List[D.Val], ic: Coll.List[I64]): Coll.BTree[Coll.BTree[Coll.List[D.Row]]] = ic match
  case Coll.Nil => cols
  case Coll.Cons(c, rest) => D.from(t, c) match
    case Coll.Nil => D.indexCols(cols, row, t, rest)
    case Coll.Cons(v, _) =>
      val n = Coll.bFind(cols, c)
      val col = Coll.bPushT(Coll.bValOr(n, c, Coll.BTip), D.vhash(v), row)
      D.indexCols(if Coll.bIsNode(n) then Coll.bRep(cols, c, col) else Coll.bIns(cols, c, col), row, t, rest)

// rl with row added, None when rl has its tuple already: one hash and one find serve the test and the insert
def D.addNew(rl: D.Rel, row: D.Row): Coll.Option[D.Rel] =
  val D.Rel(ic, set, cols, all, rc, fr) = rl
  val t = D.tupleOf(row)
  val h = D.tupleHash(t)
  val n = Coll.bFind(set, h)
  val b = Coll.bValOr(n, h, Coll.Nil)
  if D.inRows(b, t) then Coll.None
  else
    Coll.Some(D.Rel(ic, if Coll.bIsNode(n) then Coll.bRep(set, h, Coll.Cons(row, b)) else Coll.bIns(set, h, Coll.Cons(row, Coll.Nil)), D.indexCols(cols, row, t, ic), Coll.Cons(row, all), rc, fr + 1))

// the rows an atom may match under a probe (a superset: the match checks values)
def D.cands(rl: D.Rel, p: D.Probe): Coll.List[D.Row] =
  val D.Rel(_, _, cols, all, _, _) = rl
  p match
    case D.Scan => all
    // no index on c: every row (in D.solve this means no rows yet; D.why binds the head first, so it can probe a
    // column that the solve never probes)
    case D.Col(c, h) =>
      val n = Coll.bFind(cols, c)
      if Coll.bIsNode(n) then D.bucket(Coll.bValOr(n, c, Coll.BTip), h) else all

// which rows an atom reads in round r: recent (round r-1), stable (older) or both; never rows of round r
enum D.Use:
  case D.Stable
  case D.Recent
  case D.Full

// ── rules compiled: relation names to ids (a program's relations, found once) ──
// a relation: its id and its name, made once when the name is first seen (D.internId) and shared by every atom of it,
// so an atom's id and name can not disagree, and a result that names a relation needs no lookup
enum D.RelRef:
  case D.RelRef(id: I64, name: Sym.Sym)

enum D.CAtom:
  case D.CAtom(rel: D.RelRef, args: Coll.List[D.Arg])

// a compiled rule: the positive atoms in order, the negated ones (filters once the positives bound every variable);
// id = its position in the list given to D.solve, the name a proof shows; its join plans (below)
enum D.CRule:
  case D.CRule(head: D.CAtom, body: Coll.List[D.CAtom], neg: Coll.List[D.CAtom], id: I64, plans: Coll.List[D.Plan])

// a join plan (semi-naive, as Souffle): for a body atom whose relation a rule derives, that atom first reading only
// the recent rows, so its few new rows bind the variables the others probe; then the other atoms in written order,
// those before it reading stable rows, those after it all older rows. each atom reads the same rows as in written
// order, so the derivations are the same; only the work changes. made once per rule: no position index exists
enum D.Plan:
  case D.Plan(first: D.CAtom, rest: Coll.List[D.Step])

enum D.Step:
  case D.ReadOld(a: D.CAtom)
  case D.ReadAll(a: D.CAtom)

// a rule with its atoms compiled, before its plans (they need every head of the program)
enum D.Draft:
  case D.Draft(head: D.CAtom, body: Coll.List[D.CAtom], neg: Coll.List[D.CAtom], id: I64)

// a value made while the name table grows
enum D.With [A: Type]:
  case D.With(tab: Coll.List[D.RelRef], v: A)

def D.refOf(tab: Coll.List[D.RelRef], s: Sym.Sym): Coll.Option[D.RelRef] = tab match
  case Coll.Nil => Coll.None
  case Coll.Cons(h, t) =>
    val D.RelRef(_, name) = h
    if Sym.eq(name, s) then Coll.Some(h) else D.refOf(t, s)

// the relation named s; a new name gets the next id and goes at the end of tab
def D.internId(tab: Coll.List[D.RelRef], s: Sym.Sym): D.With[D.RelRef] = D.refOf(tab, s) match
  case Coll.Some(ref) => D.With(tab, ref)
  case Coll.None =>
    val ref = D.RelRef(Coll.length(tab), s)
    D.With(Coll.rev(Coll.Cons(ref, Coll.rev(tab))), ref)

def D.idOfRef(ref: D.RelRef): I64 =
  val D.RelRef(id, _) = ref
  id

def D.nameOfRef(ref: D.RelRef): Sym.Sym =
  val D.RelRef(_, name) = ref
  name

def D.catom(tab: Coll.List[D.RelRef], a: D.Atom): D.With[D.CAtom] =
  val D.Atom(rel, args) = a
  val D.With(tab2, ref) = D.internId(tab, rel)
  D.With(tab2, D.CAtom(ref, args))

enum D.Body:
  case D.Body(pos: Coll.List[D.CAtom], neg: Coll.List[D.CAtom])

// the literals compiled in written order (so names get their ids in that order): the positive atoms, the negated ones
def D.cbody(tab: Coll.List[D.RelRef], ls: Coll.List[D.Lit], pos: Coll.List[D.CAtom], neg: Coll.List[D.CAtom]): D.With[D.Body] = ls match
  case Coll.Nil => D.With(tab, D.Body(Coll.rev(pos), Coll.rev(neg)))
  case Coll.Cons(l, rest) => l match
    case D.Pos(a) =>
      val D.With(tab2, ca) = D.catom(tab, a)
      D.cbody(tab2, rest, Coll.Cons(ca, pos), neg)
    case D.Neg(a) =>
      val D.With(tab2, ca) = D.catom(tab, a)
      D.cbody(tab2, rest, pos, Coll.Cons(ca, neg))

// rule i of rs has id i: its position in the list given to D.solve; the head's name gets its id first
def D.drafts(tab: Coll.List[D.RelRef], rs: Coll.List[D.Rule], i: I64, acc: Coll.List[D.Draft]): D.With[Coll.List[D.Draft]] = rs match
  case Coll.Nil => D.With(tab, Coll.rev(acc))
  case Coll.Cons(rl, rest) =>
    val D.Rule(h, b) = rl
    val D.With(tab2, ch) = D.catom(tab, h)
    val D.With(tab3, bd) = D.cbody(tab2, b, Coll.Nil, Coll.Nil)
    val D.Body(pos, neg) = bd
    D.drafts(tab3, rest, i + 1, Coll.Cons(D.Draft(ch, pos, neg, i), acc))

def D.headIds(ds: Coll.List[D.Draft], acc: Coll.List[I64]): Coll.List[I64] = ds match
  case Coll.Nil => acc
  case Coll.Cons(d, rest) =>
    val D.Draft(h, _, _, _) = d
    val D.CAtom(ref, _) = h
    D.headIds(rest, Coll.Cons(D.idOfRef(ref), acc))

// each draft with its plans: one per body atom whose relation is a head (an input relation has recent rows only
// before the first pass, which reads in written order, so a plan for it would never run)
def D.crules(ds: Coll.List[D.Draft], heads: Coll.List[I64], acc: Coll.List[D.CRule]): Coll.List[D.CRule] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, rest) =>
    val D.Draft(h, body, neg, i) = d
    D.crules(rest, heads, Coll.Cons(D.CRule(h, body, neg, i, D.plans(body, body, heads, 0, Coll.Nil)), acc))

// the plans for the atoms of xs (xs = the suffix of body from position j)
def D.plans(body: Coll.List[D.CAtom], xs: Coll.List[D.CAtom], heads: Coll.List[I64], j: I64, acc: Coll.List[D.Plan]): Coll.List[D.Plan] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(a, rest) =>
    val D.CAtom(ref, _) = a
    if D.memberI(D.idOfRef(ref), heads) then
      D.plans(body, rest, heads, j + 1, Coll.Cons(D.Plan(a, D.steps(body, j, 0, Coll.Nil)), acc))
    else D.plans(body, rest, heads, j + 1, acc)

// the other atoms of body around position j, in written order
def D.steps(body: Coll.List[D.CAtom], j: I64, i: I64, acc: Coll.List[D.Step]): Coll.List[D.Step] = body match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(a, rest) =>
    if i < j then D.steps(rest, j, i + 1, Coll.Cons(D.ReadOld(a), acc))
    else if i == j then D.steps(rest, j, i + 1, acc)
    else D.steps(rest, j, i + 1, Coll.Cons(D.ReadAll(a), acc))

// ── joins ──
enum D.Bound:
  case D.Unbound
  case D.Is(v: D.Val)

def D.argVal(env: Coll.List[D.Bind], a: D.Arg): D.Bound = a match
  case D.AVal(v) => D.Is(v)
  case D.AVar(n) => D.envGet(env, n)

// how an atom finds its candidates under env: the bucket of its first bound column, else a scan
enum D.Probe:
  case D.Scan
  case D.Col(c: I64, h: I64)

def D.probe(env: Coll.List[D.Bind], args: Coll.List[D.Arg], c: I64): D.Probe = args match
  case Coll.Nil => D.Scan
  case Coll.Cons(a, rest) => D.argVal(env, a) match
    case D.Is(v) => D.Col(c, D.vhash(v))
    case D.Unbound => D.probe(env, rest, c + 1)

// env extended so args match t, or None
def D.matchT(env: Coll.List[D.Bind], args: Coll.List[D.Arg], t: Coll.List[D.Val]): Coll.Option[Coll.List[D.Bind]] = args match
  case Coll.Nil => Coll.Some(env)
  case Coll.Cons(a, rest) => t match
    case Coll.Nil => Coll.None
    case Coll.Cons(v, tr) => a match
      case D.AVal(w) => if D.veq(v, w) then D.matchT(env, rest, tr) else Coll.None
      case D.AVar(n) => D.envGet(env, n) match
        case D.Unbound => D.matchT(Coll.Cons(D.Bind(n, v), env), rest, tr)
        case D.Is(w) => if D.veq(v, w) then D.matchT(env, rest, tr) else Coll.None

// the extensions of e by the rows (newest first) that u reads in round r: rows of round r are skipped; recent ends at
// the first older row
def D.matchRows(e: Coll.List[D.Bind], args: Coll.List[D.Arg], rows: Coll.List[D.Row], u: D.Use, rd: I64, out: Coll.List[Coll.List[D.Bind]]): Coll.List[Coll.List[D.Bind]] = rows match
  case Coll.Nil => out
  case Coll.Cons(row, rest) =>
    val at = D.stampOf(row)
    val t = D.tupleOf(row)
    if at >= rd then D.matchRows(e, args, rest, u, rd, out)
    else
      val take = u match
        case D.Recent => at == rd - 1
        case D.Stable => at < rd - 1
        case D.Full => true
      val stop = u match
        case D.Recent => at < rd - 1
        case _ => false
      if stop then out
      else if !take then D.matchRows(e, args, rest, u, rd, out)
      else D.matchT(e, args, t) match
        case Coll.None => D.matchRows(e, args, rest, u, rd, out)
        case Coll.Some(e2) => D.matchRows(e, args, rest, u, rd, Coll.Cons(e2, out))

def D.relOf(rels: Coll.IMap[D.Rel], id: I64): D.Rel = Coll.node(rels, id) match
  case Coll.Tip => D.newRel(Coll.Nil)
  case Coll.Bin(_, _, rl, _, _) => rl

// every extension of each env by a row of the atom's relation that u reads
def D.joinAtom(rels: Coll.IMap[D.Rel], a: D.CAtom, u: D.Use, rd: I64, envs: Coll.List[Coll.List[D.Bind]], out: Coll.List[Coll.List[D.Bind]]): Coll.List[Coll.List[D.Bind]] = envs match
  case Coll.Nil => out
  case Coll.Cons(e, rest) =>
    val D.CAtom(relRef, args) = a
    val rel = D.idOfRef(relRef)
    D.joinAtom(rels, a, u, rd, rest, D.matchRows(e, args, D.cands(D.relOf(rels, rel), D.probe(e, args, 0)), u, rd, out))

// a body evaluated in written order, every atom reading all older rows: the first round of a stratum, and D.why
def D.evalAll(rels: Coll.IMap[D.Rel], body: Coll.List[D.CAtom], rd: I64, envs: Coll.List[Coll.List[D.Bind]]): Coll.List[Coll.List[D.Bind]] = body match
  case Coll.Nil => envs
  case Coll.Cons(a, rest) => envs match
    case Coll.Nil => Coll.Nil
    case Coll.Cons(_, _) => D.evalAll(rels, rest, rd, D.joinAtom(rels, a, D.Full, rd, envs, Coll.Nil))

// a plan: its recent atom first, then its steps
def D.evalPlan(rels: Coll.IMap[D.Rel], p: D.Plan, rd: I64, envs: Coll.List[Coll.List[D.Bind]]): Coll.List[Coll.List[D.Bind]] =
  val D.Plan(first, steps) = p
  D.joinSteps(rels, steps, rd, D.joinAtom(rels, first, D.Recent, rd, envs, Coll.Nil))

def D.joinSteps(rels: Coll.IMap[D.Rel], steps: Coll.List[D.Step], rd: I64, envs: Coll.List[Coll.List[D.Bind]]): Coll.List[Coll.List[D.Bind]] = steps match
  case Coll.Nil => envs
  case Coll.Cons(s, rest) => envs match
    case Coll.Nil => Coll.Nil
    case Coll.Cons(_, _) => s match
      case D.ReadOld(a) => D.joinSteps(rels, rest, rd, D.joinAtom(rels, a, D.Stable, rd, envs, Coll.Nil))
      case D.ReadAll(a) => D.joinSteps(rels, rest, rd, D.joinAtom(rels, a, D.Full, rd, envs, Coll.Nil))

def D.recentOf(rels: Coll.IMap[D.Rel], a: D.CAtom): I64 =
  val D.CAtom(relRef, _) = a
  val rel = D.idOfRef(relRef)
  val D.Rel(_, _, _, _, rc, _) = D.relOf(rels, rel)
  rc

// ── heads ──
def D.inst(env: Coll.List[D.Bind], args: Coll.List[D.Arg], acc: Coll.List[D.Val]): Coll.Option[Coll.List[D.Val]] = args match
  case Coll.Nil => Coll.Some(Coll.rev(acc))
  case Coll.Cons(a, rest) => D.argVal(env, a) match
    case D.Unbound => Coll.None
    case D.Is(v) => D.inst(env, rest, Coll.Cons(v, acc))

// each env's head tuple added as a row of round rd, unless its relation has it (from any round). Every env writes the
// one head relation: its rows go into rl, and rels takes rl once at the end (not one path copy of rels per row)
def D.heads(rels: Coll.IMap[D.Rel], h: D.CAtom, rule: D.CRule, rd: I64, envs: Coll.List[Coll.List[D.Bind]]): Coll.IMap[D.Rel] =
  val D.CAtom(relRef, args) = h
  val rel = D.idOfRef(relRef)
  D.headRows(rels, rel, D.relOf(rels, rel), D.Same, args, rule, rd, envs)

// whether rl has rows that rels does not have yet
enum D.Grew:
  case D.Same
  case D.Grown

def D.headRows(rels: Coll.IMap[D.Rel], rel: I64, rl: D.Rel, g: D.Grew, args: Coll.List[D.Arg], rule: D.CRule, rd: I64, envs: Coll.List[Coll.List[D.Bind]]): Coll.IMap[D.Rel] = envs match
  case Coll.Nil => g match
    case D.Same => rels
    case D.Grown => Coll.insert(rels, rel, rl)
  case Coll.Cons(e, rest) => D.inst(e, args, Coll.Nil) match
    case Coll.None => D.headRows(rels, rel, rl, g, args, rule, rd, rest)
    case Coll.Some(t) => D.addNew(rl, D.Made(rd, rule, t)) match
      case Coll.None => D.headRows(rels, rel, rl, g, args, rule, rd, rest)
      case Coll.Some(rl2) => D.headRows(rels, rel, rl2, D.Grown, args, rule, rd, rest)

// the envs whose negated atoms all fail: each tuple is in no round of its relation (a lower stratum, complete)
def D.negOk(rels: Coll.IMap[D.Rel], negs: Coll.List[D.CAtom], e: Coll.List[D.Bind]): Bool = negs match
  case Coll.Nil => true
  case Coll.Cons(a, rest) =>
    val D.CAtom(relRef, args) = a
    val rel = D.idOfRef(relRef)
    D.inst(e, args, Coll.Nil) match
      case Coll.None => false
      case Coll.Some(t) => if D.has(D.relOf(rels, rel), t) then false else D.negOk(rels, rest, e)

def D.filterNeg(rels: Coll.IMap[D.Rel], negs: Coll.List[D.CAtom], envs: Coll.List[Coll.List[D.Bind]], out: Coll.List[Coll.List[D.Bind]]): Coll.List[Coll.List[D.Bind]] = envs match
  case Coll.Nil => out
  case Coll.Cons(e, rest) => D.filterNeg(rels, negs, rest, if D.negOk(rels, negs, e) then Coll.Cons(e, out) else out)

// one rule in round rd, once per plan whose recent atom's relation has recent rows. the joins read the relations as
// the round began (rels0)
def D.fireAt(rels0: Coll.IMap[D.Rel], rl: D.CRule, ps: Coll.List[D.Plan], rd: I64, rels: Coll.IMap[D.Rel]): Coll.IMap[D.Rel] = ps match
  case Coll.Nil => rels
  case Coll.Cons(p, rest) =>
    val D.Plan(first, _) = p
    val e0: Coll.List[D.Bind] = Coll.Nil
    if D.recentOf(rels0, first) == 0 then D.fireAt(rels0, rl, rest, rd, rels)
    else
      D.fireAt(rels0, rl, rest, rd, D.fireWith(rels0, rl, D.evalPlan(rels0, p, rd, Coll.Cons(e0, Coll.Nil)), rd, rels))

// the body matches envs of rule rl, filtered by its negated atoms, as head rows of round rd
def D.fireWith(rels0: Coll.IMap[D.Rel], rl: D.CRule, envs: Coll.List[Coll.List[D.Bind]], rd: I64, rels: Coll.IMap[D.Rel]): Coll.IMap[D.Rel] =
  val D.CRule(h, _, neg, _, _) = rl
  D.heads(rels, h, rl, rd, D.filterNeg(rels0, neg, envs, Coll.Nil))

// the first round of a stratum reads every row once; the next rounds run each rule's plans
enum D.Pass:
  case D.FirstPass
  case D.NextPass

def D.fireAll(rels0: Coll.IMap[D.Rel], rs: Coll.List[D.CRule], rd: I64, pass: D.Pass, rels: Coll.IMap[D.Rel]): Coll.IMap[D.Rel] = rs match
  case Coll.Nil => rels
  case Coll.Cons(rl, rest) =>
    val D.CRule(_, body, _, _, plans) = rl
    val e0: Coll.List[D.Bind] = Coll.Nil
    val rels2 = pass match
      case D.FirstPass => D.fireWith(rels0, rl, D.evalAll(rels0, body, rd, Coll.Cons(e0, Coll.Nil)), rd, rels)
      case D.NextPass => D.fireAt(rels0, rl, plans, rd, rels)
    D.fireAll(rels0, rest, rd, pass, rels2)

// a round ends: this round's rows become the recent ones; the number of new rows in all relations. a relation with no
// recent and no fresh rows is the same record after the round: it stays as it is in acc (which starts as rels)
def D.advance(rels: Coll.IMap[D.Rel], id: I64, k: I64, acc: Coll.IMap[D.Rel], news: I64): D.Next =
  if id == k then D.Next(acc, news)
  else
    val D.Rel(ic, set, cols, all, rc, fr) = D.relOf(rels, id)
    if rc == 0 && fr == 0 then D.advance(rels, id + 1, k, acc, news)
    else D.advance(rels, id + 1, k, Coll.insert(acc, id, D.Rel(ic, set, cols, all, fr, 0)), news + fr)

enum D.Next:
  case D.Next(rels: Coll.IMap[D.Rel], news: I64)

// the relations after a stratum, and the next round number (stamps keep growing across strata)
enum D.Stage:
  case D.Stage(rels: Coll.IMap[D.Rel], rd: I64)

// the input facts are rows of round D.inputRound(); the rounds that derive rows come after it
def D.inputRound(): I64 = 0
def D.firstRound(): I64 = D.inputRound() + 1

// round rd reads rows of rounds < rd
def D.rounds(rs: Coll.List[D.CRule], rels: Coll.IMap[D.Rel], rd: I64, k: I64, pass: D.Pass): D.Stage =
  val D.Next(rels2, news) = D.round(rs, rels, rd, k, pass)
  if news == 0 then D.Stage(rels2, rd + 1) else D.rounds(rs, rels2, rd + 1, k, D.NextPass)

// one round: its rows and the joins that made them; only the next relations outlive it
def D.round(rs: Coll.List[D.CRule], rels: Coll.IMap[D.Rel], rd: I64, k: I64, pass: D.Pass): D.Next =
  val fired = D.fireAll(rels, rs, rd, pass, rels)
  D.advance(fired, 0, k, fired, 0)

// ── strata: a head's stratum is at least each positive body relation's, above each negated one's ──
def D.stOf(st: Coll.IMap[I64], id: I64): I64 = Coll.node(st, id) match
  case Coll.Tip => 0
  case Coll.Bin(_, _, s, _, _) => s

def D.maxSt(st: Coll.IMap[I64], as: Coll.List[D.CAtom], m: I64): I64 = as match
  case Coll.Nil => m
  case Coll.Cons(a, rest) =>
    val D.CAtom(relRef, _) = a
    val s = D.stOf(st, D.idOfRef(relRef))
    D.maxSt(st, rest, if s > m then s else m)

// a negated edge: a rule with head `head` negates `neg`, a relation whose stratum is k, so the head needs k + 1 > k.
// a stratification has at most k strata (k relations), so such an edge exists only when a cycle through negation does
enum D.NegEdge:
  case D.NegEdge(head: D.RelRef, neg: D.RelRef)

enum D.Raised:
  case D.Raised(st: Coll.IMap[I64], changed: Bool)
  case D.Over(w: D.NegEdge)

// the head hRef over its negated atoms ns, each stratum one above the negated relation's; the stratum k is never
// passed: the edge that would pass it is the failure
def D.raiseNeg(hRef: D.RelRef, ns: Coll.List[D.CAtom], st: Coll.IMap[I64], changed: Bool, k: I64): D.Raised = ns match
  case Coll.Nil => D.Raised(st, changed)
  case Coll.Cons(a, rest) =>
    val D.CAtom(nRef, _) = a
    val m = D.stOf(st, D.idOfRef(nRef)) + 1
    val hr = D.idOfRef(hRef)
    if m > k then D.Over(D.NegEdge(hRef, nRef))
    else if m > D.stOf(st, hr) then D.raiseNeg(hRef, rest, Coll.insert(st, hr, m), true, k)
    else D.raiseNeg(hRef, rest, st, changed, k)

def D.raiseAll(rs: Coll.List[D.CRule], st: Coll.IMap[I64], changed: Bool, k: I64): D.Raised = rs match
  case Coll.Nil => D.Raised(st, changed)
  case Coll.Cons(rl, rest) =>
    val D.CRule(h, body, neg, _, _) = rl
    val D.CAtom(hrRef, _) = h
    val hr = D.idOfRef(hrRef)
    val m = D.maxSt(st, body, 0)
    val raised: D.Raised =
      if m > D.stOf(st, hr) then D.raiseNeg(hrRef, neg, Coll.insert(st, hr, m), true, k)
      else D.raiseNeg(hrRef, neg, st, changed, k)
    raised match
      case D.Over(w) => D.Over(w)
      case D.Raised(st2, ch2) => D.raiseAll(rest, st2, ch2, k)

def D.topOf(st: Coll.IMap[I64], id: I64, k: I64, m: I64): I64 =
  if id == k then m else D.topOf(st, id + 1, k, if D.stOf(st, id) > m then D.stOf(st, id) else m)

// the stratification of a program: every relation's stratum, or the negated edge that passed k (a cycle through negation)
enum D.Strat:
  case D.Layered(st: Coll.IMap[I64])
  case D.Looped(w: D.NegEdge)

// raise until no stratum changes, or a negated edge would pass k
def D.strata(rs: Coll.List[D.CRule], st: Coll.IMap[I64], k: I64): D.Strat = D.raiseAll(rs, st, false, k) match
  case D.Over(w) => D.Looped(w)
  case D.Raised(st2, changed) => if changed then D.strata(rs, st2, k) else D.Layered(st2)

// ── the negation cycle a program reports (vic-kpev): a relation x depends on each relation in the body of a rule with
// head x, through a positive or a negated atom. a relation is ON A CYCLE THROUGH NEGATION when some rule with head h
// negates n and n reaches h (reflexively, transitively) through x: n ->* x ->* h. the report is the relation on such a
// cycle with the smallest id (ids: the order the names are first met, the rules' names first), so it depends on the
// rules only, not on the order the strata were raised in nor on the facts' relations ──
def D.atomRefs(as: Coll.List[D.CAtom], acc: Coll.List[D.RelRef]): Coll.List[D.RelRef] = as match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val D.CAtom(ref, _) = a
    D.atomRefs(rest, Coll.Cons(ref, acc))

def D.memberR(id: I64, xs: Coll.List[D.RelRef]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(h, t) => if D.idOfRef(h) == id then true else D.memberR(id, t)

// the relations the rules with head x read, put before acc
def D.readsOf(rs: Coll.List[D.CRule], x: I64, acc: Coll.List[D.RelRef]): Coll.List[D.RelRef] = rs match
  case Coll.Nil => acc
  case Coll.Cons(rl, rest) =>
    val D.CRule(h, body, neg, _, _) = rl
    val D.CAtom(hRef, _) = h
    if D.idOfRef(hRef) == x then D.readsOf(rest, x, D.atomRefs(neg, D.atomRefs(body, acc))) else D.readsOf(rest, x, acc)

// every relation reached from todo (itself included) by reads
def D.reach(rs: Coll.List[D.CRule], todo: Coll.List[D.RelRef], seen: Coll.List[D.RelRef]): Coll.List[D.RelRef] = todo match
  case Coll.Nil => seen
  case Coll.Cons(x, rest) =>
    val id = D.idOfRef(x)
    if D.memberR(id, seen) then D.reach(rs, rest, seen) else D.reach(rs, D.readsOf(rs, id, rest), Coll.Cons(x, seen))

def D.reachOf(rs: Coll.List[D.CRule], x: D.RelRef): Coll.List[D.RelRef] = D.reach(rs, Coll.Cons(x, Coll.Nil), Coll.Nil)

// a group of relations that is never empty: its head and the rest
enum D.Cycle:
  case D.Cycle(head: D.RelRef, tail: Coll.List[D.RelRef])

// the relations a witness's negation cycle lies among: the negated relation n and everything n reaches. the stratum
// of n is k: a chain of k negations below n holds k + 1 relations and only k exist, so one repeats: a cycle through negation
def D.cycleOf(rs: Coll.List[D.CRule], w: D.NegEdge): D.Cycle =
  val D.NegEdge(_, n) = w
  D.Cycle(n, D.reachOf(rs, n))

def D.largerOf(xs: Coll.List[D.RelRef], best: D.RelRef): D.RelRef = xs match
  case Coll.Nil => best
  case Coll.Cons(x, rest) => D.largerOf(rest, if D.idOfRef(x) > D.idOfRef(best) then x else best)

// the relation of the group with the largest id
def D.largest(c: D.Cycle): D.RelRef =
  val D.Cycle(head, tail) = c
  D.largerOf(tail, head)

def D.smaller(x: D.RelRef, best: D.RelRef): D.RelRef = if D.idOfRef(x) < D.idOfRef(best) then x else best

// the relations x of from (reached from n) that reach h, folded into best
def D.onCycle(rs: Coll.List[D.CRule], h: I64, from: Coll.List[D.RelRef], best: D.RelRef): D.RelRef = from match
  case Coll.Nil => best
  case Coll.Cons(x, rest) =>
    if D.memberR(h, D.reachOf(rs, x)) then D.onCycle(rs, h, rest, D.smaller(x, best)) else D.onCycle(rs, h, rest, best)

// the negated atoms ns of a rule with head h
def D.negEdges(rs: Coll.List[D.CRule], h: I64, ns: Coll.List[D.CAtom], best: D.RelRef): D.RelRef = ns match
  case Coll.Nil => best
  case Coll.Cons(a, rest) =>
    val D.CAtom(nRef, _) = a
    val from = D.reachOf(rs, nRef)
    if D.memberR(h, from) then D.negEdges(rs, h, rest, D.onCycle(rs, h, from, best)) else D.negEdges(rs, h, rest, best)

// the relation on a cycle through negation with the smallest id, or best: it is the largest of the witness's group,
// so a relation on a cycle (all lie in the group) is never above it
def D.negCycle(all: Coll.List[D.CRule], todo: Coll.List[D.CRule], best: D.RelRef): D.RelRef = todo match
  case Coll.Nil => best
  case Coll.Cons(rl, rest) =>
    val D.CRule(h, _, neg, _, _) = rl
    val D.CAtom(hRef, _) = h
    D.negCycle(all, rest, D.negEdges(all, D.idOfRef(hRef), neg, best))

// the report of a failed stratification: the name of the relation on a cycle through negation with the smallest id
def D.report(rs: Coll.List[D.CRule], w: D.NegEdge): Sym.Sym =
  D.nameOfRef(D.negCycle(rs, rs, D.largest(D.cycleOf(rs, w))))

def D.rulesAt(rs: Coll.List[D.CRule], st: Coll.IMap[I64], s: I64, acc: Coll.List[D.CRule]): Coll.List[D.CRule] = rs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(rl, rest) =>
    val D.CRule(h, _, _, _, _) = rl
    val D.CAtom(hrRef, _) = h
    val hr = D.idOfRef(hrRef)
    D.rulesAt(rest, st, s, if D.stOf(st, hr) == s then Coll.Cons(rl, acc) else acc)

// the rules of strata s..top, lowest first; a stratum with no rule stays in the list (it still takes a round)
def D.byStratum(rs: Coll.List[D.CRule], st: Coll.IMap[I64], s: I64, top: I64, acc: Coll.List[Coll.List[D.CRule]]): Coll.List[Coll.List[D.CRule]] =
  if s > top then Coll.rev(acc) else D.byStratum(rs, st, s + 1, top, Coll.Cons(D.rulesAt(rs, st, s, Coll.Nil), acc))

def D.runStrata(ss: Coll.List[Coll.List[D.CRule]], rels: Coll.IMap[D.Rel], rd: I64, k: I64): Coll.IMap[D.Rel] = ss match
  case Coll.Nil => rels
  case Coll.Cons(rs, rest) =>
    val D.Stage(rels2, rd2) = D.rounds(rs, rels, rd, k, D.FirstPass)
    D.runStrata(rest, rels2, rd2, k)

// ── safety: every head variable and every variable of a negated atom occurs in a positive atom ──
def D.allIn(vs: Coll.List[I64], bound: Coll.List[I64]): Bool = vs match
  case Coll.Nil => true
  case Coll.Cons(v, rest) => if D.memberI(v, bound) then D.allIn(rest, bound) else false

def D.atomsVars(as: Coll.List[D.CAtom], acc: Coll.List[I64]): Coll.List[I64] = as match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val D.CAtom(_, args) = a
    D.atomsVars(rest, D.argVars(args, acc))

// the head relation of the first unsafe rule, or None: every rule is safe
def D.firstUnsafe(rs: Coll.List[D.CRule]): Coll.Option[Sym.Sym] = rs match
  case Coll.Nil => Coll.None
  case Coll.Cons(rl, rest) =>
    val D.CRule(h, body, neg, _, _) = rl
    val D.CAtom(nameRef, hargs) = h
    val name = D.nameOfRef(nameRef)
    val bound = D.atomsVars(body, Coll.Nil)
    if D.allIn(D.argVars(hargs, Coll.Nil), bound) && D.allIn(D.atomsVars(neg, Coll.Nil), bound) then D.firstUnsafe(rest)
    else Coll.Some(name)

// ── which columns need an index: per body atom (variables bound left to right, constants bound) its first bound
// column, the one D.probe reads; no other column is ever indexed ──
def D.memberI(v: I64, xs: Coll.List[I64]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(h, t) => if h == v then true else D.memberI(v, t)

// the first column bound under bound (a constant, or a bound variable), or None: the atom is scanned
def D.firstBound(args: Coll.List[D.Arg], bound: Coll.List[I64], c: I64): Coll.Option[I64] = args match
  case Coll.Nil => Coll.None
  case Coll.Cons(a, rest) => a match
    case D.AVal(_) => Coll.Some(c)
    case D.AVar(n) => if D.memberI(n, bound) then Coll.Some(c) else D.firstBound(rest, bound, c + 1)

def D.argVars(args: Coll.List[D.Arg], acc: Coll.List[I64]): Coll.List[I64] = args match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) => a match
    case D.AVal(_) => D.argVars(rest, acc)
    case D.AVar(n) => D.argVars(rest, Coll.Cons(n, acc))

def D.colsOf(ics: Coll.IMap[Coll.List[I64]], rel: I64): Coll.List[I64] = Coll.node(ics, rel) match
  case Coll.Tip => Coll.Nil
  case Coll.Bin(_, _, cs, _, _) => cs

def D.probesOf(body: Coll.List[D.CAtom], bound: Coll.List[I64], ics: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = body match
  case Coll.Nil => ics
  case Coll.Cons(a, rest) =>
    val D.CAtom(_, args) = a
    D.probesOf(rest, D.argVars(args, bound), D.probeAtom(a, bound, ics))

// the column atom a probes under bound, recorded for its relation
def D.probeAtom(a: D.CAtom, bound: Coll.List[I64], ics: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] =
  val D.CAtom(relRef, args) = a
  val rel = D.idOfRef(relRef)
  val old = D.colsOf(ics, rel)
  D.firstBound(args, bound, 0) match
    case Coll.None => ics
    case Coll.Some(c) => if D.memberI(c, old) then ics else Coll.insert(ics, rel, Coll.Cons(c, old))

// the probes of a plan: its recent atom with nothing bound, then its steps in order
def D.probesPlan(p: D.Plan, ics: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] =
  val D.Plan(first, steps) = p
  val D.CAtom(_, args) = first
  D.probesSteps(steps, D.argVars(args, Coll.Nil), D.probeAtom(first, Coll.Nil, ics))

def D.probesSteps(steps: Coll.List[D.Step], bound: Coll.List[I64], ics: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = steps match
  case Coll.Nil => ics
  case Coll.Cons(s, rest) =>
    val a: D.CAtom = s match
      case D.ReadOld(x) => x
      case D.ReadAll(x) => x
    val D.CAtom(_, args) = a
    D.probesSteps(rest, D.argVars(args, bound), D.probeAtom(a, bound, ics))

def D.probesPlans(ps: Coll.List[D.Plan], ics: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = ps match
  case Coll.Nil => ics
  case Coll.Cons(p, rest) => D.probesPlans(rest, D.probesPlan(p, ics))

// the probes of every rule: written order (the first pass, D.why) and each plan
def D.probesAll(rs: Coll.List[D.CRule], ics: Coll.IMap[Coll.List[I64]]): Coll.IMap[Coll.List[I64]] = rs match
  case Coll.Nil => ics
  case Coll.Cons(rl, rest) =>
    val D.CRule(_, body, _, _, plans) = rl
    D.probesAll(rest, D.probesPlans(plans, D.probesOf(body, Coll.Nil, ics)))

def D.initRels(ics: Coll.IMap[Coll.List[I64]], id: I64, k: I64, acc: Coll.IMap[D.Rel]): Coll.IMap[D.Rel] =
  if id == k then acc else D.initRels(ics, id + 1, k, Coll.insert(acc, id, D.newRel(D.colsOf(ics, id))))

// ── the model ──
enum D.Model:
  case D.Model(tab: Coll.List[D.RelRef], rels: Coll.IMap[D.Rel])

// the input facts as rows of the input round; a relation that only facts name gets its id here. The rows of each
// relation are gathered first (a run of facts of one relation takes one id lookup and one insert into pend), then
// each relation's indexes are built once (D.bulk). The relations of rels have no rows yet (D.Prog's empty ones)
def D.load(tab: Coll.List[D.RelRef], fs: Coll.List[D.Fact], rels: Coll.IMap[D.Rel]): D.With[Coll.IMap[D.Rel]] = fs match
  case Coll.Nil => D.With(tab, rels)
  case Coll.Cons(f, rest) => D.loadIn(D.loadStart(tab, f, Coll.Tip), rest, rels)

// a load in a run: rows are the rows of relation rel (id id) so far, newest first, not yet in pend
enum D.Loading:
  case D.Loading(tab: Coll.List[D.RelRef], rel: Sym.Sym, id: I64, rows: Coll.List[D.Row], pend: Coll.IMap[Coll.List[D.Row]])

def D.loadIn(st: D.Loading, fs: Coll.List[D.Fact], rels: Coll.IMap[D.Rel]): D.With[Coll.IMap[D.Rel]] = fs match
  case Coll.Nil =>
    val D.Loading(tab, _, id, rows, pend) = st
    D.With(tab, D.buildRels(Coll.insert(pend, id, rows), rels, 0, Coll.length(tab)))
  case Coll.Cons(f, rest) => D.loadIn(D.loadStep(st, f), rest, rels)

def D.loadStep(st: D.Loading, f: D.Fact): D.Loading =
  val D.Loading(tab, rel, id, rows, pend) = st
  val D.Fact(r, vals) = f
  if Sym.eq(r, rel) then D.Loading(tab, rel, id, Coll.Cons(D.Input(vals), rows), pend)
  else D.loadStart(tab, f, Coll.insert(pend, id, rows))

def D.loadStart(tab: Coll.List[D.RelRef], f: D.Fact, pend: Coll.IMap[Coll.List[D.Row]]): D.Loading =
  val D.Fact(r, vals) = f
  val D.With(tab2, ref) = D.internId(tab, r)
  val id = D.idOfRef(ref)
  D.Loading(tab2, r, id, Coll.Cons(D.Input(vals), D.pendOf(pend, id)), pend)

def D.pendOf(pend: Coll.IMap[Coll.List[D.Row]], id: I64): Coll.List[D.Row] = Coll.node(pend, id) match
  case Coll.Tip => Coll.Nil
  case Coll.Bin(_, _, rows, _, _) => rows

def D.buildRels(pend: Coll.IMap[Coll.List[D.Row]], rels: Coll.IMap[D.Rel], id: I64, k: I64): Coll.IMap[D.Rel] =
  if id == k then rels
  else D.pendOf(pend, id) match
    case Coll.Nil => D.buildRels(pend, rels, id + 1, k)
    case Coll.Cons(_, _) =>
      val D.Rel(ic, _, _, _, _, _) = D.relOf(rels, id)
      D.buildRels(pend, Coll.insert(rels, id, D.bulk(ic, D.pendOf(pend, id))), id + 1, k)

// ── bulk build: the relation of rows (newest first, maybe with equal tuples) as D.addNew of each row in input order
// would make it, with each index built once from a sorted run (Coll.sortDedup, Coll.bFromSorted), no path copy per
// row. A sort key is hash * n + i for row i of n in input order: keys are unique, so the sort keeps every row, and a
// hash's rows come in input order. Hashes are below 2^32 (Sym.hash, D.modulus), so n below 2^31 keeps a key in I64 ──
def D.bulk(ic: Coll.List[I64], rows: Coll.List[D.Row]): D.Rel =
  val n = Coll.length(rows)
  val Coll.Sorted(xs) = Coll.sortDedup(D.setKeys(rows, n, n - 1, Coll.Nil))
  val D.Groups(gs, drop) = D.groupSet(xs, n)
  val all = D.kept(rows, drop, n)
  val m = Coll.length(all)
  D.Rel(ic, D.treeOf(gs), D.colsBulk(ic, all, m, Coll.BTip), all, 0, m)

def D.setKeys(rows: Coll.List[D.Row], n: I64, i: I64, acc: Coll.List[Coll.KV[D.Row]]): Coll.List[Coll.KV[D.Row]] = rows match
  case Coll.Nil => acc
  case Coll.Cons(row, rest) =>
    D.setKeys(rest, n, i - 1, Coll.Cons(Coll.KV(D.tupleHash(D.tupleOf(row)) * n + i, row), acc))

// the buckets of a key walk (highest hash first, each bucket newest first) and the input positions of the rows that
// an older row with the same tuple dropped
enum D.Groups:
  case D.Groups(gs: Coll.List[Coll.KV[Coll.List[D.Row]]], drop: Coll.List[Coll.KV[Coll.Unit]])

def D.groupSet(xs: Coll.List[Coll.KV[D.Row]], n: I64): D.Groups = xs match
  case Coll.Nil => D.Groups(Coll.Nil, Coll.Nil)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(key, row) = kv
    D.groupSetIn(rest, n, key / n, Coll.Cons(row, Coll.Nil), Coll.Nil, Coll.Nil)

// b: the rows of hash h so far (newest first, no two equal tuples); the keys come in ascending order
def D.groupSetIn(xs: Coll.List[Coll.KV[D.Row]], n: I64, h: I64, b: Coll.List[D.Row], gs: Coll.List[Coll.KV[Coll.List[D.Row]]], drop: Coll.List[Coll.KV[Coll.Unit]]): D.Groups = xs match
  case Coll.Nil => D.Groups(Coll.Cons(Coll.KV(h, b), gs), drop)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(key, row) = kv
    if key / n != h then D.groupSetIn(rest, n, key / n, Coll.Cons(row, Coll.Nil), Coll.Cons(Coll.KV(h, b), gs), drop)
    else if D.inRows(b, D.tupleOf(row)) then D.groupSetIn(rest, n, h, b, gs, Coll.Cons(Coll.KV(key % n, Coll.U), drop))
    else D.groupSetIn(rest, n, h, Coll.Cons(row, b), gs, drop)

// buckets highest key first as a tree: the reversed list is strictly ascending (one bucket per key)
def D.treeOf(gs: Coll.List[Coll.KV[Coll.List[D.Row]]]): Coll.BTree[Coll.List[D.Row]] =
  val Coll.BMap(_, t) = Coll.bFromSorted(Coll.Sorted(Coll.rev(gs)))
  t

// rows (newest first, row n-1 first) without the dropped positions
def D.kept(rows: Coll.List[D.Row], drop: Coll.List[Coll.KV[Coll.Unit]], n: I64): Coll.List[D.Row] = drop match
  case Coll.Nil => rows
  case Coll.Cons(_, _) =>
    val Coll.Sorted(ds) = Coll.sortDedup(drop)
    Coll.rev(D.keptIn(rows, Coll.rev(ds), n - 1, Coll.Nil))

// ds: dropped positions, highest first; acc: the kept rows, oldest first
def D.keptIn(rows: Coll.List[D.Row], ds: Coll.List[Coll.KV[Coll.Unit]], i: I64, acc: Coll.List[D.Row]): Coll.List[D.Row] = rows match
  case Coll.Nil => acc
  case Coll.Cons(row, rest) => ds match
    case Coll.Nil => D.keptIn(rest, ds, i - 1, Coll.Cons(row, acc))
    case Coll.Cons(d, dt) =>
      if Coll.kvKey(d) == i then D.keptIn(rest, dt, i - 1, acc) else D.keptIn(rest, ds, i - 1, Coll.Cons(row, acc))

// each column c of ic that a row has: its index by value hash, built from a sorted run (keys as in D.bulk, m rows)
def D.colsBulk(ic: Coll.List[I64], all: Coll.List[D.Row], m: I64, cols: Coll.BTree[Coll.BTree[Coll.List[D.Row]]]): Coll.BTree[Coll.BTree[Coll.List[D.Row]]] = ic match
  case Coll.Nil => cols
  case Coll.Cons(c, rest) =>
    val keys = D.colKeys(all, c, m, m - 1, Coll.Nil)
    keys match
      case Coll.Nil => D.colsBulk(rest, all, m, cols)
      case Coll.Cons(_, _) =>
        val Coll.Sorted(xs) = Coll.sortDedup(keys)
        D.colsBulk(rest, all, m, Coll.bIns(cols, c, D.treeOf(D.groupCol(xs, m))))

def D.colKeys(rows: Coll.List[D.Row], c: I64, m: I64, i: I64, acc: Coll.List[Coll.KV[D.Row]]): Coll.List[Coll.KV[D.Row]] = rows match
  case Coll.Nil => acc
  case Coll.Cons(row, rest) => D.from(D.tupleOf(row), c) match
    case Coll.Nil => D.colKeys(rest, c, m, i - 1, acc)
    case Coll.Cons(v, _) => D.colKeys(rest, c, m, i - 1, Coll.Cons(Coll.KV(D.vhash(v) * m + i, row), acc))

def D.groupCol(xs: Coll.List[Coll.KV[D.Row]], m: I64): Coll.List[Coll.KV[Coll.List[D.Row]]] = xs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(kv, rest) =>
    val Coll.KV(key, row) = kv
    D.groupColIn(rest, m, key / m, Coll.Cons(row, Coll.Nil), Coll.Nil)

def D.groupColIn(xs: Coll.List[Coll.KV[D.Row]], m: I64, h: I64, b: Coll.List[D.Row], gs: Coll.List[Coll.KV[Coll.List[D.Row]]]): Coll.List[Coll.KV[Coll.List[D.Row]]] = xs match
  case Coll.Nil => Coll.Cons(Coll.KV(h, b), gs)
  case Coll.Cons(kv, rest) =>
    val Coll.KV(key, row) = kv
    if key / m != h then D.groupColIn(rest, m, key / m, Coll.Cons(row, Coll.Nil), Coll.Cons(Coll.KV(h, b), gs))
    else D.groupColIn(rest, m, h, Coll.Cons(row, b), gs)

// a program's result: its model, or why it is not a program (an unsafe rule, a cycle through negation)
enum D.Result:
  case D.Solved(m: D.Model)
  case D.Unsafe(rel: Sym.Sym)
  case D.NegCycle(rel: Sym.Sym)

// ── a program compiled once (bead vic-kpev.1): every part of a solve that depends on the rules only, so a rule
// library solved many times pays for it once: the rules' name table, the empty relations with their probed columns,
// the compiled rules of each stratum ──
enum D.Prog:
  case D.Prog(tab: Coll.List[D.RelRef], rels: Coll.IMap[D.Rel], strata: Coll.List[Coll.List[D.CRule]])

// rules compiled: a program, or why they are not one (an unsafe rule, a cycle through negation)
enum D.Compiled:
  case D.Ready(p: D.Prog)
  case D.UnsafeRule(rel: Sym.Sym)
  case D.NegLoop(rel: Sym.Sym)

// strata are bounded by the rules' relations (k): only heads are raised, and a stratification has fewer strata than
// relations, so the names that only facts add can not change the strata of a program (only which head a cycle names)
def D.compile(rules: Coll.List[D.Rule]): D.Compiled =
  val D.With(tab, ds) = D.drafts(Coll.Nil, rules, 0, Coll.Nil)
  val crs = D.crules(ds, D.headIds(ds, Coll.Nil), Coll.Nil)
  D.firstUnsafe(crs) match
    case Coll.Some(bad) => D.UnsafeRule(bad)
    case Coll.None =>
      val k = Coll.length(tab)
      D.strata(crs, Coll.Tip, k) match
        case D.Looped(w) => D.NegLoop(D.report(crs, w))
        case D.Layered(st) =>
          D.Ready(D.Prog(tab, D.initRels(D.probesAll(crs, Coll.Tip), 0, k, Coll.Tip), D.byStratum(crs, st, 0, D.topOf(st, 0, k, 0), Coll.Nil)))

// the model of a compiled program over facts: strata in order, each to its fixpoint. ids: the rules' names in written
// order, then the names only facts use
def D.run(c: D.Compiled, facts: Coll.List[D.Fact]): D.Result = c match
  case D.UnsafeRule(rel) => D.Unsafe(rel)
  case D.NegLoop(rel) => D.NegCycle(rel)
  case D.Ready(p) =>
    val D.Prog(tab1, init, strata) = p
    val D.With(tab, rels0) = D.load(tab1, facts, init)
    val k = Coll.length(tab)
    val D.Next(rels, _) = D.advance(rels0, 0, k, rels0, 0)
    D.Solved(D.Model(tab, D.runStrata(strata, rels, D.firstRound(), k)))

// the model of rules over facts: one body for one semantics, the rules compiled for this solve
def D.solve(rules: Coll.List[D.Rule], facts: Coll.List[D.Fact]): D.Result = D.run(D.compile(rules), facts)

def D.rowsOf(rows: Coll.List[D.Row], acc: Coll.List[Coll.List[D.Val]]): Coll.List[Coll.List[D.Val]] = rows match
  case Coll.Nil => acc
  case Coll.Cons(row, rest) =>
    val t = D.tupleOf(row)
    D.rowsOf(rest, Coll.Cons(t, acc))

// the facts of rel in a model, oldest first (none when the model has no relation rel)
def D.tuples(m: D.Model, rel: Sym.Sym): Coll.List[Coll.List[D.Val]] =
  val D.Model(tab, rels) = m
  D.refOf(tab, rel) match
    case Coll.None => Coll.Nil
    case Coll.Some(ref) =>
      val D.Rel(_, _, _, all, _, _) = D.relOf(rels, D.idOfRef(ref))
      D.rowsOf(all, Coll.Nil)

// ── provenance (vic-m5r.33, vic/c/dprov-design.md): the proof of a fact ──
enum D.Proof:
  case D.Given(rel: Sym.Sym, t: Coll.List[D.Val])
  case D.ByRule(rule: I64, rel: Sym.Sym, t: Coll.List[D.Val], premises: Coll.List[D.Proof])
  // a negated premise: the atom is not in its relation, a complete lower stratum
  case D.Absent(rel: Sym.Sym, t: Coll.List[D.Val])

def D.rowIn(rows: Coll.List[D.Row], t: Coll.List[D.Val]): Coll.Option[D.Row] = rows match
  case Coll.Nil => Coll.None
  case Coll.Cons(row, rest) => if D.tupleEq(D.tupleOf(row), t) then Coll.Some(row) else D.rowIn(rest, t)

// the row of t in rl, found through the dedup set
def D.findRow(rl: D.Rel, t: Coll.List[D.Val]): Coll.Option[D.Row] =
  val D.Rel(_, set, _, _, _, _) = rl
  D.rowIn(D.bucket(set, D.tupleHash(t)), t)

// the proof of t in relation ref: an input is given; a made row is proved by the rule it points to, with the first
// body match among rows of smaller stamps, so the recursion ends. in a stratum that reads only inputs a row's stamp
// is its minimal proof height, and so is the height of this proof (zhao-2020 txt:575-576); across strata it can be
// taller (bead vic-m5r.35)
def D.proofOf(rels: Coll.IMap[D.Rel], ref: D.RelRef, t: Coll.List[D.Val]): Coll.Option[D.Proof] =
  val D.RelRef(id, rel) = ref
  D.findRow(D.relOf(rels, id), t) match
    case Coll.None => Coll.None
    case Coll.Some(row) => row match
      case D.Input(_) => Coll.Some(D.Given(rel, t))
      case D.Made(at, rl, _) => D.byRule(rels, rl, rel, at, t)

def D.byRule(rels: Coll.IMap[D.Rel], rl: D.CRule, rel: Sym.Sym, at: I64, t: Coll.List[D.Val]): Coll.Option[D.Proof] =
  val D.CRule(h, body, neg, i, _) = rl
  val D.CAtom(_, hargs) = h
  val e0: Coll.List[D.Bind] = Coll.Nil
  D.matchT(e0, hargs, t) match
    case Coll.None => Coll.None
    case Coll.Some(e) => D.evalAll(rels, body, at, Coll.Cons(e, Coll.Nil)) match
      case Coll.Nil => Coll.None
      case Coll.Cons(e2, _) => D.premises(rels, body, neg, e2, Coll.Nil) match
        case Coll.None => Coll.None
        case Coll.Some(ps) => Coll.Some(D.ByRule(i, rel, t, ps))

// the proofs of the positive atoms xs under e, in body order, then the negated atoms negs as absent
def D.premises(rels: Coll.IMap[D.Rel], xs: Coll.List[D.CAtom], negs: Coll.List[D.CAtom], e: Coll.List[D.Bind], acc: Coll.List[D.Proof]): Coll.Option[Coll.List[D.Proof]] = xs match
  case Coll.Nil => D.absents(negs, e, acc)
  case Coll.Cons(a, rest) =>
    val D.CAtom(ref, args) = a
    D.inst(e, args, Coll.Nil) match
      case Coll.None => Coll.None
      case Coll.Some(t) => D.proofOf(rels, ref, t) match
        case Coll.None => Coll.None
        case Coll.Some(p) => D.premises(rels, rest, negs, e, Coll.Cons(p, acc))

def D.absents(negs: Coll.List[D.CAtom], e: Coll.List[D.Bind], acc: Coll.List[D.Proof]): Coll.Option[Coll.List[D.Proof]] = negs match
  case Coll.Nil => Coll.Some(Coll.rev(acc))
  case Coll.Cons(a, rest) =>
    val D.CAtom(ref, args) = a
    D.inst(e, args, Coll.Nil) match
      case Coll.None => Coll.None
      case Coll.Some(t) => D.absents(rest, e, Coll.Cons(D.Absent(D.nameOfRef(ref), t), acc))

// why tuple t of rel holds in m: its proof tree down to input facts, or None when t is not in m
def D.why(m: D.Model, rel: Sym.Sym, t: Coll.List[D.Val]): Coll.Option[D.Proof] =
  val D.Model(tab, rels) = m
  D.refOf(tab, rel) match
    case Coll.None => Coll.None
    case Coll.Some(ref) => D.proofOf(rels, ref, t)

// a match env: a variable's binding (a rule has a few vars: a list is cheaper than a balanced map per binding)
enum D.Bind:
  case D.Bind(n: I64, v: D.Val)

def D.envGet(env: Coll.List[D.Bind], n: I64): D.Bound = env match
  case Coll.Nil => D.Unbound
  case Coll.Cons(b, rest) =>
    val D.Bind(m, v) = b
    if m == n then D.Is(v) else D.envGet(rest, n)
