// s2 E1 EFFECT ROWS (vic 2026-11-09, vic/c/rt-effects-design.md RULED): the protocols each def needs, a Datalog program
// over the source bodies, as s2/pure.srs. a request P.op(...) names the protocol; a constructor is a request on Region;
// a {} binder of a protocol declares it. a call in handle scope S passes on what its callee needs, except what S handles.
//   needs(F, P) :- req(F, P) | decl(F, P) | calls(F, G, S), needs(G, P), not hd(S, P)
//   row(F, P) :- needs(F, P), not decl(F, P)
// req(F, P) is written only when no handle of P is in scope; scope 0 handles nothing. each row(F, P) is one implicit
// {eff.P: P} binder of F (Ty.fn); main has none, so a request main does not handle is error[unhandled-effect].
// a handler H is one subject F (E1b): its fns' bodies are its facts, and `handle x = H()` is calls(F, H, S) in the scope
// outside the handle, so the handlers outside it answer what its ops request (deep handlers, kyo semantics).

enum Eff.Rel:
  case Eff.RReq
  case Eff.RDecl
  case Eff.RCalls
  case Eff.RHd
  case Eff.RNeeds
  case Eff.RRow

def Eff.relSym(rel: Eff.Rel): Sym.Sym = rel match
  case Eff.RReq => Sym.of("req")
  case Eff.RDecl => Sym.of("decl")
  case Eff.RCalls => Sym.of("calls")
  case Eff.RHd => Sym.of("hd")
  case Eff.RNeeds => Sym.of("needs")
  case Eff.RRow => Sym.of("row")

// ── requests: P.op names op of protocol P (one symbol: the last `.` splits it) ──
enum Eff.Req:
  case Eff.Req(p: Sym.Sym, op: Sym.Sym)

def Eff.reqOf(ps: Coll.List[Ast.Proto], f: Sym.Sym): Coll.Option[Eff.Req] =
  val s = Sym.str(f)
  Eff.lastDot(s, Str.len(s) - 1) match
    case Coll.None => Coll.None
    case Coll.Some(i) =>
      val p = Sym.of(Str.slice(s, 0, i))
      val op = Sym.of(Str.slice(s, i + 1, Str.len(s)))
      Ty.protoOp(ps, p, op) match
        case Coll.Some(_) => Coll.Some(Eff.Req(p, op))
        case Coll.None => Coll.None

// 46 = `.`
def Eff.lastDot(s: Str, i: I64): Coll.Option[I64] =
  if i < 0 then Coll.None
  else if Str.at(s, i) == 46 then Coll.Some(i)
  else Eff.lastDot(s, i - 1)

// the symbol `a.b` (srs has no string concatenation: the printer writes it)
def Eff.dotted(a: Str, b: Sym.Sym): Sym.Sym =
  Console.captureBegin()
  Console.print(a)
  Console.print(".")
  Console.print(Sym.str(b))
  Sym.of(Console.captureEnd())

// ── rows: per def, the implicit capabilities, each a protocol and its binder name eff.P ──
enum Eff.Cap:
  case Eff.Cap(p: Sym.Sym, x: Sym.Sym)

enum Eff.Rows:
  case Eff.Rows(m: Coll.SMap[Coll.List[Eff.Cap]])

enum Eff.Set:
  case Eff.Got(rows: Eff.Rows)
  case Eff.RulesBad(rel: Sym.Sym)

def Eff.none(): Eff.Rows = Eff.Rows(Coll.sEmpty())

def Eff.row(rs: Eff.Rows, f: Sym.Sym): Coll.List[Eff.Cap] =
  val Eff.Rows(m) = rs
  Coll.sLookup(m, f) match
    case Coll.Some(cs) => cs
    case Coll.None => Coll.Nil

def Eff.has(rs: Eff.Rows, f: Sym.Sym, p: Sym.Sym): Bool = Eff.capIn(Eff.row(rs, f), p)

def Eff.capIn(cs: Coll.List[Eff.Cap], p: Sym.Sym): Bool = cs match
  case Coll.Nil => false
  case Coll.Cons(c, rest) =>
    val Eff.Cap(q, _) = c
    if Sym.eq(q, p) then true else Eff.capIn(rest, p)

def Eff.rows(ds: Coll.List[Ast.Decl]): Eff.Set =
  val cx = Eff.cxOf(ds, Eff.Cx(Coll.Nil, Coll.sEmpty(), Coll.sEmpty(), Coll.sEmpty(), Eff.syms(), Coll.Nil))
  D.solve(Eff.rules(), Eff.decls(cx, ds, Eff.W(1, Coll.Nil, Coll.Nil, Coll.sEmpty()))) match
    case D.Solved(m) => Eff.Got(Eff.Rows(Eff.group(Eff.capNames(cx), D.tuples(m, Eff.relSym(Eff.RRow)), Coll.sEmpty())))
    case D.Unsafe(rel) => Eff.RulesBad(rel)
    case D.NegCycle(rel) => Eff.RulesBad(rel)

// row tuples (F, P) by F; main has no row (vic: main must have the empty row)
def Eff.group(names: Coll.SMap[Sym.Sym], ts: Coll.List[Coll.List[D.Val]], m: Coll.SMap[Coll.List[Eff.Cap]]): Coll.SMap[Coll.List[Eff.Cap]] = ts match
  case Coll.Nil => m
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(fv, more) => more match
      case Coll.Cons(pv, _) => fv match
        case D.VSym(f) => pv match
          case D.VSym(p) =>
            if Sym.eq(f, Sym.of("main")) then Eff.group(names, rest, m)
            else
              val cs: Coll.List[Eff.Cap] = Coll.sLookup(m, f) match
                case Coll.Some(xs) => xs
                case Coll.None => Coll.Nil
              val x: Sym.Sym = Coll.sLookup(names, p) match
                case Coll.Some(n) => n
                case Coll.None => p
              Eff.group(names, rest, Coll.sInsert(m, f, Coll.Cons(Eff.Cap(p, x), cs)))
          case D.VInt(_) => Eff.group(names, rest, m)
        case D.VInt(_) => Eff.group(names, rest, m)
      case Coll.Nil => Eff.group(names, rest, m)
    case Coll.Nil => Eff.group(names, rest, m)

// eff.P for each protocol P
def Eff.capNames(cx: Eff.Cx): Coll.SMap[Sym.Sym] =
  val Eff.Cx(ps, _, _, _, _, _) = cx
  Eff.namesOf(ps, Coll.sEmpty())

def Eff.namesOf(ps: Coll.List[Ast.Proto], m: Coll.SMap[Sym.Sym]): Coll.SMap[Sym.Sym] = ps match
  case Coll.Nil => m
  case Coll.Cons(p, rest) =>
    val Ast.Proto(_, _, n, _, _, _, _, _, _) = p
    Eff.namesOf(rest, Coll.sInsert(m, n, Eff.dotted("eff", n)))

// ── rules ──
def Eff.atom(rel: Eff.Rel, xs: Coll.List[I64]): D.Atom = D.Atom(Eff.relSym(rel), Pure.vars(xs))

def Eff.rules(): Coll.List[D.Rule] =
  val n1 = D.Rule(Eff.atom(Eff.RNeeds, Pure.two(0, 1)), Coll.Cons(D.Pos(Eff.atom(Eff.RReq, Pure.two(0, 1))), Coll.Nil))
  val n2 = D.Rule(Eff.atom(Eff.RNeeds, Pure.two(0, 1)), Coll.Cons(D.Pos(Eff.atom(Eff.RDecl, Pure.two(0, 1))), Coll.Nil))
  // needs(0, 1) :- calls(0, 2, 3), needs(2, 1), not hd(3, 1)
  val callsA = D.Pos(D.Atom(Eff.relSym(Eff.RCalls), Pure.vars(Coll.Cons(0, Pure.two(2, 3)))))
  val n3 =
    D.Rule(Eff.atom(Eff.RNeeds, Pure.two(0, 1)), Coll.Cons(callsA, Coll.Cons(D.Pos(Eff.atom(Eff.RNeeds, Pure.two(2, 1))), Coll.Cons(D.Neg(Eff.atom(Eff.RHd, Pure.two(3, 1))), Coll.Nil))))
  val w1 =
    D.Rule(Eff.atom(Eff.RRow, Pure.two(0, 1)), Coll.Cons(D.Pos(Eff.atom(Eff.RNeeds, Pure.two(0, 1))), Coll.Cons(D.Neg(Eff.atom(Eff.RDecl, Pure.two(0, 1))), Coll.Nil)))
  Coll.Cons(n1, Coll.Cons(n2, Coll.Cons(n3, Coll.Cons(w1, Coll.Nil))))

// ── facts ──
// a callee: a def with a body or a {} binder of a protocol (it may need one), or an extern with none (it never does:
// no fact)
enum Eff.Callee:
  case Eff.Runs
  case Eff.Leaf

// the relation and Region symbols, made once per program (not per fact)
enum Eff.Syms:
  case Eff.Syms(req: Sym.Sym, decl: Sym.Sym, calls: Sym.Sym, hd: Sym.Sym, region: Sym.Sym, ks: Names.Keys, cell: Sym.Sym)

// the protocols, handler -> protocol, the callees, the cases with fields (a call of one allocates), the symbols, the traits
enum Eff.Cx:
  case Eff.Cx(ps: Coll.List[Ast.Proto], hp: Coll.SMap[Sym.Sym], fns: Coll.SMap[Eff.Callee], ctors: Coll.SMap[Bool], ss: Eff.Syms, trs: Coll.List[Ast.Trait])

def Eff.syms(): Eff.Syms =
  Eff.Syms(Eff.relSym(Eff.RReq), Eff.relSym(Eff.RDecl), Eff.relSym(Eff.RCalls), Eff.relSym(Eff.RHd), Sym.of("Region"), Names.keys(), Sym.of("Cell.new"))

def Eff.cxOf(ds: Coll.List[Ast.Decl], cx: Eff.Cx): Eff.Cx = ds match
  case Coll.Nil => cx
  case Coll.Cons(d, rest) =>
    val Eff.Cx(ps, hp, fns, ctors, ss, trs) = cx
    d match
      case Ast.DProto(p) => Eff.cxOf(rest, Eff.Cx(Coll.Cons(p, ps), hp, fns, ctors, ss, trs))
      case Ast.DHandler(h) =>
        val Ast.Handler(_, _, n, p, _, _, _) = h
        Eff.cxOf(rest, Eff.Cx(ps, Coll.sInsert(hp, n, p), Coll.sInsert(fns, n, Eff.Runs), ctors, ss, trs))
      case Ast.DFn(f) =>
        val Ast.Fn(_, _, n, _, _, _, _, _) = f
        Eff.cxOf(rest, Eff.Cx(ps, hp, Coll.sInsert(fns, n, Eff.calleeOf(f)), ctors, ss, trs))
      case Ast.DEnum(e) =>
        val Ast.Enum(_, _, _, _, cases) = e
        Eff.cxOf(rest, Eff.Cx(ps, hp, fns, Eff.ctorsOf(cases, ctors), ss, trs))
      case Ast.DTrait(t) => Eff.cxOf(rest, Eff.Cx(ps, hp, fns, ctors, ss, Coll.Cons(t, trs)))
      case _ => Eff.cxOf(rest, cx)

// an extern with no {} binder is a leaf (rt_print, rt_str_eq, ...)
def Eff.calleeOf(f: Ast.Fn): Eff.Callee =
  val Ast.Fn(_, _, _, gs, _, _, _, body) = f
  body match
    case Ast.Extern(_) => Ty.evidence(gs, Coll.Nil) match
      case Coll.Nil => Eff.Leaf
      case Coll.Cons(_, _) => Eff.Runs
    case _ => Eff.Runs

def Eff.ctorsOf(cs: Coll.List[Ast.Case], m: Coll.SMap[Bool]): Coll.SMap[Bool] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, n, fields) = c
    fields match
      case Coll.Nil => Eff.ctorsOf(rest, m)
      case Coll.Cons(_, _) => Eff.ctorsOf(rest, Coll.sInsert(m, n, true))

// the walk: the next handle scope id, the facts; in the current def, the protocols already requested and the
// (callee, scope) pairs already called (each fact once)
enum Eff.W:
  case Eff.W(next: I64, facts: Coll.List[D.Fact], reqs: Coll.List[Sym.Sym], calls: Coll.SMap[Coll.List[I64]])

// where a walk is: the def, its handle scope id and the protocols handled there, its locals, its {} binders
enum Eff.At:
  case Eff.At(f: Sym.Sym, s: I64, hd: Coll.List[Sym.Sym], ls: Coll.List[Sym.Sym], ev: Coll.List[Ast.Binder])

def Eff.add(w: Eff.W, rel: Sym.Sym, vs: Coll.List[D.Val]): Eff.W =
  val Eff.W(n, fs, rq, cs) = w
  Eff.W(n, Coll.Cons(D.Fact(rel, vs), fs), rq, cs)

def Eff.v2(a: D.Val, b: D.Val): Coll.List[D.Val] = Coll.Cons(a, Coll.Cons(b, Coll.Nil))

def Eff.isIn(m: Coll.SMap[Bool], x: Sym.Sym): Bool = Coll.sLookup(m, x) match
  case Coll.Some(_) => true
  case Coll.None => false

// A1: the builtins that allocate a new array (in the innermost Region, as a constructor)
def Eff.isArrayNew(ss: Eff.Syms, g: Sym.Sym): Bool =
  val Eff.Syms(_, _, _, _, _, ks, c) = ss
  val Names.Keys(_, f, t, _, _) = ks
  Sym.eq(g, f) || Sym.eq(g, t) || Sym.eq(g, c)

def Eff.decls(cx: Eff.Cx, ds: Coll.List[Ast.Decl], w: Eff.W): Coll.List[D.Fact] = ds match
  case Coll.Nil =>
    val Eff.W(_, fs, _, _) = w
    fs
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) =>
      val Eff.W(n, fs, _, _) = w
      val Ast.Fn(_, _, fname, _, _, _, _, _) = f
      Eff.decls(cx, rest, Eff.fn(cx, fname, f, Eff.W(n, fs, Coll.Nil, Coll.sEmpty())))
    // a handler is one subject: its row is what all its fns need (E1b), kept at its handle site
    case Ast.DHandler(h) =>
      val Eff.W(n, fs, _, _) = w
      val Ast.Handler(_, _, hn, _, hfs, _, _) = h
      Eff.decls(cx, rest, Eff.hfns(cx, hn, hfs, Eff.W(n, fs, Coll.Nil, Coll.sEmpty())))
    case _ => Eff.decls(cx, rest, w)

// the {} binders a handler fn shares with the op it implements: a per-call capability of the caller (the op declares it),
// not a row entry of the handler
def Eff.opOwn(cx: Eff.Cx, h: Sym.Sym, fname: Sym.Sym): Coll.List[Sym.Sym] =
  val Eff.Cx(ps, hp, _, _, _, _) = cx
  Coll.sLookup(hp, h) match
    case Coll.None => Coll.Nil
    case Coll.Some(p) => Ty.protoOp(ps, p, fname) match
      case Coll.None => Coll.Nil
      case Coll.Some(o) =>
        val Ast.Op(_, _, _, ogs, _, _, _) = o
        Fx.binderNames(Ty.evidence(ogs, Coll.Nil), Coll.Nil)

// decl(F, P) for each {} binder of a protocol; the body of a run def
// n: the subject, the def itself or its handler
def Eff.fn(cx: Eff.Cx, n: Sym.Sym, f: Ast.Fn, w: Eff.W): Eff.W =
  val Ast.Fn(_, _, fname, gs, ps, _, _, body) = f
  val ev = Ty.evidence(gs, Coll.Nil)
  val w1 = Eff.declsOf(cx, n, ev, Eff.opOwn(cx, n, fname), w)
  body match
    case Ast.Def(_, e) => Eff.expr(cx, Eff.At(n, 0, Coll.Nil, Ty.names(ps, Ty.names(ev, Coll.Nil)), ev), e, w1)
    case _ => w1

def Eff.hfns(cx: Eff.Cx, h: Sym.Sym, fs: Coll.List[Ast.Fn], w: Eff.W): Eff.W = fs match
  case Coll.Nil => w
  case Coll.Cons(f, rest) => Eff.hfns(cx, h, rest, Eff.fn(cx, h, f, w))

def Eff.declsOf(cx: Eff.Cx, f: Sym.Sym, bs: Coll.List[Ast.Binder], own: Coll.List[Sym.Sym], w: Eff.W): Eff.W = bs match
  case Coll.Nil => w
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, bx, t) = b
    val Ast.Ty(_, tn, _, _, _) = t
    val Eff.Cx(ps, hp, _, _, ss, _) = cx
    val Eff.Syms(req, decl, _, _, _, _, _) = ss
    // a {} binder of a handler fn is a row entry of its handler (req, not decl): the w_ wrapper then supplies the cap; one the op
    // itself declares is the caller's per call (decl)
    val rel = Coll.sLookup(hp, f) match
      case Coll.Some(_) => if Ty.memberSym(bx, own) then decl else req
      case Coll.None => decl
    if Ty.isProto(ps, tn) then Eff.declsOf(cx, f, rest, own, Eff.add(w, rel, Eff.v2(D.VSym(f), D.VSym(tn))))
    else Eff.declsOf(cx, f, rest, own, w)

def Eff.req(cx: Eff.Cx, at: Eff.At, p: Sym.Sym, w: Eff.W): Eff.W =
  val Eff.At(f, _, hd, _, _) = at
  val Eff.W(n, fs, rq, cs) = w
  if Ty.memberSym(p, hd) || Ty.memberSym(p, rq) then w
  else
    val Eff.Cx(_, _, _, _, ss, _) = cx
    val Eff.Syms(req, _, _, _, _, _, _) = ss
    Eff.W(n, Coll.Cons(D.Fact(req, Eff.v2(D.VSym(f), D.VSym(p))), fs), Coll.Cons(p, rq), cs)

// calls(F, G, S): a leaf, F itself, or a pair already called adds nothing
def Eff.call(cx: Eff.Cx, at: Eff.At, g: Sym.Sym, w: Eff.W): Eff.W =
  val Eff.At(f, s, _, _, _) = at
  val Eff.Cx(_, _, fns, _, ss, _) = cx
  val Eff.W(n, fs, rq, cs) = w
  val seen: Coll.List[I64] = Coll.sLookup(cs, g) match
    case Coll.Some(xs) => xs
    case Coll.None => Coll.Nil
  val leaf: Bool = Coll.sLookup(fns, g) match
    case Coll.Some(k) => k match
      case Eff.Leaf => true
      case Eff.Runs => false
    case Coll.None => true
  if leaf || Sym.eq(f, g) || Eff.memberI(s, seen) then w
  else
    val Eff.Syms(_, _, calls, _, _, _, _) = ss
    Eff.W(n, Coll.Cons(D.Fact(calls, Coll.Cons(D.VSym(f), Eff.v2(D.VSym(g), D.VInt(s)))), fs), rq, Coll.sInsert(cs, g, Coll.Cons(s, seen)))

def Eff.memberI(x: I64, xs: Coll.List[I64]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(h, t) => if h == x then true else Eff.memberI(x, t)

def Eff.isFn(m: Coll.SMap[Eff.Callee], x: Sym.Sym): Bool = Coll.sLookup(m, x) match
  case Coll.Some(_) => true
  case Coll.None => false

// an op with {} binders of its own (3e: {r: Region}) takes those capabilities from its caller: the request needs each
// protocol too (so the def's row gets it, as for a call of a def with such a binder)
def Eff.opNeedsQ(cx: Eff.Cx, at: Eff.At, q: Coll.Option[Eff.Req], w: Eff.W): Eff.W = q match
  case Coll.None => w
  case Coll.Some(rq) =>
    val Eff.Req(p, op) = rq
    Eff.opNeeds(cx, at, p, op, w)

def Eff.opNeeds(cx: Eff.Cx, at: Eff.At, p: Sym.Sym, op: Sym.Sym, w: Eff.W): Eff.W =
  val Eff.Cx(ps, _, _, _, _, _) = cx
  Ty.protoOp(ps, p, op) match
    case Coll.None => w
    case Coll.Some(o) =>
      val Ast.Op(_, _, _, ogs, _, _, _) = o
      Eff.needsOf(cx, at, Ty.evidence(ogs, Coll.Nil), w)

def Eff.needsOf(cx: Eff.Cx, at: Eff.At, bs: Coll.List[Ast.Binder], w: Eff.W): Eff.W = bs match
  case Coll.Nil => w
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, tn, _, _, _) = t
    val Eff.Cx(ps, _, _, _, _, _) = cx
    Eff.needsOf(cx, at, rest, if Ty.isProto(ps, tn) then Eff.req(cx, at, tn, w) else w)

def Eff.reqTo(cx: Eff.Cx, at: Eff.At, q: Coll.Option[Eff.Req], w: Eff.W): Eff.W = q match
  case Coll.Some(rq) =>
    val Eff.Req(p, _) = rq
    Eff.req(cx, at, p, w)
  case Coll.None => w

// the type name of the {} binder x
def Eff.binderTy(bs: Coll.List[Ast.Binder], x: Sym.Sym): Coll.Option[Sym.Sym] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, y, t) = b
    val Ast.Ty(_, tn, _, _, _) = t
    if Sym.eq(x, y) then Coll.Some(tn) else Eff.binderTy(rest, x)

def Eff.capReqs(cx: Eff.Cx, at: Eff.At, cs: Coll.List[Eff.Cap], w: Eff.W): Eff.W = cs match
  case Coll.Nil => w
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, _) = c
    Eff.capReqs(cx, at, rest, Eff.req(cx, at, p, w))

def Eff.local(at: Eff.At, xs: Coll.List[Sym.Sym]): Eff.At =
  val Eff.At(f, s, hd, ls, ev) = at
  Eff.At(f, s, hd, Coll.revOnto(xs, ls), ev)

def Eff.expr(cx: Eff.Cx, at: Eff.At, e: Ast.Expr, w: Eff.W): Eff.W = e match
  case Ast.Name(_, x) =>
    val Eff.At(_, _, _, ls, _) = at
    if Ty.memberSym(x, ls) then w else Eff.call(cx, at, x, w)
  case Ast.Call(_, g, _, _, xs) =>
    val w1 = Eff.exprs(cx, at, xs, w)
    val Eff.Cx(ps, _, fns, ctors, ss, _) = cx
    val Eff.Syms(_, _, _, _, region, _, _) = ss
    if Eff.isFn(fns, g) then Eff.call(cx, at, g, w1)
    else if Eff.isIn(ctors, g) || Eff.isArrayNew(ss, g) then Eff.req(cx, at, region, w1)
    // Cell.put(c, v) and Array.put(xs, i, v) write (A1, A1b): a request on Mut, so a fn that writes has Mut in its row
    else if Str.eq(Sym.str(g), "Cell.put") || Str.eq(Sym.str(g), "Array.put") || Str.eq(Sym.str(g), "Array.blit") then
      Eff.req(cx, at, Sym.of("Mut"), w1)
    else Eff.opNeedsQ(cx, at, Eff.reqOf(ps, g), Eff.reqTo(cx, at, Eff.reqOf(ps, g), w1))
  // a trait method on {} evidence requests the capabilities the method declares (vic Q2); xs.at(i) on a local (an
  // array, A1) builds an Array.Index in the innermost Region
  case Ast.Method(_, recv, op, xs) =>
    val Eff.At(_, _, _, _, ev) = at
    val Eff.Cx(ps, _, _, _, ss, trs) = cx
    val Eff.Syms(_, _, _, _, region, _, _) = ss
    Eff.binderTy(ev, recv) match
      case Coll.Some(tn) =>
        Eff.opNeeds(cx, at, tn, op, Eff.capReqs(cx, at, Ty.methodCaps(ps, trs, tn, op), Eff.exprs(cx, at, xs, w)))
      case Coll.None =>
        if Str.eq(Sym.str(op), "at") then Eff.req(cx, at, region, Eff.exprs(cx, at, xs, w))
        else Eff.exprs(cx, at, xs, w)
  // what the rest of the block requests is the handle site's, not the op's
  case Ast.Resume(_, _, x) => Eff.expr(cx, at, x, w)
  case Ast.Bin(_, _, l, x) => Eff.expr(cx, at, x, Eff.expr(cx, at, l, w))
  case Ast.Un(_, _, x) => Eff.expr(cx, at, x, w)
  case Ast.If(_, _, c, t, x) => Eff.expr(cx, at, x, Eff.expr(cx, at, t, Eff.expr(cx, at, c, w)))
  case Ast.Match(_, _, s, arms) => Eff.arms(cx, at, arms, Eff.expr(cx, at, s, w))
  case Ast.Block(_, _, ss, last) => Eff.stmts(cx, at, ss, last, w)
  case Ast.While(_, c, b) => Eff.expr(cx, at, b, Eff.expr(cx, at, c, w))
  case Ast.Assign(_, _, x) => Eff.expr(cx, at, x, w)
  case Ast.Quant(_, _, x, _, b) => Eff.expr(cx, Eff.local(at, Coll.Cons(x, Coll.Nil)), b, w)
  case _ => w

def Eff.exprs(cx: Eff.Cx, at: Eff.At, xs: Coll.List[Ast.Expr], w: Eff.W): Eff.W = xs match
  case Coll.Nil => w
  case Coll.Cons(x, rest) => Eff.exprs(cx, at, rest, Eff.expr(cx, at, x, w))

def Eff.arms(cx: Eff.Cx, at: Eff.At, as: Coll.List[Ast.Arm], w: Eff.W): Eff.W = as match
  case Coll.Nil => w
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, p, b) = a
    val at2: Eff.At = p match
      case Ast.PCase(_, xs) => Eff.local(at, xs)
      case Ast.PAny => at
    Eff.arms(cx, at, rest, Eff.expr(cx, at2, b, w))

// a handle opens a new scope for the rest of the block: hd(S, P) for every protocol handled there
def Eff.stmts(cx: Eff.Cx, at: Eff.At, ss: Coll.List[Ast.Stmt], last: Ast.Expr, w: Eff.W): Eff.W = ss match
  case Coll.Nil => Eff.expr(cx, at, last, w)
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, _, x, _, e) =>
      Eff.stmts(cx, Eff.local(at, Coll.Cons(x, Coll.Nil)), rest, last, Eff.expr(cx, at, e, w))
    case Ast.Var(_, _, x, _, e) =>
      Eff.stmts(cx, Eff.local(at, Coll.Cons(x, Coll.Nil)), rest, last, Eff.expr(cx, at, e, w))
    // the handler's row is needed here, in the scope outside its own handle (deep handlers, E1b)
    case Ast.Handle(_, _, x, h, xs) =>
      val Eff.W(n, fs, rq, cs) = Eff.call(cx, at, h, Eff.exprs(cx, at, xs, w))
      val Eff.Cx(_, hp, _, _, ss, _) = cx
      val Eff.Syms(_, _, _, hdRel, _, _, _) = ss
      val Eff.At(f, _, hd, ls, ev) = at
      val hd2: Coll.List[Sym.Sym] = Coll.sLookup(hp, h) match
        case Coll.Some(p) => Coll.Cons(p, hd)
        case Coll.None => hd
      Eff.stmts(cx, Eff.At(f, n, hd2, Coll.Cons(x, ls), ev), rest, last, Eff.hds(hdRel, n, hd2, Eff.W(n + 1, fs, rq, cs)))
    case Ast.Do(_, e) => Eff.stmts(cx, at, rest, last, Eff.expr(cx, at, e, w))
    case Ast.Check(_, _, _, e) => Eff.stmts(cx, at, rest, last, Eff.expr(cx, at, e, w))

def Eff.hds(rel: Sym.Sym, s: I64, ps: Coll.List[Sym.Sym], w: Eff.W): Eff.W = ps match
  case Coll.Nil => w
  case Coll.Cons(p, rest) => Eff.hds(rel, s, rest, Eff.add(w, rel, Eff.v2(D.VInt(s), D.VSym(p))))
