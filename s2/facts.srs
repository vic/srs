// s2 fact groups and rule defs well-formed (s1/facts.srs checks), as a Datalog rule library: the source gives facts, a
// clash is a derived (line, name) row. a def's <> groups: entry (g 0, before the params) and exit (g 1, after the result).
// in at(x, S) x is a {} capability of the def and S a state of its protocol (an upper-case S) or a variable; in
// next(s, op, t) op is an op of a protocol of the def's capabilities; any other relation is a rule def of one of them,
// with its arity. an exit variable is bound by the entry facts; an exit fact is an at. a protocol's rule defs: not named
// at or next, one arity per name, each param in the body, each body relation a rule def of the protocol, each next op
// an op of the protocol.

enum Fx.Clash:
  case Fx.NotCap(line: I64, x: Sym.Sym)
  case Fx.BadState(line: I64, s: Sym.Sym)
  case Fx.Twice(line: I64, x: Sym.Sym)
  case Fx.NotOp(line: I64, op: Sym.Sym)
  case Fx.UnknownRel(line: I64, rel: Sym.Sym)
  case Fx.RelArity(line: I64, rel: Sym.Sym)
  case Fx.Unbound(line: I64, v: Sym.Sym)
  case Fx.ExitOther(line: I64, rel: Sym.Sym)
  case Fx.Reserved(line: I64, rel: Sym.Sym)
  case Fx.ClauseArity(line: I64, rel: Sym.Sym)
  case Fx.Unsafe(line: I64, x: Sym.Sym)
  case Fx.RuleUnknown(line: I64, rel: Sym.Sym)
  case Fx.RuleOp(line: I64, op: Sym.Sym)
  // R2a unambiguous protocols: op goes from state s to two states (a run-time outcome the program would choose)
  case Fx.Ambiguous(line: I64, op: Sym.Sym, s: Sym.Sym)
  // an op result T<x> where x is not self (the receiver is the only capability an op names)
  case Fx.OpCap(line: I64, x: Sym.Sym)
  // an op result T{...} that does not give each {} binder of T, a binder of this capability, the receiver self
  case Fx.OpChoice(line: I64, t: Sym.Sym)

enum Fx.Verdict:
  case Fx.Ok
  case Fx.Bad(cs: Coll.List[Fx.Clash])
  // the rule library is not Datalog, or a clash row of another shape: a bug in Fx.rules, as data
  case Fx.RulesBad(rel: Sym.Sym)

enum Fx.Rel:
  case Fx.RCap
  case Fx.RState
  case Fx.ROpOf
  case Fx.RRuleRel
  case Fx.RSameN
  case Fx.RUseAt
  case Fx.RAtState
  case Fx.RAtId
  case Fx.RAtLine
  case Fx.RSameId
  case Fx.RUseNext
  case Fx.RUseRel
  case Fx.RExitOther
  case Fx.RVarIn
  case Fx.RParam
  case Fx.RBodyVar
  case Fx.RRUse
  case Fx.RRNext
  case Fx.RReserved
  case Fx.RIsCap
  case Fx.RDefOp
  case Fx.RDefRel
  case Fx.RDefRelN
  case Fx.RVar0
  case Fx.RRRel
  case Fx.RNotCapAt
  case Fx.RBadStateAt
  case Fx.RTwiceAt
  case Fx.RNotOpAt
  case Fx.RUnknownRelAt
  case Fx.RRelArityAt
  case Fx.RUnboundAt
  case Fx.RExitOtherAt
  case Fx.RReservedAt
  case Fx.RClauseArityAt
  case Fx.RUnsafeAt
  case Fx.RRuleUnknownAt
  case Fx.RRuleOpAt
  case Fx.RTr
  case Fx.RSameS
  case Fx.RAmbigAt
  // op results: <x> names, T{...} choices and their count, the {} binders of each type, the name self
  case Fx.RResCap
  case Fx.RResChoice
  case Fx.RResCount
  case Fx.RTyBinder
  case Fx.RTyArity
  case Fx.RSelf
  case Fx.ROpCapAt
  case Fx.ROpChoiceAt

def Fx.relSym(rel: Fx.Rel): Sym.Sym = rel match
  case Fx.RCap => Sym.of("fxCap")
  case Fx.RState => Sym.of("fxState")
  case Fx.ROpOf => Sym.of("fxOpOf")
  case Fx.RRuleRel => Sym.of("fxRuleRel")
  case Fx.RSameN => Sym.of("fxSameN")
  case Fx.RUseAt => Sym.of("fxUseAt")
  case Fx.RAtState => Sym.of("fxAtState")
  case Fx.RAtId => Sym.of("fxAtId")
  case Fx.RAtLine => Sym.of("fxAtLine")
  case Fx.RSameId => Sym.of("fxSameId")
  case Fx.RUseNext => Sym.of("fxUseNext")
  case Fx.RUseRel => Sym.of("fxUseRel")
  case Fx.RExitOther => Sym.of("fxExitOther")
  case Fx.RVarIn => Sym.of("fxVarIn")
  case Fx.RParam => Sym.of("fxParam")
  case Fx.RBodyVar => Sym.of("fxBodyVar")
  case Fx.RRUse => Sym.of("fxRUse")
  case Fx.RRNext => Sym.of("fxRNext")
  case Fx.RReserved => Sym.of("fxReserved")
  case Fx.RIsCap => Sym.of("fxIsCap")
  case Fx.RDefOp => Sym.of("fxDefOp")
  case Fx.RDefRel => Sym.of("fxDefRel")
  case Fx.RDefRelN => Sym.of("fxDefRelN")
  case Fx.RVar0 => Sym.of("fxVar0")
  case Fx.RRRel => Sym.of("fxRRel")
  case Fx.RNotCapAt => Sym.of("fxNotCapAt")
  case Fx.RBadStateAt => Sym.of("fxBadStateAt")
  case Fx.RTwiceAt => Sym.of("fxTwiceAt")
  case Fx.RNotOpAt => Sym.of("fxNotOpAt")
  case Fx.RUnknownRelAt => Sym.of("fxUnknownRelAt")
  case Fx.RRelArityAt => Sym.of("fxRelArityAt")
  case Fx.RUnboundAt => Sym.of("fxUnboundAt")
  case Fx.RExitOtherAt => Sym.of("fxExitOtherAt")
  case Fx.RReservedAt => Sym.of("fxReservedAt")
  case Fx.RClauseArityAt => Sym.of("fxClauseArityAt")
  case Fx.RUnsafeAt => Sym.of("fxUnsafeAt")
  case Fx.RRuleUnknownAt => Sym.of("fxRuleUnknownAt")
  case Fx.RRuleOpAt => Sym.of("fxRuleOpAt")
  case Fx.RTr => Sym.of("fxTr")
  case Fx.RSameS => Sym.of("fxSameS")
  case Fx.RAmbigAt => Sym.of("fxAmbigAt")
  case Fx.RResCap => Sym.of("fxResCap")
  case Fx.RResChoice => Sym.of("fxResChoice")
  case Fx.RResCount => Sym.of("fxResCount")
  case Fx.RTyBinder => Sym.of("fxTyBinder")
  case Fx.RTyArity => Sym.of("fxTyArity")
  case Fx.RSelf => Sym.of("fxSelf")
  case Fx.ROpCapAt => Sym.of("fxOpCapAt")
  case Fx.ROpChoiceAt => Sym.of("fxOpChoiceAt")

// ── rule builders: a var by number, a constant, an atom ──
def Fx.v(n: I64): D.Arg = D.AVar(n)
def Fx.c(n: I64): D.Arg = D.AVal(D.VInt(n))
def Fx.at(rel: Fx.Rel, xs: Coll.List[D.Arg]): D.Atom = D.Atom(Fx.relSym(rel), xs)
def Fx.p(rel: Fx.Rel, xs: Coll.List[D.Arg]): D.Lit = D.Pos(Fx.at(rel, xs))
def Fx.n(rel: Fx.Rel, xs: Coll.List[D.Arg]): D.Lit = D.Neg(Fx.at(rel, xs))
def Fx.vs(xs: Coll.List[I64]): Coll.List[D.Arg] = xs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(x, rest) => Coll.Cons(Fx.v(x), Fx.vs(rest))
def Fx.l1 [A: Type] (a: A): Coll.List[A] = Coll.Cons(a, Coll.Nil)
def Fx.l2 [A: Type] (a: A, b: A): Coll.List[A] = Coll.Cons(a, Fx.l1(b))
def Fx.l3 [A: Type] (a: A, b: A, c: A): Coll.List[A] = Coll.Cons(a, Fx.l2(b, c))
def Fx.l4 [A: Type] (a: A, b: A, c: A, d: A): Coll.List[A] = Coll.Cons(a, Fx.l3(b, c, d))
def Fx.l5 [A: Type] (a: A, b: A, c: A, d: A, e: A): Coll.List[A] = Coll.Cons(a, Fx.l4(b, c, d, e))
def Fx.rule(rel: Fx.Rel, hs: Coll.List[I64], body: Coll.List[D.Lit]): D.Rule = D.Rule(Fx.at(rel, Fx.vs(hs)), body)

def Fx.rules(): Coll.List[D.Rule] =
  val isCap = Fx.rule(Fx.RIsCap, Fx.l2(0, 1), Fx.l1(Fx.p(Fx.RCap, Fx.vs(Fx.l3(0, 1, 2)))))
  val defOp = Fx.rule(Fx.RDefOp, Fx.l2(0, 3), Fx.l2(Fx.p(Fx.RCap, Fx.vs(Fx.l3(0, 1, 2))), Fx.p(Fx.ROpOf, Fx.vs(Fx.l2(2, 3)))))
  val defRel = Fx.rule(Fx.RDefRel, Fx.l2(0, 3), Fx.l2(Fx.p(Fx.RCap, Fx.vs(Fx.l3(0, 1, 2))), Fx.p(Fx.RRuleRel, Fx.vs(Fx.l4(2, 3, 4, 5)))))
  val defRelN = Fx.rule(Fx.RDefRelN, Fx.l3(0, 3, 4), Fx.l2(Fx.p(Fx.RCap, Fx.vs(Fx.l3(0, 1, 2))), Fx.p(Fx.RRuleRel, Fx.vs(Fx.l4(2, 3, 4, 5)))))
  val var0 = Fx.rule(Fx.RVar0, Fx.l2(0, 2), Fx.l1(Fx.p(Fx.RVarIn, Fx.l4(Fx.v(0), Fx.c(0), Fx.v(2), Fx.v(3)))))
  val rrel = Fx.rule(Fx.RRRel, Fx.l2(0, 1), Fx.l1(Fx.p(Fx.RRuleRel, Fx.vs(Fx.l4(0, 1, 2, 3)))))
  val notCap = Fx.rule(Fx.RNotCapAt, Fx.l2(3, 2), Fx.l2(Fx.p(Fx.RUseAt, Fx.vs(Fx.l4(0, 1, 2, 3))), Fx.n(Fx.RIsCap, Fx.vs(Fx.l2(0, 2)))))
  val badState = Fx.rule(Fx.RBadStateAt, Fx.l2(4, 3), Fx.l3(Fx.p(Fx.RAtState, Fx.vs(Fx.l5(0, 1, 2, 3, 4))), Fx.p(Fx.RCap, Fx.vs(Fx.l3(0, 2, 5))), Fx.n(Fx.RState, Fx.vs(Fx.l2(5, 3)))))
  val twice = Fx.rule(Fx.RTwiceAt, Fx.l2(5, 2), Fx.l4(Fx.p(Fx.RAtId, Fx.vs(Fx.l4(0, 1, 2, 3))), Fx.p(Fx.RAtId, Fx.vs(Fx.l4(0, 1, 2, 4))), Fx.n(Fx.RSameId, Fx.vs(Fx.l2(3, 4))), Fx.p(Fx.RAtLine, Fx.vs(Fx.l2(3, 5)))))
  val notOp = Fx.rule(Fx.RNotOpAt, Fx.l2(2, 1), Fx.l2(Fx.p(Fx.RUseNext, Fx.vs(Fx.l3(0, 1, 2))), Fx.n(Fx.RDefOp, Fx.vs(Fx.l2(0, 1)))))
  val unknownRel = Fx.rule(Fx.RUnknownRelAt, Fx.l2(3, 1), Fx.l2(Fx.p(Fx.RUseRel, Fx.vs(Fx.l4(0, 1, 2, 3))), Fx.n(Fx.RDefRel, Fx.vs(Fx.l2(0, 1)))))
  val relArity = Fx.rule(Fx.RRelArityAt, Fx.l2(3, 1), Fx.l3(Fx.p(Fx.RUseRel, Fx.vs(Fx.l4(0, 1, 2, 3))), Fx.p(Fx.RDefRel, Fx.vs(Fx.l2(0, 1))), Fx.n(Fx.RDefRelN, Fx.vs(Fx.l3(0, 1, 2)))))
  val unbound = Fx.rule(Fx.RUnboundAt, Fx.l2(3, 2), Fx.l2(Fx.p(Fx.RVarIn, Fx.l4(Fx.v(0), Fx.c(1), Fx.v(2), Fx.v(3))), Fx.n(Fx.RVar0, Fx.vs(Fx.l2(0, 2)))))
  val exitOther = Fx.rule(Fx.RExitOtherAt, Fx.l2(1, 0), Fx.l1(Fx.p(Fx.RExitOther, Fx.vs(Fx.l2(0, 1)))))
  val reserved = Fx.rule(Fx.RReservedAt, Fx.l2(1, 0), Fx.l1(Fx.p(Fx.RReserved, Fx.vs(Fx.l2(0, 1)))))
  val clauseArity = Fx.rule(Fx.RClauseArityAt, Fx.l2(3, 1), Fx.l3(Fx.p(Fx.RRuleRel, Fx.vs(Fx.l4(0, 1, 2, 3))), Fx.p(Fx.RRuleRel, Fx.vs(Fx.l4(0, 1, 4, 5))), Fx.n(Fx.RSameN, Fx.vs(Fx.l2(2, 4)))))
  val unsafe = Fx.rule(Fx.RUnsafeAt, Fx.l2(2, 1), Fx.l2(Fx.p(Fx.RParam, Fx.vs(Fx.l3(0, 1, 2))), Fx.n(Fx.RBodyVar, Fx.vs(Fx.l2(0, 1)))))
  val ruleUnknown = Fx.rule(Fx.RRuleUnknownAt, Fx.l2(2, 1), Fx.l2(Fx.p(Fx.RRUse, Fx.vs(Fx.l3(0, 1, 2))), Fx.n(Fx.RRRel, Fx.vs(Fx.l2(0, 1)))))
  val ruleOp = Fx.rule(Fx.RRuleOpAt, Fx.l2(2, 1), Fx.l2(Fx.p(Fx.RRNext, Fx.vs(Fx.l3(0, 1, 2))), Fx.n(Fx.ROpOf, Fx.vs(Fx.l2(0, 1)))))
  val a = Fx.l5(isCap, defOp, defRel, defRelN, var0)
  val b = Fx.l5(rrel, notCap, badState, twice, notOp)
  val c = Fx.l5(unknownRel, relArity, unbound, exitOther, reserved)
  // unambiguous protocols: one op from one state has one target (vars: p 0, op 1, s 2, t 3, line 4, t2 5, line2 6)
  val ambig = Fx.rule(Fx.RAmbigAt, Fx.l3(4, 1, 2), Fx.l3(Fx.p(Fx.RTr, Fx.vs(Fx.l5(0, 1, 2, 3, 4))), Fx.p(Fx.RTr, Fx.vs(Fx.l5(0, 1, 2, 5, 6))), Fx.n(Fx.RSameS, Fx.vs(Fx.l2(3, 5)))))
  val d = Fx.l5(clauseArity, unsafe, ruleUnknown, ruleOp, ambig)
  // an op result names only its receiver: <self>, and T{self, ...} with one self per {} binder of T, each a binder of
  // this capability (vars: p 0, T 1, i 2, x 3, line 4, n 5)
  val opCap = Fx.rule(Fx.ROpCapAt, Fx.l2(4, 3), Fx.l2(Fx.p(Fx.RResCap, Fx.vs(Fx.l3(0, 3, 4))), Fx.n(Fx.RSelf, Fx.vs(Fx.l1(3)))))
  val choiceSelf = Fx.rule(Fx.ROpChoiceAt, Fx.l2(4, 1), Fx.l2(Fx.p(Fx.RResChoice, Fx.vs(Fx.l5(0, 1, 2, 3, 4))), Fx.n(Fx.RSelf, Fx.vs(Fx.l1(3)))))
  val choiceProto = Fx.rule(Fx.ROpChoiceAt, Fx.l2(4, 1), Fx.l2(Fx.p(Fx.RResChoice, Fx.vs(Fx.l5(0, 1, 2, 3, 4))), Fx.n(Fx.RTyBinder, Fx.vs(Fx.l3(1, 2, 0)))))
  val choiceCount = Fx.rule(Fx.ROpChoiceAt, Fx.l2(4, 1), Fx.l2(Fx.p(Fx.RResCount, Fx.vs(Fx.l4(0, 1, 5, 4))), Fx.n(Fx.RTyArity, Fx.vs(Fx.l2(1, 5)))))
  val e = Fx.l4(opCap, choiceSelf, choiceProto, choiceCount)
  Coll.revOnto(Coll.rev(a), Coll.revOnto(Coll.rev(b), Coll.revOnto(Coll.rev(c), Coll.revOnto(Coll.rev(d), e))))

// ── facts ──
def Fx.s(x: Sym.Sym): D.Val = D.VSym(x)
def Fx.i(n: I64): D.Val = D.VInt(n)
def Fx.fact(rel: Fx.Rel, vs: Coll.List[D.Val]): D.Fact = D.Fact(Fx.relSym(rel), vs)

// the walk: the next id (atoms, rule defs) and the facts
enum Fx.St:
  case Fx.St(next: I64, facts: Coll.List[D.Fact])

def Fx.add(st: Fx.St, f: D.Fact): Fx.St =
  val Fx.St(n, fs) = st
  Fx.St(n, Coll.Cons(f, fs))

def Fx.fresh(st: Fx.St): I64 =
  val Fx.St(n, _) = st
  n

def Fx.bump(st: Fx.St): Fx.St =
  val Fx.St(n, fs) = st
  Fx.St(n + 1, fs)

// a state or a variable: a name that starts with an upper-case letter is a state
def Fx.isConst(x: Sym.Sym): Bool =
  val c = Str.at(Sym.str(x), 0)
  c >= 65 && c <= 90

def Fx.sameNs(n: I64, st: Fx.St): Fx.St = if n < 0 then st else Fx.sameNs(n - 1, Fx.add(st, Fx.fact(Fx.RSameN, Fx.l2(Fx.i(n), Fx.i(n)))))

def Fx.facts(ds: Coll.List[Ast.Decl]): Coll.List[D.Fact] =
  val ps = Pure.protos(ds, Coll.Nil)
  val Fx.St(_, fs) = Fx.decls(ps, ds, Fx.add(Fx.sameNs(16, Fx.St(0, Coll.Nil)), Fx.fact(Fx.RSelf, Fx.l1(Fx.s(Sym.of("self"))))))
  fs

def Fx.decls(ps: Coll.List[Sym.Sym], ds: Coll.List[Ast.Decl], st: Fx.St): Fx.St = ds match
  case Coll.Nil => st
  case Coll.Cons(d, rest) => d match
    case Ast.DProto(p) => Fx.decls(ps, rest, Fx.proto(p, st))
    case Ast.DFn(f) => Fx.decls(ps, rest, Fx.fn(ps, f, st))
    case Ast.DType(td) =>
      val Ast.TypeDecl(_, n, gs, _, _) = td
      val ev = Ty.evidence(gs, Coll.Nil)
      val st1 = Fx.add(Fx.tyBinders(n, ev, 0, st), Fx.fact(Fx.RTyArity, Fx.l2(Fx.s(n), Fx.i(Coll.length(ev)))))
      Fx.decls(ps, rest, Fx.groups(n, gs, Fx.caps(ps, n, ev, st1)))
    case _ => Fx.decls(ps, rest, st)

def Fx.proto(p: Ast.Proto, st: Fx.St): Fx.St =
  val Ast.Proto(_, n, states, _, _, _, ops, rules) = p
  Fx.ruleDefs(n, rules, Fx.opsF(n, ops, Fx.statesF(n, states, st)))

def Fx.statesF(p: Sym.Sym, ss: Coll.List[Sym.Sym], st: Fx.St): Fx.St = ss match
  case Coll.Nil => st
  case Coll.Cons(s, rest) => Fx.statesF(p, rest, Fx.add(Fx.add(st, Fx.fact(Fx.RState, Fx.l2(Fx.s(p), Fx.s(s)))), Fx.fact(Fx.RSameS, Fx.l2(Fx.s(s), Fx.s(s)))))

def Fx.opsF(p: Sym.Sym, os: Coll.List[Ast.Op], st: Fx.St): Fx.St = os match
  case Coll.Nil => st
  case Coll.Cons(o, rest) =>
    val Ast.Op(line, n, ogs, _, ret, trs) = o
    Fx.opsF(p, rest, Fx.resF(p, line, ret, Fx.binderNames(Ty.evidence(ogs, Coll.Nil), Coll.Nil), Fx.trsF(p, n, line, trs, Fx.add(st, Fx.fact(Fx.ROpOf, Fx.l2(Fx.s(p), Fx.s(n)))))))

// the names of binders: an op result T<r> may name a {r: Region} binder of the op itself (the caller's capability it takes)
def Fx.binderNames(bs: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, _) = b
    Fx.binderNames(rest, Coll.Cons(x, acc))

// where an op result of capability p lives: fxResCap(p, x, line) per name of <...>; fxResChoice(p, T, i, x, line) per
// name of T{...} and fxResCount(p, T, n, line)
def Fx.resF(p: Sym.Sym, line: I64, ret: Ast.Ty, own: Coll.List[Sym.Sym], st: Fx.St): Fx.St =
  val Ast.Ty(_, t, _, caps, _) = ret
  caps match
    case Ast.Inferred => st
    case Ast.Stated(xs) => Fx.resCaps(p, line, xs, own, st)
    case Ast.Chosen(xs) => Fx.resChoices(p, t, line, xs, 0, Fx.add(st, Fx.fact(Fx.RResCount, Fx.l4(Fx.s(p), Fx.s(t), Fx.i(Coll.length(xs)), Fx.i(line)))))

def Fx.resCaps(p: Sym.Sym, line: I64, xs: Coll.List[Sym.Sym], own: Coll.List[Sym.Sym], st: Fx.St): Fx.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) => Fx.resCaps(p, line, rest, own, if Ty.memberSym(x, own) then st else Fx.add(st, Fx.fact(Fx.RResCap, Fx.l3(Fx.s(p), Fx.s(x), Fx.i(line)))))

def Fx.resChoices(p: Sym.Sym, t: Sym.Sym, line: I64, xs: Coll.List[Sym.Sym], i: I64, st: Fx.St): Fx.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) => Fx.resChoices(p, t, line, rest, i + 1, Fx.add(st, Fx.fact(Fx.RResChoice, Fx.l5(Fx.s(p), Fx.s(t), Fx.i(i), Fx.s(x), Fx.i(line)))))

// fxTyBinder(T, i, P): the i-th {} binder of type T has type P
def Fx.tyBinders(t: Sym.Sym, bs: Coll.List[Ast.Binder], i: I64, st: Fx.St): Fx.St = bs match
  case Coll.Nil => st
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, ty) = b
    val Ast.Ty(_, n, _, _, _) = ty
    Fx.tyBinders(t, rest, i + 1, Fx.add(st, Fx.fact(Fx.RTyBinder, Fx.l3(Fx.s(t), Fx.i(i), Fx.s(n)))))

// fxTr(p, op, s, t, line): op of p goes from s to t
def Fx.trsF(p: Sym.Sym, op: Sym.Sym, line: I64, trs: Coll.List[Ast.Trans], st: Fx.St): Fx.St = trs match
  case Coll.Nil => st
  case Coll.Cons(t, rest) =>
    val Ast.Trans(a, b) = t
    Fx.trsF(p, op, line, rest, Fx.add(st, Fx.fact(Fx.RTr, Fx.l5(Fx.s(p), Fx.s(op), Fx.s(a), Fx.s(b), Fx.i(line)))))

// a rule def: its relation and arity; reserved names; its params; its body's names and relations
def Fx.ruleDefs(p: Sym.Sym, rs: Coll.List[Ast.RuleDef], st: Fx.St): Fx.St = rs match
  case Coll.Nil => st
  case Coll.Cons(rd, rest) =>
    val Ast.RuleDef(line, n, params, body) = rd
    val rid = Fx.fresh(st)
    val st1 = Fx.add(Fx.bump(st), Fx.fact(Fx.RRuleRel, Fx.l4(Fx.s(p), Fx.s(n), Fx.i(Coll.length(params)), Fx.i(line))))
    val st2 = if Fx.builtinRel(n) then Fx.add(st1, Fx.fact(Fx.RReserved, Fx.l2(Fx.s(n), Fx.i(line)))) else st1
    Fx.ruleDefs(p, rest, Fx.bodyAtoms(p, rid, body, Fx.params(rid, line, params, st2)))

def Fx.builtinRel(n: Sym.Sym): Bool = Str.eq(Sym.str(n), "at") || Str.eq(Sym.str(n), "next")

def Fx.params(rid: I64, line: I64, xs: Coll.List[Sym.Sym], st: Fx.St): Fx.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) => Fx.params(rid, line, rest, Fx.add(st, Fx.fact(Fx.RParam, Fx.l3(Fx.i(rid), Fx.s(x), Fx.i(line)))))

def Fx.bodyAtoms(p: Sym.Sym, rid: I64, as: Coll.List[Ast.Atom], st: Fx.St): Fx.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) =>
    val Ast.Atom(line, rel, args) = a
    val st1 = Fx.bodyNames(rid, args, st)
    Fx.bodyAtoms(p, rid, rest, Fx.bodyRel(p, line, rel, args, st1))

// next names an op; at is the protocol's own; any other relation is a use of a rule def
def Fx.bodyRel(p: Sym.Sym, line: I64, rel: Sym.Sym, args: Coll.List[Ast.Term], st: Fx.St): Fx.St =
  if Str.eq(Sym.str(rel), "next") then Fx.ruleNext(p, line, args, st)
  else if Str.eq(Sym.str(rel), "at") then st
  else Fx.add(st, Fx.fact(Fx.RRUse, Fx.l3(Fx.s(p), Fx.s(rel), Fx.i(line))))

def Fx.bodyNames(rid: I64, ts: Coll.List[Ast.Term], st: Fx.St): Fx.St = ts match
  case Coll.Nil => st
  case Coll.Cons(t, rest) => t match
    case Ast.TName(x) => Fx.bodyNames(rid, rest, Fx.add(st, Fx.fact(Fx.RBodyVar, Fx.l2(Fx.i(rid), Fx.s(x)))))
    case Ast.TNum(_) => Fx.bodyNames(rid, rest, st)

// the op of next(s, op, t): its second arg
def Fx.ruleNext(p: Sym.Sym, line: I64, ts: Coll.List[Ast.Term], st: Fx.St): Fx.St = Fx.nth(ts, 1) match
  case Coll.Some(op) => Fx.add(st, Fx.fact(Fx.RRNext, Fx.l3(Fx.s(p), Fx.s(op), Fx.i(line))))
  case Coll.None => st

def Fx.nth(ts: Coll.List[Ast.Term], i: I64): Coll.Option[Sym.Sym] = ts match
  case Coll.Nil => Coll.None
  case Coll.Cons(t, rest) =>
    if i == 0 then t match
      case Ast.TName(x) => Coll.Some(x)
      case Ast.TNum(_) => Coll.None
    else Fx.nth(rest, i - 1)

// a def: its {} capabilities, its entry groups (g 0) and its exit facts (g 1)
def Fx.fn(ps: Coll.List[Sym.Sym], f: Ast.Fn, st: Fx.St): Fx.St =
  val Ast.Fn(_, d, gs, _, _, exit, _) = f
  val st1 = Fx.caps(ps, d, Ty.evidence(gs, Coll.Nil), st)
  Fx.atoms(d, 1, exit, Fx.groups(d, gs, st1))

def Fx.caps(ps: Coll.List[Sym.Sym], d: Sym.Sym, bs: Coll.List[Ast.Binder], st: Fx.St): Fx.St = bs match
  case Coll.Nil => st
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Fx.caps(ps, d, rest, if Ty.memberSym(n, ps) then Fx.add(st, Fx.fact(Fx.RCap, Fx.l3(Fx.s(d), Fx.s(x), Fx.s(n)))) else st)

def Fx.groups(d: Sym.Sym, gs: Coll.List[Ast.Group], st: Fx.St): Fx.St = gs match
  case Coll.Nil => st
  case Coll.Cons(g, rest) => g match
    case Ast.Facts(as) => Fx.groups(d, rest, Fx.atoms(d, 0, as, st))
    case _ => Fx.groups(d, rest, st)

def Fx.atoms(d: Sym.Sym, g: I64, as: Coll.List[Ast.Atom], st: Fx.St): Fx.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) => Fx.atoms(d, g, rest, Fx.atom(d, g, a, st))

def Fx.atom(d: Sym.Sym, g: I64, a: Ast.Atom, st: Fx.St): Fx.St =
  val Ast.Atom(line, rel, args) = a
  val rn = Sym.str(rel)
  if Str.eq(rn, "at") then Fx.atAtom(d, g, line, args, st)
  else
    val st1 = Fx.varsFrom(d, g, line, args, 0, Fx.opPos(rel), st)
    if Str.eq(rn, "next") then Fx.nth(args, 1) match
      case Coll.Some(op) => Fx.add(st1, Fx.fact(Fx.RUseNext, Fx.l3(Fx.s(d), Fx.s(op), Fx.i(line))))
      case Coll.None => st1
    else
      val st2 = Fx.add(st1, Fx.fact(Fx.RUseRel, Fx.l4(Fx.s(d), Fx.s(rel), Fx.i(Coll.length(args)), Fx.i(line))))
      if g == 1 then Fx.add(st2, Fx.fact(Fx.RExitOther, Fx.l2(Fx.s(rel), Fx.i(line)))) else st2

// at(x, S): x a capability; S a state (constant) or a variable; one id per at atom (two of one x in a group clash)
def Fx.atAtom(d: Sym.Sym, g: I64, line: I64, args: Coll.List[Ast.Term], st: Fx.St): Fx.St = Fx.nth(args, 0) match
  case Coll.None => st
  case Coll.Some(x) =>
    val id = Fx.fresh(st)
    val st1 = Fx.add(Fx.add(Fx.add(Fx.add(Fx.bump(st), Fx.fact(Fx.RUseAt, Fx.l4(Fx.s(d), Fx.i(g), Fx.s(x), Fx.i(line)))), Fx.fact(Fx.RAtId, Fx.l4(Fx.s(d), Fx.i(g), Fx.s(x), Fx.i(id)))), Fx.fact(Fx.RAtLine, Fx.l2(Fx.i(id), Fx.i(line)))), Fx.fact(Fx.RSameId, Fx.l2(Fx.i(id), Fx.i(id))))
    Fx.nth(args, 1) match
      case Coll.None => st1
      case Coll.Some(s) =>
        if Fx.isConst(s) then Fx.add(st1, Fx.fact(Fx.RAtState, Fx.l5(Fx.s(d), Fx.i(g), Fx.s(x), Fx.s(s), Fx.i(line))))
        else Fx.add(st1, Fx.fact(Fx.RVarIn, Fx.l4(Fx.s(d), Fx.i(g), Fx.s(s), Fx.i(line))))

// the variables of an atom: its lower-case names, except the op of next(s, op, t) (Fx.opPos)
def Fx.varsFrom(d: Sym.Sym, g: I64, line: I64, ts: Coll.List[Ast.Term], i: I64, op: Coll.Option[I64], st: Fx.St): Fx.St = ts match
  case Coll.Nil => st
  case Coll.Cons(t, rest) => t match
    case Ast.TNum(_) => Fx.varsFrom(d, g, line, rest, i + 1, op, st)
    case Ast.TName(x) =>
      if Fx.isConst(x) || Fx.isPos(op, i) then Fx.varsFrom(d, g, line, rest, i + 1, op, st)
      else Fx.varsFrom(d, g, line, rest, i + 1, op, Fx.add(st, Fx.fact(Fx.RVarIn, Fx.l4(Fx.s(d), Fx.i(g), Fx.s(x), Fx.i(line)))))

// ── the verdict: each clash relation read as (line, name) ──
def Fx.check(ds: Coll.List[Ast.Decl]): Fx.Verdict = D.solve(Fx.rules(), Fx.facts(ds)) match
  case D.Solved(m) => Fx.ambigRows(D.tuples(m, Fx.relSym(Fx.RAmbigAt)), Coll.Nil) match
    case Coll.Some(acc) => Fx.readAll(m, Fx.kinds(), acc)
    case Coll.None => Fx.RulesBad(Fx.relSym(Fx.RAmbigAt))
  case D.Unsafe(rel) => Fx.RulesBad(rel)
  case D.NegCycle(rel) => Fx.RulesBad(rel)

def Fx.kinds(): Coll.List[Fx.Rel] =
  val a = Fx.l5(Fx.RNotCapAt, Fx.RBadStateAt, Fx.RTwiceAt, Fx.RNotOpAt, Fx.RUnknownRelAt)
  val b = Fx.l4(Fx.RRelArityAt, Fx.RUnboundAt, Fx.RExitOtherAt, Fx.RReservedAt)
  val c = Fx.l4(Fx.RClauseArityAt, Fx.RUnsafeAt, Fx.RRuleUnknownAt, Fx.RRuleOpAt)
  Coll.revOnto(Coll.rev(a), Coll.revOnto(Coll.rev(b), Coll.revOnto(Coll.rev(c), Fx.l2(Fx.ROpCapAt, Fx.ROpChoiceAt))))

def Fx.readAll(m: D.Model, ks: Coll.List[Fx.Rel], acc: Coll.List[Fx.Clash]): Fx.Verdict = ks match
  case Coll.Nil => acc match
    case Coll.Nil => Fx.Ok
    case Coll.Cons(_, _) => Fx.Bad(Coll.rev(acc))
  case Coll.Cons(k, rest) => Fx.rows(k, D.tuples(m, Fx.relSym(k)), acc) match
    case Coll.Some(acc2) => Fx.readAll(m, rest, acc2)
    case Coll.None => Fx.RulesBad(Fx.relSym(k))

def Fx.rows(k: Fx.Rel, ts: Coll.List[Coll.List[D.Val]], acc: Coll.List[Fx.Clash]): Coll.Option[Coll.List[Fx.Clash]] = ts match
  case Coll.Nil => Coll.Some(acc)
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(a, more) => more match
      case Coll.Cons(b, _) => a match
        case D.VInt(line) => b match
          case D.VSym(n) => Fx.make(k, line, n) match
            case Coll.Some(c) => Fx.rows(k, rest, Coll.Cons(c, acc))
            case Coll.None => Coll.None
          case D.VInt(_) => Coll.None
        case D.VSym(_) => Coll.None
      case Coll.Nil => Coll.None
    case Coll.Nil => Coll.None

// fxAmbigAt rows are (line, op, state)
def Fx.ambigRows(ts: Coll.List[Coll.List[D.Val]], acc: Coll.List[Fx.Clash]): Coll.Option[Coll.List[Fx.Clash]] = ts match
  case Coll.Nil => Coll.Some(acc)
  case Coll.Cons(t, rest) => t match
    case Coll.Cons(a, r1) => r1 match
      case Coll.Cons(b, r2) => r2 match
        case Coll.Cons(c, _) => a match
          case D.VInt(line) => b match
            case D.VSym(op) => c match
              case D.VSym(s) => Fx.ambigRows(rest, Coll.Cons(Fx.Ambiguous(line, op, s), acc))
              case D.VInt(_) => Coll.None
            case D.VInt(_) => Coll.None
          case D.VSym(_) => Coll.None
        case Coll.Nil => Coll.None
      case Coll.Nil => Coll.None
    case Coll.Nil => Coll.None

def Fx.make(k: Fx.Rel, line: I64, n: Sym.Sym): Coll.Option[Fx.Clash] = k match
  case Fx.RNotCapAt => Coll.Some(Fx.NotCap(line, n))
  case Fx.RBadStateAt => Coll.Some(Fx.BadState(line, n))
  case Fx.RTwiceAt => Coll.Some(Fx.Twice(line, n))
  case Fx.RNotOpAt => Coll.Some(Fx.NotOp(line, n))
  case Fx.RUnknownRelAt => Coll.Some(Fx.UnknownRel(line, n))
  case Fx.RRelArityAt => Coll.Some(Fx.RelArity(line, n))
  case Fx.RUnboundAt => Coll.Some(Fx.Unbound(line, n))
  case Fx.RExitOtherAt => Coll.Some(Fx.ExitOther(line, n))
  case Fx.RReservedAt => Coll.Some(Fx.Reserved(line, n))
  case Fx.RClauseArityAt => Coll.Some(Fx.ClauseArity(line, n))
  case Fx.RUnsafeAt => Coll.Some(Fx.Unsafe(line, n))
  case Fx.RRuleUnknownAt => Coll.Some(Fx.RuleUnknown(line, n))
  case Fx.RRuleOpAt => Coll.Some(Fx.RuleOp(line, n))
  case Fx.ROpCapAt => Coll.Some(Fx.OpCap(line, n))
  case Fx.ROpChoiceAt => Coll.Some(Fx.OpChoice(line, n))
  case _ => Coll.None

// the position of an op name in an atom: next(s, op, t) has one at 1, other relations none
def Fx.opPos(rel: Sym.Sym): Coll.Option[I64] = if Str.eq(Sym.str(rel), "next") then Coll.Some(1) else Coll.None

def Fx.isPos(op: Coll.Option[I64], i: I64): Bool = op match
  case Coll.Some(j) => i == j
  case Coll.None => false
