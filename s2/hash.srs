// s2 content hashes (s1/hash.srs, vic-uw3 H1; vic 2026-11-06: Unison hashing, names are metadata). the hash of a decl =
// the BLAKE3 (s2/b3.srs) of the canonical token stream of its Ast: a local as its binding position (innermost first), a
// ref to another decl as that decl's hash, a ref inside its own SCC as the member's position (members ordered by their
// first-pass hash). the stream starts with the format and the rule-set version, so a change of either is a new key.

// the digest: the 256 bits of the BLAKE3 as four I64 words (each two little-endian U32 words of it); the name of a store entry
enum Hs.Dg:
  case Hs.Dg(a: I64, b: I64, c: I64, d: I64)

// the stream so far, newest token first (the walk adds, Hs.fin prints it oldest first, one tail loop each)
enum Hs.Tk:
  case Hs.TNil
  case Hs.TInt(x: I64, rest: Hs.Tk)
  case Hs.TStr(s: Str, rest: Hs.Tk)

// the rules of the walk below (what each token means): any change to them bumps this, and every hash and store entry is new
def Hs.version(): I64 = 1

// the digest and store format: 1 was digest (a) (4 lanes mod primes), 2 is BLAKE3 of the token text; old entries are misses
def Hs.format(): I64 = 2

// an empty stream of kind k (0 a decl, 9 a component): the format and the version first
def Hs.start(k: I64): Hs.Tk = Hs.add(Hs.add(Hs.add(Hs.TNil, Hs.format()), Hs.version()), k)

def Hs.add(g: Hs.Tk, x: I64): Hs.Tk = Hs.TInt(x, g)

// a string: its length, then its bytes (the length keeps it prefix-free)
def Hs.str(g: Hs.Tk, s: Str): Hs.Tk = Hs.TStr(s, Hs.add(g, Str.len(s)))

def Hs.dg(g: Hs.Tk, h: Hs.Dg): Hs.Tk =
  val Hs.Dg(a, b, c, d) = h
  Hs.add(Hs.add(Hs.add(Hs.add(g, a), b), c), d)

def Hs.rev(g: Hs.Tk, acc: Hs.Tk): Hs.Tk = g match
  case Hs.TNil => acc
  case Hs.TInt(x, rest) => Hs.rev(rest, Hs.TInt(x, acc))
  case Hs.TStr(s, rest) => Hs.rev(rest, Hs.TStr(s, acc))

// the text of a stream, oldest first: an integer in decimal and ";", a string as its bytes and ";"
def Hs.emit(g: Hs.Tk): Unit = g match
  case Hs.TNil => ()
  case Hs.TInt(x, rest) =>
    Console.printI64(x)
    Console.print(";")
    Hs.emit(rest)
  case Hs.TStr(s, rest) =>
    Console.print(s)
    Console.print(";")
    Hs.emit(rest)

def Hs.word(lo: U32, hi: U32): I64 = I64.ofU64(U64.of(lo) | U64.of(hi) << 32)

// the digest of a stream
def Hs.fin(g: Hs.Tk): Hs.Dg =
  Console.captureBegin()
  Hs.emit(Hs.rev(g, Hs.TNil))
  val B3.Hash(h0, h1, h2, h3, h4, h5, h6, h7) = B3.hash(Console.captureEnd())
  Hs.Dg(Hs.word(h0, h1), Hs.word(h2, h3), Hs.word(h4, h5), Hs.word(h6, h7))

def Hs.less(x: Hs.Dg, y: Hs.Dg): Bool =
  val Hs.Dg(a, b, c, d) = x
  val Hs.Dg(a2, b2, c2, d2) = y
  a < a2 || a == a2 && (b < b2 || b == b2 && (c < c2 || c == c2 && d < d2))

// ── the walk: pass 1 hashes a ref to an SCC member as one token, pass 2 as the member's position ──
enum Hs.Pass:
  case Hs.First
  case Hs.Second

enum Hs.Cx:
  case Hs.Cx(hm: Coll.SMap[Hs.Dg], mem: Coll.List[Sym.Sym], pass: Hs.Pass)

// a name: a local (its position, only where a local can stand), a member of this SCC, or a ref (a hash, else its text)
enum Hs.Where:
  case Hs.Local
  case Hs.Global

def Hs.name(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, x: Sym.Sym, w: Hs.Where): Hs.Tk =
  val Hs.Cx(hm, mem, pass) = cx
  val pos: Coll.Option[I64] = w match
    case Hs.Local => Hs.index(env, x, 0)
    case Hs.Global => Coll.None
  pos match
    case Coll.Some(i) => Hs.add(Hs.add(g, 3), i)
    case Coll.None => Hs.index(mem, x, 0) match
      case Coll.Some(i) => pass match
        case Hs.First => Hs.add(g, 5)
        case Hs.Second => Hs.add(Hs.add(g, 6), i)
      case Coll.None => Coll.sLookup(hm, x) match
        case Coll.Some(h) => Hs.dg(Hs.add(g, 4), h)
        case Coll.None => Hs.str(Hs.add(g, 2), Sym.str(x))

def Hs.index(xs: Coll.List[Sym.Sym], x: Sym.Sym, i: I64): Coll.Option[I64] = xs match
  case Coll.Nil => Coll.None
  case Coll.Cons(y, rest) => if Sym.eq(x, y) then Coll.Some(i) else Hs.index(rest, x, i + 1)

// a hash and the locals after it (binders pass their names on)
enum Hs.W:
  case Hs.W(g: Hs.Tk, env: Coll.List[Sym.Sym])

def Hs.ty(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, t: Ast.Ty): Hs.Tk =
  val Ast.Ty(_, n, args, _, vals) = t
  Hs.exprs(cx, env, Hs.tys(cx, env, Hs.name(cx, env, Hs.add(Hs.add(g, 9), Coll.length(args)), n, Hs.Local), args), vals)

def Hs.tys(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, ts: Coll.List[Ast.Ty]): Hs.Tk = ts match
  case Coll.Nil => g
  case Coll.Cons(t, rest) => Hs.tys(cx, env, Hs.ty(cx, env, g, t), rest)

def Hs.binOp(op: Ast.BinOp): I64 = op match
  case Ast.Add => 0
  case Ast.Sub => 1
  case Ast.Mul => 2
  case Ast.Div => 3
  case Ast.Mod => 4
  case Ast.Lt => 5
  case Ast.Le => 6
  case Ast.Gt => 7
  case Ast.Ge => 8
  case Ast.Eq => 9
  case Ast.Ne => 10
  case Ast.And => 11
  case Ast.Or => 12
  case Ast.BitOr => 13
  case Ast.BitXor => 14
  case Ast.BitAnd => 15
  case Ast.Shl => 16
  case Ast.Shr => 17

def Hs.expr(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, e: Ast.Expr): Hs.Tk = e match
  case Ast.Int(_, v) => Hs.add(Hs.add(g, 32), v)
  case Ast.Bool(_, v) => Hs.add(Hs.add(g, 33), if v then 1 else 0)
  case Ast.Str(_, s) => Hs.str(Hs.add(g, 34), s)
  case Ast.Unit(_) => Hs.add(g, 35)
  case Ast.Name(_, x) => Hs.name(cx, env, Hs.add(g, 36), x, Hs.Local)
  case Ast.Call(_, f, targs, chosen, xs) =>
    val g1 = Hs.name(cx, env, Hs.add(Hs.add(Hs.add(g, 37), Coll.length(xs)), Coll.length(targs)), f, Hs.Global)
    Hs.exprs(cx, env, Hs.names(cx, env, Hs.tys(cx, env, g1, targs), chosen), xs)
  case Ast.Method(_, recv, op, xs) =>
    Hs.exprs(cx, env, Hs.str(Hs.name(cx, env, Hs.add(Hs.add(g, 42), Coll.length(xs)), recv, Hs.Local), Sym.str(op)), xs)
  case Ast.Resume(_, k, x) => Hs.expr(cx, env, Hs.name(cx, env, Hs.add(g, 72), k, Hs.Local), x)
  case Ast.Bin(_, op, l, x) => Hs.expr(cx, env, Hs.expr(cx, env, Hs.add(Hs.add(g, 43), Hs.binOp(op)), l), x)
  case Ast.Un(_, op, x) =>
    val k = op match
      case Ast.Neg => 0
      case Ast.Not => 1
      case Ast.BitNot => 2
    Hs.expr(cx, env, Hs.add(Hs.add(g, 44), k), x)
  case Ast.If(_, _, c, t, x) => Hs.expr(cx, env, Hs.expr(cx, env, Hs.expr(cx, env, Hs.add(g, 45), c), t), x)
  case Ast.Match(_, _, s, arms) => Hs.arms(cx, env, Hs.expr(cx, env, Hs.add(Hs.add(g, 46), Coll.length(arms)), s), arms)
  case Ast.Block(_, _, ss, last) =>
    val Hs.W(g1, env1) = Hs.stmts(cx, Hs.W(Hs.add(Hs.add(g, 50), Coll.length(ss)), env), ss)
    Hs.expr(cx, env1, g1, last)
  case Ast.While(_, c, b) => Hs.expr(cx, env, Hs.expr(cx, env, Hs.add(g, 51), c), b)
  case Ast.Assign(_, x, v) => Hs.expr(cx, env, Hs.name(cx, env, Hs.add(g, 52), x, Hs.Local), v)
  case Ast.Quant(_, q, x, t, b) =>
    val k = q match
      case Ast.Forall => 47
      case Ast.Exists => 48
    Hs.expr(cx, Coll.Cons(x, env), Hs.ty(cx, env, Hs.add(g, k), t), b)

def Hs.exprs(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, xs: Coll.List[Ast.Expr]): Hs.Tk = xs match
  case Coll.Nil => g
  case Coll.Cons(x, rest) => Hs.exprs(cx, env, Hs.expr(cx, env, g, x), rest)

def Hs.names(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, xs: Coll.List[Sym.Sym]): Hs.Tk = xs match
  case Coll.Nil => g
  case Coll.Cons(x, rest) => Hs.names(cx, env, Hs.name(cx, env, g, x, Hs.Local), rest)

// an arm: its case (a ref), its binders bound in its body (each one, `_` too: positions stay fixed)
def Hs.arms(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, as: Coll.List[Ast.Arm]): Hs.Tk = as match
  case Coll.Nil => g
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, p, b) = a
    val g2 = p match
      case Ast.PAny => Hs.expr(cx, env, Hs.add(g, 49), b)
      case Ast.PCase(c, binds) =>
        Hs.expr(cx, Coll.revOnto(binds, env), Hs.add(Hs.name(cx, env, Hs.add(g, 49), c, Hs.Global), Coll.length(binds)), b)
    Hs.arms(cx, env, g2, rest)

def Hs.stmts(cx: Hs.Cx, w: Hs.W, ss: Coll.List[Ast.Stmt]): Hs.W = ss match
  case Coll.Nil => w
  case Coll.Cons(s, rest) =>
    val Hs.W(g, env) = w
    val w2 = s match
      case Ast.Val(_, _, x, ann, e) => Hs.W(Hs.expr(cx, env, Hs.ann(cx, env, Hs.add(g, 53), ann), e), Coll.Cons(x, env))
      case Ast.Var(_, _, x, ann, e) => Hs.W(Hs.expr(cx, env, Hs.ann(cx, env, Hs.add(g, 57), ann), e), Coll.Cons(x, env))
      case Ast.Handle(_, _, x, h, xs) =>
        Hs.W(Hs.exprs(cx, env, Hs.name(cx, env, Hs.add(g, 54), h, Hs.Global), xs), Coll.Cons(x, env))
      case Ast.Do(_, e) => Hs.W(Hs.expr(cx, env, Hs.add(g, 55), e), env)
      case Ast.Check(_, _, k, e) =>
        val c = k match
          case Ast.LInvariant => 0
          case Ast.LDecreases => 1
        Hs.W(Hs.expr(cx, env, Hs.add(Hs.add(g, 56), c), e), env)
    Hs.stmts(cx, w2, rest)

def Hs.ann(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, a: Coll.Option[Ast.Ty]): Hs.Tk = a match
  case Coll.None => Hs.add(g, 0)
  case Coll.Some(t) => Hs.ty(cx, env, Hs.add(g, 1), t)

// binders in order: each type sees the ones before, then its name is the next position
def Hs.binders(cx: Hs.Cx, w: Hs.W, bs: Coll.List[Ast.Binder]): Hs.W = bs match
  case Coll.Nil => w
  case Coll.Cons(b, rest) =>
    val Hs.W(g, env) = w
    val Ast.Binder(_, x, t) = b
    Hs.binders(cx, Hs.W(Hs.ty(cx, env, Hs.add(g, 28), t), Coll.Cons(x, env)), rest)

def Hs.groups(cx: Hs.Cx, w: Hs.W, gs: Coll.List[Ast.Group]): Hs.W = gs match
  case Coll.Nil => w
  case Coll.Cons(gr, rest) =>
    val Hs.W(g, env) = w
    val w2 = gr match
      case Ast.Types(bs) => Hs.binders(cx, Hs.W(Hs.add(g, 26), env), bs)
      case Ast.Evidence(bs) => Hs.binders(cx, Hs.W(Hs.add(g, 27), env), bs)
      case Ast.Facts(as) => Hs.W(Hs.atoms(cx, env, Hs.add(g, 29), as), env)
    Hs.groups(cx, w2, rest)

def Hs.atoms(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, as: Coll.List[Ast.Atom]): Hs.Tk = as match
  case Coll.Nil => g
  case Coll.Cons(a, rest) =>
    val Ast.Atom(_, rel, ts) = a
    Hs.atoms(cx, env, Hs.terms(cx, env, Hs.str(Hs.add(g, Coll.length(ts)), Sym.str(rel)), ts), rest)

def Hs.terms(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, ts: Coll.List[Ast.Term]): Hs.Tk = ts match
  case Coll.Nil => g
  case Coll.Cons(t, rest) =>
    val g2 = t match
      case Ast.TName(x) => Hs.name(cx, env, Hs.add(g, 30), x, Hs.Local)
      case Ast.TNum(v) => Hs.add(Hs.add(g, 31), v)
    Hs.terms(cx, env, g2, rest)

def Hs.clauses(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, cs: Coll.List[Ast.Clause]): Hs.Tk = cs match
  case Coll.Nil => g
  case Coll.Cons(c, rest) =>
    val g2 = c match
      case Ast.CondC(_, k, e) =>
        val kc = k match
          case Ast.Requires => 0
          case Ast.Ensures => 1
          case Ast.Returns => 2
          case Ast.Decreases => 3
          case Ast.Invariant => 4
        Hs.expr(cx, env, Hs.add(Hs.add(g, 58), kc), e)
      case Ast.ProofUsing(_, xs) => Hs.names(cx, env, Hs.add(g, 59), xs)
      case Ast.ProofInduction(_, x) => Hs.name(cx, env, Hs.add(g, 60), x, Hs.Local)
      case Ast.ProofLean(_, s) => Hs.str(Hs.add(g, 61), s)
    Hs.clauses(cx, env, g2, rest)

// a def: its groups, params, result, exit facts, then its body and clauses (all see the params)
def Hs.fn(cx: Hs.Cx, f: Ast.Fn): Hs.Tk =
  val Ast.Fn(_, _, _, gs, ps, ret, exit, body) = f
  val Hs.W(g1, env1) = Hs.groups(cx, Hs.W(Hs.add(Hs.start(0), 12), Coll.Nil), gs)
  val Hs.W(g2, env2) = Hs.binders(cx, Hs.W(Hs.add(g1, Coll.length(ps)), env1), ps)
  val g3 = Hs.atoms(cx, env2, Hs.ty(cx, env2, g2, ret), exit)
  body match
    case Ast.Extern(_) => Hs.add(g3, 70)
    case Ast.Def(cs, e) => Hs.clauses(cx, env2, Hs.expr(cx, env2, Hs.add(g3, 71), e), cs)

// an enum: its groups, then each case's fields (the field and case names are metadata: positions only)
def Hs.enum_(cx: Hs.Cx, e: Ast.Enum): Hs.Tk =
  val Ast.Enum(_, _, _, gs, cases) = e
  val Hs.W(g1, env1) = Hs.groups(cx, Hs.W(Hs.add(Hs.start(0), 13), Coll.Nil), gs)
  Hs.cases(cx, env1, Hs.add(g1, Coll.length(cases)), cases)

def Hs.cases(cx: Hs.Cx, env: Coll.List[Sym.Sym], g: Hs.Tk, cs: Coll.List[Ast.Case]): Hs.Tk = cs match
  case Coll.Nil => g
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, _, fs) = c
    val Hs.W(g2, _) = Hs.binders(cx, Hs.W(Hs.add(Hs.add(g, 14), Coll.length(fs)), env), fs)
    Hs.cases(cx, env, g2, rest)

// ── the decls of one kind: what each refers to among them (a call names a fn, a type names an enum) ──
enum Hs.D:
  case Hs.DF(f: Ast.Fn)
  case Hs.DE(e: Ast.Enum)

def Hs.hashD(cx: Hs.Cx, d: Hs.D): Hs.Dg = Hs.fin(Hs.walk(cx, d))

def Hs.walk(cx: Hs.Cx, d: Hs.D): Hs.Tk = d match
  case Hs.DF(f) => Hs.fn(cx, f)
  case Hs.DE(e) => Hs.enum_(cx, e)

// the names that d mentions (an over-approximation is fine: only the SCC split depends on it, and only names in ds count)
def Hs.refs(d: Hs.D, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = d match
  case Hs.DF(f) =>
    val Ast.Fn(_, _, _, _, _, _, _, body) = f
    body match
      case Ast.Def(_, e) => Hs.eRefs(e, acc)
      case Ast.Extern(_) => acc
  case Hs.DE(e) =>
    val Ast.Enum(_, _, _, _, cases) = e
    Hs.caseRefs(cases, acc)

def Hs.caseRefs(cs: Coll.List[Ast.Case], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = cs match
  case Coll.Nil => acc
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, _, fs) = c
    Hs.caseRefs(rest, Hs.binderRefs(fs, acc))

def Hs.binderRefs(bs: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    Hs.binderRefs(rest, Hs.tyRefs(t, acc))

def Hs.tyRefs(t: Ast.Ty, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] =
  val Ast.Ty(_, n, args, _, _) = t
  Hs.tysRefs(args, Coll.Cons(n, acc))

def Hs.tysRefs(ts: Coll.List[Ast.Ty], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ts match
  case Coll.Nil => acc
  case Coll.Cons(t, rest) => Hs.tysRefs(rest, Hs.tyRefs(t, acc))

def Hs.eRefs(e: Ast.Expr, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = e match
  case Ast.Name(_, x) => Coll.Cons(x, acc)
  case Ast.Call(_, f, _, _, xs) => Hs.esRefs(xs, Coll.Cons(f, acc))
  case Ast.Method(_, _, _, xs) => Hs.esRefs(xs, acc)
  case Ast.Resume(_, _, x) => Hs.eRefs(x, acc)
  case Ast.Bin(_, _, l, x) => Hs.eRefs(x, Hs.eRefs(l, acc))
  case Ast.Un(_, _, x) => Hs.eRefs(x, acc)
  case Ast.If(_, _, c, t, x) => Hs.eRefs(x, Hs.eRefs(t, Hs.eRefs(c, acc)))
  case Ast.Match(_, _, s, arms) => Hs.armRefs(arms, Hs.eRefs(s, acc))
  case Ast.Block(_, _, ss, last) => Hs.eRefs(last, Hs.stmtRefs(ss, acc))
  case Ast.While(_, c, b) => Hs.eRefs(b, Hs.eRefs(c, acc))
  case Ast.Assign(_, _, x) => Hs.eRefs(x, acc)
  case Ast.Quant(_, _, _, _, b) => Hs.eRefs(b, acc)
  case _ => acc

def Hs.esRefs(xs: Coll.List[Ast.Expr], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Hs.esRefs(rest, Hs.eRefs(x, acc))

def Hs.armRefs(as: Coll.List[Ast.Arm], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = as match
  case Coll.Nil => acc
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, _, b) = a
    Hs.armRefs(rest, Hs.eRefs(b, acc))

def Hs.stmtRefs(ss: Coll.List[Ast.Stmt], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) =>
    val acc2 = s match
      case Ast.Val(_, _, _, _, e) => Hs.eRefs(e, acc)
      case Ast.Var(_, _, _, _, e) => Hs.eRefs(e, acc)
      case Ast.Handle(_, _, _, _, xs) => Hs.esRefs(xs, acc)
      case Ast.Do(_, e) => Hs.eRefs(e, acc)
      case Ast.Check(_, _, _, e) => Hs.eRefs(e, acc)
    Hs.stmtRefs(rest, acc2)

// ── Tarjan's SCCs over the decls of one kind, callees first ──
enum Hs.T:
  case Hs.T(next: I64, idx: Coll.SMap[I64], low: Coll.SMap[I64], stack: Coll.List[Sym.Sym], on: Coll.SMap[Bool], comps: Coll.List[Coll.List[Sym.Sym]])

// the edges of each decl: only names of decls in the map count
def Hs.edges(dm: Coll.SMap[Hs.D], x: Sym.Sym): Coll.List[Sym.Sym] = Coll.sLookup(dm, x) match
  case Coll.None => Coll.Nil
  case Coll.Some(d) => Hs.inMap(dm, Hs.refs(d, Coll.Nil), Coll.Nil)

def Hs.inMap(dm: Coll.SMap[Hs.D], xs: Coll.List[Sym.Sym], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Coll.sLookup(dm, x) match
    case Coll.Some(_) => Hs.inMap(dm, rest, Coll.Cons(x, acc))
    case Coll.None => Hs.inMap(dm, rest, acc)

def Hs.geti(m: Coll.SMap[I64], x: Sym.Sym): I64 = Coll.sLookup(m, x) match
  case Coll.Some(i) => i
  case Coll.None => 0 - 1

def Hs.min(a: I64, b: I64): I64 = if a < b then a else b

def Hs.visit(dm: Coll.SMap[Hs.D], v: Sym.Sym, t: Hs.T): Hs.T =
  val Hs.T(n, idx, low, st, on, cs) = t
  val t1 =
    Hs.T(n + 1, Coll.sInsert(idx, v, n), Coll.sInsert(low, v, n), Coll.Cons(v, st), Coll.sInsert(on, v, true), cs)
  val t2 = Hs.succs(dm, v, Hs.edges(dm, v), t1)
  val Hs.T(n2, idx2, low2, st2, on2, cs2) = t2
  if Hs.geti(low2, v) == Hs.geti(idx2, v) then
    val Hs.Pop(comp, rest, on3) = Hs.pop(v, st2, on2, Coll.Nil)
    Hs.T(n2, idx2, low2, rest, on3, Coll.Cons(comp, cs2))
  else t2

def Hs.succs(dm: Coll.SMap[Hs.D], v: Sym.Sym, ws: Coll.List[Sym.Sym], t: Hs.T): Hs.T = ws match
  case Coll.Nil => t
  case Coll.Cons(w, rest) =>
    val Hs.T(_, idx, _, _, on, _) = t
    if Hs.geti(idx, w) < 0 then
      val t2 = Hs.visit(dm, w, t)
      val Hs.T(n2, idx2, low2, st2, on2, cs2) = t2
      Hs.succs(dm, v, rest, Hs.T(n2, idx2, Coll.sInsert(low2, v, Hs.min(Hs.geti(low2, v), Hs.geti(low2, w))), st2, on2, cs2))
    else if Hs.onStack(on, w) then
      val Hs.T(n2, idx2, low2, st2, on2, cs2) = t
      Hs.succs(dm, v, rest, Hs.T(n2, idx2, Coll.sInsert(low2, v, Hs.min(Hs.geti(low2, v), Hs.geti(idx2, w))), st2, on2, cs2))
    else Hs.succs(dm, v, rest, t)

enum Hs.Pop:
  case Hs.Pop(comp: Coll.List[Sym.Sym], rest: Coll.List[Sym.Sym], on: Coll.SMap[Bool])

// the stack down to v: one component (on-stack marks removed: set to false)
def Hs.pop(v: Sym.Sym, st: Coll.List[Sym.Sym], on: Coll.SMap[Bool], acc: Coll.List[Sym.Sym]): Hs.Pop = st match
  case Coll.Nil => Hs.Pop(acc, Coll.Nil, on)
  case Coll.Cons(x, rest) =>
    val on2 = Coll.sInsert(on, x, false)
    if Sym.eq(x, v) then Hs.Pop(Coll.Cons(x, acc), rest, on2) else Hs.pop(v, rest, on2, Coll.Cons(x, acc))

// the components, callees first (Tarjan emits each after the ones it reaches)
def Hs.comps(dm: Coll.SMap[Hs.D], order: Coll.List[Sym.Sym], t: Hs.T): Coll.List[Coll.List[Sym.Sym]] = order match
  case Coll.Nil =>
    val Hs.T(_, _, _, _, _, cs) = t
    Coll.rev(cs)
  case Coll.Cons(x, rest) =>
    val Hs.T(_, idx, _, _, _, _) = t
    Hs.comps(dm, rest, if Hs.geti(idx, x) < 0 then Hs.visit(dm, x, t) else t)

// ── one component: a decl alone hashes alone; a cycle hashes as one, each member = (component, position) ──
def Hs.comp(dm: Coll.SMap[Hs.D], hm: Coll.SMap[Hs.Dg], ms: Coll.List[Sym.Sym]): Coll.SMap[Hs.Dg] = ms match
  case Coll.Nil => hm
  case Coll.Cons(m, more) =>
    val selfRef = Ty.memberSym(m, Hs.edges(dm, m))
    if Coll.length(more) == 0 && !selfRef then Hs.put(dm, hm, m, Hs.hashOf(dm, Hs.Cx(hm, Coll.Nil, Hs.Second), m))
    else
      val order = Hs.sorted(dm, hm, ms, ms, Coll.Nil)
      val whole = Hs.whole(dm, Hs.Cx(hm, order, Hs.Second), order, Hs.start(9))
      Hs.members(dm, hm, whole, order, 0)

def Hs.hashOf(dm: Coll.SMap[Hs.D], cx: Hs.Cx, m: Sym.Sym): Hs.Dg = Coll.sLookup(dm, m) match
  case Coll.Some(d) => Hs.hashD(cx, d)
  case Coll.None => Hs.Dg(0, 0, 0, 0)

// members by their first-pass hash (insertion sort: equal hashes keep component order)
enum Hs.M:
  case Hs.M(name: Sym.Sym, g: Hs.Dg)

def Hs.sorted(dm: Coll.SMap[Hs.D], hm: Coll.SMap[Hs.Dg], all: Coll.List[Sym.Sym], ms: Coll.List[Sym.Sym], acc: Coll.List[Hs.M]): Coll.List[Sym.Sym] = ms match
  case Coll.Nil => Hs.mNames(acc, Coll.Nil)
  case Coll.Cons(m, rest) =>
    Hs.sorted(dm, hm, all, rest, Hs.ins(acc, Hs.M(m, Hs.hashOf(dm, Hs.Cx(hm, all, Hs.First), m))))

def Hs.ins(xs: Coll.List[Hs.M], m: Hs.M): Coll.List[Hs.M] = xs match
  case Coll.Nil => Coll.Cons(m, Coll.Nil)
  case Coll.Cons(x, rest) =>
    val Hs.M(_, g) = m
    val Hs.M(_, h) = x
    if Hs.less(g, h) then Coll.Cons(m, xs) else Coll.Cons(x, Hs.ins(rest, m))

def Hs.mNames(xs: Coll.List[Hs.M], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = xs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(x, rest) =>
    val Hs.M(n, _) = x
    Hs.mNames(rest, Coll.Cons(n, acc))

def Hs.whole(dm: Coll.SMap[Hs.D], cx: Hs.Cx, ms: Coll.List[Sym.Sym], g: Hs.Tk): Hs.Tk = ms match
  case Coll.Nil => g
  case Coll.Cons(m, rest) => Hs.whole(dm, cx, rest, Hs.dg(g, Hs.hashOf(dm, cx, m)))

def Hs.members(dm: Coll.SMap[Hs.D], hm: Coll.SMap[Hs.Dg], whole: Hs.Tk, ms: Coll.List[Sym.Sym], i: I64): Coll.SMap[Hs.Dg] = ms match
  case Coll.Nil => hm
  case Coll.Cons(m, rest) => Hs.members(dm, Hs.put(dm, hm, m, Hs.fin(Hs.add(Hs.add(whole, 10), i))), whole, rest, i + 1)

// an enum's cases are refs too: (enum hash, tag)
def Hs.put(dm: Coll.SMap[Hs.D], hm: Coll.SMap[Hs.Dg], m: Sym.Sym, g: Hs.Dg): Coll.SMap[Hs.Dg] =
  val hm2 = Coll.sInsert(hm, m, g)
  Coll.sLookup(dm, m) match
    case Coll.Some(d) => d match
      case Hs.DE(e) =>
        val Ast.Enum(_, _, _, _, cases) = e
        Hs.casesPut(hm2, g, cases, 0)
      case Hs.DF(_) => hm2
    case Coll.None => hm2

def Hs.casesPut(hm: Coll.SMap[Hs.Dg], g: Hs.Dg, cs: Coll.List[Ast.Case], i: I64): Coll.SMap[Hs.Dg] = cs match
  case Coll.Nil => hm
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, n, _) = c
    Hs.casesPut(Coll.sInsert(hm, n, Hs.fin(Hs.add(Hs.dg(Hs.start(8), g), i))), g, rest, i + 1)

def Hs.compsPut(dm: Coll.SMap[Hs.D], hm: Coll.SMap[Hs.Dg], cs: Coll.List[Coll.List[Sym.Sym]]): Coll.SMap[Hs.Dg] = cs match
  case Coll.Nil => hm
  case Coll.Cons(c, rest) => Hs.compsPut(dm, Hs.comp(dm, hm, c), rest)

// ── every def (not extern) and enum: enums first, then fns; the hashes by name ──
enum Hs.Split:
  case Hs.Split(es: Coll.SMap[Hs.D], eo: Coll.List[Sym.Sym], fs: Coll.SMap[Hs.D], fo: Coll.List[Sym.Sym])

def Hs.split(ds: Coll.List[Ast.Decl], sp: Hs.Split): Hs.Split = ds match
  case Coll.Nil =>
    val Hs.Split(es, eo, fs, fo) = sp
    Hs.Split(es, Coll.rev(eo), fs, Coll.rev(fo))
  case Coll.Cons(d, rest) =>
    val Hs.Split(es, eo, fs, fo) = sp
    d match
      case Ast.DEnum(e) =>
        val Ast.Enum(_, _, n, _, _) = e
        Hs.split(rest, Hs.Split(Coll.sInsert(es, n, Hs.DE(e)), Coll.Cons(n, eo), fs, fo))
      case Ast.DFn(f) =>
        val Ast.Fn(_, _, n, _, _, _, _, body) = f
        val isExt: Bool = body match
          case Ast.Extern(_) => true
          case _ => false
        if isExt then Hs.split(rest, sp)
        else Hs.split(rest, Hs.Split(es, eo, Coll.sInsert(fs, n, Hs.DF(f)), Coll.Cons(n, fo)))
      case _ => Hs.split(rest, sp)

def Hs.all(ds: Coll.List[Ast.Decl]): Coll.SMap[Hs.Dg] =
  val Hs.Split(es, eo, fs, fo) = Hs.split(ds, Hs.Split(Coll.sEmpty(), Coll.Nil, Coll.sEmpty(), Coll.Nil))
  val t0 = Hs.T(0, Coll.sEmpty(), Coll.sEmpty(), Coll.Nil, Coll.sEmpty(), Coll.Nil)
  val hm1 = Hs.compsPut(es, Coll.sEmpty(), Hs.comps(es, eo, t0))
  Hs.compsPut(fs, hm1, Hs.comps(fs, fo, t0))

// `s2c --hash`: "name a.b.c.d" for every def (not extern) and enum, in program order
def Hs.print(ds: Coll.List[Ast.Decl]): Unit = Hs.printFrom(Hs.all(ds), ds)

def Hs.printFrom(hm: Coll.SMap[Hs.Dg], ds: Coll.List[Ast.Decl]): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, rest) =>
    val n: Coll.Option[Sym.Sym] = d match
      case Ast.DEnum(e) =>
        val Ast.Enum(_, _, en, _, _) = e
        Coll.Some(en)
      case Ast.DFn(f) =>
        val Ast.Fn(_, _, fn, _, _, _, _, _) = f
        Coll.Some(fn)
      case _ => Coll.None
    n match
      case Coll.Some(x) => Coll.sLookup(hm, x) match
        case Coll.Some(g) => Hs.show(x, g)
        case Coll.None => ()
      case Coll.None => ()
    Hs.printFrom(hm, rest)

def Hs.show(n: Sym.Sym, g: Hs.Dg): Unit =
  val Hs.Dg(a, b, c, d) = g
  Console.print(Sym.str(n))
  Console.print(" ")
  Console.printI64(a)
  Console.print(".")
  Console.printI64(b)
  Console.print(".")
  Console.printI64(c)
  Console.print(".")
  Console.printI64(d)
  Console.print("\n")

// on the stack now (a popped node is kept as false)
def Hs.onStack(on: Coll.SMap[Bool], w: Sym.Sym): Bool = Coll.sLookup(on, w) match
  case Coll.Some(b) => b
  case Coll.None => false
