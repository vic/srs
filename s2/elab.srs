// s2 self-host rung T3 (vic/c/s2-selfhost.md "T3 design"): the elaborated program, what mono and emit read. Ty.expr
// builds it while it infers, so the two cannot disagree. a term keeps its vars until mono reifies it with the final
// substitution.

// the C type of an int literal: I64, or U32 or U64 when the expected type is one (Ty.expr)
enum El.IntK:
  case El.KI64
  case El.KU32
  case El.KU64

enum El.Expr:
  case El.Int(line: I64, v: I64, k: El.IntK)
  case El.Bool(line: I64, v: Bool)
  case El.Str(line: I64, s: Str)
  case El.Unit(line: I64)
  // a name bound in the fn: a param, a {} binder, a val, var, handle or pattern binder
  case El.Local(line: I64, x: Sym.Sym)
  // f[targs]{caps}(args): the instance and the caller's capability for each protocol {} binder ({r: Region}, ...), in written order
  case El.CallFn(line: I64, f: Sym.Sym, targs: Coll.List[K.Term], caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr])
  // a constructor: its enum at targs, allocated where at says
  case El.New(line: I64, en: Sym.Sym, targs: Coll.List[K.Term], c: Sym.Sym, at: El.Alloc, args: Coll.List[El.Expr])
  case El.Nullary(line: I64, en: Sym.Sym, targs: Coll.List[K.Term], c: Sym.Sym)
  // the rest of a block after a multi-shot handle x = h(args) (vic-hm63 C3): its value has the block type a; the whole is
  // the handler's answer ans
  case El.MHandled(line: I64, x: Sym.Sym, h: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr], rest: El.Expr, a: K.Term, ans: K.Term)
  // resume k(arg) in a multi-shot op
  case El.Resume(line: I64, k: Sym.Sym, arg: El.Expr)
  // recv.op(args): an op of the capability recv's protocol
  case El.Op(line: I64, recv: Sym.Sym, ty: K.Term, op: Sym.Sym, args: Coll.List[El.Expr], caps: Coll.List[Sym.Sym])
  // recv.op(args) on {} evidence of trait type ty: the given's fn, with the caller's capability for each of the trait
  // method's {} capabilities (vic Q2)
  case El.TCall(line: I64, ty: K.Term, op: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr])
  case El.Bin(line: I64, op: Ast.BinOp, l: El.Expr, rhs: El.Expr)
  case El.Un(line: I64, op: Ast.UnOp, e: El.Expr)
  case El.If(line: I64, c: El.Expr, t: El.Expr, e: El.Expr)
  // scrut is an enum at targs
  case El.Match(line: I64, s: El.Expr, en: K.Term, arms: Coll.List[El.Arm])
  case El.Block(line: I64, stmts: Coll.List[El.Stmt], last: El.Expr)
  case El.While(line: I64, c: El.Expr, body: El.Expr)
  case El.Assign(line: I64, x: Sym.Sym, e: El.Expr)
  // A1 arrays: xs(i) with i proved in range (C p[i], no check); Array.slice(xs, off, m) (C xs + off)
  case El.Index(line: I64, xs: Sym.Sym, i: El.Expr)
  case El.Slice(line: I64, xs: El.Expr, off: El.Expr)
  // Array.fill(n, x) and Array.tabulate[F](n) in region reg: n elements of type elem, each x, or gen with the local i
  // bound to the element's index (gen calls the given's at)
  case El.Fill(line: I64, reg: Sym.Sym, n: El.Expr, x: El.Expr, elem: K.Term)
  case El.Tab(line: I64, reg: Sym.Sym, n: El.Expr, elem: K.Term, i: Sym.Sym, gen: El.Expr)
  // A1 Cell[A]: a new cell holding v (one word in reg); Cell.get(c); Cell.put(c, v)
  case El.CellNew(line: I64, reg: Sym.Sym, v: El.Expr, elem: K.Term)
  case El.CellGet(line: I64, c: El.Expr)
  // extern "libc" struct: a new value in the Region reg (sizeof(struct name) bytes), and a read of one of its fields (the C member by name)
  case El.CNew(line: I64, reg: Sym.Sym, name: Sym.Sym)
  case El.CField(line: I64, c: El.Expr, name: Sym.Sym, field: Sym.Sym, ty: K.Term)
  case El.CellPut(line: I64, c: El.Expr, v: El.Expr)
  // A1b: Array.put(xs, i, v) writes one scalar slot of the local array xs, i proved in [0, n) (C xs[i] = v)
  case El.ArrPut(line: I64, xs: Sym.Sym, i: El.Expr, v: El.Expr)
  // Array.blit(xs, at, s, m): copies min(m, len s) bytes of s into the local Array[U8] xs from at, at and m proved in range (Ty.blit)
  case El.Blit(line: I64, xs: Sym.Sym, at: El.Expr, s: El.Expr, m: El.Expr)
  // an expression that did not type (its clash is in the result): emit never runs on a program with clashes
  case El.Bad(line: I64)

enum El.Arm:
  case El.Arm(line: I64, p: Ast.Pat, body: El.Expr)

enum El.Stmt:
  // a val or var with its type (emit declares the C local with it)
  case El.Val(line: I64, x: Sym.Sym, ty: K.Term, mut: Bool, e: El.Expr)
  // caps: the handler's row (s2/eff.srs), the capabilities of the handle site it keeps for its ops (E1b)
  case El.Handle(line: I64, x: Sym.Sym, h: Sym.Sym, caps: Coll.List[Sym.Sym], args: Coll.List[El.Expr])
  case El.Do(e: El.Expr)

// a def: its [] binders (instantiated by mono), its protocol {} binders (leading C params), params with types
enum El.Param:
  case El.Param(x: Sym.Sym, ty: K.Term)

enum El.Fn:
  case El.Fn(line: I64, name: Sym.Sym, tparams: Coll.List[Sym.Sym], caps: Coll.List[Sym.Sym], params: Coll.List[El.Param], ret: K.Term, body: El.Body)

// a def has C, an extern is a C symbol of the runtime; ghost: per param, true for an I64 that only names the length of an
// Array param of a libc extern (a proof object: not a C param, not a C argument)
enum El.Body:
  case El.Def(e: El.Expr)
  case El.Extern(abi: Ast.Abi, ghost: Coll.List[Bool])

// handler name for protocol proto: its fns (init, then the ops)
enum El.Handler:
  case El.Handler(name: Sym.Sym, proto: Sym.Sym, fns: Coll.List[El.Fn], shots: Ast.Shots)

// given [tparams] {ev} head: the trait methods for the head's args (a call through {} evidence of a ground goal type is
// a static call to the instance of the given picked for it)
enum El.Given:
  case El.Given(tparams: Coll.List[Sym.Sym], ev: Coll.List[Sym.Sym], head: K.Term, fns: Coll.List[El.Fn])

// where a constructor allocates: in the Region capability region, or nowhere at run time (a top-level val: compile time only)
enum El.Alloc:
  case El.In(region: Sym.Sym)
  case El.Comptime
  // into the cell of local cell, a box of the same case the match on cell took apart (s2c --mem-reuse, s2/mem.srs M13)
  case El.Into(cell: Sym.Sym)
