// s2 store (s1/store.srs, vic-uw3 H2; vic 2026-11-06: Nix-like, content addressed): an entry = one decl as the printer
// writes it (Ast.decl; parse(print(d)) prints as d, the printer fixpoint), keyed by its content hash (s2/hash.srs).
// IO driver: an entry is written only through protocol StoreOut, so a write that does not commit does not compile.
// (capabilities Store and StoreOut, their Srs.* handlers and the rt_store_* externs are in lib/prelude.srs: Srs.* names are the prelude's)

// a decl as the printer writes it
def Store.text(d: Ast.Decl): Str =
  Console.captureBegin()
  Ast.decl(d)
  Console.captureEnd()

def Store.write(dir: Str, g: Hs.Dg, s: Str): Unit =
  val Hs.Dg(a, b, c, d) = g
  handle o = Srs.StoreFile(dir, a, b, c, d)
  o.put(s)
  o.commit()

def Store.read(dir: Str, g: Hs.Dg): Str =
  val Hs.Dg(a, b, c, d) = g
  Store.load(dir, a, b, c, d)

// an entry reads back as the decl when it parses to exactly one decl that prints as the original
def Store.same(entry: Str, want: Str): Bool =
  if Str.len(entry) < 0 then false
  else Parse.source(entry) match
    case Parse.Ok(ds, _) => ds match
      case Coll.Cons(x, rest) => rest match
        case Coll.Nil => Str.eq(Store.text(x), want)
        case Coll.Cons(_, _) => false
      case Coll.Nil => false
    case Parse.Err(_, _) => false

enum Store.Tally:
  case Store.Tally(wrote: I64, same: I64, shared: I64, bad: I64, seen: Coll.List[Hs.Dg])

def Store.seen(gs: Coll.List[Hs.Dg], g: Hs.Dg): Bool = gs match
  case Coll.Nil => false
  case Coll.Cons(h, rest) => if !Hs.less(g, h) && !Hs.less(h, g) then true else Store.seen(rest, g)

// `s2c --store-check`: write every hashed decl, read each back, compare (vic-uw3 H2 oracle); a later decl with a hash
// met before shares the entry (names are metadata)
def Store.check(ds: Coll.List[Ast.Decl]): Unit =
  val Store.Tally(w, s, sh, b, _) = Store.decls(Store.dir(), Hs.all(ds), ds, Store.Tally(0, 0, 0, 0, Coll.Nil))
  Console.print("store: wrote ")
  Console.printI64(w)
  Console.print(", read equal ")
  Console.printI64(s)
  Console.print(", shared ")
  Console.printI64(sh)
  Console.print(", bad ")
  Console.printI64(b)
  Console.print("\n")

def Store.decls(dir: Str, hm: Coll.SMap[Hs.Dg], ds: Coll.List[Ast.Decl], t: Store.Tally): Store.Tally = ds match
  case Coll.Nil => t
  case Coll.Cons(d, rest) =>
    val n: Coll.Option[Sym.Sym] = d match
      case Ast.DEnum(e) =>
        val Ast.Enum(_, _, en, _, _) = e
        Coll.Some(en)
      case Ast.DFn(f) =>
        val Ast.Fn(_, _, fname, _, _, _, _, _) = f
        Coll.Some(fname)
      case _ => Coll.None
    val g: Coll.Option[Hs.Dg] = n match
      case Coll.Some(x) => Coll.sLookup(hm, x)
      case Coll.None => Coll.None
    g match
      case Coll.None => Store.decls(dir, hm, rest, t)
      case Coll.Some(h) => Store.decls(dir, hm, rest, Store.one(dir, h, Store.text(d), t))

def Store.one(dir: Str, g: Hs.Dg, want: Str, t: Store.Tally): Store.Tally =
  val Store.Tally(w, s, sh, b, seen) = t
  val w2 = if Str.len(Store.read(dir, g)) < 0 then Store.wrote(dir, g, want, w) else w
  val seen2 = Coll.Cons(g, seen)
  if Store.seen(seen, g) then Store.Tally(w2, s, sh + 1, b, seen2)
  else if Store.same(Store.read(dir, g), want) then Store.Tally(w2, s + 1, sh, b, seen2)
  else Store.Tally(w2, s, sh, b + 1, seen2)

def Store.wrote(dir: Str, g: Hs.Dg, s: Str, w: I64): I64 =
  Store.write(dir, g, s)
  w + 1
