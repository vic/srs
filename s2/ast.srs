// s2 P1 (vic-m5r.23, vic/c/ast-design.md): the typed AST. one case per shape, named fields, so a wrong shape does not
// compile; an AST may still hold an invalid program (unknown name, bad state): the checker finds those as data.
// every node keeps its source line. Ast.print writes it back as srs source (the oracle of P1, and of the parser later).

enum Ast.BinOp:
  case Ast.Add
  case Ast.Sub
  case Ast.Mul
  case Ast.Div
  case Ast.Mod
  case Ast.Lt
  case Ast.Le
  case Ast.Gt
  case Ast.Ge
  case Ast.Eq
  case Ast.Ne
  case Ast.And
  case Ast.Or
  // on U32 and U64 only: | ^ &, and << >> (>>> is >>: the operand is unsigned) with an I64 count taken mod the width
  case Ast.BitOr
  case Ast.BitXor
  case Ast.BitAnd
  case Ast.Shl
  case Ast.Shr

enum Ast.UnOp:
  case Ast.Neg
  case Ast.Not
  // ~x on U32 and U64
  case Ast.BitNot

// the // lines before a node that starts a line, as written ("" = a blank line between them); only `srs fmt` lexes
// comments (Lex.Keep), so a compiled AST has NoDoc everywhere. it is the first field of a node, as it is first in the
// source; Block holds the doc of its last expression, If the doc of its else
enum Ast.Doc:
  case Ast.NoDoc
  case Ast.Doc(lines: Coll.List[Str])

// how a match was written: PatVal = val C(a, b) = e, the rest of the block as the body of its one arm
enum Ast.Form:
  case Ast.Written
  case Ast.PatVal

// T[args]<caps>: no caps written = inferred; written = a bound. T{self}: the result of a capability op whose type's {}
// binders the receiver takes (only there: Parse.capDef)
enum Ast.Caps:
  case Ast.Inferred
  case Ast.Stated(cs: Coll.List[Sym.Sym])
  case Ast.Chosen(cs: Coll.List[Sym.Sym])

enum Ast.Ty:
  case Ast.Ty(line: I64, name: Sym.Sym, args: Coll.List[Ast.Ty], caps: Ast.Caps, vals: Coll.List[Ast.Expr])

enum Ast.Q:
  case Ast.Forall
  case Ast.Exists

enum Ast.LoopCond:
  case Ast.LInvariant
  case Ast.LDecreases

enum Ast.Expr:
  case Ast.Int(line: I64, v: I64)
  case Ast.Bool(line: I64, v: Bool)
  // s = the text between the quotes, escapes as written
  case Ast.Str(line: I64, s: Str)
  case Ast.Unit(line: I64)
  case Ast.Name(line: I64, n: Sym.Sym)
  // f[T]{a}(x): types and chosen evidence are empty lists when not written
  case Ast.Call(line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym], args: Coll.List[Ast.Expr])
  // d.knock(): an op on a capability, or a method on {} evidence (the checker tells which)
  case Ast.Method(line: I64, recv: Sym.Sym, op: Sym.Sym, args: Coll.List[Ast.Expr])
  // resume k(arg) in a handler op: the rest of the handled block, its value (vic-hm63 Q-M2)
  case Ast.Resume(line: I64, k: Sym.Sym, arg: Ast.Expr)
  case Ast.Bin(line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr)
  case Ast.Un(line: I64, op: Ast.UnOp, e: Ast.Expr)
  case Ast.If(elseDoc: Ast.Doc, line: I64, c: Ast.Expr, t: Ast.Expr, e: Ast.Expr)
  case Ast.Match(form: Ast.Form, line: I64, s: Ast.Expr, arms: Coll.List[Ast.Arm])
  // a block always has a value: after a last val or handle it is Ast.Unit
  case Ast.Block(lastDoc: Ast.Doc, line: I64, stmts: Coll.List[Ast.Stmt], last: Ast.Expr)
  case Ast.While(line: I64, c: Ast.Expr, body: Ast.Expr)
  case Ast.Assign(line: I64, x: Sym.Sym, e: Ast.Expr)
  // forall x: T => e, exists x: T => e (contracts only)
  case Ast.Quant(line: I64, q: Ast.Q, x: Sym.Sym, t: Ast.Ty, e: Ast.Expr)

enum Ast.Pat:
  case Ast.PCase(c: Sym.Sym, binds: Coll.List[Sym.Sym])
  case Ast.PAny

enum Ast.Arm:
  case Ast.Arm(doc: Ast.Doc, line: I64, p: Ast.Pat, body: Ast.Expr)

enum Ast.Stmt:
  case Ast.Val(doc: Ast.Doc, line: I64, x: Sym.Sym, ann: Coll.Option[Ast.Ty], e: Ast.Expr)
  case Ast.Var(doc: Ast.Doc, line: I64, x: Sym.Sym, ann: Coll.Option[Ast.Ty], e: Ast.Expr)
  case Ast.Handle(doc: Ast.Doc, line: I64, x: Sym.Sym, h: Sym.Sym, args: Coll.List[Ast.Expr])
  case Ast.Do(doc: Ast.Doc, e: Ast.Expr)
  // a loop invariant or measure in a block (s1/parse.srs:494)
  case Ast.Check(doc: Ast.Doc, line: I64, k: Ast.LoopCond, e: Ast.Expr)

// <> atoms. a name is a variable or a constant by its position (s1/facts.srs:1-3: lowercase in a state position is a
// variable, but `knock` in next(s, knock, s2) is an op): the checker decides, not the parser
enum Ast.Term:
  case Ast.TName(n: Sym.Sym)
  case Ast.TNum(v: I64)

enum Ast.Atom:
  case Ast.Atom(line: I64, rel: Sym.Sym, args: Coll.List[Ast.Term])

enum Ast.Binder:
  case Ast.Binder(line: I64, x: Sym.Sym, ty: Ast.Ty)

// binder groups in written order (vic/c/binders-design.md); the exit facts are a field of the fn
enum Ast.Group:
  case Ast.Types(bs: Coll.List[Ast.Binder])
  case Ast.Evidence(bs: Coll.List[Ast.Binder])
  case Ast.Facts(atoms: Coll.List[Ast.Atom])

// a contract clause between a signature and its body (C13, s1/parse.srs:147-184), erased in C
enum Ast.Cond:
  case Ast.Requires
  case Ast.Ensures
  case Ast.Returns
  case Ast.Decreases
  case Ast.Invariant

enum Ast.Clause:
  case Ast.CondC(line: I64, k: Ast.Cond, e: Ast.Expr)
  case Ast.ProofUsing(line: I64, xs: Coll.List[Sym.Sym])
  case Ast.ProofInduction(line: I64, x: Sym.Sym)
  case Ast.ProofLean(line: I64, s: Str)

// the C ABI of an extern: Srs = the srs runtime (prototype from the srs signature only); Libc = a libc function
// (the libc headers are included and the srs prototype must agree with them: C11 6.7p4, else the C compile fails)
enum Ast.Abi:
  case Ast.AbiSrs
  case Ast.AbiLibc
  // a libc function with a trailing `...` (printf, open, fcntl): only libc can be variadic, so only here
  case Ast.AbiLibcVar
  // extern "libc" val NAME: I32 (or I64, U64): a C constant or macro, read as ((int32_t)(NAME)); no prototype, no effect
  case Ast.AbiLibcVal
  // a libc function the prelude declares (S2c.read marks the first file): its prototype and the libc headers only when called
  case Ast.AbiLibcPre

enum Ast.Body:
  case Ast.Def(cs: Coll.List[Ast.Clause], e: Ast.Expr)
  case Ast.Extern(abi: Ast.Abi)

enum Ast.Fn:
  case Ast.Fn(doc: Ast.Doc, line: I64, name: Sym.Sym, groups: Coll.List[Ast.Group], params: Coll.List[Ast.Binder], ret: Ast.Ty, exit: Coll.List[Ast.Atom], body: Ast.Body)

enum Ast.Trans:
  case Ast.Trans(from: Sym.Sym, to: Sym.Sym)

enum Ast.Op:
  case Ast.Op(doc: Ast.Doc, line: I64, name: Sym.Sym, groups: Coll.List[Ast.Group], params: Coll.List[Ast.Binder], ret: Ast.Ty, trans: Coll.List[Ast.Trans])

enum Ast.RuleDef:
  case Ast.RuleDef(line: I64, name: Sym.Sym, params: Coll.List[Sym.Sym], body: Coll.List[Ast.Atom])

enum Ast.Proto:
  case Ast.Proto(doc: Ast.Doc, line: I64, name: Sym.Sym, states: Coll.List[Sym.Sym], start: Sym.Sym, ends: Coll.List[Sym.Sym], dropOp: Coll.Option[Sym.Sym], ops: Coll.List[Ast.Op], rules: Coll.List[Ast.RuleDef])

enum Ast.Handler:
  case Ast.Handler(doc: Ast.Doc, line: I64, name: Sym.Sym, proto: Sym.Sym, fns: Coll.List[Ast.Fn], shots: Ast.Shots, st: Ast.HState)

// a handler resumes once, at once (plain C), or names its continuations (vic-hm63): handler H [A: Type] for P, the
// block type A, and per op its continuation k (def choose(k): R)
// a handler written with no init keeps no state: the parser adds init(): Ptr = Srs.noState() and a self: Ptr first
// param to each op (Parse.stateless); the printer leaves them out again
enum Ast.HState:
  case Ast.Stateful
  case Ast.Stateless

enum Ast.Shots:
  case Ast.OneShot
  case Ast.MultiShot(ans: Sym.Sym, ks: Coll.List[Ast.KOp])

enum Ast.KOp:
  case Ast.KOp(op: Sym.Sym, k: Sym.Sym)

enum Ast.Case:
  case Ast.Case(doc: Ast.Doc, line: I64, name: Sym.Sym, fields: Coll.List[Ast.Binder])

enum Ast.Enum:
  case Ast.Enum(doc: Ast.Doc, line: I64, name: Sym.Sym, groups: Coll.List[Ast.Group], cases: Coll.List[Ast.Case])

// trait Name groups: its method signatures (no body)
enum Ast.Trait:
  case Ast.Trait(doc: Ast.Doc, line: I64, name: Sym.Sym, groups: Coll.List[Ast.Group], sigs: Coll.List[Ast.Fn])

// given groups Head[args]: the methods of the trait Head for those args
enum Ast.Given:
  case Ast.Given(doc: Ast.Doc, line: I64, groups: Coll.List[Ast.Group], head: Ast.Ty, fns: Coll.List[Ast.Fn])

// a value pattern of a type value match: an int, a string, true or false, or _
enum Ast.VPat:
  case Ast.VInt(v: I64)
  case Ast.VStr(s: Str)
  case Ast.VBool(v: Bool)
  case Ast.VAny

enum Ast.TyArm:
  case Ast.TyArm(line: I64, pat: Ast.Ty, res: Ast.Ty)

enum Ast.ValArm:
  case Ast.ValArm(line: I64, pat: Ast.VPat, res: Ast.Ty)

// the body of a type decl: a type, a match on a type, a match on a value binder
enum Ast.TBody:
  case Ast.Alias(t: Ast.Ty)
  case Ast.TyMatch(scrut: Ast.Ty, arms: Coll.List[Ast.TyArm])
  case Ast.ValMatch(x: Sym.Sym, arms: Coll.List[Ast.ValArm])
  // extern "libc" struct Libc.<C name>: the fields srs reads of a C struct, each I32, I64, U32 or U64; the value is a pointer to
  // sizeof(struct <C name>) bytes (a nominal type with no body of its own)
  case Ast.CStruct(fields: Coll.List[Ast.CField])

// a field of a libc struct: its C name and its srs type
enum Ast.CField:
  case Ast.CField(line: I64, name: Sym.Sym, ty: Ast.Ty)

// type Name groups (value binders) = body
enum Ast.TypeDecl:
  case Ast.TypeDecl(doc: Ast.Doc, line: I64, name: Sym.Sym, groups: Coll.List[Ast.Group], vals: Coll.List[Ast.Binder], body: Ast.TBody)

enum Ast.Decl:
  case Ast.DFn(f: Ast.Fn)
  case Ast.DEnum(e: Ast.Enum)
  case Ast.DProto(p: Ast.Proto)
  case Ast.DHandler(h: Ast.Handler)
  case Ast.DTrait(t: Ast.Trait)
  case Ast.DGiven(g: Ast.Given)
  case Ast.DType(t: Ast.TypeDecl)
  // a top-level val x: T = e, a compile-time value: a nullary fn whose body is e (vic 2026-11-09)
  case Ast.DVal(v: Ast.Fn)

// ── printer: srs source, Ast.step() spaces per level ──
def Ast.step(): I64 = 2

def Ast.sym(s: Sym.Sym): Unit = Console.print(Sym.str(s))

def Ast.indent(n: I64): Unit =
  if n > 0 then
    Console.print(" ")
    Ast.indent(n - 1)
  else ()

def Ast.line(ind: I64): Unit =
  Console.print("\n")
  Ast.indent(ind)

// a node's comments, each on its own line at ind, after the line break that starts the node; a blank line only at
// the top level (in a body it would leave spaces at the end of a line)
def Ast.doc(d: Ast.Doc, ind: I64): Unit = d match
  case Ast.NoDoc => ()
  case Ast.Doc(ls) => Ast.docLines(ls, ind)

def Ast.docLines(ls: Coll.List[Str], ind: I64): Unit = ls match
  case Coll.Nil => ()
  case Coll.Cons(l, rest) =>
    if Str.len(l) > 0 then
      Console.print(l)
      Ast.line(ind)
    else if ind == 0 then Console.print("\n")
    else ()
    Ast.docLines(rest, ind)

def Ast.hasDoc(d: Ast.Doc): Bool = d match
  case Ast.NoDoc => false
  case Ast.Doc(_) => true

def Ast.fnDocOut(f: Ast.Fn, ind: I64): Unit =
  val Ast.Fn(d, _, _, _, _, _, _, _) = f
  Ast.doc(d, ind)

def Ast.stmtDocOf(s: Ast.Stmt): Ast.Doc = s match
  case Ast.Val(d, _, _, _, _) => d
  case Ast.Var(d, _, _, _, _) => d
  case Ast.Handle(d, _, _, _, _) => d
  case Ast.Do(d, _) => d
  case Ast.Check(d, _, _, _) => d

def Ast.declDocOf(decl: Ast.Decl): Ast.Doc = decl match
  case Ast.DFn(f) =>
    val Ast.Fn(d, _, _, _, _, _, _, _) = f
    d
  case Ast.DVal(f) =>
    val Ast.Fn(d, _, _, _, _, _, _, _) = f
    d
  case Ast.DEnum(e) =>
    val Ast.Enum(d, _, _, _, _) = e
    d
  case Ast.DProto(p) =>
    val Ast.Proto(d, _, _, _, _, _, _, _, _) = p
    d
  case Ast.DHandler(h) =>
    val Ast.Handler(d, _, _, _, _, _, _) = h
    d
  case Ast.DTrait(t) =>
    val Ast.Trait(d, _, _, _, _) = t
    d
  case Ast.DGiven(g) =>
    val Ast.Given(d, _, _, _, _) = g
    d
  case Ast.DType(t) =>
    val Ast.TypeDecl(d, _, _, _, _, _) = t
    d

// the rest of a block after a pattern val, at ind: its statements and its value, each on its own line
def Ast.rest(b: Ast.Expr, ind: I64): Unit = b match
  case Ast.Block(ld, _, ss, last) =>
    Ast.stmts(ss, ind)
    Ast.last(ld, last, ind)
  case _ => Ast.last(Ast.NoDoc, b, ind)

// the last expression of a block on its own line; a PatVal match prints as the val it was written as, its arm's
// block going on at the same indent
def Ast.last(ld: Ast.Doc, e: Ast.Expr, ind: I64): Unit =
  Ast.line(ind)
  Ast.doc(ld, ind)
  e match
    case Ast.Match(f, _, s, arms) => f match
      case Ast.Written => Ast.expr(e, ind)
      case Ast.PatVal => arms match
        case Coll.Nil => Ast.expr(e, ind)
        case Coll.Cons(a, _) =>
          val Ast.Arm(_, _, p, b) = a
          Console.print("val ")
          Ast.pat(p)
          Console.print(" =")
          Ast.body(s, ind)
          Ast.rest(b, ind)
    case _ => Ast.lineExpr(e, ind)

// names separated by sep
def Ast.syms(xs: Coll.List[Sym.Sym], sep: Str): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(h, t) =>
    Ast.sym(h)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(sep)
        Ast.syms(t, sep)

def Ast.tys(xs: Coll.List[Ast.Ty]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(h, t) =>
    Ast.ty(h)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        Ast.tys(t)

def Ast.ty(t: Ast.Ty): Unit =
  val Ast.Ty(_, n, args, caps, vals) = t
  Ast.sym(n)
  args match
    case Coll.Nil => ()
    case Coll.Cons(_, _) =>
      Console.print("[")
      Ast.tys(args)
      Console.print("]")
  vals match
    case Coll.Nil => ()
    case Coll.Cons(_, _) =>
      Console.print("(")
      Ast.args(vals, 0)
      Console.print(")")
  caps match
    case Ast.Inferred => ()
    case Ast.Stated(cs) =>
      Console.print("<")
      Ast.syms(cs, ", ")
      Console.print(">")
    case Ast.Chosen(cs) =>
      Console.print("{")
      Ast.syms(cs, ", ")
      Console.print("}")

def Ast.opText(op: Ast.BinOp): Str = op match
  case Ast.Add => "+"
  case Ast.Sub => "-"
  case Ast.Mul => "*"
  case Ast.Div => "/"
  case Ast.Mod => "%"
  case Ast.Lt => "<"
  case Ast.Le => "<="
  case Ast.Gt => ">"
  case Ast.Ge => ">="
  case Ast.Eq => "=="
  case Ast.Ne => "!="
  case Ast.And => "&&"
  case Ast.Or => "||"
  case Ast.BitOr => "|"
  case Ast.BitXor => "^"
  case Ast.BitAnd => "&"
  case Ast.Shl => "<<"
  case Ast.Shr => ">>"

// how tightly an expression binds as an operand, loosest first: if, match, block, while and assign only in ( ); a
// binary operator by its level; a unary operator; an atom (literal, name, call, method)
enum Ast.Bind:
  case Ast.Loose
  case Ast.Infix(op: Ast.BinOp)
  case Ast.Prefix
  case Ast.Atomic

// an operand position: it takes an expression that binds at least as tightly as b, or strictly more tightly
// (the right operand of a left associative operator)
enum Ast.Need:
  case Ast.AtLeast(b: Ast.Bind)
  case Ast.Above(b: Ast.Bind)

// the order of Bind, loosest first; binary levels as Parse.binOf: the Scala 3 table by first char (| ^ & = < + *,
// so || is at |, && at &, << >> at <). only compared
def Ast.rank(b: Ast.Bind): I64 = b match
  case Ast.Loose => 0
  case Ast.Infix(op) => op match
    case Ast.Or => 1
    case Ast.BitOr => 1
    case Ast.BitXor => 2
    case Ast.And => 3
    case Ast.BitAnd => 3
    case Ast.Eq => 4
    case Ast.Ne => 4
    case Ast.Lt => 5
    case Ast.Le => 5
    case Ast.Gt => 5
    case Ast.Ge => 5
    case Ast.Shl => 5
    case Ast.Shr => 5
    case Ast.Add => 6
    case Ast.Sub => 6
    case Ast.Mul => 7
    case Ast.Div => 7
    case Ast.Mod => 7
  case Ast.Prefix => 8
  case Ast.Atomic => 9

def Ast.bindOf(e: Ast.Expr): Ast.Bind = e match
  case Ast.Bin(_, op, _, _) => Ast.Infix(op)
  case Ast.Un(_, _, _) => Ast.Prefix
  case Ast.If(_, _, _, _, _) => Ast.Loose
  case Ast.Match(_, _, _, _) => Ast.Loose
  case Ast.Block(_, _, _, _) => Ast.Loose
  case Ast.While(_, _, _) => Ast.Loose
  case Ast.Assign(_, _, _) => Ast.Loose
  case Ast.Quant(_, _, _, _, _) => Ast.Loose
  case _ => Ast.Atomic

def Ast.fits(e: Ast.Expr, n: Ast.Need): Bool = n match
  case Ast.AtLeast(b) => Ast.rank(Ast.bindOf(e)) >= Ast.rank(b)
  case Ast.Above(b) => Ast.rank(Ast.bindOf(e)) > Ast.rank(b)

// e in an operand position: in ( ) when it does not fit
def Ast.operand(e: Ast.Expr, n: Ast.Need, ind: I64): Unit =
  if Ast.fits(e, n) then Ast.expr(e, ind)
  else
    Console.print("(")
    Ast.expr(e, ind)
    Console.print(")")

def Ast.args(xs: Coll.List[Ast.Expr], ind: I64): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(h, t) =>
    Ast.expr(h, ind)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        Ast.args(t, ind)

// e after `=`, `then`, `else`, `do` or `=>`: a block on its own lines one level in; a match on this line, its arms
// below; anything else on this line when it fits Ast.width() on one line, else on the next line one level in (the
// parser reads both as e: Parse.blockOf)
def Ast.body(e: Ast.Expr, ind: I64): Unit = e match
  case Ast.Block(ld, _, ss, last) =>
    Ast.stmts(ss, ind + Ast.step())
    Ast.last(ld, last, ind + Ast.step())
  case Ast.Match(f, _, _, _) => f match
    case Ast.PatVal => Ast.last(Ast.NoDoc, e, ind + Ast.step())
    case Ast.Written =>
      Console.print(" ")
      Ast.expr(e, ind)
  case _ => Ast.oneLine(e, ind, 1) match
    case Coll.Some(s) =>
      Console.print(" ")
      Console.print(s)
    case Coll.None =>
      Ast.line(ind + Ast.step())
      Ast.lineExpr(e, ind + Ast.step())

def Ast.expr(e: Ast.Expr, ind: I64): Unit = e match
  case Ast.Int(_, v) => Ast.int(v)
  case Ast.Bool(_, v) => Console.print(if v then "true" else "false")
  case Ast.Str(_, s) =>
    Console.print("\"")
    Console.print(s)
    Console.print("\"")
  case Ast.Unit(_) => Console.print("()")
  case Ast.Name(_, n) => Ast.sym(n)
  case Ast.Call(_, f, targs, chosen, xs) =>
    Ast.sym(f)
    targs match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("[")
        Ast.tys(targs)
        Console.print("]")
    chosen match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("{")
        Ast.syms(chosen, ", ")
        Console.print("}")
    Console.print("(")
    Ast.args(xs, ind)
    Console.print(")")
  case Ast.Method(_, recv, op, xs) =>
    Ast.sym(recv)
    Console.print(".")
    Ast.sym(op)
    Console.print("(")
    Ast.args(xs, ind)
    Console.print(")")
  case Ast.Resume(_, k, x) =>
    Console.print("resume ")
    Ast.sym(k)
    Console.print("(")
    Ast.expr(x, ind)
    Console.print(")")
  case Ast.Bin(_, op, l, rhs) =>
    Ast.operand(l, Ast.AtLeast(Ast.Infix(op)), ind)
    Console.print(" ")
    Console.print(Ast.opText(op))
    Console.print(" ")
    Ast.operand(rhs, Ast.Above(Ast.Infix(op)), ind)
  case Ast.Un(_, op, x) =>
    Console.print(Ast.unText(op))
    Ast.operand(x, Ast.AtLeast(Ast.Prefix), ind)
  case Ast.If(ed, _, c, t, x) => Ast.ifExpr(ed, c, t, x, ind, false)
  case Ast.Match(_, _, s, arms) =>
    Ast.operand(s, Ast.AtLeast(Ast.Atomic), ind)
    Console.print(" match")
    Ast.arms(arms, ind + Ast.step())
  case Ast.Block(ld, _, ss, last) =>
    Ast.stmts(ss, ind)
    Ast.last(ld, last, ind)
  case Ast.While(_, c, b) =>
    Console.print("while ")
    Ast.expr(c, ind)
    // a match condition ends with its arms: do starts the next line (as tests/s2/prog/contracts.srs)
    c match
      case Ast.Match(_, _, _, _) =>
        Ast.line(ind)
        Console.print("do")
      case _ => Console.print(" do")
    Ast.body(b, ind)
  case Ast.Quant(_, q, x, t, b) =>
    Console.print(Ast.qText(q))
    Console.print(" ")
    Ast.sym(x)
    Console.print(": ")
    Ast.ty(t)
    Console.print(" => ")
    Ast.expr(b, ind)
  case Ast.Assign(_, x, v) =>
    Ast.sym(x)
    Console.print(" = ")
    Ast.expr(v, ind)

// a literal: the lexer reads decimal digits mod 2^64 (9223372036854775808 is I64 min), so a negative value prints as
// its unsigned digits, which read back as it (2^64 = 1844674407370955161 * 10 + 6)
def Ast.int(v: I64): Unit =
  if v >= 0 then Console.printI64(v)
  else
    // v = 10q + r, r in -9..0: 2^64 + v = 10(1844674407370955161 + q) + 6 + r, with a borrow when 6 + r < 0
    val q = v / 10
    val r = v % 10
    Console.printI64(if 6 + r < 0 then 1844674407370955160 + q else 1844674407370955161 + q)
    Console.printI64(if 6 + r < 0 then 16 + r else 6 + r)

def Ast.unText(op: Ast.UnOp): Str = op match
  case Ast.Neg => "-"
  case Ast.Not => "!"
  case Ast.BitNot => "~"

// ── if (Scala 3 style, vic 2026-11-12: readability first) ──
// an if at the start of a line, or after = or =>, is one line when it fits Ast.width() and no else of it must start
// a line (a branch on more lines, a comment before else, an else-if chain); else it breaks: each else on its own
// line, and after = or => the whole if goes on the next line one step in. An if inside an expression (an argument,
// an operand) is always one line: a line break inside ( ) does not lex there

// the line width: 19921 of the 20926 code lines of lib, s2 and s2c are within it, and comments wrap at it (2026-11-12)
def Ast.width(): I64 = 120

// an else of e must start a line
def Ast.breaks(e: Ast.Expr): Bool = e match
  case Ast.If(ed, _, _, t, x) => Ast.multiLine(t) || Ast.multiLine(x) || Ast.hasDoc(ed) || Ast.isIf(x)
  case _ => false

// e printed on one line lead columns after the current one, when it fits
def Ast.oneLine(e: Ast.Expr, ind: I64, lead: I64): Coll.Option[Str] =
  if Ast.breaks(e) || Ast.multiLine(e) then Coll.None
  else
    val col = Console.column() + lead
    Console.captureBegin()
    Ast.expr(e, ind)
    val s = Console.captureEnd()
    if col + Str.len(s) <= Ast.width() then Coll.Some(s) else Coll.None

// e at the start of a line at ind
def Ast.lineExpr(e: Ast.Expr, ind: I64): Unit = e match
  case Ast.If(ed, _, c, t, x) => Ast.oneLine(e, ind, 0) match
    case Coll.Some(s) => Console.print(s)
    case Coll.None => Ast.ifExpr(ed, c, t, x, ind, true)
  case _ => Ast.expr(e, ind)

// split: each else starts a line at ind
def Ast.ifExpr(ed: Ast.Doc, c: Ast.Expr, t: Ast.Expr, x: Ast.Expr, ind: I64, split: Bool): Unit =
  Console.print("if ")
  Ast.expr(c, ind)
  Console.print(" then")
  if Ast.isIf(t) && !Ast.breaks(t) then
    // a one-line if in a then keeps its parens: if a then (if b then c else d) else e
    Console.print(" (")
    Ast.expr(t, ind)
    Console.print(")")
  else if split || Ast.multiLine(t) then Ast.body(t, ind)
  else
    Console.print(" ")
    Ast.expr(t, ind)
  if split || Ast.multiLine(t) || Ast.multiLine(x) || Ast.hasDoc(ed) then
    Ast.line(ind)
    Ast.doc(ed, ind)
    Console.print("else")
    x match
      case Ast.If(ed2, _, c2, t2, x2) =>
        Console.print(" ")
        Ast.ifExpr(ed2, c2, t2, x2, ind, true)
      case _ => Ast.body(x, ind)
  else
    Console.print(" else ")
    Ast.expr(x, ind)

def Ast.isIf(e: Ast.Expr): Bool = e match
  case Ast.If(_, _, _, _, _) => true
  case _ => false

def Ast.multiLine(e: Ast.Expr): Bool = e match
  case Ast.Block(_, _, _, _) => true
  case Ast.Match(_, _, _, _) => true
  case Ast.While(_, _, _) => true
  case Ast.If(ed, _, _, t, x) => Ast.multiLine(t) || Ast.multiLine(x) || Ast.hasDoc(ed)
  case _ => false

def Ast.arms(xs: Coll.List[Ast.Arm], ind: I64): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(a, t) =>
    val Ast.Arm(d, _, p, b) = a
    Ast.line(ind)
    Ast.doc(d, ind)
    Console.print("case ")
    Ast.pat(p)
    Console.print(" =>")
    Ast.body(b, ind)
    Ast.arms(t, ind)

def Ast.pat(p: Ast.Pat): Unit = p match
  case Ast.PAny => Console.print("_")
  case Ast.PCase(c, bs) =>
    Ast.sym(c)
    bs match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("(")
        Ast.syms(bs, ", ")
        Console.print(")")

// each statement on its own line at ind
def Ast.stmts(xs: Coll.List[Ast.Stmt], ind: I64): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(s, t) =>
    Ast.line(ind)
    Ast.doc(Ast.stmtDocOf(s), ind)
    Ast.stmt(s, ind)
    Ast.stmts(t, ind)

def Ast.stmt(s: Ast.Stmt, ind: I64): Unit = s match
  case Ast.Val(_, _, x, ann, e) =>
    Console.print("val ")
    Ast.binding(x, ann, e, ind)
  case Ast.Var(_, _, x, ann, e) =>
    Console.print("var ")
    Ast.binding(x, ann, e, ind)
  case Ast.Handle(_, _, x, h, xs) =>
    Console.print("handle ")
    Ast.sym(x)
    Console.print(" = ")
    Ast.sym(h)
    Console.print("(")
    Ast.args(xs, ind)
    Console.print(")")
  case Ast.Do(_, e) => Ast.lineExpr(e, ind)
  case Ast.Check(_, _, k, e) =>
    Console.print(Ast.loopText(k))
    Console.print(" ")
    Ast.expr(e, ind)

def Ast.qText(q: Ast.Q): Str = q match
  case Ast.Forall => "forall"
  case Ast.Exists => "exists"

def Ast.loopText(k: Ast.LoopCond): Str = k match
  case Ast.LInvariant => "invariant"
  case Ast.LDecreases => "decreases"

def Ast.binding(x: Sym.Sym, ann: Coll.Option[Ast.Ty], e: Ast.Expr, ind: I64): Unit =
  Ast.sym(x)
  ann match
    case Coll.None => ()
    case Coll.Some(t) =>
      Console.print(": ")
      Ast.ty(t)
  Console.print(" =")
  Ast.body(e, ind)

def Ast.term(t: Ast.Term): Unit = t match
  case Ast.TName(n) => Ast.sym(n)
  case Ast.TNum(v) => Console.printI64(v)

def Ast.terms(xs: Coll.List[Ast.Term]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(h, t) =>
    Ast.term(h)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        Ast.terms(t)

// at(x, T) is written x: T (vic 2026-11-09)
def Ast.atom(rel: Sym.Sym, ts: Coll.List[Ast.Term]): Unit =
  if Str.eq(Sym.str(rel), "at") && Coll.length(ts) == 2 then ts match
    case Coll.Cons(x, rest) =>
      Ast.term(x)
      Console.print(": ")
      Ast.terms(rest)
    case Coll.Nil => ()
  else Ast.atomCall(rel, ts)

def Ast.atomCall(rel: Sym.Sym, ts: Coll.List[Ast.Term]): Unit =
  Ast.sym(rel)
  Console.print("(")
  Ast.terms(ts)
  Console.print(")")

def Ast.atoms(xs: Coll.List[Ast.Atom]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(a, t) =>
    val Ast.Atom(_, rel, ts) = a
    Ast.atom(rel, ts)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        Ast.atoms(t)

def Ast.binders(xs: Coll.List[Ast.Binder]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(b, t) =>
    val Ast.Binder(_, x, ty) = b
    Ast.sym(x)
    Console.print(": ")
    Ast.ty(ty)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        Ast.binders(t)

// each group followed by a space: ` [A: Type] {s: Show[A]} <at(t, S)> `
def Ast.groups(xs: Coll.List[Ast.Group]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(g, t) =>
    Console.print(" ")
    g match
      case Ast.Types(bs) =>
        Console.print("[")
        Ast.binders(bs)
        Console.print("]")
      case Ast.Evidence(bs) =>
        Console.print("{")
        Ast.binders(bs)
        Console.print("}")
      case Ast.Facts(ats) =>
        Console.print("<")
        Ast.atoms(ats)
        Console.print(">")
    Ast.groups(t)

def Ast.fn(f: Ast.Fn, ind: I64): Unit =
  val Ast.Fn(_, _, name, _, _, ret, _, body) = f
  body match
    case Ast.Extern(abi) => abi match
      case Ast.AbiSrs =>
        Console.print("extern ")
        Ast.fnSig(f, ind)
      case Ast.AbiLibcVal =>
        Console.print("extern \"libc\" val ")
        Ast.sym(name)
        Console.print(": ")
        Ast.ty(ret)
      case _ =>
        Console.print("extern \"libc\" ")
        Ast.fnSig(f, ind)
    case Ast.Def(_, _) => Ast.fnSig(f, ind)

// a trait method signature: a def without body and without extern
def Ast.sigs(xs: Coll.List[Ast.Fn], ind: I64): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(f, t) =>
    Ast.line(ind)
    Ast.fnDocOut(f, ind)
    Ast.fnSig(f, ind)
    Ast.sigs(t, ind)

// def name groups (params): ty <exit> [= body]
def Ast.fnSig(f: Ast.Fn, ind: I64): Unit = Ast.fnSigK(f, ind, Coll.None)

// k: the continuation param of a multi-shot handler op, written first
def Ast.fnSigK(f: Ast.Fn, ind: I64, k: Coll.Option[Sym.Sym]): Unit =
  val Ast.Fn(_, _, name, gs, ps, ret, exit, body) = f
  Console.print("def ")
  Ast.sym(name)
  Ast.groups(gs)
  gs match
    case Coll.Nil => ()
    case Coll.Cons(_, _) => Console.print(" ")
  Console.print("(")
  k match
    case Coll.None => ()
    case Coll.Some(x) =>
      Ast.sym(x)
      ps match
        case Coll.Nil => ()
        case Coll.Cons(_, _) => Console.print(", ")
  Ast.binders(ps)
  body match
    case Ast.Extern(abi) => abi match
      case Ast.AbiLibcVar => Console.print(Ast.varText(ps))
      case _ => ()
    case Ast.Def(_, _) => ()
  Console.print("): ")
  Ast.ty(ret)
  exit match
    case Coll.Nil => ()
    case Coll.Cons(_, _) =>
      Console.print(" <")
      Ast.atoms(exit)
      Console.print(">")
  body match
    case Ast.Extern(_) => ()
    case Ast.Def(cs, e) => Ast.withClauses(cs, e, ind)

// the trailing ... of a variadic libc extern
def Ast.varText(ps: Coll.List[Ast.Binder]): Str = ps match
  case Coll.Nil => "..."
  case Coll.Cons(_, _) => ", ..."

// = body; with clauses: each on its own line one step in, then = at the start of a line (as tests/s2/prog/contracts.srs)
def Ast.withClauses(cs: Coll.List[Ast.Clause], e: Ast.Expr, ind: I64): Unit = cs match
  case Coll.Nil =>
    Console.print(" =")
    Ast.body(e, ind)
  case Coll.Cons(_, _) =>
    Ast.clauses(cs, ind + Ast.step())
    Ast.line(ind)
    Console.print("=")
    Ast.body(e, ind)

def Ast.condText(k: Ast.Cond): Str = k match
  case Ast.Requires => "requires"
  case Ast.Ensures => "ensures"
  case Ast.Returns => "returns"
  case Ast.Decreases => "decreases"
  case Ast.Invariant => "invariant"

def Ast.clauses(cs: Coll.List[Ast.Clause], ind: I64): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    Ast.line(ind)
    c match
      case Ast.CondC(_, k, x) =>
        Console.print(Ast.condText(k))
        Console.print(" ")
        Ast.expr(x, ind)
      case Ast.ProofUsing(_, xs) =>
        Console.print("proof using ")
        Ast.syms(xs, ", ")
      case Ast.ProofInduction(_, x) =>
        Console.print("proof by induction ")
        Ast.sym(x)
      case Ast.ProofLean(_, s) =>
        Console.print("proof lean \"")
        Console.print(s)
        Console.print("\"")
    Ast.clauses(rest, ind)

// a handler's fns: an op with a continuation prints it as its first param
def Ast.hfns(xs: Coll.List[Ast.Fn], ks: Coll.List[Ast.KOp], ind: I64): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(f, t) =>
    val Ast.Fn(_, _, n, _, _, _, _, _) = f
    Ast.line(ind)
    Ast.fnDocOut(f, ind)
    Ast.kOf(ks, n) match
      case Coll.None => Ast.fn(f, ind)
      case Coll.Some(k) => Ast.fnSigK(f, ind, Coll.Some(k))
    Ast.hfns(t, ks, ind)

// a stateless handler's fns as written: no init (Parse.stateless puts it first), no self param
def Ast.asWritten(st: Ast.HState, fs: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = st match
  case Ast.Stateful => fs
  case Ast.Stateless => fs match
    case Coll.Nil => fs
    case Coll.Cons(_, ops) => Ast.noSelf(ops)

def Ast.noSelf(fs: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val Ast.Fn(d, l, n, gs, ps, ret, exit, body) = f
    val ps2: Coll.List[Ast.Binder] = ps match
      case Coll.Nil => ps
      case Coll.Cons(_, pt) => pt
    Coll.Cons(Ast.Fn(d, l, n, gs, ps2, ret, exit, body), Ast.noSelf(rest))

def Ast.dropGroup(fs: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(f, rest) =>
    val Ast.Fn(d, l, n, gs, ps, ret, exit, body) = f
    val gs2: Coll.List[Ast.Group] = gs match
      case Coll.Nil => gs
      case Coll.Cons(_, gt) => gt
    Coll.Cons(Ast.Fn(d, l, n, gs2, ps, ret, exit, body), Ast.dropGroup(rest))

def Ast.kOf(ks: Coll.List[Ast.KOp], op: Sym.Sym): Coll.Option[Sym.Sym] = ks match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Ast.KOp(o, k) = x
    if Sym.eq(o, op) then Coll.Some(k) else Ast.kOf(rest, op)

def Ast.fns(xs: Coll.List[Ast.Fn], ind: I64): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(f, t) =>
    Ast.line(ind)
    Ast.fnDocOut(f, ind)
    Ast.fn(f, ind)
    Ast.fns(t, ind)

def Ast.trans(xs: Coll.List[Ast.Trans]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(tr, t) =>
    val Ast.Trans(a, b) = tr
    Ast.sym(a)
    Console.print(" -> ")
    Ast.sym(b)
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        Ast.trans(t)

// a capability's ops as written (Parse.capDef): an op every state keeps has no facts; one move is <A> .. <B>; any
// other set of moves is a transition named as the op, def name <s name t> .. <t>. Parsing the text back gives the
// same transitions (Parse.resolveOps)
def Ast.ops(xs: Coll.List[Ast.Op], sts: Coll.List[Sym.Sym]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(o, t) =>
    val Ast.Op(d, _, name, gs, ps, ret, trs) = o
    Ast.line(Ast.step())
    Ast.doc(d, Ast.step())
    val mv = Ast.movesOf(trs, sts)
    mv match
      case Ast.ByRel =>
        Console.print("transition ")
        Ast.sym(name)
        Console.print(" ")
        Ast.trans(trs)
        Ast.line(Ast.step())
      case _ => ()
    Console.print("def ")
    Ast.sym(name)
    mv match
      case Ast.Stays => ()
      case Ast.OneMove(a, _) =>
        Console.print(" <")
        Ast.sym(a)
        Console.print(">")
      case Ast.ByRel =>
        Console.print(" <s ")
        Ast.sym(name)
        Console.print(" t>")
    Ast.groups(gs)
    mv match
      case Ast.Stays => gs match
        case Coll.Nil => ()
        case Coll.Cons(_, _) => Console.print(" ")
      case _ => Console.print(" ")
    Console.print("(")
    Ast.binders(ps)
    Console.print("): ")
    Ast.ty(ret)
    mv match
      case Ast.Stays => ()
      case Ast.OneMove(_, b) =>
        Console.print(" <")
        Ast.sym(b)
        Console.print(">")
      case Ast.ByRel => Console.print(" <t>")
    Ast.ops(t, sts)

// how an op's transitions are written
enum Ast.Moves:
  case Ast.Stays
  case Ast.OneMove(from: Sym.Sym, to: Sym.Sym)
  case Ast.ByRel

def Ast.movesOf(trs: Coll.List[Ast.Trans], sts: Coll.List[Sym.Sym]): Ast.Moves =
  if Ast.allStay(trs) && Coll.length(trs) == Coll.length(sts) then Ast.Stays
  else trs match
    case Coll.Cons(tr, rest) => rest match
      case Coll.Nil =>
        val Ast.Trans(a, b) = tr
        Ast.OneMove(a, b)
      case Coll.Cons(_, _) => Ast.ByRel
    case Coll.Nil => Ast.ByRel

def Ast.allStay(trs: Coll.List[Ast.Trans]): Bool = trs match
  case Coll.Nil => true
  case Coll.Cons(tr, rest) =>
    val Ast.Trans(a, b) = tr
    Sym.eq(a, b) && Ast.allStay(rest)

// no state line: one state Live, the start and the stop (Parse.proto)
def Ast.oneLive(sts: Coll.List[Sym.Sym], start: Sym.Sym, ends: Coll.List[Sym.Sym]): Bool =
  Ast.onlyLive(sts) && Str.eq(Sym.str(start), "Live") && Ast.onlyLive(ends)

def Ast.onlyLive(xs: Coll.List[Sym.Sym]): Bool = xs match
  case Coll.Cons(x, rest) => rest match
    case Coll.Nil => Str.eq(Sym.str(x), "Live")
    case Coll.Cons(_, _) => false
  case Coll.Nil => false

def Ast.rules(xs: Coll.List[Ast.RuleDef]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(rl, t) =>
    val Ast.RuleDef(_, name, ps, body) = rl
    Ast.line(Ast.step())
    Console.print("rule def ")
    Ast.sym(name)
    Console.print("(")
    Ast.syms(ps, ", ")
    Console.print(") = ")
    Ast.atoms(body)
    Ast.rules(t)

def Ast.cases(xs: Coll.List[Ast.Case]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(c, t) =>
    val Ast.Case(d, _, name, fs) = c
    Ast.line(Ast.step())
    Ast.doc(d, Ast.step())
    Console.print("case ")
    Ast.sym(name)
    fs match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("(")
        Ast.binders(fs)
        Console.print(")")
    Ast.cases(t)

def Ast.decl(d: Ast.Decl): Unit = d match
  case Ast.DFn(f) => Ast.fn(f, 0)
  case Ast.DVal(v) =>
    val Ast.Fn(_, _, name, _, _, ret, _, body) = v
    Console.print("val ")
    Ast.sym(name)
    Console.print(": ")
    Ast.ty(ret)
    body match
      case Ast.Def(_, e) =>
        Console.print(" =")
        Ast.body(e, 0)
      case _ => ()
  case Ast.DEnum(en) =>
    val Ast.Enum(_, _, name, gs, cs) = en
    Console.print("enum ")
    Ast.sym(name)
    Ast.groups(gs)
    Console.print(":")
    Ast.cases(cs)
  case Ast.DProto(p) =>
    val Ast.Proto(_, _, name, sts, start, ends, dropOp, ops, rules) = p
    Console.print("capability ")
    Ast.sym(name)
    Console.print(":")
    if Ast.oneLive(sts, start, ends) then ()
    else
      Ast.line(Ast.step())
      Console.print("state ")
      Ast.syms(sts, ", ")
      Ast.line(Ast.step())
      Console.print("start ")
      Ast.sym(start)
      Ast.line(Ast.step())
      Console.print("stop ")
      Ast.syms(ends, ", ")
    Ast.ops(ops, sts)
    dropOp match
      case Coll.None => ()
      case Coll.Some(o) =>
        Ast.line(Ast.step())
        Console.print("drop ")
        Ast.sym(o)
    Ast.rules(rules)
  case Ast.DHandler(h) =>
    val Ast.Handler(_, _, name, proto, fs, shots, st) = h
    Console.print("handler ")
    Ast.sym(name)
    val ks: Coll.List[Ast.KOp] = shots match
      case Ast.OneShot => Coll.Nil
      case Ast.MultiShot(a, xs) =>
        Console.print(" [")
        Ast.sym(a)
        Console.print(": Type]")
        xs
    // the parser gives every fn of a multi-shot handler its [A: Type]: printed once, on the handler
    val fs2: Coll.List[Ast.Fn] = shots match
      case Ast.OneShot => fs
      case Ast.MultiShot(_, _) => Ast.dropGroup(fs)
    Console.print(" for ")
    Ast.sym(proto)
    Console.print(":")
    Ast.hfns(Ast.asWritten(st, fs2), ks, Ast.step())
  case Ast.DTrait(tr) =>
    val Ast.Trait(_, _, name, gs, sigs) = tr
    Console.print("trait ")
    Ast.sym(name)
    Ast.groups(gs)
    Console.print(":")
    Ast.sigs(sigs, Ast.step())
  case Ast.DGiven(g) =>
    val Ast.Given(_, _, gs, head, fs) = g
    Console.print("given")
    Ast.groups(gs)
    Console.print(" ")
    Ast.ty(head)
    Console.print(":")
    Ast.fns(fs, Ast.step())
  case Ast.DType(td) =>
    val Ast.TypeDecl(_, _, name, gs, vals, body) = td
    body match
      case Ast.CStruct(fs) => Ast.cstruct(name, fs)
      case _ => Ast.typeDecl(name, gs, vals, body)

def Ast.tyArms(xs: Coll.List[Ast.TyArm]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(a, t) =>
    val Ast.TyArm(_, p, res) = a
    Ast.line(Ast.step())
    Console.print("case ")
    Ast.ty(p)
    Console.print(" => ")
    Ast.ty(res)
    Ast.tyArms(t)

def Ast.valArms(xs: Coll.List[Ast.ValArm]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(a, t) =>
    val Ast.ValArm(_, p, res) = a
    Ast.line(Ast.step())
    Console.print("case ")
    p match
      case Ast.VInt(v) => Console.printI64(v)
      case Ast.VStr(s) =>
        Console.print("\"")
        Console.print(s)
        Console.print("\"")
      case Ast.VBool(b) => Console.print(if b then "true" else "false")
      case Ast.VAny => Console.print("_")
    Console.print(" => ")
    Ast.ty(res)
    Ast.valArms(t)

// a source file as srs fmt writes it (decls parsed with Lex.Keep): each decl after its doc, which keeps the blank
// lines and comments written before it
def Ast.source(ds: Coll.List[Ast.Decl]): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, t) =>
    Ast.doc(Ast.declDocOf(d), 0)
    Ast.decl(d)
    Console.print("\n")
    Ast.source(t)

// a program: its decls, one blank line between two, a newline after the last
def Ast.print(ds: Coll.List[Ast.Decl]): Unit = ds match
  case Coll.Nil => ()
  case Coll.Cons(d, t) =>
    Ast.doc(Ast.declDocOf(d), 0)
    Ast.decl(d)
    Console.print("\n")
    t match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("\n")
        Ast.print(t)

// type Name groups (value binders) = body
def Ast.typeDecl(name: Sym.Sym, gs: Coll.List[Ast.Group], vals: Coll.List[Ast.Binder], body: Ast.TBody): Unit =
  Console.print("type ")
  Ast.sym(name)
  Ast.groups(gs)
  vals match
    case Coll.Nil => ()
    case Coll.Cons(_, _) =>
      Console.print(" (")
      Ast.binders(vals)
      Console.print(")")
  Console.print(" = ")
  body match
    case Ast.Alias(t) => Ast.ty(t)
    case Ast.TyMatch(s, arms) =>
      Ast.ty(s)
      Console.print(" match")
      Ast.tyArms(arms)
    case Ast.ValMatch(x, arms) =>
      Ast.sym(x)
      Console.print(" match")
      Ast.valArms(arms)
    case Ast.CStruct(_) => ()

// extern "libc" struct Libc.name:, one field per line
def Ast.cstruct(name: Sym.Sym, fs: Coll.List[Ast.CField]): Unit =
  Console.print("extern \"libc\" struct ")
  Ast.sym(name)
  Console.print(":")
  Ast.cfields(fs)

def Ast.cfields(fs: Coll.List[Ast.CField]): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val Ast.CField(_, n, t) = f
    Ast.line(Ast.step())
    Ast.sym(n)
    Console.print(": ")
    Ast.ty(t)
    Ast.cfields(rest)
