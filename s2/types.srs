// s2 self-host rung T1 (vic/c/s2-selfhost.md, vic/c/s2-typing-spec.md): the types of a program, as s1/check.srs infers
// them. a type is a K.Term: K.Con(name, args). a callee's [] binders open to fresh K.Vars at each call and are solved
// by K.unify (check mode first: the expected type binds them before the args, s1 vic-m5r.18); inside a generic body
// they are rigid, a K.Con named by the binder. every error is a Ty.Clash (data); every generic call and constructor
// records its instance (callee + type args), the input of mono and emit.

enum Ty.Clash:
  case Ty.Mismatch(line: I64, got: K.Term, want: K.Term)
  case Ty.Unknown(line: I64, name: Sym.Sym)
  case Ty.Arity(line: I64, name: Sym.Sym)
  case Ty.NotEnum(line: I64, got: K.Term)
  case Ty.NoOp(line: I64, name: Sym.Sym)
  case Ty.CannotInfer(line: I64, name: Sym.Sym)
  // a {} binder of protocol p with no capability of p in scope, or more than one (s1 theCap)
  case Ty.NoCap(line: I64, p: Sym.Sym)
  // a compile-time body (a top-level val) calls a fn with effects (s2/pure.srs), or opens a handler
  case Ty.Impure(line: I64, f: Sym.Sym)
  case Ty.ComptimeHandle(line: I64, h: Sym.Sym)
  // the purity rules are not a Datalog program: a bug in s2, as data
  case Ty.PureRules(rel: Sym.Sym)
  // a match with no `_` arm that misses a case of its enum (the first one missed)
  case Ty.NotExhaustive(line: I64, missing: Sym.Sym)
  // a pattern with another number of binders than its case has fields
  case Ty.PatArity(line: I64, c: Sym.Sym)
  // a trait goal: no local evidence and no given proves it; two givens tie; two locals prove it; the search of given
  // clauses ran out of fuel; the chosen name does not prove it; f{...} with another count than f's {} binders
  case Ty.NoGiven(line: I64, goal: K.Term)
  case Ty.AmbigGivens(line: I64, goal: K.Term)
  case Ty.AmbigEvidence(line: I64, goal: K.Term)
  case Ty.GivenFuel(line: I64, goal: K.Term)
  case Ty.ChosenBad(line: I64, goal: K.Term)
  case Ty.ChosenCount(line: I64, f: Sym.Sym)
  // shapes: a chosen name that is not a capability of p; evidence or a capability used as a value; a [] binder that
  // hides a type; a capability as a value param; a given that does not fit its trait; an extern slot at a non-pointer
  case Ty.ChosenNotCap(line: I64, p: Sym.Sym)
  case Ty.EvidenceValue(line: I64, x: Sym.Sym)
  case Ty.CapValue(line: I64, x: Sym.Sym)
  case Ty.BinderHides(line: I64, x: Sym.Sym)
  case Ty.CapParam(line: I64, x: Sym.Sym)
  case Ty.TraitArity(line: I64, t: Sym.Sym)
  case Ty.NotMethod(line: I64, m: Sym.Sym)
  case Ty.MissingMethod(line: I64, m: Sym.Sym)
  case Ty.SigDiffers(line: I64, m: Sym.Sym)
  case Ty.NotInHead(line: I64, x: Sym.Sym)
  case Ty.ExternSlot(line: I64, t: K.Term)
  // a request, or a call whose row has p, with no handler of p in scope (main's row must be empty)
  case Ty.UnhandledEffect(line: I64, p: Sym.Sym)
  // an rt_* extern called outside the fns of a handler named Srs.*
  case Ty.RtOutsideSrs(line: I64, f: Sym.Sym)
  // run-time code names a top-level val (a compile-time value)
  case Ty.ValAtRunTime(line: I64, x: Sym.Sym)

// a {} goal of a trait at a call (the binder's type under the call's type args), the locals in scope there and the chosen
// name if f{x}(...) wrote one: resolved after the whole program, with the final substitution
enum Ty.Goal:
  case Ty.Goal(line: I64, goal: K.Term, locals: Coll.List[Ty.Bind], chosen: Coll.Option[Sym.Sym])

// a generic callee at a call line, with its type args (vars until solved)
enum Ty.Inst:
  case Ty.Inst(line: I64, f: Sym.Sym, targs: Coll.List[K.Term])

enum Ty.Bind:
  case Ty.Bind(x: Sym.Sym, t: K.Term)

// the declarations the inference reads; rows: each def's implicit capabilities (s2/eff.srs)
enum Ty.Cx:
  case Ty.Cx(fns: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ps: Coll.List[Ast.Proto], hs: Coll.List[Ast.Handler], trs: Coll.List[Ast.Trait], mode: Ty.Mode, impure: Coll.SMap[Bool], rows: Eff.Rows, vals: Coll.SMap[Bool])

// a body that runs (a constructor allocates in a Region) or a top-level val body, evaluated at compile time (no Region, vic Q-U4)
enum Ty.Mode:
  case Ty.Run(by: Ty.By)
  case Ty.Comptime

// whose body runs: only the fns of a handler named Srs.* may call rt_* (vic 2026-11-09)
enum Ty.By:
  case Ty.User
  case Ty.Srs

// the substitution, the next fresh var, the clashes, the instances
enum Ty.St:
  case Ty.St(s: Coll.IMap[K.Term], next: I64, cs: Coll.List[Ty.Clash], is: Coll.List[Ty.Inst], gs: Coll.List[Ty.Goal], nom: Coll.SMap[K.Term])

enum Ty.At:
  case Ty.At(st: Ty.St, t: K.Term)

def Ty.con(n: Str): K.Term = K.Con(Sym.of(n), Coll.Nil)

def Ty.fresh(st: Ty.St): Ty.At =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.At(Ty.St(s, n + 1, cs, is, gs, nm), K.Var(n))

def Ty.clash(st: Ty.St, c: Ty.Clash): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.St(s, n, Coll.Cons(c, cs), is, gs, nm)

// got must equal want: unify, or a Mismatch (the state keeps its substitution). a value of a type with <> facts is
// a value of its body (it only refines it, vic-jxk): got widens to the body when it does not unify as it is
def Ty.expect(st: Ty.St, line: I64, got: K.Term, want: K.Term): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  K.unify(s, got, want) match
    case Coll.Some(s2) => Ty.St(s2, n, cs, is, gs, nm)
    case Coll.None => Ty.widen(nm, K.walk(s, got)) match
      case Coll.Some(body) => K.unify(s, body, want) match
        case Coll.Some(s3) => Ty.St(s3, n, cs, is, gs, nm)
        case Coll.None => Ty.St(s, n, Coll.Cons(Ty.Mismatch(line, got, want), cs), is, gs, nm)
      case Coll.None => Ty.St(s, n, Coll.Cons(Ty.Mismatch(line, got, want), cs), is, gs, nm)

def Ty.widen(nm: Coll.SMap[K.Term], t: K.Term): Coll.Option[K.Term] = t match
  case K.Con(n, _) => Coll.sLookup(nm, n)
  case _ => Coll.None

// the types with <> facts (kept nominal by Tl) and their bodies
def Ty.nominals(ds: Coll.List[Ast.Decl], m: Coll.SMap[K.Term]): Coll.SMap[K.Term] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DType(td) =>
      val Ast.TypeDecl(_, n, gs, _, body) = td
      val m2 = body match
        case Ast.Alias(t) => if Tl.hasFacts(gs) then Coll.sInsert(m, n, Ty.term(t, Coll.Nil)) else m
        case _ => m
      Ty.nominals(rest, m2)
    case _ => Ty.nominals(rest, m)

// unify when want is known (check mode), else nothing
def Ty.expectOpt(st: Ty.St, line: I64, got: K.Term, want: Coll.Option[K.Term]): Ty.St = want match
  case Coll.None => st
  case Coll.Some(w) => Ty.expect(st, line, got, w)

def Ty.lookup(bs: Coll.List[Ty.Bind], x: Sym.Sym): Coll.Option[K.Term] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) =>
    val Ty.Bind(y, t) = b
    if Sym.eq(x, y) then Coll.Some(t) else Ty.lookup(rest, x)

// ── Ast.Ty as a term: a name bound in tv (a [] binder: a var at a call, a rigid con in a body) is its term ──
def Ty.term(t: Ast.Ty, tv: Coll.List[Ty.Bind]): K.Term =
  val Ast.Ty(_, n, args, _, _) = t
  args match
    case Coll.Nil => Ty.lookup(tv, n) match
      case Coll.Some(x) => x
      case Coll.None => K.Con(n, Coll.Nil)
    case Coll.Cons(_, _) => K.Con(n, Ty.terms(args, tv, Coll.Nil))

def Ty.terms(ts: Coll.List[Ast.Ty], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = ts match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(t, rest) => Ty.terms(rest, tv, Coll.Cons(Ty.term(t, tv), acc))

// the [] binder names of groups
def Ty.tparams(gs: Coll.List[Ast.Group], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = gs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(g, rest) => g match
    case Ast.Types(bs) => Ty.tparams(rest, Ty.names(bs, acc))
    case Ast.Evidence(_) => Ty.tparams(rest, acc)
    case Ast.Facts(_) => Ty.tparams(rest, acc)

def Ty.names(bs: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, _) = b
    Ty.names(rest, Coll.Cons(x, acc))

// each binder name to a fresh var (a call site), in order; the vars are the instance's type args
enum Ty.Open:
  case Ty.Open(st: Ty.St, tv: Coll.List[Ty.Bind], vars: Coll.List[K.Term])

def Ty.open(st: Ty.St, xs: Coll.List[Sym.Sym], tv: Coll.List[Ty.Bind], vars: Coll.List[K.Term]): Ty.Open = xs match
  case Coll.Nil => Ty.Open(st, tv, Coll.rev(vars))
  case Coll.Cons(x, rest) =>
    val Ty.At(st1, v) = Ty.fresh(st)
    Ty.open(st1, rest, Coll.Cons(Ty.Bind(x, v), tv), Coll.Cons(v, vars))

// each binder name to a rigid con named by it (inside a generic body)
def Ty.rigid(xs: Coll.List[Sym.Sym], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Ty.rigid(rest, Coll.Cons(Ty.Bind(x, K.Con(x, Coll.Nil)), acc))

// ── lookups ──
def Ty.fnNamed(fs: Coll.List[Ast.Fn], f: Sym.Sym): Coll.Option[Ast.Fn] = fs match
  case Coll.Nil => Coll.None
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, n, _, _, _, _, _) = g
    if Sym.eq(n, f) then Coll.Some(g) else Ty.fnNamed(rest, f)

// the enum a case belongs to, and the case
enum Ty.CaseOf:
  case Ty.CaseOf(e: Ast.Enum, c: Ast.Case)

def Ty.caseNamed(es: Coll.List[Ast.Enum], f: Sym.Sym): Coll.Option[Ty.CaseOf] = es match
  case Coll.Nil => Coll.None
  case Coll.Cons(e, rest) =>
    val Ast.Enum(_, _, _, cases) = e
    Ty.caseIn(cases, e, f) match
      case Coll.Some(c) => Coll.Some(Ty.CaseOf(e, c))
      case Coll.None => Ty.caseNamed(rest, f)

def Ty.caseIn(cs: Coll.List[Ast.Case], e: Ast.Enum, f: Sym.Sym): Coll.Option[Ast.Case] = cs match
  case Coll.Nil => Coll.None
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    if Sym.eq(n, f) then Coll.Some(c) else Ty.caseIn(rest, e, f)

// the enum's type at fresh vars: E[v1..vn], with the binders bound for its fields
def Ty.openEnum(st: Ty.St, e: Ast.Enum): Ty.Open =
  val Ast.Enum(_, _, gs, _) = e
  Ty.open(st, Ty.tparams(gs, Coll.Nil), Coll.Nil, Coll.Nil)

def Ty.enumTerm(e: Ast.Enum, vars: Coll.List[K.Term]): K.Term =
  val Ast.Enum(_, n, _, _) = e
  K.Con(n, vars)

// ── expressions: the type and the elaborated form of e under locals bs, want = the expected type (check mode) ──
enum Ty.Ex:
  case Ty.Ex(st: Ty.St, t: K.Term, e: El.Expr)

enum Ty.Es:
  case Ty.Es(st: Ty.St, es: Coll.List[El.Expr])

def Ty.expr(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], e: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex = e match
  case Ast.Int(line, v) => Ty.lit(st, line, Ty.con("I64"), want, El.Int(line, v))
  case Ast.Bool(line, v) => Ty.lit(st, line, Ty.con("Bool"), want, El.Bool(line, v))
  case Ast.Str(line, s) => Ty.lit(st, line, Ty.con("Str"), want, El.Str(line, s))
  case Ast.Unit(line) => Ty.lit(st, line, Ty.con("Unit"), want, El.Unit(line))
  case Ast.Name(line, x) => Ty.lookup(bs, x) match
    case Coll.Some(t) => Ty.lit(Ty.nameUse(cx, st, line, x, t), line, t, want, El.Local(line, x))
    case Coll.None => Ty.call(cx, st, bs, line, x, Coll.Nil, Coll.Nil, Coll.Nil, want)
  case Ast.Call(line, f, targs, chosen, xs) => Ty.call(cx, st, bs, line, f, targs, chosen, xs, want)
  case Ast.Method(line, recv, op, xs) => Ty.method(cx, st, bs, line, recv, op, xs, want)
  case Ast.Bin(line, op, l, rhs) => Ty.bin(cx, st, bs, line, op, l, rhs, want)
  case Ast.Un(line, op, x) =>
    val t = Ty.con(Ty.unTy(op))
    val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.Some(t))
    Ty.lit(st1, line, t, want, El.Un(line, op, ex))
  case Ast.If(line, c, t, x) =>
    val Ty.Ex(st1, _, ec) = Ty.expr(cx, st, bs, c, Coll.Some(Ty.con("Bool")))
    val Ty.Ex(st2, tt, et) = Ty.expr(cx, st1, bs, t, want)
    val Ty.Ex(st3, _, ex) = Ty.expr(cx, st2, bs, x, Coll.Some(tt))
    Ty.Ex(st3, tt, El.If(line, ec, et, ex))
  case Ast.Match(line, s, arms) =>
    val Ty.Ex(st1, ts, es) = Ty.expr(cx, st, bs, s, Coll.None)
    Ty.arms(cx, st1, bs, line, ts, es, arms, want)
  case Ast.Block(line, ss, last) => Ty.block(cx, st, bs, line, ss, last, want, Coll.Nil)
  case Ast.While(line, c, b) =>
    val Ty.Ex(st1, _, ec) = Ty.expr(cx, st, bs, c, Coll.Some(Ty.con("Bool")))
    val Ty.Ex(st2, _, eb) = Ty.expr(cx, st1, bs, b, Coll.None)
    Ty.lit(st2, line, Ty.con("Unit"), want, El.While(line, ec, eb))
  case Ast.Assign(line, x, v) => Ty.lookup(bs, x) match
    case Coll.None => Ty.Ex(Ty.clash(st, Ty.Unknown(line, x)), Ty.con("Unit"), El.Bad(line))
    case Coll.Some(tx) =>
      val Ty.Ex(st1, _, ev) = Ty.expr(cx, st, bs, v, Coll.Some(tx))
      Ty.lit(st1, line, Ty.con("Unit"), want, El.Assign(line, x, ev))
  // a quantifier is a contract: checked, erased (no C)
  case Ast.Quant(line, _, x, t, b) =>
    val Ty.Ex(st1, _, _) = Ty.expr(cx, st, Coll.Cons(Ty.Bind(x, Ty.term(t, Coll.Nil)), bs), b, Coll.Some(Ty.con("Bool")))
    Ty.lit(st1, line, Ty.con("Bool"), want, El.Bool(line, true))

// a type that is known: checked against want
def Ty.lit(st: Ty.St, line: I64, t: K.Term, want: Coll.Option[K.Term], e: El.Expr): Ty.Ex = Ty.Ex(Ty.expectOpt(st, line, t, want), t, e)

// an expression that did not type: a fresh type, El.Bad
def Ty.bad(st: Ty.St, line: I64): Ty.Ex =
  val Ty.At(st1, v) = Ty.fresh(st)
  Ty.Ex(st1, v, El.Bad(line))

// ── calls: a def or a constructor (a name with no args is a nullary case) ──
def Ty.call(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Cx(fns, es, ps, _, _, _, _, _, _) = cx
  Ty.fnNamed(fns, f) match
    case Coll.Some(g) => Ty.callFn(cx, Ty.valCall(cx, Ty.rtCall(cx, Ty.pureCall(cx, st, line, f), line, g), line, f), bs, line, g, targs, chosen, xs, want)
    case Coll.None => Ty.caseNamed(es, f) match
      case Coll.Some(co) => Ty.callCase(cx, st, bs, line, co, xs, want)
      case Coll.None => Eff.reqOf(ps, f) match
        case Coll.Some(q) => Ty.request(cx, st, bs, line, q, xs, want)
        case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, f)), bs, xs), line)

// P.op(args): the op on the innermost capability of P in scope (vic 2026-11-09: the innermost handler answers)
def Ty.request(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, q: Eff.Req, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Eff.Req(p, op) = q
  Ty.innermost(Ty.subst(st), bs, p) match
    case Coll.Some(x) => Ty.method(cx, st, bs, line, x, op, xs, want)
    case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.UnhandledEffect(line, p)), bs, xs), line)

// the innermost local of protocol type p
def Ty.innermost(s: Coll.IMap[K.Term], bs: Coll.List[Ty.Bind], p: Sym.Sym): Coll.Option[Sym.Sym] = Ty.innermostFrom(s, bs, p, Coll.Nil)

// seen: the names of the inner locals; a capability whose name an inner local shadows is out of reach by its name
def Ty.innermostFrom(s: Coll.IMap[K.Term], bs: Coll.List[Ty.Bind], p: Sym.Sym, seen: Coll.List[Sym.Sym]): Coll.Option[Sym.Sym] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) =>
    val Ty.Bind(x, t) = b
    val isP: Bool = K.walk(s, t) match
      case K.Con(n, args) => Sym.eq(n, p) && Coll.length(args) == 0
      case _ => false
    if isP && !Ty.memberSym(x, seen) then Coll.Some(x) else Ty.innermostFrom(s, rest, p, Coll.Cons(x, seen))

// the callee's row: for each implicit capability, the caller's innermost of its protocol
def Ty.rowCaps(st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, cs: Coll.List[Eff.Cap], acc: Coll.List[Sym.Sym]): Ty.Caps = cs match
  case Coll.Nil => Ty.Caps(st, Coll.rev(acc))
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, _) = c
    Ty.innermost(Ty.subst(st), bs, p) match
      case Coll.Some(x) => Ty.rowCaps(st, bs, line, rest, Coll.Cons(x, acc))
      case Coll.None => Ty.rowCaps(Ty.clash(st, Ty.UnhandledEffect(line, p)), bs, line, rest, acc)

// the args alone (an unknown callee: still checked)
def Ty.args(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr]): Ty.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) =>
    val Ty.Ex(st1, _, _) = Ty.expr(cx, st, bs, x, Coll.None)
    Ty.args(cx, st1, bs, rest)

// f[T]{caps}(args): open the binders, explicit type args, check mode (want binds the result first), args left to right;
// each protocol {} binder takes a caller capability (the chosen name, else the one of its protocol in scope)
def Ty.callFn(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, g: Ast.Fn, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ast.Fn(_, name, gs, ps, ret, _, _) = g
  val tps = Ty.tparams(gs, Coll.Nil)
  val Ty.Open(st1, tv, vars) = Ty.open(st, tps, Coll.Nil, Coll.Nil)
  val st2 = Ty.explicit(st1, line, vars, Ty.terms(targs, Coll.Nil, Coll.Nil))
  val rt = Ty.term(ret, tv)
  val st3 = Ty.expectOpt(st2, line, rt, want)
  if Coll.length(ps) != Coll.length(xs) then Ty.Ex(Ty.args(cx, Ty.clash(st3, Ty.Arity(line, name)), bs, xs), rt, El.Bad(line))
  else
    val Ty.Es(st4, eargs) = Ty.params(cx, st3, bs, line, ps, tv, xs, Coll.Nil)
    val ev = Ty.evidence(gs, Coll.Nil)
    val st4b = if Coll.length(chosen) > 0 && Coll.length(chosen) != Coll.length(ev) then Ty.clash(st4, Ty.ChosenCount(line, name)) else st4
    val Ty.Caps(st5, caps) = Ty.capArgs(cx, st4b, bs, line, tv, ev, chosen, 0, Coll.Nil)
    val Ty.Cx(_, _, _, _, _, _, _, rows, _) = cx
    val Ty.Caps(st6, icaps) = Ty.rowCaps(st5, bs, line, Ty.runRow(cx, Eff.row(rows, name)), Coll.Nil)
    Ty.Ex(Ty.inst(st6, line, name, vars), rt, El.CallFn(line, name, vars, Coll.revOnto(Coll.rev(caps), icaps), eargs))

// record a generic instance (no binders: nothing to instantiate)
def Ty.inst(st: Ty.St, line: I64, name: Sym.Sym, vars: Coll.List[K.Term]): Ty.St = vars match
  case Coll.Nil => st
  case Coll.Cons(_, _) =>
    val Ty.St(s, n, cs, is, gs, nm) = st
    Ty.St(s, n, cs, Coll.Cons(Ty.Inst(line, name, vars), is), gs, nm)

// f[T1, ...]: each written type arg binds its binder (too many: Arity)
def Ty.explicit(st: Ty.St, line: I64, vars: Coll.List[K.Term], ts: Coll.List[K.Term]): Ty.St = ts match
  case Coll.Nil => st
  case Coll.Cons(t, rest) => vars match
    case Coll.Nil => Ty.clash(st, Ty.Arity(line, Sym.of("[]")))
    case Coll.Cons(v, vs) => Ty.explicit(Ty.expect(st, line, v, t), line, vs, rest)

// each arg against its param type (binders as opened); the elaborated args in order
def Ty.params(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], acc: Coll.List[El.Expr]): Ty.Es = ps match
  case Coll.Nil => Ty.Es(st, Coll.rev(acc))
  case Coll.Cons(p, prest) => xs match
    case Coll.Nil => Ty.Es(st, Coll.rev(acc))
    case Coll.Cons(x, xrest) =>
      val Ast.Binder(_, _, pt) = p
      val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.Some(Ty.term(pt, tv)))
      Ty.params(cx, st1, bs, line, prest, tv, xrest, Coll.Cons(ex, acc))

// ── capabilities at a call: each {} binder of a protocol type takes a caller capability ──
enum Ty.Caps:
  case Ty.Caps(st: Ty.St, caps: Coll.List[Sym.Sym])

// i = the binder's index among all {} binders (f{a, b}(x) picks by it)
def Ty.capArgs(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, tv: Coll.List[Ty.Bind], ev: Coll.List[Ast.Binder], chosen: Coll.List[Sym.Sym], i: I64, acc: Coll.List[Sym.Sym]): Ty.Caps = ev match
  case Coll.Nil => Ty.Caps(st, Coll.rev(acc))
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, pn, _, _, _) = t
    val Ty.Cx(_, _, ps, _, _, mode, _, _, _) = cx
    val compilerRegion: Bool = mode match
      case Ty.Comptime => Pure.isRegion(pn)
      case Ty.Run(_) => false
    if !Ty.isProto(ps, pn) then Ty.capArgs(cx, Ty.addGoal(st, Ty.Goal(line, Ty.term(t, tv), bs, Ty.nthSym(chosen, i))), bs, line, tv, rest, chosen, i + 1, acc)
    // at compile time the compiler supplies Region (vic 2026-11-09)
    else if compilerRegion then Ty.capArgs(cx, st, bs, line, tv, rest, chosen, i + 1, acc)
    else Ty.capFor(st, bs, line, pn, chosen, i) match
      case Ty.Caps(st1, c) => Ty.capArgs(cx, st1, bs, line, tv, rest, chosen, i + 1, Coll.revOnto(c, acc))

// the cap of protocol p: the chosen name at index i, else the one local of type p in scope (none or two: NoCap)
def Ty.capFor(st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, p: Sym.Sym, chosen: Coll.List[Sym.Sym], i: I64): Ty.Caps = chosen match
  case Coll.Cons(_, _) => Ty.nthSym(chosen, i) match
    case Coll.Some(x) => Ty.Caps(if Ty.isCapOf(Ty.subst(st), bs, x, p) then st else Ty.clash(st, Ty.ChosenNotCap(line, p)), Coll.Cons(x, Coll.Nil))
    case Coll.None => Ty.Caps(Ty.clash(st, Ty.NoCap(line, p)), Coll.Nil)
  case Coll.Nil => Ty.capsOf(Ty.subst(st), bs, p, Coll.Nil) match
    case Coll.Cons(x, more) => more match
      case Coll.Nil => Ty.Caps(st, Coll.Cons(x, Coll.Nil))
      case Coll.Cons(_, _) => Ty.Caps(Ty.clash(st, Ty.NoCap(line, p)), Coll.Nil)
    case Coll.Nil => Ty.Caps(Ty.clash(st, Ty.NoCap(line, p)), Coll.Nil)

// the distinct local names of type p (a shadowed name counts once)
def Ty.capsOf(s: Coll.IMap[K.Term], bs: Coll.List[Ty.Bind], p: Sym.Sym, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ty.Bind(x, t) = b
    val isP: Bool = K.walk(s, t) match
      case K.Con(n, args) => Sym.eq(n, p) && Coll.length(args) == 0
      case _ => false
    if isP && !Ty.memberSym(x, acc) then Ty.capsOf(s, rest, p, Coll.Cons(x, acc)) else Ty.capsOf(s, rest, p, acc)

def Ty.memberSym(x: Sym.Sym, xs: Coll.List[Sym.Sym]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(h, t) => if Sym.eq(h, x) then true else Ty.memberSym(x, t)

def Ty.nthSym(xs: Coll.List[Sym.Sym], i: I64): Coll.Option[Sym.Sym] = xs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) => if i == 0 then Coll.Some(x) else Ty.nthSym(rest, i - 1)

def Ty.isProto(ps: Coll.List[Ast.Proto], n: Sym.Sym): Bool = ps match
  case Coll.Nil => false
  case Coll.Cons(p, rest) =>
    val Ast.Proto(_, pn, _, _, _, _, _, _) = p
    if Sym.eq(pn, n) then true else Ty.isProto(rest, n)

// a constructor: the enum at fresh vars, check mode first, then the fields; it is a request on Region, so it allocates in
// the innermost Region in scope (a compile-time body allocates nothing at run time)
def Ty.callCase(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, co: Ty.CaseOf, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.CaseOf(e, c) = co
  val Ast.Enum(_, en, _, _) = e
  val Ast.Case(_, name, fields) = c
  val Ty.Open(st1, tv, vars) = Ty.openEnum(st, e)
  val et = Ty.enumTerm(e, vars)
  val st2 = Ty.expectOpt(st1, line, et, want)
  if Coll.length(fields) != Coll.length(xs) then Ty.Ex(Ty.args(cx, Ty.clash(st2, Ty.Arity(line, name)), bs, xs), et, El.Bad(line))
  else
    val st3 = Ty.inst(st2, line, name, vars)
    fields match
      case Coll.Nil => Ty.Ex(st3, et, El.Nullary(line, en, vars, name))
      case Coll.Cons(_, _) =>
        val Ty.Es(st4, eargs) = Ty.params(cx, st3, bs, line, fields, tv, xs, Coll.Nil)
        val Ty.Cx(_, _, _, _, _, mode, _, _, _) = cx
        mode match
          case Ty.Comptime => Ty.Ex(st4, et, El.New(line, en, vars, name, El.Comptime, eargs))
          case Ty.Run(_) => Ty.innermost(Ty.subst(st4), bs, Sym.of("Region")) match
            case Coll.Some(reg) => Ty.Ex(st4, et, El.New(line, en, vars, name, El.In(reg), eargs))
            case Coll.None => Ty.Ex(Ty.clash(st4, Ty.UnhandledEffect(line, Sym.of("Region"))), et, El.Bad(line))

// recv.op(args): recv is a capability (op of its protocol) or {} evidence of a trait (the trait method, trait args
// bound from the evidence type)
def Ty.method(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, recv: Sym.Sym, op: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Cx(_, _, ps, _, trs, _, _, _, _) = cx
  Ty.lookup(bs, recv) match
    case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, recv)), bs, xs), line)
    case Coll.Some(rt) => K.walk(Ty.subst(st), rt) match
      case K.Con(tn, targs) => Ty.protoOp(ps, tn, op) match
        case Coll.Some(o) =>
          val Ast.Op(_, _, ops, oret, _) = o
          Ty.callSig(cx, st, bs, line, recv, rt, op, ops, oret, Coll.Nil, xs, want)
        case Coll.None => Ty.traitMethod(trs, tn, op) match
          case Coll.Some(tm) =>
            val Ty.TM(tr, m) = tm
            val Ast.Trait(_, _, tgs, _) = tr
            val Ast.Fn(_, _, _, mps, mret, _, _) = m
            Ty.callSig(cx, st, bs, line, recv, rt, op, mps, mret, Ty.zipBind(Ty.tparams(tgs, Coll.Nil), targs, Coll.Nil), xs, want)
          case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.NoOp(line, op)), bs, xs), line)
      case _ => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.NoOp(line, op)), bs, xs), line)

def Ty.subst(st: Ty.St): Coll.IMap[K.Term] =
  val Ty.St(s, _, _, _, _, _) = st
  s

// a signature with its binders bound to tv: arity, args, result
def Ty.callSig(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, recv: Sym.Sym, rty: K.Term, name: Sym.Sym, ps: Coll.List[Ast.Binder], ret: Ast.Ty, tv: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val rt = Ty.term(ret, tv)
  if Coll.length(ps) != Coll.length(xs) then Ty.Ex(Ty.args(cx, Ty.clash(st, Ty.Arity(line, name)), bs, xs), rt, El.Bad(line))
  else
    val Ty.Es(st1, eargs) = Ty.params(cx, st, bs, line, ps, tv, xs, Coll.Nil)
    Ty.lit(st1, line, rt, want, El.Op(line, recv, rty, name, eargs))

def Ty.zipBind(xs: Coll.List[Sym.Sym], ts: Coll.List[K.Term], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => ts match
    case Coll.Nil => acc
    case Coll.Cons(t, trest) => Ty.zipBind(rest, trest, Coll.Cons(Ty.Bind(x, t), acc))

def Ty.protoOp(ps: Coll.List[Ast.Proto], p: Sym.Sym, op: Sym.Sym): Coll.Option[Ast.Op] = ps match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Ast.Proto(_, n, _, _, _, _, ops, _) = x
    if Sym.eq(n, p) then Ty.opIn(ops, op) else Ty.protoOp(rest, p, op)

def Ty.opIn(os: Coll.List[Ast.Op], op: Sym.Sym): Coll.Option[Ast.Op] = os match
  case Coll.Nil => Coll.None
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, n, _, _, _) = o
    if Sym.eq(n, op) then Coll.Some(o) else Ty.opIn(rest, op)

enum Ty.TM:
  case Ty.TM(t: Ast.Trait, m: Ast.Fn)

def Ty.traitMethod(trs: Coll.List[Ast.Trait], t: Sym.Sym, op: Sym.Sym): Coll.Option[Ty.TM] = trs match
  case Coll.Nil => Coll.None
  case Coll.Cons(tr, rest) =>
    val Ast.Trait(_, n, _, sigs) = tr
    if Sym.eq(n, t) then
      Ty.fnNamed(sigs, op) match
        case Coll.Some(m) => Coll.Some(Ty.TM(tr, m))
        case Coll.None => Coll.None
    else Ty.traitMethod(rest, t, op)

// ── operators: arithmetic on I64, comparison gives Bool (== and != on any one type), && || on Bool ──
def Ty.bin(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex = op match
  case Ast.Eq => Ty.eqOp(cx, st, bs, line, op, l, rhs, want)
  case Ast.Ne => Ty.eqOp(cx, st, bs, line, op, l, rhs, want)
  case Ast.And => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("Bool"), Ty.con("Bool"), want)
  case Ast.Or => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("Bool"), Ty.con("Bool"), want)
  case Ast.Lt => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("I64"), Ty.con("Bool"), want)
  case Ast.Le => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("I64"), Ty.con("Bool"), want)
  case Ast.Gt => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("I64"), Ty.con("Bool"), want)
  case Ast.Ge => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("I64"), Ty.con("Bool"), want)
  case _ => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("I64"), Ty.con("I64"), want)

// both operands of type arg, the result of type res
def Ty.both(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, arg: K.Term, res: K.Term, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Ex(st1, _, el) = Ty.expr(cx, st, bs, l, Coll.Some(arg))
  val Ty.Ex(st2, _, er) = Ty.expr(cx, st1, bs, rhs, Coll.Some(arg))
  Ty.lit(st2, line, res, want, El.Bin(line, op, el, er))

def Ty.eqOp(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Ex(st1, tl, el) = Ty.expr(cx, st, bs, l, Coll.None)
  val Ty.Ex(st2, _, er) = Ty.expr(cx, st1, bs, rhs, Coll.Some(tl))
  Ty.lit(st2, line, Ty.con("Bool"), want, El.Bin(line, op, el, er))

// ── match: the scrutinee is an enum E[args]; each arm binds its case fields with E's binders at args ──
def Ty.arms(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ts: K.Term, es: El.Expr, as: Coll.List[Ast.Arm], want: Coll.Option[K.Term]): Ty.Ex = as match
  case Coll.Nil => Ty.bad(st, line)
  case Coll.Cons(a, rest) =>
    val Ty.Cx(_, enums, _, _, _, _, _, _, _) = cx
    val st0 = Ty.missingCase(enums, as) match
      case Coll.Some(c) => Ty.clash(st, Ty.NotExhaustive(line, c))
      case Coll.None => st
    val Ty.AEx(st1, t1, ea) = Ty.arm(cx, st0, bs, ts, a, want)
    Ty.armsSame(cx, st1, bs, line, ts, es, rest, t1, Coll.Cons(ea, Coll.Nil))

// the arms after the first: each must have the first's type; the elaborated arms in order
def Ty.armsSame(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ts: K.Term, es: El.Expr, as: Coll.List[Ast.Arm], t: K.Term, acc: Coll.List[El.Arm]): Ty.Ex = as match
  case Coll.Nil => Ty.Ex(st, t, El.Match(line, es, ts, Coll.rev(acc)))
  case Coll.Cons(a, rest) =>
    val Ty.AEx(st1, _, ea) = Ty.arm(cx, st, bs, ts, a, Coll.Some(t))
    Ty.armsSame(cx, st1, bs, line, ts, es, rest, t, Coll.Cons(ea, acc))

// an arm: its type and its elaborated form
enum Ty.AEx:
  case Ty.AEx(st: Ty.St, t: K.Term, a: El.Arm)

def Ty.arm(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], ts: K.Term, a: Ast.Arm, want: Coll.Option[K.Term]): Ty.AEx =
  val Ast.Arm(line, p, b) = a
  val Ty.Cx(_, es, _, _, _, _, _, _, _) = cx
  val Ty.Ex(st9, t9, e9) = p match
    case Ast.PAny => Ty.expr(cx, st, bs, b, want)
    case Ast.PCase(c, binds) => Ty.caseNamed(es, c) match
      case Coll.None => Ty.expr(cx, Ty.clash(st, Ty.Unknown(line, c)), bs, b, want)
      case Coll.Some(co) =>
        val Ty.CaseOf(e, cs) = co
        val Ast.Case(_, _, fields) = cs
        val Ty.Open(st1, tv, vars) = Ty.openEnum(st, e)
        val st1b = if Coll.length(binds) == Coll.length(fields) then st1 else Ty.clash(st1, Ty.PatArity(line, c))
        val st2 = Ty.expect(st1b, line, ts, Ty.enumTerm(e, vars))
        Ty.expr(cx, st2, Ty.bindFields(binds, fields, tv, bs), b, want)
  Ty.AEx(st9, t9, El.Arm(line, p, e9))

def Ty.bindFields(xs: Coll.List[Sym.Sym], fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], bs: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => bs
  case Coll.Cons(x, rest) => fs match
    case Coll.Nil => bs
    case Coll.Cons(f, frest) =>
      val Ast.Binder(_, _, ft) = f
      Ty.bindFields(rest, frest, tv, if Str.eq(Sym.str(x), "_") then bs else Coll.Cons(Ty.Bind(x, Ty.term(ft, tv)), bs))

// ── blocks: val/var bind (an annotation is the expected type), handle binds a capability of the handler's protocol;
// acc = the elaborated statements so far, reversed ──
def Ty.block(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ss: Coll.List[Ast.Stmt], last: Ast.Expr, want: Coll.Option[K.Term], acc: Coll.List[El.Stmt]): Ty.Ex = ss match
  case Coll.Nil =>
    val Ty.Ex(st1, t, el) = Ty.expr(cx, st, bs, last, want)
    Ty.Ex(st1, t, El.Block(line, Coll.rev(acc), el))
  case Coll.Cons(s, rest) => s match
    case Ast.Val(sl, x, ann, e) => Ty.bindStmt(cx, st, bs, line, sl, x, ann, e, false, rest, last, want, acc)
    case Ast.Var(sl, x, ann, e) => Ty.bindStmt(cx, st, bs, line, sl, x, ann, e, true, rest, last, want, acc)
    // the handler's row takes the innermost capabilities outside this handle (E1b)
    case Ast.Handle(sl, x, h, xs) =>
      val Ty.Cx(_, _, _, hs, _, mode, _, rows, _) = cx
      val Ty.Es(st1, eargs) = Ty.exprs(cx, Ty.pureHandle(mode, st, sl, h), bs, xs, Coll.Nil)
      val Ty.Caps(st2, caps) = Ty.rowCaps(st1, bs, sl, Eff.row(rows, h), Coll.Nil)
      Ty.block(cx, st2, Coll.Cons(Ty.Bind(x, K.Con(Ty.protoOf(hs, h), Coll.Nil)), bs), line, rest, last, want, Coll.Cons(El.Handle(sl, x, h, caps, eargs), acc))
    case Ast.Do(e) =>
      val Ty.Ex(st1, _, ee) = Ty.expr(cx, st, bs, e, Coll.None)
      Ty.block(cx, st1, bs, line, rest, last, want, Coll.Cons(El.Do(ee), acc))
    // a loop invariant or measure: checked, erased
    case Ast.Check(_, k, e) =>
      val want2 = k match
        case Ast.LInvariant => Ty.con("Bool")
        case Ast.LDecreases => Ty.con("I64")
      val Ty.Ex(st1, _, _) = Ty.expr(cx, st, bs, e, Coll.Some(want2))
      Ty.block(cx, st1, bs, line, rest, last, want, acc)

def Ty.exprs(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], acc: Coll.List[El.Expr]): Ty.Es = xs match
  case Coll.Nil => Ty.Es(st, Coll.rev(acc))
  case Coll.Cons(x, rest) =>
    val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.None)
    Ty.exprs(cx, st1, bs, rest, Coll.Cons(ex, acc))

def Ty.bindStmt(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, sl: I64, x: Sym.Sym, ann: Coll.Option[Ast.Ty], e: Ast.Expr, mut: Bool, rest: Coll.List[Ast.Stmt], last: Ast.Expr, want: Coll.Option[K.Term], acc: Coll.List[El.Stmt]): Ty.Ex =
  val wa: Coll.Option[K.Term] = ann match
    case Coll.None => Coll.None
    case Coll.Some(t) => Coll.Some(Ty.term(t, Coll.Nil))
  val Ty.Ex(st1, te, ee) = Ty.expr(cx, st, bs, e, wa)
  val tx = wa match
    case Coll.None => te
    case Coll.Some(w) => w
  Ty.block(cx, st1, Coll.Cons(Ty.Bind(x, tx), bs), line, rest, last, want, Coll.Cons(El.Val(sl, x, tx, mut, ee), acc))

def Ty.protoOf(hs: Coll.List[Ast.Handler], h: Sym.Sym): Sym.Sym = hs match
  case Coll.Nil => h
  case Coll.Cons(x, rest) =>
    val Ast.Handler(_, n, p, _) = x
    if Sym.eq(n, h) then p else Ty.protoOf(rest, h)

// ── a def: params and {} binders as locals, binders rigid, the body checked against the declared result ──
enum Ty.FnEx:
  case Ty.FnEx(st: Ty.St, f: El.Fn)

// row: the implicit capabilities (s2/eff.srs), outermost locals, C params after the written ones
def Ty.fn(cx: Ty.Cx, st0: Ty.St, f: Ast.Fn, row: Coll.List[Eff.Cap]): Ty.FnEx =
  val Ast.Fn(line, name, gs, ps, ret, _, body) = f
  val Ty.Cx(_, _, protos, _, _, _, _, _, _) = cx
  val tps = Ty.tparams(gs, Coll.Nil)
  val tv = Ty.rigid(tps, Coll.Nil)
  val ev = Ty.evidence(gs, Coll.Nil)
  val bs = Ty.binds(ps, tv, Ty.binds(ev, tv, Ty.rowBinds(row, Coll.Nil)))
  val rt = Ty.term(ret, tv)
  val caps = Coll.revOnto(Coll.rev(Ty.capNames(protos, ev, Coll.Nil)), Ty.rowNames(row))
  val eps = Ty.elParams(ps, tv, Coll.Nil)
  val st = Ty.fnShape(cx, st0, line, tps, ps)
  body match
    case Ast.Extern => Ty.FnEx(st, El.Fn(line, name, tps, caps, eps, rt, El.Extern))
    case Ast.Def(_, e) =>
      val Ty.Ex(st1, _, eb) = Ty.expr(cx, st, bs, e, Coll.Some(rt))
      Ty.FnEx(st1, El.Fn(line, name, tps, caps, eps, rt, El.Def(eb)))

def Ty.rowBinds(row: Coll.List[Eff.Cap], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = row match
  case Coll.Nil => acc
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, x) = c
    Ty.rowBinds(rest, Coll.Cons(Ty.Bind(x, K.Con(p, Coll.Nil)), acc))

def Ty.rowNames(row: Coll.List[Eff.Cap]): Coll.List[Sym.Sym] = row match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(c, rest) =>
    val Eff.Cap(_, x) = c
    Coll.Cons(x, Ty.rowNames(rest))

// the {} binders of a protocol type, in written order (leading C params)
def Ty.capNames(ps: Coll.List[Ast.Proto], ev: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ev match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Ty.capNames(ps, rest, if Ty.isProto(ps, n) then Coll.Cons(x, acc) else acc)

def Ty.elParams(ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[El.Param]): Coll.List[El.Param] = ps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, t) = p
    Ty.elParams(rest, tv, Coll.Cons(El.Param(x, Ty.term(t, tv)), acc))

def Ty.binds(ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, t) = p
    Ty.binds(rest, tv, Coll.Cons(Ty.Bind(x, Ty.term(t, tv)), acc))

def Ty.evidence(gs: Coll.List[Ast.Group], acc: Coll.List[Ast.Binder]): Coll.List[Ast.Binder] = gs match
  case Coll.Nil => acc
  case Coll.Cons(g, rest) => g match
    case Ast.Evidence(bs) => Ty.evidence(rest, Coll.revOnto(Coll.rev(bs), acc))
    case Ast.Types(_) => Ty.evidence(rest, acc)
    case Ast.Facts(_) => Ty.evidence(rest, acc)

// ── the program: every def and handler fn; then each instance must be solved ──
enum Ty.Result:
  case Ty.Result(clashes: Coll.List[Ty.Clash], insts: Coll.List[Ty.Inst], s: Coll.IMap[K.Term], fns: Coll.List[El.Fn], hs: Coll.List[El.Handler], gvs: Coll.List[El.Given])

def Ty.cxOf(ds: Coll.List[Ast.Decl], fns: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ps: Coll.List[Ast.Proto], hs: Coll.List[Ast.Handler], trs: Coll.List[Ast.Trait], vals: Coll.SMap[Bool]): Ty.Cx = ds match
  case Coll.Nil => Ty.Cx(fns, es, ps, hs, trs, Ty.Run(Ty.User), Coll.sEmpty(), Eff.none(), vals)
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) => Ty.cxOf(rest, Coll.Cons(f, fns), es, ps, hs, trs, vals)
    case Ast.DVal(f) =>
      val Ast.Fn(_, vn, _, _, _, _, _) = f
      Ty.cxOf(rest, Coll.Cons(f, fns), es, ps, hs, trs, Coll.sInsert(vals, vn, true))
    case Ast.DEnum(e) => Ty.cxOf(rest, fns, Coll.Cons(e, es), ps, hs, trs, vals)
    case Ast.DProto(p) => Ty.cxOf(rest, fns, es, Coll.Cons(p, ps), hs, trs, vals)
    case Ast.DHandler(h) => Ty.cxOf(rest, fns, es, ps, Coll.Cons(h, hs), trs, vals)
    case Ast.DTrait(t) => Ty.cxOf(rest, fns, es, ps, hs, Coll.Cons(t, trs), vals)
    case Ast.DGiven(_) => Ty.cxOf(rest, fns, es, ps, hs, trs, vals)
    case Ast.DType(_) => Ty.cxOf(rest, fns, es, ps, hs, trs, vals)

// the fns with effects first (s2/pure.srs): a top-level val may call none of them
def Ty.check(ds: Coll.List[Ast.Decl]): Ty.Result = Eff.rows(ds) match
  case Eff.Got(rows) => Ty.checkWith(ds, Coll.Nil, rows)
  case Eff.RulesBad(rel) => Ty.Result(Coll.Cons(Ty.PureRules(rel), Coll.Nil), Coll.Nil, Coll.Tip, Coll.Nil, Coll.Nil, Coll.Nil)

// tgs: the {} goals of the types the defs name (Tl.typeGoals), resolved with the goals of the calls; rows: Eff.rows(ds)
def Ty.checkWith(ds: Coll.List[Ast.Decl], tgs: Coll.List[Tl.Goal], rows: Eff.Rows): Ty.Result =
  val Ty.Cx(fns0, es0, ps0, hs0, trs0, mode0, _, _, vals0) = Ty.cxOf(ds, Coll.Nil, Coll.Nil, Coll.Nil, Coll.Nil, Coll.Nil, Coll.sEmpty())
  val nom = Ty.nominals(ds, Coll.sEmpty())
  val pr = if Ty.hasVal(ds) then Pure.impure(ds, rows) else Pure.Got(Coll.sEmpty())
  val imp: Coll.SMap[Bool] = pr match
    case Pure.Got(m) => m
    case Pure.RulesBad(_) => Coll.sEmpty()
  val st0 = pr match
    case Pure.Got(_) => Ty.St(Coll.Tip, 0, Coll.Nil, Coll.Nil, Coll.Nil, nom)
    case Pure.RulesBad(rel) => Ty.St(Coll.Tip, 0, Coll.Cons(Ty.PureRules(rel), Coll.Nil), Coll.Nil, Coll.Nil, nom)
  val cx = Ty.Cx(fns0, es0, ps0, hs0, trs0, mode0, imp, rows, vals0)
  val Ty.Fns(st1, fs, hs, gvs) = Ty.decls(cx, st0, ds, Coll.Nil, Coll.Nil, Coll.Nil)
  val Ty.St(s, _, cs, is, gs, _) = st1
  val allGoals = Ty.typeGoals(fns0, tgs, Coll.rev(gs))
  val cs2 = Ty.externSlots(es0, Ty.externs(fns0, Coll.sEmpty()), s, is, Ty.goals(ps0, Ty.cands(ps0, ds, Coll.Nil), s, allGoals, cs))
  Ty.Result(Ty.unsolved(s, is, cs2), is, s, fs, hs, gvs)

// the elaborated defs, handlers and givens so far (reversed while walking)
enum Ty.Fns:
  case Ty.Fns(st: Ty.St, fs: Coll.List[El.Fn], hs: Coll.List[El.Handler], gvs: Coll.List[El.Given])

// top-level defs, handler fns (the prelude has Arena and Heap, lib/prelude.srs:38) and given fns
def Ty.decls(cx: Ty.Cx, st: Ty.St, ds: Coll.List[Ast.Decl], acc: Coll.List[El.Fn], hacc: Coll.List[El.Handler], gacc: Coll.List[El.Given]): Ty.Fns = ds match
  case Coll.Nil => Ty.Fns(st, Coll.rev(acc), Coll.rev(hacc), Coll.rev(gacc))
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) =>
      val Ast.Fn(_, fname, _, _, _, _, _) = f
      val Ty.Cx(_, _, _, _, _, _, _, rows, _) = cx
      val Ty.FnEx(st1, ef) = Ty.fn(cx, st, f, Eff.row(rows, fname))
      Ty.decls(cx, st1, rest, Coll.Cons(ef, acc), hacc, gacc)
    // a top-level val is checked as a compile-time body (no row: only Region, the compiler's); no C (vic 2026-11-09)
    case Ast.DVal(f) =>
      val Ty.FnEx(st1, _) = Ty.fn(Ty.comptime(cx), st, f, Coll.Nil)
      Ty.decls(cx, st1, rest, acc, hacc, gacc)
    // every fn of a handler takes the handler's row (E1b): the capabilities its handle site keeps
    case Ast.DHandler(h) =>
      val Ast.Handler(_, hn, p, fs) = h
      val Ty.Cx(_, _, _, _, _, _, _, rows, _) = cx
      val Ty.Fns(st1, efs, _, _) = Ty.fnsEl(Ty.byHandler(cx, hn), st, fs, Eff.row(rows, hn), Coll.Nil)
      Ty.decls(cx, st1, rest, acc, Coll.Cons(El.Handler(hn, p, efs), hacc), gacc)
    // a given's fns see its binders: its [] binders are theirs, its {} evidence is local
    case Ast.DGiven(g) =>
      val Ast.Given(_, gs, head, fs) = g
      val Ty.Fns(st1, efs, _, _) = Ty.fnsEl(cx, Ty.givenShape(cx, st, g), Ty.underGroups(gs, fs, Coll.Nil), Coll.Nil, Coll.Nil)
      val gv = El.Given(Ty.tparams(gs, Coll.Nil), Ty.binderNames(Ty.evidence(gs, Coll.Nil), Coll.Nil), Ty.term(head, Coll.Nil), efs)
      Ty.decls(cx, st1, rest, acc, hacc, Coll.Cons(gv, gacc))
    case _ => Ty.decls(cx, st, rest, acc, hacc, gacc)

def Ty.underGroups(gs: Coll.List[Ast.Group], fs: Coll.List[Ast.Fn], acc: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(f, rest) =>
    val Ast.Fn(line, name, fgs, ps, ret, exit, body) = f
    Ty.underGroups(gs, rest, Coll.Cons(Ast.Fn(line, name, Coll.revOnto(Coll.rev(gs), fgs), ps, ret, exit, body), acc))

def Ty.binderNames(bs: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, _) = b
    Ty.binderNames(rest, Coll.Cons(x, acc))

// fns of a handler or given, elaborated in order, each with row
def Ty.fnsEl(cx: Ty.Cx, st: Ty.St, fs: Coll.List[Ast.Fn], row: Coll.List[Eff.Cap], acc: Coll.List[El.Fn]): Ty.Fns = fs match
  case Coll.Nil => Ty.Fns(st, Coll.rev(acc), Coll.Nil, Coll.Nil)
  case Coll.Cons(f, rest) =>
    val Ty.FnEx(st1, ef) = Ty.fn(cx, st, f, row)
    Ty.fnsEl(cx, st1, rest, row, Coll.Cons(ef, acc))

// an instance with a type arg that is still a var after the whole program: CannotInfer
def Ty.unsolved(s: Coll.IMap[K.Term], is: Coll.List[Ty.Inst], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = is match
  case Coll.Nil => cs
  case Coll.Cons(i, rest) =>
    val Ty.Inst(line, f, ts) = i
    if Ty.ground(s, ts) then Ty.unsolved(s, rest, cs) else Ty.unsolved(s, rest, Coll.Cons(Ty.CannotInfer(line, f), cs))

def Ty.ground(s: Coll.IMap[K.Term], ts: Coll.List[K.Term]): Bool = ts match
  case Coll.Nil => true
  case Coll.Cons(t, rest) => if Ty.groundT(K.reify(s, t)) then Ty.ground(s, rest) else false

def Ty.groundT(t: K.Term): Bool = t match
  case K.Var(_) => false
  case K.Int(_) => true
  case K.Con(_, args) => Ty.groundAll(args)

def Ty.groundAll(ts: Coll.List[K.Term]): Bool = ts match
  case Coll.Nil => true
  case Coll.Cons(t, rest) => if Ty.groundT(t) then Ty.groundAll(rest) else false

def Ty.unTy(op: Ast.UnOp): Str = op match
  case Ast.Neg => "I64"
  case Ast.Not => "Bool"

def Ty.lineOf(e: Ast.Expr): I64 = e match
  case Ast.Int(l, _) => l
  case Ast.Bool(l, _) => l
  case Ast.Str(l, _) => l
  case Ast.Unit(l) => l
  case Ast.Name(l, _) => l
  case Ast.Call(l, _, _, _, _) => l
  case Ast.Method(l, _, _, _) => l
  case Ast.Bin(l, _, _, _) => l
  case Ast.Un(l, _, _) => l
  case Ast.If(l, _, _, _) => l
  case Ast.Match(l, _, _) => l
  case Ast.Block(l, _, _) => l
  case Ast.While(l, _, _) => l
  case Ast.Assign(l, _, _) => l
  case Ast.Quant(l, _, _, _, _) => l

// the fns of a handler named Srs.* run as Ty.Srs: the runtime's own bodies, the only callers of rt_*
def Ty.byHandler(cx: Ty.Cx, h: Sym.Sym): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, _, imp, rows, vals) = cx
  val s = Sym.str(h)
  val by: Ty.By = if Str.len(s) > 4 && Str.eq(Str.slice(s, 0, 4), "Srs.") then Ty.Srs else Ty.User
  Ty.Cx(fns, es, ps, hs, trs, Ty.Run(by), imp, rows, vals)

// a call of an rt_* extern anywhere but a Srs.* handler body
def Ty.rtCall(cx: Ty.Cx, st: Ty.St, line: I64, g: Ast.Fn): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _) = cx
  val Ast.Fn(_, n, _, _, _, _, body) = g
  val s = Sym.str(n)
  val rt: Bool = body match
    case Ast.Extern => Str.len(s) > 3 && Str.eq(Str.slice(s, 0, 3), "rt_")
    case _ => false
  mode match
    case Ty.Run(by) => by match
      case Ty.Srs => st
      case Ty.User => if rt then Ty.clash(st, Ty.RtOutsideSrs(line, n)) else st
    case Ty.Comptime => if rt then Ty.clash(st, Ty.RtOutsideSrs(line, n)) else st

// a callee's row as this body passes it: at compile time the compiler owns Region (vic Q-U4), so no capability for it
def Ty.runRow(cx: Ty.Cx, cs: Coll.List[Eff.Cap]): Coll.List[Eff.Cap] =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _) = cx
  mode match
    case Ty.Comptime => Ty.notRegion(cs)
    case Ty.Run(_) => cs

def Ty.notRegion(cs: Coll.List[Eff.Cap]): Coll.List[Eff.Cap] = cs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, _) = c
    if Str.eq(Sym.str(p), "Region") then Ty.notRegion(rest) else Coll.Cons(c, Ty.notRegion(rest))

// run-time code may not name a top-level val yet (its C static data is a later rung)
def Ty.valCall(cx: Ty.Cx, st: Ty.St, line: I64, f: Sym.Sym): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, _, _, vals) = cx
  mode match
    case Ty.Comptime => st
    case Ty.Run(_) => Coll.sLookup(vals, f) match
      case Coll.Some(_) => Ty.clash(st, Ty.ValAtRunTime(line, f))
      case Coll.None => st

def Ty.comptime(cx: Ty.Cx): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, _, imp, rows, vals) = cx
  Ty.Cx(fns, es, ps, hs, trs, Ty.Comptime, imp, rows, vals)

// in a compile-time body (vic Q-U4) a call of a fn with effects, and any handle, is a clash
def Ty.pureCall(cx: Ty.Cx, st: Ty.St, line: I64, f: Sym.Sym): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, imp, _, _) = cx
  mode match
    case Ty.Run(_) => st
    case Ty.Comptime => if Pure.has(imp, f) then Ty.clash(st, Ty.Impure(line, f)) else st

def Ty.pureHandle(mode: Ty.Mode, st: Ty.St, line: I64, h: Sym.Sym): Ty.St = mode match
  case Ty.Run(_) => st
  case Ty.Comptime => Ty.clash(st, Ty.ComptimeHandle(line, h))

// ── a match covers every case of its enum, or has a `_` arm: the first case no arm names ──
def Ty.missingCase(es: Coll.List[Ast.Enum], as: Coll.List[Ast.Arm]): Coll.Option[Sym.Sym] =
  if Ty.hasAny(as) then Coll.None
  else Ty.firstCase(as) match
    case Coll.None => Coll.None
    case Coll.Some(c) => Ty.caseNamed(es, c) match
      case Coll.None => Coll.None
      case Coll.Some(co) =>
        val Ty.CaseOf(e, _) = co
        val Ast.Enum(_, _, _, cases) = e
        Ty.uncovered(cases, as)

def Ty.hasAny(as: Coll.List[Ast.Arm]): Bool = as match
  case Coll.Nil => false
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, _) = a
    p match
      case Ast.PAny => true
      case Ast.PCase(_, _) => Ty.hasAny(rest)

def Ty.firstCase(as: Coll.List[Ast.Arm]): Coll.Option[Sym.Sym] = as match
  case Coll.Nil => Coll.None
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, _) = a
    p match
      case Ast.PCase(c, _) => Coll.Some(c)
      case Ast.PAny => Ty.firstCase(rest)

def Ty.uncovered(cs: Coll.List[Ast.Case], as: Coll.List[Ast.Arm]): Coll.Option[Sym.Sym] = cs match
  case Coll.Nil => Coll.None
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, n, _) = c
    if Ty.armNames(n, as) then Ty.uncovered(rest, as) else Coll.Some(n)

def Ty.armNames(n: Sym.Sym, as: Coll.List[Ast.Arm]): Bool = as match
  case Coll.Nil => false
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, p, _) = a
    p match
      case Ast.PCase(c, _) => if Sym.eq(c, n) then true else Ty.armNames(n, rest)
      case Ast.PAny => Ty.armNames(n, rest)

def Ty.addGoal(st: Ty.St, g: Ty.Goal): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.St(s, n, cs, is, Coll.Cons(g, gs), nm)

// ── trait goals (s1/given.srs): local evidence first, else the givens whose head matches, each with its own {} goals
// proved (fuel per step); the most specific head wins, on a draw the one with fewer {} binders (Scala3) ──
enum Ty.Cand:
  case Ty.Cand(id: I64, tps: Coll.List[Sym.Sym], head: K.Term, evs: Coll.List[K.Term])

// a given's [] binders as rigid names in its head and in its {} goals of traits
def Ty.cands(ps: Coll.List[Ast.Proto], ds: Coll.List[Ast.Decl], acc: Coll.List[Ty.Cand]): Coll.List[Ty.Cand] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, rest) => d match
    case Ast.DGiven(g) =>
      val Ast.Given(_, gs, head, _) = g
      val tps = Ty.tparams(gs, Coll.Nil)
      val tv = Ty.rigid(tps, Coll.Nil)
      Ty.cands(ps, rest, Coll.Cons(Ty.Cand(Coll.length(acc), tps, Ty.term(head, tv), Ty.traitGoals(ps, Ty.evidence(gs, Coll.Nil), tv, Coll.Nil)), acc))
    case _ => Ty.cands(ps, rest, acc)

def Ty.traitGoals(ps: Coll.List[Ast.Proto], bs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Ty.traitGoals(ps, rest, tv, if Ty.isProto(ps, n) then acc else Coll.Cons(Ty.term(t, tv), acc))

enum Ty.Res:
  case Ty.Proved
  case Ty.NoneFound
  case Ty.Tie
  case Ty.TwoLocals
  case Ty.OutOfFuel

def Ty.givenFuel(): I64 = 1000

// every goal of the program, with the final substitution; a goal that is not ground has a CannotInfer already
def Ty.goals(ps: Coll.List[Ast.Proto], cands: Coll.List[Ty.Cand], s: Coll.IMap[K.Term], gs: Coll.List[Ty.Goal], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = gs match
  case Coll.Nil => cs
  case Coll.Cons(g, rest) =>
    val Ty.Goal(line, t0, locals, chosen) = g
    val t = K.reify(s, t0)
    if !Ty.groundT(t) then Ty.goals(ps, cands, s, rest, cs)
    else if Ty.isProtoT(ps, t) then Ty.goals(ps, cands, s, rest, if Coll.length(Ty.localsOf(s, locals, t, Coll.Nil)) == 1 then cs else Coll.Cons(Ty.NoCap(line, Ty.headOf(t)), cs))
    else chosen match
      case Coll.Some(x) => Ty.goals(ps, cands, s, rest, if Ty.localProves(s, locals, x, t) then cs else Coll.Cons(Ty.ChosenBad(line, t), cs))
      case Coll.None => Ty.goals(ps, cands, s, rest, Ty.resClash(line, t, Ty.resolve(cands, s, locals, t, Ty.givenFuel()), cs))

def Ty.resClash(line: I64, t: K.Term, res: Ty.Res, cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = res match
  case Ty.Proved => cs
  case Ty.NoneFound => Coll.Cons(Ty.NoGiven(line, t), cs)
  case Ty.Tie => Coll.Cons(Ty.AmbigGivens(line, t), cs)
  case Ty.TwoLocals => Coll.Cons(Ty.AmbigEvidence(line, t), cs)
  case Ty.OutOfFuel => Coll.Cons(Ty.GivenFuel(line, t), cs)

def Ty.localProves(s: Coll.IMap[K.Term], locals: Coll.List[Ty.Bind], x: Sym.Sym, t: K.Term): Bool = Ty.lookup(locals, x) match
  case Coll.Some(u) => Mono.termEq(K.reify(s, u), t)
  case Coll.None => false

def Ty.resolve(cands: Coll.List[Ty.Cand], s: Coll.IMap[K.Term], locals: Coll.List[Ty.Bind], t: K.Term, fuel: I64): Ty.Res =
  if fuel <= 0 then Ty.OutOfFuel
  else
    val n = Coll.length(Ty.localsOf(s, locals, t, Coll.Nil))
    if n > 1 then Ty.TwoLocals
    else if n == 1 then Ty.Proved
    else Ty.viable(cands, cands, s, locals, t, fuel, Coll.Nil) match
      case Ty.Viable(vs) => Ty.best(vs, vs)
      case Ty.ViableFuel => Ty.OutOfFuel

// the distinct local names whose type is t (a shadowed name counts once)
def Ty.localsOf(s: Coll.IMap[K.Term], bs: Coll.List[Ty.Bind], t: K.Term, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ty.Bind(x, u) = b
    if !Ty.memberSym(x, acc) && Mono.termEq(K.reify(s, u), t) then Ty.localsOf(s, rest, t, Coll.Cons(x, acc)) else Ty.localsOf(s, rest, t, acc)

enum Ty.Vs:
  case Ty.Viable(cs: Coll.List[Ty.Cand])
  case Ty.ViableFuel

// the givens whose head matches t and whose own goals are proved
def Ty.viable(all: Coll.List[Ty.Cand], cs: Coll.List[Ty.Cand], s: Coll.IMap[K.Term], locals: Coll.List[Ty.Bind], t: K.Term, fuel: I64, acc: Coll.List[Ty.Cand]): Ty.Vs = cs match
  case Coll.Nil => Ty.Viable(Coll.rev(acc))
  case Coll.Cons(c, rest) =>
    val Ty.Cand(_, tps, head, evs) = c
    Mono.matchT(tps, head, t, Coll.Some(Coll.Nil)) match
      case Coll.None => Ty.viable(all, rest, s, locals, t, fuel, acc)
      case Coll.Some(sub) => Ty.allProved(all, s, locals, Mono.applyAll(sub, evs, Coll.Nil), fuel - 1) match
        case Ty.Proved => Ty.viable(all, rest, s, locals, t, fuel, Coll.Cons(c, acc))
        case Ty.OutOfFuel => Ty.ViableFuel
        case _ => Ty.viable(all, rest, s, locals, t, fuel, acc)

def Ty.allProved(all: Coll.List[Ty.Cand], s: Coll.IMap[K.Term], locals: Coll.List[Ty.Bind], gs: Coll.List[K.Term], fuel: I64): Ty.Res = gs match
  case Coll.Nil => Ty.Proved
  case Coll.Cons(g, rest) => Ty.resolve(all, s, locals, g, fuel) match
    case Ty.Proved => Ty.allProved(all, s, locals, rest, fuel)
    case Ty.NoneFound => Ty.NoneFound
    case Ty.Tie => Ty.Tie
    case Ty.TwoLocals => Ty.TwoLocals
    case Ty.OutOfFuel => Ty.OutOfFuel

// the one candidate better than every other one, else a tie (none: NoneFound)
def Ty.best(vs: Coll.List[Ty.Cand], all: Coll.List[Ty.Cand]): Ty.Res = vs match
  case Coll.Nil => if Coll.length(all) == 0 then Ty.NoneFound else Ty.Tie
  case Coll.Cons(c, rest) => if Ty.beatsAll(c, all) then Ty.Proved else Ty.best(rest, all)

def Ty.beatsAll(c: Ty.Cand, all: Coll.List[Ty.Cand]): Bool = all match
  case Coll.Nil => true
  case Coll.Cons(d, rest) => if Ty.sameCand(c, d) || Ty.better(c, d) then Ty.beatsAll(c, rest) else false

// the same given decl (two decls with one head are two candidates: a tie)
def Ty.sameCand(a: Ty.Cand, b: Ty.Cand): Bool =
  val Ty.Cand(i, _, _, _) = a
  val Ty.Cand(j, _, _, _) = b
  i == j

def Ty.better(a: Ty.Cand, b: Ty.Cand): Bool =
  val Ty.Cand(_, atps, ah, aev) = a
  val Ty.Cand(_, btps, bh, bev) = b
  val ab = Mono.isSome(Mono.matchT(btps, bh, ah, Coll.Some(Coll.Nil)))
  val ba = Mono.isSome(Mono.matchT(atps, ah, bh, Coll.Some(Coll.Nil)))
  if ab && !ba then true else if ab && ba then Coll.length(aev) < Coll.length(bev) else false

// ── shapes (s1/check.srs, s1/given.srs): what a use of a name, a def's binders and a given must look like ──
// evidence is only a method receiver, a capability only a {} arg: neither is a value
def Ty.nameUse(cx: Ty.Cx, st: Ty.St, line: I64, x: Sym.Sym, t: K.Term): Ty.St =
  val Ty.Cx(_, _, ps, _, trs, _, _, _, _) = cx
  K.walk(Ty.subst(st), t) match
    case K.Con(n, _) =>
      if Ty.isProto(ps, n) then Ty.clash(st, Ty.CapValue(line, x))
      else if Ty.isTrait(trs, n) then Ty.clash(st, Ty.EvidenceValue(line, x))
      else st
    case _ => st

def Ty.isTrait(trs: Coll.List[Ast.Trait], n: Sym.Sym): Bool = trs match
  case Coll.Nil => false
  case Coll.Cons(t, rest) =>
    val Ast.Trait(_, m, _, _) = t
    if Sym.eq(m, n) then true else Ty.isTrait(rest, n)

def Ty.isEnum(es: Coll.List[Ast.Enum], n: Sym.Sym): Bool = es match
  case Coll.Nil => false
  case Coll.Cons(e, rest) =>
    val Ast.Enum(_, m, _, _) = e
    if Sym.eq(m, n) then true else Ty.isEnum(rest, n)

def Ty.isBuiltin(n: Sym.Sym): Bool =
  val s = Sym.str(n)
  Str.eq(s, "I64") || Str.eq(s, "Bool") || Str.eq(s, "Str") || Str.eq(s, "Unit") || Str.eq(s, "Ptr") || Str.eq(s, "Type")

// x is a local whose type is protocol p
def Ty.isCapOf(s: Coll.IMap[K.Term], bs: Coll.List[Ty.Bind], x: Sym.Sym, p: Sym.Sym): Bool = Ty.lookup(bs, x) match
  case Coll.None => false
  case Coll.Some(t) => K.walk(s, t) match
    case K.Con(n, args) => Sym.eq(n, p) && Coll.length(args) == 0
    case _ => false

// a [] binder may not hide a type; a capability is a {} binder, never a value param
def Ty.fnShape(cx: Ty.Cx, st: Ty.St, line: I64, tps: Coll.List[Sym.Sym], ps: Coll.List[Ast.Binder]): Ty.St =
  Ty.capParams(cx, Ty.hides(cx, st, line, tps), ps)

def Ty.hides(cx: Ty.Cx, st: Ty.St, line: I64, tps: Coll.List[Sym.Sym]): Ty.St = tps match
  case Coll.Nil => st
  case Coll.Cons(x, rest) =>
    val Ty.Cx(_, es, ps, _, trs, _, _, _, _) = cx
    val known = Ty.isBuiltin(x) || Ty.isEnum(es, x) || Ty.isProto(ps, x) || Ty.isTrait(trs, x)
    Ty.hides(cx, if known then Ty.clash(st, Ty.BinderHides(line, x)) else st, line, rest)

def Ty.capParams(cx: Ty.Cx, st: Ty.St, ps: Coll.List[Ast.Binder]): Ty.St = ps match
  case Coll.Nil => st
  case Coll.Cons(b, rest) =>
    val Ast.Binder(line, x, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    val Ty.Cx(_, _, protos, _, _, _, _, _, _) = cx
    Ty.capParams(cx, if Ty.isProto(protos, n) then Ty.clash(st, Ty.CapParam(line, x)) else st, rest)

// a given: its head names a trait with that many args; its fns are exactly the trait's methods, each with the trait's
// signature at the head's args; each [] binder occurs in the head
def Ty.givenShape(cx: Ty.Cx, st: Ty.St, g: Ast.Given): Ty.St =
  val Ast.Given(line, gs, head, fs) = g
  val Ast.Ty(_, tn, targs, _, _) = head
  val Ty.Cx(_, _, _, _, trs, _, _, _, _) = cx
  val st1 = Ty.inHead(st, line, Ty.tparams(gs, Coll.Nil), head)
  Ty.traitNamed(trs, tn) match
    case Coll.None => Ty.clash(st1, Ty.Unknown(line, tn))
    case Coll.Some(tr) =>
      val Ast.Trait(_, _, tgs, sigs) = tr
      val ttps = Ty.tparams(tgs, Coll.Nil)
      if Coll.length(ttps) != Coll.length(targs) then Ty.clash(st1, Ty.TraitArity(line, tn))
      else
        val tps = Ty.tparams(gs, Coll.Nil)
        val tv = Ty.rigid(tps, Coll.Nil)
        val sub = Ty.zipBind(ttps, Ty.terms(targs, tv, Coll.Nil), Coll.Nil)
        Ty.missing(sigs, fs, line, Ty.methods(sigs, fs, sub, tv, st1))

def Ty.traitNamed(trs: Coll.List[Ast.Trait], n: Sym.Sym): Coll.Option[Ast.Trait] = trs match
  case Coll.Nil => Coll.None
  case Coll.Cons(t, rest) =>
    val Ast.Trait(_, m, _, _) = t
    if Sym.eq(m, n) then Coll.Some(t) else Ty.traitNamed(rest, n)

def Ty.inHead(st: Ty.St, line: I64, tps: Coll.List[Sym.Sym], head: Ast.Ty): Ty.St = tps match
  case Coll.Nil => st
  case Coll.Cons(x, rest) => Ty.inHead(if Ty.occurs(x, head) then st else Ty.clash(st, Ty.NotInHead(line, x)), line, rest, head)

def Ty.occurs(x: Sym.Sym, t: Ast.Ty): Bool =
  val Ast.Ty(_, n, args, _, _) = t
  if Sym.eq(x, n) then true else Ty.occursAll(x, args)

def Ty.occursAll(x: Sym.Sym, ts: Coll.List[Ast.Ty]): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(t, rest) => if Ty.occurs(x, t) then true else Ty.occursAll(x, rest)

// each fn of the given: a method of the trait, with its signature (params and result at the head's args)
def Ty.methods(sigs: Coll.List[Ast.Fn], fs: Coll.List[Ast.Fn], sub: Coll.List[Ty.Bind], tv: Coll.List[Ty.Bind], st: Ty.St): Ty.St = fs match
  case Coll.Nil => st
  case Coll.Cons(f, rest) =>
    val Ast.Fn(line, n, _, ps, ret, _, _) = f
    val st1 = Ty.fnNamed(sigs, n) match
      case Coll.None => Ty.clash(st, Ty.NotMethod(line, n))
      case Coll.Some(m) =>
        val Ast.Fn(_, _, _, mps, mret, _, _) = m
        val same = Mono.termEq(Ty.term(ret, tv), Ty.term(mret, sub)) && Mono.termsEq(Ty.binderTerms(ps, tv, Coll.Nil), Ty.binderTerms(mps, sub, Coll.Nil))
        if same then st else Ty.clash(st, Ty.SigDiffers(line, n))
    Ty.methods(sigs, rest, sub, tv, st1)

def Ty.binderTerms(bs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    Ty.binderTerms(rest, tv, Coll.Cons(Ty.term(t, tv), acc))

def Ty.missing(sigs: Coll.List[Ast.Fn], fs: Coll.List[Ast.Fn], line: I64, st: Ty.St): Ty.St = sigs match
  case Coll.Nil => st
  case Coll.Cons(m, rest) =>
    val Ast.Fn(_, n, _, _, _, _, _) = m
    val st1 = Ty.fnNamed(fs, n) match
      case Coll.Some(_) => st
      case Coll.None => Ty.clash(st, Ty.MissingMethod(line, n))
    Ty.missing(rest, fs, line, st1)

// a generic extern's [] slots are void*: each type arg it is called at must be a pointer (an enum or Ptr)
def Ty.externSlots(es: Coll.List[Ast.Enum], ext: Coll.SMap[Bool], s: Coll.IMap[K.Term], is: Coll.List[Ty.Inst], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = is match
  case Coll.Nil => cs
  case Coll.Cons(i, rest) =>
    val Ty.Inst(line, f, ts) = i
    Ty.externSlots(es, ext, s, rest, if Pure.has(ext, f) then Ty.ptrSlots(es, s, line, ts, cs) else cs)

// the generic externs, by name
def Ty.externs(fs: Coll.List[Ast.Fn], m: Coll.SMap[Bool]): Coll.SMap[Bool] = fs match
  case Coll.Nil => m
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, n, _, _, _, _, body) = g
    val m2 = body match
      case Ast.Extern => Coll.sInsert(m, n, true)
      case _ => m
    Ty.externs(rest, m2)

def Ty.ptrSlots(es: Coll.List[Ast.Enum], s: Coll.IMap[K.Term], line: I64, ts: Coll.List[K.Term], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = ts match
  case Coll.Nil => cs
  case Coll.Cons(t0, rest) =>
    val t = K.reify(s, t0)
    val ok: Bool = t match
      case K.Con(n, _) => Ty.isEnum(es, n) || Str.eq(Sym.str(n), "Ptr")
      case _ => true
    Ty.ptrSlots(es, s, line, rest, if ok then cs else Coll.Cons(Ty.ExternSlot(line, t), cs))

// the impure set is read only in compile-time bodies: a program without a top-level val needs none
def Ty.hasVal(ds: Coll.List[Ast.Decl]): Bool = ds match
  case Coll.Nil => false
  case Coll.Cons(d, rest) => d match
    case Ast.DVal(_) => true
    case _ => Ty.hasVal(rest)

// a protocol goal (a type's {f: File} binder) is a capability in scope, not a given
def Ty.isProtoT(ps: Coll.List[Ast.Proto], t: K.Term): Bool = t match
  case K.Con(n, _) => Ty.isProto(ps, n)
  case _ => false

def Ty.headOf(t: K.Term): Sym.Sym = t match
  case K.Con(n, _) => n
  case _ => Sym.of("?")

// each type goal under its def's binders: [] rigid, {} the locals that may prove it
def Ty.typeGoals(fns: Coll.List[Ast.Fn], tgs: Coll.List[Tl.Goal], acc: Coll.List[Ty.Goal]): Coll.List[Ty.Goal] = tgs match
  case Coll.Nil => acc
  case Coll.Cons(g, rest) =>
    val Tl.Goal(line, f, goal) = g
    Ty.fnNamed(fns, f) match
      case Coll.None => Ty.typeGoals(fns, rest, acc)
      case Coll.Some(fd) =>
        val Ast.Fn(_, _, gs, _, _, _, _) = fd
        val tv = Ty.rigid(Ty.tparams(gs, Coll.Nil), Coll.Nil)
        Ty.typeGoals(fns, rest, Coll.Cons(Ty.Goal(line, Ty.term(goal, tv), Ty.binds(Ty.evidence(gs, Coll.Nil), tv, Coll.Nil), Coll.None), acc))
