// s2 self-host rung T1 (vic/c/s2-selfhost.md, vic/c/s2-typing-spec.md): the types of a program, as s1/check.srs infers
// them. a type is a K.Term: K.Con(name, args). a callee's [] binders open to fresh K.Vars at each call and are solved
// by K.unify (check mode first: the expected type binds them before the args, s1 vic-m5r.18); inside a generic body
// they are rigid, a K.Con named by the binder. every error is a Ty.Clash (data); every generic call and constructor
// records its instance (callee + type args), the input of mono and emit.

enum Ty.Clash:
  case Ty.Mismatch(line: I64, got: K.Term, want: K.Term)
  case Ty.Unknown(line: I64, name: Sym.Sym)
  case Ty.Arity(line: I64, name: Sym.Sym)
  case Ty.NotEnum(line: I64, got: K.Term)
  case Ty.NoOp(line: I64, name: Sym.Sym)
  case Ty.CannotInfer(line: I64, name: Sym.Sym)
  // a {} binder of protocol p with no capability of p in scope, or more than one (s1 theCap)
  case Ty.NoCap(line: I64, p: Sym.Sym)
  // a compile-time body (a top-level val) calls a fn with effects (s2/pure.srs), or opens a handler
  case Ty.Impure(line: I64, f: Sym.Sym)
  case Ty.ComptimeHandle(line: I64, h: Sym.Sym)
  // the purity rules are not a Datalog program: a bug in s2, as data
  case Ty.PureRules(rel: Sym.Sym)
  // a match with no `_` arm that misses a case of its enum (the first one missed)
  case Ty.NotExhaustive(line: I64, missing: Sym.Sym)
  // a pattern with another number of binders than its case has fields
  case Ty.PatArity(line: I64, c: Sym.Sym)
  // a trait goal: no local evidence and no given proves it; two givens tie; two locals prove it; the search of given
  // clauses ran out of fuel; the chosen name does not prove it; f{...} with another count than f's {} binders
  case Ty.NoGiven(line: I64, goal: K.Term)
  case Ty.AmbigGivens(line: I64, goal: K.Term)
  case Ty.AmbigEvidence(line: I64, goal: K.Term)
  case Ty.GivenFuel(line: I64, goal: K.Term)
  case Ty.ChosenBad(line: I64, goal: K.Term)
  case Ty.ChosenCount(line: I64, f: Sym.Sym)
  // shapes: a chosen name that is not a capability of p; evidence or a capability used as a value; a [] binder that
  // hides a type; a capability as a value param; a given that does not fit its trait; an extern slot at a non-pointer
  case Ty.ChosenNotCap(line: I64, p: Sym.Sym)
  case Ty.EvidenceValue(line: I64, x: Sym.Sym)
  case Ty.CapValue(line: I64, x: Sym.Sym)
  case Ty.BinderHides(line: I64, x: Sym.Sym)
  case Ty.CapParam(line: I64, x: Sym.Sym)
  // a value type (a result, a field, a type arg of one) that names capability p: capabilities are erased (vic 2026-11-09)
  case Ty.CapErased(line: I64, p: Sym.Sym)
  // a given whose head is not a trait (a capability is implemented by a handler)
  case Ty.NotTrait(line: I64, n: Sym.Sym)
  // multi-shot handlers (vic-hm63): resume of a name that is not this op's continuation; an op with k whose result is
  // not the answer type; a multi-shot handler (its C, selective CPS, is a later rung)
  case Ty.ResumeNotK(line: I64, k: Sym.Sym)
  case Ty.AnswerType(line: I64, op: Sym.Sym)
  case Ty.MultishotShape(line: I64, p: Sym.Sym)
  case Ty.TraitArity(line: I64, t: Sym.Sym)
  case Ty.NotMethod(line: I64, m: Sym.Sym)
  case Ty.MissingMethod(line: I64, m: Sym.Sym)
  case Ty.SigDiffers(line: I64, m: Sym.Sym)
  case Ty.NotInHead(line: I64, x: Sym.Sym)
  case Ty.ExternSlot(line: I64, t: K.Term)
  // a request, or a call whose row has p, with no handler of p in scope (main's row must be empty)
  case Ty.UnhandledEffect(line: I64, p: Sym.Sym)
  // in a given's fn, a capability its trait method does not declare (vic Q2: the given's row is a subset)
  case Ty.GivenRow(line: I64, p: Sym.Sym)
  // a world capability (Srs.Env, Srs.Files, Srs.Clock, Srs.Net) handled outside main by a def that holds no binder of it
  case Ty.AmbientWorld(line: I64, p: Sym.Sym)
  // an rt_* extern called outside the fns of a handler named Srs.*
  case Ty.RtOutsideSrs(line: I64, f: Sym.Sym)
  // a libc extern called outside the fns of a handler named Srs.*
  case Ty.LibcOutsideHandler(line: I64, f: Sym.Sym)
  // handler state: the type init returns is not pointer-shaped (the env keeps it as a void*); an op whose self is another type
  case Ty.StateShape(line: I64, h: Sym.Sym)
  case Ty.StateType(line: I64, op: Sym.Sym)
  // run-time code names a top-level val (a compile-time value)
  case Ty.ValAtRunTime(line: I64, x: Sym.Sym)
  // an int literal outside its type t (a U32 above 2^32 - 1)
  case Ty.IntRange(line: I64, t: K.Term)
  // A1 arrays: an assignment to a local with an identity; xs(i) with i not proved in [0, n); a slice whose bounds are
  // not proved; xs.at(i) where no local in scope holds the length
  case Ty.AssignVal(line: I64, x: Sym.Sym)
  case Ty.IndexUnproved(line: I64, xs: Sym.Sym)
  case Ty.SliceUnproved(line: I64, f: Sym.Sym)
  case Ty.LenUnnamed(line: I64, xs: Sym.Sym)
  // A1b: Array.put of a value that is not a scalar
  case Ty.PutData(line: I64, xs: Sym.Sym)
  // a ctor pattern binder named like a declared ctor: a nested pattern, not supported (a binder is always a variable)
  case Ty.NestedPattern(line: I64, x: Sym.Sym)
  // 3e: a handler fn does not declare the {} binders its op declares (first, in order); an op binder that is no capability protocol
  case Ty.OpSig(line: I64, op: Sym.Sym)
  case Ty.OpBinder(line: I64, op: Sym.Sym)

// a {} goal of a trait at a call (the binder's type under the call's type args), the locals in scope there and the chosen
// name if f{x}(...) wrote one: resolved after the whole program, with the final substitution
enum Ty.Goal:
  case Ty.Goal(line: I64, goal: K.Term, locals: Coll.List[Ty.Bind], chosen: Coll.Option[Sym.Sym])

// a generic callee at a call line, with its type args (vars until solved)
enum Ty.Inst:
  case Ty.Inst(line: I64, f: Sym.Sym, targs: Coll.List[K.Term])

enum Ty.Bind:
  case Ty.Bind(x: Sym.Sym, t: K.Term)
  // A1 (vic/c/array-design.md): an immutable I64 local (a param, a val) and its identity id, unique in the program.
  // an Array length and a fact name the identity, not the name: a shadowing local or a type that leaves its block
  // cannot make two values one. a binding runs at most once per call outside loops, so one id is one value per call
  case Ty.Val(x: Sym.Sym, t: K.Term, id: I64)
  // a fact of an if condition on identities, true in its then-arm (Ty.facts)
  case Ty.Fact(a: Ty.Atom)
  // inside a while body or the rest of a multi-shot handle a binding runs more than once per call: no new identity
  case Ty.Loop
  // Array.put of data: x was bound in this fn by Array.fill or Array.tabulate (placed before its Ty.Bind in bs), so its slots live in
  // the Region of that call and Flow checks what a put stores against it (Flow.Bnd home); any other array keeps put-data
  case Ty.Home(x: Sym.Sym)

// the facts an if condition gives (signed I64 compares of immutable locals, no arithmetic but b - c): 0 <= a; a < b;
// a <= b; a <= b - c
enum Ty.Atom:
  case Ty.Lo(a: I64)
  case Ty.Lt(a: I64, b: I64)
  case Ty.Le(a: I64, b: I64)
  case Ty.LeSub(a: I64, b: I64, c: I64)

// the declarations the inference reads; rows: each def's implicit capabilities (s2/eff.srs)
enum Ty.Cx:
  case Ty.Cx(fns: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ps: Coll.List[Ast.Proto], hs: Coll.List[Ast.Handler], trs: Coll.List[Ast.Trait], mode: Ty.Mode, impure: Coll.SMap[Bool], rows: Eff.Rows, vals: Coll.SMap[Bool], arr: Names.Arrays, idx: Ty.Idx)

// a body that runs (a constructor allocates in a Region) or a top-level val body, evaluated at compile time (no Region, vic Q-U4)
enum Ty.Mode:
  case Ty.Run(by: Ty.By)
  case Ty.Comptime

// whose body runs: only the fns of a handler named Srs.* may call rt_* (vic 2026-11-09)
enum Ty.By:
  case Ty.User
  // the user def main: the one place a world capability is handled
  case Ty.Main
  case Ty.Srs
  // a fn of a given: its capabilities are its trait method's {} binders
  case Ty.Given
  // an op of a multi-shot handler: its continuation k, resumed with v, giving the answer ans (vic-hm63)
  case Ty.MultiOp(k: Sym.Sym, v: K.Term, ans: K.Term)

// the substitution, the next fresh var, the clashes, the instances
enum Ty.St:
  case Ty.St(s: K.Subst, next: I64, cs: Coll.List[Ty.Clash], is: Coll.List[Ty.Inst], gs: Coll.List[Ty.Goal], nom: Coll.SMap[K.Term])

enum Ty.At:
  case Ty.At(st: Ty.St, t: K.Term)

def Ty.con(n: Str): K.Term = K.Con(Sym.of(n), Coll.Nil)

def Ty.fresh(st: Ty.St): Ty.At =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.At(Ty.St(s, n + 1, cs, is, gs, nm), K.Var(n))

def Ty.clash(st: Ty.St, c: Ty.Clash): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.St(s, n, Coll.Cons(c, cs), is, gs, nm)

// got must equal want: unify, or a Mismatch (the state keeps its substitution). a value of a type with <> facts is
// a value of its body (it only refines it, vic-jxk): got widens to the body when it does not unify as it is
def Ty.expect(st: Ty.St, line: I64, got: K.Term, want: K.Term): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  K.unify(s, got, want) match
    case Coll.Some(s2) => Ty.St(s2, n, cs, is, gs, nm)
    case Coll.None => Ty.widen(nm, K.walk(s, got)) match
      case Coll.Some(body) => K.unify(s, body, want) match
        case Coll.Some(s3) => Ty.St(s3, n, cs, is, gs, nm)
        case Coll.None => Ty.St(s, n, Coll.Cons(Ty.Mismatch(line, got, want), cs), is, gs, nm)
      case Coll.None => Ty.St(s, n, Coll.Cons(Ty.Mismatch(line, got, want), cs), is, gs, nm)

def Ty.widen(nm: Coll.SMap[K.Term], t: K.Term): Coll.Option[K.Term] = t match
  case K.Con(n, _) => Coll.sLookup(nm, n)
  case _ => Coll.None

// the types with <> facts (kept nominal by Tl) and their bodies
def Ty.nominals(ds: Coll.List[Ast.Decl], m: Coll.SMap[K.Term]): Coll.SMap[K.Term] = ds match
  case Coll.Nil => m
  case Coll.Cons(d, rest) => d match
    case Ast.DType(td) =>
      val Ast.TypeDecl(_, _, n, gs, _, body) = td
      val m2 = body match
        case Ast.Alias(t) => if Tl.hasFacts(gs) then Coll.sInsert(m, n, Ty.term(t, Coll.Nil)) else m
        case _ => m
      Ty.nominals(rest, m2)
    case _ => Ty.nominals(rest, m)

// unify when want is known (check mode), else nothing
def Ty.expectOpt(st: Ty.St, line: I64, got: K.Term, want: Coll.Option[K.Term]): Ty.St = want match
  case Coll.None => st
  case Coll.Some(w) => Ty.expect(st, line, got, w)

def Ty.lookup(bs: Coll.List[Ty.Bind], x: Sym.Sym): Coll.Option[K.Term] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(y, t) => if Sym.eq(x, y) then Coll.Some(t) else Ty.lookup(rest, x)
    case Ty.Val(y, t, _) => if Sym.eq(x, y) then Coll.Some(t) else Ty.lookup(rest, x)
    case Ty.Fact(_) => Ty.lookup(rest, x)
    case Ty.Loop => Ty.lookup(rest, x)
    case Ty.Home(_) => Ty.lookup(rest, x)

// a [] binder in tv (a type name: never a value's identity)
def Ty.lookupTy(bs: Coll.List[Ty.Bind], x: Sym.Sym): Coll.Option[K.Term] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(y, t) => if Sym.eq(x, y) then Coll.Some(t) else Ty.lookupTy(rest, x)
    case _ => Ty.lookupTy(rest, x)

// the identity of the innermost local x: none when it is mutable, not I64, or shadowed by such a local (A1)
def Ty.idOf(bs: Coll.List[Ty.Bind], x: Sym.Sym): Coll.Option[I64] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(y, _) => if Sym.eq(x, y) then Coll.None else Ty.idOf(rest, x)
    case Ty.Val(y, _, id) => if Sym.eq(x, y) then Coll.Some(id) else Ty.idOf(rest, x)
    case _ => Ty.idOf(rest, x)

// the innermost local whose identity is id, still reachable by its name (A1: a length read at run time)
def Ty.nameOfId(bs: Coll.List[Ty.Bind], id: I64, seen: Coll.List[Sym.Sym]): Coll.Option[Sym.Sym] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(y, _) => Ty.nameOfId(rest, id, Coll.Cons(y, seen))
    case Ty.Val(y, _, j) =>
      if j == id && !Ty.memberSym(y, seen) then Coll.Some(y) else Ty.nameOfId(rest, id, Coll.Cons(y, seen))
    case _ => Ty.nameOfId(rest, id, seen)

def Ty.holds(bs: Coll.List[Ty.Bind], a: Ty.Atom): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(b, rest) => b match
    case Ty.Fact(f) => if Ty.atomEq(f, a) then true else Ty.holds(rest, a)
    case _ => Ty.holds(rest, a)

def Ty.atomEq(f: Ty.Atom, a: Ty.Atom): Bool = f match
  case Ty.Lo(x) => a match
    case Ty.Lo(y) => x == y
    case _ => false
  case Ty.Lt(x, y) => a match
    case Ty.Lt(u, v) => x == u && y == v
    case _ => false
  case Ty.Le(x, y) => a match
    case Ty.Le(u, v) => x == u && y == v
    case _ => false
  case Ty.LeSub(x, y, z) => a match
    case Ty.LeSub(u, v, w) => x == u && y == v && z == w
    case _ => false

// x is an array bound in this fn by Array.fill or Array.tabulate (its innermost binding carries a Ty.Home)
def Ty.homeOf(bs: Coll.List[Ty.Bind], x: Sym.Sym): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(b, rest) => b match
    case Ty.Home(y) => if Sym.eq(x, y) then true else Ty.homeOf(rest, x)
    case Ty.Bind(y, _) => if Sym.eq(x, y) then false else Ty.homeOf(rest, x)
    case Ty.Val(y, _, _) => if Sym.eq(x, y) then false else Ty.homeOf(rest, x)
    case _ => Ty.homeOf(rest, x)

// val x = Array.fill(...) or Array.tabulate(...): a var could be assigned another array later, so it has no home
def Ty.isNewArray(e: Ast.Expr): Bool = e match
  case Ast.Call(_, f, _, _, _) => Str.eq(Sym.str(f), "Array.fill") || Str.eq(Sym.str(f), "Array.tabulate")
  case _ => false

def Ty.inLoop(bs: Coll.List[Ty.Bind]): Bool = bs match
  case Coll.Nil => false
  case Coll.Cons(b, rest) => b match
    case Ty.Loop => true
    case _ => Ty.inLoop(rest)

// ── Ast.Ty as a term: a name bound in tv (a [] binder: a var at a call, a rigid con in a body) is its term; a value
// arg (the n of Array[A](n), A1) is the identity of the local n in tv, the last type arg ──
def Ty.term(t: Ast.Ty, tv: Coll.List[Ty.Bind]): K.Term =
  val Ast.Ty(_, n, args, _, vals) = t
  args match
    case Coll.Nil => Ty.lookupTy(tv, n) match
      case Coll.Some(x) => x
      case Coll.None => K.Con(n, Coll.Nil)
    case Coll.Cons(_, _) => vals match
      case Coll.Nil => K.Con(n, Ty.terms(args, tv, Coll.Nil))
      case Coll.Cons(v, _) =>
        K.Con(n, Coll.revOnto(Coll.rev(Ty.terms(args, tv, Coll.Nil)), Coll.Cons(Ty.lenTerm(tv, v), Coll.Nil)))

// a length: K.Int of the local's identity; anything else is a length no local names (no fact or read can reach it)
def Ty.lenTerm(tv: Coll.List[Ty.Bind], v: Ast.Expr): K.Term = v match
  case Ast.Name(_, x) => Ty.idOf(tv, x) match
    case Coll.Some(id) => K.Int(id)
    case Coll.None => Ty.con("Array.unnamed")
  case _ => Ty.con("Array.unnamed")

// a type with a value arg anywhere in it
def Ty.hasVals(t: Ast.Ty): Bool =
  val Ast.Ty(_, _, args, _, vals) = t
  Coll.length(vals) > 0 || Ty.anyVals(args)

def Ty.anyVals(ts: Coll.List[Ast.Ty]): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(t, rest) => if Ty.hasVals(t) then true else Ty.anyVals(rest)

// the identities in bs, for a type written in a body (a val annotation): its lengths name locals
// (the reachable ones: seen = the names of inner locals)
def Ty.idsOnly(bs: Coll.List[Ty.Bind], seen: Coll.List[Sym.Sym], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) => b match
    case Ty.Val(y, _, _) =>
      Ty.idsOnly(rest, Coll.Cons(y, seen), if Ty.memberSym(y, seen) then acc else Coll.Cons(b, acc))
    case Ty.Bind(y, _) => Ty.idsOnly(rest, Coll.Cons(y, seen), acc)
    case _ => Ty.idsOnly(rest, seen, acc)

def Ty.terms(ts: Coll.List[Ast.Ty], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = ts match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(t, rest) => Ty.terms(rest, tv, Coll.Cons(Ty.term(t, tv), acc))

// the [] binder names of groups
def Ty.tparams(gs: Coll.List[Ast.Group], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = gs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(g, rest) => g match
    case Ast.Types(bs) => Ty.tparams(rest, Ty.names(bs, acc))
    case Ast.Evidence(_) => Ty.tparams(rest, acc)
    case Ast.Facts(_) => Ty.tparams(rest, acc)

def Ty.names(bs: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, _) = b
    Ty.names(rest, Coll.Cons(x, acc))

// each binder name to a fresh var (a call site), in order; the vars are the instance's type args
enum Ty.Open:
  case Ty.Open(st: Ty.St, tv: Coll.List[Ty.Bind], vars: Coll.List[K.Term])

def Ty.open(st: Ty.St, xs: Coll.List[Sym.Sym], tv: Coll.List[Ty.Bind], vars: Coll.List[K.Term]): Ty.Open = xs match
  case Coll.Nil => Ty.Open(st, tv, Coll.rev(vars))
  case Coll.Cons(x, rest) =>
    val Ty.At(st1, v) = Ty.fresh(st)
    Ty.open(st1, rest, Coll.Cons(Ty.Bind(x, v), tv), Coll.Cons(v, vars))

// each binder name to a rigid con named by it (inside a generic body)
def Ty.rigid(xs: Coll.List[Sym.Sym], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => Ty.rigid(rest, Coll.Cons(Ty.Bind(x, K.Con(x, Coll.Nil)), acc))

// ── lookups ──
def Ty.fnNamed(fs: Coll.List[Ast.Fn], f: Sym.Sym): Coll.Option[Ast.Fn] = fs match
  case Coll.Nil => Coll.None
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, _, n, _, _, _, _, _) = g
    if Sym.eq(n, f) then Coll.Some(g) else Ty.fnNamed(rest, f)

// the enum a case belongs to, and the case
enum Ty.CaseOf:
  case Ty.CaseOf(e: Ast.Enum, c: Ast.Case)

// the program's defs and cases by name, built once with the Cx: the first of a name wins, as Ty.fnNamed and
// Ty.caseNamed find it in the lists
enum Ty.Idx:
  case Ty.Idx(fns: Coll.SMap[Ast.Fn], cases: Coll.SMap[Ty.CaseOf], structs: Coll.SMap[Ast.TypeDecl])

def Ty.idxOf(fns: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ts: Coll.SMap[Ast.TypeDecl]): Ty.Idx =
  Ty.Idx(Ty.idxFns(fns, Coll.sEmpty()), Ty.idxEnums(es, Coll.sEmpty()), ts)

def Ty.idxFns(fs: Coll.List[Ast.Fn], m: Coll.SMap[Ast.Fn]): Coll.SMap[Ast.Fn] = fs match
  case Coll.Nil => m
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, _, n, _, _, _, _, _) = g
    Ty.idxFns(rest, Ty.sFirst(m, n, g))

def Ty.idxEnums(es: Coll.List[Ast.Enum], m: Coll.SMap[Ty.CaseOf]): Coll.SMap[Ty.CaseOf] = es match
  case Coll.Nil => m
  case Coll.Cons(e, rest) =>
    val Ast.Enum(_, _, _, _, cases) = e
    Ty.idxEnums(rest, Ty.idxCases(cases, e, m))

def Ty.idxCases(cs: Coll.List[Ast.Case], e: Ast.Enum, m: Coll.SMap[Ty.CaseOf]): Coll.SMap[Ty.CaseOf] = cs match
  case Coll.Nil => m
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, n, _) = c
    Ty.idxCases(rest, e, Ty.sFirst(m, n, Ty.CaseOf(e, c)))

// m with s = v unless s is in m already
def Ty.sFirst [V: Type] (m: Coll.SMap[V], s: Sym.Sym, v: V): Coll.SMap[V] = Coll.sLookup(m, s) match
  case Coll.Some(_) => m
  case Coll.None => Coll.sInsert(m, s, v)

def Ty.fnOf(cx: Ty.Cx, f: Sym.Sym): Coll.Option[Ast.Fn] =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, _, idx) = cx
  val Ty.Idx(fs, _, _) = idx
  Coll.sLookup(fs, f)

def Ty.caseOf(cx: Ty.Cx, f: Sym.Sym): Coll.Option[Ty.CaseOf] =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, _, idx) = cx
  val Ty.Idx(_, cs, _) = idx
  Coll.sLookup(cs, f)

// the enum's type at fresh vars: E[v1..vn], with the binders bound for its fields
def Ty.openEnum(st: Ty.St, e: Ast.Enum): Ty.Open =
  val Ast.Enum(_, _, _, gs, _) = e
  Ty.open(st, Ty.tparams(gs, Coll.Nil), Coll.Nil, Coll.Nil)

def Ty.enumTerm(e: Ast.Enum, vars: Coll.List[K.Term]): K.Term =
  val Ast.Enum(_, _, n, _, _) = e
  K.Con(n, vars)

// ── expressions: the type and the elaborated form of e under locals bs, want = the expected type (check mode) ──
enum Ty.Ex:
  case Ty.Ex(st: Ty.St, t: K.Term, e: El.Expr)

enum Ty.Es:
  case Ty.Es(st: Ty.St, es: Coll.List[El.Expr])

def Ty.expr(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], e: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex = e match
  case Ast.Int(line, v) => Ty.int(st, line, v, want)
  case Ast.Bool(line, v) => Ty.lit(st, line, Ty.con("Bool"), want, El.Bool(line, v))
  case Ast.Str(line, s) => Ty.lit(st, line, Ty.con("Str"), want, El.Str(line, s))
  case Ast.Unit(line) => Ty.lit(st, line, Ty.con("Unit"), want, El.Unit(line))
  case Ast.Name(line, x) => Ty.lookup(bs, x) match
    case Coll.Some(t) => Ty.lit(Ty.nameUse(cx, st, line, x, t), line, t, want, El.Local(line, x))
    case Coll.None => Ty.call(cx, st, bs, line, x, Coll.Nil, Coll.Nil, Coll.Nil, want)
  case Ast.Call(line, f, targs, chosen, xs) => Ty.call(cx, st, bs, line, f, targs, chosen, xs, want)
  case Ast.Method(line, recv, op, xs) => Ty.method(cx, st, bs, line, recv, op, xs, want)
  case Ast.Resume(line, k, x) => Ty.resume(cx, st, bs, line, k, x, want)
  case Ast.Bin(line, op, l, rhs) => Ty.bin(cx, st, bs, line, op, l, rhs, want)
  case Ast.Un(line, op, x) => op match
    case Ast.BitNot => Ty.ints1(cx, st, bs, line, x, want)
    case _ =>
      val t = Ty.con(Ty.unTy(op))
      val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.Some(t))
      Ty.lit(st1, line, t, want, El.Un(line, op, ex))
  // the then-arm knows the facts of the condition (A1)
  case Ast.If(_, line, c, t, x) =>
    val Ty.Ex(st1, _, ec) = Ty.expr(cx, st, bs, c, Coll.Some(Ty.con("Bool")))
    val Ty.Ex(st2, tt, et) = Ty.expr(cx, st1, Ty.thenBs(cx, bs, c), t, want)
    val Ty.Ex(st3, _, ex) = Ty.expr(cx, st2, bs, x, Coll.Some(tt))
    Ty.Ex(st3, tt, El.If(line, ec, et, ex))
  case Ast.Match(_, line, s, arms) =>
    val Ty.Ex(st1, ts, es) = Ty.expr(cx, st, bs, s, Coll.None)
    Ty.arms(cx, st1, bs, line, ts, es, arms, want)
  case Ast.Block(_, line, ss, last) => Ty.block(cx, st, bs, line, ss, last, want, Coll.Nil)
  case Ast.While(line, c, b) =>
    val bl = Ty.loopBs(cx, bs)
    val Ty.Ex(st1, _, ec) = Ty.expr(cx, st, bl, c, Coll.Some(Ty.con("Bool")))
    val Ty.Ex(st2, _, eb) = Ty.expr(cx, st1, bl, b, Coll.None)
    Ty.lit(st2, line, Ty.con("Unit"), want, El.While(line, ec, eb))
  case Ast.Assign(line, x, v) => Ty.lookup(bs, x) match
    case Coll.None => Ty.Ex(Ty.clash(st, Ty.Unknown(line, x)), Ty.con("Unit"), El.Bad(line))
    case Coll.Some(tx) =>
      // a local with an identity (A1) is immutable: a length or a fact names its one value
      val st0: Ty.St = Ty.idOf(bs, x) match
        case Coll.Some(_) => Ty.clash(st, Ty.AssignVal(line, x))
        case Coll.None => st
      val Ty.Ex(st1, _, ev) = Ty.expr(cx, st0, bs, v, Coll.Some(tx))
      Ty.lit(st1, line, Ty.con("Unit"), want, El.Assign(line, x, ev))
  // a quantifier is a contract: checked, erased (no C)
  case Ast.Quant(line, _, x, t, b) =>
    val Ty.Ex(st1, _, _) =
      Ty.expr(cx, st, Coll.Cons(Ty.Bind(x, Ty.term(t, Coll.Nil)), bs), b, Coll.Some(Ty.con("Bool")))
    Ty.lit(st1, line, Ty.con("Bool"), want, El.Bool(line, true))

// ── A1 facts (vic/c/array-design.md): the conjuncts of an if condition that compare immutable I64 locals (Ty.Val) hold in
// the then-arm. each is an atom on identities, so it stays true however the arm shadows names; only && is split (an ||
// or a ! gives nothing); a compare of a mutable local, or of any other expression, gives nothing ──
def Ty.thenBs(cx: Ty.Cx, bs: Coll.List[Ty.Bind], c: Ast.Expr): Coll.List[Ty.Bind] =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, arr, idx) = cx
  arr match
    case Names.NoArrays => bs
    case Names.UsesArrays => Ty.facts(bs, c, bs)

def Ty.loopBs(cx: Ty.Cx, bs: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, arr, idx) = cx
  arr match
    case Names.NoArrays => bs
    case Names.UsesArrays => Coll.Cons(Ty.Loop, bs)

def Ty.facts(bs: Coll.List[Ty.Bind], c: Ast.Expr, acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = c match
  case Ast.Bin(_, op, l, r) => op match
    case Ast.And => Ty.facts(bs, r, Ty.facts(bs, l, acc))
    case Ast.Le => Ty.factLe(bs, l, r, acc)
    case Ast.Ge => Ty.factLe(bs, r, l, acc)
    case Ast.Lt => Ty.fact2(Ty.idE(bs, l), Ty.idE(bs, r), acc)
    case Ast.Gt => Ty.fact2(Ty.idE(bs, r), Ty.idE(bs, l), acc)
    case _ => acc
  case _ => acc

// a < b
def Ty.fact2(a: Coll.Option[I64], b: Coll.Option[I64], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = a match
  case Coll.Some(x) => b match
    case Coll.Some(y) => Coll.Cons(Ty.Fact(Ty.Lt(x, y)), acc)
    case Coll.None => acc
  case Coll.None => acc

// l <= r: 0 <= a, a <= b, a <= b - c
def Ty.factLe(bs: Coll.List[Ty.Bind], l: Ast.Expr, r: Ast.Expr, acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = Ty.idE(bs, l) match
  case Coll.None => l match
    case Ast.Int(_, v) => if v == 0 then Ty.factLo(Ty.idE(bs, r), acc) else acc
    case _ => acc
  case Coll.Some(a) => r match
    case Ast.Bin(_, op, b, c) => op match
      case Ast.Sub => Ty.factSub(a, Ty.idE(bs, b), Ty.idE(bs, c), acc)
      case _ => acc
    case _ => Ty.idE(bs, r) match
      case Coll.Some(b) => Coll.Cons(Ty.Fact(Ty.Le(a, b)), acc)
      case Coll.None => acc

def Ty.factLo(a: Coll.Option[I64], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = a match
  case Coll.Some(x) => Coll.Cons(Ty.Fact(Ty.Lo(x)), acc)
  case Coll.None => acc

def Ty.factSub(a: I64, b: Coll.Option[I64], c: Coll.Option[I64], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = b match
  case Coll.Some(y) => c match
    case Coll.Some(z) => Coll.Cons(Ty.Fact(Ty.LeSub(a, y, z)), acc)
    case Coll.None => acc
  case Coll.None => acc

// the identity of a name expression
def Ty.idE(bs: Coll.List[Ty.Bind], e: Ast.Expr): Coll.Option[I64] = e match
  case Ast.Name(_, x) => Ty.idOf(bs, x)
  case _ => Coll.None

// i in [0, n): xs(i) needs no check
def Ty.inBounds(bs: Coll.List[Ty.Bind], i: I64, n: I64): Bool = Ty.holds(bs, Ty.Lo(i)) && Ty.holds(bs, Ty.Lt(i, n))

// [off, off + m) in [0, n), written without an add that could wrap: 0 <= off, 0 <= m, m <= n, off <= n - m (n - m
// cannot wrap when 0 <= m <= n)
def Ty.sliceIn(bs: Coll.List[Ty.Bind], off: I64, m: I64, n: I64): Bool =
  Ty.holds(bs, Ty.Lo(off)) && Ty.holds(bs, Ty.Lo(m)) && Ty.holds(bs, Ty.Le(m, n)) && Ty.holds(bs, Ty.LeSub(off, n, m))

// a type that is known: checked against want
def Ty.lit(st: Ty.St, line: I64, t: K.Term, want: Coll.Option[K.Term], e: El.Expr): Ty.Ex =
  Ty.Ex(Ty.expectOpt(st, line, t, want), t, e)

// an expression that did not type: a fresh type, El.Bad
def Ty.bad(st: Ty.St, line: I64): Ty.Ex =
  val Ty.At(st1, v) = Ty.fresh(st)
  Ty.Ex(st1, v, El.Bad(line))

// ── calls: a def or a constructor (a name with no args is a nullary case) ──
def Ty.call(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Cx(fns, es, ps, _, _, _, _, _, _, _, idx) = cx
  Ty.fnOf(cx, f) match
    case Coll.Some(g) =>
      Ty.callFn(cx, Ty.valCall(cx, Ty.rtCall(cx, Ty.pureCall(cx, st, line, f), line, g), line, f), bs, line, g, targs, chosen, xs, want)
    case Coll.None => Ty.caseOf(cx, f) match
      case Coll.Some(co) => Ty.callCase(cx, st, bs, line, co, xs, want)
      case Coll.None => Eff.reqOf(ps, f) match
        case Coll.Some(q) => Ty.request(cx, st, bs, line, q, xs, want)
        case Coll.None => Ty.arrayCall(cx, st, bs, line, f, targs, xs, want)

// ── A1 arrays (vic/c/array-design.md): Array[A](n) is K.Con(Array, [A, K.Int(id of n)]), one pointer to n elements ──
enum Ty.ArrT:
  case Ty.ArrT(elem: K.Term, len: K.Term)

def Ty.arrayOf(s: Coll.IMap[K.Term], t: K.Term): Coll.Option[Ty.ArrT] = K.walk(s, t) match
  case K.Con(n, args) => if Str.eq(Sym.str(n), "Array") then Ty.arrParts(args) else Coll.None
  case _ => Coll.None

def Ty.arrParts(args: Coll.List[K.Term]): Coll.Option[Ty.ArrT] = args match
  case Coll.Cons(a, rest) => rest match
    case Coll.Cons(n, _) => Coll.Some(Ty.ArrT(a, n))
    case Coll.Nil => Coll.None
  case Coll.Nil => Coll.None

// the length's identity (none: a length no local names)
def Ty.lenId(t: K.Term): Coll.Option[I64] = t match
  case K.Int(id) => Coll.Some(id)
  case _ => Coll.None

// a call that is no def, case or request: xs(i) on a local array, or an Array builtin; else an unknown name
def Ty.arrayCall(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = Ty.lookup(bs, f) match
  case Coll.Some(t) => Ty.arrayOf(Ty.subst(st), t) match
    case Coll.Some(at) => xs match
      case Coll.Cons(ix, more) => more match
        case Coll.Nil => Ty.index(cx, st, bs, line, f, at, ix, want)
        case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
      case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, f)), bs, xs), line)
  case Coll.None =>
    val fs = Sym.str(f)
    if Str.eq(fs, "Array.slice") then Ty.slice(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "Array.fill") then Ty.fill(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "Array.tabulate") then Ty.tabulate(cx, st, bs, line, f, targs, xs, want)
    else if Str.eq(fs, "Cell.new") then Ty.cellNew(cx, st, bs, line, f, xs, want)
    else if Ty.isCNew(cx, f) then Ty.cstructNew(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "ACell.new") then Ty.atomNew(cx, st, bs, line, f, xs, want)
    else if Eff.isAtomOp(f) then Ty.atomCall(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "Cell.get") then Ty.cellGet(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "Cell.put") then Ty.cellPut(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "Array.put") then Ty.arrPut(cx, st, bs, line, f, xs, want)
    else if Str.eq(fs, "Array.blit") then Ty.blit(cx, st, bs, line, f, xs, want)
    else Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, f)), bs, xs), line)

// ── A1 Cell[A]: one word in the innermost Region, Cell.get(c) reads it, Cell.put(c, v) writes it, a request on Mut (a
// write is an effect in the row). shortcut: A is a scalar (I64, Bool, U32, U64, U8): a cell (or an Array.put slot) of
// region data needs a flow rule that v outlives the cell; upgrade with that rule ──
def Ty.isScalar(s: Coll.IMap[K.Term], t: K.Term): Bool = K.walk(s, t) match
  case K.Con(n, args) =>
    val x = Sym.str(n)
    Coll.length(args) == 0 && (Str.eq(x, "I64") || Str.eq(x, "Bool") || Str.eq(x, "U32") || Str.eq(x, "U64") || Str.eq(x, "U8") || Str.eq(x, "F64"))
  case _ => false

// extern "libc" struct Libc.name: `Libc.name.new()` allocates sizeof(struct name) bytes in the innermost Region (as Cell.new); a field is
// read by `s.field()` (Ty.method). Ty.Idx.structs holds the declared structs
def Ty.cstructOfNew(cx: Ty.Cx, f: Sym.Sym): Coll.Option[Sym.Sym] =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, _, idx) = cx
  val Ty.Idx(_, _, ss) = idx
  val s = Sym.str(f)
  val n = Str.len(s)
  if n > 4 && Str.eq(Str.slice(s, n - 4, n), ".new") then
    val tn = Sym.of(Str.slice(s, 0, n - 4))
    Coll.sLookup(ss, tn) match
      case Coll.Some(_) => Coll.Some(tn)
      case Coll.None => Coll.None
  else Coll.None

def Ty.isCNew(cx: Ty.Cx, f: Sym.Sym): Bool = Ty.cstructOfNew(cx, f) match
  case Coll.Some(_) => true
  case Coll.None => false

def Ty.cstructNew(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Nil => Ty.cstructOfNew(cx, f) match
    case Coll.Some(tn) =>
      val Ty.RegAt(st1, reg) = Ty.regionAt(cx, st, bs, line)
      Ty.lit(st1, line, K.Con(tn, Coll.Nil), want, El.CNew(line, reg, tn))
    case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, f)), bs, xs), line)
  case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// s.field(): a field of the libc struct type of the local s
def Ty.cfield(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, recv: Sym.Sym, tn: Sym.Sym, op: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Coll.Option[Ty.Ex] =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, _, idx) = cx
  val Ty.Idx(_, _, ss) = idx
  Coll.sLookup(ss, tn) match
    case Coll.None => Coll.None
    case Coll.Some(td) =>
      val Ast.TypeDecl(_, _, _, _, _, body) = td
      body match
        case Ast.CStruct(fs) => Ty.cfieldIn(cx, st, bs, line, recv, tn, op, xs, want, fs)
        case _ => Coll.None

def Ty.cfieldIn(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, recv: Sym.Sym, tn: Sym.Sym, op: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term], fs: Coll.List[Ast.CField]): Coll.Option[Ty.Ex] = fs match
  case Coll.Nil => Coll.None
  case Coll.Cons(f, rest) =>
    val Ast.CField(_, fname, fty) = f
    if Sym.eq(fname, op) then
      val ft = Ty.term(fty, bs)
      val st1 = xs match
        case Coll.Nil => st
        case Coll.Cons(_, _) => Ty.clash(st, Ty.Arity(line, op))
      Coll.Some(Ty.lit(st1, line, ft, want, El.CField(line, El.Local(line, recv), tn, fname, ft)))
    else Ty.cfieldIn(cx, st, bs, line, recv, tn, op, xs, want, rest)

def Ty.cellNew(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ev, r1) => r1 match
    case Coll.Nil =>
      val wa: Coll.Option[K.Term] = want match
        case Coll.Some(w) => K.walk(Ty.subst(st), w) match
          case K.Con(wn, wargs) => if Str.eq(Sym.str(wn), "Cell") then Coll.headOpt(wargs) else Coll.None
          case _ => Coll.None
        case Coll.None => Coll.None
      val Ty.Ex(st1, ta, eV) = Ty.expr(cx, st, bs, ev, wa)
      // any A: the cell is made in the innermost Region, which every value in scope outlives (Cseal checks the puts)
      val st2 = st1
      val Ty.RegAt(st3, reg) = Ty.regionAt(cx, st2, bs, line)
      Ty.lit(st3, line, K.Con(Sym.of("Cell"), Coll.Cons(ta, Coll.Nil)), want, El.CellNew(line, reg, eV, ta))
    case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// the cell arg c: Cell[a] at a fresh a
def Ty.cellArg(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], ec: Ast.Expr): Ty.Ex =
  val Ty.At(st0, a) = Ty.fresh(st)
  val Ty.Ex(st1, _, eC) = Ty.expr(cx, st0, bs, ec, Coll.Some(K.Con(Sym.of("Cell"), Coll.Cons(a, Coll.Nil))))
  Ty.Ex(st1, a, eC)

// Cell.get(c): the word
def Ty.cellGet(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ec, r1) => r1 match
    case Coll.Nil =>
      val Ty.Ex(st1, a, eC) = Ty.cellArg(cx, st, bs, ec)
      Ty.lit(st1, line, a, want, El.CellGet(line, eC))
    case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// a write is a request on Mut: its handler in scope, else unhandled-effect
def Ty.needMut(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64): Ty.St =
  Ty.needEff(cx, st, bs, line, Sym.of("Mut"))

// a request on capability mut: its handler in scope, else unhandled-effect
def Ty.needEff(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, mut: Sym.Sym): Ty.St = Ty.innermost(Ty.subst(st), bs, mut) match
  case Coll.Some(_) => st
  case Coll.None => Ty.clash(st, Ty.unhandled(cx, line, mut))

// Cell.put(c, v): a write, a request on Mut
def Ty.cellPut(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ec, r1) => r1 match
    case Coll.Cons(ev, r2) => r2 match
      case Coll.Nil =>
        val Ty.Ex(st1, a, eC) = Ty.cellArg(cx, st, bs, ec)
        val Ty.Ex(st2, _, eV) = Ty.expr(cx, st1, bs, ev, Coll.Some(a))
        Ty.lit(Ty.needMut(cx, st2, bs, line), line, Ty.con("Unit"), want, El.CellPut(line, eC, eV, !Ty.isScalar(Ty.subst(st2), a)))
      case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// ── ACell[A]: one atomic word in the innermost Region (a Cell that only atomic ops touch). A is a word type (I64, U64, Ptr),
// fetchAdd only an integer; load, store, cas and fetchAdd are requests on Atomic, so plain code cannot touch the word ──
def Ty.isWord(s: Coll.IMap[K.Term], t: K.Term): Bool = K.walk(s, t) match
  case K.Con(n, args) => Coll.length(args) == 0 && (Str.eq(Sym.str(n), "Ptr") || Ty.isInt64(s, t))
  case _ => false

def Ty.isInt64(s: Coll.IMap[K.Term], t: K.Term): Bool = K.walk(s, t) match
  case K.Con(n, args) => Coll.length(args) == 0 && (Str.eq(Sym.str(n), "I64") || Str.eq(Sym.str(n), "U64"))
  case _ => false

def Ty.acellTy(a: K.Term): K.Term = K.Con(Sym.of("ACell"), Coll.Cons(a, Coll.Nil))

def Ty.atomNew(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ev, r1) => r1 match
    case Coll.Nil =>
      val wa: Coll.Option[K.Term] = want match
        case Coll.Some(w) => K.walk(Ty.subst(st), w) match
          case K.Con(wn, wargs) => if Str.eq(Sym.str(wn), "ACell") then Coll.headOpt(wargs) else Coll.None
          case _ => Coll.None
        case Coll.None => Coll.None
      val Ty.Ex(st1, ta, eV) = Ty.expr(cx, st, bs, ev, wa)
      val st2 = if Ty.isWord(Ty.subst(st1), ta) then st1 else Ty.clash(st1, Ty.Mismatch(line, ta, Ty.con("I64")))
      val Ty.RegAt(st3, reg) = Ty.regionAt(cx, st2, bs, line)
      Ty.lit(st3, line, Ty.acellTy(ta), want, El.CellNew(line, reg, eV, ta))
    case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// the cell arg c: ACell[a] at a fresh a, a word type
def Ty.atomArg(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ec: Ast.Expr): Ty.Ex =
  val Ty.At(st0, a) = Ty.fresh(st)
  val Ty.Ex(st1, _, eC) = Ty.expr(cx, st0, bs, ec, Coll.Some(Ty.acellTy(a)))
  val st2 = if Ty.isWord(Ty.subst(st1), a) then st1 else Ty.clash(st1, Ty.Mismatch(line, a, Ty.con("I64")))
  Ty.Ex(Ty.needEff(cx, st2, bs, line, Sym.of("Atomic")), a, eC)

// ACell.load(c), ACell.store(c, v), ACell.cas(c, want, v): Bool, ACell.fetchAdd(c, d): the word before the add
def Ty.atomCall(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ec, r1) =>
    val Ty.Ex(st1, a, eC) = Ty.atomArg(cx, st, bs, line, ec)
    val fs = Sym.str(f)
    r1 match
      case Coll.Nil =>
        if Str.eq(fs, "ACell.load") then Ty.lit(st1, line, a, want, El.AtomLoad(line, eC))
        else Ty.bad(Ty.args(cx, Ty.clash(st1, Ty.Arity(line, f)), bs, xs), line)
      case Coll.Cons(e2, r2) => r2 match
        case Coll.Nil =>
          val Ty.Ex(st2, _, eV) = Ty.expr(cx, st1, bs, e2, Coll.Some(a))
          if Str.eq(fs, "ACell.store") then Ty.lit(st2, line, Ty.con("Unit"), want, El.AtomStore(line, eC, eV))
          else if Str.eq(fs, "ACell.fetchAdd") then
            val st3 = if Ty.isInt64(Ty.subst(st2), a) then st2 else Ty.clash(st2, Ty.Mismatch(line, a, Ty.con("I64")))
            Ty.lit(st3, line, a, want, El.AtomAdd(line, eC, eV))
          else Ty.bad(Ty.args(cx, Ty.clash(st2, Ty.Arity(line, f)), bs, xs), line)
        case Coll.Cons(e3, r3) => r3 match
          case Coll.Nil =>
            val Ty.Ex(st2, _, eW) = Ty.expr(cx, st1, bs, e2, Coll.Some(a))
            val Ty.Ex(st3, _, eV) = Ty.expr(cx, st2, bs, e3, Coll.Some(a))
            if Str.eq(fs, "ACell.cas") then Ty.lit(st3, line, Ty.con("Bool"), want, El.AtomCas(line, eC, eW, eV))
            else Ty.bad(Ty.args(cx, Ty.clash(st3, Ty.Arity(line, f)), bs, xs), line)
          case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st1, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// the innermost Region in scope, where a new array lives (a constructor's rule, Ty.callCase); none at compile time
enum Ty.RegAt:
  case Ty.RegAt(st: Ty.St, reg: Sym.Sym)

def Ty.regionAt(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64): Ty.RegAt =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, idx) = cx
  val region = Sym.of("Region")
  mode match
    case Ty.Comptime => Ty.RegAt(Ty.clash(st, Ty.Impure(line, region)), region)
    case Ty.Run(_) => Ty.innermost(Ty.subst(st), bs, region) match
      case Coll.Some(reg) => Ty.RegAt(st, reg)
      case Coll.None => Ty.RegAt(Ty.clash(st, Ty.unhandled(cx, line, region)), region)

// the length of a new array: the identity of the local n (a length no local names could never be read)
def Ty.newLen(st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, en: Ast.Expr): Ty.At = Ty.idE(bs, en) match
  case Coll.Some(id) => Ty.At(st, K.Int(id))
  case Coll.None => Ty.At(Ty.clash(st, Ty.LenUnnamed(line, f)), Ty.con("Array.unnamed"))

// Array.fill(n, x): n elements, each x; created initialised (A1: no uninitialised element)
def Ty.fill(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(en, r1) => r1 match
    case Coll.Cons(ex, r2) => r2 match
      case Coll.Nil =>
        val wa: Coll.Option[K.Term] = want match
          case Coll.Some(w) => Ty.arrayOf(Ty.subst(st), w) match
            case Coll.Some(at) =>
              val Ty.ArrT(a, _) = at
              Coll.Some(a)
            case Coll.None => Coll.None
          case Coll.None => Coll.None
        val Ty.Ex(st1, _, eN) = Ty.expr(cx, st, bs, en, Coll.Some(Ty.con("I64")))
        val Ty.Ex(st2, ta, eX) = Ty.expr(cx, st1, bs, ex, wa)
        val Ty.At(st3, len) = Ty.newLen(st2, bs, line, f, en)
        val Ty.RegAt(st4, reg) = Ty.regionAt(cx, st3, bs, line)
        Ty.lit(st4, line, K.Con(Sym.of("Array"), Coll.Cons(ta, Coll.Cons(len, Coll.Nil))), want, El.Fill(line, reg, eN, eX, ta))
      case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// Array.tabulate[F](n): element i is the given Array.Gen[F, A]'s at(i), for i from 0 (a function is a given: no closures)
def Ty.tabulate(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, targs: Coll.List[Ast.Ty], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = targs match
  case Coll.Cons(tf, tr) => tr match
    case Coll.Nil => xs match
      case Coll.Cons(en, r1) => r1 match
        case Coll.Nil =>
          val Ty.At(st0, a) = Ty.fresh(st)
          val Ty.Ex(st1, _, eN) = Ty.expr(cx, st0, bs, en, Coll.Some(Ty.con("I64")))
          val Ty.At(st2, len) = Ty.newLen(st1, bs, line, f, en)
          val Ty.RegAt(st3, reg) = Ty.regionAt(cx, st2, bs, line)
          val goal = K.Con(Sym.of("Array.Gen"), Coll.Cons(Ty.term(tf, Coll.Nil), Coll.Cons(a, Coll.Nil)))
          val st4 = Ty.addGoal(st3, Ty.Goal(line, goal, bs, Coll.None))
          val i = Sym.of("tab.i")
          Ty.lit(st4, line, K.Con(Sym.of("Array"), Coll.Cons(a, Coll.Cons(len, Coll.Nil))), want, El.Tab(line, reg, eN, a, i, El.TCall(line, goal, Sym.of("at"), Coll.Nil, Coll.Cons(El.Local(line, i), Coll.Nil))))
        case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
      case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// xs.at(j): Array.Ok(xs(j)) when 0 <= j < n, else Array.Out(j), never a crash. checked by the same fact rule as any
// xs(i): j is bound once to a local with an identity (the compare and the read see one value), n is the local that
// holds the length (none in scope: LenUnnamed)
def Ty.atCall(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, recv: Sym.Sym, at: Ty.ArrT, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.ArrT(_, n) = at
  xs match
    case Coll.Cons(ej, r1) => r1 match
      case Coll.Nil =>
        val nn: Coll.Option[Sym.Sym] = Ty.lenId(K.walk(Ty.subst(st), n)) match
          case Coll.Some(nid) => Ty.nameOfId(bs, nid, Coll.Nil)
          case Coll.None => Coll.None
        nn match
          case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.LenUnnamed(line, recv)), bs, xs), line)
          case Coll.Some(nx) =>
            val Ty.Ex(st1, _, eJ) = Ty.expr(cx, st, bs, ej, Coll.Some(Ty.con("I64")))
            val j = Sym.of("at.j")
            val jn = Ast.Name(line, j)
            val c =
              Ast.Bin(line, Ast.And, Ast.Bin(line, Ast.Le, Ast.Int(line, 0), jn), Ast.Bin(line, Ast.Lt, jn, Ast.Name(line, nx)))
            val ok =
              Ast.Call(line, Sym.of("Array.Ok"), Coll.Nil, Coll.Nil, Coll.Cons(Ast.Call(line, recv, Coll.Nil, Coll.Nil, Coll.Cons(jn, Coll.Nil)), Coll.Nil))
            val out = Ast.Call(line, Sym.of("Array.Out"), Coll.Nil, Coll.Nil, Coll.Cons(jn, Coll.Nil))
            // at.j lives only in this expression and no value carries its identity out: a fresh one is sound in a loop too
            val bj = Coll.Cons(Ty.Val(j, Ty.con("I64"), Ty.nextId(st1)), bs)
            val Ty.Ex(st2, t, eI) = Ty.expr(cx, Ty.stamped(st1), bj, Ast.If(Ast.NoDoc, line, c, ok, out), want)
            Ty.Ex(st2, t, El.Block(line, Coll.Cons(El.Val(line, j, Ty.con("I64"), false, eJ), Coll.Nil), eI))
      case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, recv)), bs, xs), line)
    case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, recv)), bs, xs), line)

// xs(i): i a local proved in [0, n) by the facts in scope: p[i], no check (else IndexUnproved: use xs.at(i))
def Ty.index(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, x: Sym.Sym, at: Ty.ArrT, ix: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.ArrT(a, n) = at
  val Ty.Ex(st1, _, ei) = Ty.expr(cx, st, bs, ix, Coll.Some(Ty.con("I64")))
  Ty.lit(Ty.proved(st1, bs, line, x, n, ix), line, a, want, El.Index(line, x, ei))

// the index ix of xs: Array[A](n) is a local proved in [0, n) by the facts in scope, else IndexUnproved
def Ty.proved(st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, x: Sym.Sym, n: K.Term, ix: Ast.Expr): Ty.St =
  val ok: Bool = Ty.idE(bs, ix) match
    case Coll.Some(i) => Ty.lenId(K.walk(Ty.subst(st), n)) match
      case Coll.Some(nid) => Ty.inBounds(bs, i, nid)
      case Coll.None => false
    case Coll.None => false
  if ok then st else Ty.clash(st, Ty.IndexUnproved(line, x))

// Array.put(xs, i, v): xs a local array, i proved like xs(i), v a scalar A, a write (a request on Mut); C xs[i] = v.
// shortcut: A is a scalar (Ty.isScalar): region data in a slot needs a flow rule, later (PutData)
def Ty.arrPut(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ex, r1) => r1 match
    case Coll.Cons(ix, r2) => r2 match
      case Coll.Cons(ev, r3) => r3 match
        case Coll.Nil => ex match
          case Ast.Name(_, x) => Ty.lookup(bs, x) match
            case Coll.Some(t) => Ty.arrayOf(Ty.subst(st), t) match
              case Coll.Some(at) =>
                val Ty.ArrT(a, n) = at
                val Ty.Ex(st1, _, eI) = Ty.expr(cx, st, bs, ix, Coll.Some(Ty.con("I64")))
                val Ty.Ex(st2, ta, eV) = Ty.expr(cx, st1, bs, ev, Coll.Some(a))
                val st3 =
                  if Ty.isScalar(Ty.subst(st2), ta) || Ty.homeOf(bs, x) then st2 else Ty.clash(st2, Ty.PutData(line, x))
                Ty.lit(Ty.needMut(cx, Ty.proved(st3, bs, line, x, n, ix), bs, line), line, Ty.con("Unit"), want, El.ArrPut(line, x, eI, eV))
              case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Mismatch(line, t, Ty.con("Array"))), bs, xs), line)
            case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, x)), bs, xs), line)
          case _ => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, f)), bs, xs), line)
        case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
      case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// Array.blit(xs, at, s, m): copies the first min(m, Str.len(s)) bytes of s into the local Array[U8](n) xs from slot at; at and m
// locals proved like Array.slice (0 <= at, 0 <= m, m <= n, at <= n - m), so the copy is in range for every s: a write
// (a request on Mut); C memcpy. A copy: s may die before xs does
def Ty.blit(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ex, r1) => r1 match
    case Coll.Cons(eo, r2) => r2 match
      case Coll.Cons(es, r3) => r3 match
        case Coll.Cons(em, r4) => r4 match
          case Coll.Nil => ex match
            case Ast.Name(_, x) => Ty.lookup(bs, x) match
              case Coll.Some(t) => Ty.arrayOf(Ty.subst(st), t) match
                case Coll.Some(at) =>
                  val Ty.ArrT(a, n) = at
                  val st0 = Ty.expectOpt(st, line, Ty.con("U8"), Coll.Some(a))
                  val Ty.Ex(st1, _, eO) = Ty.expr(cx, st0, bs, eo, Coll.Some(Ty.con("I64")))
                  val Ty.Ex(st2, _, eS) = Ty.expr(cx, st1, bs, es, Coll.Some(Ty.con("Str")))
                  val Ty.Ex(st3, _, eM) = Ty.expr(cx, st2, bs, em, Coll.Some(Ty.con("I64")))
                  val ok: Bool = Ty.sliceOk(bs, Ty.idE(bs, eo), Ty.idE(bs, em), Ty.lenId(K.walk(Ty.subst(st3), n)))
                  Ty.lit(Ty.needMut(cx, if ok then st3 else Ty.clash(st3, Ty.IndexUnproved(line, x)), bs, line), line, Ty.con("Unit"), want, El.Blit(line, x, eO, eS, eM))
                case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Mismatch(line, t, Ty.con("Array"))), bs, xs), line)
              case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, x)), bs, xs), line)
            case _ => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, f)), bs, xs), line)
          case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
        case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
      case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

// Array.slice(xs, off, m): a view of m elements from off, of type Array[A](m); off and m locals proved in range
def Ty.slice(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, f: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex = xs match
  case Coll.Cons(ea, r1) => r1 match
    case Coll.Cons(eo, r2) => r2 match
      case Coll.Cons(em, r3) => r3 match
        case Coll.Nil =>
          val Ty.Ex(st1, ta, exa) = Ty.expr(cx, st, bs, ea, Coll.None)
          val Ty.Ex(st2, _, exo) = Ty.expr(cx, st1, bs, eo, Coll.Some(Ty.con("I64")))
          val Ty.Ex(st3, _, _) = Ty.expr(cx, st2, bs, em, Coll.Some(Ty.con("I64")))
          Ty.arrayOf(Ty.subst(st3), ta) match
            case Coll.Some(at) =>
              val Ty.ArrT(a, n) = at
              val ok: Bool = Ty.sliceOk(bs, Ty.idE(bs, eo), Ty.idE(bs, em), Ty.lenId(K.walk(Ty.subst(st3), n)))
              val tm: K.Term = Ty.idE(bs, em) match
                case Coll.Some(m) => K.Int(m)
                case Coll.None => Ty.con("Array.unnamed")
              Ty.lit(if ok then st3 else Ty.clash(st3, Ty.SliceUnproved(line, f)), line, K.Con(Sym.of("Array"), Coll.Cons(a, Coll.Cons(tm, Coll.Nil))), want, El.Slice(line, exa, exo))
            case Coll.None => Ty.bad(Ty.clash(st3, Ty.Mismatch(line, ta, K.Con(Sym.of("Array"), Coll.Nil))), line)
        case Coll.Cons(_, _) => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
      case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
    case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)
  case Coll.Nil => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Arity(line, f)), bs, xs), line)

def Ty.sliceOk(bs: Coll.List[Ty.Bind], off: Coll.Option[I64], m: Coll.Option[I64], n: Coll.Option[I64]): Bool = off match
  case Coll.Some(o) => m match
    case Coll.Some(mm) => n match
      case Coll.Some(nn) => Ty.sliceIn(bs, o, mm, nn)
      case Coll.None => false
    case Coll.None => false
  case Coll.None => false

// P.op(args): the op on the innermost capability of P in scope (vic 2026-11-09: the innermost handler answers)
def Ty.request(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, q: Eff.Req, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Eff.Req(p, op) = q
  Ty.innermost(Ty.subst(st), bs, p) match
    case Coll.Some(x) => Ty.method(cx, st, bs, line, x, op, xs, want)
    case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.unhandled(cx, line, p)), bs, xs), line)

// no capability of p in scope: in a given's fn, its trait method does not declare p; elsewhere nothing handles p
def Ty.unhandled(cx: Ty.Cx, line: I64, p: Sym.Sym): Ty.Clash =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, idx) = cx
  mode match
    case Ty.Run(by) => by match
      case Ty.Given => Ty.GivenRow(line, p)
      case _ => Ty.UnhandledEffect(line, p)
    case Ty.Comptime => Ty.UnhandledEffect(line, p)

// the innermost local of protocol type p
def Ty.innermost(s: K.Subst, bs: Coll.List[Ty.Bind], p: Sym.Sym): Coll.Option[Sym.Sym] =
  Ty.innermostFrom(s, bs, p, Coll.Nil)

// seen: the names of the inner locals; a capability whose name an inner local shadows is out of reach by its name
def Ty.innermostFrom(s: K.Subst, bs: Coll.List[Ty.Bind], p: Sym.Sym, seen: Coll.List[Sym.Sym]): Coll.Option[Sym.Sym] = bs match
  case Coll.Nil => Coll.None
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(x, t) =>
      val isP: Bool = K.walk(s, t) match
        case K.Con(n, args) => Sym.eq(n, p) && Coll.length(args) == 0
        case _ => false
      if isP && !Ty.memberSym(x, seen) then Coll.Some(x) else Ty.innermostFrom(s, rest, p, Coll.Cons(x, seen))
    // an I64 local is never a capability, but it shadows one of its name
    case Ty.Val(x, _, _) => Ty.innermostFrom(s, rest, p, Coll.Cons(x, seen))
    case _ => Ty.innermostFrom(s, rest, p, seen)

// the callee's row: for each implicit capability, the caller's innermost of its protocol
def Ty.rowCaps(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, cs: Coll.List[Eff.Cap], acc: Coll.List[Sym.Sym]): Ty.Caps = cs match
  case Coll.Nil => Ty.Caps(st, Coll.rev(acc))
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, _) = c
    Ty.innermost(Ty.subst(st), bs, p) match
      case Coll.Some(x) => Ty.rowCaps(cx, st, bs, line, rest, Coll.Cons(x, acc))
      case Coll.None => Ty.rowCaps(cx, Ty.clash(st, Ty.unhandled(cx, line, p)), bs, line, rest, acc)

// the args alone (an unknown callee: still checked)
def Ty.args(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr]): Ty.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) =>
    val Ty.Ex(st1, _, _) = Ty.expr(cx, st, bs, x, Coll.None)
    Ty.args(cx, st1, bs, rest)

// f[T]{caps}(args): open the binders, explicit type args, check mode (want binds the result first), args left to right;
// each protocol {} binder takes a caller capability (the chosen name, else the one of its protocol in scope)
def Ty.callFn(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, g: Ast.Fn, targs: Coll.List[Ast.Ty], chosen: Coll.List[Sym.Sym], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ast.Fn(_, _, name, gs, ps, ret, _, body) = g
  val variadic: Bool = body match
    case Ast.Def(_, _) => false
    case Ast.Extern(abi) => Ty.isVariadic(abi)
  val tps = Ty.tparams(gs, Coll.Nil)
  val Ty.Open(st1a, tv0, vars) = Ty.open(st, tps, Coll.Nil, Coll.Nil)
  // A1: a length in the signature names an I64 param: at the call it is the identity of the arg (a fresh one when the
  // arg is not a local with one: no fact or value of the caller has it)
  val Ty.Cx(_, _, _, _, _, _, _, _, _, arr, idx) = cx
  val Ty.Ids(st1, tv) = arr match
    case Names.NoArrays => Ty.Ids(st1a, tv0)
    case Names.UsesArrays => if Ty.sigVals(ps, ret) then Ty.argIds(st1a, bs, ps, xs, tv0) else Ty.Ids(st1a, tv0)
  val st2 = Ty.explicit(st1, line, vars, Ty.terms(targs, Coll.Nil, Coll.Nil))
  val rt = Ty.term(ret, tv)
  val st3 = Ty.expectOpt(st2, line, rt, want)
  if if variadic then Coll.length(xs) < Coll.length(ps) else Coll.length(ps) != Coll.length(xs) then
    Ty.Ex(Ty.args(cx, Ty.clash(st3, Ty.Arity(line, name)), bs, xs), rt, El.Bad(line))
  else
    val Ty.Es(st4p, eargs0) = Ty.params(cx, st3, bs, line, ps, tv, xs, Coll.Nil)
    val Ty.Es(st4, eargs) =
      if variadic then Ty.extras(cx, st4p, bs, Ty.dropN(xs, Coll.length(ps)), Coll.rev(eargs0)) else Ty.Es(st4p, eargs0)
    val ev = Ty.evidence(gs, Coll.Nil)
    val st4b =
      if Coll.length(chosen) > 0 && Coll.length(chosen) != Coll.length(ev) then
        Ty.clash(st4, Ty.ChosenCount(line, name))
      else st4
    val Ty.Caps(st5, caps) = Ty.capArgs(cx, st4b, bs, line, tv, ev, chosen, 0, Coll.Nil)
    val Ty.Cx(_, _, _, _, _, _, _, rows, _, _, idx) = cx
    val Ty.Caps(st6, icaps) = Ty.rowCaps(cx, st5, bs, line, Ty.runRow(cx, Eff.row(rows, name)), Coll.Nil)
    Ty.Ex(Ty.inst(st6, line, name, vars), rt, El.CallFn(line, name, vars, Coll.revOnto(Coll.rev(caps), icaps), Ty.callArgs(body, ps, eargs)))

// the args a call keeps: a libc callee's ghost args (an Array length: no C argument) are checked, then dropped
def Ty.callArgs(body: Ast.Body, ps: Coll.List[Ast.Binder], es: Coll.List[El.Expr]): Coll.List[El.Expr] = body match
  case Ast.Def(_, _) => es
  case Ast.Extern(abi) => abi match
    case Ast.AbiSrs => es
    case _ => Ty.dropGhost(Ty.ghostsFor(abi, ps), es)

def Ty.dropGhost(gh: Coll.List[Bool], es: Coll.List[El.Expr]): Coll.List[El.Expr] = es match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(e, rest) => gh match
    case Coll.Nil => es
    case Coll.Cons(g, gr) => if g then Ty.dropGhost(gr, rest) else Coll.Cons(e, Ty.dropGhost(gr, rest))

def Ty.isVariadic(abi: Ast.Abi): Bool = abi match
  case Ast.AbiLibcVar => true
  case _ => false

// the extra args of a variadic libc call: C promotes each to int, so each is an I32 (anything else is a mismatch)
def Ty.extras(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], acc: Coll.List[El.Expr]): Ty.Es = xs match
  case Coll.Nil => Ty.Es(st, Coll.rev(acc))
  case Coll.Cons(x, rest) =>
    val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.Some(Ty.con("I32")))
    Ty.extras(cx, st1, bs, rest, Coll.Cons(ex, acc))

def Ty.dropN(xs: Coll.List[Ast.Expr], n: I64): Coll.List[Ast.Expr] =
  if n <= 0 then xs
  else xs match
    case Coll.Nil => Coll.Nil
    case Coll.Cons(_, rest) => Ty.dropN(rest, n - 1)

// the ghost params of a libc extern: an I64 that only names the length of an Array param is a proof object, not a C value
// (the C prototype and the C call leave it out); an srs extern has none
def Ty.ghostsFor(abi: Ast.Abi, ps: Coll.List[Ast.Binder]): Coll.List[Bool] = abi match
  case Ast.AbiSrs => Ty.noGhosts(ps)
  case _ => Ty.ghosts(ps, ps)

def Ty.noGhosts(ps: Coll.List[Ast.Binder]): Coll.List[Bool] = ps match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(_, rest) => Coll.Cons(false, Ty.noGhosts(rest))

def Ty.ghosts(all: Coll.List[Ast.Binder], ps: Coll.List[Ast.Binder]): Coll.List[Bool] = ps match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, t) = p
    val Ast.Ty(_, tn, _, _, _) = t
    Coll.Cons(Str.eq(Sym.str(tn), "I64") && Ty.lengthOfAny(all, x), Ty.ghosts(all, rest))

def Ty.lengthOfAny(all: Coll.List[Ast.Binder], x: Sym.Sym): Bool = all match
  case Coll.Nil => false
  case Coll.Cons(q, rest) =>
    val Ast.Binder(_, _, qt) = q
    val Ast.Ty(_, _, _, _, vals) = qt
    Ty.namesVal(vals, x) || Ty.lengthOfAny(rest, x)

def Ty.namesVal(vals: Coll.List[Ast.Expr], x: Sym.Sym): Bool = vals match
  case Coll.Nil => false
  case Coll.Cons(v, rest) => v match
    case Ast.Name(_, y) => Sym.eq(x, y) || Ty.namesVal(rest, x)
    case _ => Ty.namesVal(rest, x)

// a signature with a value arg in a param type or the result (A1)
def Ty.sigVals(ps: Coll.List[Ast.Binder], ret: Ast.Ty): Bool = if Ty.hasVals(ret) then true else Ty.paramVals(ps)

def Ty.paramVals(ps: Coll.List[Ast.Binder]): Bool = ps match
  case Coll.Nil => false
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, _, t) = p
    if Ty.hasVals(t) then true else Ty.paramVals(rest)

// each I64 param gets the identity of its arg (same value), else a fresh one that no local has: a length of that
// identity is never indexed, sliced or read (so a call in a loop may share it)
def Ty.argIds(st: Ty.St, bs: Coll.List[Ty.Bind], ps: Coll.List[Ast.Binder], xs: Coll.List[Ast.Expr], tv: Coll.List[Ty.Bind]): Ty.Ids = ps match
  case Coll.Nil => Ty.Ids(st, tv)
  case Coll.Cons(p, prest) => xs match
    case Coll.Nil => Ty.Ids(st, tv)
    case Coll.Cons(x, xrest) =>
      val Ast.Binder(_, px, pt) = p
      if Ty.isI64(pt) then Ty.idE(bs, x) match
        case Coll.Some(id) => Ty.argIds(st, bs, prest, xrest, Coll.Cons(Ty.Val(px, Ty.con("I64"), id), tv))
        case Coll.None =>
          Ty.argIds(Ty.stamped(st), bs, prest, xrest, Coll.Cons(Ty.Val(px, Ty.con("I64"), Ty.nextId(st)), tv))
      else Ty.argIds(st, bs, prest, xrest, tv)

// record a generic instance (no binders: nothing to instantiate)
def Ty.inst(st: Ty.St, line: I64, name: Sym.Sym, vars: Coll.List[K.Term]): Ty.St = vars match
  case Coll.Nil => st
  case Coll.Cons(_, _) =>
    val Ty.St(s, n, cs, is, gs, nm) = st
    Ty.St(s, n, cs, Coll.Cons(Ty.Inst(line, name, vars), is), gs, nm)

// f[T1, ...]: each written type arg binds its binder (too many: Arity)
def Ty.explicit(st: Ty.St, line: I64, vars: Coll.List[K.Term], ts: Coll.List[K.Term]): Ty.St = ts match
  case Coll.Nil => st
  case Coll.Cons(t, rest) => vars match
    case Coll.Nil => Ty.clash(st, Ty.Arity(line, Sym.of("[]")))
    case Coll.Cons(v, vs) => Ty.explicit(Ty.expect(st, line, v, t), line, vs, rest)

// each arg against its param type (binders as opened); the elaborated args in order
def Ty.params(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], acc: Coll.List[El.Expr]): Ty.Es = ps match
  case Coll.Nil => Ty.Es(st, Coll.rev(acc))
  case Coll.Cons(p, prest) => xs match
    case Coll.Nil => Ty.Es(st, Coll.rev(acc))
    case Coll.Cons(x, xrest) =>
      val Ast.Binder(_, _, pt) = p
      val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.Some(Ty.term(pt, tv)))
      Ty.params(cx, st1, bs, line, prest, tv, xrest, Coll.Cons(ex, acc))

// ── capabilities at a call: each {} binder of a protocol type takes a caller capability ──
enum Ty.Caps:
  case Ty.Caps(st: Ty.St, caps: Coll.List[Sym.Sym])

// i = the binder's index among all {} binders (f{a, b}(x) picks by it)
def Ty.capArgs(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, tv: Coll.List[Ty.Bind], ev: Coll.List[Ast.Binder], chosen: Coll.List[Sym.Sym], i: I64, acc: Coll.List[Sym.Sym]): Ty.Caps = ev match
  case Coll.Nil => Ty.Caps(st, Coll.rev(acc))
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, pn, _, _, _) = t
    val Ty.Cx(_, _, ps, _, _, mode, _, _, _, _, idx) = cx
    val compilerRegion: Bool = mode match
      case Ty.Comptime => Pure.isRegion(pn)
      case Ty.Run(_) => false
    if !Ty.isProto(ps, pn) then
      Ty.capArgs(cx, Ty.addGoal(st, Ty.Goal(line, Ty.term(t, tv), bs, Ty.nthSym(chosen, i))), bs, line, tv, rest, chosen, i + 1, acc)
    // at compile time the compiler supplies Region (vic 2026-11-09)
    else if compilerRegion then Ty.capArgs(cx, st, bs, line, tv, rest, chosen, i + 1, acc)
    else Ty.capFor(st, bs, line, pn, chosen, i) match
      case Ty.Caps(st1, c) => Ty.capArgs(cx, st1, bs, line, tv, rest, chosen, i + 1, Coll.revOnto(c, acc))

// the cap of protocol p: the chosen name at index i, else the one local of type p in scope (none or two: NoCap)
def Ty.capFor(st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, p: Sym.Sym, chosen: Coll.List[Sym.Sym], i: I64): Ty.Caps = chosen match
  case Coll.Cons(_, _) => Ty.nthSym(chosen, i) match
    case Coll.Some(x) =>
      Ty.Caps(if Ty.isCapOf(Ty.subst(st), bs, x, p) then st else Ty.clash(st, Ty.ChosenNotCap(line, p)), Coll.Cons(x, Coll.Nil))
    case Coll.None => Ty.Caps(Ty.clash(st, Ty.NoCap(line, p)), Coll.Nil)
  case Coll.Nil => Ty.capsOf(Ty.subst(st), bs, p, Coll.Nil) match
    case Coll.Cons(x, more) => more match
      case Coll.Nil => Ty.Caps(st, Coll.Cons(x, Coll.Nil))
      case Coll.Cons(_, _) => Ty.Caps(Ty.clash(st, Ty.NoCap(line, p)), Coll.Nil)
    case Coll.Nil => Ty.Caps(Ty.clash(st, Ty.NoCap(line, p)), Coll.Nil)

// the distinct local names of type p (a shadowed name counts once)
def Ty.capsOf(s: K.Subst, bs: Coll.List[Ty.Bind], p: Sym.Sym, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(x, t) =>
      val isP: Bool = K.walk(s, t) match
        case K.Con(n, args) => Sym.eq(n, p) && Coll.length(args) == 0
        case _ => false
      if isP && !Ty.memberSym(x, acc) then Ty.capsOf(s, rest, p, Coll.Cons(x, acc)) else Ty.capsOf(s, rest, p, acc)
    case _ => Ty.capsOf(s, rest, p, acc)

def Ty.memberSym(x: Sym.Sym, xs: Coll.List[Sym.Sym]): Bool = xs match
  case Coll.Nil => false
  case Coll.Cons(h, t) => if Sym.eq(h, x) then true else Ty.memberSym(x, t)

def Ty.nthSym(xs: Coll.List[Sym.Sym], i: I64): Coll.Option[Sym.Sym] = xs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) => if i == 0 then Coll.Some(x) else Ty.nthSym(rest, i - 1)

def Ty.isProto(ps: Coll.List[Ast.Proto], n: Sym.Sym): Bool = ps match
  case Coll.Nil => false
  case Coll.Cons(p, rest) =>
    val Ast.Proto(_, _, pn, _, _, _, _, _, _) = p
    if Sym.eq(pn, n) then true else Ty.isProto(rest, n)

// a constructor: the enum at fresh vars, check mode first, then the fields; it is a request on Region, so it allocates in
// the innermost Region in scope (a compile-time body allocates nothing at run time)
def Ty.callCase(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, co: Ty.CaseOf, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.CaseOf(e, c) = co
  val Ast.Enum(_, _, en, _, _) = e
  val Ast.Case(_, _, name, fields) = c
  val Ty.Open(st1, tv, vars) = Ty.openEnum(st, e)
  val et = Ty.enumTerm(e, vars)
  val st2 = Ty.expectOpt(st1, line, et, want)
  if Coll.length(fields) != Coll.length(xs) then
    Ty.Ex(Ty.args(cx, Ty.clash(st2, Ty.Arity(line, name)), bs, xs), et, El.Bad(line))
  else
    val st3 = Ty.inst(st2, line, name, vars)
    fields match
      case Coll.Nil => Ty.Ex(st3, et, El.Nullary(line, en, vars, name))
      case Coll.Cons(_, _) =>
        // A1: a length in a field type names an I64 field: the identity of its arg
        val Ty.Cx(_, _, _, _, _, _, _, _, _, arr, idx) = cx
        val Ty.Ids(st3b, tvf) = arr match
          case Names.NoArrays => Ty.Ids(st3, tv)
          case Names.UsesArrays => if Ty.paramVals(fields) then Ty.argIds(st3, bs, fields, xs, tv) else Ty.Ids(st3, tv)
        val Ty.Es(st4, eargs) = Ty.params(cx, st3b, bs, line, fields, tvf, xs, Coll.Nil)
        val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, idx) = cx
        mode match
          case Ty.Comptime => Ty.Ex(st4, et, El.New(line, en, vars, name, El.Comptime, eargs))
          case Ty.Run(_) => Ty.innermost(Ty.subst(st4), bs, Sym.of("Region")) match
            case Coll.Some(reg) => Ty.Ex(st4, et, El.New(line, en, vars, name, El.In(reg), eargs))
            case Coll.None => Ty.Ex(Ty.clash(st4, Ty.unhandled(cx, line, Sym.of("Region"))), et, El.Bad(line))

// recv.op(args): recv is a capability (op of its protocol) or {} evidence of a trait (the trait method, trait args
// bound from the evidence type)
def Ty.method(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, recv: Sym.Sym, op: Sym.Sym, xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Cx(_, _, ps, _, trs, _, _, _, _, _, idx) = cx
  Ty.lookup(bs, recv) match
    case Coll.None =>
      // struct.new(): a name that is a declared extern "libc" struct, not a local (a lowercase C tag parses as a method call)
      if Str.eq(Sym.str(op), "new") && Ty.isCNew(cx, Eff.dotted(Sym.str(recv), op)) then
        Ty.cstructNew(cx, st, bs, line, Eff.dotted(Sym.str(recv), op), xs, want)
      else Ty.bad(Ty.args(cx, Ty.clash(st, Ty.Unknown(line, recv)), bs, xs), line)
    case Coll.Some(rt) => K.walk(Ty.subst(st), rt) match
      case K.Con(tn, targs) => Ty.protoOp(ps, tn, op) match
        case Coll.Some(o) =>
          val Ast.Op(_, _, _, ogs, ops, oret, _) = o
          val Ty.Caps(st0, ocaps) = Ty.opCaps(cx, st, bs, line, Ty.evidence(ogs, Coll.Nil), Coll.Nil)
          Ty.callSig(cx, st0, bs, line, Ty.ProtoOp(recv, ocaps), rt, op, ops, oret, Coll.Nil, xs, want)
        case Coll.None => Ty.traitMethod(trs, tn, op) match
          case Coll.Some(tm) =>
            val Ty.TM(tr, m) = tm
            val Ast.Trait(_, _, _, tgs, _) = tr
            val Ast.Fn(_, _, _, _, mps, mret, _, _) = m
            val Ty.Caps(st1, caps) = Ty.rowCaps(cx, st, bs, line, Ty.methodCaps(ps, trs, tn, op), Coll.Nil)
            Ty.callSig(cx, st1, bs, line, Ty.TraitOp(caps), rt, op, mps, mret, Ty.zipBind(Ty.tparams(tgs, Coll.Nil), targs, Coll.Nil), xs, want)
          // xs.at(j) on an array (A1); s.field() on an extern "libc" struct
          case Coll.None => Ty.arrayOf(Ty.subst(st), rt) match
            case Coll.Some(at) =>
              if Str.eq(Sym.str(op), "at") then Ty.atCall(cx, st, bs, line, recv, at, xs, want)
              else Ty.bad(Ty.args(cx, Ty.clash(st, Ty.NoOp(line, op)), bs, xs), line)
            case Coll.None => Ty.cfield(cx, st, bs, line, recv, tn, op, xs, want) match
              case Coll.Some(ex) => ex
              case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.NoOp(line, op)), bs, xs), line)
      case _ => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.NoOp(line, op)), bs, xs), line)

def Ty.subst(st: Ty.St): K.Subst =
  val Ty.St(s, _, _, _, _, _) = st
  s

// recv.op: an op of capability recv, or a trait method with the caller's capabilities for its {} binders
enum Ty.OpKind:
  case Ty.ProtoOp(recv: Sym.Sym, caps: Coll.List[Sym.Sym])
  case Ty.TraitOp(caps: Coll.List[Sym.Sym])

// a signature with its binders bound to tv: arity, args, result
def Ty.callSig(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, k: Ty.OpKind, rty: K.Term, name: Sym.Sym, ps: Coll.List[Ast.Binder], ret: Ast.Ty, tv: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], want: Coll.Option[K.Term]): Ty.Ex =
  val rt = Ty.term(ret, tv)
  if Coll.length(ps) != Coll.length(xs) then
    Ty.Ex(Ty.args(cx, Ty.clash(st, Ty.Arity(line, name)), bs, xs), rt, El.Bad(line))
  else
    val Ty.Es(st1, eargs) = Ty.params(cx, st, bs, line, ps, tv, xs, Coll.Nil)
    val ex: El.Expr = k match
      case Ty.ProtoOp(recv, ocaps) => El.Op(line, recv, rty, name, eargs, ocaps)
      case Ty.TraitOp(caps) => El.TCall(line, rty, name, caps, eargs)
    Ty.lit(st1, line, rt, want, ex)

def Ty.zipBind(xs: Coll.List[Sym.Sym], ts: Coll.List[K.Term], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => acc
  case Coll.Cons(x, rest) => ts match
    case Coll.Nil => acc
    case Coll.Cons(t, trest) => Ty.zipBind(rest, trest, Coll.Cons(Ty.Bind(x, t), acc))

// the capabilities an op's own {} binders take at a request: the caller's innermost of each protocol (as a constructor
// takes the innermost Region), none in scope = NoCap
def Ty.opCaps(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ev: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Ty.Caps = ev match
  case Coll.Nil => Ty.Caps(st, Coll.rev(acc))
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, pn, _, _, _) = t
    val Ty.Cx(_, _, ps, _, _, _, _, _, _, _, _) = cx
    if !Ty.isProto(ps, pn) then Ty.opCaps(cx, st, bs, line, rest, acc)
    else Ty.innermost(Ty.subst(st), bs, pn) match
      case Coll.Some(x) => Ty.opCaps(cx, st, bs, line, rest, Coll.Cons(x, acc))
      case Coll.None => Ty.opCaps(cx, Ty.clash(st, Ty.NoCap(line, pn)), bs, line, rest, acc)

def Ty.protoOp(ps: Coll.List[Ast.Proto], p: Sym.Sym, op: Sym.Sym): Coll.Option[Ast.Op] = ps match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Ast.Proto(_, _, n, _, _, _, _, ops, _) = x
    if Sym.eq(n, p) then Ty.opIn(ops, op) else Ty.protoOp(rest, p, op)

def Ty.opIn(os: Coll.List[Ast.Op], op: Sym.Sym): Coll.Option[Ast.Op] = os match
  case Coll.Nil => Coll.None
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, _, n, _, _, _, _) = o
    if Sym.eq(n, op) then Coll.Some(o) else Ty.opIn(rest, op)

enum Ty.TM:
  case Ty.TM(t: Ast.Trait, m: Ast.Fn)

def Ty.traitMethod(trs: Coll.List[Ast.Trait], t: Sym.Sym, op: Sym.Sym): Coll.Option[Ty.TM] = trs match
  case Coll.Nil => Coll.None
  case Coll.Cons(tr, rest) =>
    val Ast.Trait(_, _, n, _, sigs) = tr
    if Sym.eq(n, t) then Ty.fnNamed(sigs, op) match
      case Coll.Some(m) => Coll.Some(Ty.TM(tr, m))
      case Coll.None => Coll.None
    else Ty.traitMethod(rest, t, op)

// ── operators: + - * and comparison on one int type (I64, U32, U64; U32 and U64 wrap), / % on I64 (C: no wrap
// trap on unsigned / 0), | ^ & ~ << >> on U32 or U64 only, == and != on any one type, && || on Bool. no implicit
// conversion between int types (U32.of, U64.of, I64.of in lib/prelude.srs). every unsigned op is defined in C for
// every input: unsigned wraps, a shift count is taken mod the width ──
def Ty.bin(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex = op match
  case Ast.Eq => Ty.eqOp(cx, st, bs, line, op, l, rhs, want)
  case Ast.Ne => Ty.eqOp(cx, st, bs, line, op, l, rhs, want)
  case Ast.And => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("Bool"), Ty.con("Bool"), want)
  case Ast.Or => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("Bool"), Ty.con("Bool"), want)
  case Ast.Lt => Ty.ints(cx, st, bs, line, op, l, rhs, true, Ty.AnyInt, want)
  case Ast.Le => Ty.ints(cx, st, bs, line, op, l, rhs, true, Ty.AnyInt, want)
  case Ast.Gt => Ty.ints(cx, st, bs, line, op, l, rhs, true, Ty.AnyInt, want)
  case Ast.Ge => Ty.ints(cx, st, bs, line, op, l, rhs, true, Ty.AnyInt, want)
  case Ast.Add => Ty.ints(cx, st, bs, line, op, l, rhs, false, Ty.AnyInt, want)
  case Ast.Sub => Ty.ints(cx, st, bs, line, op, l, rhs, false, Ty.AnyInt, want)
  case Ast.Mul => Ty.ints(cx, st, bs, line, op, l, rhs, false, Ty.AnyInt, want)
  case Ast.BitOr => Ty.ints(cx, st, bs, line, op, l, rhs, false, Ty.WordInt, want)
  case Ast.BitXor => Ty.ints(cx, st, bs, line, op, l, rhs, false, Ty.WordInt, want)
  case Ast.BitAnd => Ty.ints(cx, st, bs, line, op, l, rhs, false, Ty.WordInt, want)
  case Ast.Shl => Ty.shift(cx, st, bs, line, op, l, rhs, want)
  case Ast.Shr => Ty.shift(cx, st, bs, line, op, l, rhs, want)
  case _ => Ty.both(cx, st, bs, line, op, l, rhs, Ty.con("I64"), Ty.con("I64"), want)

// the int types an operator takes: any of I64, U32, U64, or a word (U32, U64)
enum Ty.Ints:
  case Ty.AnyInt
  case Ty.WordInt

// the int kind of t under the substitution: U32 or U64 by name, else I64 (a var, another type: the caller unifies)
def Ty.kindOf(st: Ty.St, t: K.Term): El.IntK =
  val Ty.St(s, _, _, _, _, _) = st
  K.walk(s, t) match
    // by text: Sym.of would hash and allocate per operator
    case K.Con(n, _) => Ty.kindNamed(Sym.str(n))
    case _ => El.KI64

def Ty.kindNamed(s: Str): El.IntK =
  if Str.eq(s, "U32") then El.KU32
  else if Str.eq(s, "U64") then El.KU64
  else El.KI64

def Ty.kindTy(k: El.IntK): K.Term = k match
  case El.KI64 => Ty.con("I64")
  case El.KU32 => Ty.con("U32")
  case El.KU64 => Ty.con("U64")

// the kind an operator works at, from its deciding operand's kind: a word operator on a non-word wants U32
def Ty.opKind(k: El.IntK, which: Ty.Ints): El.IntK = which match
  case Ty.AnyInt => k
  case Ty.WordInt => k match
    case El.KU64 => El.KU64
    case _ => El.KU32

// the expected type passed to an operand: a wanted U32 or U64 (so a literal operand is one), else none (inferred)
def Ty.wordHint(st: Ty.St, want: Coll.Option[K.Term]): Coll.Option[K.Term] = want match
  case Coll.None => Coll.None
  case Coll.Some(w) => Ty.kindOf(st, w) match
    case El.KI64 => Coll.None
    case _ => Coll.Some(w)

// an int literal: I64, or the U32 or U64 the context wants; it must fit that type (no silent wrap)
def Ty.int(st: Ty.St, line: I64, v: I64, want: Coll.Option[K.Term]): Ty.Ex =
  val k: El.IntK = want match
    case Coll.None => El.KI64
    case Coll.Some(w) => Ty.kindOf(st, w)
  val st1 = if Ty.fits(k, v) then st else Ty.clash(st, Ty.IntRange(line, Ty.kindTy(k)))
  Ty.lit(st1, line, Ty.kindTy(k), want, El.Int(line, v, k))

def Ty.fits(k: El.IntK, v: I64): Bool = k match
  case El.KI64 => true
  case El.KU32 => v >= 0 && v <= 4294967295
  case El.KU64 => v >= 0

// t0 must be the int type t (a con): no unify when t0 already is t, the common case (no new state per operator)
def Ty.expectInt(st: Ty.St, line: I64, t0: K.Term, t: K.Term): Ty.St =
  val Ty.St(s, _, _, _, _, _) = st
  if Ty.sameCon(K.walk(s, t0), t) then st else Ty.expect(st, line, t0, t)

def Ty.sameCon(a: K.Term, b: K.Term): Bool = a match
  case K.Con(n, _) => b match
    case K.Con(m, _) => Sym.eq(n, m)
    case _ => false
  case _ => false

def Ty.isIntLit(e: Ast.Expr): Bool = e match
  case Ast.Int(_, _) => true
  case _ => false

// one operand decides the type: the left, or the right when the left is a literal (0xff & x); the other is checked
// against it. cmp: the result is Bool, else the operand type
def Ty.ints(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, cmp: Bool, which: Ty.Ints, want: Coll.Option[K.Term]): Ty.Ex =
  val lit = Ty.isIntLit(l)
  val d = if lit then rhs else l
  val o = if lit then l else rhs
  val Ty.Ex(st1, t0, ed) = Ty.expr(cx, st, bs, d, if cmp then Coll.None else Ty.wordHint(st, want))
  val t = Ty.kindTy(Ty.opKind(Ty.kindOf(st1, t0), which))
  val Ty.Ex(st2, _, eo) = Ty.expr(cx, Ty.expectInt(st1, Ty.lineOf(d), t0, t), bs, o, Coll.Some(t))
  Ty.lit(st2, line, if cmp then Ty.con("Bool") else t, want, El.Bin(line, op, if lit then eo else ed, if lit then ed else eo))

// x << n, x >> n: x a word, n an I64 taken mod the width (C's shift is undefined for a count outside [0, width))
def Ty.shift(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Ex(st1, t0, el) = Ty.expr(cx, st, bs, l, Ty.wordHint(st, want))
  val k = Ty.opKind(Ty.kindOf(st1, t0), Ty.WordInt)
  val t = Ty.kindTy(k)
  val Ty.Ex(st2, _, en) = Ty.expr(cx, Ty.expectInt(st1, Ty.lineOf(l), t0, t), bs, rhs, Coll.Some(Ty.con("I64")))
  val mask = Ty.widthMask(k)
  Ty.lit(st2, line, t, want, El.Bin(line, op, el, El.Bin(line, Ast.BitAnd, en, El.Int(line, mask, El.KI64))))

def Ty.widthMask(k: El.IntK): I64 = k match
  case El.KU64 => 63
  case _ => 31

// ~x on a word
def Ty.ints1(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, x: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Ex(st1, t0, ex) = Ty.expr(cx, st, bs, x, Ty.wordHint(st, want))
  val t = Ty.kindTy(Ty.opKind(Ty.kindOf(st1, t0), Ty.WordInt))
  Ty.lit(Ty.expectInt(st1, Ty.lineOf(x), t0, t), line, t, want, El.Un(line, Ast.BitNot, ex))

// both operands of type arg, the result of type res
def Ty.both(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, arg: K.Term, res: K.Term, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Ex(st1, _, el) = Ty.expr(cx, st, bs, l, Coll.Some(arg))
  val Ty.Ex(st2, _, er) = Ty.expr(cx, st1, bs, rhs, Coll.Some(arg))
  Ty.lit(st2, line, res, want, El.Bin(line, op, el, er))

def Ty.eqOp(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, op: Ast.BinOp, l: Ast.Expr, rhs: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Ex(st1, tl, el) = Ty.expr(cx, st, bs, l, Coll.None)
  val Ty.Ex(st2, _, er) = Ty.expr(cx, st1, bs, rhs, Coll.Some(tl))
  Ty.lit(st2, line, Ty.con("Bool"), want, El.Bin(line, op, el, er))

// ── match: the scrutinee is an enum E[args]; each arm binds its case fields with E's binders at args ──
def Ty.arms(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ts: K.Term, es: El.Expr, as: Coll.List[Ast.Arm], want: Coll.Option[K.Term]): Ty.Ex = as match
  case Coll.Nil => Ty.bad(st, line)
  case Coll.Cons(a, rest) =>
    val Ty.Cx(_, enums, _, _, _, _, _, _, _, _, idx) = cx
    val st0 = Ty.missingCase(cx, as) match
      case Coll.Some(c) => Ty.clash(st, Ty.NotExhaustive(line, c))
      case Coll.None => st
    val Ty.AEx(st1, t1, ea) = Ty.arm(cx, st0, bs, ts, a, want)
    Ty.armsSame(cx, st1, bs, line, ts, es, rest, t1, Coll.Cons(ea, Coll.Nil))

// the arms after the first: each must have the first's type; the elaborated arms in order
def Ty.armsSame(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ts: K.Term, es: El.Expr, as: Coll.List[Ast.Arm], t: K.Term, acc: Coll.List[El.Arm]): Ty.Ex = as match
  case Coll.Nil => Ty.Ex(st, t, El.Match(line, es, ts, Coll.rev(acc)))
  case Coll.Cons(a, rest) =>
    val Ty.AEx(st1, _, ea) = Ty.arm(cx, st, bs, ts, a, Coll.Some(t))
    Ty.armsSame(cx, st1, bs, line, ts, es, rest, t, Coll.Cons(ea, acc))

// a sub-pattern is a variable binder: one named like a declared ctor is a nested pattern the writer meant as a test
def Ty.nestedBinder(cx: Ty.Cx, st: Ty.St, line: I64, xs: Coll.List[Sym.Sym]): Ty.St = xs match
  case Coll.Nil => st
  case Coll.Cons(x, rest) => Ty.caseOf(cx, x) match
    case Coll.Some(_) => Ty.nestedBinder(cx, Ty.clash(st, Ty.NestedPattern(line, x)), line, rest)
    case Coll.None => Ty.nestedBinder(cx, st, line, rest)

// an arm: its type and its elaborated form
enum Ty.AEx:
  case Ty.AEx(st: Ty.St, t: K.Term, a: El.Arm)

def Ty.arm(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], ts: K.Term, a: Ast.Arm, want: Coll.Option[K.Term]): Ty.AEx =
  val Ast.Arm(_, line, p, b) = a
  val Ty.Cx(_, es, _, _, _, _, _, _, _, _, idx) = cx
  val Ty.Ex(st9, t9, e9) = p match
    case Ast.PAny => Ty.expr(cx, st, bs, b, want)
    case Ast.PCase(c, binds) => Ty.caseOf(cx, c) match
      case Coll.None => Ty.expr(cx, Ty.clash(st, Ty.Unknown(line, c)), bs, b, want)
      case Coll.Some(co) =>
        val Ty.CaseOf(e, cs) = co
        val Ast.Case(_, _, _, fields) = cs
        val Ty.Open(st1, tv, vars) = Ty.openEnum(st, e)
        val st1b =
          Ty.nestedBinder(cx, if Coll.length(binds) == Coll.length(fields) then st1 else Ty.clash(st1, Ty.PatArity(line, c)), line, binds)
        val st2 = Ty.expect(st1b, line, ts, Ty.enumTerm(e, vars))
        // A1: each I64 field binder has an identity (not in a loop), and the field types name lengths by it
        val Ty.Cx(_, _, _, _, _, _, _, _, _, arr, idx) = cx
        val Ty.FieldBs(st3, bs3) = arr match
          case Names.NoArrays => Ty.FieldBs(st2, Ty.bindFields(binds, fields, tv, bs))
          case Names.UsesArrays =>
            if Ty.paramVals(fields) then Ty.fieldIds(st2, binds, fields, tv, bs)
            else Ty.FieldBs(st2, Ty.bindFields(binds, fields, tv, bs))
        Ty.expr(cx, st3, bs3, b, want)
  Ty.AEx(st9, t9, El.Arm(line, p, e9))

enum Ty.FieldBs:
  case Ty.FieldBs(st: Ty.St, bs: Coll.List[Ty.Bind])

// A1 record with a length field: the I64 fields get identities (none in a loop), the field types name them, and a
// binder of an I64 field has its field's identity
def Ty.fieldIds(st: Ty.St, binds: Coll.List[Sym.Sym], fields: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], bs: Coll.List[Ty.Bind]): Ty.FieldBs =
  val Ty.Ids(st1, tvf) = if Ty.inLoop(bs) then Ty.Ids(st, tv) else Ty.paramIds(st, fields, tv)
  Ty.FieldBs(st1, Ty.bindFieldsV(binds, fields, tvf, bs))

def Ty.bindFieldsV(xs: Coll.List[Sym.Sym], fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], bs: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => bs
  case Coll.Cons(x, rest) => fs match
    case Coll.Nil => bs
    case Coll.Cons(f, frest) =>
      val Ast.Binder(_, fx, ft) = f
      val tx = Ty.term(ft, tv)
      val b: Ty.Bind = Ty.idOf(tv, fx) match
        case Coll.Some(id) => Ty.Val(x, tx, id)
        case Coll.None => Ty.Bind(x, tx)
      Ty.bindFieldsV(rest, frest, tv, if Str.eq(Sym.str(x), "_") then bs else Coll.Cons(b, bs))

def Ty.bindFields(xs: Coll.List[Sym.Sym], fs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], bs: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = xs match
  case Coll.Nil => bs
  case Coll.Cons(x, rest) => fs match
    case Coll.Nil => bs
    case Coll.Cons(f, frest) =>
      val Ast.Binder(_, _, ft) = f
      Ty.bindFields(rest, frest, tv, if Str.eq(Sym.str(x), "_") then bs else Coll.Cons(Ty.Bind(x, Ty.term(ft, tv)), bs))

// ── blocks: val/var bind (an annotation is the expected type), handle binds a capability of the handler's protocol;
// acc = the elaborated statements so far, reversed ──
def Ty.block(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, ss: Coll.List[Ast.Stmt], last: Ast.Expr, want: Coll.Option[K.Term], acc: Coll.List[El.Stmt]): Ty.Ex = ss match
  case Coll.Nil =>
    val Ty.Ex(st1, t, el) = Ty.expr(cx, st, bs, last, want)
    Ty.Ex(st1, t, El.Block(line, Coll.rev(acc), el))
  case Coll.Cons(s, rest) => s match
    case Ast.Val(_, sl, x, ann, e) => Ty.bindStmt(cx, st, bs, line, sl, x, ann, e, false, rest, last, want, acc)
    case Ast.Var(_, sl, x, ann, e) => Ty.bindStmt(cx, st, bs, line, sl, x, ann, e, true, rest, last, want, acc)
    // the handler's row takes the innermost capabilities outside this handle (E1b)
    case Ast.Handle(_, sl, x, h, xs) =>
      val Ty.Cx(_, _, _, hs, _, mode, _, rows, _, _, idx) = cx
      val mp = Ty.protoOf(hs, h)
      val st0 =
        if Ty.isMultiShot(hs, h) then
          Ty.shapeFns(cx, Ty.shape(cx, st, x, mp, rest, last), mp, Ty.cpsCallsE(cx, mp, last, Ty.cpsCalls(cx, mp, rest, Coll.Nil)), Coll.Nil)
        else st
      val Ty.Es(st1, eargs) =
        Ty.exprs(cx, Ty.pureHandle(mode, Ty.ambient(cx, st0, bs, sl, h, mp), sl, h), bs, xs, Coll.Nil)
      val Ty.Caps(st2, caps) = Ty.rowCaps(cx, st1, bs, sl, Eff.row(rows, h), Coll.Nil)
      val bs2 = Coll.Cons(Ty.Bind(x, K.Con(Ty.protoOf(hs, h), Coll.Nil)), bs)
      Ty.multiOf(hs, h) match
        case Coll.None =>
          Ty.block(cx, st2, bs2, line, rest, last, want, Coll.Cons(El.Handle(sl, x, h, caps, eargs), acc))
        // multi-shot (vic-hm63 Q-M2, Q-M3): the rest of the block is its own block of type a; the whole is the answer R[A := a]
        case Coll.Some(ma) =>
          val Ty.MA(av, ans) = ma
          // the rest runs once per resume: a loop for identities (A1)
          val Ty.Ex(st3, a, er) = Ty.block(cx, st2, Ty.loopBs(cx, bs2), line, rest, last, Coll.None, Coll.Nil)
          val rt = Ty.term(ans, Coll.Cons(Ty.Bind(av, a), Coll.Nil))
          val Ty.Ex(st4, t, ev) = Ty.lit(st3, sl, rt, want, El.MHandled(sl, x, h, caps, eargs, er, a, rt))
          Ty.Ex(st4, t, El.Block(line, Coll.rev(acc), ev))
    case Ast.Do(_, e) =>
      val Ty.Ex(st1, _, ee) = Ty.expr(cx, st, bs, e, Coll.None)
      Ty.block(cx, st1, bs, line, rest, last, want, Coll.Cons(El.Do(ee), acc))
    // a loop invariant or measure: checked, erased
    case Ast.Check(_, _, k, e) =>
      val want2 = k match
        case Ast.LInvariant => Ty.con("Bool")
        case Ast.LDecreases => Ty.con("I64")
      val Ty.Ex(st1, _, _) = Ty.expr(cx, st, bs, e, Coll.Some(want2))
      Ty.block(cx, st1, bs, line, rest, last, want, acc)

def Ty.exprs(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], xs: Coll.List[Ast.Expr], acc: Coll.List[El.Expr]): Ty.Es = xs match
  case Coll.Nil => Ty.Es(st, Coll.rev(acc))
  case Coll.Cons(x, rest) =>
    val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.None)
    Ty.exprs(cx, st1, bs, rest, Coll.Cons(ex, acc))

def Ty.bindStmt(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, sl: I64, x: Sym.Sym, ann: Coll.Option[Ast.Ty], e: Ast.Expr, mut: Bool, rest: Coll.List[Ast.Stmt], last: Ast.Expr, want: Coll.Option[K.Term], acc: Coll.List[El.Stmt]): Ty.Ex =
  val Ty.Cx(_, _, _, _, _, _, _, _, _, arr, idx) = cx
  val wa: Coll.Option[K.Term] = ann match
    case Coll.None => Coll.None
    case Coll.Some(t) => Coll.Some(Ty.term(t, Ty.annIds(arr, t, bs)))
  val Ty.Ex(st1, te, ee) = Ty.expr(cx, st, bs, e, wa)
  val tx = wa match
    case Coll.None => te
    case Coll.Some(w) => w
  val Ty.Bound(st2, b) = Ty.bindVal(arr, st1, bs, x, tx, mut, e)
  val bs2 = if !mut && Ty.isNewArray(e) then Coll.Cons(Ty.Home(x), Coll.Cons(b, bs)) else Coll.Cons(b, bs)
  Ty.block(cx, st2, bs2, line, rest, last, want, Coll.Cons(El.Val(sl, x, tx, mut, ee), acc))

enum Ty.Bound:
  case Ty.Bound(st: Ty.St, b: Ty.Bind)

// A1: an immutable I64 val gets an identity: the one of the local it copies (val j = i: same value), else a fresh one,
// never inside a loop (Ty.Loop: one identity would be many values)
def Ty.annIds(arr: Names.Arrays, t: Ast.Ty, bs: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = arr match
  case Names.NoArrays => Coll.Nil
  case Names.UsesArrays => if Ty.hasVals(t) then Ty.idsOnly(bs, Coll.Nil, Coll.Nil) else Coll.Nil

def Ty.bindVal(arr: Names.Arrays, st: Ty.St, bs: Coll.List[Ty.Bind], x: Sym.Sym, tx: K.Term, mut: Bool, e: Ast.Expr): Ty.Bound = arr match
  case Names.NoArrays => Ty.Bound(st, Ty.Bind(x, tx))
  case Names.UsesArrays => Ty.bindValArr(st, bs, x, tx, mut, e)

def Ty.bindValArr(st: Ty.St, bs: Coll.List[Ty.Bind], x: Sym.Sym, tx: K.Term, mut: Bool, e: Ast.Expr): Ty.Bound =
  val isI64: Bool = K.walk(Ty.subst(st), tx) match
    case K.Con(n, args) => Coll.length(args) == 0 && Str.eq(Sym.str(n), "I64")
    case _ => false
  if mut || !isI64 then Ty.Bound(st, Ty.Bind(x, tx))
  else
    val alias: Coll.Option[I64] = e match
      case Ast.Name(_, y) => Ty.idOf(bs, y)
      case _ => Coll.None
    alias match
      case Coll.Some(id) => Ty.Bound(st, Ty.Val(x, tx, id))
      case Coll.None =>
        if Ty.inLoop(bs) then Ty.Bound(st, Ty.Bind(x, tx)) else Ty.Bound(Ty.stamped(st), Ty.Val(x, tx, Ty.nextId(st)))

def Ty.protoOf(hs: Coll.List[Ast.Handler], h: Sym.Sym): Sym.Sym = hs match
  case Coll.Nil => h
  case Coll.Cons(x, rest) =>
    val Ast.Handler(_, _, n, p, _, _, _) = x
    if Sym.eq(n, h) then p else Ty.protoOf(rest, h)

// ── a def: params and {} binders as locals, binders rigid, the body checked against the declared result ──
enum Ty.FnEx:
  case Ty.FnEx(st: Ty.St, f: El.Fn)

// row: the implicit capabilities (s2/eff.srs), outermost locals, C params after the written ones
def Ty.fn(cx0: Ty.Cx, st0: Ty.St, f: Ast.Fn, row: Coll.List[Eff.Cap]): Ty.FnEx =
  val Ast.Fn(_, line, name, gs, ps, ret, _, body) = f
  val cx = Ty.mainCx(cx0, name)
  val Ty.Cx(_, _, protos, _, _, _, _, _, _, arr, idx) = cx
  val tps = Ty.tparams(gs, Coll.Nil)
  // A1: each I64 param has an identity; the param types and the result name lengths by it
  val Ty.Ids(st0b, tv) = arr match
    case Names.NoArrays => Ty.Ids(st0, Ty.rigid(tps, Coll.Nil))
    case Names.UsesArrays => Ty.paramIds(st0, ps, Ty.rigid(tps, Coll.Nil))
  val ev = Ty.evidence(gs, Coll.Nil)
  val bs = Ty.binds(ps, tv, Ty.binds(ev, tv, Ty.rowBinds(row, Coll.Nil)))
  val rt = Ty.term(ret, tv)
  val caps = Coll.revOnto(Coll.rev(Ty.capNames(protos, ev, Coll.Nil)), Ty.rowNames(row))
  val eps = Ty.elParams(ps, tv, Coll.Nil)
  val st = Ty.fnShape(cx, st0b, line, tps, ps, ret)
  body match
    case Ast.Extern(abi) => Ty.FnEx(st, El.Fn(line, name, tps, caps, eps, rt, El.Extern(abi, Ty.ghostsFor(abi, ps))))
    case Ast.Def(_, e) =>
      val Ty.Ex(st1, _, eb) = Ty.expr(cx, st, bs, e, Coll.Some(rt))
      Ty.FnEx(Ty.mhPlace(st1, eb), El.Fn(line, name, tps, caps, eps, rt, El.Def(eb)))

// a user def named main runs as Ty.Main
def Ty.mainCx(cx: Ty.Cx, name: Sym.Sym): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, mode, imp, rows, vals, arr, idx) = cx
  mode match
    case Ty.Run(by) => by match
      case Ty.User =>
        if Str.eq(Sym.str(name), "main") then Ty.Cx(fns, es, ps, hs, trs, Ty.Run(Ty.Main), imp, rows, vals, arr, idx)
        else cx
      case Ty.Main => cx
      case Ty.Srs => cx
      case Ty.Given => cx
      case Ty.MultiOp(_, _, _) => cx
    case Ty.Comptime => cx

// a world capability is handled only in main, or where a binder already holds it (object capability: no ambient authority)
def Ty.ambient(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, h: Sym.Sym, p: Sym.Sym): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, _) = cx
  if !Ty.worldHandler(h) then st
  else mode match
    case Ty.Run(by) => by match
      case Ty.Main => st
      case Ty.User => Ty.held(st, bs, line, p)
      case Ty.Srs => Ty.held(st, bs, line, p)
      case Ty.Given => Ty.held(st, bs, line, p)
      case Ty.MultiOp(_, _, _) => Ty.held(st, bs, line, p)
    case Ty.Comptime => st

def Ty.held(st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, p: Sym.Sym): Ty.St = Ty.innermost(Ty.subst(st), bs, p) match
  case Coll.Some(_) => st
  case Coll.None => Ty.clash(st, Ty.AmbientWorld(line, p))

def Ty.worldHandler(h: Sym.Sym): Bool =
  val s = Sym.str(h)
  Str.eq(s, "Srs.Env") || Str.eq(s, "Srs.Files") || Str.eq(s, "Srs.Clock") || Str.eq(s, "Srs.Net") || Str.eq(s, "Srs.Pages")

def Ty.rowBinds(row: Coll.List[Eff.Cap], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = row match
  case Coll.Nil => acc
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, x) = c
    Ty.rowBinds(rest, Coll.Cons(Ty.Bind(x, K.Con(p, Coll.Nil)), acc))

def Ty.rowNames(row: Coll.List[Eff.Cap]): Coll.List[Sym.Sym] = row match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(c, rest) =>
    val Eff.Cap(_, x) = c
    Coll.Cons(x, Ty.rowNames(rest))

// the {} binders of a protocol type, in written order (leading C params)
def Ty.capNames(ps: Coll.List[Ast.Proto], ev: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ev match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Ty.capNames(ps, rest, if Ty.isProto(ps, n) then Coll.Cons(x, acc) else acc)

def Ty.elParams(ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[El.Param]): Coll.List[El.Param] = ps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, t) = p
    Ty.elParams(rest, tv, Coll.Cons(El.Param(x, Ty.term(t, tv)), acc))

def Ty.binds(ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, t) = p
    val tx = Ty.term(t, tv)
    val b: Ty.Bind = Ty.idOf(tv, x) match
      case Coll.Some(id) => Ty.Val(x, tx, id)
      case Coll.None => Ty.Bind(x, tx)
    Ty.binds(rest, tv, Ty.withHome(t, x, Coll.Cons(b, acc)))

// a param array with a stated region (xs: Array[A](n)<r>) takes data in a slot: Flow checks the value against that region
// (Flow.putAt, the stated-bound check), as for an array allocated in the fn (Ty.Home)
def Ty.withHome(t: Ast.Ty, x: Sym.Sym, bs: Coll.List[Ty.Bind]): Coll.List[Ty.Bind] =
  if Ty.isBoundedArray(t) then Coll.Cons(Ty.Home(x), bs) else bs

def Ty.isBoundedArray(t: Ast.Ty): Bool =
  val Ast.Ty(_, n, _, caps, _) = t
  caps match
    case Ast.Stated(_) => Str.eq(Sym.str(n), "Array")
    case _ => false

// A1: an identity for each I64 param, in tv (Ty.term names a length by it)
enum Ty.Ids:
  case Ty.Ids(st: Ty.St, tv: Coll.List[Ty.Bind])

def Ty.paramIds(st: Ty.St, ps: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind]): Ty.Ids = ps match
  case Coll.Nil => Ty.Ids(st, tv)
  case Coll.Cons(p, rest) =>
    val Ast.Binder(_, x, t) = p
    if Ty.isI64(t) then Ty.paramIds(Ty.stamped(st), rest, Coll.Cons(Ty.Val(x, Ty.con("I64"), Ty.nextId(st)), tv))
    else Ty.paramIds(st, rest, tv)

// a fresh identity is the next fresh var's number (one counter: unique in the program)
def Ty.nextId(st: Ty.St): I64 =
  val Ty.St(_, n, _, _, _, _) = st
  n

def Ty.stamped(st: Ty.St): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.St(s, n + 1, cs, is, gs, nm)

def Ty.isI64(t: Ast.Ty): Bool =
  val Ast.Ty(_, n, args, _, _) = t
  Coll.length(args) == 0 && Str.eq(Sym.str(n), "I64")

// the {} binders in written order, group after group (a call's chosen evidence names them by position)
def Ty.evidence(gs: Coll.List[Ast.Group], acc: Coll.List[Ast.Binder]): Coll.List[Ast.Binder] = gs match
  case Coll.Nil => acc
  case Coll.Cons(g, rest) => g match
    case Ast.Evidence(bs) => Ty.evidence(rest, Coll.revOnto(Coll.rev(acc), bs))
    case Ast.Types(_) => Ty.evidence(rest, acc)
    case Ast.Facts(_) => Ty.evidence(rest, acc)

// ── the program: every def and handler fn; then each instance must be solved ──
enum Ty.Result:
  case Ty.Result(clashes: Coll.List[Ty.Clash], insts: Coll.List[Ty.Inst], s: K.Subst, fns: Coll.List[El.Fn], hs: Coll.List[El.Handler], gvs: Coll.List[El.Given])

def Ty.cxOf(ds: Coll.List[Ast.Decl], fns: Coll.List[Ast.Fn], es: Coll.List[Ast.Enum], ps: Coll.List[Ast.Proto], hs: Coll.List[Ast.Handler], trs: Coll.List[Ast.Trait], vals: Coll.SMap[Bool], ts: Coll.SMap[Ast.TypeDecl]): Ty.Cx = ds match
  case Coll.Nil =>
    Ty.Cx(fns, es, ps, hs, trs, Ty.Run(Ty.User), Coll.sEmpty(), Eff.none(), vals, Names.NoArrays, Ty.idxOf(fns, es, ts))
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) => Ty.cxOf(rest, Coll.Cons(f, fns), es, ps, hs, trs, vals, ts)
    case Ast.DVal(f) =>
      val Ast.Fn(_, _, vn, _, _, _, _, _) = f
      Ty.cxOf(rest, Coll.Cons(f, fns), es, ps, hs, trs, Coll.sInsert(vals, vn, true), ts)
    case Ast.DEnum(e) => Ty.cxOf(rest, fns, Coll.Cons(e, es), ps, hs, trs, vals, ts)
    case Ast.DProto(p) => Ty.cxOf(rest, fns, es, Coll.Cons(p, ps), hs, trs, vals, ts)
    case Ast.DHandler(h) => Ty.cxOf(rest, fns, es, ps, Coll.Cons(h, hs), trs, vals, ts)
    case Ast.DTrait(t) => Ty.cxOf(rest, fns, es, ps, hs, Coll.Cons(t, trs), vals, ts)
    case Ast.DGiven(_) => Ty.cxOf(rest, fns, es, ps, hs, trs, vals, ts)
    case Ast.DType(td) =>
      val Ast.TypeDecl(_, _, tn, _, _, tb) = td
      tb match
        case Ast.CStruct(_) => Ty.cxOf(rest, fns, es, ps, hs, trs, vals, Coll.sInsert(ts, tn, td))
        case _ => Ty.cxOf(rest, fns, es, ps, hs, trs, vals, ts)

// the compiler's check: aliases expanded (Tl), effect rows, then types; the one entry for s2c and the tests
enum Ty.Typed:
  case Ty.TlBad(es: Coll.List[Tl.Err])
  case Ty.RowsBad(rel: Sym.Sym)
  case Ty.Checked(xds: Coll.List[Ast.Decl], rows: Eff.Rows, res: Ty.Result)

def Ty.typed(ds: Coll.List[Ast.Decl], arr: Names.Arrays): Ty.Typed =
  val Tl.W(xds, tes) = Tl.expand(ds)
  tes match
    case Coll.Cons(_, _) => Ty.TlBad(tes)
    case Coll.Nil => Eff.rows(xds) match
      case Eff.RulesBad(rel) => Ty.RowsBad(rel)
      case Eff.Got(rows) => Ty.Checked(xds, rows, Ty.checkWith(xds, Tl.typeGoals(ds), rows, arr))

// the fns with effects first (s2/pure.srs): a top-level val may call none of them
// tgs: the {} goals of the types the defs name (Tl.typeGoals), resolved with the goals of the calls; rows: Eff.rows(ds)
def Ty.checkWith(ds: Coll.List[Ast.Decl], tgs: Coll.List[Tl.Goal], rows: Eff.Rows, arr: Names.Arrays): Ty.Result =
  val Ty.Cx(fns0, es0, ps0, hs0, trs0, mode0, _, _, vals0, _, idx) =
    Ty.cxOf(ds, Coll.Nil, Coll.Nil, Coll.Nil, Coll.Nil, Coll.Nil, Coll.sEmpty(), Coll.sEmpty())
  val nom = Ty.nominals(ds, Coll.sEmpty())
  val pr = if Ty.hasVal(ds) then Pure.impure(ds, rows) else Pure.Got(Coll.sEmpty())
  val imp: Coll.SMap[Bool] = pr match
    case Pure.Got(m) => m
    case Pure.RulesBad(_) => Coll.sEmpty()
  val st0 = pr match
    case Pure.Got(_) => Ty.St(Coll.Tip, 0, Coll.Nil, Coll.Nil, Coll.Nil, nom)
    case Pure.RulesBad(rel) => Ty.St(Coll.Tip, 0, Coll.Cons(Ty.PureRules(rel), Coll.Nil), Coll.Nil, Coll.Nil, nom)
  val cx = Ty.Cx(fns0, es0, ps0, hs0, trs0, mode0, imp, rows, vals0, arr, idx)
  val Ty.Fns(st1, fs, hs, gvs) = Ty.decls(cx, st0, ds, Coll.Nil, Coll.Nil, Coll.Nil)
  val Ty.St(s, _, cs, is, gs, _) = st1
  val allGoals = Ty.typeGoals(fns0, tgs, Coll.rev(gs))
  val cs2 =
    Ty.externSlots(es0, Ty.externs(fns0, Coll.sEmpty()), s, is, Ty.goals(ps0, Ty.cands(ps0, ds, Coll.Nil), s, allGoals, cs))
  Ty.Result(Ty.unsolved(s, is, cs2), is, s, fs, hs, gvs)

// the elaborated defs, handlers and givens so far (reversed while walking)
enum Ty.Fns:
  case Ty.Fns(st: Ty.St, fs: Coll.List[El.Fn], hs: Coll.List[El.Handler], gvs: Coll.List[El.Given])

// top-level defs, handler fns (the prelude has Arena and Heap, lib/prelude.srs:38) and given fns
def Ty.decls(cx: Ty.Cx, st: Ty.St, ds: Coll.List[Ast.Decl], acc: Coll.List[El.Fn], hacc: Coll.List[El.Handler], gacc: Coll.List[El.Given]): Ty.Fns = ds match
  case Coll.Nil => Ty.Fns(st, Coll.rev(acc), Coll.rev(hacc), Coll.rev(gacc))
  case Coll.Cons(d, rest) => d match
    case Ast.DFn(f) =>
      val Ast.Fn(_, _, fname, _, _, _, _, _) = f
      val Ty.Cx(_, _, _, _, _, _, _, rows, _, _, idx) = cx
      val Ty.FnEx(st1, ef) = Ty.fn(Ty.byHandler(cx, fname), st, f, Eff.row(rows, fname))
      Ty.decls(cx, st1, rest, Coll.Cons(ef, acc), hacc, gacc)
    // a top-level val is checked as a compile-time body (no row: only Region, the compiler's); no C (vic 2026-11-09)
    case Ast.DVal(f) =>
      val Ty.FnEx(st1, _) = Ty.fn(Ty.comptime(cx), st, f, Coll.Nil)
      Ty.decls(cx, st1, rest, acc, hacc, gacc)
    // every fn of a handler takes the handler's row (E1b): the capabilities its handle site keeps
    case Ast.DHandler(h) =>
      val Ast.Handler(_, hl, hn, p, fs, shots, _) = h
      val Ty.Cx(_, _, ps, _, _, _, _, rows, _, _, idx) = cx
      shots match
        case Ast.OneShot =>
          val Ty.Fns(st1, efs, _, _) = Ty.fnsEl(Ty.byHandler(cx, hn), st, fs, Eff.row(rows, hn), Coll.Nil)
          Ty.decls(cx, Ty.opSig(ps, Ty.stateOk(Ty.esOf(cx), Ty.opRets(ps, st1, p, fs), fs), p, fs), rest, acc, Coll.Cons(El.Handler(hn, p, efs, shots), hacc), gacc)
        // multi-shot (vic-hm63): typed here; its C (selective CPS) is a later rung, so it stops at this phase for now
        case Ast.MultiShot(a, ks) =>
          val ans = Ty.answerOf(fs, a)
          val Ty.Fns(st2, efs, _, _) = Ty.multiFns(cx, st, hn, p, ans, ks, fs, Eff.row(rows, hn), Coll.Nil)
          Ty.decls(cx, st2, rest, acc, Coll.Cons(El.Handler(hn, p, efs, shots), hacc), gacc)
    // a given's fns see its binders: its [] binders are theirs, its {} evidence is local
    case Ast.DGiven(g) =>
      val Ast.Given(_, _, gs, head, fs) = g
      val Ast.Ty(_, tn, _, _, _) = head
      val Ty.Fns(st1, efs, _, _) =
        Ty.givenFns(Ty.byGiven(cx), Ty.givenShape(cx, st, g), tn, Ty.underGroups(gs, fs, Coll.Nil), Coll.Nil)
      val gv =
        El.Given(Ty.tparams(gs, Coll.Nil), Ty.binderNames(Ty.evidence(gs, Coll.Nil), Coll.Nil), Ty.term(head, Coll.Nil), efs)
      Ty.decls(cx, st1, rest, acc, hacc, Coll.Cons(gv, gacc))
    case Ast.DProto(pr) =>
      val Ast.Proto(_, _, _, _, _, _, _, pops, _) = pr
      val Ty.Cx(_, _, cps, _, _, _, _, _, _, _, _) = cx
      Ty.decls(cx, Ty.opBinders(cps, st, pops), rest, acc, hacc, gacc)
    case Ast.DEnum(e) =>
      val Ast.Enum(_, _, _, _, cases) = e
      Ty.decls(cx, Ty.erasedFields(cx, st, cases), rest, acc, hacc, gacc)
    case _ => Ty.decls(cx, st, rest, acc, hacc, gacc)

def Ty.underGroups(gs: Coll.List[Ast.Group], fs: Coll.List[Ast.Fn], acc: Coll.List[Ast.Fn]): Coll.List[Ast.Fn] = fs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, line, name, fgs, ps, ret, exit, body) = f
    Ty.underGroups(gs, rest, Coll.Cons(Ast.Fn(Ast.NoDoc, line, name, Coll.revOnto(Coll.rev(gs), fgs), ps, ret, exit, body), acc))

def Ty.binderNames(bs: Coll.List[Ast.Binder], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, _) = b
    Ty.binderNames(rest, Coll.Cons(x, acc))

// handler state: the type init returns, S, is what every op takes as self. The handle site keeps it as a void* (srs_env st),
// so S is pointer-shaped (Ptr, Array, Cell or an enum: a scalar or a Str would be cut or converted), and every op of the
// handler takes the same S (else an op reads the state as another type)
def Ty.esOf(cx: Ty.Cx): Coll.List[Ast.Enum] =
  val Ty.Cx(_, es, _, _, _, _, _, _, _, _, _) = cx
  es

def Ty.stateOk(es: Coll.List[Ast.Enum], st: Ty.St, fs: Coll.List[Ast.Fn]): Ty.St = Ty.initFn(fs) match
  case Coll.None => st
  case Coll.Some(i) =>
    val Ast.Fn(_, line, _, _, _, sty, _, _) = i
    val Ast.Ty(_, sn, _, _, _) = sty
    val st1 = if Ty.stateShaped(es, sn) then st else Ty.clash(st, Ty.StateShape(line, sn))
    Ty.selfAgree(sty, st1, fs)

def Ty.initFn(fs: Coll.List[Ast.Fn]): Coll.Option[Ast.Fn] = fs match
  case Coll.Nil => Coll.None
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, _, n, _, _, _, _, _) = f
    if Str.eq(Sym.str(n), "init") then Coll.Some(f) else Ty.initFn(rest)

def Ty.stateShaped(es: Coll.List[Ast.Enum], n: Sym.Sym): Bool =
  val s = Sym.str(n)
  Str.eq(s, "Ptr") || Str.eq(s, "Array") || Str.eq(s, "Cell") || Str.eq(s, "ACell") || Ty.isEnum(es, n)

def Ty.selfAgree(sty: Ast.Ty, st: Ty.St, fs: Coll.List[Ast.Fn]): Ty.St = fs match
  case Coll.Nil => st
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, line, n, _, ps, _, _, _) = f
    val ok: Bool =
      if Str.eq(Sym.str(n), "init") then true
      else ps match
        case Coll.Nil => true
        case Coll.Cons(p, _) =>
          val Ast.Binder(_, _, pt) = p
          Ty.sameTy(sty, pt)
    Ty.selfAgree(sty, if ok then st else Ty.clash(st, Ty.StateType(line, n)), rest)

// the same type by name and arguments (lengths and region lists are not part of the state's shape)
def Ty.sameTy(a: Ast.Ty, b: Ast.Ty): Bool =
  val Ast.Ty(_, an, aa, _, _) = a
  val Ast.Ty(_, bn, ba, _, _) = b
  Sym.eq(an, bn) && Ty.sameTys(aa, ba)

def Ty.sameTys(xs: Coll.List[Ast.Ty], ys: Coll.List[Ast.Ty]): Bool = xs match
  case Coll.Nil => ys match
    case Coll.Nil => true
    case Coll.Cons(_, _) => false
  case Coll.Cons(x, xr) => ys match
    case Coll.Nil => false
    case Coll.Cons(y, yr) => Ty.sameTy(x, y) && Ty.sameTys(xr, yr)

// 3e: a handler fn declares the {} binders its op declares: the first k, same protocols in order (more are its row)
def Ty.opSig(ps: Coll.List[Ast.Proto], st: Ty.St, p: Sym.Sym, fs: Coll.List[Ast.Fn]): Ty.St = fs match
  case Coll.Nil => st
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, line, n, fgs, fps, _, _, _) = f
    val st1: Ty.St = Ty.protoOp(ps, p, n) match
      case Coll.None => st
      case Coll.Some(o) =>
        val Ast.Op(_, _, _, ogs, ops, _, _) = o
        if Ty.protoPrefix(Ty.evidence(ogs, Coll.Nil), Ty.evidence(fgs, Coll.Nil)) then
          Ty.opParams(st, line, ops, Ty.afterSelf(fps))
        else Ty.clash(st, Ty.OpSig(line, n))
    Ty.opSig(ps, st1, p, rest)

// a handler fn's params after its first, self (the parser gives a stateless handler's fns one too)
def Ty.afterSelf(fps: Coll.List[Ast.Binder]): Coll.List[Ast.Binder] = fps match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(_, rest) => rest

// a handler fn's value params after self have the op's types, pairwise (a Mismatch at the fn's line); the count is
// Names' error[handler-arity]. Without this a handler body read its op's args under types of its own choosing
def Ty.opParams(st: Ty.St, line: I64, ops: Coll.List[Ast.Binder], fps: Coll.List[Ast.Binder]): Ty.St = ops match
  case Coll.Nil => st
  case Coll.Cons(o, orest) => fps match
    case Coll.Nil => st
    case Coll.Cons(fp, frest) =>
      val Ast.Binder(_, _, ot) = o
      val Ast.Binder(_, _, ft) = fp
      Ty.opParams(Ty.expect(st, line, Ty.term(ft, Coll.Nil), Ty.term(ot, Coll.Nil)), line, orest, frest)

// the op's binders are a prefix of the fn's by protocol
def Ty.protoPrefix(op: Coll.List[Ast.Binder], fn: Coll.List[Ast.Binder]): Bool = op match
  case Coll.Nil => true
  case Coll.Cons(a, arest) => fn match
    case Coll.Nil => false
    case Coll.Cons(b, brest) =>
      val Ast.Binder(_, _, at) = a
      val Ast.Ty(_, an, _, _, _) = at
      val Ast.Binder(_, _, bt) = b
      val Ast.Ty(_, bn, _, _, _) = bt
      Sym.eq(an, bn) && Ty.protoPrefix(arest, brest)

// 3e: every {} binder of an op is a capability protocol (the caller's capability it takes per call)
def Ty.opBinders(ps: Coll.List[Ast.Proto], st: Ty.St, os: Coll.List[Ast.Op]): Ty.St = os match
  case Coll.Nil => st
  case Coll.Cons(o, rest) =>
    val Ast.Op(_, line, n, ogs, _, _, _) = o
    Ty.opBinders(ps, if Ty.allProtos(ps, Ty.evidence(ogs, Coll.Nil)) then st else Ty.clash(st, Ty.OpBinder(line, n)), rest)

def Ty.allProtos(ps: Coll.List[Ast.Proto], bs: Coll.List[Ast.Binder]): Bool = bs match
  case Coll.Nil => true
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, pn, _, _, _) = t
    Ty.isProto(ps, pn) && Ty.allProtos(ps, rest)

// a one-shot handler fn returns its op's result type: the op's decl is what the caller gets (Ty.fn checked the body
// against the fn's own result). a fn for an op T{self} may return T's body: it makes the T (its facts are the op's)
def Ty.opRets(ps: Coll.List[Ast.Proto], st: Ty.St, p: Sym.Sym, fs: Coll.List[Ast.Fn]): Ty.St = fs match
  case Coll.Nil => st
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, line, n, _, _, ret, _, _) = f
    val st1: Ty.St = Ty.protoOp(ps, p, n) match
      case Coll.None => st
      case Coll.Some(o) =>
        val Ast.Op(_, _, _, _, _, oret, _) = o
        Ty.expect(st, line, Ty.term(ret, Coll.Nil), Ty.opWant(st, oret))
    Ty.opRets(ps, st1, p, rest)

// the result type a handler fn must give for an op that returns t. An op T{self} also takes T's body type: sound
// because Flow.checkHandler lets that result live in no capability the fn body names (row caps, opened caps, its own
// binders), so a body-typed result can only live in the handler's own state = self, and self outlives every T{self}
// a caller holds. Narrow it once a handler fn can build a T{self} itself (follow-up bead)
def Ty.opWant(st: Ty.St, t: Ast.Ty): K.Term =
  val Ast.Ty(_, _, _, caps, _) = t
  val Ty.St(_, _, _, _, _, nm) = st
  val w = Ty.term(t, Coll.Nil)
  caps match
    case Ast.Chosen(_) => Ty.widen(nm, w) match
      case Coll.Some(b) => b
      case Coll.None => w
    case _ => w

// fns of a handler or given, elaborated in order, each with row
def Ty.fnsEl(cx: Ty.Cx, st: Ty.St, fs: Coll.List[Ast.Fn], row: Coll.List[Eff.Cap], acc: Coll.List[El.Fn]): Ty.Fns = fs match
  case Coll.Nil => Ty.Fns(st, Coll.rev(acc), Coll.Nil, Coll.Nil)
  case Coll.Cons(f, rest) =>
    val Ty.FnEx(st1, ef) = Ty.fn(cx, st, f, row)
    Ty.fnsEl(cx, st1, rest, row, Coll.Cons(ef, acc))

// an instance with a type arg that is still a var after the whole program: CannotInfer
def Ty.unsolved(s: K.Subst, is: Coll.List[Ty.Inst], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = is match
  case Coll.Nil => cs
  case Coll.Cons(i, rest) =>
    val Ty.Inst(line, f, ts) = i
    if Ty.ground(s, ts) then Ty.unsolved(s, rest, cs) else Ty.unsolved(s, rest, Coll.Cons(Ty.CannotInfer(line, f), cs))

def Ty.ground(s: K.Subst, ts: Coll.List[K.Term]): Bool = ts match
  case Coll.Nil => true
  case Coll.Cons(t, rest) => if Ty.groundT(K.reify(s, t)) then Ty.ground(s, rest) else false

def Ty.groundT(t: K.Term): Bool = t match
  case K.Var(_) => false
  case K.Int(_) => true
  case K.Con(_, args) => Ty.groundAll(args)

def Ty.groundAll(ts: Coll.List[K.Term]): Bool = ts match
  case Coll.Nil => true
  case Coll.Cons(t, rest) => if Ty.groundT(t) then Ty.groundAll(rest) else false

def Ty.unTy(op: Ast.UnOp): Str = op match
  case Ast.Neg => "I64"
  case Ast.Not => "Bool"
  // not read: Ty.ints1 types ~ by its operand (U32 or U64)
  case Ast.BitNot => "U32"

def Ty.lineOf(e: Ast.Expr): I64 = e match
  case Ast.Int(l, _) => l
  case Ast.Bool(l, _) => l
  case Ast.Str(l, _) => l
  case Ast.Unit(l) => l
  case Ast.Name(l, _) => l
  case Ast.Call(l, _, _, _, _) => l
  case Ast.Method(l, _, _, _) => l
  case Ast.Resume(l, _, _) => l
  case Ast.Bin(l, _, _, _) => l
  case Ast.Un(l, _, _) => l
  case Ast.If(_, l, _, _, _) => l
  case Ast.Match(_, l, _, _) => l
  case Ast.Block(_, l, _, _) => l
  case Ast.While(l, _, _) => l
  case Ast.Assign(l, _, _) => l
  case Ast.Quant(l, _, _, _, _) => l

// the fns of a handler named Srs.*, and the top-level defs named Srs.*, run as Ty.Srs: the runtime's own bodies, the only callers of rt_*
def Ty.byHandler(cx: Ty.Cx, h: Sym.Sym): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, _, imp, rows, vals, arr, idx) = cx
  val s = Sym.str(h)
  val by: Ty.By = if Str.len(s) > 4 && Str.eq(Str.slice(s, 0, 4), "Srs.") then Ty.Srs else Ty.User
  Ty.Cx(fns, es, ps, hs, trs, Ty.Run(by), imp, rows, vals, arr, idx)

// ── the shape a multi-shot handle compiles today (vic-hm63 C3, interim error[multishot-shape]): in the rest of its
// block, an op of its capability p only as the whole value of a val or a statement; no call of a fn whose row holds p ──
// a multi-shot handler: its block type binder and its answer type (done's result, else the binder)
enum Ty.MA:
  case Ty.MA(a: Sym.Sym, ans: Ast.Ty)

def Ty.multiOf(hs: Coll.List[Ast.Handler], h: Sym.Sym): Coll.Option[Ty.MA] = hs match
  case Coll.Nil => Coll.None
  case Coll.Cons(x, rest) =>
    val Ast.Handler(_, _, n, _, fs, shots, _) = x
    val here: Coll.Option[Ty.MA] = shots match
      case Ast.OneShot => Coll.None
      case Ast.MultiShot(a, _) => Coll.Some(Ty.MA(a, Ty.answerOf(fs, a)))
    if Sym.eq(n, h) then here else Ty.multiOf(rest, h)

def Ty.isMultiShot(hs: Coll.List[Ast.Handler], h: Sym.Sym): Bool = hs match
  case Coll.Nil => false
  case Coll.Cons(x, rest) =>
    val Ast.Handler(_, _, n, _, _, shots, _) = x
    val multi: Bool = shots match
      case Ast.OneShot => false
      case Ast.MultiShot(_, _) => true
    if Sym.eq(n, h) then multi else Ty.isMultiShot(rest, h)

def Ty.shape(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, ss: Coll.List[Ast.Stmt], last: Ast.Expr): Ty.St = ss match
  case Coll.Nil => Ty.shapeTop(cx, st, x, p, last)
  case Coll.Cons(s, rest) =>
    val st1 = s match
      case Ast.Val(_, _, _, _, e) => Ty.shapeTop(cx, st, x, p, e)
      case Ast.Do(_, e) => Ty.shapeTop(cx, st, x, p, e)
      case Ast.Var(_, _, _, _, e) => Ty.shapeIn(cx, st, x, p, e)
      case Ast.Handle(_, _, _, _, xs) => Ty.shapeAll(cx, st, x, p, xs)
      case Ast.Check(_, _, _, e) => Ty.shapeIn(cx, st, x, p, e)
    Ty.shape(cx, st1, x, p, rest, last)

// a whole op of p is allowed (its args are not); anything else must not use p
def Ty.shapeTop(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, e: Ast.Expr): Ty.St = e match
  case Ast.Method(_, recv, _, xs) =>
    if Sym.eq(recv, x) then Ty.shapeAll(cx, st, x, p, xs) else Ty.shapeIn(cx, st, x, p, e)
  case Ast.Call(_, f, _, _, xs) =>
    val Ty.Cx(_, _, _, _, _, _, _, rows, _, _, idx) = cx
    if Ty.isReqOf(cx, f, p) then Ty.shapeAll(cx, st, x, p, xs)
    // a fn whose row holds p (C3.4): compiled in CPS for this site (its body: Ty.shapeFns)
    else if Eff.has(rows, f, p) then Ty.shapeAll(cx, st, x, p, xs)
    else Ty.shapeIn(cx, st, x, p, e)
  // an if whose arms hold cuts (nested ops): each arm is a chain of its own, joined after the if
  case Ast.If(_, _, c, t, f) => Ty.shapeArm(cx, Ty.shapeArm(cx, Ty.shapeIn(cx, st, x, p, c), x, p, t), x, p, f)
  case _ => Ty.shapeIn(cx, st, x, p, e)

// an arm: a block with cuts as whole top-level vals, statements or last, or one whole cut
def Ty.shapeArm(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, e: Ast.Expr): Ty.St = e match
  case Ast.Block(_, _, ss, last) => Ty.shape(cx, st, x, p, ss, last)
  case _ => Ty.shapeTop(cx, st, x, p, e)

// the CPS fns a multi-shot site reaches (C3.4): each body has the site's shape (ops of p and CPS calls only as whole
// top-level vals or statements); todo: fns to check, seen: checked (recursion ends)
def Ty.shapeFns(cx: Ty.Cx, st: Ty.St, p: Sym.Sym, todo: Coll.List[Sym.Sym], seen: Coll.List[Sym.Sym]): Ty.St = todo match
  case Coll.Nil => st
  case Coll.Cons(f, rest) =>
    if Ty.memberSym(f, seen) then Ty.shapeFns(cx, st, p, rest, seen)
    else
      val Ty.Cx(fns, _, _, _, _, _, _, _, _, _, idx) = cx
      Ty.fnOf(cx, f) match
        case Coll.None => Ty.shapeFns(cx, st, p, rest, Coll.Cons(f, seen))
        case Coll.Some(g) =>
          val Ast.Fn(_, _, _, _, _, _, _, body) = g
          val k = Eff.dotted("eff", p)
          val st1 = body match
            case Ast.Extern(_) => st
            case Ast.Def(_, e) => e match
              case Ast.Block(_, _, ss, last) => Ty.shape(cx, st, k, p, ss, last)
              case _ => Ty.shapeTop(cx, st, k, p, e)
          Ty.shapeFns(cx, st1, p, Ty.cpsCallsB(cx, p, body, rest), Coll.Cons(f, seen))

// the CPS fns called as whole top-level vals or statements of ss
def Ty.cpsCalls(cx: Ty.Cx, p: Sym.Sym, ss: Coll.List[Ast.Stmt], acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = ss match
  case Coll.Nil => acc
  case Coll.Cons(s, rest) =>
    val e: Ast.Expr = s match
      case Ast.Val(_, _, _, _, x) => x
      case Ast.Do(_, x) => x
      case _ => Ast.Unit(0)
    Ty.cpsCalls(cx, p, rest, Ty.cpsCallsE(cx, p, e, acc))

def Ty.cpsCallsB(cx: Ty.Cx, p: Sym.Sym, b: Ast.Body, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = b match
  case Ast.Def(_, e) => Ty.cpsCallsE(cx, p, e, acc)
  case Ast.Extern(_) => acc

// the CPS fns e calls in a cut position: whole, the arms of an if, a block's statements and last (bead vic-tecg: last too)
def Ty.cpsCallsE(cx: Ty.Cx, p: Sym.Sym, e: Ast.Expr, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = e match
  case Ast.Call(_, f, _, _, _) =>
    val Ty.Cx(_, _, _, _, _, _, _, rows, _, _, idx) = cx
    if Eff.has(rows, f, p) && !Ty.isReqOf(cx, f, p) then Coll.Cons(f, acc) else acc
  case Ast.If(_, _, _, t, f) => Ty.cpsCallsE(cx, p, f, Ty.cpsCallsE(cx, p, t, acc))
  case Ast.Block(_, _, ss, last) => Ty.cpsCallsE(cx, p, last, Ty.cpsCalls(cx, p, ss, acc))
  case _ => acc

def Ty.isReqOf(cx: Ty.Cx, f: Sym.Sym, p: Sym.Sym): Bool =
  val Ty.Cx(_, _, ps, _, _, _, _, _, _, _, idx) = cx
  Eff.reqOf(ps, f) match
    case Coll.Some(q) =>
      val Eff.Req(qp, _) = q
      Sym.eq(qp, p)
    case Coll.None => false

def Ty.shapeAll(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, es: Coll.List[Ast.Expr]): Ty.St = es match
  case Coll.Nil => st
  case Coll.Cons(e, rest) => Ty.shapeAll(cx, Ty.shapeIn(cx, st, x, p, e), x, p, rest)

// e nested in an expression: an op of p, or a call whose row holds p, is a clash at its line
def Ty.shapeIn(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, e: Ast.Expr): Ty.St = e match
  case Ast.Method(line, recv, _, xs) =>
    Ty.shapeAll(cx, if Sym.eq(recv, x) then Ty.clash(st, Ty.MultishotShape(line, p)) else st, x, p, xs)
  case Ast.Call(line, f, _, _, xs) =>
    val Ty.Cx(_, _, _, _, _, _, _, rows, _, _, idx) = cx
    val bad = Ty.isReqOf(cx, f, p) || Eff.has(rows, f, p)
    Ty.shapeAll(cx, if bad then Ty.clash(st, Ty.MultishotShape(line, p)) else st, x, p, xs)
  case Ast.Resume(_, _, a) => Ty.shapeIn(cx, st, x, p, a)
  case Ast.Bin(_, _, l, r) => Ty.shapeIn(cx, Ty.shapeIn(cx, st, x, p, l), x, p, r)
  case Ast.Un(_, _, a) => Ty.shapeIn(cx, st, x, p, a)
  case Ast.If(_, _, c, t, f) => Ty.shapeAll(cx, st, x, p, Coll.Cons(c, Coll.Cons(t, Coll.Cons(f, Coll.Nil))))
  case Ast.Match(_, _, s, arms) => Ty.shapeArms(cx, Ty.shapeIn(cx, st, x, p, s), x, p, arms)
  case Ast.Block(_, _, ss, l) => Ty.shapeBlock(cx, st, x, p, ss, l)
  case Ast.While(_, c, b) => Ty.shapeIn(cx, Ty.shapeIn(cx, st, x, p, c), x, p, b)
  case Ast.Assign(_, _, a) => Ty.shapeIn(cx, st, x, p, a)
  case Ast.Quant(_, _, _, _, a) => Ty.shapeIn(cx, st, x, p, a)
  case _ => st

def Ty.shapeArms(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, as: Coll.List[Ast.Arm]): Ty.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, _, b) = a
    Ty.shapeArms(cx, Ty.shapeIn(cx, st, x, p, b), x, p, rest)

// a nested block: every statement nested (no top level there)
def Ty.shapeBlock(cx: Ty.Cx, st: Ty.St, x: Sym.Sym, p: Sym.Sym, ss: Coll.List[Ast.Stmt], last: Ast.Expr): Ty.St = ss match
  case Coll.Nil => Ty.shapeIn(cx, st, x, p, last)
  case Coll.Cons(s, rest) =>
    val st1 = s match
      case Ast.Val(_, _, _, _, e) => Ty.shapeIn(cx, st, x, p, e)
      case Ast.Var(_, _, _, _, e) => Ty.shapeIn(cx, st, x, p, e)
      case Ast.Do(_, e) => Ty.shapeIn(cx, st, x, p, e)
      case Ast.Handle(_, _, _, _, xs) => Ty.shapeAll(cx, st, x, p, xs)
      case Ast.Check(_, _, _, e) => Ty.shapeIn(cx, st, x, p, e)
    Ty.shapeBlock(cx, st1, x, p, rest, last)

// the answer type R of a multi-shot handler: the result of its done fn, else its block type A (vic-hm63 Q-M3)
def Ty.answerOf(fs: Coll.List[Ast.Fn], a: Sym.Sym): Ast.Ty = Ty.fnNamed(fs, Sym.of("done")) match
  case Coll.Some(d) =>
    val Ast.Fn(_, _, _, _, _, ret, _, _) = d
    ret
  case Coll.None => Ast.Ty(0, a, Coll.Nil, Ast.Inferred, Coll.Nil)

// the fns of a multi-shot handler: an op with k runs as Ty.MultiOp (resume k(v): v the op's declared result, the
// resume the answer R) and returns R; done takes the block type A; the rest as a plain handler fn
def Ty.multiFns(cx: Ty.Cx, st: Ty.St, hn: Sym.Sym, p: Sym.Sym, ans: Ast.Ty, ks: Coll.List[Ast.KOp], fs: Coll.List[Ast.Fn], row: Coll.List[Eff.Cap], acc: Coll.List[El.Fn]): Ty.Fns = fs match
  case Coll.Nil => Ty.Fns(st, Coll.rev(acc), Coll.Nil, Coll.Nil)
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, line, n, _, _, ret, _, _) = f
    val Ty.Cx(_, _, ps, _, _, _, _, _, _, _, idx) = cx
    val rt = Ty.term(ans, Coll.Nil)
    val fx: Ty.FnEx = Ast.kOf(ks, n) match
      case Coll.None => Ty.fn(Ty.byHandler(cx, hn), st, f, row)
      case Coll.Some(k) =>
        val v = Ty.opResult(ps, p, n)
        val sa = if Mono.termEq(Ty.term(ret, Coll.Nil), rt) then st else Ty.clash(st, Ty.AnswerType(line, n))
        Ty.fn(Ty.byMulti(cx, k, v, rt), sa, f, row)
    val Ty.FnEx(st1, ef) = fx
    Ty.multiFns(cx, st1, hn, p, ans, ks, rest, row, Coll.Cons(ef, acc))

// the declared result of op n of capability p (what resume k(v) takes)
def Ty.opResult(ps: Coll.List[Ast.Proto], p: Sym.Sym, n: Sym.Sym): K.Term = Ty.protoOp(ps, p, n) match
  case Coll.Some(o) =>
    val Ast.Op(_, _, _, _, _, oret, _) = o
    Ty.term(oret, Coll.Nil)
  case Coll.None => Ty.con("Unit")

// where a multi-shot handle compiles today (vic-hm63 C3.3 slice 1): as the last of a fn's body block, its rest opens
// no handle and holds no other multi-shot handle; elsewhere error[multishot-shape]
def Ty.mhPlace(st: Ty.St, e: El.Expr): Ty.St = e match
  case El.MHandled(_, _, _, _, args, rest, _, _) => Ty.mhRest(Ty.mhNone(st, args), rest)
  case El.Block(_, ss, last) => last match
    case El.MHandled(_, _, _, _, args, rest, _, _) => Ty.mhRest(Ty.mhNone(Ty.mhStmts(st, ss), args), rest)
    case _ => Ty.mhNone(Ty.mhStmts(st, ss), Coll.Cons(last, Coll.Nil))
  case _ => Ty.mhNone(st, Coll.Cons(e, Coll.Nil))

def Ty.mhRest(st: Ty.St, rest: El.Expr): Ty.St = rest match
  case El.Block(_, ss, last) => Ty.mhNone(Ty.mhNoHandle(Ty.mhStmts(st, ss), ss), Coll.Cons(last, Coll.Nil))
  case _ => Ty.mhNone(st, Coll.Cons(rest, Coll.Nil))

def Ty.mhNoHandle(st: Ty.St, ss: Coll.List[El.Stmt]): Ty.St = ss match
  case Coll.Nil => st
  case Coll.Cons(s, rest) => s match
    case El.Handle(line, _, h, _, _) => Ty.mhNoHandle(Ty.clash(st, Ty.MultishotShape(line, h)), rest)
    case _ => Ty.mhNoHandle(st, rest)

def Ty.mhStmts(st: Ty.St, ss: Coll.List[El.Stmt]): Ty.St = ss match
  case Coll.Nil => st
  case Coll.Cons(s, rest) => s match
    case El.Val(_, _, _, _, e) => Ty.mhStmts(Ty.mhNone(st, Coll.Cons(e, Coll.Nil)), rest)
    case El.Handle(_, _, _, _, xs) => Ty.mhStmts(Ty.mhNone(st, xs), rest)
    case El.Do(e) => Ty.mhStmts(Ty.mhNone(st, Coll.Cons(e, Coll.Nil)), rest)

// no multi-shot handle anywhere in es
def Ty.mhNone(st: Ty.St, es: Coll.List[El.Expr]): Ty.St = es match
  case Coll.Nil => st
  case Coll.Cons(e, rest) =>
    val st1 = e match
      case El.MHandled(line, _, h, _, _, _, _, _) => Ty.clash(st, Ty.MultishotShape(line, h))
      case El.CallFn(_, _, _, _, xs) => Ty.mhNone(st, xs)
      case El.New(_, _, _, _, _, xs) => Ty.mhNone(st, xs)
      case El.Op(_, _, _, _, xs, _) => Ty.mhNone(st, xs)
      case El.TCall(_, _, _, _, xs) => Ty.mhNone(st, xs)
      case El.Resume(_, _, x) => Ty.mhNone(st, Coll.Cons(x, Coll.Nil))
      case El.Bin(_, _, l, r) => Ty.mhNone(st, Coll.Cons(l, Coll.Cons(r, Coll.Nil)))
      case El.Un(_, _, x) => Ty.mhNone(st, Coll.Cons(x, Coll.Nil))
      case El.If(_, c, t, f) => Ty.mhNone(st, Coll.Cons(c, Coll.Cons(t, Coll.Cons(f, Coll.Nil))))
      case El.Match(_, s, _, arms) => Ty.mhArms(Ty.mhNone(st, Coll.Cons(s, Coll.Nil)), arms)
      case El.Block(_, ss, l) => Ty.mhNone(Ty.mhStmts(st, ss), Coll.Cons(l, Coll.Nil))
      case El.While(_, c, b) => Ty.mhNone(st, Coll.Cons(c, Coll.Cons(b, Coll.Nil)))
      case El.Assign(_, _, x) => Ty.mhNone(st, Coll.Cons(x, Coll.Nil))
      case El.Index(_, _, i) => Ty.mhNone(st, Coll.Cons(i, Coll.Nil))
      case El.Slice(_, x, o) => Ty.mhNone(st, Coll.Cons(x, Coll.Cons(o, Coll.Nil)))
      case El.Fill(_, _, n, x, _) => Ty.mhNone(st, Coll.Cons(n, Coll.Cons(x, Coll.Nil)))
      case El.Tab(_, _, n, _, _, g) => Ty.mhNone(st, Coll.Cons(n, Coll.Cons(g, Coll.Nil)))
      case El.CellNew(_, _, v, _) => Ty.mhNone(st, Coll.Cons(v, Coll.Nil))
      case El.CellGet(_, c) => Ty.mhNone(st, Coll.Cons(c, Coll.Nil))
      case El.CNew(_, _, _) => Ty.mhNone(st, Coll.Nil)
      case El.CField(_, c, _, _, _) => Ty.mhNone(st, Coll.Cons(c, Coll.Nil))
      case El.CellPut(_, c, v, _) => Ty.mhNone(st, Coll.Cons(c, Coll.Cons(v, Coll.Nil)))
      case El.ArrPut(_, _, i, v) => Ty.mhNone(st, Coll.Cons(i, Coll.Cons(v, Coll.Nil)))
      case El.AtomLoad(_, c) => Ty.mhNone(st, Coll.Cons(c, Coll.Nil))
      case El.AtomStore(_, c, v) => Ty.mhNone(st, Coll.Cons(c, Coll.Cons(v, Coll.Nil)))
      case El.AtomCas(_, c, w, v) => Ty.mhNone(st, Coll.Cons(c, Coll.Cons(w, Coll.Cons(v, Coll.Nil))))
      case El.AtomAdd(_, c, d) => Ty.mhNone(st, Coll.Cons(c, Coll.Cons(d, Coll.Nil)))
      case _ => st
    Ty.mhNone(st1, rest)

def Ty.mhArms(st: Ty.St, as: Coll.List[El.Arm]): Ty.St = as match
  case Coll.Nil => st
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    Ty.mhArms(Ty.mhNone(st, Coll.Cons(b, Coll.Nil)), rest)

def Ty.byMulti(cx: Ty.Cx, k: Sym.Sym, v: K.Term, ans: K.Term): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, _, imp, rows, vals, arr, idx) = cx
  Ty.Cx(fns, es, ps, hs, trs, Ty.Run(Ty.MultiOp(k, v, ans)), imp, rows, vals, arr, idx)

// resume k(x): only the op's own k; x against v; the value is the answer
def Ty.resume(cx: Ty.Cx, st: Ty.St, bs: Coll.List[Ty.Bind], line: I64, k: Sym.Sym, x: Ast.Expr, want: Coll.Option[K.Term]): Ty.Ex =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, idx) = cx
  val kva: Coll.Option[Ty.KVA] = mode match
    case Ty.Run(by) => by match
      case Ty.MultiOp(k2, v, ans) => if Sym.eq(k, k2) then Coll.Some(Ty.KVA(v, ans)) else Coll.None
      case _ => Coll.None
    case Ty.Comptime => Coll.None
  kva match
    case Coll.None => Ty.bad(Ty.args(cx, Ty.clash(st, Ty.ResumeNotK(line, k)), bs, Coll.Cons(x, Coll.Nil)), line)
    case Coll.Some(t) =>
      val Ty.KVA(v, ans) = t
      val Ty.Ex(st1, _, ex) = Ty.expr(cx, st, bs, x, Coll.Some(v))
      Ty.lit(st1, line, ans, want, El.Resume(line, k, ex))

enum Ty.KVA:
  case Ty.KVA(v: K.Term, ans: K.Term)

def Ty.byGiven(cx: Ty.Cx): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, _, imp, rows, vals, arr, idx) = cx
  Ty.Cx(fns, es, ps, hs, trs, Ty.Run(Ty.Given), imp, rows, vals, arr, idx)

// the fns of a given of trait tn: each one's row is its trait method's {} capabilities (vic Q2; inferred, never written)
def Ty.givenFns(cx: Ty.Cx, st: Ty.St, tn: Sym.Sym, fs: Coll.List[Ast.Fn], acc: Coll.List[El.Fn]): Ty.Fns = fs match
  case Coll.Nil => Ty.Fns(st, Coll.rev(acc), Coll.Nil, Coll.Nil)
  case Coll.Cons(f, rest) =>
    val Ty.Cx(_, _, ps, _, trs, _, _, _, _, _, idx) = cx
    val Ast.Fn(_, _, n, _, _, _, _, _) = f
    val Ty.FnEx(st1, ef) = Ty.fn(cx, st, f, Ty.methodCaps(ps, trs, tn, n))
    Ty.givenFns(cx, st1, tn, rest, Coll.Cons(ef, acc))

// the capabilities trait method tn.op declares: its {} binders of a protocol, in written order (none: not a method)
def Ty.methodCaps(ps: Coll.List[Ast.Proto], trs: Coll.List[Ast.Trait], tn: Sym.Sym, op: Sym.Sym): Coll.List[Eff.Cap] = Ty.traitMethod(trs, tn, op) match
  case Coll.None => Coll.Nil
  case Coll.Some(tm) =>
    val Ty.TM(_, m) = tm
    val Ast.Fn(_, _, _, gs, _, _, _, _) = m
    Ty.protoCaps(ps, Ty.evidence(gs, Coll.Nil), Coll.Nil)

def Ty.protoCaps(ps: Coll.List[Ast.Proto], bs: Coll.List[Ast.Binder], acc: Coll.List[Eff.Cap]): Coll.List[Eff.Cap] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, x, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Ty.protoCaps(ps, rest, if Ty.isProto(ps, n) then Coll.Cons(Eff.Cap(n, x), acc) else acc)

// a call of an rt_* or libc extern anywhere but a Srs.* handler body
def Ty.rtCall(cx: Ty.Cx, st: Ty.St, line: I64, g: Ast.Fn): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, idx) = cx
  val Ast.Fn(_, _, n, _, _, _, _, body) = g
  val s = Sym.str(n)
  val rt: Bool = body match
    case Ast.Extern(_) => Str.len(s) > 3 && Str.eq(Str.slice(s, 0, 3), "rt_")
    case _ => false
  val libc: Bool = body match
    case Ast.Extern(abi) => abi match
      case Ast.AbiLibc => true
      case Ast.AbiLibcVar => true
      case Ast.AbiSrs => false
      case Ast.AbiLibcVal => false
      case Ast.AbiLibcPre => true
    case _ => false
  mode match
    case Ty.Run(by) => by match
      case Ty.Srs => st
      case _ => Ty.outsideSrs(st, line, n, rt, libc)
    case Ty.Comptime => Ty.outsideSrs(st, line, n, rt, libc)

def Ty.outsideSrs(st: Ty.St, line: I64, n: Sym.Sym, rt: Bool, libc: Bool): Ty.St =
  if rt then Ty.clash(st, Ty.RtOutsideSrs(line, n))
  else if libc then Ty.clash(st, Ty.LibcOutsideHandler(line, n))
  else st

// a callee's row as this body passes it: at compile time the compiler owns Region (vic Q-U4), so no capability for it
def Ty.runRow(cx: Ty.Cx, cs: Coll.List[Eff.Cap]): Coll.List[Eff.Cap] =
  val Ty.Cx(_, _, _, _, _, mode, _, _, _, _, idx) = cx
  mode match
    case Ty.Comptime => Ty.notRegion(cs)
    case Ty.Run(_) => cs

def Ty.notRegion(cs: Coll.List[Eff.Cap]): Coll.List[Eff.Cap] = cs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(c, rest) =>
    val Eff.Cap(p, _) = c
    if Str.eq(Sym.str(p), "Region") then Ty.notRegion(rest) else Coll.Cons(c, Ty.notRegion(rest))

// run-time code may not name a top-level val yet (its C static data is a later rung)
def Ty.valCall(cx: Ty.Cx, st: Ty.St, line: I64, f: Sym.Sym): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, _, _, vals, _, idx) = cx
  mode match
    case Ty.Comptime => st
    case Ty.Run(_) => Coll.sLookup(vals, f) match
      case Coll.Some(_) => Ty.clash(st, Ty.ValAtRunTime(line, f))
      case Coll.None => st

def Ty.comptime(cx: Ty.Cx): Ty.Cx =
  val Ty.Cx(fns, es, ps, hs, trs, _, imp, rows, vals, arr, idx) = cx
  Ty.Cx(fns, es, ps, hs, trs, Ty.Comptime, imp, rows, vals, arr, idx)

// in a compile-time body (vic Q-U4) a call of a fn with effects, and any handle, is a clash
def Ty.pureCall(cx: Ty.Cx, st: Ty.St, line: I64, f: Sym.Sym): Ty.St =
  val Ty.Cx(_, _, _, _, _, mode, imp, _, _, _, idx) = cx
  mode match
    case Ty.Run(_) => st
    case Ty.Comptime => if Pure.has(imp, f) then Ty.clash(st, Ty.Impure(line, f)) else st

def Ty.pureHandle(mode: Ty.Mode, st: Ty.St, line: I64, h: Sym.Sym): Ty.St = mode match
  case Ty.Run(_) => st
  case Ty.Comptime => Ty.clash(st, Ty.ComptimeHandle(line, h))

// ── a match covers every case of its enum, or has a `_` arm: the first case no arm names ──
def Ty.missingCase(cx: Ty.Cx, as: Coll.List[Ast.Arm]): Coll.Option[Sym.Sym] =
  if Ty.hasAny(as) then Coll.None
  else Ty.firstCase(as) match
    case Coll.None => Coll.None
    case Coll.Some(c) => Ty.caseOf(cx, c) match
      case Coll.None => Coll.None
      case Coll.Some(co) =>
        val Ty.CaseOf(e, _) = co
        val Ast.Enum(_, _, _, _, cases) = e
        Ty.uncovered(cases, as)

def Ty.hasAny(as: Coll.List[Ast.Arm]): Bool = as match
  case Coll.Nil => false
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, p, _) = a
    p match
      case Ast.PAny => true
      case Ast.PCase(_, _) => Ty.hasAny(rest)

def Ty.firstCase(as: Coll.List[Ast.Arm]): Coll.Option[Sym.Sym] = as match
  case Coll.Nil => Coll.None
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, p, _) = a
    p match
      case Ast.PCase(c, _) => Coll.Some(c)
      case Ast.PAny => Ty.firstCase(rest)

def Ty.uncovered(cs: Coll.List[Ast.Case], as: Coll.List[Ast.Arm]): Coll.Option[Sym.Sym] = cs match
  case Coll.Nil => Coll.None
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, n, _) = c
    if Ty.armNames(n, as) then Ty.uncovered(rest, as) else Coll.Some(n)

def Ty.armNames(n: Sym.Sym, as: Coll.List[Ast.Arm]): Bool = as match
  case Coll.Nil => false
  case Coll.Cons(a, rest) =>
    val Ast.Arm(_, _, p, _) = a
    p match
      case Ast.PCase(c, _) => if Sym.eq(c, n) then true else Ty.armNames(n, rest)
      case Ast.PAny => Ty.armNames(n, rest)

def Ty.addGoal(st: Ty.St, g: Ty.Goal): Ty.St =
  val Ty.St(s, n, cs, is, gs, nm) = st
  Ty.St(s, n, cs, is, Coll.Cons(g, gs), nm)

// ── trait goals (s1/given.srs): local evidence first, else the givens whose head matches, each with its own {} goals
// proved (fuel per step); the most specific head wins, on a draw the one with fewer {} binders (Scala3) ──
enum Ty.Cand:
  case Ty.Cand(id: I64, tps: Coll.List[Sym.Sym], head: K.Term, evs: Coll.List[K.Term])

// a given's [] binders as rigid names in its head and in its {} goals of traits
def Ty.cands(ps: Coll.List[Ast.Proto], ds: Coll.List[Ast.Decl], acc: Coll.List[Ty.Cand]): Coll.List[Ty.Cand] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, rest) => d match
    case Ast.DGiven(g) =>
      val Ast.Given(_, _, gs, head, _) = g
      val tps = Ty.tparams(gs, Coll.Nil)
      val tv = Ty.rigid(tps, Coll.Nil)
      Ty.cands(ps, rest, Coll.Cons(Ty.Cand(Coll.length(acc), tps, Ty.term(head, tv), Ty.traitGoals(ps, Ty.evidence(gs, Coll.Nil), tv, Coll.Nil)), acc))
    case _ => Ty.cands(ps, rest, acc)

def Ty.traitGoals(ps: Coll.List[Ast.Proto], bs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    Ty.traitGoals(ps, rest, tv, if Ty.isProto(ps, n) then acc else Coll.Cons(Ty.term(t, tv), acc))

enum Ty.Res:
  case Ty.Proved
  case Ty.NoneFound
  case Ty.Tie
  case Ty.TwoLocals
  case Ty.OutOfFuel

def Ty.givenFuel(): I64 = 1000

// every goal of the program, with the final substitution; a goal that is not ground has a CannotInfer already
def Ty.goals(ps: Coll.List[Ast.Proto], cands: Coll.List[Ty.Cand], s: K.Subst, gs: Coll.List[Ty.Goal], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = gs match
  case Coll.Nil => cs
  case Coll.Cons(g, rest) =>
    val Ty.Goal(line, t0, locals, chosen) = g
    val t = K.reify(s, t0)
    if !Ty.groundT(t) then Ty.goals(ps, cands, s, rest, cs)
    else if Ty.isProtoT(ps, t) then
      Ty.goals(ps, cands, s, rest, if Coll.length(Ty.localsOf(s, locals, t, Coll.Nil)) == 1 then cs else Coll.Cons(Ty.NoCap(line, Ty.headOf(t)), cs))
    else chosen match
      case Coll.Some(x) =>
        Ty.goals(ps, cands, s, rest, if Ty.localProves(s, locals, x, t) then cs else Coll.Cons(Ty.ChosenBad(line, t), cs))
      case Coll.None =>
        Ty.goals(ps, cands, s, rest, Ty.resClash(line, t, Ty.resolve(cands, s, locals, t, Ty.givenFuel()), cs))

def Ty.resClash(line: I64, t: K.Term, res: Ty.Res, cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = res match
  case Ty.Proved => cs
  case Ty.NoneFound => Coll.Cons(Ty.NoGiven(line, t), cs)
  case Ty.Tie => Coll.Cons(Ty.AmbigGivens(line, t), cs)
  case Ty.TwoLocals => Coll.Cons(Ty.AmbigEvidence(line, t), cs)
  case Ty.OutOfFuel => Coll.Cons(Ty.GivenFuel(line, t), cs)

def Ty.localProves(s: K.Subst, locals: Coll.List[Ty.Bind], x: Sym.Sym, t: K.Term): Bool = Ty.lookup(locals, x) match
  case Coll.Some(u) => Mono.termEq(K.reify(s, u), t)
  case Coll.None => false

def Ty.resolve(cands: Coll.List[Ty.Cand], s: K.Subst, locals: Coll.List[Ty.Bind], t: K.Term, fuel: I64): Ty.Res =
  if fuel <= 0 then Ty.OutOfFuel
  else
    val n = Coll.length(Ty.localsOf(s, locals, t, Coll.Nil))
    if n > 1 then Ty.TwoLocals
    else if n == 1 then Ty.Proved
    else Ty.viable(cands, cands, s, locals, t, fuel, Coll.Nil) match
      case Ty.Viable(vs) => Ty.best(vs, vs)
      case Ty.ViableFuel => Ty.OutOfFuel

// the distinct local names whose type is t (a shadowed name counts once)
def Ty.localsOf(s: K.Subst, bs: Coll.List[Ty.Bind], t: K.Term, acc: Coll.List[Sym.Sym]): Coll.List[Sym.Sym] = bs match
  case Coll.Nil => acc
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(x, u) =>
      if !Ty.memberSym(x, acc) && Mono.termEq(K.reify(s, u), t) then Ty.localsOf(s, rest, t, Coll.Cons(x, acc))
      else Ty.localsOf(s, rest, t, acc)
    // an I64 local is no evidence
    case _ => Ty.localsOf(s, rest, t, acc)

enum Ty.Vs:
  case Ty.Viable(cs: Coll.List[Ty.Cand])
  case Ty.ViableFuel

// the givens whose head matches t and whose own goals are proved
def Ty.viable(all: Coll.List[Ty.Cand], cs: Coll.List[Ty.Cand], s: K.Subst, locals: Coll.List[Ty.Bind], t: K.Term, fuel: I64, acc: Coll.List[Ty.Cand]): Ty.Vs = cs match
  case Coll.Nil => Ty.Viable(Coll.rev(acc))
  case Coll.Cons(c, rest) =>
    val Ty.Cand(_, tps, head, evs) = c
    Mono.matchT(tps, head, t, Coll.Some(Coll.Nil)) match
      case Coll.None => Ty.viable(all, rest, s, locals, t, fuel, acc)
      case Coll.Some(sub) => Ty.allProved(all, s, locals, Mono.applyAll(sub, evs, Coll.Nil), fuel - 1) match
        case Ty.Proved => Ty.viable(all, rest, s, locals, t, fuel, Coll.Cons(c, acc))
        case Ty.OutOfFuel => Ty.ViableFuel
        case _ => Ty.viable(all, rest, s, locals, t, fuel, acc)

def Ty.allProved(all: Coll.List[Ty.Cand], s: K.Subst, locals: Coll.List[Ty.Bind], gs: Coll.List[K.Term], fuel: I64): Ty.Res = gs match
  case Coll.Nil => Ty.Proved
  case Coll.Cons(g, rest) => Ty.resolve(all, s, locals, g, fuel) match
    case Ty.Proved => Ty.allProved(all, s, locals, rest, fuel)
    case Ty.NoneFound => Ty.NoneFound
    case Ty.Tie => Ty.Tie
    case Ty.TwoLocals => Ty.TwoLocals
    case Ty.OutOfFuel => Ty.OutOfFuel

// the one candidate better than every other one, else a tie (none: NoneFound)
def Ty.best(vs: Coll.List[Ty.Cand], all: Coll.List[Ty.Cand]): Ty.Res = vs match
  case Coll.Nil => if Coll.length(all) == 0 then Ty.NoneFound else Ty.Tie
  case Coll.Cons(c, rest) => if Ty.beatsAll(c, all) then Ty.Proved else Ty.best(rest, all)

def Ty.beatsAll(c: Ty.Cand, all: Coll.List[Ty.Cand]): Bool = all match
  case Coll.Nil => true
  case Coll.Cons(d, rest) => if Ty.sameCand(c, d) || Ty.better(c, d) then Ty.beatsAll(c, rest) else false

// the same given decl (two decls with one head are two candidates: a tie)
def Ty.sameCand(a: Ty.Cand, b: Ty.Cand): Bool =
  val Ty.Cand(i, _, _, _) = a
  val Ty.Cand(j, _, _, _) = b
  i == j

def Ty.better(a: Ty.Cand, b: Ty.Cand): Bool =
  val Ty.Cand(_, atps, ah, aev) = a
  val Ty.Cand(_, btps, bh, bev) = b
  val ab = Mono.isSome(Mono.matchT(btps, bh, ah, Coll.Some(Coll.Nil)))
  val ba = Mono.isSome(Mono.matchT(atps, ah, bh, Coll.Some(Coll.Nil)))
  if ab && !ba then true
  else if ab && ba then Coll.length(aev) < Coll.length(bev)
  else false

// ── shapes (s1/check.srs, s1/given.srs): what a use of a name, a def's binders and a given must look like ──
// evidence is only a method receiver, a capability only a {} arg: neither is a value
def Ty.nameUse(cx: Ty.Cx, st: Ty.St, line: I64, x: Sym.Sym, t: K.Term): Ty.St =
  val Ty.Cx(_, _, ps, _, trs, _, _, _, _, _, idx) = cx
  K.walk(Ty.subst(st), t) match
    case K.Con(n, _) =>
      if Ty.isProto(ps, n) then Ty.clash(st, Ty.CapValue(line, x))
      else if Ty.isTrait(trs, n) then Ty.clash(st, Ty.EvidenceValue(line, x))
      else st
    case _ => st

def Ty.isTrait(trs: Coll.List[Ast.Trait], n: Sym.Sym): Bool = trs match
  case Coll.Nil => false
  case Coll.Cons(t, rest) =>
    val Ast.Trait(_, _, m, _, _) = t
    if Sym.eq(m, n) then true else Ty.isTrait(rest, n)

def Ty.isEnum(es: Coll.List[Ast.Enum], n: Sym.Sym): Bool = es match
  case Coll.Nil => false
  case Coll.Cons(e, rest) =>
    val Ast.Enum(_, _, m, _, _) = e
    if Sym.eq(m, n) then true else Ty.isEnum(rest, n)

def Ty.isBuiltin(n: Sym.Sym): Bool =
  val s = Sym.str(n)
  Str.eq(s, "I64") || Str.eq(s, "Bool") || Str.eq(s, "Str") || Str.eq(s, "Unit") || Str.eq(s, "Ptr") || Str.eq(s, "Type") || Str.eq(s, "U32") || Str.eq(s, "U64") || Str.eq(s, "U8") || Str.eq(s, "I32") || Str.eq(s, "CStr") || Str.eq(s, "CArgv") || Str.eq(s, "F64")

// x is a local whose type is protocol p
def Ty.isCapOf(s: K.Subst, bs: Coll.List[Ty.Bind], x: Sym.Sym, p: Sym.Sym): Bool = Ty.lookup(bs, x) match
  case Coll.None => false
  case Coll.Some(t) => K.walk(s, t) match
    case K.Con(n, args) => Sym.eq(n, p) && Coll.length(args) == 0
    case _ => false

// a [] binder may not hide a type; a capability is a {} binder, never a value param, and erased (vic 2026-11-09): no
// result type names one
def Ty.fnShape(cx: Ty.Cx, st: Ty.St, line: I64, tps: Coll.List[Sym.Sym], ps: Coll.List[Ast.Binder], ret: Ast.Ty): Ty.St =
  Ty.erased(cx, Ty.capParams(cx, Ty.hides(cx, st, line, tps), ps), ret)

// a value type that names a capability, at any depth: error[capability-erased]
def Ty.erased(cx: Ty.Cx, st: Ty.St, t: Ast.Ty): Ty.St =
  val Ast.Ty(line, n, args, _, _) = t
  val Ty.Cx(_, _, protos, _, _, _, _, _, _, _, idx) = cx
  Ty.erasedAll(cx, if Ty.isProto(protos, n) then Ty.clash(st, Ty.CapErased(line, n)) else st, args)

def Ty.erasedAll(cx: Ty.Cx, st: Ty.St, ts: Coll.List[Ast.Ty]): Ty.St = ts match
  case Coll.Nil => st
  case Coll.Cons(t, rest) => Ty.erasedAll(cx, Ty.erased(cx, st, t), rest)

def Ty.erasedFields(cx: Ty.Cx, st: Ty.St, cs: Coll.List[Ast.Case]): Ty.St = cs match
  case Coll.Nil => st
  case Coll.Cons(c, rest) =>
    val Ast.Case(_, _, _, fs) = c
    Ty.erasedFields(cx, Ty.erasedAll(cx, st, Ty.binderTys(fs)), rest)

def Ty.binderTys(bs: Coll.List[Ast.Binder]): Coll.List[Ast.Ty] = bs match
  case Coll.Nil => Coll.Nil
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    Coll.Cons(t, Ty.binderTys(rest))

def Ty.hides(cx: Ty.Cx, st: Ty.St, line: I64, tps: Coll.List[Sym.Sym]): Ty.St = tps match
  case Coll.Nil => st
  case Coll.Cons(x, rest) =>
    val Ty.Cx(_, es, ps, _, trs, _, _, _, _, _, idx) = cx
    val known = Ty.isBuiltin(x) || Ty.isEnum(es, x) || Ty.isProto(ps, x) || Ty.isTrait(trs, x)
    Ty.hides(cx, if known then Ty.clash(st, Ty.BinderHides(line, x)) else st, line, rest)

def Ty.capParams(cx: Ty.Cx, st: Ty.St, ps: Coll.List[Ast.Binder]): Ty.St = ps match
  case Coll.Nil => st
  case Coll.Cons(b, rest) =>
    val Ast.Binder(line, x, t) = b
    val Ast.Ty(_, n, _, _, _) = t
    val Ty.Cx(_, _, protos, _, _, _, _, _, _, _, idx) = cx
    Ty.capParams(cx, if Ty.isProto(protos, n) then Ty.clash(st, Ty.CapParam(line, x)) else st, rest)

// a given: its head names a trait with that many args; its fns are exactly the trait's methods, each with the trait's
// signature at the head's args; each [] binder occurs in the head
def Ty.givenShape(cx: Ty.Cx, st: Ty.St, g: Ast.Given): Ty.St =
  val Ast.Given(_, line, gs, head, fs) = g
  val Ast.Ty(_, tn, targs, _, _) = head
  val Ty.Cx(_, _, _, _, trs, _, _, _, _, _, idx) = cx
  val st1 = Ty.inHead(st, line, Ty.tparams(gs, Coll.Nil), head)
  Ty.traitNamed(trs, tn) match
    case Coll.None => Ty.clash(st1, Ty.NotTrait(line, tn))
    case Coll.Some(tr) =>
      val Ast.Trait(_, _, _, tgs, sigs) = tr
      val ttps = Ty.tparams(tgs, Coll.Nil)
      if Coll.length(ttps) != Coll.length(targs) then Ty.clash(st1, Ty.TraitArity(line, tn))
      else
        val tps = Ty.tparams(gs, Coll.Nil)
        val tv = Ty.rigid(tps, Coll.Nil)
        val sub = Ty.zipBind(ttps, Ty.terms(targs, tv, Coll.Nil), Coll.Nil)
        Ty.missing(sigs, fs, line, Ty.methods(sigs, fs, sub, tv, st1))

def Ty.traitNamed(trs: Coll.List[Ast.Trait], n: Sym.Sym): Coll.Option[Ast.Trait] = trs match
  case Coll.Nil => Coll.None
  case Coll.Cons(t, rest) =>
    val Ast.Trait(_, _, m, _, _) = t
    if Sym.eq(m, n) then Coll.Some(t) else Ty.traitNamed(rest, n)

def Ty.inHead(st: Ty.St, line: I64, tps: Coll.List[Sym.Sym], head: Ast.Ty): Ty.St = tps match
  case Coll.Nil => st
  case Coll.Cons(x, rest) =>
    Ty.inHead(if Ty.occurs(x, head) then st else Ty.clash(st, Ty.NotInHead(line, x)), line, rest, head)

def Ty.occurs(x: Sym.Sym, t: Ast.Ty): Bool =
  val Ast.Ty(_, n, args, _, _) = t
  if Sym.eq(x, n) then true else Ty.occursAll(x, args)

def Ty.occursAll(x: Sym.Sym, ts: Coll.List[Ast.Ty]): Bool = ts match
  case Coll.Nil => false
  case Coll.Cons(t, rest) => if Ty.occurs(x, t) then true else Ty.occursAll(x, rest)

// each fn of the given: a method of the trait, with its signature (params and result at the head's args)
def Ty.methods(sigs: Coll.List[Ast.Fn], fs: Coll.List[Ast.Fn], sub: Coll.List[Ty.Bind], tv: Coll.List[Ty.Bind], st: Ty.St): Ty.St = fs match
  case Coll.Nil => st
  case Coll.Cons(f, rest) =>
    val Ast.Fn(_, line, n, _, ps, ret, _, _) = f
    val st1 = Ty.fnNamed(sigs, n) match
      case Coll.None => Ty.clash(st, Ty.NotMethod(line, n))
      case Coll.Some(m) =>
        val Ast.Fn(_, _, _, _, mps, mret, _, _) = m
        val same =
          Mono.termEq(Ty.term(ret, tv), Ty.term(mret, sub)) && Mono.termsEq(Ty.binderTerms(ps, tv, Coll.Nil), Ty.binderTerms(mps, sub, Coll.Nil))
        if same then st else Ty.clash(st, Ty.SigDiffers(line, n))
    Ty.methods(sigs, rest, sub, tv, st1)

def Ty.binderTerms(bs: Coll.List[Ast.Binder], tv: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = bs match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(b, rest) =>
    val Ast.Binder(_, _, t) = b
    Ty.binderTerms(rest, tv, Coll.Cons(Ty.term(t, tv), acc))

def Ty.missing(sigs: Coll.List[Ast.Fn], fs: Coll.List[Ast.Fn], line: I64, st: Ty.St): Ty.St = sigs match
  case Coll.Nil => st
  case Coll.Cons(m, rest) =>
    val Ast.Fn(_, _, n, _, _, _, _, _) = m
    val st1 = Ty.fnNamed(fs, n) match
      case Coll.Some(_) => st
      case Coll.None => Ty.clash(st, Ty.MissingMethod(line, n))
    Ty.missing(rest, fs, line, st1)

// a generic extern's [] slots are void*: each type arg it is called at must be a pointer (an enum or Ptr)
def Ty.externSlots(es: Coll.List[Ast.Enum], ext: Coll.SMap[Bool], s: K.Subst, is: Coll.List[Ty.Inst], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = is match
  case Coll.Nil => cs
  case Coll.Cons(i, rest) =>
    val Ty.Inst(line, f, ts) = i
    Ty.externSlots(es, ext, s, rest, if Pure.has(ext, f) then Ty.ptrSlots(es, s, line, ts, cs) else cs)

// the generic externs, by name
def Ty.externs(fs: Coll.List[Ast.Fn], m: Coll.SMap[Bool]): Coll.SMap[Bool] = fs match
  case Coll.Nil => m
  case Coll.Cons(g, rest) =>
    val Ast.Fn(_, _, n, _, _, _, _, body) = g
    val m2 = body match
      case Ast.Extern(_) => Coll.sInsert(m, n, true)
      case _ => m
    Ty.externs(rest, m2)

def Ty.ptrSlots(es: Coll.List[Ast.Enum], s: K.Subst, line: I64, ts: Coll.List[K.Term], cs: Coll.List[Ty.Clash]): Coll.List[Ty.Clash] = ts match
  case Coll.Nil => cs
  case Coll.Cons(t0, rest) =>
    val t = K.reify(s, t0)
    val ok: Bool = t match
      case K.Con(n, _) => Ty.isEnum(es, n) || Str.eq(Sym.str(n), "Ptr")
      case _ => true
    Ty.ptrSlots(es, s, line, rest, if ok then cs else Coll.Cons(Ty.ExternSlot(line, t), cs))

// the impure set is read only in compile-time bodies: a program without a top-level val needs none
def Ty.hasVal(ds: Coll.List[Ast.Decl]): Bool = ds match
  case Coll.Nil => false
  case Coll.Cons(d, rest) => d match
    case Ast.DVal(_) => true
    case _ => Ty.hasVal(rest)

// a protocol goal (a type's {f: File} binder) is a capability in scope, not a given
def Ty.isProtoT(ps: Coll.List[Ast.Proto], t: K.Term): Bool = t match
  case K.Con(n, _) => Ty.isProto(ps, n)
  case _ => false

def Ty.headOf(t: K.Term): Sym.Sym = t match
  case K.Con(n, _) => n
  case _ => Sym.of("?")

// each type goal under its def's binders: [] rigid, {} the locals that may prove it
def Ty.typeGoals(fns: Coll.List[Ast.Fn], tgs: Coll.List[Tl.Goal], acc: Coll.List[Ty.Goal]): Coll.List[Ty.Goal] = tgs match
  case Coll.Nil => acc
  case Coll.Cons(g, rest) =>
    val Tl.Goal(line, f, goal) = g
    Ty.fnNamed(fns, f) match
      case Coll.None => Ty.typeGoals(fns, rest, acc)
      case Coll.Some(fd) =>
        val Ast.Fn(_, _, _, gs, _, _, _, _) = fd
        val tv = Ty.rigid(Ty.tparams(gs, Coll.Nil), Coll.Nil)
        Ty.typeGoals(fns, rest, Coll.Cons(Ty.Goal(line, Ty.term(goal, tv), Ty.binds(Ty.evidence(gs, Coll.Nil), tv, Coll.Nil), Coll.None), acc))
