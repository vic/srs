// format: off
// G3: a libc extern whose result is Unit has a void prototype: cfmakeraw(struct termios*) of <termios.h> returns void, so
// the C compile passes (an int64_t result is "conflicting types")
extern "libc" struct termios:
  c_lflag: U32
extern "libc" def cfmakeraw(t: termios): Unit
// format: on
def main(): I64 = 0
