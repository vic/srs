// G1: the libc headers declare struct timespec and clock_gettime (<time.h>), struct pollfd and poll (<poll.h>): each
// field and prototype is checked against them, so the C compile passes only with those headers
extern "libc" struct timespec:
  tv_sec: I64
  tv_nsec: I64
extern "libc" struct pollfd:
  fd: I32
extern "libc" def clock_gettime(id: I32, ts: timespec): I32
extern "libc" def poll(fds: pollfd, n: U64, ms: I32): I32
def main(): I64 = 0
