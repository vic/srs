// format: off
// expect: error[cell-seal]
// a Cell of region data written while an inner Arena is open (here the value comes from the caller: the rule is by
// place, it does not track the value)
def CS.fill(c: Cell[Str], s: Str): Unit =
  handle q = Srs.Arena()
  Cell.put(c, s)
def main(): I64 =
  handle m = Srs.Mut()
  handle r = Srs.Arena()
  val c = Cell.new("x")
  CS.fill(c, "y")
  0
