// format: off
// expect: error[unhandled-effect]
// a handler whose ops request Console needs a Console handler outside its handle
capability Out:
  state Live
  start Live
  stop Live
  def put(n: I64): Unit

handler Std for Out:
  def put(n: I64): Unit = Console.printI64(n)

def main(): I64 =
  handle s = Std()
  Out.put(1)
  0
