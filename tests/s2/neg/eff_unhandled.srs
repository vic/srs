// format: off
// expect: error[unhandled-effect]
capability Log:
  state Live
  start Live
  stop Live
  def say(n: I64): Unit

handler Out for Log:
  def say(n: I64): Unit = Console.printI64(n)

enum Box:
  case Box(v: I64)

def tell(n: I64): Unit = Log.say(n)

// main must have the empty row: a call that needs Log, a request before its handler, a constructor with no Region
def main(): I64 =
  tell(1)
  Log.say(2)
  handle o = Out()
  val Box(v) = Box(3)
  Log.say(v)
  0
// expect: --> tests/s2/neg/eff_unhandled.srs:19
// expect: --> tests/s2/neg/eff_unhandled.srs:20
// expect: --> tests/s2/neg/eff_unhandled.srs:22
