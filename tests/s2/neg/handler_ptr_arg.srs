// expect: error[use-after-free]
// a handler op Ptr^<self> may return its arg: a request P.op(q) keeps q's region, as c.op(q) does
capability Pool:
  state Open, Shut
  start Open
  stop Shut
  def keep <Open> (q: Ptr): Ptr^<self> <Open>
  def shut <Open> (): Unit <Shut>
  drop shut

handler HPool for Pool:
  def keep(q: Ptr): Ptr = q
  def shut(): Unit = ()

def peek(p: Ptr): I64 = 7

def main(): I64 =
  handle p = HPool()
  handle a = Srs.Arena()
  val x = Pool.keep(a.alloc(8))
  a.free()
  val n = peek(x)
  p.shut()
  n
// expect: 'a'
// expect: --> tests/s2/neg/handler_ptr_arg.srs:22
