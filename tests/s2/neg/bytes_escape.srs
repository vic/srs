// expect: error[region-escape]
// the Str of Str.ofBytes lives where its bytes live: it must not leave the block that closes their region
def leak(): Str =
  handle r = Srs.Arena()
  val n = 2
  val xs: Array[U8](n) = Array.fill(n, U8.of(65))
  Str.ofBytes(n, xs)
def main(): I64 = Str.len(leak())
// expect: --> tests/s2/neg/bytes_escape.srs:4
