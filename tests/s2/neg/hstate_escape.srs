// format: off
// expect: error[region-escape]
// the state lives in the Region of the handle site (init builds it there): an op that returns it hands out memory of b, which the block closes
enum Hx.St:
  case Hx.St.Mk(n: I64, xs: Array[I64](n))

capability Hx:
  def snap(): Hx.St

handler Hhx for Hx:
  def init(): Hx.St =
    val n = 3
    Hx.St.Mk(n, Array.fill(n, 0))
  def snap(self: Hx.St): Hx.St = self

def main(): I64 =
  handle m = Srs.Mut()
  handle a = Srs.Arena()
  val s: Hx.St =
    handle b = Srs.Arena()
    handle t = Hhx()
    Hx.snap()
  s match
    case Hx.St.Mk(n, xs) => n
// expect: --> tests/s2/neg/hstate_escape.srs:20
