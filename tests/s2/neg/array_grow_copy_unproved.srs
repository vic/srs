// format: off
// expect: error[index-unproved]
// the copy loop proves i < n for xs but writes ys of length m: i < m is not proved
def G.copy(n: I64, xs: Array[I64](n), m: I64, ys: Array[I64](m), i: I64): Unit =
  if 0 <= i && i < n then
    Array.put(ys, i, xs(i))
    G.copy(n, xs, m, ys, i + 1)
  else ()
def main(): I64 = 0
