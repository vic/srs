capability Pa:
  def put(x: I64): I64

handler Hpa for Pa:
  def put(x: I64, y: I64): I64 = x + y

def main(): I64 =
  handle io = Srs.Console()
  handle h = Hpa()
  Console.printI64(Pa.put(3))
  0
