// format: off
// expect: error[unhandled-effect]
// Rr.go needs a Region (its inferred row): main has the Hrg capability but no Region handler, so the error is at the call (Rr.go needs Region)
capability Rg:
  def mk {r: Region} (n: I64): Str<r>

handler Hrg for Rg:
  def mk {r: Region} (n: I64): Str<r> =
    val xs: Array[U8](n) = Array.fill(n, U8.of(65))
    Str.ofBytes(n, xs)

def Rr.go(n: I64): Str = Rg.mk(n)

def main(): I64 =
  handle io = Srs.Console()
  handle h = Hrg()
  Console.print(Rr.go(3))
  0
// expect: --> tests/s2/neg/op_region_row_noregion.srs:17
