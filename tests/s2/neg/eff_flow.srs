// expect: error[op-not-allowed]
// a request is an op on the innermost capability of its protocol: Flow checks its state as for d.shut()
capability Door:
  state Open, Shut
  start Open
  stop Shut
  def shut <Open> (): Unit <Shut>

handler Hinge for Door:
  def shut(): Unit = ()

def main(): I64 =
  handle d = Hinge()
  Door.shut()
  Door.shut()
  0
