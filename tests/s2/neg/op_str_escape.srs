// expect: error[region-escape]
// an op result of type Str that names no capability may be bytes the handler fn put in the Region its handle site keeps (here b)
capability Os1:
  def name(): Str

handler Hos for Os1:
  def name(): Str =
    val n = 3
    val xs: Array[U8](n) = Array.fill(n, U8.of(65))
    Str.ofBytes(n, xs)

def main(): I64 =
  handle io = Srs.Console()
  handle a = Srs.Arena()
  val s: Str =
    handle b = Srs.Arena()
    handle h = Hos()
    Os1.name()
  Console.print(s)
  0
// expect: --> tests/s2/neg/op_str_escape.srs:16
