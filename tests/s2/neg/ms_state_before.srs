// expect: error[multishot-state]
// the lamp is On at the resume point but Off at the end: the second branch would start Off (vic Q-M4)
capability NonDet:
  def choose(): Bool
handler Count [A: Type] for NonDet:
  def done(x: A): I64 = 1
  def choose(k): I64 = resume k(true) + resume k(false)
capability Lamp:
  state Off, On
  start Off
  stop Off
  def on <Off> (): Unit <On>
  def off <On> (): Unit <Off>
handler HLamp for Lamp:
  def on(): Unit = ()
  def off(): Unit = ()
def run(): I64 =
  handle l = HLamp()
  handle nd = Count()
  l.on()
  val a = nd.choose()
  l.off()
  0
def main(): I64 = run()
