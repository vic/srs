// expect: error[capability-bound]
// a param a: List<s> is a bound the body trusts: an arg that lives in t does not fit
def keep {s: Region} {t: Region} (a: List<s>): I64 = sum(a)
def go {s: Region} {t: Region} (): I64 =
  val x = build{t}(3)
  keep{s, t}(x)
def main(): I64 =
  handle io = Srs.Console()
  handle sess = Srs.Heap()
  handle tmp = Srs.Arena()
  go{sess, tmp}()
