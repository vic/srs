// format: off
// expect: error[region-escape]
// an op result with no region named is checked like a def result: the handler fn returns memory of the Arena it closes
capability Oe:
  def get(): Str

handler Hoe for Oe:
  def get(): Str =
    handle r = Srs.Arena()
    val n = 3
    val xs: Array[U8](n) = Array.fill(n, U8.of(65))
    Str.ofBytes(n, xs)

def main(): I64 =
  handle io = Srs.Console()
  handle h = Hoe()
  Console.print(Oe.get())
  0
// expect: --> tests/s2/neg/op_result_escape.srs:9
