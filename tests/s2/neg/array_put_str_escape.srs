// format: off
// expect: error[region-escape]
// a slot of outer (in r) outlives r2: a Str that lives in the inner region r2 must not be put into it
def main(): I64 =
  handle m = Srs.Mut()
  handle r = Srs.Arena()
  val n = 2
  val i = 0
  val outer = Array.fill(n, "")
  handle r2 = Srs.Arena()
  val bs = Array.fill(n, U8.of(104))
  val s = Str.ofBytes{r2}(n, bs)
  if 0 <= i && i < n then Array.put(outer, i, s) else ()
  0
