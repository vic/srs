// expect: error[impure-call]
// an inferred row is an effect, as a written {r: Region} binder is: mk allocates, so its row has Region
enum Box:
  case Box(v: I64)

def mk(x: I64): Box = Box(x)
spec def g(x: I64): I64 =
  val Box(v) = mk(x)
  v
def main(): I64 = 0
// s1: a spec def calls only pure defs and pure externs, not 'mk'
