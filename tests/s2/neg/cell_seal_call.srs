// format: off
// expect: error[cell-seal]
// a fn that writes a cell of region data, called while an inner Arena is open (its region dies before the cell)
def CS.set(c: Cell[Str], s: Str): Unit = Cell.put(c, s)
def CS.inner(c: Cell[Str]): Unit =
  handle q = Srs.Arena()
  val n = 3
  CS.set(c, Str.ofBytes(n, Array.fill(n, U8.of(65))))
def main(): I64 =
  handle m = Srs.Mut()
  handle r = Srs.Arena()
  val c = Cell.new("x")
  CS.inner(c)
  0
