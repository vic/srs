// format: off
// expect: error[stale-value]
// a view made by builder b1 is bound to b1, not to whichever Scratch is in scope where it is read
capability Scratch:
  state Building, Viewed, Gone
  start Building
  stop Gone
  def add <Building> (s: Str): Unit <Building>
  def view <Building> (): Ptr <Viewed>
  def clear <Viewed> (): Unit <Building>
  transition ends Building -> Gone, Viewed -> Gone
  def done <s ends t> (): Unit <t>

handler HScratch for Scratch:
  def add(s: Str): Unit = ()
  def view(): Ptr = Srs.noState()
  def clear(): Unit = ()
  def done(): Unit = ()

// bytes of the builder, valid only while it is Viewed (no change since the view)
type View {b: Scratch} <b: Viewed> = Ptr
extern def I6.viewOf {b: Scratch} <b: Viewed> (p: Ptr): View
def I6.hash {b: Scratch} <b: Viewed> (v: View): I64 = 7
def I6.keep(p: Ptr): I64 = 0

// a fresh builder handle per user: the first user's view outlives its handle; a second handle is Viewed
// when the stale view is read
def I6.fill {b: Scratch} <b: Building> (s: Str): View <b: Viewed> =
  b.add(s)
  I6.viewOf(b.view())
def I6.first {o: Scratch} <o: Building> (): View <o: Building> =
  handle b1 = HScratch()
  val v: View = I6.fill{b1}("Derive(")
  b1.done()
  v
def I6.second {o: Scratch} <o: Building> (): I64 <o: Viewed> =
  val v: View = I6.first()
  val w: View = I6.fill("text")
  I6.hash(v) + I6.hash(w)
def main(): I64 =
  handle o = HScratch()
  val n = I6.second()
  o.done()
  n
// v is read after b1 ended and escapes b1's block; in second, v is o's view, made while o was Building
// expect: error[region-escape]
// expect: --> tests/s2/neg/tf_maker.srs:35
// expect: --> tests/s2/neg/tf_maker.srs:39
