enum Ap.E:
  case Ap.A
  case Ap.B(x: I64)
def Ap.set(n: I64, xs: Array[Ap.E](n), i: I64): Unit =
  if 0 <= i && i < n then Array.put(xs, i, Ap.B(1)) else ()
