// s2 P6 FRONT (vic-m5r.27): the parser. tests/s2/ast.out is the Ast printer's text of hand-built Asts (rung P1); parsing it and
// printing the result gives it back byte for byte, except one blank line: ast.srs prints ce7 and ce9 in two Ast.print calls
// (tests/s2/ast.srs:120-121), one call separates them. then parse errors are data (the line and what was expected)
def PT.err(line: I64, want: Str): Unit =
  Console.print("error ")
  Console.printI64(line)
  Console.print(" ")
  Console.print(want)
  Console.print("\n")

def PT.run {r: Region} (src: Str): Unit = Parse.source(src) match
  case Parse.Ok(ds, _) => Ast.print(ds)
  case Parse.Err(line, want) => PT.err(line, want)

def main(): I64 =
  handle r = Srs.Arena()
  handle c = Srs.Console()
  handle fs = Srs.Files()
  PT.run(Files.read("tests/s2/ast.out"))
  PT.run(Files.read("tests/s2/prog/contracts.srs"))
  PT.run("def h(p: Pair[I64, I64]): I64 =\n  val y = 1\n  val Pair(a, b) = p\n  a + b * y\n")
  PT.run("def k(): I64 = 10 - 3 - 2\ndef m(b: Bool): I64 =\n  if b then 1\n  else 2\n")
  PT.run("trait Ho.Fold [F: Type] [A: Type] [B: Type]:\n  def step(acc: B, x: A): B\n\ngiven Ho.Fold[Ho.Sum, I64, I64]:\n  def step(acc: I64, x: I64): I64 = acc + x\n\ngiven [A: Type] {o: Ord[A]} Ord[List[A]]:\n  def cmp(a: A, b: A): I64 = 0\n")
  PT.run("spec def twoOf(n: I64): I64 = n + n\n")
  PT.run("type Bits (n: I64) = n match\n  case 8 => Bool\n  case _ => I64\n\ntype Twice (n: I64) = Bits(n * 2)\n\ntype TPick (b: Bool) = b match\n  case true => Str\n  case false => I64\n\ntype Wide [A: Type] = A match\n  case Bool => I64\n  case I64 => I64\n\ntype OpenFile {f: File} <at(f, Opened)> = Ptr\n\ndef tb3(x: Bits(dbl(4))^<r>): Bool = !x\n")
  PT.run("type Id = [A: Type] =>> A\n")
  PT.run("def g(b: Bool): I64 =\n  if b then\n    val x = 1\n    x\n  else 2\n")
  PT.run("def f(): I64 =\n  val x = (1 + \n  x\n")
  PT.run("handler Count [A: Type] for NonDet:\n  def done(x: A): I64 = 1\n  def choose(k): I64 = resume k(true) + resume k(false)\n")
  PT.run("enum E:\n  case A\n  kase B\n")
  PT.run("def g(): I64 = if true then 1\n")
  0
