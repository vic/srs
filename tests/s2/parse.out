def main(): I64 =
  handle f = CFile()
  var i = 0
  while i < 2 do
    f.read()
    i = i + 1
  f.close()
  0

enum Opt [A: Type]:
  case None
  case Some(v: A)

enum Pair [A: Type] [B: Type]:
  case Pair(a: A, b: B)

def get [A: Type] (o: Opt[A], d: A): A = o match
  case None => d
  case Some(v) => v

def first [A: Type] [B: Type] (p: Pair[A, B]): A = p match
  case Pair(a, _) => a

def main(): I64 =
  handle r = Srs.Arena()
  val n: Opt[I64] = None
  rt_print_i64(get(Some(41), 0) + get(n, 1))
  rt_print("\n")
  rt_print_i64(if get(Some(true), false) then 1 else 0)
  rt_print("\n")
  val p = Pair(Some(7), false)
  rt_print_i64(get(first(p), 0))
  rt_print("\n")
  val q: Opt[I64]<r> = Some(5)
  rt_print_i64(get(q, 0))
  rt_print("\n")
  0

def ce7(): Bool = false && 1 / 0 == 0

def ce9(): I64 = 0 - (0 - 3)
def size(xs: List): I64
  ensures result >= 0
  proof by induction xs
= xs match
  case Nil => 0
  case Cons(_, t) => 1 + size(t)

def count(xs: List): I64
  requires size(xs) >= 0
  ensures result == size(xs)
  proof using size
=
  var c = xs
  var n = 0
  while c match
    case Nil => false
    case Cons(_, _) => true
  do
    invariant n + size(c) == size(xs)
    decreases size(c)
    c = c match
      case Nil => c
      case Cons(_, t) => t
    n = n + 1
  n

def memL(v: I64, xs: List): Bool = xs match
  case Nil => false
  case Cons(h, t) => h == v || memL(v, t)

def push {r: Region} (h: I64, xs: List): List
  ensures forall v: I64 => memL(v, result) == (h == v || memL(v, xs))
  proof using memL
= Cons(h, xs)

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  Console.printI64(count(build(5)))
  Console.print("\n")
  0

