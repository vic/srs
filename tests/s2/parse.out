capability Door:
  state Shut, Open1, Open2, Gone
  start Shut
  stop Gone
  transition knock Shut -> Open1, Open1 -> Open2
  def knock <s knock t> (): I64 <t>
  transition leave Open1 -> Gone, Open2 -> Gone
  def leave <s leave t> (): Unit <t>
  rule def twoKnocks(s, s3) = next(s, knock, s2), next(s2, knock, s3)
  rule def reach(s, t) = next(s, knock, t)
  rule def reach(s, t) = next(s, knock, u), reach(u, t)

handler HDoor for Door:
  def init(): Ptr = rt_arena_new()
  def knock(self: Ptr): I64 = 3
  def leave(self: Ptr): Unit = rt_arena_free(self)

def knockTwice {d: Door} <d: s, twoKnocks(s, s3)> (): I64 <d: s3> =
  val a = d.knock()
  a + d.knock()

def knockOnce {d: Door} <d: Shut, reach(Shut, t), next(Shut, knock, t)> (): I64 <d: t> = d.knock()

def main(): I64 =
  handle d = HDoor()
  val x = knockTwice()
  d.leave()
  handle e = HDoor()
  val y = knockOnce{e}()
  e.leave()
  rt_print_i64(x + y)
  rt_print("\n")
  0

