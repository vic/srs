// s2 component 1 (Sym): same name = equal; other name = not; a hash tie with other strings = not equal
def T.b(x: Bool): I64 = if x then 1 else 0

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  val a = Sym.of("unify")
  Console.printI64(T.b(Sym.eq(a, Sym.of("unify"))))
  Console.printI64(T.b(Sym.eq(a, Sym.of("unifx"))))
  Console.printI64(T.b(Sym.eq(Sym.Sym(7, "a"), Sym.Sym(7, "b"))))
  Console.printI64(T.b(Sym.eq(Sym.Sym(7, "a"), Sym.Sym(8, "a"))))
  Console.printI64(T.b(Sym.hash(a) == strHash("unify") && Str.eq(Sym.str(a), "unify")))
  Console.print("\n")
  0
