// pass: vic-u2d U1b (vic: pure = no effects): a top-level val calls pure defs, also mutually recursive ones
def sq(x: I64): I64 = x * x
def isEven(n: I64): Bool = if n == 0 then true else isOdd(n - 1)
def isOdd(n: I64): Bool = if n == 0 then false else isEven(n - 1)
val sqEven: Bool = isEven(sq(3))

def main(): I64 =
  handle io = Srs.Console()
  Console.printI64(sq(3))
  if isEven(4) then Console.print(" even\n") else Console.print(" odd\n")
  0
