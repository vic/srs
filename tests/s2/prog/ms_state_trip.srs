// pass: an outer capability may move between resume points if it comes back (vic Q-M4): Off at the op and at the end
capability NonDet:
  def choose(): Bool
handler Count [A: Type] for NonDet:
  def done(x: A): I64 = 1
  def choose(k): I64 = resume k(true) + resume k(false)
capability Lamp:
  state Off, On
  start Off
  stop Off
  def on <Off> (): Unit <On>
  def off <On> (): Unit <Off>
handler HLamp for Lamp:
  def on(): Unit = ()
  def off(): Unit = ()
def run(): I64 =
  handle l = HLamp()
  handle nd = Count()
  val a = nd.choose()
  l.on()
  l.off()
  val b = nd.choose()
  0
def main(): I64 =
  handle io = Srs.Console()
  Console.printI64(run())
  Console.print("\n")
  0
