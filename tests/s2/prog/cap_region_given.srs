// pass: one Arena in main, but a given head writes a Region binder {r: Region}: namesRegion looks into given groups, so
// Region is not static and every row keeps its Region param (tests/run.sh greps the C)
trait Rv.Sh [A: Type]:
  def show(x: A): I64

given {r: Region} Rv.Sh[I64]:
  def show(x: I64): I64 = x + 1

def main(): I64 =
  handle c = Srs.Console()
  handle r = Srs.Arena()
  Console.printI64(5)
  Console.printChar(10)
  0
