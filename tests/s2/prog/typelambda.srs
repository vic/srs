// pass: BD6 type telescopes + match types (vic S18, vic-9l7.9): F[X] is the body with A := X; a match type reduces by
// its first matching case; aliases of generic enums; types inside types
enum Box [A: Type]:
  case Box(v: A)

type Id [A: Type] = A
type Wide [A: Type] = A match
  case Bool => I64
  case I64 => I64
type Boxed [A: Type] = Box[Id[A]]
type Num = I64

def widen(b: Bool): Wide[Bool] = if b then 1 else 0
def unbox [A: Type] (b: Boxed[A]): A = b match
  case Box(v) => v

def main(): I64 =
  handle r = Arena()
  val n: Id[I64] = 40
  val w: Wide[I64] = widen(true)
  val k: Num = unbox(Box(1))
  rt_print_i64(n + w + k)
  rt_print("\n")
  0
