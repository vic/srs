// pass: enum representation (rung S1a, S1d): a nullary case is one static per enum instance and case; a payload case
// is a box whose tag is the smallest unsigned int that holds the case count, with its Bool fields beside the tag. A
// generic enum at two instances (I64, Str) with nullary cases between payload cases, Bool fields mixed with word
// fields, a Bool-only case (a 2-byte box: the next box stays aligned only by the allocation granule), and an enum of
// 258 cases (a 2-byte tag) with a payload case past tag 255
enum Rp.Shape [A: Type]:
  case Rp.Dot
  case Rp.Line(on: Bool, a: A)
  case Rp.Gap
  case Rp.Box(a: A, lit: Bool, b: A, hid: Bool)
  case Rp.End
  case Rp.Flag(b: Bool)

def Rp.b2i(b: Bool): I64 = if b then 1 else 0

def Rp.code [A: Type] (s: Rp.Shape[A]): I64 = s match
  case Rp.Dot => 1
  case Rp.Line(on, _) => 20 + Rp.b2i(on)
  case Rp.Gap => 3
  case Rp.Box(_, lit, _, hid) => 40 + 2 * Rp.b2i(lit) + Rp.b2i(hid)
  case Rp.End => 5
  case Rp.Flag(b) => 60 + Rp.b2i(b)

def Rp.showI(s: Rp.Shape[I64]): Unit =
  Console.printI64(Rp.code(s))
  Console.print(" ")
  s match
    case Rp.Line(_, a) => Console.printI64(a)
    case Rp.Box(a, _, b, _) => Console.printI64(a * 100 + b)
    case _ => Console.print("-")
  Console.print("\n")

def Rp.showS(s: Rp.Shape[Str]): Unit =
  Console.printI64(Rp.code(s))
  Console.print(" ")
  s match
    case Rp.Line(_, a) => Console.print(a)
    case Rp.Box(a, _, b, _) =>
      Console.print(a)
      Console.print(b)
    case _ => Console.print("-")
  Console.print("\n")

