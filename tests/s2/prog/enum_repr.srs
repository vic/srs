def Rp.big(b: Rp.Big): I64 = b match
  case Rp.B0 => 1
  case Rp.B255 => 2
  case Rp.B256 => 3
  case Rp.BPay(n, ok) => n + Rp.b2i(ok)
  case _ => 0

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  val d: Rp.Shape[I64] = Rp.Dot
  val g: Rp.Shape[I64] = Rp.Gap
  val e: Rp.Shape[I64] = Rp.End
  Rp.showI(d)
  Rp.showI(g)
  Rp.showI(e)
  Rp.showI(Rp.Line(true, 7))
  Rp.showI(Rp.Flag(true))
  Rp.showI(Rp.Line(false, 8))
  Rp.showI(Rp.Box(1, true, 2, false))
  Rp.showI(Rp.Box(3, false, 4, true))
  val sd: Rp.Shape[Str] = Rp.Dot
  val sg: Rp.Shape[Str] = Rp.Gap
  val se: Rp.Shape[Str] = Rp.End
  Rp.showS(sd)
  Rp.showS(sg)
  Rp.showS(se)
  Rp.showS(Rp.Line(true, "x"))
  Rp.showS(Rp.Flag(false))
  Rp.showS(Rp.Box("p", true, "q", true))
  Console.printI64(Rp.big(Rp.B0))
  Console.print(" ")
  Console.printI64(Rp.big(Rp.B1))
  Console.print(" ")
  Console.printI64(Rp.big(Rp.B255))
  Console.print(" ")
  Console.printI64(Rp.big(Rp.B256))
  Console.print(" ")
  Console.printI64(Rp.big(Rp.BPay(40, true)))
  Console.print("\n")
  0
