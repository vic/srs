// pass: Console.printI64 prints the decimal text of an I64 at the edges: INT64_MIN, -1, 0, single and double digits
// around the powers of ten, and INT64_MAX. one value per line, the same bytes as snprintf("%lld")

def main(): I64 =
  handle c = Srs.Console()
  Console.printI64(-9223372036854775808)
  Console.print("\n")
  Console.printI64(-1)
  Console.print("\n")
  Console.printI64(0)
  Console.print("\n")
  Console.printI64(9)
  Console.print("\n")
  Console.printI64(10)
  Console.print("\n")
  Console.printI64(99)
  Console.print("\n")
  Console.printI64(100)
  Console.print("\n")
  Console.printI64(9223372036854775807)
  Console.print("\n")
  0
