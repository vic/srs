// pass: A1 Cell[A] (vic/c/array-design.md): one typed word; Cell.put is a write, a request on Mut, so Cl.bump has Mut
// in its inferred row and main handles it
def Cl.bump(c: Cell[I64]): Unit = Cell.put(c, Cell.get(c) + 1)

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  handle m = Srs.Mut()
  val c = Cell.new(40)
  Cl.bump(c)
  Cl.bump(c)
  Console.printI64(Cell.get(c))
  Console.print("\n")
  val b = Cell.new(false)
  Cell.put(b, true)
  Console.print(if Cell.get(b) then "yes\n" else "no\n")
  0
