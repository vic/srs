// pass: Srs.Arena (the Arena written in srs): an array of 1000 elements and a sum, then the region ends
def Ab.sum(n: I64, xs: Array[I64](n), i: I64, acc: I64): I64 =
  if 0 <= i && i < n then Ab.sum(n, xs, i + 1, acc + xs(i)) else acc
def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  val n = 1000
  val xs = Array.fill(n, 7)
  Console.printI64(Ab.sum(n, xs, 0, 0))
  Console.print("\n")
  0
