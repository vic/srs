// format: off
// pass: one Arena in main, but a trait method signature writes a Region binder {r: Region}: namesRegion looks into trait
// sigs, so Region is not static and every row keeps its Region param (tests/run.sh greps the C)
trait Rt.Mk [A: Type]:
  def mk {r: Region} (x: A): A

given Rt.Mk[I64]:
  def mk(x: I64): I64 = x + 1

// format: on
def main(): I64 =
  handle c = Srs.Console()
  handle r = Srs.Arena()
  Console.printI64(5)
  Console.printChar(10)
  0
