// pass: Str.less(a, b) orders by bytes as unsigned values, a proper prefix first; Str.has(s, c, i, e) finds byte c in
// s[i, e) with i and e clamped to [0, len). Both are checked against byte-by-byte references on every pair and every
// range of a set of strings with bytes above 127, NUL, CR and LF, and on extreme bounds
def say(s: Str, v: I64): Unit =
  Console.print(s)
  Console.print(" ")
  Console.printI64(v)
  Console.print("\n")

def refLess(a: Str, b: Str, i: I64): Bool =
  if i >= Str.len(a) || i >= Str.len(b) then Str.len(a) < Str.len(b)
  else if Str.at(a, i) != Str.at(b, i) then Str.at(a, i) < Str.at(b, i)
  else refLess(a, b, i + 1)

def refHas(s: Str, c: I64, i: I64, e: I64): Bool =
  if i >= e || i >= Str.len(s) then false
  else if i >= 0 && Str.at(s, i) == c then true
  else refHas(s, c, i + 1, e)

def pick(k: I64): Str =
  if k == 0 then "" else if k == 1 then "a" else if k == 2 then "ab" else if k == 3 then "abc"
  else if k == 4 then "ab\0" else if k == 5 then "\0" else if k == 6 then "é" else if k == 7 then "aé"
  else if k == 8 then "a~" else if k == 9 then "abcdefghijklmnopq" else if k == 10 then "abcdefghijklmnopr"
  else if k == 11 then "abcdefgh\r\nijklmn" else "abcdefgh"

def badLess(a: I64, b: I64, n: I64): I64 =
  if a == 13 then n
  else if b == 13 then badLess(a + 1, 0, n)
  else badLess(a, b + 1, if Str.less(pick(a), pick(b)) == refLess(pick(a), pick(b), 0) then n else n + 1)

def lessCount(a: I64, b: I64, n: I64): I64 =
  if a == 13 then n
  else if b == 13 then lessCount(a + 1, 0, n)
  else lessCount(a, b + 1, if Str.less(pick(a), pick(b)) then n + 1 else n)

def badHas(k: I64, c: I64, i: I64, e: I64, n: I64): I64 =
  if k == 13 then n
  else if c == 4 then badHas(k + 1, 0, 0 - 2, 0 - 2, n)
  else if i == 20 then badHas(k, c + 1, 0 - 2, 0 - 2, n)
  else if e == 20 then badHas(k, c, i + 1, 0 - 2, n)
  else
    val b = if c == 0 then 0 else if c == 1 then 169 else if c == 2 then 10 else 113
    badHas(k, c, i, e + 1, if Str.has(pick(k), b, i, e) == refHas(pick(k), b, i, e) then n else n + 1)

def hasCount(k: I64, n: I64): I64 =
  if k == 13 then n else hasCount(k + 1, if Str.has(pick(k), 0, 0, Str.len(pick(k))) then n + 1 else n)

def main(): I64 =
  handle c = Srs.Console()
  say("less bad", badLess(0, 0, 0))
  say("less true", lessCount(0, 0, 0))
  say("has bad", badHas(0, 0, 0 - 2, 0 - 2, 0))
  say("has nul", hasCount(0, 0))
  val lo: I64 = 0 - 9223372036854775807 - 1
  val hi: I64 = 9223372036854775807
  say("has ext", (if Str.has("abc", 99, lo, hi) then 1 else 0) + (if Str.has("abc", 99, hi, lo) then 2 else 0) + (if Str.has("abc", 97, 1, hi) then 4 else 0) + (if Str.has("é", 169 + 256, 0, 2) then 8 else 0) + (if Str.has("é", 169, 0, 2) then 0 else 16))
  0
