// pass: the innermost handler is found by type, among the locals that are still in reach by name: val t shadows the
// Twice capability t, so Plain answers
capability Tally:
  def add(a: I64, b: I64): I64

handler Plain for Tally:
  def add(a: I64, b: I64): I64 = a + b

handler Twice for Tally:
  def add(a: I64, b: I64): I64 = 2 * (a + b)

def main(): I64 =
  handle io = Srs.Console()
  handle p = Plain()
  handle t = Twice()
  val t = 5
  Console.printI64(Tally.add(t, 1))
  Console.print("\n")
  0
