// pass: BD4b capabilities are {} evidence (vic-9l7.7): {r: Region} is the one Region in scope at the call;
// in C it is the first param, the call passes it first
def make {r: Region} (n: I64): List = if n == 0 then Nil else Cons(n, make(n - 1))

def main(): I64 =
  handle io = Srs.Console()
  handle h = Srs.Heap()
  val s = sum(make(4))
  h.free()
  Console.printI64(s)
  Console.print("\n")
  0
