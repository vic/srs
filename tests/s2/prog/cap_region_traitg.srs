// pass: one Arena in main, but a trait head writes a Region binder {r: Region}: namesRegion looks into trait groups, so
// Region is not static and every row keeps its Region param (tests/run.sh greps the C)
trait Rg.Mk [A: Type] {r: Region}:
  def mk(x: A): A

given Rg.Mk[I64]:
  def mk(x: I64): I64 = x + 1

def main(): I64 =
  handle c = Srs.Console()
  handle r = Srs.Arena()
  Console.printI64(5)
  Console.printChar(10)
  0
