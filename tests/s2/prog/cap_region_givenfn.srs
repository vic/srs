// pass: one Arena in main, but a given's method writes a Region binder {r: Region}: namesRegion looks into given fns, so
// Region is not static and every row keeps its Region param (tests/run.sh greps the C)
trait Rf.Sh [A: Type]:
  def show(x: A): I64

given Rf.Sh[I64]:
  def show {r: Region} (x: I64): I64 = x + 1

def main(): I64 =
  handle c = Srs.Console()
  handle r = Srs.Arena()
  Console.printI64(5)
  Console.printChar(10)
  0
