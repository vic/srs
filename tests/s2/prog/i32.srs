// R0b I32: storage type for C int (libc results). I32.of keeps the low 32 bits, I64.ofI32 sign-extends
extern def I32.of(x: I64): I32
extern def I64.ofI32(x: I32): I64

def main(): I64 =
  handle io = Srs.Console()
  Console.printI64(I64.ofI32(I32.of(4294967295)))
  Console.print("\n")
  Console.printI64(I64.ofI32(I32.of(2147483648)))
  Console.print("\n")
  Console.printI64(I64.ofI32(I32.of(7)))
  Console.print("\n")
  0
