// pass: a capability binder needs no name (vic Q1): {Console} is {_: Console}; `_` is not bound; mixed with named evidence
trait Show [A: Type]:
  def show(x: A): I64

given Show[I64]:
  def show(x: I64): I64 = x + 1

def log {Console} (s: Str): Unit = Console.print(s)

def sh {s: Show[I64], Console} (x: I64): Unit = Console.printI64(s.show(x))

def both {Console, _: Files} (p: Str): Unit = Console.print(p)

def main(): I64 =
  handle c = Srs.Console()
  handle r = Srs.Arena()
  handle f = Srs.Files()
  log("hi ")
  sh(41)
  both(" ok\n")
  0
