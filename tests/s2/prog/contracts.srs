// pass: verification syntax (C13) parses, checks, and is erased in C
def size(xs: List): I64
  ensures result >= 0
  proof by induction xs
= xs match
  case Nil => 0
  case Cons(_, t) => 1 + size(t)

def count(xs: List): I64
  requires size(xs) >= 0
  ensures result == size(xs)
  proof using size
=
  var c = xs
  var n = 0
  while c match
    case Nil => false
    case Cons(_, _) => true
  do
    invariant n + size(c) == size(xs)
    decreases size(c)
    c = c match
      case Nil => c
      case Cons(_, t) => t
    n = n + 1
  n

def memL(v: I64, xs: List): Bool = xs match
  case Nil => false
  case Cons(h, t) => h == v || memL(v, t)

def push {r: Region} (h: I64, xs: List): List
  ensures forall v: I64 => memL(v, result) == (h == v || memL(v, xs))
  proof using memL
= Cons(h, xs)

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  Console.printI64(count(build(5)))
  Console.print("\n")
  0

// plain defs: Region is inferred where a def builds data
def twoOf(n: I64): List = Cons(n, Cons(n, Nil))
def strLen2(s: Str): I64 = Str.len(s) * 2
