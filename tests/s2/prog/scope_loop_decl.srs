// pass: a var declared in a loop turn with no sources is a new binding each turn: what the turn before assigned it (a
// list in tmp, which that turn's end closed) is not what this turn reads
def main(): I64 =
  handle io = Srs.Console()
  var i = 0
  var total = 0
  while i < 3 do
    handle tmp = Srs.Arena()
    var z = Nil
    total = total + sum(z)
    z = build{tmp}(2)
    total = total + sum(z)
    i = i + 1
  Console.printI64(total)
  Console.print("\n")
  0
