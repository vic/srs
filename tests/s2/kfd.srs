// s2 component 5 (disequality + finite domains): the cases of tests/kanren_neq.srs (store printed as the reified pair,
// not the s1 binding list) and of tests/kanren_fd.srs (same .out lines); then a 9-queens-free bigger label: 8 distinct
// vars in 1..8 with X1 < X2 < ... (one answer), to exercise settle rounds
def T.c0 {r: Region} (f: Str): K.Term = K.Con(Sym.of(f), Coll.Nil)
def T.c1 {r: Region} (f: Str, a: K.Term): K.Term = K.Con(Sym.of(f), Coll.Cons(a, Coll.Nil))
def T.c2 {r: Region} (f: Str, a: K.Term, b: K.Term): K.Term = K.Con(Sym.of(f), Coll.Cons(a, Coll.Cons(b, Coll.Nil)))
def T.both {r: Region} (g: K.Goal, h: K.Goal): K.Goal = K.Conj(g, h)
def T.in {r: Region} (x: K.Term, a: I64, b: I64): K.Goal = K.In(x, K.range(a, b))
def T.lt {r: Region} (x: K.Term, y: K.Term): K.Goal = K.Post(K.FBin(K.Lt, x, y))
def T.le {r: Region} (x: K.Term, y: K.Term): K.Goal = K.Post(K.FBin(K.Le, x, y))

def T.show(t: K.Term): Unit = t match
  case K.Var(n) =>
    Console.print("_")
    Console.printI64(n)
  case K.Int(v) => Console.printI64(v)
  case K.Con(f, args) =>
    Console.print(Sym.str(f))
    args match
      case Coll.Nil => ()
      case Coll.Cons(h, t) =>
        Console.print("(")
        T.show(h)
        T.showRest(t)
        Console.print(")")

def T.showRest(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(h, t) =>
    Console.print(", ")
    T.show(h)
    T.showRest(t)

def T.vars {r: Region} (st: K.State, i: I64, nv: I64): Unit =
  if i < nv then
    if i > 0 then Console.print(" ; ") else ()
    val K.State(s, _, _, _, _) = st
    T.show(K.reify(s, K.Var(i)))
    T.vars(st, i + 1, nv)
  else ()

def T.neqs {r: Region} (s: K.Subst, ns: Coll.List[K.Neq]): Unit = ns match
  case Coll.Nil => ()
  case Coll.Cons(h, t) =>
    val K.Neq(a, b) = h
    Console.print(" {")
    T.show(K.reify(s, a))
    Console.print(" =/= ")
    T.show(K.reify(s, b))
    Console.print("}")
    T.neqs(s, t)

def T.answers {r: Region} (xs: Coll.List[K.State], nv: I64, store: Bool): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(st, t) =>
    T.vars(st, 0, nv)
    val K.State(s, ns, _, _, _) = st
    if store then T.neqs(s, ns) else ()
    Console.print("\n")
    T.answers(t, nv, store)

// disequality cases: answers with their store, then --
def T.neq {r: Region} (g: K.Goal, nv: I64): Unit =
  val none: Coll.List[K.Rule] = Coll.Nil
  val K.Run(ans, _) = K.solve(none, g, nv, 100, 10)
  T.answers(ans, nv, true)
  Console.print("--\n")

// finite domain cases: answers, then the status
def T.fd {r: Region} (g: K.Goal, nv: I64, fuel: I64): Unit =
  val none: Coll.List[K.Rule] = Coll.Nil
  val K.Run(ans, st) = K.solve(none, g, nv, fuel, 10)
  T.answers(ans, nv, false)
  st match
    case K.Ended => Console.print("ended\n")
    case K.Limit => Console.print("limit\n")
    case K.NoFuel => Console.print("nofuel\n")

// X0 < X1 < ... < X(n-1)
def T.chainLt {r: Region} (i: I64, n: I64, g: K.Goal): K.Goal = if i + 1 >= n then g else T.chainLt(i + 1, n, T.both(g, T.lt(K.Var(i), K.Var(i + 1))))
def T.allIn {r: Region} (i: I64, n: I64, a: I64, b: I64, g: K.Goal): K.Goal = if i >= n then g else T.allIn(i + 1, n, a, b, T.both(g, T.in(K.Var(i), a, b)))
def T.vlist {r: Region} (i: I64, acc: Coll.List[K.Term]): Coll.List[K.Term] = if i < 0 then acc else T.vlist(i - 1, Coll.Cons(K.Var(i), acc))

def T.ne {r: Region} (x: K.Term, y: K.Term): K.Goal = K.Post(K.FBin(K.Ne, x, y))

// pigeonhole: n variables in 1..m, all different, labeled (no answer when n > m); the fuel it runs on
def T.pig {r: Region} (n: I64, m: I64, fuel: I64): Unit =
  val vs = T.vlist(n - 1, Coll.Nil)
  T.fd(T.both(T.allIn(0, n, 1, m, K.True), T.both(K.distinct(vs), K.Label(vs))), n, fuel)

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  val x = K.Var(0)
  val y = K.Var(1)
  val z = K.Var(2)
  val a = T.c0("a")
  val b = T.c0("b")
  T.neq(T.both(K.Diseq(x, a), K.Eq(x, a)), 1)
  T.neq(T.both(K.Eq(x, a), K.Diseq(x, a)), 1)
  T.neq(T.both(K.Diseq(x, a), K.Eq(x, b)), 1)
  val fxy = T.c2("f", x, y)
  val fab = T.c2("f", a, b)
  T.neq(T.both(K.Diseq(fxy, fab), K.Eq(x, a)), 2)
  T.neq(T.both(T.both(K.Diseq(fxy, fab), K.Eq(x, a)), K.Eq(y, b)), 2)
  T.neq(T.both(K.Disj(K.Eq(x, a), K.Eq(x, b)), K.Diseq(x, a)), 1)
  T.neq(T.both(K.Diseq(x, y), K.Eq(x, y)), 2)
  T.neq(T.both(T.both(K.Diseq(x, y), K.Eq(x, a)), K.Eq(y, b)), 2)
  T.neq(K.Diseq(T.c1("f", x), T.c1("g", x)), 1)
  T.neq(T.both(K.Eq(x, a), K.Diseq(fxy, fab)), 2)
  val x1: Coll.List[K.Term] = Coll.Cons(x, Coll.Nil)
  val xy: Coll.List[K.Term] = Coll.Cons(x, Coll.Cons(y, Coll.Nil))
  val xyz: Coll.List[K.Term] = Coll.Cons(x, Coll.Cons(y, Coll.Cons(z, Coll.Nil)))
  T.fd(T.both(T.in(x, 1, 3), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.both(T.in(x, 1, 3), T.in(y, 1, 3)), T.lt(x, y)), K.Label(xy)), 2, 1000)
  val sum = T.both(T.both(T.in(x, 0, 2), T.in(y, 0, 2)), K.Post(K.FPlus(x, y, z)))
  T.fd(T.both(sum, K.Eq(z, K.Int(4))), 3, 1000)
  T.fd(T.both(T.both(T.both(T.both(T.in(x, 1, 2), T.in(y, 1, 2)), T.in(z, 1, 2)), K.distinct(xyz)), K.Label(xyz)), 3, 1000)
  T.fd(T.both(T.in(x, 1, 3), K.Eq(x, K.Int(5))), 1, 1000)
  T.fd(T.both(K.Eq(x, K.Int(2)), T.in(x, 1, 3)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 3), T.in(x, 2, 5)), K.Label(x1)), 1, 1000)
  T.fd(T.both(K.Eq(x, T.c1("f", T.c0("a"))), T.in(x, 1, 3)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 2), K.Diseq(x, K.Int(1))), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.in(x, 1, 5), T.lt(x, K.Int(2))), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 5), T.in(y, 0, 0)), T.le(x, y)), 2, 1000)
  T.fd(T.both(T.both(K.Eq(x, y), T.in(x, 1, 3)), T.in(y, 3, 5)), 2, 1000)
  T.fd(T.both(T.both(T.both(T.in(x, 1, 3), T.in(y, 2, 3)), K.Eq(x, y)), K.Label(xy)), 2, 1000)
  T.fd(T.both(T.in(x, 1, 3), K.Label(x1)), 1, 2)
  T.fd(T.both(T.both(T.in(x, 1, 3), T.in(y, 1, 2)), K.Label(xy)), 2, 1000)
  // the mirror of the case above: the wider domain is on the later variable; unified variables must meet, not overwrite
  T.fd(T.both(T.both(T.both(T.in(x, 2, 3), T.in(y, 1, 3)), K.Eq(x, y)), K.Label(xy)), 2, 1000)
  // 12 variables in 1..12, each smaller than the next: propagation alone fixes all (one answer, no label choice)
  T.fd(T.both(T.chainLt(0, 12, T.allIn(0, 12, 1, 12, K.True)), K.Label(T.vlist(11, Coll.Nil))), 12, 1000)
  // propagation strength, seen in fuel: X < Y < Z < W in 1..5 leaves X in 1..2 only when a narrowed variable wakes the
  // other propagators (a label of X costs 2 <= fuel 3)
  val w = K.Var(3)
  val chain4 = T.both(T.both(T.both(T.both(T.both(T.both(T.in(x, 1, 5), T.in(y, 1, 5)), T.in(z, 1, 5)), T.in(w, 1, 5)), T.lt(x, y)), T.lt(y, z)), T.lt(z, w))
  T.fd(T.both(chain4, K.Label(x1)), 4, 3)
  // X =/= Y in 1..2 and X = 1 fix Y = 2 with no label
  T.fd(T.both(T.both(T.both(T.in(x, 1, 2), T.in(y, 1, 2)), K.Post(K.FBin(K.Ne, x, y))), K.Eq(x, K.Int(1))), 2, 1000)
  // bitset domains (vic-kpev K6 f): up to 64 wide a mask, wider a list; bounds, removals and meets cross the 64 limit
  val x100 = T.in(x, 1, 100)
  T.fd(T.both(T.both(T.both(x100, T.lt(K.Int(62), x)), T.lt(x, K.Int(66))), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 64), T.lt(K.Int(61), x)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 0, 63), T.lt(K.Int(60), x)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 65), T.lt(K.Int(62), x)), K.Label(x1)), 1, 1000)
  // meets: list with list, mask with mask on either side, mask with list on either side, disjoint
  T.fd(T.both(T.both(T.in(x, 1, 200), T.in(x, 50, 250)), T.both(T.lt(x, K.Int(120)), T.both(T.lt(K.Int(55), x), K.Label(x1)))), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 200), T.in(x, 50, 250)), T.both(T.lt(x, K.Int(120)), T.both(T.lt(K.Int(56), x), K.Label(x1)))), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 10, 20), T.in(x, 15, 40)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 15, 40), T.in(x, 10, 20)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(x100, T.in(x, 98, 105)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 98, 105), T.in(x, 1, 100)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.in(x, 1, 5), T.in(x, 7, 9)), 1, 1000)
  T.fd(T.both(T.in(x, 0, 63), T.in(x, 64, 70)), 1, 1000)
  T.fd(T.both(T.in(x, 0, 63), T.in(x, 63, 80)), 1, 1000)
  T.fd(T.both(T.in(x, 1, 200), T.in(x, 300, 400)), 1, 1000)
  // removals at the ends and in the middle of a mask
  val e1 = T.both(T.both(x100, T.in(x, 90, 200)), T.ne(x, K.Int(95)))
  val e2 = T.both(T.both(T.both(e1, T.ne(x, K.Int(90))), T.ne(x, K.Int(100))), T.ne(x, K.Int(7)))
  T.fd(T.both(e2, K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.both(x100, T.in(x, 90, 200)), T.ne(x, K.Int(95))), K.Label(x1)), 1, 1000)
  // x <= y <= 3 over 1..100
  T.fd(T.both(T.both(T.both(x100, T.in(y, 1, 100)), T.le(x, y)), T.both(T.le(y, K.Int(3)), K.Label(xy))), 2, 1000)
  // sums across the limit: Z = X + Y, X and Y in 30..40 and Z in 60..80
  T.fd(T.both(T.both(T.both(T.in(x, 30, 40), T.in(y, 30, 40)), T.in(z, 60, 80)), K.Post(K.FPlus(x, y, z))), 3, 1000)
  // pigeonhole: 8 into 7 has no answer, 7 into 7 has 5040 (the first 10); fuel 8659 ends the first, 8658 does not
  T.pig(8, 7, 1000000)
  T.pig(8, 7, 8659)
  T.pig(8, 7, 8658)
  T.pig(7, 7, 1000000)
  // a variable bound deep inside a term meets its domain, and its disequalities: Y in 1..2 cannot be 3 under X = f(Y)
  val fy = T.c1("f", y)
  val fz = T.c1("f", z)
  val f3 = T.c1("f", K.Int(3))
  val f1 = T.c1("f", K.Int(1))
  T.fd(T.both(T.both(T.in(y, 1, 2), K.Eq(x, fy)), K.Eq(x, f3)), 3, 1000)
  T.fd(T.both(T.both(T.both(T.in(y, 1, 3), K.Eq(x, fy)), K.Eq(x, f3)), K.Label(T.vlist(1, Coll.Nil))), 3, 1000)
  T.fd(T.both(T.both(T.both(T.in(y, 1, 2), T.in(z, 2, 3)), K.Eq(x, fy)), K.Eq(x, fz)), 3, 1000)
  T.neq(T.both(T.both(K.Diseq(y, K.Int(3)), K.Eq(x, fy)), K.Eq(x, f3)), 3)
  T.neq(T.both(T.both(K.Diseq(y, z), K.Eq(x, fy)), K.Eq(x, fz)), 3)
  T.neq(T.both(T.both(K.Diseq(fy, fz), K.Eq(x, fy)), K.Eq(x, T.c1("f", T.c0("a")))), 3)
  T.neq(T.both(T.both(K.Diseq(fy, fz), K.Eq(y, T.c1("g", z))), K.Eq(z, T.c0("a"))), 3)
  // a pair is watched under the variables a binding brings in: X =/= Y, X = f(Z), Y = f(1) leave Z to decide
  val xy2 = K.Diseq(x, y)
  T.neq(T.both(T.both(T.both(xy2, K.Eq(x, fz)), K.Eq(y, f1)), K.Eq(z, K.Int(1))), 3)
  T.neq(T.both(T.both(T.both(xy2, K.Eq(x, fz)), K.Eq(y, f1)), K.Eq(z, K.Int(2))), 3)
  // a violated pair kills the branch at the binding, before the next split (fuel 0: a split would be nofuel): the
  // watchers wake on the bound variable, on either side of the pair, through an alias, and on a variable a binding
  // brought in. the last one lives
  val split = K.Disj(K.True, K.True)
  T.fd(T.both(T.both(K.Diseq(x, a), K.Eq(x, a)), split), 1, 0)
  T.fd(T.both(T.both(K.Diseq(a, x), K.Eq(x, a)), split), 1, 0)
  T.fd(T.both(T.both(K.Diseq(x, y), K.Eq(x, y)), split), 2, 0)
  T.fd(T.both(T.both(T.both(T.both(xy2, K.Eq(x, fz)), K.Eq(y, f1)), K.Eq(z, K.Int(1))), split), 3, 0)
  T.fd(T.both(T.both(T.both(T.both(xy2, K.Eq(x, fz)), K.Eq(y, f1)), K.Eq(z, K.Int(2))), split), 3, 0)
  T.fd(T.both(T.both(K.Diseq(x, a), K.Eq(x, b)), split), 1, 0)
  // x =/= y reads a bound term as its integer, on either side: outside the domain it prunes nothing, equal it dies, a
  // constructor dies, a variable without a domain waits; labeling passes over bound terms and variables without a domain
  val x3 = T.in(x, 1, 3)
  T.fd(T.both(T.both(x3, T.ne(K.Int(2), x)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(x3, T.ne(x, K.Int(2))), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(x3, T.ne(K.Int(5), x)), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(x3, T.ne(x, K.Int(5))), K.Label(x1)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 2, 2), T.ne(K.Int(2), x)), K.Label(x1)), 1, 1000)
  T.fd(T.ne(K.Int(3), K.Int(3)), 0, 1000)
  T.fd(T.ne(K.Int(3), K.Int(4)), 0, 1000)
  T.fd(T.both(T.both(x3, K.Eq(y, a)), T.ne(x, y)), 2, 1000)
  T.fd(T.both(T.both(x3, K.Eq(y, a)), T.ne(y, x)), 2, 1000)
  T.fd(T.both(K.Eq(x, a), T.ne(x, K.Int(1))), 1, 1000)
  T.fd(T.both(K.Eq(x, a), T.ne(K.Int(1), x)), 1, 1000)
  T.fd(T.both(T.both(T.in(x, 1, 2), T.ne(x, y)), K.Label(xy)), 2, 1000)
  T.fd(T.both(T.both(T.in(y, 1, 2), T.ne(x, y)), K.Label(xy)), 2, 1000)
  T.fd(T.both(T.both(T.both(x3, T.in(y, 2, 3)), T.ne(x, y)), K.Label(xy)), 2, 1000)
  T.fd(T.both(T.both(T.both(x3, T.in(y, 1, 3)), T.ne(x, y)), T.both(K.Eq(y, K.Int(2)), K.Label(xy))), 2, 1000)
  T.fd(T.both(T.both(T.both(x3, T.in(y, 1, 3)), T.ne(x, y)), T.both(K.Eq(x, K.Int(1)), K.Label(xy))), 2, 1000)
  val w3 = T.in(w, 1, 2)
  T.fd(T.both(T.both(T.both(K.Eq(x, K.Int(7)), K.Eq(y, a)), w3), K.Label(Coll.Cons(x, Coll.Cons(y, Coll.Cons(z, Coll.Cons(w, Coll.Nil)))))), 4, 1000)
  // the removal is made when the propagator runs, not when the label reaches the value: fuel 2 ends with two branches
  T.fd(T.both(T.both(x3, T.ne(x, K.Int(2))), K.Label(x1)), 1, 2)
  T.fd(T.both(T.both(x3, T.ne(K.Int(2), x)), K.Label(x1)), 1, 2)
  0
