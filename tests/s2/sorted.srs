// s2 b4: Coll.sortDedup builds a Sorted (strictly ascending keys, last binding wins) by bottom-up merge sort
def T.show(xs: Coll.List[Coll.KV[I64]]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(e, t) => T.showKV(e, t)

def T.showKV(e: Coll.KV[I64], t: Coll.List[Coll.KV[I64]]): I64 = e match
  case Coll.KV(k, v) =>
    Console.printI64(k)
    Console.print("=")
    Console.printI64(v)
    Console.print(" ")
    T.show(t)

// 1 iff keys strictly ascend (prev < every key)
def T.asc(xs: Coll.List[Coll.KV[I64]], prev: I64): I64 = xs match
  case Coll.Nil => 1
  case Coll.Cons(e, t) => if Coll.kvKey(e) > prev then T.asc(t, Coll.kvKey(e)) else 0

def T.scr {r: Region} (i: I64, n: I64, acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] =
  if i == n then acc else T.scr(i + 1, n, Coll.Cons(Coll.KV((i * 7919) % 100003, i), acc))

def T.none(): Coll.List[Coll.KV[I64]] = Coll.Nil

def T.val(s: Coll.Sorted[I64]): Coll.List[Coll.KV[I64]] = s match
  case Coll.Sorted(xs) => xs

// the input lists of the oracle, in list order: keys (i * 7919) % 1009 (many duplicates, short runs both ways),
// keys i / 2 ascending (one run, adjacent duplicates), keys n - 1 down to 0 (one descending run)
def T.genMod {r: Region} (i: I64, n: I64, acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] =
  if i == n then acc else T.genMod(i + 1, n, Coll.Cons(Coll.KV((i * 7919) % 1009, i), acc))

def T.genUp {r: Region} (i: I64, acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] =
  if i == 0 then acc else T.genUp(i - 1, Coll.Cons(Coll.KV((i - 1) / 2, i - 1), acc))

def T.genDown {r: Region} (i: I64, n: I64, acc: Coll.List[Coll.KV[I64]]): Coll.List[Coll.KV[I64]] =
  if i == n then acc else T.genDown(i + 1, n, Coll.Cons(Coll.KV(i, i), acc))

// the second path: the same list put into a BMap in list order (a later binding replaces)
def T.bm {r: Region} (xs: Coll.List[Coll.KV[I64]], m: Coll.BMap[I64]): Coll.BMap[I64] = xs match
  case Coll.Nil => m
  case Coll.Cons(e, t) => T.bmKV(e, t, m)

def T.bmKV {r: Region} (e: Coll.KV[I64], t: Coll.List[Coll.KV[I64]], m: Coll.BMap[I64]): Coll.BMap[I64] = e match
  case Coll.KV(k, v) => T.bm(t, Coll.bInsert(m, k, v))

def T.is (o: Coll.Option[I64], v: I64): Bool = o match
  case Coll.None => false
  case Coll.Some(w) => w == v

// keys strictly ascend above prev and every value is the one m binds
def T.agrees {r: Region} (xs: Coll.List[Coll.KV[I64]], m: Coll.BMap[I64], prev: I64): Bool = xs match
  case Coll.Nil => true
  case Coll.Cons(e, t) => T.agreeKV(e, t, m, prev)

def T.agreeKV {r: Region} (e: Coll.KV[I64], t: Coll.List[Coll.KV[I64]], m: Coll.BMap[I64], prev: I64): Bool = e match
  case Coll.KV(k, v) => if k > prev && T.is(Coll.bLookup(m, k), v) then T.agrees(t, m, k) else false

// "1 0" when sortDedup agrees with the map and has its size
def T.oracle {r: Region} (xs: Coll.List[Coll.KV[I64]]): I64 =
  val ys = T.val(Coll.sortDedup(xs))
  val m = T.bm(xs, Coll.bEmpty[I64]())
  Console.printI64(if T.agrees(ys, m, -1) then 1 else 0)
  Console.print(" ")
  Console.printI64(Coll.length(ys) - Coll.bSize(m))
  Console.print("\n")
  0

def main(): I64 =
  handle io = Srs.Console()
  handle r = Srs.Arena()
  val l = Coll.Cons(Coll.KV(5, 1), Coll.Cons(Coll.KV(3, 2), Coll.Cons(Coll.KV(9, 3), Coll.Cons(Coll.KV(5, 4), Coll.Cons(Coll.KV(1, 5), Coll.Cons(Coll.KV(3, 6), Coll.Cons(Coll.KV(7, 7), Coll.Cons(Coll.KV(5, 8), Coll.Cons(Coll.KV(0, 9), Coll.Cons(Coll.KV(8, 10), Coll.Nil))))))))))
  val s = Coll.sortDedup(l)
  T.show(T.val(s))
  Console.print("\n")
  Console.printI64(Coll.length(T.val(s)))
  Console.print("\n")
  val w = Coll.sortDedup(Coll.Cons(Coll.KV(4, 100), Coll.Cons(Coll.KV(4, 200), Coll.Nil)))
  T.show(T.val(w))
  Console.print("\n")
  val big = Coll.sortDedup(T.scr(0, 100000, Coll.Nil))
  Console.printI64(T.asc(T.val(big), -1))
  Console.print("\n")
  Console.printI64(Coll.length(T.val(big)))
  Console.print("\n")
  val e = Coll.sortDedup(T.none())
  Console.printI64(Coll.length(T.val(e)))
  Console.print("\n")
  T.oracle(T.genMod(0, 20000, Coll.Nil))
  T.oracle(T.genUp(20000, Coll.Nil))
  T.oracle(T.genDown(0, 20000, Coll.Nil))
  0
