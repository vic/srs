// s2 self-host rung T1 (vic/c/s2-selfhost.md): type inference. the oracle is s1: s2's own sources and the prelude are
// accepted by s1, so they must type with no clash and every generic call solved; then one program per clash kind
def TT.parseAll {r: Region} (ps: Coll.List[Str], acc: Coll.List[Ast.Decl]): Coll.List[Ast.Decl] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) => Parse.source(rt_read_file(p)) match
    case Parse.Ok(ds, _) => TT.parseAll(rest, Coll.revOnto(Coll.rev(ds), acc))
    case Parse.Err(line, _) =>
      rt_print("parse error ")
      rt_print(p)
      rt_print(" ")
      rt_print_i64(line)
      rt_print("\n")
      TT.parseAll(rest, acc)

// the prelude and every s2 source (a new s2 file goes here too)
def TT.sources {r: Region} (): Coll.List[Str] =
  val a = Coll.Cons("lib/prelude.srs", Coll.Cons("s2/ast.srs", Coll.Cons("s2/bmap.srs", Coll.Cons("s2/coll.srs", Coll.Cons("s2/datalog.srs", Coll.Cons("s2/elab.srs", Coll.Cons("s2/emit.srs", Coll.Cons("s2/mono.srs", Coll.Nil))))))))
  val b = Coll.Cons("s2/flow.srs", Coll.Cons("s2/kanren.srs", Coll.Cons("s2/kfd.srs", Coll.Cons("s2/ksearch.srs", Coll.Cons("s2/lex.srs", Coll.Nil)))))
  val c = Coll.Cons("s2/names.srs", Coll.Cons("s2/parse.srs", Coll.Cons("s2/queue.srs", Coll.Cons("s2/sym.srs", Coll.Cons("s2/types.srs", Coll.Nil)))))
  Coll.revOnto(Coll.rev(a), Coll.revOnto(Coll.rev(b), c))

def TT.show(c: Ty.Clash): Unit = c match
  case Ty.Mismatch(l, _, _) => TT.say("mismatch", l)
  case Ty.Unknown(l, n) => TT.sayN("unknown", l, n)
  case Ty.Arity(l, n) => TT.sayN("arity", l, n)
  case Ty.NotEnum(l, _) => TT.say("notenum", l)
  case Ty.NoOp(l, n) => TT.sayN("noop", l, n)
  case Ty.CannotInfer(l, n) => TT.sayN("cannotinfer", l, n)
  case Ty.NoCap(l, p) => TT.sayN("nocap", l, p)

def TT.say(k: Str, l: I64): Unit =
  rt_print(" ")
  rt_print(k)
  rt_print(" ")
  rt_print_i64(l)

def TT.sayN(k: Str, l: I64, n: Sym.Sym): Unit =
  TT.say(k, l)
  rt_print(" ")
  rt_print(Sym.str(n))

def TT.showAll(cs: Coll.List[Ty.Clash]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    TT.show(c)
    TT.showAll(rest)

def TT.run {r: Region} (name: Str, ds: Coll.List[Ast.Decl]): Unit =
  rt_print(name)
  rt_print(":")
  val Ty.Result(cs, is, _, _, _, _) = Ty.check(ds)
  cs match
    case Coll.Nil => rt_print(" ok")
    case Coll.Cons(_, _) => TT.showAll(Coll.rev(cs))
  rt_print("\n")

def TT.src {r: Region} (s: Str): Coll.List[Ast.Decl] = Parse.source(s) match
  case Parse.Ok(ds, _) => ds
  case Parse.Err(_, _) => Coll.Nil

def main(): I64 =
  handle r = Arena()
  val lib = TT.parseAll(TT.sources(), Coll.Nil)
  TT.run("self", lib)
  val Ty.Result(_, is, _, sfs, _, _) = Ty.check(lib)
  val mi = Mono.run(Ty.check(lib))
  rt_print("mono self: generic instances over 100: ")
  rt_print_i64(if TT.genericCount(mi, 0) > 100 then 1 else 0)
  rt_print(", open: ")
  rt_print_i64(TT.openCount(mi, 0))
  rt_print("\n")
  rt_print("bad nodes in self: ")
  rt_print_i64(TT.badsFns(sfs, 0))
  rt_print("\n")
  rt_print("instances over 1000: ")
  rt_print_i64(if Coll.length(is) > 1000 then 1 else 0)
  rt_print("\n")
  TT.run("trait_args", Coll.revOnto(Coll.rev(TT.src("def fold1 [X: Type] [Y: Type] {f: Coll.Fold[Y, X, I64]} (x: X): I64 = f.step(0, x)\n")), lib))
  TT.run("mismatch", Coll.revOnto(Coll.rev(TT.src("def f(): I64 = true\n")), lib))
  TT.run("arity", Coll.revOnto(Coll.rev(TT.src("def g(x: I64): I64 = x\ndef f(): I64 = g(1, 2)\n")), lib))
  TT.run("unknown", Coll.revOnto(Coll.rev(TT.src("def f(): I64 = nope(1)\n")), lib))
  TT.run("cannotinfer", Coll.revOnto(Coll.rev(TT.src("def f(): I64 = Coll.length(Coll.Nil)\n")), lib))
  rt_print("elab usem:\n")
  TT.elab("def mk {r: Region} (n: I64): Coll.List[I64] = Coll.Cons(n, Coll.Nil)\ndef pair {p: Region} {q: Region} (): I64 = 0\ndef usem(): I64 =\n  handle a = Arena()\n  handle b = Heap()\n  val xs = mk{b}(3)\n  Coll.length(Coll.rev{a}(xs)) + Coll.length(mk{a}(1)) + pair{a, b}()\n", lib, "usem")
  rt_print("mono usem:\n")
  TT.insts(Mono.run(Ty.check(Coll.revOnto(Coll.rev(TT.src("def mk {r: Region} (n: I64): Coll.List[I64] = Coll.Cons(n, Coll.Nil)\ndef usem(): I64 =\n  handle a = Arena()\n  Coll.length(Coll.rev(mk(3)))\n")), TT.parseAll(Coll.Cons("lib/prelude.srs", Coll.Cons("s2/coll.srs", Coll.Cons("s2/sym.srs", Coll.Nil))), Coll.Nil)))))
  0

// ── T3: the elaborated calls of one def: instance, type args (reified), caps; constructors with their region ──
def TT.term(t: K.Term): Unit = t match
  case K.Var(n) =>
    rt_print("?")
    rt_print_i64(n)
  case K.Int(v) => rt_print_i64(v)
  case K.Con(f, args) =>
    rt_print(Sym.str(f))
    args match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        rt_print("[")
        TT.terms(args)
        rt_print("]")

def TT.terms(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    TT.term(t)
    rest match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        rt_print(", ")
        TT.terms(rest)

def TT.reified {r: Region} (s: Coll.IMap[K.Term], ts: Coll.List[K.Term], acc: Coll.List[K.Term]): Coll.List[K.Term] = ts match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(t, rest) => TT.reified(s, rest, Coll.Cons(K.reify(s, t), acc))

def TT.syms(xs: Coll.List[Sym.Sym]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    rt_print(" ")
    rt_print(Sym.str(x))
    TT.syms(rest)

// the calls of e, in evaluation order (args first)
def TT.calls {r: Region} (s: Coll.IMap[K.Term], e: El.Expr): Unit = e match
  case El.CallFn(_, f, ts, caps, args) =>
    TT.callsAll(s, args)
    rt_print(Sym.str(f))
    rt_print("[")
    TT.terms(TT.reified(s, ts, Coll.Nil))
    rt_print("] caps")
    TT.syms(caps)
    rt_print("\n")
  case El.New(_, en, ts, c, reg, args) =>
    TT.callsAll(s, args)
    rt_print("new ")
    rt_print(Sym.str(c))
    rt_print(" : ")
    TT.term(K.reify(s, K.Con(en, ts)))
    rt_print(" in ")
    rt_print(Sym.str(reg))
    rt_print("\n")
  case El.Nullary(_, en, ts, c) =>
    rt_print(Sym.str(c))
    rt_print(" : ")
    TT.term(K.reify(s, K.Con(en, ts)))
    rt_print("\n")
  case El.Block(_, ss, last) =>
    TT.stmts(s, ss)
    TT.calls(s, last)
  case El.Bin(_, _, l, rhs) =>
    TT.calls(s, l)
    TT.calls(s, rhs)
  case El.Un(_, _, x) => TT.calls(s, x)
  case El.If(_, c, t, x) =>
    TT.calls(s, c)
    TT.calls(s, t)
    TT.calls(s, x)
  case El.Op(_, _, _, _, args) => TT.callsAll(s, args)
  case El.While(_, c, b) =>
    TT.calls(s, c)
    TT.calls(s, b)
  case El.Assign(_, _, x) => TT.calls(s, x)
  case El.Match(_, x, _, _) => TT.calls(s, x)
  case _ => ()

def TT.callsAll {r: Region} (s: Coll.IMap[K.Term], xs: Coll.List[El.Expr]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    TT.calls(s, x)
    TT.callsAll(s, rest)

def TT.stmts {r: Region} (s: Coll.IMap[K.Term], ss: Coll.List[El.Stmt]): Unit = ss match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    x match
      case El.Val(_, _, _, _, e) => TT.calls(s, e)
      case El.Do(e) => TT.calls(s, e)
      case El.Handle(_, _, _, _) => ()
    TT.stmts(s, rest)

def TT.elab {r: Region} (src: Str, lib: Coll.List[Ast.Decl], name: Str): Unit =
  val Ty.Result(cs, _, s, fs, _, _) = Ty.check(Coll.revOnto(Coll.rev(TT.src(src)), lib))
  TT.showAll(cs)
  TT.fnCalls(s, fs, Sym.of(name))

def TT.fnCalls {r: Region} (s: Coll.IMap[K.Term], fs: Coll.List[El.Fn], name: Sym.Sym): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, body) = f
    if Sym.eq(n, name) then
      body match
        case El.Def(e) => TT.calls(s, e)
        case _ => ()
    else TT.fnCalls(s, rest, name)

// El.Bad nodes in an elaborated program: 0 when it typed (a mutant that drops an elaboration shows up here)
def TT.badsFns(fs: Coll.List[El.Fn], n: I64): I64 = fs match
  case Coll.Nil => n
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, _, _, _, _, body) = f
    val k = body match
      case El.Def(e) => TT.bads(e)
      case _ => 0
    TT.badsFns(rest, n + k)

def TT.bads(e: El.Expr): I64 = e match
  case El.Bad(_) => 1
  case El.CallFn(_, _, _, _, args) => TT.badsAll(args)
  case El.New(_, _, _, _, _, args) => TT.badsAll(args)
  case El.Op(_, _, _, _, args) => TT.badsAll(args)
  case El.Bin(_, _, l, rhs) => TT.bads(l) + TT.bads(rhs)
  case El.Un(_, _, x) => TT.bads(x)
  case El.If(_, c, t, x) => TT.bads(c) + TT.bads(t) + TT.bads(x)
  case El.Match(_, x, _, arms) => TT.bads(x) + TT.badsArms(arms)
  case El.Block(_, ss, last) => TT.badsStmts(ss) + TT.bads(last)
  case El.While(_, c, b) => TT.bads(c) + TT.bads(b)
  case El.Assign(_, _, x) => TT.bads(x)
  case _ => 0

def TT.badsAll(xs: Coll.List[El.Expr]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(x, rest) => TT.bads(x) + TT.badsAll(rest)

def TT.badsArms(xs: Coll.List[El.Arm]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    TT.bads(b) + TT.badsArms(rest)

def TT.badsStmts(xs: Coll.List[El.Stmt]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(s, rest) =>
    val k = s match
      case El.Val(_, _, _, _, e) => TT.bads(e)
      case El.Do(e) => TT.bads(e)
      case El.Handle(_, _, _, args) => TT.badsAll(args)
    k + TT.badsStmts(rest)

// ── B1 mono: the instances (callee [args]) in worklist order; ground = no var in any instance's args ──
def TT.insts {r: Region} (is: Coll.List[Mono.Inst]): Unit = is match
  case Coll.Nil => ()
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, sub) = i
    val El.Fn(_, n, tps, _, _, _, _) = f
    tps match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        rt_print(Sym.str(n))
        rt_print("[")
        TT.terms(TT.subArgs(tps, sub, Coll.Nil))
        rt_print("]\n")
    TT.insts(rest)

def TT.subArgs {r: Region} (tps: Coll.List[Sym.Sym], sub: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = tps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(x, rest) => Ty.lookup(sub, x) match
    case Coll.Some(t) => TT.subArgs(rest, sub, Coll.Cons(t, acc))
    case Coll.None => TT.subArgs(rest, sub, acc)

// generic instances, and how many have a var left in their args
def TT.genericCount(is: Coll.List[Mono.Inst], n: I64): I64 = is match
  case Coll.Nil => n
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, _) = i
    val El.Fn(_, _, tps, _, _, _, _) = f
    TT.genericCount(rest, n + (if Coll.length(tps) > 0 then 1 else 0))

def TT.openCount(is: Coll.List[Mono.Inst], n: I64): I64 = is match
  case Coll.Nil => n
  case Coll.Cons(i, rest) =>
    val Mono.Inst(_, sub) = i
    TT.openCount(rest, n + TT.openSub(sub))

def TT.openSub(sub: Coll.List[Ty.Bind]): I64 = sub match
  case Coll.Nil => 0
  case Coll.Cons(b, rest) =>
    val Ty.Bind(_, t) = b
    (if Ty.groundT(t) then 0 else 1) + TT.openSub(rest)
