// s2 self-host rung T1 (vic/c/s2-selfhost.md): type inference. the oracle is s1: s2's own sources and the prelude are
// accepted by s1, so they must type with no clash and every generic call solved; then one program per clash kind
def TT.parseAll {r: Region} (ps: Coll.List[Str], acc: Coll.List[Ast.Decl]): Coll.List[Ast.Decl] = ps match
  case Coll.Nil => acc
  case Coll.Cons(p, rest) => Parse.source(Files.read(p)) match
    case Parse.Ok(ds, _) => TT.parseAll(rest, Coll.revOnto(Coll.rev(ds), acc))
    case Parse.Err(line, _) =>
      Console.print("parse error ")
      Console.print(p)
      Console.print(" ")
      Console.printI64(line)
      Console.print("\n")
      TT.parseAll(rest, acc)

// the prelude and every s2 source (a new s2 file goes here too)
def TT.sources {r: Region} (): Coll.List[Str] =
  val a = Coll.Cons("lib/prelude.srs", Coll.Cons("s2/ast.srs", Coll.Cons("s2/b3.srs", Coll.Cons("s2/bmap.srs", Coll.Cons("s2/coll.srs", Coll.Cons("s2/datalog.srs", Coll.Cons("s2/eff.srs", Coll.Cons("s2/elab.srs", Coll.Cons("s2/elgate.srs", Coll.Cons("s2/emit.srs", Coll.Cons("s2/eval.srs", Coll.Cons("s2/facts.srs", Coll.Cons("s2/mono.srs", Coll.Nil)))))))))))))
  val b = Coll.Cons("s2/flow.srs", Coll.Cons("s2/hash.srs", Coll.Cons("s2/kanren.srs", Coll.Cons("s2/kfd.srs", Coll.Cons("s2/ksearch.srs", Coll.Cons("s2/lex.srs", Coll.Nil))))))
  val c = Coll.Cons("s2/names.srs", Coll.Cons("s2/parse.srs", Coll.Cons("s2/pure.srs", Coll.Cons("s2/queue.srs", Coll.Cons("s2/store.srs", Coll.Cons("s2/sym.srs", Coll.Cons("s2/tlevel.srs", Coll.Cons("s2/types.srs", Coll.Nil))))))))
  Coll.revOnto(Coll.rev(a), Coll.revOnto(Coll.rev(b), c))

def TT.show(c: Ty.Clash): Unit = c match
  case Ty.Mismatch(l, _, _) => TT.say("mismatch", l)
  case Ty.Unknown(l, n) => TT.sayN("unknown", l, n)
  case Ty.Arity(l, n) => TT.sayN("arity", l, n)
  case Ty.NotEnum(l, _) => TT.say("notenum", l)
  case Ty.NoOp(l, n) => TT.sayN("noop", l, n)
  case Ty.CannotInfer(l, n) => TT.sayN("cannotinfer", l, n)
  case Ty.NoCap(l, p) => TT.sayN("nocap", l, p)
  case Ty.Impure(l, n) => TT.sayN("impure", l, n)
  case Ty.ComptimeHandle(l, h) => TT.sayN("comptimehandle", l, h)
  case Ty.PureRules(rel) => TT.sayN("purerules", 0, rel)
  case Ty.NotExhaustive(l, c) => TT.sayN("notexhaustive", l, c)
  case Ty.PatArity(l, c) => TT.sayN("patarity", l, c)
  case Ty.NoGiven(l, _) => TT.say("nogiven", l)
  case Ty.AmbigGivens(l, _) => TT.say("ambiggivens", l)
  case Ty.AmbigEvidence(l, _) => TT.say("ambigevidence", l)
  case Ty.GivenFuel(l, _) => TT.say("givenfuel", l)
  case Ty.ChosenBad(l, _) => TT.say("chosenbad", l)
  case Ty.ChosenCount(l, f) => TT.sayN("chosencount", l, f)
  case Ty.ChosenNotCap(l, p) => TT.sayN("chosennotcap", l, p)
  case Ty.EvidenceValue(l, x) => TT.sayN("evidencevalue", l, x)
  case Ty.CapValue(l, x) => TT.sayN("capvalue", l, x)
  case Ty.BinderHides(l, x) => TT.sayN("binderhides", l, x)
  case Ty.CapParam(l, x) => TT.sayN("capparam", l, x)
  case Ty.CapErased(l, p) => TT.sayN("caperased", l, p)
  case Ty.NotTrait(l, n) => TT.sayN("nottrait", l, n)
  case Ty.ResumeNotK(l, k) => TT.sayN("resumenotk", l, k)
  case Ty.AnswerType(l, op) => TT.sayN("answertype", l, op)
  case Ty.MultishotShape(l, p) => TT.sayN("multishotshape", l, p)
  case Ty.TraitArity(l, t) => TT.sayN("traitarity", l, t)
  case Ty.NotMethod(l, m) => TT.sayN("notmethod", l, m)
  case Ty.MissingMethod(l, m) => TT.sayN("missingmethod", l, m)
  case Ty.SigDiffers(l, m) => TT.sayN("sigdiffers", l, m)
  case Ty.NotInHead(l, x) => TT.sayN("notinhead", l, x)
  case Ty.ExternSlot(l, _) => TT.say("externslot", l)
  case Ty.UnhandledEffect(l, p) => TT.sayN("unhandled", l, p)
  case Ty.GivenRow(l, p) => TT.sayN("givenrow", l, p)
  case Ty.RtOutsideSrs(l, f) => TT.sayN("rtoutside", l, f)
  case Ty.LibcOutsideHandler(l, f) => TT.sayN("libcoutside", l, f)
  case Ty.ValAtRunTime(l, x) => TT.sayN("valrun", l, x)
  case Ty.IntRange(l, _) => TT.say("intrange", l)
  case Ty.AssignVal(l, x) => TT.sayN("assignval", l, x)
  case Ty.IndexUnproved(l, x) => TT.sayN("indexunproved", l, x)
  case Ty.SliceUnproved(l, f) => TT.sayN("sliceunproved", l, f)
  case Ty.LenUnnamed(l, x) => TT.sayN("lenunnamed", l, x)
  case Ty.PutData(l, x) => TT.sayN("putdata", l, x)
  case Ty.NestedPattern(l, x) => TT.sayN("nestedpattern", l, x)

def TT.say(k: Str, l: I64): Unit =
  Console.print(" ")
  Console.print(k)
  Console.print(" ")
  Console.printI64(l)

def TT.sayN(k: Str, l: I64, n: Sym.Sym): Unit =
  TT.say(k, l)
  Console.print(" ")
  Console.print(Sym.str(n))

def TT.showAll(cs: Coll.List[Ty.Clash]): Unit = cs match
  case Coll.Nil => ()
  case Coll.Cons(c, rest) =>
    TT.show(c)
    TT.showAll(rest)

def TT.typed(ds: Coll.List[Ast.Decl]): Ty.Typed = Ty.typed(ds, Names.UsesArrays)

def TT.run {r: Region} (name: Str, ds: Coll.List[Ast.Decl]): Unit = TT.report(name, TT.checked(TT.typed(ds)))

// a check that stopped before types prints why; an empty result follows so the report stays one line
def TT.checked(t: Ty.Typed): Ty.Result = t match
  case Ty.Checked(_, _, res) => res
  case Ty.RowsBad(rel) => Ty.Result(Coll.Cons(Ty.PureRules(rel), Coll.Nil), Coll.Nil, Coll.Tip, Coll.Nil, Coll.Nil, Coll.Nil)
  case Ty.TlBad(_) =>
    Console.print(" tl-errors")
    Ty.Result(Coll.Nil, Coll.Nil, Coll.Tip, Coll.Nil, Coll.Nil, Coll.Nil)

def TT.report {r: Region} (name: Str, res: Ty.Result): Unit =
  Console.print(name)
  Console.print(":")
  val Ty.Result(cs, _, _, _, _, _) = res
  cs match
    case Coll.Nil => Console.print(" ok")
    case Coll.Cons(_, _) => TT.showAll(Coll.rev(cs))
  Console.print("\n")

def TT.src {r: Region} (s: Str): Coll.List[Ast.Decl] = Parse.source(s) match
  case Parse.Ok(ds, _) => ds
  case Parse.Err(_, _) => Coll.Nil

def main(): I64 =
  handle r = Srs.Arena()
  handle c = Srs.Console()
  handle fs = Srs.Files()
  val lib = TT.parseAll(TT.sources(), Coll.Nil)
  // the whole self check once: its clashes, instances, defs and mono
  val self = TT.checked(TT.typed(lib))
  TT.report("self", self)
  val Ty.Result(_, is, _, sfs, _, _) = self
  val mi = Mono.run(self)
  Console.print("mono self: generic instances over 100: ")
  Console.printI64(if TT.genericCount(mi, 0) > 100 then 1 else 0)
  Console.print(", open: ")
  Console.printI64(TT.openCount(mi, 0))
  Console.print("\n")
  Console.print("bad nodes in self: ")
  Console.printI64(TT.badsFns(sfs, 0))
  Console.print("\n")
  Console.print("instances over 1000: ")
  Console.printI64(if Coll.length(is) > 1000 then 1 else 0)
  Console.print("\n")
  // the clash probes need only the prelude, Coll and Sym: they re-check this small lib, not the whole self (each whole check is 0.15 s)
  val small = TT.parseAll(Coll.Cons("lib/prelude.srs", Coll.Cons("s2/coll.srs", Coll.Cons("s2/sym.srs", Coll.Nil))), Coll.Nil)
  TT.run("trait_args", Coll.revOnto(Coll.rev(TT.src("def fold1 [X: Type] [Y: Type] {f: Coll.Fold[Y, X, I64]} (x: X): I64 = f.step(0, x)\n")), small))
  TT.run("mismatch", Coll.revOnto(Coll.rev(TT.src("def f(): I64 = true\n")), small))
  TT.run("arity", Coll.revOnto(Coll.rev(TT.src("def g(x: I64): I64 = x\ndef f(): I64 = g(1, 2)\n")), small))
  TT.run("unknown", Coll.revOnto(Coll.rev(TT.src("def f(): I64 = nope(1)\n")), small))
  TT.run("cannotinfer", Coll.revOnto(Coll.rev(TT.src("def f(): I64 = Coll.length(Coll.Nil)\n")), small))
  Console.print("elab usem:\n")
  TT.elab("def mk {r: Region} (n: I64): Coll.List[I64] = Coll.Cons(n, Coll.Nil)\ndef pair {p: Region} {q: Region} (): I64 = 0\ndef rv [A: Type] {r: Region} (xs: Coll.List[A]): Coll.List[A] = Coll.rev(xs)\ndef usem(): I64 =\n  handle a = Srs.Arena()\n  handle b = Srs.Heap()\n  val xs = mk{b}(3)\n  Coll.length(rv{a}(xs)) + Coll.length(mk{a}(1)) + pair{a, b}()\n", small, "usem")
  Console.print("mono usem:\n")
  TT.insts(Mono.run(TT.checked(TT.typed(Coll.revOnto(Coll.rev(TT.src("def mk {r: Region} (n: I64): Coll.List[I64] = Coll.Cons(n, Coll.Nil)\ndef usem(): I64 =\n  handle a = Srs.Arena()\n  Coll.length(Coll.rev(mk(3)))\n")), TT.parseAll(Coll.Cons("lib/prelude.srs", Coll.Cons("s2/coll.srs", Coll.Cons("s2/sym.srs", Coll.Nil))), Coll.Nil))))))
  0

// ── T3: the elaborated calls of one def: instance, type args (reified), caps; constructors with their region ──
def TT.term(t: K.Term): Unit = t match
  case K.Var(n) =>
    Console.print("?")
    Console.printI64(n)
  case K.Int(v) => Console.printI64(v)
  case K.Con(f, args) =>
    Console.print(Sym.str(f))
    args match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print("[")
        TT.terms(args)
        Console.print("]")

def TT.terms(ts: Coll.List[K.Term]): Unit = ts match
  case Coll.Nil => ()
  case Coll.Cons(t, rest) =>
    TT.term(t)
    rest match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(", ")
        TT.terms(rest)

def TT.reified {r: Region} (s: K.Subst, ts: Coll.List[K.Term], acc: Coll.List[K.Term]): Coll.List[K.Term] = ts match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(t, rest) => TT.reified(s, rest, Coll.Cons(K.reify(s, t), acc))

def TT.syms(xs: Coll.List[Sym.Sym]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    Console.print(" ")
    Console.print(Sym.str(x))
    TT.syms(rest)

// the calls of e, in evaluation order (args first)
def TT.calls {r: Region} (s: K.Subst, e: El.Expr): Unit = e match
  case El.CallFn(_, f, ts, caps, args) =>
    TT.callsAll(s, args)
    Console.print(Sym.str(f))
    Console.print("[")
    TT.terms(TT.reified(s, ts, Coll.Nil))
    Console.print("] caps")
    TT.syms(caps)
    Console.print("\n")
  case El.New(_, en, ts, c, at, args) =>
    TT.callsAll(s, args)
    Console.print("new ")
    Console.print(Sym.str(c))
    Console.print(" : ")
    TT.term(K.reify(s, K.Con(en, ts)))
    Console.print(" in ")
    TT.alloc(at)
    Console.print("\n")
  case El.Nullary(_, en, ts, c) =>
    Console.print(Sym.str(c))
    Console.print(" : ")
    TT.term(K.reify(s, K.Con(en, ts)))
    Console.print("\n")
  case El.Block(_, ss, last) =>
    TT.stmts(s, ss)
    TT.calls(s, last)
  case El.Bin(_, _, l, rhs) =>
    TT.calls(s, l)
    TT.calls(s, rhs)
  case El.Un(_, _, x) => TT.calls(s, x)
  case El.If(_, c, t, x) =>
    TT.calls(s, c)
    TT.calls(s, t)
    TT.calls(s, x)
  case El.Op(_, _, _, _, args) => TT.callsAll(s, args)
  case El.While(_, c, b) =>
    TT.calls(s, c)
    TT.calls(s, b)
  case El.Assign(_, _, x) => TT.calls(s, x)
  case El.Match(_, x, _, _) => TT.calls(s, x)
  case _ => ()

def TT.callsAll {r: Region} (s: K.Subst, xs: Coll.List[El.Expr]): Unit = xs match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    TT.calls(s, x)
    TT.callsAll(s, rest)

def TT.stmts {r: Region} (s: K.Subst, ss: Coll.List[El.Stmt]): Unit = ss match
  case Coll.Nil => ()
  case Coll.Cons(x, rest) =>
    x match
      case El.Val(_, _, _, _, e) => TT.calls(s, e)
      case El.Do(e) => TT.calls(s, e)
      case El.Handle(_, _, _, _, _) => ()
    TT.stmts(s, rest)

def TT.elab {r: Region} (src: Str, lib: Coll.List[Ast.Decl], name: Str): Unit =
  val Ty.Result(cs, _, s, fs, _, _) = TT.checked(TT.typed(Coll.revOnto(Coll.rev(TT.src(src)), lib)))
  TT.showAll(cs)
  TT.fnCalls(s, fs, Sym.of(name))

def TT.fnCalls {r: Region} (s: K.Subst, fs: Coll.List[El.Fn], name: Sym.Sym): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    val El.Fn(_, n, _, _, _, _, body) = f
    if Sym.eq(n, name) then
      body match
        case El.Def(e) => TT.calls(s, e)
        case _ => ()
    else TT.fnCalls(s, rest, name)

// El.Bad nodes in an elaborated program: 0 when it typed (a mutant that drops an elaboration shows up here)
def TT.badsFns(fs: Coll.List[El.Fn], n: I64): I64 = fs match
  case Coll.Nil => n
  case Coll.Cons(f, rest) =>
    val El.Fn(_, _, _, _, _, _, body) = f
    val k = body match
      case El.Def(e) => TT.bads(e)
      case _ => 0
    TT.badsFns(rest, n + k)

def TT.bads(e: El.Expr): I64 = e match
  case El.Bad(_) => 1
  case El.CallFn(_, _, _, _, args) => TT.badsAll(args)
  case El.New(_, _, _, _, _, args) => TT.badsAll(args)
  case El.Op(_, _, _, _, args) => TT.badsAll(args)
  case El.Bin(_, _, l, rhs) => TT.bads(l) + TT.bads(rhs)
  case El.Un(_, _, x) => TT.bads(x)
  case El.If(_, c, t, x) => TT.bads(c) + TT.bads(t) + TT.bads(x)
  case El.Match(_, x, _, arms) => TT.bads(x) + TT.badsArms(arms)
  case El.Block(_, ss, last) => TT.badsStmts(ss) + TT.bads(last)
  case El.While(_, c, b) => TT.bads(c) + TT.bads(b)
  case El.Assign(_, _, x) => TT.bads(x)
  case _ => 0

def TT.badsAll(xs: Coll.List[El.Expr]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(x, rest) => TT.bads(x) + TT.badsAll(rest)

def TT.badsArms(xs: Coll.List[El.Arm]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(a, rest) =>
    val El.Arm(_, _, b) = a
    TT.bads(b) + TT.badsArms(rest)

def TT.badsStmts(xs: Coll.List[El.Stmt]): I64 = xs match
  case Coll.Nil => 0
  case Coll.Cons(s, rest) =>
    val k = s match
      case El.Val(_, _, _, _, e) => TT.bads(e)
      case El.Do(e) => TT.bads(e)
      case El.Handle(_, _, _, _, args) => TT.badsAll(args)
    k + TT.badsStmts(rest)

// ── B1 mono: the instances (callee [args]) in worklist order; ground = no var in any instance's args ──
def TT.insts {r: Region} (is: Coll.List[Mono.Inst]): Unit = is match
  case Coll.Nil => ()
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, sub, _) = i
    val El.Fn(_, n, tps, _, _, _, _) = f
    tps match
      case Coll.Nil => ()
      case Coll.Cons(_, _) =>
        Console.print(Sym.str(n))
        Console.print("[")
        TT.terms(TT.subArgs(tps, sub, Coll.Nil))
        Console.print("]\n")
    TT.insts(rest)

def TT.subArgs {r: Region} (tps: Coll.List[Sym.Sym], sub: Coll.List[Ty.Bind], acc: Coll.List[K.Term]): Coll.List[K.Term] = tps match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(x, rest) => Ty.lookup(sub, x) match
    case Coll.Some(t) => TT.subArgs(rest, sub, Coll.Cons(t, acc))
    case Coll.None => TT.subArgs(rest, sub, acc)

// generic instances, and how many have a var left in their args
def TT.genericCount(is: Coll.List[Mono.Inst], n: I64): I64 = is match
  case Coll.Nil => n
  case Coll.Cons(i, rest) =>
    val Mono.Inst(f, _, _) = i
    val El.Fn(_, _, tps, _, _, _, _) = f
    TT.genericCount(rest, n + (if Coll.length(tps) > 0 then 1 else 0))

def TT.openCount(is: Coll.List[Mono.Inst], n: I64): I64 = is match
  case Coll.Nil => n
  case Coll.Cons(i, rest) =>
    val Mono.Inst(_, sub, _) = i
    TT.openCount(rest, n + TT.openSub(sub))

def TT.openSub(sub: Coll.List[Ty.Bind]): I64 = sub match
  case Coll.Nil => 0
  case Coll.Cons(b, rest) => b match
    case Ty.Bind(_, t) => (if Ty.groundT(t) then 0 else 1) + TT.openSub(rest)
    // a mono sub binds [] binders only (Ty.Bind); the A1 cases are locals
    case _ => TT.openSub(rest)

def TT.alloc(a: El.Alloc): Unit = a match
  case El.In(reg) => Console.print(Sym.str(reg))
  case El.Comptime => Console.print("comptime")
