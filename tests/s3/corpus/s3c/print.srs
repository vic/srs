// s3c PARSE-1b: the AST printer, in s2. It prints a def or enum node back as source text: each token's source text, the
// punctuation as literals, layout from the structure: ind = the indent of the line being written, a block is at ind + 2.
// The oracle relexes this text (skip mode) and compares it with the decl's own tokens. Spacing only matters for a `<` (glued to the
// token before it iff the source token was an ltglued) and for tokens that would merge: a name next to a name gets a space.

def Pr.s(x: Str): Unit = Console.print(x)
def Pr.tok(g: Na.G, j: I64): Unit = Console.print(Na.text(g, j))

def Pr.spaces(n: I64): Unit =
  if n > 0 then
    Console.print(" ")
    Pr.spaces(n - 1)
  else ()

// a new line at indent n
def Pr.line(n: I64): Unit =
  Console.print("\n")
  Pr.spaces(n)

// token ids of the list r, separated by ", "
def Pr.toks(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(", ") else ()
    Pr.tok(g, Na.item(g, r, i))
    Pr.toks(g, r, i + 1)
  else ()

// ── types, groups ──
def Pr.tys(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(", ") else ()
    Pr.ty(g, Na.item(g, r, i))
    Pr.tys(g, r, i + 1)
  else ()

def Pr.ty(g: Na.G, n: I64): Unit =
  val k = Na.kd(g, n)
  if k == Na.kTyCaps() then
    Pr.ty(g, Na.a(g, n))
    Pr.s("<")
    Pr.toks(g, Na.b(g, n), 0)
    Pr.s(">")
  else
    Pr.tok(g, Na.tok(g, n))
    if Na.a(g, n) != 0 then
      Pr.s("[")
      Pr.tys(g, Na.a(g, n), 0)
      Pr.s("]")
    else ()
    if Na.b(g, n) != 0 then
      Pr.s("(")
      Pr.exprs(g, Na.b(g, n), 0, 0)
      Pr.s(")")
    else ()

def Pr.binders(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(", ") else ()
    val b = Na.item(g, r, i)
    val bk = Na.kd(g, b)
    if bk == Na.kBind() then
      Pr.tok(g, Na.tok(g, b))
      Pr.s(": ")
      Pr.ty(g, Na.a(g, b))
    else if bk == Na.kBare() then Pr.tok(g, Na.tok(g, b))
    else if bk == Na.kDots() then Pr.s("...")
    else Pr.ty(g, Na.a(g, b))
    Pr.binders(g, r, i + 1)
  else ()

def Pr.atom(g: Na.G, n: I64): Unit =
  val k = Na.kd(g, n)
  Pr.tok(g, Na.tok(g, n))
  if k == Na.kAtomCall() then
    Pr.s("(")
    Pr.toks(g, Na.a(g, n), 0)
    Pr.s(")")
  else if k == Na.kAtomAt() then
    Pr.s(": ")
    Pr.tok(g, Na.a(g, n))
  else if k == Na.kAtomInf() then
    Pr.s(" ")
    Pr.tok(g, Na.a(g, n))
    Pr.s(" ")
    Pr.tok(g, Na.b(g, n))
  else
    Pr.s(" ")
    Pr.tok(g, Na.a(g, n))

def Pr.atoms(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(", ") else ()
    Pr.atom(g, Na.item(g, r, i))
    Pr.atoms(g, r, i + 1)
  else ()

// a header part: group, params, return type, exit facts, body
def Pr.part(g: Na.G, n: I64, ind: I64): Unit =
  val k = Na.kd(g, n)
  if k == Na.kGTypes() then
    Pr.s("[")
    Pr.binders(g, Na.a(g, n), 0)
    Pr.s("]")
  else if k == Na.kGEv() then
    Pr.s("{")
    Pr.binders(g, Na.a(g, n), 0)
    Pr.s("}")
  else if k == Na.kGFacts() || k == Na.kExit() then
    Pr.s(" <")
    Pr.atoms(g, Na.a(g, n), 0)
    Pr.s(">")
  else if k == Na.kParams() then
    Pr.s("(")
    Pr.binders(g, Na.a(g, n), 0)
    Pr.s(")")
  else if k == Na.kRet() then
    Pr.s(": ")
    Pr.ty(g, Na.a(g, n))
  else if k == Na.kBody() then
    Pr.s(" = ")
    Pr.rhs(g, Na.a(g, n), ind)
  else if k == Na.kClause() then
    Pr.line(ind + 2)
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" ")
    Pr.expr(g, Na.a(g, n), ind + 2)
  else if k == Na.kProofUs() then
    Pr.line(ind + 2)
    Pr.s("proof using ")
    Pr.toks(g, Na.a(g, n), 0)
  else if k == Na.kProofInd() then
    Pr.line(ind + 2)
    Pr.s("proof by induction ")
    Pr.tok(g, Na.a(g, n))
  else if k == Na.kProofLean() then
    Pr.line(ind + 2)
    Pr.s("proof lean ")
    Pr.tok(g, Na.a(g, n))
  else if k == Na.kEntry() then
    Pr.s(" <")
    Pr.toksSp(g, Na.a(g, n), 0)
    Pr.s(">")
  else if k == Na.kOpRet() || k == Na.kOpRetC() then
    Pr.s(": ")
    Pr.ty(g, Na.a(g, n))
    if k == Na.kOpRetC() then
      Pr.s("{")
      Pr.toks(g, Na.b(g, n), 0)
      Pr.s("}")
    else ()
  else if k == Na.kExitSt() then
    Pr.s(" <")
    Pr.tok(g, Na.a(g, n))
    Pr.s(">")
  else if k == Na.kHAns() then
    Pr.s(" [")
    Pr.tok(g, Na.a(g, n))
    Pr.s(": Type]")
  else if k == Na.kHFor() then
    Pr.s(" for ")
    Pr.tok(g, Na.a(g, n))
  else if k == Na.kAlias() then
    Pr.s(" = ")
    Pr.ty(g, Na.a(g, n))
  else if k == Na.kTyMatch() then
    Pr.s(" = ")
    Pr.ty(g, Na.a(g, n))
    Pr.s(" match")
    Pr.tarms(g, Na.b(g, n), 0, ind)
  else if k == Na.kValMatch() then
    Pr.s(" = ")
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" match")
    Pr.tarms(g, Na.b(g, n), 0, ind)
  else ()

// token ids of the list r, separated by a space
def Pr.toksSp(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(" ") else ()
    Pr.tok(g, Na.item(g, r, i))
    Pr.toksSp(g, r, i + 1)
  else ()

// case ty => ty and case value => ty arms
def Pr.tarms(g: Na.G, r: I64, i: I64, ind: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    Pr.line(ind + 2)
    Pr.s("case ")
    if Na.kd(g, n) == Na.kTArm() then Pr.ty(g, Na.a(g, n)) else Pr.tok(g, Na.a(g, n))
    Pr.s(" => ")
    Pr.ty(g, Na.b(g, n))
    Pr.tarms(g, r, i + 1, ind)
  else ()

// the parts of a def at indent ind; the `=` after clauses goes on a line of its own
def Pr.parts(g: Na.G, r: I64, i: I64, ind: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kBody() && i > 0 && Pr.isClause(Na.kd(g, Na.item(g, r, i - 1))) then
      Pr.line(ind)
      Pr.s("= ")
      Pr.rhs(g, Na.a(g, n), ind)
    else Pr.part(g, n, ind)
    Pr.parts(g, r, i + 1, ind)
  else ()

def Pr.isClause(k: I64): Bool = k == Na.kClause() || k == Na.kProofUs() || k == Na.kProofInd() || k == Na.kProofLean()

// ── expressions ──
def Pr.exprs(g: Na.G, r: I64, i: I64, ind: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(", ") else ()
    Pr.expr(g, Na.item(g, r, i), ind)
    Pr.exprs(g, r, i + 1, ind)
  else ()

def Pr.callGroups(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kCGTys() then
      Pr.s("[")
      Pr.tys(g, Na.a(g, n), 0)
      Pr.s("]")
    else
      Pr.s("{")
      Pr.toks(g, Na.a(g, n), 0)
      Pr.s("}")
    Pr.callGroups(g, r, i + 1)
  else ()

def Pr.pat(g: Na.G, n: I64): Unit =
  val k = Na.kd(g, n)
  Pr.tok(g, Na.tok(g, n))
  if k == Na.kPCase() then
    Pr.s("(")
    Pr.toks(g, Na.a(g, n), 0)
    Pr.s(")")
  else ()

def Pr.arms(g: Na.G, r: I64, i: I64, ind: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    Pr.line(ind + 2)
    Pr.s("case ")
    Pr.pat(g, Na.a(g, n))
    Pr.s(" => ")
    Pr.rhs(g, Na.b(g, n), ind + 2)
    Pr.arms(g, r, i + 1, ind)
  else ()

// the right side of =, then, else, do, =>: a block goes on its own lines
def Pr.rhs(g: Na.G, n: I64, ind: I64): Unit =
  if Na.kd(g, n) == Na.kBlock() then Pr.stmts(g, Na.a(g, n), 0, ind + 2)
  else Pr.expr(g, n, ind)

def Pr.stmts(g: Na.G, r: I64, i: I64, ind: I64): Unit =
  if i < Na.len(g, r) then
    Pr.line(ind)
    Pr.stmt(g, Na.item(g, r, i), ind)
    Pr.stmts(g, r, i + 1, ind)
  else ()

def Pr.stmt(g: Na.G, n: I64, ind: I64): Unit =
  val k = Na.kd(g, n)
  if k == Na.kVal() || k == Na.kVar() then
    if k == Na.kVal() then Pr.s("val ") else Pr.s("var ")
    Pr.tok(g, Na.tok(g, n))
    if Na.a(g, n) != 0 then
      Pr.s(": ")
      Pr.ty(g, Na.a(g, n))
    else ()
    Pr.s(" = ")
    Pr.rhs(g, Na.b(g, n), ind)
  else if k == Na.kPatVal() then
    Pr.s("val ")
    Pr.tok(g, Na.tok(g, n))
    Pr.s("(")
    Pr.toks(g, Na.a(g, n), 0)
    Pr.s(") = ")
    Pr.rhs(g, Na.b(g, n), ind)
  else if k == Na.kHandle() then
    Pr.s("handle ")
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" = ")
    Pr.tok(g, Na.a(g, n))
    Pr.s("(")
    Pr.exprs(g, Na.b(g, n), 0, ind)
    Pr.s(")")
  else if k == Na.kCheck() then
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" ")
    Pr.expr(g, Na.a(g, n), ind)
  else Pr.expr(g, Na.a(g, n), ind)

// a binary < written glued to its left operand stays glued
def Pr.bin(g: Na.G, n: I64, ind: I64): Unit =
  Pr.expr(g, Na.a(g, n), ind)
  if Na.cls(g, Na.tok(g, n)) == Kc.ltg() then
    Pr.s("<")
    Pr.expr(g, Na.b(g, n), ind)
  else
    Pr.s(" ")
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" ")
    Pr.expr(g, Na.b(g, n), ind)

// the last token of the expression is a Dedent (a block or match arms close its lines), so a following else is on a new line
def Pr.endsDed(g: Na.G, n: I64): Bool =
  val k = Na.kd(g, n)
  if k == Na.kBlock() || k == Na.kMatch() then true
  else if k == Na.kIf() || k == Na.kIfNl() then Pr.endsDed(g, Na.b(g, Na.b(g, n)))
  else if k == Na.kWhile() then Pr.endsDed(g, Na.b(g, n))
  else if k == Na.kAssign() then Pr.endsDed(g, Na.a(g, n))
  else false

def Pr.ifE(g: Na.G, n: I64, ind: I64): Unit =
  val p = Na.b(g, n)
  val t = Na.a(g, p)
  Pr.s("if ")
  Pr.expr(g, Na.a(g, n), ind)
  Pr.s(" then ")
  Pr.rhs(g, t, ind)
  if Na.kd(g, n) == Na.kIfNl() || Pr.endsDed(g, t) then Pr.line(ind) else Pr.s(" ")
  Pr.s("else ")
  Pr.rhs(g, Na.b(g, p), ind)

def Pr.expr(g: Na.G, n: I64, ind: I64): Unit =
  val k = Na.kd(g, n)
  if k == Na.kInt() || k == Na.kStr() || k == Na.kChar() || k == Na.kName() then Pr.tok(g, Na.tok(g, n))
  else if k == Na.kUnit() then Pr.s("()")
  else if k == Na.kParen() then
    Pr.s("(")
    Pr.expr(g, Na.a(g, n), ind)
    Pr.s(")")
  else if k == Na.kCall() then
    Pr.tok(g, Na.tok(g, n))
    Pr.callGroups(g, Na.a(g, n), 0)
    Pr.s("(")
    Pr.exprs(g, Na.b(g, n), 0, ind)
    Pr.s(")")
  else if k == Na.kMethod() then
    Pr.tok(g, Na.tok(g, n))
    Pr.s(".")
    Pr.tok(g, Na.a(g, n))
    Pr.s("(")
    Pr.exprs(g, Na.b(g, n), 0, ind)
    Pr.s(")")
  else if k == Na.kResume() then
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" ")
    Pr.tok(g, Na.a(g, n))
    Pr.s("(")
    Pr.expr(g, Na.b(g, n), ind)
    Pr.s(")")
  else if k == Na.kBin() then Pr.bin(g, n, ind)
  else if k == Na.kUn() then
    Pr.tok(g, Na.tok(g, n))
    Pr.expr(g, Na.a(g, n), ind)
  else if k == Na.kIf() || k == Na.kIfNl() then Pr.ifE(g, n, ind)
  else if k == Na.kMatch() then
    Pr.expr(g, Na.a(g, n), ind)
    Pr.s(" match")
    Pr.arms(g, Na.b(g, n), 0, ind)
  else if k == Na.kWhile() then
    Pr.s("while ")
    Pr.expr(g, Na.a(g, n), ind)
    if Pr.endsDed(g, Na.a(g, n)) then
      Pr.line(ind)
      Pr.s("do ")
    else Pr.s(" do ")
    Pr.rhs(g, Na.b(g, n), ind)
  else if k == Na.kAssign() then
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" = ")
    Pr.rhs(g, Na.a(g, n), ind)
  else if k == Na.kBlock() then Pr.rhs(g, n, ind)
  else if k == Na.kQuant() then
    Pr.tok(g, Na.tok(g, n))
    Pr.s(" ")
    Pr.tok(g, Na.tok(g, Na.a(g, n)))
    Pr.s(": ")
    Pr.ty(g, Na.a(g, Na.a(g, n)))
    Pr.s(" => ")
    Pr.expr(g, Na.b(g, n), ind)
  else ()

// ── decls ──
def Pr.cases(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    val k = Na.kd(g, n)
    if k == Na.kCase() then
      Pr.line(2)
      Pr.s("case ")
      Pr.tok(g, Na.tok(g, n))
      Pr.s("(")
      Pr.binders(g, Na.a(g, n), 0)
      Pr.s(")")
    else if k == Na.kCaseNP() then
      Pr.line(2)
      Pr.s("case ")
      Pr.tok(g, Na.tok(g, n))
    else ()
    Pr.cases(g, r, i + 1)
  else ()

// a def at indent ind
def Pr.defN(g: Na.G, n: I64, ind: I64): Unit =
  Pr.s("def ")
  Pr.tok(g, Na.a(g, n))
  Pr.parts(g, Na.b(g, n), 0, ind)

// the header items of the list r (all but the defs), inline
def Pr.inl(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kDef() then () else Pr.part(g, n, 0)
    Pr.inl(g, r, i + 1)
  else ()

// the defs of the list r, one per line at indent 2
def Pr.members(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kDef() then
      Pr.line(2)
      Pr.defN(g, n, 2)
    else ()
    Pr.members(g, r, i + 1)
  else ()

// A -> B, C -> D from the flat token list
def Pr.pairs(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    if i > 0 then Pr.s(", ") else ()
    Pr.tok(g, Na.item(g, r, i))
    Pr.s(" -> ")
    Pr.tok(g, Na.item(g, r, i + 1))
    Pr.pairs(g, r, i + 2)
  else ()

def Pr.capItem(g: Na.G, n: I64): Unit =
  val k = Na.kd(g, n)
  Pr.line(2)
  if k == Na.kStateL() then
    Pr.s("state ")
    Pr.toks(g, Na.a(g, n), 0)
  else if k == Na.kStart() then
    Pr.s("start ")
    Pr.tok(g, Na.a(g, n))
  else if k == Na.kStop() then
    Pr.s("stop ")
    Pr.toks(g, Na.a(g, n), 0)
  else if k == Na.kDrop() then
    Pr.s("drop ")
    Pr.tok(g, Na.a(g, n))
  else if k == Na.kTrans() then
    Pr.s("transition ")
    Pr.tok(g, Na.a(g, n))
    Pr.s(" ")
    Pr.pairs(g, Na.b(g, n), 0)
  else if k == Na.kRule() then
    val p = Na.b(g, n)
    Pr.s("rule def ")
    Pr.tok(g, Na.a(g, n))
    Pr.s("(")
    Pr.toks(g, Na.a(g, p), 0)
    Pr.s(") = ")
    Pr.atoms(g, Na.b(g, p), 0)
  else if k == Na.kCapDef() then Pr.defN(g, n, 2)
  else ()

def Pr.capItems(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    Pr.capItem(g, Na.item(g, r, i))
    Pr.capItems(g, r, i + 1)
  else ()

// the field lines of an extern struct
def Pr.fields(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val f = Na.item(g, r, i)
    Pr.line(2)
    Pr.tok(g, Na.tok(g, f))
    Pr.s(": ")
    Pr.ty(g, Na.a(g, f))
    Pr.fields(g, r, i + 1)
  else ()

def Pr.extern(g: Na.G, n: I64): Unit =
  val k = Na.kd(g, n)
  if k == Na.kDef() then Pr.defN(g, n, 0)
  else if k == Na.kCStruct() then
    Pr.s("struct ")
    Pr.tok(g, Na.tok(g, n))
    Pr.s(":")
    Pr.fields(g, Na.b(g, n), 0)
  else if k == Na.kCVal() then
    Pr.s("val ")
    Pr.tok(g, Na.tok(g, n))
    Pr.s(": ")
    Pr.ty(g, Na.a(g, n))
  else ()

// the root of a decl (at indent 0)
def Pr.decl(g: Na.G, n: I64): Unit =
  val k = Na.kd(g, n)
  if k == Na.kDef() then Pr.defN(g, n, 0)
  else if k == Na.kEnum() then
    Pr.s("enum ")
    Pr.tok(g, Na.a(g, n))
    Pr.enumGroups(g, Na.b(g, n), 0)
    Pr.s(":")
    Pr.cases(g, Na.b(g, n), 0)
  else if k == Na.kExtern() then
    Pr.s("extern ")
    if Na.a(g, n) != 0 then
      Pr.tok(g, Na.a(g, n))
      Pr.s(" ")
    else ()
    Pr.extern(g, Na.b(g, n))
  else if k == Na.kHandler() then
    Pr.s("handler ")
    Pr.tok(g, Na.a(g, n))
    Pr.inl(g, Na.b(g, n), 0)
    Pr.s(":")
    Pr.members(g, Na.b(g, n), 0)
  else if k == Na.kProto() then
    Pr.s("capability ")
    Pr.tok(g, Na.a(g, n))
    Pr.s(":")
    Pr.capItems(g, Na.b(g, n), 0)
  else if k == Na.kTrait() then
    Pr.s("trait ")
    Pr.tok(g, Na.a(g, n))
    Pr.inl(g, Na.b(g, n), 0)
    Pr.s(":")
    Pr.members(g, Na.b(g, n), 0)
  else if k == Na.kGiven() then
    Pr.s("given")
    Pr.inl(g, Na.b(g, n), 0)
    Pr.s(" ")
    Pr.ty(g, Na.a(g, n))
    Pr.s(":")
    Pr.members(g, Na.b(g, n), 0)
  else if k == Na.kType() then
    Pr.s("type ")
    Pr.tok(g, Na.a(g, n))
    Pr.inl(g, Na.b(g, n), 0)
  else if k == Na.kVal() then Pr.stmt(g, n, 0)
  else ()

// the groups before the cases of an enum
def Pr.enumGroups(g: Na.G, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    val k = Na.kd(g, n)
    if k == Na.kCase() || k == Na.kCaseNP() then ()
    else
      Pr.part(g, n, 0)
      Pr.enumGroups(g, r, i + 1)
  else ()
