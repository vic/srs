// T-a clause input: requires / ensures / invariant / decreases are typed (scope 2). `s3c --types lib/prelude.srs`: clauses: checked=7
// untyped=0 mismatches=1. The one mismatch is line 18: an `ensures` that is an I64, not a Bool.
def C.inc(x: I64): I64
  requires x >= 0
  ensures result > x
  ensures forall v: I64 => v < result || v >= result
= x + 1
def C.loop(n: I64): I64
  requires 0 <= n
=
  var i = 0
  while i < n do
    invariant 0 <= i
    decreases n - i
    i = i + 1
  i
def C.bad(x: I64): I64
  ensures result + 1
= x
def main(): I64 = 0
