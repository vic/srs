enum Opt [A: Type]:
  case Some(v: A)
  case None
enum Mk:
  case Mk(n: I64)
type Al [A: Type] = Opt[A]
trait Show [A: Type]:
  def show(x: A): I64
capability Cx:
  state S
  start S
  def op <S> (n: I64): Mk <S>
handler Hx for Cx:
  def init(): Unit = ()
def f [A: Type] (x: A, y: Mk, z: Nope): Opt[A] = None
def g [A: Type] (A: I64, y: A): A = A
def main(): I64 =
  handle h = Hx()
  val v: Mk = Mk(1)
  0
