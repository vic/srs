// proof.dl: S1b-0 proof rules over the index-site facts of `s3c --idx-facts` (Souffle workbench, NOT our engine).
// codes: binder b = "2b", literal v = "2v+1" (odd), length of an unsized value = "L:ARR"; guard operands are symbols.
.decl def(d: number, file: symbol, line: number, name: symbol)
.decl site(d: number, s: number, pos: number, kind: number, arr: number, ix: number)
.decl lit(d: number, s: number, v: number)
.decl compound(d: number, s: number, text: symbol)
.decl arrlen(d: number, arr: number, n: symbol)
.decl scope(d: number, sc: number, lo: number, hi: number)
.decl guard(d: number, sc: number, kind: number, a: symbol, b: symbol)
.decl assign(d: number, v: number, pos: number)
.decl unsigned(d: number, b: number)
.input def
.input site
.input lit
.input compound
.input arrlen
.input scope
.input guard
.input assign
.input unsigned

// the length symbol of a site's array: the written one, or the value's own identity
.decl lenOf(d: number, s: number, l: symbol)
lenOf(d, s, n) :- site(d, s, _, _, a, _), arrlen(d, a, n), n != "own".
lenOf(d, s, cat("L:", to_string(a))) :- site(d, s, _, _, a, _), arrlen(d, a, "own").

.decl ixs(d: number, s: number, i: symbol)
ixs(d, s, to_string(ix)) :- site(d, s, _, _, _, ix), ix >= 0.

.decl inScope(d: number, s: number, sc: number)
inScope(d, s, sc) :- site(d, s, pos, _, _, _), scope(d, sc, lo, hi), lo <= pos, pos <= hi.

// a reassignment of the index binder inside the scope, at or after the scope start and before the site
.decl killed(d: number, s: number, sc: number)
killed(d, s, sc) :- site(d, s, pos, _, _, ix), ix >= 0, ix % 2 = 0, assign(d, ix / 2, ap), scope(d, sc, lo, _), inScope(d, s, sc), ap >= lo, ap < pos.
// the bound operand reassigned likewise (the length is a binder of the array value)
killed(d, s, sc) :- site(d, s, pos, _, arr, _), assign(d, arr, ap), scope(d, sc, lo, _), inScope(d, s, sc), ap >= lo, ap < pos.

.decl inLt(d: number, s: number)
inLt(d, s) :- ixs(d, s, i), lenOf(d, s, n), inScope(d, s, sc), guard(d, sc, 0, i, n), !killed(d, s, sc).
// slice bounds: `<= len` is enough
inLt(d, s) :- site(d, s, _, k, _, _), (k = 3 ; k = 4), ixs(d, s, i), lenOf(d, s, n), inScope(d, s, sc), guard(d, sc, 2, i, n), !killed(d, s, sc).
inLt(d, s) :- lit(d, s, v), lenOf(d, s, n), !contains("L:", n), to_number(n) % 2 = 1, v < to_number(n) / 2.

.decl inLo(d: number, s: number)
inLo(d, s) :- ixs(d, s, i), inScope(d, s, sc), guard(d, sc, 1, i, _), !killed(d, s, sc).
inLo(d, s) :- site(d, s, _, _, _, ix), ix >= 0, ix % 2 = 0, unsigned(d, ix / 2).
inLo(d, s) :- lit(d, s, v), v >= 0.

.decl proved(d: number, s: number)
proved(d, s) :- inLt(d, s), inLo(d, s).

.decl unproved(d: number, s: number)
unproved(d, s) :- site(d, s, _, _, _, _), !proved(d, s).

// causes of an unproved site, one per site (first match in this order)
.decl cause(d: number, s: number, c: symbol)
cause(d, s, "compound-index") :- unproved(d, s), site(d, s, _, _, _, -1).
cause(d, s, "array-not-local") :- unproved(d, s), site(d, s, _, _, 0, ix), ix != -1.
cause(d, s, "no-upper-guard") :- unproved(d, s), site(d, s, _, _, a, ix), ix != -1, a != 0, !inLt(d, s).
cause(d, s, "no-lower-bound") :- unproved(d, s), site(d, s, _, _, a, ix), ix != -1, a != 0, inLt(d, s), !inLo(d, s).

.decl total(n: number)
total(c) :- c = count : { site(_, _, _, _, _, _) }.
.decl nproved(n: number)
nproved(c) :- c = count : { proved(_, _) }.
.decl nunproved(n: number)
nunproved(c) :- c = count : { unproved(_, _) }.
.decl ndefs(n: number)
ndefs(c) :- c = count : { def(_, _, _, _) }.
.decl bycause(c: symbol, n: number)
bycause(c, n) :- cause(_, _, c), n = count : { cause(_, _, c) }.
.decl firstun(d: number, s: number, file: symbol, line: number, name: symbol, kind: number, c: symbol)
.decl siteline(d: number, s: number, line: number)
.input siteline
firstun(d, s, f, sl, nm, k, c) :- unproved(d, s), def(d, f, _, nm), site(d, s, _, k, _, _), cause(d, s, c), siteline(d, s, sl).
.output total
.output nproved
.output nunproved
.output ndefs
.output bycause
.output firstun
