pliveIn(v0, v1) :- puse(v0, v1).
pliveOut(v0, v1) :- pliveIn(v0, v2), predge(v2, v1).
pliveIn(v0, v1) :- pliveOut(v0, v1), !pdef(v0, v1).
pmoved(v0, v1) :- puse(v0, v1), !pliveOut(v0, v1).
reached(v1) :- reached(v0), call(v0, v1).
run(v1, v0) :- callIn(v0, v1).
run(v1, v2) :- callFree(v0, v1), run(v0, v2).
fills(v0, v1) :- siteIn(v0, v1).
fills(v0, v2) :- siteFree(v0, v1), run(v1, v2).
manyDef(v0) :- multi(v0).
manyDef(v0) :- loopCall(v0).
manyDef(v1) :- callFree(v0, v1), manyDef(v0).
live(v0) :- regionIn(v0, v1), reached(v1).
outl(v0, v1) :- inside(v1, v0).
outl(v0, v1) :- top(v1, v2), run(v2, v0).
outl(v0, v2) :- outl(v0, v1), outl(v1, v2).
eretR(v0) :- eret(v0).
eretR(v0) :- ealias(v0, v3), eretR(v3).
eretR(v0) :- efield(v0, v3), eretC(v3).
eretC(v0) :- eretR(v0).
eretC(v0) :- ealias(v0, v3), eretC(v3).
eretC(v0) :- eload(v0, v3), eretC(v3).
esinkR(v0) :- esink(v0).
esinkR(v0) :- ealias(v0, v3), esinkR(v3).
esinkR(v0) :- efield(v0, v3), esinkC(v3).
esinkC(v0) :- esinkR(v0).
esinkC(v0) :- ealias(v0, v3), esinkC(v3).
esinkC(v0) :- eload(v0, v3), esinkC(v3).
eretC(v0) :- eargOf(v0, v6, v7, v8), eretPC(v6, v7), eretC(v8).
esinkC(v0) :- eargOf(v0, v6, v7, v8), esinkPC(v6, v7).
esinkC(v0) :- eargOf(v0, v6, v7, v8), eretPC(v6, v7), esinkC(v8).
eretPC(v6, v7) :- eparam(v6, v7, v0), eretC(v0).
esinkPC(v6, v7) :- eparam(v6, v7, v0), esinkC(v0).
eretR(v0) :- eargOf(v0, v6, v7, v8), eretP(v6, v7), eretR(v8).
esinkR(v0) :- eargOf(v0, v6, v7, v8), esinkP(v6, v7).
esinkR(v0) :- eargOf(v0, v6, v7, v8), eretP(v6, v7), esinkR(v8).
eretP(v6, v7) :- eparam(v6, v7, v0), eretR(v0).
esinkP(v6, v7) :- eparam(v6, v7, v0), esinkR(v0).
eesc(v0) :- esiteNode(v0, v1), eretR(v1).
eesc(v0) :- esiteNode(v0, v1), esinkR(v1).
eshared(v0) :- emulti(v0).
eshared(v0) :- eunknown(v0).
eshared(v0) :- eflow(v3, v0), eshared(v3).
eshared(v0) :- eargOf(v3, v6, v7, v8), eshared(v3), eparam(v6, v7, v0).
eshared(v0) :- eretOf(v6, v11), eshared(v11), ecallOf(v0, v6).
eown(v0, v12) :- esm(v14, v13), fills(v13, v12), esiteNode(v14, v0).
erin(v0, v12) :- esm(v14, v13), fills(v13, v12), esiteNode(v14, v0).
erin(v0, v12) :- eflow(v3, v0), erin(v3, v12).
erin(v0, v12) :- eargOf(v3, v6, v7, v8), erin(v3, v12), eparam(v6, v7, v0).
erin(v0, v12) :- ecallIn(v0, v12).
erin(v0, v12) :- ecallFree(v0, v15), run(v15, v12).
erin(v0, v12) :- eargOf(v3, v6, v7, v0), erin(v3, v12), eretP(v6, v7).
emarg(v3, v6, v0) :- eargOf(v3, v6, v7, v8), eparam(v6, v7, v0).
emres(v11, v6, v8) :- eretOf(v6, v11), ecallOf(v8, v6).
ehasOwn(v0) :- eown(v0, v12).
enoRegion(v14) :- esiteOf(v14, v6), reached(v6), esiteNode(v14, v0), !ehasOwn(v0).
sunb(v0) :- sself(v0), sallocs(v0).
sunb(v0) :- sloopAlloc(v0).
sunb(v0) :- call(v0, v1), sunb(v1).
sneed(v0) :- call(v0, v1), sunb(v1).
sneed(v0) :- sloopAlloc(v0).
srunSink(v0) :- enode(v1, v0, 1), esinkR(v1).
srunSink(v0) :- enode(v1, v0, 2), esinkR(v1).
srunSink(v0) :- call(v0, v1), srunSink(v1).
snewRet(v0) :- enode(v1, v0, 1), eretR(v1).
snewRet(v0) :- enode(v1, v0, 2), eretR(v1).
