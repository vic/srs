// pass: vic-u2d U1b (vic: pure = no effects): a spec def calls pure defs, also mutually recursive ones
def sq(x: I64): I64 = x * x
def isEven(n: I64): Bool = if n == 0 then true else isOdd(n - 1)
def isOdd(n: I64): Bool = if n == 0 then false else isEven(n - 1)
spec def sqEven(x: I64): Bool = isEven(sq(x))

def main(): I64 =
  rt_print_i64(sq(3))
  if isEven(4) then rt_print(" even\n") else rt_print(" odd\n")
  0
