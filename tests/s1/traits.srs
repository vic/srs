// pass: BD4a-1 traits + givens (vic-9l7.6): a given's methods are the trait's, with the head's type args;
// calls through {} evidence come in BD4a-2
trait Show [A: Type]:
  def show(x: A): I64

enum Box [A: Type]:
  case Box(v: A)

given Show[I64]:
  def show(x: I64): I64 = x + 1

given [A: Type] Show[Box[A]]:
  def show(x: Box[A]): I64 = 7

def main(): I64 =
  rt_print_i64(1)
  rt_print("\n")
  0
