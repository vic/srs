// pass: Kanren K1 unify (lib/kanren.srs): bind both sides, chains, occurs check, clash, arity
def c0(r: Region, f: Str): Term = TCon(f, TNil)
def c1(r: Region, f: Str, a: Term): Term = TCon(f, TCons(a, TNil))
def c2(r: Region, f: Str, a: Term, b: Term): Term = TCon(f, TCons(a, TCons(b, TNil)))

def show(r: Region, u: Unified, t: Term): Unit =
  u match
    case Fail => rt_print("fail")
    case Ok(s) => showTerm(walkAll(r, s, t))
  rt_print("\n")

def main(): I64 =
  handle r = Arena()
  val x = TVar(0)
  val y = TVar(1)
  // f(X, b) == f(a, Y)  =>  f(a, b)
  show(r, unify(r, SNil, c2(r, "f", x, c0(r, "b")), c2(r, "f", c0(r, "a"), y)), c2(r, "f", x, y))
  // X == Y, Y == c  =>  X = c
  val u = unify(r, SNil, x, y)
  u match
    case Fail => rt_print("fail\n")
    case Ok(s) => show(r, unify(r, s, y, c0(r, "c")), x)
  // X == X  =>  X unbound
  show(r, unify(r, SNil, x, x), x)
  // X == list(X)  =>  occurs check
  show(r, unify(r, SNil, x, c1(r, "list", x)), x)
  // X == Y, Y == list(X)  =>  occurs check through a chain
  u match
    case Fail => rt_print("fail\n")
    case Ok(s) => show(r, unify(r, s, y, c1(r, "list", x)), x)
  // f(a) == g(a)  =>  clash
  show(r, unify(r, SNil, c1(r, "f", c0(r, "a")), c1(r, "g", c0(r, "a"))), x)
  // f(a) == f(a, b)  =>  arity
  show(r, unify(r, SNil, c1(r, "f", c0(r, "a")), c2(r, "f", c0(r, "a"), c0(r, "b"))), x)
  // f(a, b) == f(a)  =>  arity, other side
  show(r, unify(r, SNil, c2(r, "f", c0(r, "a"), c0(r, "b")), c1(r, "f", c0(r, "a"))), x)
  r.free()
  0
