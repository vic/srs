// pass: Kanren K1 unify (lib/kanren.srs): bind both sides, chains, occurs check, clash, arity
def c0 {r: Region} (f: Str): Term = TCon(f, TNil)
def c1 {r: Region} (f: Str, a: Term): Term = TCon(f, TCons(a, TNil))
def c2 {r: Region} (f: Str, a: Term, b: Term): Term = TCon(f, TCons(a, TCons(b, TNil)))

def show {r: Region} (u: Unified, t: Term): Unit =
  u match
    case Fail => rt_print("fail")
    case Ok(s) => showTerm(walkAll(s, t))
  rt_print("\n")

def main(): I64 =
  handle r = Arena()
  val x = TVar(0)
  val y = TVar(1)
  // f(X, b) == f(a, Y)  =>  f(a, b)
  show(unify(SNil, c2("f", x, c0("b")), c2("f", c0("a"), y)), c2("f", x, y))
  // X == Y, Y == c  =>  X = c
  val u = unify(SNil, x, y)
  u match
    case Fail => rt_print("fail\n")
    case Ok(s) => show(unify(s, y, c0("c")), x)
  // X == X  =>  X unbound
  show(unify(SNil, x, x), x)
  // X == list(X)  =>  occurs check
  show(unify(SNil, x, c1("list", x)), x)
  // X == Y, Y == list(X)  =>  occurs check through a chain
  u match
    case Fail => rt_print("fail\n")
    case Ok(s) => show(unify(s, y, c1("list", x)), x)
  // f(a) == g(a)  =>  clash
  show(unify(SNil, c1("f", c0("a")), c1("g", c0("a"))), x)
  // f(a) == f(a, b)  =>  arity
  show(unify(SNil, c1("f", c0("a")), c2("f", c0("a"), c0("b"))), x)
  // f(a, b) == f(a)  =>  arity, other side
  show(unify(SNil, c2("f", c0("a"), c0("b")), c1("f", c0("a"))), x)
  r.free()
  0
