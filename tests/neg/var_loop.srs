// expect: use of value after its region ended
// ys takes a only on the 2nd turn: needs the loop fixpoint
def main(): I64 =
  handle a = Arena()
  handle b = Heap()
  var xs = buildAt(b, 2)
  var ys = buildAt(b, 1)
  var i = 0
  while i < 2 do
    ys = xs
    xs = buildAt(a, 1)
    i = i + 1
  a.free()
  sum(ys)
