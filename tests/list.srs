enum List:
  case Nil
  case Cons(h: I64, t: List)

def build(r: Region, n: I64): List =
  if n == 0 then Nil else Cons(n, build(r, n - 1))

def sum(xs: List): I64 =
  xs match
    case Nil => 0
    case Cons(h, t) => h + sum(t)

def main(): I64 =
  handle r = Arena()
  val xs = build(r, 10)
  rt_print_i64(sum(xs))
  rt_print("\n")
  sum(xs) - 55
