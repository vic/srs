# .github/workflows/ci.yml is generated: each aspect gives jobs to the `workflow` sink. Every step is one devshell
# command (commands.nix): what CI runs, `nix develop -c <cmd>` runs locally. Jobs start at once, none waits.
{ yen, ... }:
let
  inherit (yen.lib.batteries) github;
  setup = [
    { uses = "actions/checkout@v4"; }
    {
      uses = "cachix/install-nix-action@v31";
      "with".github_access_token = "\${{ secrets.GITHUB_TOKEN }}";
    }
  ];
  dev = name: command: {
    inherit name;
    run = "nix develop -c ${command}";
  };
  job = timeout: steps: {
    runs-on = "ubuntu-latest";
    timeout-minutes = timeout;
    steps = setup ++ steps;
  };
in
{
  yen.kinds.repo.sinks.workflow = {
    reduce = yen.lib.reduce.merge;
    files = github.workflow {
      from = yen.kinds.repo.sinks.workflow;
      path = ".github/workflows/ci.yml";
      header = jobs: ''
        # DO-NOT-EDIT. Generated by nix/ci.nix. Regenerate: nix run .#write-files
        # Jobs: ${toString jobs}
      '';
      doc = {
        name = "ci";
        on = {
          push.branches = [ "main" ];
          pull_request = { };
          workflow_dispatch = { };
        };
        concurrency = {
          group = "\${{ github.workflow }}-\${{ github.ref }}";
          cancel-in-progress = "\${{ github.ref != 'refs/heads/main' }}";
        };
        permissions.contents = "read";
      };
    };
  };
  yen.aspects.ci-jobs = {
    at = yen.kinds.repo;
    workflow = {
      fmt = job 10 [
        (dev "every nix file is formatted (nixfmt)" "fmt-check")
        (dev "the workflows are valid (actionlint)" "lint")
      ];
      # the generated files are current: one check per file
      flake-check = job 20 [
        {
          name = "nix flake check";
          run = "nix flake check -L";
        }
      ];
      # lean-check = job 30 [ (dev "Lean soundness proofs of the effect checker" "lean-check") ];
      srs-test = job 20 [ (dev "srs gate: fixpoint, seed, programs" "srs-test") ];
    };
  };
}
