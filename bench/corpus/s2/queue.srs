// a persistent FIFO queue (s2 component 2, vic 2026-11-06): Okasaki's two lists, front in order, back reversed.
// push O(1); pop O(1) amortized (the back is reversed once, when the front runs out). the fair search queue.
enum Queue.Queue [A: Type]:
  case Queue.Queue(front: Coll.List[A], back: Coll.List[A])

// a pop: the queue was empty, or its first element and the rest
enum Queue.Popped [A: Type]:
  case Queue.Empty
  case Queue.Got(x: A, rest: Queue.Queue[A])

def Queue.empty [A: Type] {r: Region} (): Queue.Queue[A] = Queue.Queue(Coll.Nil, Coll.Nil)

def Queue.push [A: Type] {r: Region} (q: Queue.Queue[A], x: A): Queue.Queue[A] =
  val Queue.Queue(f, b) = q
  Queue.Queue(f, Coll.Cons(x, b))

// each of xs pushed, in order
def Queue.pushAll [A: Type] {r: Region} (q: Queue.Queue[A], xs: Coll.List[A]): Queue.Queue[A] = xs match
  case Coll.Nil => q
  case Coll.Cons(x, t) => Queue.pushAll(Queue.push(q, x), t)

def Queue.pop [A: Type] {r: Region} (q: Queue.Queue[A]): Queue.Popped[A] =
  val Queue.Queue(f, b) = q
  f match
    case Coll.Cons(x, t) => Queue.Got(x, Queue.Queue(t, b))
    case Coll.Nil => Coll.rev(b) match
      case Coll.Nil => Queue.Empty
      case Coll.Cons(x, t) => Queue.Got(x, Queue.Queue(t, Coll.Nil))
