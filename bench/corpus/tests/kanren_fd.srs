// pass: Kanren K4 finite domains (lib/kanren.srs): dom, meet, <, <=, +, distinct, label first-fail, propagation w/o label
def c0 {r: Region} (f: Str): Term = TCon(f, TNil)
def c1 {r: Region} (f: Str, a: Term): Term = TCon(f, TCons(a, TNil))
def both {r: Region} (g: Goal, h: Goal): Goal = GConj(g, h)
def lt {r: Region} (x: Term, y: Term): Goal = GFd(FBin(BLt, x, y))
def le {r: Region} (x: Term, y: Term): Goal = GFd(FBin(BLe, x, y))
def in {r: Region} (x: Term, a: I64, b: I64): Goal = GDom(x, range(a, b))
def three {r: Region} (x: Term, y: Term, z: Term): Terms = TCons(x, TCons(y, TCons(z, TNil)))

def show {r: Region} (run: Run, nv: I64): Unit = run match
  case Run(ans, st) =>
    showAnswers(ans, nv)
    st match
      case Ended => rt_print("ended\n")
      case Limit => rt_print("limit\n")
      case NoFuel => rt_print("nofuel\n")

def showAnswers {r: Region} (ans: Answers, nv: I64): Unit = ans match
  case ANil => ()
  case ACons(st, t) =>
    var i = 0
    while i < nv do
      if i > 0 then rt_print(" ; ") else ()
      showTerm(walkAll(substOf(st), TVar(i)))
      i = i + 1
    rt_print("\n")
    showAnswers(t, nv)

def main(): I64 =
  handle r = Arena()
  val x = TVar(0)
  val y = TVar(1)
  val z = TVar(2)
  val xs = three(x, y, z)
  // X in 1..3, label  =>  1, 2, 3
  show(solve(RNil, both(in(x, 1, 3), GLabel(xs)), 1, 1000, 10), 1)
  // X, Y in 1..3, X < Y, label  =>  3 pairs
  show(solve(RNil, both(both(both(in(x, 1, 3), in(y, 1, 3)), lt(x, y)), GLabel(xs)), 2, 1000, 10), 2)
  // X, Y in 0..2, X + Y = Z, Z == 4  =>  2 ; 2 ; 4 by propagation, no label
  val sum = both(both(in(x, 0, 2), in(y, 0, 2)), GFd(FPlus(x, y, z)))
  show(solve(RNil, both(sum, GEq(z, TInt(4))), 3, 1000, 10), 3)
  // X, Y, Z in 1..2, distinct, label  =>  none
  show(solve(RNil, both(both(both(both(in(x, 1, 2), in(y, 1, 2)), in(z, 1, 2)), distinct(xs)), GLabel(xs)), 3, 1000, 10), 3)
  // X in 1..3, X == 5  =>  none
  show(solve(RNil, both(in(x, 1, 3), GEq(x, TInt(5))), 1, 1000, 10), 1)
  // X == 2, X in 1..3  =>  2
  show(solve(RNil, both(GEq(x, TInt(2)), in(x, 1, 3)), 1, 1000, 10), 1)
  // X in 1..3, X in 2..5, label  =>  2, 3
  show(solve(RNil, both(both(in(x, 1, 3), in(x, 2, 5)), GLabel(xs)), 1, 1000, 10), 1)
  // X == f(a), X in 1..3  =>  none
  show(solve(RNil, both(GEq(x, c1("f", c0("a"))), in(x, 1, 3)), 1, 1000, 10), 1)
  // X in 1..2, X =/= 1, label  =>  2
  show(solve(RNil, both(both(in(x, 1, 2), GNeq(x, TInt(1))), GLabel(xs)), 1, 1000, 10), 1)
  // X in 1..5, X < 2  =>  1 by propagation; X <= Y, Y in 0..0  =>  none
  show(solve(RNil, both(in(x, 1, 5), lt(x, TInt(2))), 1, 1000, 10), 1)
  show(solve(RNil, both(both(in(x, 1, 5), in(y, 0, 0)), le(x, y)), 2, 1000, 10), 2)
  // X == Y, X in 1..3, Y in 3..5  =>  3 ; 3 (unified variables meet)
  show(solve(RNil, both(both(GEq(x, y), in(x, 1, 3)), in(y, 3, 5)), 2, 1000, 10), 2)
  // X in 1..3, Y in 2..3, X == Y after domains  =>  domains meet: 2 equal pairs
  show(solve(RNil, both(both(both(in(x, 1, 3), in(y, 2, 3)), GEq(x, y)), GLabel(xs)), 2, 1000, 10), 2)
  // label 1..3 with fuel 2: a 3-value pick costs 3  =>  nofuel
  show(solve(RNil, both(in(x, 1, 3), GLabel(xs)), 1, 2, 10), 1)
  // X in 1..3, Y in 1..2, label: first-fail picks Y (smaller) first, so answers come Y-major
  show(solve(RNil, both(both(in(x, 1, 3), in(y, 1, 2)), GLabel(xs)), 2, 1000, 10), 2)
  r.free()
  0
