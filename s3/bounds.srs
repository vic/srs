// s3 index proof (S1b-3a step 1): the proof rules of $S1B/proof.dl as RULE DATA on the Datalog engine (s3/dl.srs), driven by the
// fact dump of `s3c --idx-facts` (S1b-0). One solve per def: the facts of the def are loaded, Dl.run, the unproved sites are read,
// Dl.clear. The relations have no def column. Entry: Bd.run(dump text, print per-site verdicts) from s3/dlmain.srs (--prf, --prf-dump).
//
// relations (U32 columns; ids are the plan's)
//   0 site(s, pos, kind, arr, ix, ixb)   ix = the index code or NONE when compound (-1); ixb = binder of an even ix, else NONE
//   1 lit(s, v, nn)                      v is stored biased (+2^31) so order holds; nn = 1 when v >= 0
//   2 arrlen(arr, n, lv)                 n = the written length code, or 2^24 + arr for `own` (the identity L:arr); lv = biased literal
//                                        length value (n odd: n / 2) or 0 (none: no biased lit is below it)
//   3 scope(sc, lo, hi)  4 guard(sc, kind, a, b)   operand codes: binder b = 2b, literal v = 2v+1, L:b = 2^24 + b
//   5 assign(v, pos)  6 unsigned(b)
//   derived: 7 lenOf(s, n) 8 inScope(s, sc) 9 killed(s, sc) 10 inLt(s) 11 inLo(s) 12 proved(s) 13 unproved(s)
// columns the loader adds to the dump (all computed from one dump line, no rule logic): site.ixb, lit.nn, arrlen.lv, and the
// biased lit.v; `ix % 2 = 0`, `ix / 2` (killed, unsigned), `v >= 0` (inLo) and `v < n / 2` (inLt) of proof.dl become these columns.
// strata: S0 lenOf, inScope | S1 killed (2 rules) | S2 inLt (T1 guard < len, T2 two slice kinds guard <= len, T3 literal), inLo (O1 guard
// 0 <= i, O2 unsigned, O3 literal) | S3 proved | S4 unproved. The cause of an unproved site is classified outside the engine, from its
// site row and the inLt / inLo rows (proof.dl `cause`, first match: compound-index, array-not-local, no-upper-guard, no-lower-bound).
// atoms: `0 rel idx specs` positive, `1 rel idx specs` negative, `2|3|4 opA opB` Lt | Le | Ne (spec = tag, value; tag 0 const, 1 slot).
// the site driver binds slots 0..5 = s pos kind arr ix ixb. shortcut: hand-written plan until DL-1b moves the planner into srs.
def Bd.plan(): Str = "6 3 3 3 4 2 1 2 2 2 1 1 1 1 0 63 1 7 2 7 3 7 4 15 5 3 6 1 7 3 8 3 9 3 10 1 11 1 12 1 13 1 0 1 2 1 3 0 5 1 8 1 3 1 7 1 4 7 2 0 7 1 0 1 6 2 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 2 15 1 3 2 6 2 7 0 8 1 0 1 6 4 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 3 16 2 6 2 7 2 8 3 1 7 1 1 3 1 1 1 8 2 0 9 1 0 1 7 6 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 5 17 1 5 2 6 0 8 18 1 0 2 7 0 3 19 1 7 2 8 2 9 3 1 8 1 6 2 1 6 1 1 0 9 1 0 1 7 6 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 5 17 1 3 2 6 0 8 18 1 0 2 7 0 3 19 1 7 2 8 2 9 3 1 8 1 6 2 1 6 1 1 7 0 10 1 0 5 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 7 20 1 0 2 6 0 8 18 1 0 2 7 0 4 4 1 7 0 0 1 4 1 6 1 9 9 1 0 1 7 0 10 1 0 5 0 0 -1 2 0 2 1 0 3 2 3 2 4 2 5 0 7 20 1 0 2 6 0 8 18 1 0 2 7 0 4 4 1 7 0 2 1 4 1 6 1 9 9 1 0 1 7 0 10 1 0 5 0 0 -1 2 0 2 1 0 4 2 3 2 4 2 5 0 7 20 1 0 2 6 0 8 18 1 0 2 7 0 4 4 1 7 0 2 1 4 1 6 1 9 9 1 0 1 7 0 10 1 0 4 0 1 -1 2 0 2 1 2 2 0 0 14 1 0 2 3 2 4 2 5 2 6 2 7 0 2 15 1 5 2 8 2 9 2 1 1 1 9 0 11 1 0 4 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 8 18 1 0 2 6 0 4 21 1 6 0 1 1 4 2 7 1 9 9 1 0 1 6 0 11 1 0 2 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 0 6 6 1 5 0 11 1 0 1 0 1 -1 2 0 2 1 0 1 1 0 12 1 0 2 0 10 -1 2 0 0 11 11 1 0 1 0 13 1 0 2 0 0 -1 2 0 2 1 2 2 2 3 2 4 2 5 1 12 12 1 0"

def Bd.pn(): I64 = 568
def Bd.nrel(): I64 = 14
def Bd.nix(): I64 = 22
def Bd.nstr(): I64 = 5
def Bd.bias(): I64 = 2147483648
def Bd.lbase(): I64 = 16777216
def Bd.none(): I64 = 4294967295

// counters and per-site info live in one I64 array w (wn words): counters 0..15, then 5 words per site id (line, kind, arr, ix, flags)
def Bd.sSites(): I64 = 0
def Bd.sProved(): I64 = 1
def Bd.sUnp(): I64 = 2
def Bd.sCause(): I64 = 3
def Bd.sSolves(): I64 = 7
def Bd.sDefs(): I64 = 8
def Bd.sErr(): I64 = 9
def Bd.sDefLo(): I64 = 10
def Bd.sDefHi(): I64 = 11
def Bd.sDefId(): I64 = 12
def Bd.sDefSites(): I64 = 13
def Bd.sIntern(): I64 = 14
def Bd.sb(sid: I64): I64 = 80 + 5 * sid

def Bd.cg(wn: I64, w: Array[I64](wn), i: I64): I64 = Dl.g(wn, w, i)

def Bd.bump(wn: I64, w: Array[I64](wn), i: I64, d: I64): Unit = Dl.s(wn, w, i, Dl.g(wn, w, i) + d)

def Bd.new(): Dl.St =
  val st = Dl.init(Bd.pn(), Bd.nrel(), Bd.nix())
  val i = Dl.fillP(st, Bd.plan(), 0, 0, Bd.pn())
  Dl.br(st, 0, 0)
  st

// ── text ──
def Bd.eol(s: Str, n: I64, i: I64): I64 =
  if i >= n then n else if Str.at(s, i) == 10 then i else Bd.eol(s, n, i + 1)

def Bd.sep(s: Str, n: I64, i: I64): I64 =
  if i < n && (Str.at(s, i) == 9 || Str.at(s, i) == 32) then Bd.sep(s, n, i + 1) else i

def Bd.countNl(s: Str, n: I64, i: I64, acc: I64): I64 =
  if i >= n then acc else Bd.countNl(s, n, i + 1, if Str.at(s, i) == 10 then acc + 1 else acc)

// the index of the k-th tab (k >= 1) in [i, e), or e
def Bd.tabN(s: Str, i: I64, e: I64, k: I64): I64 =
  if i >= e then e
  else if Str.at(s, i) == 9 then (if k <= 1 then i else Bd.tabN(s, i + 1, e, k - 1))
  else Bd.tabN(s, i + 1, e, k)

// an operand code: `L:b` is 2^24 + b, else the number
def Bd.opd(s: Str, n: I64, i: I64): Dl.N =
  val j = Bd.sep(s, n, i)
  if j < n && Str.at(s, j) == 76 then
    val Dl.N(v, k) = Dl.num(s, j + 2)
    Dl.N(v + Bd.lbase(), k)
  else Dl.num(s, j)

// ── load ──
// a column value must fit a U32 (an operand code below 2^25); a defect is counted and 0 stored
def Bd.hb(st: Dl.St, wn: I64, w: Array[I64](wn), c: I64, v: I64): Unit =
  if v < 0 || v > 4294967295 then
    Bd.bump(wn, w, Bd.sErr(), 1)
    Dl.setHb(st, c, 0)
  else Dl.setHb(st, c, v)

// a code above 2^25 (a literal 2v+1 with a large v) is interned: its id is 2^25 + its place in the table (w 16..79, at most 64
// distinct), so equal codes stay equal and no other code collides; a negative code or a full table is a defect
def Bd.find(wn: I64, w: Array[I64](wn), v: I64, i: I64, k: I64): I64 =
  if i >= k then 0 - 1 else if Bd.cg(wn, w, 16 + i) == v then i else Bd.find(wn, w, v, i + 1, k)

def Bd.icode(wn: I64, w: Array[I64](wn), v: I64): I64 =
  if v < 2 * Bd.lbase() then v
  else
    val k = Bd.cg(wn, w, Bd.sIntern())
    val j = Bd.find(wn, w, v, 0, k)
    if j >= 0 then 2 * Bd.lbase() + j
    else if k < 64 then
      Dl.s(wn, w, 16 + k, v)
      Dl.s(wn, w, Bd.sIntern(), k + 1)
      2 * Bd.lbase() + k
    else 0 - 1

def Bd.hbCode(st: Dl.St, wn: I64, w: Array[I64](wn), c: I64, v: I64): Unit = Bd.hb(st, wn, w, c, Bd.icode(wn, w, v))

def Bd.ldSite(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(sid, i2) = Dl.num(s, i1)
  val Dl.N(pos, i3) = Dl.num(s, i2)
  val Dl.N(kind, i4) = Dl.num(s, i3)
  val Dl.N(arr, i5) = Dl.num(s, i4)
  val Dl.N(ix, i6) = Dl.num(s, i5)
  val Dl.N(line, _) = Dl.num(s, i6)
  Bd.hb(st, wn, w, 0, sid)
  Bd.hb(st, wn, w, 1, pos)
  Bd.hb(st, wn, w, 2, kind)
  Bd.hb(st, wn, w, 3, arr)
  if ix < 0 then Dl.setHb(st, 4, Bd.none()) else Bd.hbCode(st, wn, w, 4, ix)
  if ix >= 0 && ix % 2 == 0 && ix < 2 * Bd.lbase() then Bd.hb(st, wn, w, 5, ix / 2) else Dl.setHb(st, 5, Bd.none())
  Dl.add(st, 0, 6)
  val b = Bd.sb(sid)
  Dl.s(wn, w, b, line)
  Dl.s(wn, w, b + 1, kind)
  Dl.s(wn, w, b + 2, arr)
  Dl.s(wn, w, b + 3, ix)
  Dl.s(wn, w, b + 4, 0)
  Bd.bump(wn, w, Bd.sSites(), 1)
  Bd.bump(wn, w, Bd.sDefSites(), 1)

def Bd.ldLit(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(sid, i2) = Dl.num(s, i1)
  val Dl.N(v, _) = Dl.num(s, i2)
  Bd.hb(st, wn, w, 0, sid)
  Bd.hb(st, wn, w, 1, v + Bd.bias())
  Dl.setHb(st, 2, if v >= 0 then 1 else 0)
  Dl.add(st, 1, 3)

def Bd.ldArrlen(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, n: I64, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(arr, i2) = Dl.num(s, i1)
  val j = Bd.sep(s, n, i2)
  val own = j < n && Str.at(s, j) == 111
  val Dl.N(v, _) = if own then Dl.N(Bd.lbase() + arr, j) else Dl.num(s, j)
  Bd.hb(st, wn, w, 0, arr)
  Bd.hbCode(st, wn, w, 1, v)
  Bd.hb(st, wn, w, 2, if own then 0 else (if v >= 0 && v % 2 == 1 then v / 2 + Bd.bias() else 0))
  Dl.add(st, 2, 3)

def Bd.ldScope(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(sc, i2) = Dl.num(s, i1)
  val Dl.N(lo, i3) = Dl.num(s, i2)
  val Dl.N(hi, _) = Dl.num(s, i3)
  Bd.hb(st, wn, w, 0, sc)
  Bd.hb(st, wn, w, 1, lo)
  Bd.hb(st, wn, w, 2, hi)
  Dl.add(st, 3, 3)

def Bd.ldGuard(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, n: I64, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(sc, i2) = Dl.num(s, i1)
  val Dl.N(kind, i3) = Dl.num(s, i2)
  val Dl.N(a, i4) = Bd.opd(s, n, i3)
  val Dl.N(b, _) = Bd.opd(s, n, i4)
  Bd.hb(st, wn, w, 0, sc)
  Bd.hb(st, wn, w, 1, kind)
  Bd.hbCode(st, wn, w, 2, a)
  Bd.hbCode(st, wn, w, 3, b)
  Dl.add(st, 4, 4)

def Bd.ldAssign(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(v, i2) = Dl.num(s, i1)
  val Dl.N(pos, _) = Dl.num(s, i2)
  Bd.hb(st, wn, w, 0, v)
  Bd.hb(st, wn, w, 1, pos)
  Dl.add(st, 5, 2)

def Bd.ldUnsigned(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, i: I64): Unit =
  val Dl.N(_, i1) = Dl.num(s, i)
  val Dl.N(b, _) = Dl.num(s, i1)
  Bd.hb(st, wn, w, 0, b)
  Dl.add(st, 6, 1)

// ── solve one def, read the unproved sites ──
def Bd.mark(wn: I64, w: Array[I64](wn), rn: I64, xs: Array[U32](rn), i: I64, n: I64, bit: I64): Unit =
  if i >= n then () else
    val b = Bd.sb(Dl.u(rn, xs, i)) + 4
    Dl.s(wn, w, b, Dl.g(wn, w, b) + bit)
    Bd.mark(wn, w, rn, xs, i + 1, n, bit)

def Bd.marks(st: Dl.St, wn: I64, w: Array[I64](wn), r: I64, bit: I64): Unit =
  Dl.relOf(st, r) match
    case Dl.Rel.Mk(_, rn, xs) => Bd.mark(wn, w, rn, xs, 0, Dl.cnt(st, r), bit)

def Bd.cname(c: I64): Str =
  if c == 0 then "compound-index" else if c == 1 then "array-not-local" else if c == 2 then "no-upper-guard" else "no-lower-bound"

// firstun.csv of Souffle: def id, site id, file (of the def), site line, def name, kind, cause
def Bd.pr(wn: I64, w: Array[I64](wn), sx: Str, sid: I64, line: I64, kind: I64, c: I64): Unit =
  val lo = Bd.cg(wn, w, Bd.sDefLo())
  val hi = Bd.cg(wn, w, Bd.sDefHi())
  val t2 = Bd.tabN(sx, lo, hi, 2)
  val t3 = Bd.tabN(sx, lo, hi, 3)
  val t4 = Bd.tabN(sx, lo, hi, 4)
  Console.printI64(Bd.cg(wn, w, Bd.sDefId()))
  Console.print("\t")
  Console.printI64(sid)
  Console.print("\t")
  Console.print(Str.slice(sx, t2 + 1, t3))
  Console.print("\t")
  Console.printI64(line)
  Console.print("\t")
  Console.print(Str.slice(sx, t4 + 1, hi))
  Console.print("\t")
  Console.printI64(kind)
  Console.print("\t")
  Console.print(Bd.cname(c))
  Console.print("\n")

def Bd.unp(wn: I64, w: Array[I64](wn), sx: Str, rn: I64, xs: Array[U32](rn), i: I64, n: I64, dump: Bool): Unit =
  if i >= n then () else
    val sid = Dl.u(rn, xs, i)
    val b = Bd.sb(sid)
    val ix = Bd.cg(wn, w, b + 3)
    val arr = Bd.cg(wn, w, b + 2)
    val fl = Bd.cg(wn, w, b + 4)
    val c = if ix < 0 then 0 else if arr == 0 then 1 else if fl % 2 == 0 then 2 else 3
    Bd.bump(wn, w, Bd.sCause() + c, 1)
    if dump then Bd.pr(wn, w, sx, sid, Bd.cg(wn, w, b), Bd.cg(wn, w, b + 1), c) else ()
    Bd.unp(wn, w, sx, rn, xs, i + 1, n, dump)

def Bd.solve(st: Dl.St, wn: I64, w: Array[I64](wn), sx: Str, dump: Bool): Unit =
  Dl.run(st, 0, Bd.nstr(), Bd.nrel() + 2 * Bd.nix())
  Bd.bump(wn, w, Bd.sSolves(), 1)
  Bd.bump(wn, w, Bd.sProved(), Dl.cnt(st, 12))
  Bd.bump(wn, w, Bd.sUnp(), Dl.cnt(st, 13))
  Bd.marks(st, wn, w, 10, 1)
  Bd.marks(st, wn, w, 11, 2)
  Dl.relOf(st, 13) match
    case Dl.Rel.Mk(_, rn, xs) => Bd.unp(wn, w, sx, rn, xs, 0, Dl.cnt(st, 13), dump)

// the facts of the current def are done: solve it when it has sites, then empty the relations
def Bd.finish(st: Dl.St, wn: I64, w: Array[I64](wn), sx: Str, dump: Bool): Unit =
  if Bd.cg(wn, w, Bd.sDefs()) > 0 then
    if Bd.cg(wn, w, Bd.sDefSites()) > 0 then Bd.solve(st, wn, w, sx, dump) else ()
    Dl.clear(st, 0)
  else ()

def Bd.newDef(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, i: I64, e: I64, dump: Bool): Unit =
  Bd.finish(st, wn, w, s, dump)
  val Dl.N(d, _) = Dl.num(s, i)
  Dl.s(wn, w, Bd.sDefLo(), i)
  Dl.s(wn, w, Bd.sDefHi(), e)
  Dl.s(wn, w, Bd.sDefId(), d)
  Dl.s(wn, w, Bd.sDefSites(), 0)
  Bd.bump(wn, w, Bd.sDefs(), 1)

// the kind of a dump line from its first letters: 1 def, 2 site, 3 scope, 4 lit, 5 ignored (compound, undecoded), 6 arrlen,
// 7 assign, 8 guard, 9 unsigned, 0 unknown
def Bd.kindOf(s: Str, i: I64): I64 =
  val c0 = Str.at(s, i)
  val c1 = Str.at(s, i + 1)
  if c0 == 100 then 1
  else if c0 == 115 then (if c1 == 105 then 2 else 3)
  else if c0 == 108 then 4
  else if c0 == 99 then 5
  else if c0 == 97 then (if c1 == 114 then 6 else 7)
  else if c0 == 103 then 8
  else if c0 == 117 then (if Str.at(s, i + 2) == 115 then 9 else 5)
  else 0

def Bd.line(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, n: I64, i: I64, e: I64, dump: Bool): Unit =
  val k = Bd.kindOf(s, i)
  if k == 1 then Bd.newDef(st, wn, w, s, i, e, dump)
  else if k == 2 then Bd.ldSite(st, wn, w, s, i)
  else if k == 3 then Bd.ldScope(st, wn, w, s, i)
  else if k == 4 then Bd.ldLit(st, wn, w, s, i)
  else if k == 5 then ()
  else if k == 6 then Bd.ldArrlen(st, wn, w, s, n, i)
  else if k == 7 then Bd.ldAssign(st, wn, w, s, i)
  else if k == 8 then Bd.ldGuard(st, wn, w, s, n, i)
  else if k == 9 then Bd.ldUnsigned(st, wn, w, s, i)
  else Bd.bump(wn, w, Bd.sErr(), 1)

def Bd.lines(st: Dl.St, wn: I64, w: Array[I64](wn), s: Str, n: I64, i: I64, dump: Bool): Unit =
  if i >= n then Bd.finish(st, wn, w, s, dump)
  else
    val e = Bd.eol(s, n, i)
    if e > i then Bd.line(st, wn, w, s, n, i, e, dump) else ()
    Bd.lines(st, wn, w, s, n, e + 1, dump)

def Bd.kv(name: Str, v: I64): Unit =
  Console.print(name)
  Console.printI64(v)

def Bd.report(wn: I64, w: Array[I64](wn)): Unit =
  Bd.kv("# sites=", Bd.cg(wn, w, Bd.sSites()))
  Bd.kv(" proved=", Bd.cg(wn, w, Bd.sProved()))
  Bd.kv(" unproved=", Bd.cg(wn, w, Bd.sUnp()))
  Bd.kv(" defs=", Bd.cg(wn, w, Bd.sDefs()))
  Bd.kv(" solves=", Bd.cg(wn, w, Bd.sSolves()))
  Bd.kv(" errors=", Bd.cg(wn, w, Bd.sErr()))
  Console.print("\n")
  Bd.kv("# compound-index=", Bd.cg(wn, w, Bd.sCause()))
  Bd.kv(" array-not-local=", Bd.cg(wn, w, Bd.sCause() + 1))
  Bd.kv(" no-upper-guard=", Bd.cg(wn, w, Bd.sCause() + 2))
  Bd.kv(" no-lower-bound=", Bd.cg(wn, w, Bd.sCause() + 3))
  Console.print("\n")

// exit 0 when the plan is well formed and every dump line loaded
def Bd.run(src: Str, dump: Bool): I64 =
  val n = Str.len(src)
  val wn = 80 + 5 * (Bd.countNl(src, n, 0, 0) + 2)
  val w = Array.fill(wn, 0)
  val st = Bd.new()
  val defects = Dl.chkStrata(st, 0, Bd.nstr(), Bd.nrel() + 2 * Bd.nix())
  if defects > 0 then
    Bd.kv("# plan defects=", defects)
    Console.print("\n")
    1
  else
    Bd.lines(st, wn, w, src, n, 0, dump)
    Bd.report(wn, w)
    if Bd.cg(wn, w, Bd.sErr()) > 0 then 1 else 0
