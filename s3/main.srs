// s3c LEX-1 driver: s3c --lex F1 F2 ... prints "path tokens=N diags=D"; s3c --lex-dump F prints "kind off len" per token,
// then "diag code off" per diag. A file that does not read is named and the exit code is 1.

def M.sp(): Unit = Console.print(" ")
def M.nl(): Unit = Console.print("\n")

def M.tokLines(cap: I64, ks: Array[U8](cap), os: Array[U32](cap), ls: Array[U32](cap), t: I64, j: I64): Unit =
  if 0 <= j && j < t && j < cap then
    Lx.byteKind(I64.ofU8(ks(j))) match
      case Coll.Some(k) => Console.print(Lx.kindName(k))
      case Coll.None => Console.print("badkind")
    M.sp()
    Console.printI64(I64.of(os(j)))
    M.sp()
    Console.printI64(I64.of(ls(j)))
    M.nl()
    M.tokLines(cap, ks, os, ls, t, j + 1)
  else ()

def M.diagLines(dcap: I64, dc: Array[U8](dcap), dof: Array[U32](dcap), d: I64, j: I64): Unit =
  if 0 <= j && j < d && j < dcap then
    Console.print("diag ")
    Lx.byteWhy(I64.ofU8(dc(j))) match
      case Coll.Some(w) => Console.print(Lx.whyName(w))
      case Coll.None => Console.print("badwhy")
    M.sp()
    Console.printI64(I64.of(dof(j)))
    M.nl()
    M.diagLines(dcap, dc, dof, d, j + 1)
  else ()

// dump = true: one line per token and diag; false: the counts line
def M.file(dump: Bool, nt: Lx.Notes, p: Str, src: Str): Unit =
  val Lx.Out(cap, ks, os, ls, t, dcap, dc, dof, d) = Lx.lex(nt, src)
  if dump then
    M.tokLines(cap, ks, os, ls, t, 0)
    M.diagLines(dcap, dc, dof, d, 0)
  else
    Console.print(p)
    Console.print(" tokens=")
    Console.printI64(t)
    Console.print(" diags=")
    Console.printI64(d)
    M.nl()

def M.files(dump: Bool, nt: Lx.Notes, i: I64, bad: I64): I64 =
  if i >= Args.count() then bad
  else
    val p = Args.at(i)
    Files.bytes(p) match
      case Os.Ok(src) =>
        M.file(dump, nt, p, src)
        M.files(dump, nt, i + 1, bad)
      case Os.Fail(_) =>
        Console.print(p)
        Console.print(" unreadable\n")
        M.files(dump, nt, i + 1, 1)

// PARSE-1a: s3c --decls[-keep] F... prints "path decls=N diags=D" per file, then the totals per kind;
// s3c --decls-dump[-keep] F prints "kind name head lo hi" per decl, then "diag code tok" per diag.
def M.declLines(src: Str, tcap: I64, to: Array[U32](tcap), tl: Array[U32](tcap), cap: I64, kd: Array[U8](cap), nm: Array[U32](cap), hd: Array[U32](cap), lo: Array[U32](cap), hi: Array[U32](cap), c: I64, i: I64): Unit =
  if 0 <= i && i < c && i < cap then
    Ps.byteKind(I64.ofU8(kd(i))) match
      case Coll.Some(k) => Console.print(Ps.kindName(k))
      case Coll.None => Console.print("badkind")
    M.sp()
    val q = I64.of(nm(i))
    if 0 <= q && q < tcap then
      val o = I64.of(to(q))
      Console.print(Str.slice(src, o, o + I64.of(tl(q))))
    else Console.print("badname")
    M.sp()
    Console.printI64(I64.of(hd(i)))
    M.sp()
    Console.printI64(I64.of(lo(i)))
    M.sp()
    Console.printI64(I64.of(hi(i)))
    M.nl()
    M.declLines(src, tcap, to, tl, cap, kd, nm, hd, lo, hi, c, i + 1)
  else ()

def M.pdiagLines(dcap: I64, dw: Array[U8](dcap), dt: Array[U32](dcap), d: I64, j: I64): Unit =
  if 0 <= j && j < d && j < dcap then
    Console.print("diag ")
    Ps.byteWhy(I64.ofU8(dw(j))) match
      case Coll.Some(w) => Console.print(Ps.whyName(w))
      case Coll.None => Console.print("badwhy")
    M.sp()
    Console.printI64(I64.of(dt(j)))
    M.nl()
    M.pdiagLines(dcap, dw, dt, d, j + 1)
  else ()

// tot(b) += 1 per decl of kind byte b
def M.tally(cap: I64, kd: Array[U8](cap), c: I64, i: I64, tn: I64, tot: Array[I64](tn)): Unit =
  if 0 <= i && i < c && i < cap then
    val b = I64.ofU8(kd(i))
    if 0 <= b && b < tn then
      Array.put(tot, b, tot(b) + 1)
    else Console.print("tally: bad kind byte\n")
    M.tally(cap, kd, c, i + 1, tn, tot)
  else ()

def M.totals(tn: I64, tot: Array[I64](tn), b: I64): Unit =
  if 0 <= b && b < tn then
    Ps.byteKind(b) match
      case Coll.Some(k) => Console.print(Ps.kindName(k))
      case Coll.None => Console.print("badkind")
    M.sp()
    Console.printI64(tot(b))
    M.nl()
    M.totals(tn, tot, b + 1)
  else ()

// dump = true: one line per decl and diag; false: the counts line, and the per-kind tally into tot. returns the diag count
def M.dfile(dump: Bool, nt: Lx.Notes, p: Str, src: Str, tn: I64, tot: Array[I64](tn)): I64 =
  val lx = Lx.lex(nt, src)
  val Lx.Out(tcap, _, to, tl, _, _, _, _, _) = lx
  val Ps.Out(cap, kd, nm, hd, lo, hi, c, dcap, dw, dt, d) = Ps.parse(src, lx)
  if dump then
    M.declLines(src, tcap, to, tl, cap, kd, nm, hd, lo, hi, c, 0)
    M.pdiagLines(dcap, dw, dt, d, 0)
  else
    M.tally(cap, kd, c, 0, tn, tot)
    Console.print(p)
    Console.print(" decls=")
    Console.printI64(c)
    Console.print(" diags=")
    Console.printI64(d)
    M.nl()
  d

def M.dfiles(dump: Bool, nt: Lx.Notes, i: I64, bad: I64, dsum: I64, tn: I64, tot: Array[I64](tn)): I64 =
  if i >= Args.count() then
    if !dump then
      M.totals(tn, tot, 0)
      Console.print("total diags=")
      Console.printI64(dsum)
      M.nl()
    else ()
    bad
  else
    val p = Args.at(i)
    Files.bytes(p) match
      case Os.Ok(src) =>
        val dn = M.dfile(dump, nt, p, src, tn, tot)
        M.dfiles(dump, nt, i + 1, bad, dsum + dn, tn, tot)
      case Os.Fail(_) =>
        Console.print(p)
        Console.print(" unreadable\n")
        M.dfiles(dump, nt, i + 1, 1, dsum, tn, tot)

def M.decls(dump: Bool, nt: Lx.Notes): I64 =
  val tn = 11
  val tot = Array.fill(tn, 0)
  M.dfiles(dump, nt, 2, 0, 0, tn, tot)

// PARSE-1b: s3c --lex-text F prints "kind text" per token (skip mode); s3c --parse F... parses every def and enum decl and prints the
// counts; s3c --rt F... also prints each decl back, relexes it and compares it with the decl's own tokens (oracle R).
def M.textLines(src: Str, cap: I64, ks: Array[U8](cap), os: Array[U32](cap), ls: Array[U32](cap), t: I64, j: I64): Unit =
  if 0 <= j && j < t && j < cap then
    val kb = I64.ofU8(ks(j))
    Lx.byteKind(kb) match
      case Coll.Some(k) => Console.print(Lx.kindName(k))
      case Coll.None => Console.print("badkind")
    if kb < Lx.kindByte(Lx.KNl) then
      M.sp()
      val o = I64.of(os(j))
      Console.print(Str.slice(src, o, o + I64.of(ls(j))))
    else ()
    M.nl()
    M.textLines(src, cap, ks, os, ls, t, j + 1)
  else ()

def M.tfiles(i: I64, bad: I64): I64 =
  if i >= Args.count() then bad
  else
    val p = Args.at(i)
    Files.bytes(p) match
      case Os.Ok(src) =>
        val Lx.Out(cap, ks, os, ls, t, _, _, _, _) = Lx.lex(Lx.Skip, src)
        M.textLines(src, cap, ks, os, ls, t, 0)
        M.tfiles(i + 1, bad)
      case Os.Fail(_) =>
        Console.print(p)
        Console.print(" unreadable\n")
        M.tfiles(i + 1, 1)

// the 1-based line of byte offset o
def M.lineOf(src: Str, o: I64, i: I64, acc: I64): I64 =
  if i < o && i < Str.len(src) then M.lineOf(src, o, i + 1, if Str.at(src, i) == 10 then acc + 1 else acc)
  else acc

// tokens [0, i) of the two streams agree (kind byte and text); i = the first difference, or the end of the shorter
def M.cmpLoop(src: Str, lx: Lx.Out, a: I64, n1: I64, txt: Str, lx2: Lx.Out, n2: I64, i: I64): I64 =
  val Lx.Out(tcap, ks, os, ls, _, _, _, _, _) = lx
  val Lx.Out(tcap2, ks2, os2, ls2, _, _, _, _, _) = lx2
  val q = a + i
  if i < n1 && i < n2 && 0 <= q && q < tcap && 0 <= i && i < tcap2 then
    val o1 = I64.of(os(q))
    val o2 = I64.of(os2(i))
    if I64.ofU8(ks(q)) == I64.ofU8(ks2(i)) && Str.eq(Str.slice(src, o1, o1 + I64.of(ls(q))), Str.slice(txt, o2, o2 + I64.of(ls2(i)))) then
      M.cmpLoop(src, lx, a, n1, txt, lx2, n2, i + 1)
    else i
  else i

// the number of tokens of lx2 without its trailing Nl and Dedent
def M.trimEnd(tcap: I64, ks: Array[U8](tcap), t: I64): I64 =
  val q = t - 1
  if 0 <= q && q < tcap then
    val b = I64.ofU8(ks(q))
    if b == Lx.kindByte(Lx.KNl) || b == Lx.kindByte(Lx.KDedent) then M.trimEnd(tcap, ks, q) else t
  else t

def M.tokText(src: Str, cap: I64, os: Array[U32](cap), ls: Array[U32](cap), t: I64, j: I64): Str =
  if 0 <= j && j < t && j < cap then
    val o = I64.of(os(j))
    Str.slice(src, o, o + I64.of(ls(j)))
  else "<end>"

// stat slots: total, pass, parse errors (decl kind 0 = def at +0, 1 = enum at +1); 6 failures shown; 7 nodes; 8 overflow; 9 notYet
enum M.St:
  case M.St(n: I64, a: Array[I64](n))

def M.sget(st: M.St, s: I64): I64 =
  val M.St(n, a) = st
  if 0 <= s && s < n then a(s) else 0

def M.sadd(st: M.St, s: I64, v: I64): Unit =
  val M.St(n, a) = st
  if 0 <= s && s < n then Array.put(a, s, a(s) + v) else ()

def M.bump(st: M.St, s: I64): Unit = M.sadd(st, s, 1)

def M.showFail(p: Str, src: Str, kb: I64, name: Str, off: I64, what: Str, idx: I64, a: Str, b: Str): Unit =
  Console.print("FAIL ")
  Console.print(if kb == 0 then "def" else "enum")
  Console.print(" ")
  Console.print(name)
  Console.print(" ")
  Console.print(p)
  Console.print(":")
  Console.printI64(M.lineOf(src, off, 0, 1))
  Console.print(" ")
  Console.print(what)
  Console.print(" ")
  Console.printI64(idx)
  Console.print(" src=[")
  Console.print(a)
  Console.print("] printed=[")
  Console.print(b)
  Console.print("]\n")

def M.rtDecl(p: Str, src: Str, lx: Lx.Out, g: Na.G, head: I64, hi: I64, kb: I64, rt: Bool, st: M.St): Unit =
  val Lx.Out(tcap, _, os, ls, _, _, _, _, _) = lx
  M.bump(st, kb)
  val root = Pz.decl(g, head, hi)
  val nm = M.tokText(src, tcap, os, ls, hi, head + 1)
  val hoff = if 0 <= head && head < tcap then I64.of(os(head)) else 0
  if !Pz.ok(g) then
    M.bump(st, 4 + kb)
    val et = Na.cget(g, Na.sErrTok())
    val eoff = if 0 <= et && et < tcap then I64.of(os(et)) else 0
    if Na.cget(g, Na.sDiag()) > 0 && Na.dwhy(g, 0) == 1 then M.bump(st, 9) else ()
    if M.sget(st, 6) < 5 then
      M.bump(st, 6)
      M.showFail(p, src, kb, nm, eoff, "parse-error", et - head, M.tokText(src, tcap, os, ls, hi, et), "-")
    else ()
  else if rt then
    Console.captureBegin()
    Pr.decl(g, root)
    val txt = Console.captureEnd()
    val lx2 = Lx.lex(Lx.Skip, txt)
    val Lx.Out(tcap2, ks2, os2, ls2, t2, _, _, _, _) = lx2
    val n2 = M.trimEnd(tcap2, ks2, t2)
    val n1 = hi - head
    val k = M.cmpLoop(src, lx, head, n1, txt, lx2, n2, 0)
    if k == n1 && k == n2 then M.bump(st, 2 + kb)
    else if M.sget(st, 6) < 5 then
      M.bump(st, 6)
      M.showFail(p, src, kb, nm, hoff, "diff", k, M.tokText(src, tcap, os, ls, hi, head + k), M.tokText(txt, tcap2, os2, ls2, n2, k))
    else ()
  else M.bump(st, 2 + kb)

def M.rtDecls(p: Str, src: Str, lx: Lx.Out, g: Na.G, cap: I64, kd: Array[U8](cap), hd: Array[U32](cap), hi: Array[U32](cap), c: I64, rt: Bool, st: M.St, i: I64): Unit =
  if 0 <= i && i < c && i < cap then
    val b = I64.ofU8(kd(i))
    if b == Ps.kindByte(Ps.Def) || b == Ps.kindByte(Ps.Enum) then M.rtDecl(p, src, lx, g, I64.of(hd(i)), I64.of(hi(i)), b, rt, st) else ()
    M.rtDecls(p, src, lx, g, cap, kd, hd, hi, c, rt, st, i + 1)
  else ()

// the skeleton parser's diags, one line each: DIAG why file:line
def M.skelDiags(p: Str, src: Str, tcap: I64, os: Array[U32](tcap), dcap: I64, dw: Array[U8](dcap), dt: Array[U32](dcap), d: I64, j: I64): Unit =
  if 0 <= j && j < d && j < dcap then
    val q = I64.of(dt(j))
    Console.print("DIAG ")
    Ps.byteWhy(I64.ofU8(dw(j))) match
      case Coll.Some(w) => Console.print(Ps.whyName(w))
      case Coll.None => Console.print("badwhy")
    Console.print(" ")
    Console.print(p)
    Console.print(":")
    Console.printI64(M.lineOf(src, if 0 <= q && q < tcap then I64.of(os(q)) else 0, 0, 1))
    M.nl()
    M.skelDiags(p, src, tcap, os, dcap, dw, dt, d, j + 1)
  else ()

def M.rtFile(p: Str, src: Str, rt: Bool, st: M.St): Unit =
  val lx = Lx.lex(Lx.Skip, src)
  val Lx.Out(tcap0, _, os0, _, _, _, _, _, _) = lx
  val Ps.Out(cap, kd, _, hd, _, hi, c, dcap, dw, dt, d) = Ps.parse(src, lx)
  M.skelDiags(p, src, tcap0, os0, dcap, dw, dt, d, 0)
  val g = Pz.build(src, lx)
  M.rtDecls(p, src, lx, g, cap, kd, hd, hi, c, rt, st, 0)
  M.sadd(st, 7, Na.cget(g, Na.sNodes()) - 1)
  M.sadd(st, 8, Na.cget(g, Na.sOver()))

def M.rfiles(rt: Bool, i: I64, bad: I64, st: M.St): I64 =
  if i >= Args.count() then
    Console.print("def ")
    Console.printI64(M.sget(st, 2))
    Console.print("/")
    Console.printI64(M.sget(st, 0))
    Console.print(" enum ")
    Console.printI64(M.sget(st, 3))
    Console.print("/")
    Console.printI64(M.sget(st, 1))
    Console.print(" parseErr def=")
    Console.printI64(M.sget(st, 4))
    Console.print(" enum=")
    Console.printI64(M.sget(st, 5))
    Console.print(" nodes=")
    Console.printI64(M.sget(st, 7))
    Console.print(" overflow=")
    Console.printI64(M.sget(st, 8))
    Console.print(" notYet=")
    Console.printI64(M.sget(st, 9))
    M.nl()
    bad
  else
    val p = Args.at(i)
    Files.bytes(p) match
      case Os.Ok(src) =>
        M.rtFile(p, src, rt, st)
        M.rfiles(rt, i + 1, bad, st)
      case Os.Fail(_) =>
        Console.print(p)
        Console.print(" unreadable\n")
        M.rfiles(rt, i + 1, 1, st)

def M.rmain(rt: Bool): I64 =
  val sn = 16
  M.rfiles(rt, 2, 0, M.St(sn, Array.fill(sn, 0)))

def main(): I64 =
  handle io = Srs.Console()
  handle a = Srs.Args()
  handle m = Srs.Mut()
  handle r = Srs.Arena()
  handle fs = Srs.Files()
  if Args.count() > 1 && Str.eq(Args.at(1), "--parse") then M.rmain(false)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--rt") then M.rmain(true)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--lex-text") then M.tfiles(2, 0)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--decls") then M.decls(false, Lx.Skip)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--decls-keep") then M.decls(false, Lx.Keep)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--decls-dump") then M.decls(true, Lx.Skip)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--decls-dump-keep") then M.decls(true, Lx.Keep)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--lex") then M.files(false, Lx.Skip, 2, 0)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--lex-keep") then M.files(false, Lx.Keep, 2, 0)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--lex-dump") then M.files(true, Lx.Skip, 2, 0)
  else if Args.count() > 1 && Str.eq(Args.at(1), "--lex-dump-keep") then M.files(true, Lx.Keep, 2, 0)
  else
    Console.print("usage: s3c (--lex | --lex-keep) F... | (--lex-dump | --lex-dump-keep) F\n")
    2
