// s3c NAMES-1: name resolution over the AST as a functional pass, in s2. Scope rules learned from s2/names.srs (Names.expr 342,
// Names.arms 365, Names.block 380, Names.fn 302, Names.clauses 328, Names.decl 183): a use of a name or a call is a local (params and
// {} evidence binders of its def, val/var/handle binders of the block before it, arm and val-pattern binders, quantifier binder, the
// implicit `result` of a clause, the fields of a case in its own field types) or else a global by its FULL name (a def, an extern def or
// val, a top-level val, an enum case, a capability op `Cap.op`, a builtin). Innermost binder wins; a val's own value is resolved before
// its binder is in scope. `_` binds nothing. A dotted name is one token and is looked up whole: there is no module prefix rule.
// Data shape new: symbols = an interned name table (flat open addressing, s3 hash over the bytes, a byte pool), globals = a table indexed
// by symbol id (dense, so it is sorted by symbol) -> decl id with kind/file/line/name columns, locals = a scope stack of (symbol, binder
// token, kind). The result is SoA per file indexed by the USE-SITE TOKEN (a use site is not always a node: pattern binders, evidence
// names): ref U32 (Local: binder token; others: decl id) and refKind U8 (Nm.RK, closed: Global Local Case Builtin Cap Unresolved).
// Overflow of a fixed table is counted in slot Nm.sOver (never silent); every unreachable-by-sizing else says so.

// ── ref kinds ──
enum Nm.RK:
  case Nm.RGlobal
  case Nm.RLocal
  case Nm.RCase
  case Nm.RBuiltin
  case Nm.RCap
  case Nm.RUnres

def Nm.rkByte(k: Nm.RK): I64 = k match
  case Nm.RGlobal => 0
  case Nm.RLocal => 1
  case Nm.RCase => 2
  case Nm.RBuiltin => 3
  case Nm.RCap => 4
  case Nm.RUnres => 5

def Nm.rkOf(b: I64): Coll.Option[Nm.RK] =
  if b == 0 then Coll.Some(Nm.RGlobal)
  else if b == 1 then Coll.Some(Nm.RLocal)
  else if b == 2 then Coll.Some(Nm.RCase)
  else if b == 3 then Coll.Some(Nm.RBuiltin)
  else if b == 4 then Coll.Some(Nm.RCap)
  else if b == 5 then Coll.Some(Nm.RUnres)
  else Coll.None

def Nm.rkName(k: Nm.RK): Str = k match
  case Nm.RGlobal => "Global"
  case Nm.RLocal => "Local"
  case Nm.RCase => "Case"
  case Nm.RBuiltin => "Builtin"
  case Nm.RCap => "Cap"
  case Nm.RUnres => "Unresolved"

def Nm.kindStr(b: I64): Str =
  Nm.rkOf(b) match
    case Coll.Some(k) => Nm.rkName(k)
    case Coll.None => "badkind"

def Nm.kGlobal(): I64 = Nm.rkByte(Nm.RGlobal)
def Nm.kLocal(): I64 = Nm.rkByte(Nm.RLocal)
def Nm.kCase(): I64 = Nm.rkByte(Nm.RCase)
def Nm.kBuiltin(): I64 = Nm.rkByte(Nm.RBuiltin)
def Nm.kCap(): I64 = Nm.rkByte(Nm.RCap)
def Nm.kUnres(): I64 = Nm.rkByte(Nm.RUnres)

// scope entry kinds: a binder token, or an implicit binder (`result`) with no token of its own
def Nm.bBinder(): I64 = 0
def Nm.bImplicit(): I64 = 1
// the continuation k of a handler fn: resumed, never read
def Nm.bCont(): I64 = 2

// counter slots
def Nm.sSyms(): I64 = 0
def Nm.sPool(): I64 = 1
def Nm.sDecl(): I64 = 2
def Nm.sSp(): I64 = 3
def Nm.sOver(): I64 = 4
def Nm.sDup(): I64 = 5
def Nm.sRes(): I64 = 6
def Nm.sUnres(): I64 = 7
def Nm.sShown(): I64 = 8
def Nm.sKinds(): I64 = 9
def Nm.sLocals(): I64 = 15
def Nm.sMaxSp(): I64 = 16
// the deepest scope of the decl being resolved; decls whose scope is not empty at their end (a leak)
def Nm.sRootMax(): I64 = 18
def Nm.sLeak(): I64 = 19
// the top decls by scope depth, deepest first: depth at sTop + i, file at sTop + 5 + i, line at sTop + 10 + i
def Nm.sTop(): I64 = 40
def Nm.nTop(): I64 = 5
def Nm.sPerr(): I64 = 17
def Nm.sUFile(): I64 = 20
def Nm.sUTok(): I64 = 30
def Nm.maxShown(): I64 = 10

// ── the world ──
enum Nm.Sy:
  case Nm.Sy(hcap: I64, hs: Array[U32](hcap), scap: I64, so: Array[U32](scap), sl: Array[U32](scap), pcap: I64, pool: Array[U8](pcap))

// decl id -> kind byte, file, line, name symbol; tab: symbol id -> decl id (0 = none). decl 0 and symbol 0 are the absent ones.
enum Nm.Gt:
  case Nm.Gt(gcap: I64, gk: Array[U8](gcap), gf: Array[U32](gcap), gl: Array[U32](gcap), gs: Array[U32](gcap), tcap: I64, tab: Array[U32](tcap))

enum Nm.Sc:
  case Nm.Sc(cap: I64, ss: Array[U32](cap), st: Array[U32](cap), sk: Array[U8](cap))

enum Nm.Cn:
  case Nm.Cn(cnn: I64, cn: Array[I64](cnn))

enum Nm.W:
  case Nm.W(sy: Nm.Sy, gt: Nm.Gt, sc: Nm.Sc, cn: Nm.Cn)

def Nm.cget(w: Nm.W, s: I64): I64 =
  val Nm.W(_, _, _, c) = w
  val Nm.Cn(cnn, cn) = c
  if 0 <= s && s < cnn then cn(s)
  // shortcut: slots are the Nm.s* constants, always below cnn; s3 Vec will make it unrepresentable
  else 0

def Nm.cset(w: Nm.W, s: I64, v: I64): Unit =
  val Nm.W(_, _, _, c) = w
  val Nm.Cn(cnn, cn) = c
  if 0 <= s && s < cnn then Array.put(cn, s, v)
  else ()

def Nm.cinc(w: Nm.W, s: I64): Unit = Nm.cset(w, s, Nm.cget(w, s) + 1)

def Nm.over(w: Nm.W): Unit = Nm.cinc(w, Nm.sOver())

def Nm.world(ntok: I64, nbytes: I64): Nm.W =
  val hcap = 2 * ntok + 1024
  val scap = ntok + 1024
  val pcap = nbytes + 8192
  val gcap = ntok + 1024
  val ccap = ntok + 1024
  val cnn = 64
  val hs = Array.fill(hcap, U32.of(0))
  val so = Array.fill(scap, U32.of(0))
  val sl = Array.fill(scap, U32.of(0))
  val pool = Array.fill(pcap, U8.of(0))
  val gk = Array.fill(gcap, U8.of(0))
  val gf = Array.fill(gcap, U32.of(0))
  val gl = Array.fill(gcap, U32.of(0))
  val gs = Array.fill(gcap, U32.of(0))
  val tab = Array.fill(scap, U32.of(0))
  val ss = Array.fill(ccap, U32.of(0))
  val st = Array.fill(ccap, U32.of(0))
  val sk = Array.fill(ccap, U8.of(0))
  val cn = Array.fill(cnn, 0)
  val w = Nm.W(Nm.Sy(hcap, hs, scap, so, sl, pcap, pool), Nm.Gt(gcap, gk, gf, gl, gs, scap, tab), Nm.Sc(ccap, ss, st, sk), Nm.Cn(cnn, cn))
  // symbol 0 and decl 0 are the absent ones
  Nm.cset(w, Nm.sSyms(), 1)
  Nm.cset(w, Nm.sDecl(), 1)
  w

// ── symbols: a text is seg1 [. seg2], hashed and compared byte by byte without building it ──
enum Nm.T:
  case Nm.T(s1: Str, o1: I64, l1: I64, s2: Str, o2: I64, l2: I64)

def Nm.tLen(t: Nm.T): I64 =
  val Nm.T(_, _, l1, _, _, l2) = t
  if l2 > 0 then l1 + 1 + l2 else l1

def Nm.tAt(t: Nm.T, i: I64): I64 =
  val Nm.T(s1, o1, l1, s2, o2, _) = t
  if i < l1 then Str.at(s1, o1 + i)
  else if i == l1 then 46
  else Str.at(s2, o2 + i - l1 - 1)

def Nm.hashT(t: Nm.T, i: I64, n: I64, h: I64): I64 =
  if i < n then Nm.hashT(t, i + 1, n, (h + Nm.tAt(t, i)) * 16777619 % 4294967296) else h

def Nm.lit(s: Str): Nm.T = Nm.T(s, 0, Str.len(s), "", 0, 0)

def Nm.poolEq(pcap: I64, pool: Array[U8](pcap), p: I64, t: Nm.T, i: I64, n: I64): Bool =
  val q = p + i
  if i >= n then true
  else if 0 <= q && q < pcap then
    if I64.ofU8(pool(q)) == Nm.tAt(t, i) then Nm.poolEq(pcap, pool, p, t, i + 1, n) else false
  else false

def Nm.symEq(w: Nm.W, id: I64, t: Nm.T, n: I64): Bool =
  val Nm.W(sy, _, _, _) = w
  val Nm.Sy(_, _, scap, so, sl, pcap, pool) = sy
  if 0 <= id && id < scap then
    if I64.of(sl(id)) == n then Nm.poolEq(pcap, pool, I64.of(so(id)), t, 0, n) else false
  else false

def Nm.cpPool(pcap: I64, pool: Array[U8](pcap), p: I64, t: Nm.T, i: I64, n: I64): Unit =
  val q = p + i
  if i < n && 0 <= q && q < pcap then
    Array.put(pool, q, U8.of(Nm.tAt(t, i)))
    Nm.cpPool(pcap, pool, p, t, i + 1, n)
  else ()

// a new symbol for t at hash slot `slot`
def Nm.insert(w: Nm.W, t: Nm.T, n: I64, slot: I64): I64 =
  val Nm.W(sy, _, _, _) = w
  val Nm.Sy(hcap, hs, scap, so, sl, pcap, pool) = sy
  val id = Nm.cget(w, Nm.sSyms())
  val pp = Nm.cget(w, Nm.sPool())
  if 0 <= id && id < scap && 0 <= slot && slot < hcap && 0 <= pp && pp + n <= pcap then
    Array.put(hs, slot, U32.of(id))
    Array.put(so, id, U32.of(pp))
    Array.put(sl, id, U32.of(n))
    Nm.cpPool(pcap, pool, pp, t, 0, n)
    Nm.cset(w, Nm.sSyms(), id + 1)
    Nm.cset(w, Nm.sPool(), pp + n)
    id
  // shortcut: s2 cannot express room-guaranteed append; s3 Vec will make it unrepresentable
  else
    Nm.over(w)
    0

// the symbol of t (0 = absent; with ins the symbol is made when absent)
def Nm.probe(w: Nm.W, t: Nm.T, n: I64, ins: Bool, start: I64, k: I64): I64 =
  val Nm.W(sy, _, _, _) = w
  val Nm.Sy(hcap, hs, _, _, _, _, _) = sy
  if 0 <= k && k < hcap then
    val slot = (start + k) % hcap
    if 0 <= slot && slot < hcap then
      val id = I64.of(hs(slot))
      if id == 0 then
        if ins then Nm.insert(w, t, n, slot) else 0
      else if Nm.symEq(w, id, t, n) then id
      else Nm.probe(w, t, n, ins, start, k + 1)
    // shortcut: s2 cannot express room-guaranteed append; s3 Vec will make it unrepresentable
    else
      Nm.over(w)
      0
  // shortcut: s2 cannot express room-guaranteed append; s3 Vec will make it unrepresentable
  else
    Nm.over(w)
    0

def Nm.sym(w: Nm.W, t: Nm.T, ins: Bool): I64 =
  val Nm.W(sy, _, _, _) = w
  val Nm.Sy(hcap, _, _, _, _, _, _) = sy
  val n = Nm.tLen(t)
  if hcap > 0 then Nm.probe(w, t, n, ins, Nm.hashT(t, 0, n, 2166136261) % hcap, 0)
  else
    Nm.over(w)
    0

// ── files: tokens, decl roots, the line of every token ──
def Nm.srcOf(g: Na.G): Str =
  val Na.G(tk, _, _, _) = g
  val Na.Tk(src, _, _, _, _, _) = tk
  src

def Nm.tcapOf(g: Na.G): I64 =
  val Na.G(tk, _, _, _) = g
  val Na.Tk(_, tcap, _, _, _, _) = tk
  tcap

def Nm.tokT(g: Na.G, j: I64): Nm.T =
  val o = Na.toff(g, j)
  Nm.T(Nm.srcOf(g), o, Na.tlen(g, j), "", 0, 0)

def Nm.isUnder(g: Na.G, j: I64): Bool =
  Na.tlen(g, j) == 1 && Str.at(Nm.srcOf(g), Na.toff(g, j)) == 95

enum Nm.F:
  case Nm.F(path: Str, g: Na.G, lcap: I64, ln: Array[U32](lcap), rc: I64, rk: Array[U8](rc), rr: Array[U32](rc), perr: I64)

def Nm.nlCount(src: Str, i: I64, e: I64, acc: I64): I64 =
  if i < e then Nm.nlCount(src, i + 1, e, if Str.at(src, i) == 10 then acc + 1 else acc) else acc

def Nm.lineFill(g: Na.G, lcap: I64, ln: Array[U32](lcap), j: I64, t: I64, prev: I64, line: I64): Unit =
  if 0 <= j && j < t && j < lcap then
    val o = Na.toff(g, j)
    val l2 = if o > prev then line + Nm.nlCount(Nm.srcOf(g), prev, o, 0) else line
    Array.put(ln, j, U32.of(l2))
    Nm.lineFill(g, lcap, ln, j + 1, t, if o > prev then o else prev, l2)
  else ()

def Nm.lineAt(lcap: I64, ln: Array[U32](lcap), j: I64): I64 =
  if 0 <= j && j < lcap then I64.of(ln(j)) else 0

// parse every decl of the skeleton that has an AST (def .. given); a decl that does not parse keeps root 0 and is counted
def Nm.parseDecls(g: Na.G, cap: I64, kd: Array[U8](cap), hd: Array[U32](cap), hi: Array[U32](cap), c: I64, rc: I64, rk: Array[U8](rc), rr: Array[U32](rc), i: I64, perr: I64): I64 =
  if 0 <= i && i < c && i < cap && i < rc then
    val kb = I64.ofU8(kd(i))
    Array.put(rk, i, U8.of(kb))
    if kb <= Ps.kindByte(Ps.Given) then
      val root = Pz.decl(g, I64.of(hd(i)), I64.of(hi(i)), kb)
      if Pz.ok(g) then
        Array.put(rr, i, U32.of(root))
        Nm.parseDecls(g, cap, kd, hd, hi, c, rc, rk, rr, i + 1, perr)
      else Nm.parseDecls(g, cap, kd, hd, hi, c, rc, rk, rr, i + 1, perr + 1)
    else Nm.parseDecls(g, cap, kd, hd, hi, c, rc, rk, rr, i + 1, perr)
  else perr

def Nm.parseFile(p: Str, src: Str): Nm.F =
  val lx = Lx.lex(Lx.Skip, src)
  val Ps.Out(cap, kd, _, hd, _, hi, c, _, _, _, _) = Ps.parse(src, lx)
  val g = Pz.build(src, lx)
  val rc = c + 1
  val rk = Array.fill(rc, U8.of(0))
  val rr = Array.fill(rc, U32.of(0))
  val perr = Nm.parseDecls(g, cap, kd, hd, hi, c, rc, rk, rr, 0, 0)
  val lcap = Nm.tcapOf(g)
  val ln = Array.fill(lcap, U32.of(0))
  val Lx.Out(_, _, _, _, t, _, _, _, _) = lx
  Nm.lineFill(g, lcap, ln, 0, t, 0, 1)
  Nm.F(p, g, lcap, ln, rc, rk, rr, perr)

def Nm.load(i: I64): Coll.List[Nm.F] =
  if i >= Args.count() then Coll.Nil
  else
    val p = Args.at(i)
    Files.bytes(p) match
      case Os.Ok(src) =>
        val f = Nm.parseFile(p, src)
        Coll.Cons(f, Nm.load(i + 1))
      case Os.Fail(_) =>
        Console.print(p)
        Console.print(" unreadable\n")
        Nm.load(i + 1)

def Nm.sumTok(fs: Coll.List[Nm.F], acc: I64): I64 = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Nm.F(_, g, _, _, _, _, _, _) = f
    Nm.sumTok(rest, acc + Nm.tcapOf(g))

def Nm.sumBytes(fs: Coll.List[Nm.F], acc: I64): I64 = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Nm.F(_, g, _, _, _, _, _, _) = f
    Nm.sumBytes(rest, acc + Str.len(Nm.srcOf(g)))

def Nm.sumPerr(fs: Coll.List[Nm.F], acc: I64): I64 = fs match
  case Coll.Nil => acc
  case Coll.Cons(f, rest) =>
    val Nm.F(_, _, _, _, _, _, _, pe) = f
    Nm.sumPerr(rest, acc + pe)

def Nm.nth(fs: Coll.List[Nm.F], i: I64): Coll.Option[Nm.F] = fs match
  case Coll.Nil => Coll.None
  case Coll.Cons(f, rest) => if i == 0 then Coll.Some(f) else Nm.nth(rest, i - 1)

// ── globals ──
// a global of kind kb named by symbol sym, declared in file fi at line; the first declaration of a symbol wins, later ones are counted
def Nm.declare(w: Nm.W, kb: I64, fi: I64, line: I64, sym: I64): Unit =
  val Nm.W(_, gt, _, _) = w
  val Nm.Gt(gcap, gk, gf, gl, gs, tcap, tab) = gt
  val d = Nm.cget(w, Nm.sDecl())
  if 0 < sym && 0 <= sym && sym < tcap && 0 <= d && d < gcap then
    if I64.of(tab(sym)) != 0 then Nm.cinc(w, Nm.sDup())
    else
      Array.put(gk, d, U8.of(kb))
      Array.put(gf, d, U32.of(fi))
      Array.put(gl, d, U32.of(line))
      Array.put(gs, d, U32.of(sym))
      Array.put(tab, sym, U32.of(d))
      Nm.cset(w, Nm.sDecl(), d + 1)
  // shortcut: s2 cannot express room-guaranteed append; s3 Vec will make it unrepresentable
  else Nm.over(w)

def Nm.bi(w: Nm.W, s: Str): Unit = Nm.declare(w, Nm.kBuiltin(), 0, 0, Nm.sym(w, Nm.lit(s), true))

// the builtin calls of s2/names.srs Names.builtins (163) and Names.atoms (167, 170), and the two literals the parser reads as names
def Nm.builtins(w: Nm.W): Unit =
  Nm.bi(w, "Array.fill")
  Nm.bi(w, "Array.tabulate")
  Nm.bi(w, "Array.slice")
  Nm.bi(w, "Array.put")
  Nm.bi(w, "Array.blit")
  Nm.bi(w, "Array.aload")
  Nm.bi(w, "Array.astore")
  Nm.bi(w, "Array.cas")
  Nm.bi(w, "Array.fetchAdd")
  Nm.bi(w, "Cell.new")
  Nm.bi(w, "Cell.get")
  Nm.bi(w, "Cell.put")
  Nm.bi(w, "ACell.new")
  Nm.bi(w, "ACell.load")
  Nm.bi(w, "ACell.store")
  Nm.bi(w, "ACell.cas")
  Nm.bi(w, "ACell.fetchAdd")
  Nm.bi(w, "true")
  Nm.bi(w, "false")

def Nm.declTok(w: Nm.W, g: Na.G, lcap: I64, ln: Array[U32](lcap), fi: I64, kb: I64, tok: I64): Unit =
  Nm.declare(w, kb, fi, Nm.lineAt(lcap, ln, tok), Nm.sym(w, Nm.tokT(g, tok), true))

// the cases of an enum are the items of kind kCase / kCaseNP of its part list
def Nm.declCases(w: Nm.W, g: Na.G, lcap: I64, ln: Array[U32](lcap), fi: I64, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    val k = Na.kd(g, n)
    if k == Na.kCase() || k == Na.kCaseNP() then Nm.declTok(w, g, lcap, ln, fi, Nm.kCase(), Na.tok(g, n)) else ()
    Nm.declCases(w, g, lcap, ln, fi, r, i + 1)
  else ()

// a capability's defs are the requests Cap.op
def Nm.declOps(w: Nm.W, g: Na.G, lcap: I64, ln: Array[U32](lcap), fi: I64, ptok: I64, r: I64, i: I64): Unit =
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kCapDef() then
      val s = Nm.srcOf(g)
      val t = Nm.T(s, Na.toff(g, ptok), Na.tlen(g, ptok), s, Na.toff(g, Na.a(g, n)), Na.tlen(g, Na.a(g, n)))
      Nm.declare(w, Nm.kCap(), fi, Nm.lineAt(lcap, ln, Na.a(g, n)), Nm.sym(w, t, true))
    else ()
    Nm.declOps(w, g, lcap, ln, fi, ptok, r, i + 1)
  else ()

def Nm.declExtern(w: Nm.W, g: Na.G, lcap: I64, ln: Array[U32](lcap), fi: I64, inner: I64): Unit =
  val k = Na.kd(g, inner)
  if k == Na.kDef() then Nm.declTok(w, g, lcap, ln, fi, Nm.kGlobal(), Na.a(g, inner))
  else if k == Na.kCVal() then Nm.declTok(w, g, lcap, ln, fi, Nm.kGlobal(), Na.tok(g, inner))
  else if k == Na.kCStruct() then
    // Libc.<name>.new, as s2 Names.decl 209
    val s = Nm.srcOf(g)
    val t = Nm.T(s, Na.toff(g, Na.tok(g, inner)), Na.tlen(g, Na.tok(g, inner)), "new", 0, 3)
    Nm.declare(w, Nm.kGlobal(), fi, Nm.lineAt(lcap, ln, Na.tok(g, inner)), Nm.sym(w, t, true))
  else ()

// kb = the skeleton's decl kind byte: 0 def, 1 enum, 2 extern, 3 handler, 4 capability, 5 trait, 6 type, 7 val, 8 given
def Nm.declRoot(w: Nm.W, g: Na.G, lcap: I64, ln: Array[U32](lcap), fi: I64, kb: I64, root: I64): Unit =
  if kb == 0 then Nm.declTok(w, g, lcap, ln, fi, Nm.kGlobal(), Na.a(g, root))
  else if kb == 1 then Nm.declCases(w, g, lcap, ln, fi, Na.b(g, root), 0)
  else if kb == 2 then Nm.declExtern(w, g, lcap, ln, fi, Na.b(g, root))
  else if kb == 4 then Nm.declOps(w, g, lcap, ln, fi, Na.a(g, root), Na.b(g, root), 0)
  else if kb == 7 then Nm.declTok(w, g, lcap, ln, fi, Nm.kGlobal(), Na.tok(g, root))
  else ()

def Nm.declFile(w: Nm.W, f: Nm.F, fi: I64, i: I64): Unit =
  val Nm.F(_, g, lcap, ln, rc, rk, rr, _) = f
  if 0 <= i && i < rc then
    val root = I64.of(rr(i))
    if root != 0 then Nm.declRoot(w, g, lcap, ln, fi, I64.ofU8(rk(i)), root) else ()
    Nm.declFile(w, f, fi, i + 1)
  else ()

def Nm.declFiles(w: Nm.W, fs: Coll.List[Nm.F], fi: I64): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    Nm.declFile(w, f, fi, 0)
    Nm.declFiles(w, rest, fi + 1)

// ── resolution ──
enum Nm.X:
  case Nm.X(w: Nm.W, g: Na.G, fi: I64, path: Str, dump: Bool, lcap: I64, ln: Array[U32](lcap), rcap: I64, rk: Array[U8](rcap), rf: Array[U32](rcap))

def Nm.sp(x: Nm.X): I64 =
  val Nm.X(w, _, _, _, _, _, _, _, _, _) = x
  Nm.cget(w, Nm.sSp())

def Nm.setSp(x: Nm.X, v: I64): Unit =
  val Nm.X(w, _, _, _, _, _, _, _, _, _) = x
  Nm.cset(w, Nm.sSp(), v)

// push a binder: the symbol of text t, the binder token, its kind
def Nm.push(x: Nm.X, t: Nm.T, tok: I64, kb: I64): Unit =
  val Nm.X(w, _, _, _, _, _, _, _, _, _) = x
  val Nm.W(_, _, sc, _) = w
  val Nm.Sc(cap, ss, st, sk) = sc
  val sym = Nm.sym(w, t, true)
  val sp = Nm.cget(w, Nm.sSp())
  if 0 < sym && 0 <= sp && sp < cap then
    Array.put(ss, sp, U32.of(sym))
    Array.put(st, sp, U32.of(tok))
    Array.put(sk, sp, U8.of(kb))
    Nm.cset(w, Nm.sSp(), sp + 1)
    Nm.cinc(w, Nm.sLocals())
    if sp + 1 > Nm.cget(w, Nm.sMaxSp()) then Nm.cset(w, Nm.sMaxSp(), sp + 1) else ()
    if sp + 1 > Nm.cget(w, Nm.sRootMax()) then Nm.cset(w, Nm.sRootMax(), sp + 1) else ()
  // shortcut: s2 cannot express room-guaranteed append; s3 Vec will make it unrepresentable
  else Nm.over(w)

// bind the name token j (`_` binds nothing)
def Nm.bind(x: Nm.X, j: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if Nm.isUnder(g, j) then () else Nm.push(x, Nm.tokT(g, j), j, Nm.bBinder())

def Nm.bindResult(x: Nm.X, j: I64): Unit = Nm.push(x, Nm.lit("result"), j, Nm.bImplicit())

def Nm.look(w: Nm.W, sym: I64, i: I64): Coll.Option[I64] =
  val Nm.W(_, _, sc, _) = w
  val Nm.Sc(cap, ss, _, _) = sc
  if 0 <= i && i < cap then
    if I64.of(ss(i)) == sym then Coll.Some(i) else Nm.look(w, sym, i - 1)
  else Coll.None

def Nm.lineOfTok(x: Nm.X, j: I64): I64 =
  val Nm.X(_, _, _, _, _, lcap, ln, _, _, _) = x
  Nm.lineAt(lcap, ln, j)

def Nm.printPool(pcap: I64, pool: Array[U8](pcap), p: I64, i: I64, n: I64): Unit =
  val q = p + i
  if i < n && 0 <= q && q < pcap then
    Console.printChar(I64.ofU8(pool(q)))
    Nm.printPool(pcap, pool, p, i + 1, n)
  else ()

def Nm.printSym(w: Nm.W, id: I64): Unit =
  val Nm.W(sy, _, _, _) = w
  val Nm.Sy(_, _, scap, so, sl, pcap, pool) = sy
  if 0 <= id && id < scap then Nm.printPool(pcap, pool, I64.of(so(id)), 0, I64.of(sl(id)))
  else ()

def Nm.dumpLine(x: Nm.X, j: I64, kb: I64, ref: I64): Unit =
  val Nm.X(w, g, _, path, _, lcap, ln, _, _, _) = x
  val Nm.W(_, gt, _, _) = w
  val Nm.Gt(gcap, _, gf, gl, gs, _, _) = gt
  Console.print(path)
  Console.print(":")
  Console.printI64(Nm.lineAt(lcap, ln, j))
  Console.print(" ")
  Console.print(Na.text(g, j))
  Console.print(" ")
  Console.print(Nm.kindStr(kb))
  Console.print(" ")
  if kb == Nm.kLocal() then
    Console.printI64(Nm.lineAt(lcap, ln, ref))
    Console.print(":")
    Console.print(Na.text(g, ref))
    Console.print(" ut=")
    Console.printI64(j)
    Console.print(" tt=")
    Console.printI64(ref)
  else if kb == Nm.kUnres() || kb == Nm.kBuiltin() then Console.print("-")
  else if 0 <= ref && ref < gcap then
    Console.printI64(I64.of(gf(ref)))
    Console.print(":")
    Console.printI64(I64.of(gl(ref)))
    Console.print(":")
    Nm.printSym(w, I64.of(gs(ref)))
  else Console.print("badref")
  Console.print("\n")

// record the resolution of use token j
def Nm.set(x: Nm.X, j: I64, kb: I64, ref: I64): Unit =
  val Nm.X(w, _, fi, _, dump, _, _, rcap, rk, rf) = x
  if 0 <= j && j < rcap then
    Array.put(rk, j, U8.of(kb))
    Array.put(rf, j, U32.of(ref))
  // shortcut: a use token is a token of its file, always below rcap; s3 Vec will make it unrepresentable
  else Nm.over(w)
  Nm.cinc(w, Nm.sKinds() + kb)
  if kb == Nm.kUnres() then
    Nm.cinc(w, Nm.sUnres())
    val sh = Nm.cget(w, Nm.sShown())
    if sh < Nm.maxShown() then
      Nm.cset(w, Nm.sUFile() + sh, fi)
      Nm.cset(w, Nm.sUTok() + sh, j)
      Nm.cset(w, Nm.sShown(), sh + 1)
    else ()
  else Nm.cinc(w, Nm.sRes())
  if dump then Nm.dumpLine(x, j, kb, ref) else ()

// the innermost local of this symbol, else a global; else Unresolved
def Nm.use(x: Nm.X, j: I64): Unit =
  val Nm.X(w, g, _, _, _, _, _, _, _, _) = x
  val sym = Nm.sym(w, Nm.tokT(g, j), false)
  Nm.look(w, sym, Nm.cget(w, Nm.sSp()) - 1) match
    case Coll.Some(i) => Nm.useLocal(x, j, i, sym)
    case Coll.None => Nm.useGlobal(x, j, sym)

// resume k(v): k is the continuation of the handler fn, which is no value (tests/s2/neg/ms_k_value.srs): only a continuation binder answers
def Nm.useK(x: Nm.X, j: I64): Unit =
  val Nm.X(w, g, _, _, _, _, _, _, _, _) = x
  val sym = Nm.sym(w, Nm.tokT(g, j), false)
  Nm.look(w, sym, Nm.cget(w, Nm.sSp()) - 1) match
    case Coll.Some(i) => Nm.useKAt(x, j, i)
    case Coll.None => Nm.set(x, j, Nm.kUnres(), 0)

def Nm.useKAt(x: Nm.X, j: I64, i: I64): Unit =
  val Nm.X(w, _, _, _, _, _, _, _, _, _) = x
  val Nm.W(_, _, sc, _) = w
  val Nm.Sc(cap, _, st, sk) = sc
  if 0 <= i && i < cap then
    if I64.ofU8(sk(i)) == Nm.bCont() then Nm.set(x, j, Nm.kLocal(), I64.of(st(i)))
    else Nm.set(x, j, Nm.kUnres(), 0)
  // shortcut: Nm.look answers an index below cap; s3 Vec will make it unrepresentable
  else Nm.over(w)

// a continuation binder is no value: a value use of its name goes on to the globals
def Nm.useLocal(x: Nm.X, j: I64, i: I64, sym: I64): Unit =
  val Nm.X(w, _, _, _, _, _, _, _, _, _) = x
  val Nm.W(_, _, sc, _) = w
  val Nm.Sc(cap, _, st, sk) = sc
  if 0 <= i && i < cap then
    if I64.ofU8(sk(i)) == Nm.bImplicit() then Nm.set(x, j, Nm.kBuiltin(), I64.of(st(i)))
    else if I64.ofU8(sk(i)) == Nm.bCont() then Nm.useGlobal(x, j, sym)
    else Nm.set(x, j, Nm.kLocal(), I64.of(st(i)))
  // shortcut: Nm.look answers an index below cap; s3 Vec will make it unrepresentable
  else Nm.over(w)

def Nm.useGlobal(x: Nm.X, j: I64, sym: I64): Unit =
  val Nm.X(w, _, _, _, _, _, _, _, _, _) = x
  val Nm.W(_, gt, _, _) = w
  val Nm.Gt(gcap, gk, _, _, _, tcap, tab) = gt
  val d = if 0 <= sym && sym < tcap then I64.of(tab(sym)) else 0
  if 0 < d && 0 <= d && d < gcap then Nm.set(x, j, I64.ofU8(gk(d)), d)
  else Nm.set(x, j, Nm.kUnres(), 0)

def Nm.useList(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    Nm.use(x, Na.item(g, r, i))
    Nm.useList(x, r, i + 1)
  else ()

// the value args of a type (Array[A](n)) are expressions; its type args are types; <g> names binders
def Nm.ty(x: Nm.X, t: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  val k = Na.kd(g, t)
  if k == Na.kTy() then
    Nm.tys(x, Na.a(g, t), 0)
    Nm.exprs(x, Na.b(g, t), 0)
  else if k == Na.kTyCaps() then
    Nm.ty(x, Na.a(g, t))
    Nm.useList(x, Na.b(g, t), 0)
  else ()

def Nm.tys(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    Nm.ty(x, Na.item(g, r, i))
    Nm.tys(x, r, i + 1)
  else ()

def Nm.exprs(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    Nm.expr(x, Na.item(g, r, i))
    Nm.exprs(x, r, i + 1)
  else ()

// the groups of a call, in written order: [T] types, {a} evidence names
def Nm.callGroups(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kCGTys() then Nm.tys(x, Na.a(g, n), 0)
    else if Na.kd(g, n) == Na.kCGEv() then Nm.useList(x, Na.a(g, n), 0)
    else ()
    Nm.callGroups(x, r, i + 1)
  else ()

def Nm.expr(x: Nm.X, n: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  val k = Na.kd(g, n)
  if k == Na.kName() then Nm.use(x, Na.tok(g, n))
  else if k == Na.kParen() || k == Na.kUn() then Nm.expr(x, Na.a(g, n))
  else if k == Na.kCall() then
    Nm.use(x, Na.tok(g, n))
    Nm.callGroups(x, Na.a(g, n), 0)
    Nm.exprs(x, Na.b(g, n), 0)
  else if k == Na.kMethod() then
    Nm.use(x, Na.tok(g, n))
    Nm.exprs(x, Na.b(g, n), 0)
  else if k == Na.kResume() then
    Nm.useK(x, Na.a(g, n))
    Nm.expr(x, Na.b(g, n))
  else if k == Na.kBin() || k == Na.kWhile() || k == Na.kPair() || k == Na.kIf() || k == Na.kIfNl() then
    Nm.expr(x, Na.a(g, n))
    Nm.expr(x, Na.b(g, n))
  else if k == Na.kMatch() then
    Nm.expr(x, Na.a(g, n))
    Nm.arms(x, Na.b(g, n), 0)
  else if k == Na.kBlock() then
    val sp = Nm.sp(x)
    Nm.stmts(x, Na.a(g, n), 0)
    Nm.setSp(x, sp)
  else if k == Na.kAssign() then
    Nm.use(x, Na.tok(g, n))
    Nm.expr(x, Na.a(g, n))
  else if k == Na.kQuant() then
    val sp = Nm.sp(x)
    val bd = Na.a(g, n)
    Nm.ty(x, Na.a(g, bd))
    Nm.bind(x, Na.tok(g, bd))
    Nm.expr(x, Na.b(g, n))
    Nm.setSp(x, sp)
  else ()

// an arm: its case is a use; its binders are locals of its body
def Nm.arms(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val arm = Na.item(g, r, i)
    val p = Na.a(g, arm)
    val k = Na.kd(g, p)
    val sp = Nm.sp(x)
    if k == Na.kPCase() then
      Nm.use(x, Na.tok(g, p))
      Nm.bindList(x, Na.a(g, p), 0)
    else if k == Na.kPCaseNP() then Nm.use(x, Na.tok(g, p))
    else ()
    Nm.expr(x, Na.b(g, arm))
    Nm.setSp(x, sp)
    Nm.arms(x, r, i + 1)
  else ()

def Nm.bindList(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    Nm.bind(x, Na.item(g, r, i))
    Nm.bindList(x, r, i + 1)
  else ()

// a block: each statement in turn; a val, var, handle or val-pattern binds for the statements after it, not for its own value
def Nm.stmts(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val s = Na.item(g, r, i)
    val k = Na.kd(g, s)
    if k == Na.kVal() || k == Na.kVar() then
      Nm.ty(x, Na.a(g, s))
      Nm.expr(x, Na.b(g, s))
      Nm.bind(x, Na.tok(g, s))
    else if k == Na.kHandle() then
      Nm.exprs(x, Na.b(g, s), 0)
      Nm.bind(x, Na.tok(g, s))
    else if k == Na.kPatVal() then
      Nm.use(x, Na.tok(g, s))
      Nm.expr(x, Na.b(g, s))
      Nm.bindList(x, Na.a(g, s), 0)
    else Nm.expr(x, Na.a(g, s))
    Nm.stmts(x, r, i + 1)
  else ()

// ── decls ──
// the binders of the {} evidence groups of a def's parts, then its params: all are locals of its types, clauses and body
def Nm.bindEv(x: Nm.X, parts: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, parts) then
    val p = Na.item(g, parts, i)
    if Na.kd(g, p) == Na.kGEv() then Nm.bindBinders(x, Na.a(g, p), 0) else ()
    Nm.bindEv(x, parts, i + 1)
  else ()

def Nm.bindPar(x: Nm.X, parts: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, parts) then
    val p = Na.item(g, parts, i)
    if Na.kd(g, p) == Na.kParams() then Nm.bindBinders(x, Na.a(g, p), 0) else ()
    Nm.bindPar(x, parts, i + 1)
  else ()

// kBind and kBare (a handler op's continuation) bind their token; kBindAnon and kDots bind nothing
def Nm.bindBinders(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val b = Na.item(g, r, i)
    val k = Na.kd(g, b)
    if k == Na.kBind() then Nm.bind(x, Na.tok(g, b))
    else if k == Na.kBare() then Nm.push(x, Nm.tokT(g, Na.tok(g, b)), Na.tok(g, b), Nm.bCont())
    else ()
    Nm.bindBinders(x, r, i + 1)
  else ()

// the value args of the types of a binder list
def Nm.binderTys(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val b = Na.item(g, r, i)
    val k = Na.kd(g, b)
    if k == Na.kBind() || k == Na.kBindAnon() then Nm.ty(x, Na.a(g, b)) else ()
    Nm.binderTys(x, r, i + 1)
  else ()

// the types, clauses and body of a def, in written order
def Nm.parts(x: Nm.X, parts: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, parts) then
    val p = Na.item(g, parts, i)
    val k = Na.kd(g, p)
    if k == Na.kGEv() || k == Na.kParams() then Nm.binderTys(x, Na.a(g, p), 0)
    else if k == Na.kRet() then Nm.ty(x, Na.a(g, p))
    else if k == Na.kClause() then
      val sp = Nm.sp(x)
      Nm.bindResult(x, Na.tok(g, p))
      Nm.expr(x, Na.a(g, p))
      Nm.setSp(x, sp)
    else if k == Na.kProofUs() then Nm.useList(x, Na.a(g, p), 0)
    else if k == Na.kBody() then Nm.expr(x, Na.a(g, p))
    else ()
    Nm.parts(x, parts, i + 1)
  else ()

def Nm.defN(x: Nm.X, d: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  val sp = Nm.sp(x)
  val parts = Na.b(g, d)
  Nm.bindEv(x, parts, 0)
  Nm.bindPar(x, parts, 0)
  Nm.parts(x, parts, 0)
  Nm.setSp(x, sp)

// the defs among the parts of a handler, trait or given
def Nm.defsOf(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kDef() then Nm.defN(x, n) else ()
    Nm.defsOf(x, r, i + 1)
  else ()

// the field types of a case name the other fields of the case
def Nm.cases(x: Nm.X, r: I64, i: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  if i < Na.len(g, r) then
    val n = Na.item(g, r, i)
    if Na.kd(g, n) == Na.kCase() then
      val sp = Nm.sp(x)
      Nm.bindBinders(x, Na.a(g, n), 0)
      Nm.binderTys(x, Na.a(g, n), 0)
      Nm.setSp(x, sp)
    else ()
    Nm.cases(x, r, i + 1)
  else ()

// insert (depth d, file f, line l) into the sorted top list at position i; the displaced entry moves down
def Nm.topIns(w: Nm.W, i: I64, d: I64, f: I64, l: I64): Unit =
  if i < Nm.nTop() then
    val cd = Nm.cget(w, Nm.sTop() + i)
    if d > cd then
      val cf = Nm.cget(w, Nm.sTop() + Nm.nTop() + i)
      val cl = Nm.cget(w, Nm.sTop() + 2 * Nm.nTop() + i)
      Nm.cset(w, Nm.sTop() + i, d)
      Nm.cset(w, Nm.sTop() + Nm.nTop() + i, f)
      Nm.cset(w, Nm.sTop() + 2 * Nm.nTop() + i, l)
      Nm.topIns(w, i + 1, cd, cf, cl)
    else Nm.topIns(w, i + 1, d, f, l)
  else ()

// one decl: the scope starts empty, the depth it reached is ranked, a scope left non-empty is counted as a leak
def Nm.root(x: Nm.X, kb: I64, root: I64): Unit =
  val Nm.X(w, g, fi, _, _, _, _, _, _, _) = x
  Nm.cset(w, Nm.sRootMax(), 0)
  Nm.root0(x, kb, root)
  if Nm.sp(x) != 0 then Nm.cinc(w, Nm.sLeak()) else ()
  Nm.topIns(w, 0, Nm.cget(w, Nm.sRootMax()), fi, Nm.lineOfTok(x, Na.tok(g, root)))

def Nm.root0(x: Nm.X, kb: I64, root: I64): Unit =
  val Nm.X(_, g, _, _, _, _, _, _, _, _) = x
  Nm.setSp(x, 0)
  if kb == 0 then Nm.defN(x, root)
  else if kb == 1 then Nm.cases(x, Na.b(g, root), 0)
  else if kb == 2 then
    if Na.kd(g, Na.b(g, root)) == Na.kDef() then Nm.defN(x, Na.b(g, root)) else ()
  else if kb == 3 || kb == 5 || kb == 8 then Nm.defsOf(x, Na.b(g, root), 0)
  else if kb == 7 then
    Nm.ty(x, Na.a(g, root))
    Nm.expr(x, Na.b(g, root))
  else ()

def Nm.rootsOf(x: Nm.X, rc: I64, rk: Array[U8](rc), rr: Array[U32](rc), i: I64): Unit =
  if 0 <= i && i < rc then
    val r = I64.of(rr(i))
    if r != 0 then Nm.root(x, I64.ofU8(rk(i)), r) else ()
    Nm.rootsOf(x, rc, rk, rr, i + 1)
  else ()

def Nm.resolveFile(w: Nm.W, f: Nm.F, fi: I64, dump: Bool): Unit =
  val Nm.F(path, g, lcap, ln, rc, rk, rr, _) = f
  val rcap = Nm.tcapOf(g)
  val ks = Array.fill(rcap, U8.of(0))
  val fs = Array.fill(rcap, U32.of(0))
  Nm.rootsOf(Nm.X(w, g, fi, path, dump, lcap, ln, rcap, ks, fs), rc, rk, rr, 0)

def Nm.resolveFiles(w: Nm.W, fs: Coll.List[Nm.F], fi: I64, dump: Bool): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, rest) =>
    Nm.resolveFile(w, f, fi, dump)
    Nm.resolveFiles(w, rest, fi + 1, dump)

// ── report ──
def Nm.showUnres(w: Nm.W, fs: Coll.List[Nm.F], i: I64): Unit =
  if i < Nm.cget(w, Nm.sShown()) then
    Nm.nth(fs, Nm.cget(w, Nm.sUFile() + i)) match
      case Coll.Some(f) =>
        val Nm.F(path, g, lcap, ln, _, _, _, _) = f
        val j = Nm.cget(w, Nm.sUTok() + i)
        Console.print(path)
        Console.print(":")
        Console.printI64(Nm.lineAt(lcap, ln, j))
        Console.print(" ")
        Console.print(Na.text(g, j))
        Console.print("\n")
      case Coll.None => Console.print("badfile\n")
    Nm.showUnres(w, fs, i + 1)
  else ()

def Nm.kinds(w: Nm.W, b: I64): Unit =
  if b <= Nm.kUnres() then
    Console.print(" ")
    Console.print(Nm.kindStr(b))
    Console.print("=")
    Console.printI64(Nm.cget(w, Nm.sKinds() + b))
    Nm.kinds(w, b + 1)
  else ()

def Nm.num(s: Str, v: I64): Unit =
  Console.print(s)
  Console.printI64(v)

def Nm.summary(w: Nm.W, fs: Coll.List[Nm.F]): Unit =
  Nm.num("globals=", Nm.cget(w, Nm.sDecl()) - 1)
  Nm.num(" locals=", Nm.cget(w, Nm.sLocals()))
  Nm.num(" resolved=", Nm.cget(w, Nm.sRes()))
  Nm.num(" unresolved=", Nm.cget(w, Nm.sUnres()))
  Console.print("\n")
  Nm.showUnres(w, fs, 0)
  Console.print("kinds")
  Nm.kinds(w, 0)
  Nm.num(" syms=", Nm.cget(w, Nm.sSyms()) - 1)
  Nm.num(" dups=", Nm.cget(w, Nm.sDup()))
  Nm.num(" maxScope=", Nm.cget(w, Nm.sMaxSp()))
  Nm.num(" parseErr=", Nm.sumPerr(fs, 0))
  Nm.num(" overflow=", Nm.cget(w, Nm.sOver()))
  Nm.num(" leaks=", Nm.cget(w, Nm.sLeak()))
  Console.print("\n")
  Nm.showTop(w, fs, 0)

// the decls with the deepest scopes: "deepest depth=D file:line"
def Nm.showTop(w: Nm.W, fs: Coll.List[Nm.F], i: I64): Unit =
  if i < Nm.nTop() then
    Nm.nth(fs, Nm.cget(w, Nm.sTop() + Nm.nTop() + i)) match
      case Coll.Some(f) =>
        val Nm.F(path, _, _, _, _, _, _, _) = f
        Nm.num("deepest depth=", Nm.cget(w, Nm.sTop() + i))
        Console.print(" ")
        Console.print(path)
        Nm.num(":", Nm.cget(w, Nm.sTop() + 2 * Nm.nTop() + i))
        Console.print("\n")
      case Coll.None => Console.print("badfile\n")
    Nm.showTop(w, fs, i + 1)
  else ()

// s3c --names F... : the program is all the files; --names-dump F... also prints one line per use token
def Nm.run(dump: Bool): I64 =
  val fs = Nm.load(2)
  val w = Nm.world(Nm.sumTok(fs, 0), Nm.sumBytes(fs, 0))
  Nm.builtins(w)
  Nm.declFiles(w, fs, 0)
  Nm.resolveFiles(w, fs, 0, dump)
  if !dump then Nm.summary(w, fs) else ()
  if Coll.length(fs) < Args.count() - 2 then 1 else 0
